        need(event, 'Material correction of an accepted obligation requires current Finance resolution')\n    48\t    cancellation_clear = True\n    49\t    for cancellation in cancellations:\n    50\t        if cancellation['status'] != 'confirmed' or cancellation.get('validation_status','PASS') != 'PASS':\n    51\t            cancellation_clear = False\n    52\t            continue\n    53\t        confirmed = cancellation['confirmed_at']\n    54\t        for event in accepted:\n    55\t            # Equality cannot prove the pre-acceptance branch. A bound resolution\n    56\t            # can resolve it without fabricating an ordering.\n    57\t            if utc_time(confirmed) >= utc_time(event['source_record']['Activity time (UTC)']):\n    58\t                need(event, 'Cancellation after acceptance/dispatch requires Finance resolution',\n    59\t                     cancellation=cancellation['cancellation_id'], after=confirmed)\n    60\t    for requirement in requirements:\n    61\t        requirement['resolved_by'] = []\n    62\t        for resolution in resolutions:\n    63\t            value = resolution['source_record']\n    64\t            named = set(str(value.get('Resolved activity references') or '').splitlines())\n    65\t            cancellations_named = set(str(value.get('Travel cancellation references') or value.get('Travel cancellation reference') or '').splitlines())\n    66\t            named_cancel = requirement['cancellation_id'] in (named | cancellations_named)\n    67\t            linked = named_cancel if requirement['cancellation_id'] else requirement['event_id'] in named\n    68\t            if (linked and value.get('Request reference') == requirement['request_id']\n    69\t                    and resolution['obligation_cents'] == allowed\n    70\t                    and utc_time(value['Activity time (UTC)']) >= utc_time(requirement['after'])):\n    71\t                requirement['resolved_by'].append(resolution['event_id'])\n    72\t 