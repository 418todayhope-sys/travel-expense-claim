174\t        f\"- Owner follow-up drafts: `{output_paths['drafts'].name}` (human review required; not sent).\",\n   175\t        \"\",\n   176\t        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n   177\t        \"\",\n   178\t    ])\n   179\t    return \"\\n\".join(lines)\n   180\t\n   181\t\n   182\tdef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n   183\t    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n   184\t    errors = verify_source_manifest(run_dir)\n   185\t    if errors:\n   186\t        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n   187\t    manifest_path = run_dir / \"sources.json\"\n   188\t    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n   189\t    parsed_path = run_dir / OUTPUT_NAME\n   190\t    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n   191\t    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n   192\t    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n   193\t        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n   194\t    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n   195\t        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n   196\t    batches = parsed.get(\"arrival_batches\")\n   197\t    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n   198\t        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n   199\t    output_paths = {\n   200\t        \"claims\": run_dir / \"claims.csv\",\n   201\t        \"report\": run_dir / \"report.md\",\n   202\t        \"queue\": run_dir / \"repair-queue.json\",\n   203\t        \"state\": run_dir / \"offline-replay-state.json\",\n   204\t        \"drafts\": run_dir / \"follow-up-drafts.md\",\n   205\t        \"workflow\": run_dir / \"ordinary-workflow.json\",\n   206\t        \"demo\": run_dir / \"ordinary-workflow-demo.md\",\n   207\t        \"revalidation\": run_dir / \"correction-cancellation-verification.json\",\n   208\t        \"revalidation_summary\": run_dir / \"correction-cancellation-verification.md\",\n   209\t    }\n   210\t    occupied = [str(path) for path in output_paths.values() if path.exists()]\n   211\t    if occupied:\n   212\t        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n   213\t    batches_dir = run_dir / \"batches\"\n   214\t    if batches_dir.exists() and any(batches_dir.iterdir()):\n   215\t        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n   216\t\n   217\t    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n   218\t    previous: dict[str, Any] | None = None\n   219\t    previous_path: Path | None = None\n   220\t    sealed: list[Path] = []\n   221\t    for number in batches:\n   222\t        batch_id = f\"arrival-{number:03d}\"\n   223\t        predecessor = None\n   224\t        if previous_path is not None:\n   225\t            predecessor = {\n   226\t                \"path\": f\"batches/{previous_path.name}\",\n   227\t                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n   228\t            }\n   229\t        current = integrate_arrival_batch(\n   230\t            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n   231\t            source_binding=binding, predecessor=predecessor, prior_result=previous,\n   232\t            source_observations=manifest[\"files\"],\n   233\t        )\n   234\t        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n   235\t        path = seal_batch_snapshot(\n   236\t            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n   237\t            predecessor_path=previous_path, schema_path=schema_path,\n   238\t            allow_unconfirmed_case_clock=True, **{\n   239\t                key: current[\"snapshot\"][key]\n   240\t                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\", \"permit_approvals\", \"budget_reconciliation\")\n     1\t\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport csv\n     6\timport hashlib\n     7\timport json\n     8\timport subprocess\n     9\tfrom datetime import datetime\n    10\tfrom pathlib import Path\n    11\tfrom typing import Any\n    12\t\n    13\tfrom .follow_up import render_follow_up_drafts\n    14\tfrom .integration import integrate_arrival_batch\n    15\tfrom .offline_replay import OFFLINE_MARKER, _report\n    16\tfrom .revalidation import verification_document\n    17\tfrom .ordinary import ordinary_demo\n    18\tfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\n    19\tfrom .snapshots import verify_snapshot\n    20\tfrom .sources import SOURCES, verify_source_manifest\n    21\t\n    22\tREQUIRED_FILES = (\n    23\t    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    24\t    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n    25\t    \"ordinary-workflow.json\", \"ordinary-workflow-demo.md\",\n    26\t    \"correction-cancellation-verification.json\", \"correction-cancellation-verification.md\",\n    27\t)\n    28\t\n    29\t\n    30\tdef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    31\t    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    32\t    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    33\t    checks: list[dict[str, Any]] = []\n    34\t    objects: dict[str, dict] = {}\n    35\t\n    36\t    def add(name, status, detail, evidence, action):\n    37\t        checks.append(dict(check=name, status=status, detail=detail,\n    38\t                           evidence_paths=[str(path) for path in evidence], next_action=action))\n    39\t\n    40\t    def check(name, paths, operation):\n    41\t        try:\n    42\t            operation()\n    43\t        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n    44\t            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n    45\t                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n    46\t        else:\n    47\t            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n    48\t\n    49\t    def require(condition, message):\n    50\t        if not condition:\n    51\t            raise ValueError(message)\n    52\t\n    53\t    for name in REQUIRED_FILES:\n    54\t        path = run_dir / name\n    55\t        def read(path=path, name=name):\n    56\t            require(path.is_file(), f\"Required output missing: {name}\")\n    57\t            if name.endswith(\".json\"):\n    58\t                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n    59\t                require(isinstance(obj, dict), f\"{name} must contain an object\")\n    60\t                objects[name] = obj\n    61\t        check(f\"required:{name}\", [path], read)\n    62\t\n    63\t    manifest = objects.get(\"sources.json\", {})\n    64\t    parsed = objects.get(\"parsed-records.json\", {})\n    65\t    state = objects.get(\"offline-replay-state.json\", {})\n    66\t    def manifest_integrity():\n    67\t     