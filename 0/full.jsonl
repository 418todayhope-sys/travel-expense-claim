essed_batches\"] = list(domain[\"processed_batches\"])\n    return {\n        \"snapshot\": snapshot,\n        \"domain\": domain,\n        \"decision_history\": deepcopy(domain[\"decision_history\"]),\n        \"finance_reconciliations\": deepcopy(finance_results),\n        \"revision_history\": deepcopy(history),\n        \"repair_queue_by_owner\": _owner_view(domain[\"repair_queue\"]),\n        \"batch_delta_counts\": {key: len(value) for key, value in delta.items()},\n        \"input_sha256\": digest,\n    }\n\n\ndef _owner_view(queue: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:\n    grouped: dict[str, list[dict[str, Any]]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n13:from .outputs import owner_grouped_view, write_claims_csv, write_repair_queue\n27:def _exclusive_json(path: Path, value: Any) -> None:\n34:def _report(\n36:    output_paths: dict[str, Path],\n111:        \"Full stage evidence and transition history: `ordinary-workflow.json`. A retained claim is demonstrated in `ordinary-workflow-demo.md`.\", \"\"])\n128:            f\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\",\n161:        f\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\",\n162:        f\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\",\n163:        f\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\",\n164:        f\"- Owner follow-up drafts: `{output_paths['drafts'].name}` (human review required; not sent).\",\n172:def run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n173:    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n189:    output_paths = {\n195:        \"workflow\": run_dir / \"ordinary-workflow.json\",\n196:        \"demo\": run_dir / \"ordinary-workflow-demo.md\",\n198:    occupied = [str(path) for path in output_paths.values() if path.exists()]\n200:        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n262:    write_claims_csv(current_claims, output_paths[\"claims\"])\n264:    write_repair_queue(queue, output_paths[\"queue\"])\n265:    _exclusive_json(output_paths[\"state\"], {\n291:    _exclusive_json(output_paths[\"workflow\"], {\"mode\": \"offline-replay\", \"fresh_native_reads_performed\": False,\n293:    output_paths[\"demo\"].write_text(ordinary_demo(workflows), encoding=\"utf-8\")\n297:    with output_paths[\"drafts\"].open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n301:        output_paths=output_paths,\n303:    output_paths[\"report\"].write_text(report, encoding=\"utf-8\", newline=\"\\n\")\n304:    return {\"run_id\": manifest[\"run_id\"], \"snapshots\": sealed, \"outputs\": output_paths, \"state\": latest, \"draft_count\": draft_count}\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    return json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-SYNTHETIC-ONLY'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-SYNTHETIC-ONLY',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation'):\n        assert checks[name]['status'] == 'PASS'\n109:Financial activities include the pending, failed, or settled outcomes of payment requests, as well as accepted commitments, adjustments, refunds, and cancellations. These are all tracked and owned by the Finance department.\n113:Tell me more about cancellations.\n117:Cancellations can target an entire trip or just a permit version independently of a claim. They must be initiated by the employee and confirmed by the supervisor, and these actions are tracked in the Travel cancellations workbook. If there were paid costs or Finance commitments, Finance will need to issue a specific disposition and resolve the money separately.\n125:Finance will issue a specific disposition bound to the cancellation ID, which confirms the reimbursement eligibility and provides a new allowed amount and reason for the affected costs.\n127:- [Travel cancellations](https://docs.google.com/spreadsheets/d/REDACTED/edit)\n237:Finance owns setting currency rates, managing spending caps, and issuing official policy exceptions. They also execute payments and resolve any monetary issues or cancellations, but they cannot waive missing evidence like receipts or proof of payment.\n261:Supervisors evaluate the business purpose of the trip, client commitment, schedule coverage, and permit consistency before providing their review reply. They also confirm travel cancellations initiated by the trip employee.\n273:Which work to revalidate after material corrections is the norm?\n309:Issues refer to unresolved problems like missing receipts, incomplete payment proof, late filings, or mismatched data. For repair work, constraints involve organizing the missing evidence into usable local tasks, retaining the subject and revision, identifying the responsible owner, and ensuring corrections go through required reviews.\n429:Let's discuss more about the process of cancellations when the original permit process is not fully reconstructed.\n433:When a cancellation occurs, the valid confirmation pauses payment readiness but does not erase the Finance commitment. If the original permit was lawful before arrangements, it remains lawful, and we record a specific cancellation issue rather than invalidating the permit.\n679:I want to discuss more about the re-entry lifecycle in regard to an employee resubmits a correction that changes a claim. How do you structurally invalidate the old record? while preserving its history?\n683:When a correction is submitted, it receives a new version number while the old version is retained in the history. The material changes structurally invalidate the prior reviews and approvals, requiring the claim to go through the required approval process again based on the new facts. You can see how we track these in the Initial claim binder and the Claim updates binder.\n690:For permit cancellation lifecycle. Without an associated expense claim. What specific document or log entry serves as verification?\n694:For a permit cancellation without a claim, the verification is a confirmed cancellation record in the Travel cancellations tab of the Travel registers workbook. This record shows the initiation by the employee and confirmation by their supervisor.\n704:When a claim is rejected by the budget owner due to funding, the claim is closed without payment, and the specific non-payment reason is recorded. Since it is a rejection, there is no next owner; the process concludes unless the employee chooses to submit a correction later.\n728:Finance provides specific outcome labels such as \"failed,\" \"pending,\" or \"cancelled\" in the Finance activity log. These indicate the status of the monetary transfer rather than a decision on the claim's entitlement.\n736:They are not interchangeable. \"Failed\" indicates an attempted transfer was unsuccessful, \"pending\" means the transfer is awaiting completion, and \"cancelled\" means the proposed payment was formally revoked before or after being initiated.\n796:To make sure I understand this, I want to summarize: an 