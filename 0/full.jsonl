{"timestamp":"2026-10-14T19:38:09.577Z","ordinal":443,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13beb-f5b1-7430-847f-20bf35334bf7","item":{"type":"CommandExecution","id":"exec-0527c562-990d-4b4f-ba03-64c995351b5a","process_id":"56371","command":["/bin/bash","-lc","git status --short; git diff --cached; git diff -- README.md src/travel_claim/cli.py src/travel_claim/offline_replay.py; cat src/travel_claim/readiness.py tests/test_readiness.py; git branch --show-current; git log -1 --oneline; cat .git/hooks/prepare-commit-msg .git/hooks/post-commit .git/hooks/pre-push"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"git status --short; git diff --cached; git diff -- README.md src/travel_claim/cli.py src/travel_claim/offline_replay.py; cat src/travel_claim/readiness.py tests/test_readiness.py; git branch --show-current; git log -1 --oneline; cat .git/hooks/prepare-commit-msg .git/hooks/post-commit .git/hooks/pre-push"}],"source":"unified_exec_startup","status":"completed","stdout":" M README.md\n M src/travel_claim/cli.py\n M src/travel_claim/offline_replay.py\n?? artifacts/runs/\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? src/travel_claim/readiness.py\n?? tests/test_readiness.py\ndiff --git a/README.md b/README.md\nindex 6a3d9e8..10bd03c 100644\n--- a/README.md\n+++ b/README.md\n@@ -81,6 +81,16 @@ travel-claim validate-snapshot artifacts/runs/<run-id>/batches/<batch-id>.json\n \n `verify-batch` also checks the source-manifest bytes, predecessor bytes, and cancellation-to-issue references. Do not overwrite a sealed snapshot; create a new run with a documented link if later processing changes its content.\n \n+## Submission-readiness validation\n+\n+```bash\n+travel-claim validate-readiness artifacts/runs/<run-id> --output-dir artifacts/verification/<new-validation-id>\n+```\n+\n+This read-only command writes `readiness.json` and `readiness.md` in a new directory outside the retained run. It checks source scope and byte hashes, input bindings, the complete snapshot chain, required files, the exact CSV contract, evidence-derived report/queue/draft traceability, and local Entire.io checkpoint references for HEAD. It does not contact native sources or verify remote synchronization. Existing validation directories are never overwritten.\n+\n+Each check is `PASS`, `BLOCKED`, or `FAIL`; exit codes are 0, 2, and 1 respectively. Integrity failures take precedence over blockers. Missing policy content and an unconfirmed authoritative case clock remain `BLOCKED`, even when retained artifacts are intact. An offline replay always remains blocked for final live-source submission. This validator covers the retained repository requirements and never certifies policy eligibility, approvals, financial closure, full native assignment compliance, or fresh execution from replay artifacts.\n+\n ## Current implementation boundary\n \n The implementation supports fresh source capture, byte-bound manifests, loss-aware transcription, schema/hash-checked snapshots, policy-neutral arrival-ordered replay, source-classified Finance reconciliation, exact CSV output, and local owner-grouped repair tracking. `offline-replay` is a structural replay only: the inaccessible reimbursement policy and unconfirmed case clock keep policy conclusions, approval readiness, entitlement, and closure unresolved. Human replies are not imported automatically, and the command never sends repair drafts or moves money. Do not treat an offline replay as a fresh source read or completed claim processing.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 54817fb..3be1433 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -11,6 +11,7 @@ from jsonschema import Draft202012Validator, FormatChecker\n \n from .outputs import write_claims_csv\n from .offline_replay import run_offline_replay\n+from .readiness import readiness_summary, validate_readiness, write_readiness_reports\n from .parsing import parse_retained_run\n from .snapshots import seal_batch_snapshot, verify_snapshot\n from .sources import capture_sources, verify_source_manifest\n@@ -92,11 +93,30 @@ def build_parser() -> argparse.ArgumentParser:\n     )\n     replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n     replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n+    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n+    readiness.add_argument(\"run_dir\", type=Path)\n+    readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n+    readiness.add_argument(\"--repo\", type=Path, default=Path(__file__).resolve().parents[2])\n+    readiness.add_argument(\"--output-dir\", type=Path, required=True, help=\"new directory for readiness.json and readiness.md\")\n     return parser\n \n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == \"validate-readiness\":\n+        try:\n+            run_root = args.run_dir.resolve()\n+            output_root = args.output_dir.resolve()\n+            if output_root == run_root or output_root.is_relative_to(run_root):\n+                raise ValueError(\"Readiness outputs must be outside the retained run directory\")\n+            report = validate_readiness(args.run_dir, schema_path=args.schema, repo_dir=args.repo)\n+            write_readiness_reports(report, args.output_dir)\n+        except (OSError, ValueError) as exc:\n+            print(f\"Could not validate readiness: {exc}\", file=sys.stderr)\n+            return 1\n+        print(readiness_summary(report))\n+        print(f\"Readiness reports: {args.output_dir}\")\n+        return {\"PASS\": 0, \"BLOCKED\": 2, \"FAIL\": 1}[report[\"status\"]]\n     if args.command == \"validate-snapshot\":\n         errors = validate_snapshot(args.snapshot, args.schema)\n         if errors:\ndiff --git a/src/travel_claim/offline_replay.py b/src/travel_claim/offline_replay.py\nindex 2c580eb..680831e 100644\n--- a/src/travel_claim/offline_replay.py\n+++ b/src/travel_claim/offline_replay.py\n@@ -35,6 +35,11 @@ def _report(\n     output_paths: dict[str, Path],\n ) -> str:\n     manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n+    clock_issue = parsed.get(\"case_clock_issue\") or {}\n+    policy_retained = any(\n+        row.get(\"source_id\") == \"policy-pol-2026-2\" and row.get(\"status\") == \"read\" and not row.get(\"missing_scope\")\n+        for row in json.loads((snapshots[0].parents[1] / \"sources.json\").read_text())[\"files\"]\n+    )\n     lines = [\n         \"# Project D operations handoff — OFFLINE REPLAY\",\n         \"\",\n@@ -44,8 +49,12 @@ def _report(\n         \"- Mode: `offline-replay`\",\n         \"- Fresh native reads in this run: **no**\",\n         f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n-        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n-        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n+        (f\"- Case clock: **supplied** (`{parsed['case_clock']}`; supplied authority remains subject to human review).\"\n+         if parsed.get(\"case_clock\") else\n+         f\"- Case clock: **unresolved** ({clock_issue.get('owner', 'Exercise facilitator')}; {clock_issue.get('next_action', 'obtain authoritative case clock')})\"),\n+        (\"- Reimbursement policy POL-2026.2: **retained**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"\n+         if policy_retained else\n+         \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"),\n         f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n         \"- Retained source observations: \" + \"; \".join(\n             f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport hashlib\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import integrate_arrival_batch\nfrom .offline_replay import OFFLINE_MARKER, _report\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\nfrom .snapshots import verify_snapshot\nfrom .sources import SOURCES, verify_source_manifest\n\nREQUIRED_FILES = (\n    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n)\n\n\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    checks: list[dict[str, Any]] = []\n    objects: dict[str, dict] = {}\n\n    def add(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") == \"native-source-manifest/1\", \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    clock = manifest.get(\"case_clock\")\n    clock_confirmed = False\n    if clock:\n        try:\n            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n        except (ValueError, TypeError, AttributeError):\n            pass\n    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n\n    mode = state.get(\"mode\", \"unverified\")\n    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n    add(\"execution-scope\", \"BLOCKED\", \"Retained-input offline replay; no fresh native-source execution\" if offline else\n        \"Fresh native-source execution is not established by the supported replay artifacts\",\n        [run_dir / \"offline-replay-state.json\"], \"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\")\n\n    def bindings():\n        manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n        parsed_hash = hashlib.sha256((run_dir / \"parsed-records.json\").read_bytes()).hexdigest()\n        require(parsed[\"source_manifest\"] == {\"path\": \"sources.json\", \"sha256\": manifest_hash}, \"Parsed manifest binding mismatch\")\n        require(state[\"source_manifest_sha256\"] == manifest_hash and state[\"parsed_records_sha256\"] == parsed_hash,\n                \"Replay state input hash mismatch\")\n        require(state[\"parsed_records_path\"] == \"parsed-records.json\", \"Unexpected parsed input path\")\n        require(manifest[\"run_id\"] == parsed[\"run_id\"] == state[\"run_id\"] == run_dir.name, \"Run identities disagree\")\n        require(offline, \"Replay mode/fresh-read markers disagree or are unsupported\")\n    check(\"input-bindings\", [run_dir / name for name in (\"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\")], bindings)\n\n    snapshots: list[Path] = []\n    def chain():\n        batches = parsed[\"arrival_batches\"]\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \"Arrival sequence is incomplete\")\n        expected = [f\"batches/arrival-{n:03d}.json\" for n in batches]\n        require(state[\"sealed_batches\"] == expected, \"Sealed batch list does not match arrival sequence\")\n        require({p.name for p in (run_dir / \"batches\").glob(\"*.json\")} == {Path(p).name for p in expected}, \"Missing or orphaned snapshots\")\n        previous = None\n        for relative in expected:\n            path = run_dir / relative\n            errors = verify_snapshot(path, run_dir, schema_path)\n            require(not errors, f\"{relative}: {'; '.join(errors)}\")\n            obj = json.loads(path.read_text())\n            require(obj[\"batch_id\"] == path.stem, \"Snapshot batch identity mismatch\")\n            require(obj[\"predecessor\"] == previous, \"Snapshot chain order mismatch\")\n            require(any(i[\"record_id\"] == \"offline-replay-mode\" for i in obj[\"issues\"]), \"Snapshot offline marker missing\")\n            previous = {\"path\": relative, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()}\n            snapshots.append(path)\n    check(\"snapshot-chain\", [run_dir / \"batches\", schema_path], chain)\n\n    def snapshot_evidence():\n        require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n        prior_result = None\n        for number, path in enumerate(snapshots, start=1):\n            observed = json.loads(path.read_text())\n            current = integrate_arrival_batch(\n                parsed, arrival_batch=number, run_id=state[\"run_id\"], batch_id=path.stem,\n                source_binding=observed[\"source_binding\"], predecessor=observed[\"predecessor\"],\n                prior_result=prior_result,\n            )\n            current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n            require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n            prior_result = current\n    check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n\n    # Collect only references actually present in retained parsed evidence.\n    parsed_refs: set[str] = set()\n    def collect_refs(value):\n        if isinstance(value, dict):\n            if all(key in value for key in (\"source_id\", \"source_sha256\", \"locator\")):\n                parsed_refs.add(f\"{value['source_id']}@{value['source_sha256']}#{value['locator']}\")\n            for child in value.values():\n                collect_refs(child)\n        elif isinstance(value, list):\n            for child in value:\n                collect_refs(child)\n    collect_refs(parsed)\n    queue: dict = {}\n    def queue_trace():\n        queue.update(load_repair_queue(run_dir / \"repair-queue.json\"))\n        require(queue == state[\"repair_queue\"], \"Queue differs from replay state\")\n        retained = {r[\"source_id\"]: r for r in manifest[\"files\"] if r[\"status\"] == \"read\"}\n        for item in queue[\"items\"].values():\n            require(item[\"subject_type\"] in {\"claim\", \"trip\", \"permit\"} and isinstance(item[\"revision\"], int) and not isinstance(item[\"revision\"], bool) and item[\"revision\"] > 0, \"Invalid repair subject/revision\")\n            require(all(isinstance(item[f], str) and item[f].strip() for f in (\"subject_id\", \"owner\", \"missing_or_return_reason\", \"next_action\")), \"Missing repair trace fields\")\n            require(item[\"run_id\"] == state[\"run_id\"] and f\"batches/{item['batch_id']}.json\" in state[\"sealed_batches\"], \"Repair run/batch reference mismatch\")\n            require(item[\"request_draft\"] == {\"status\": \"draft\", \"sent\": False}, \"Repair request is not an unsent draft\")\n            require(isinstance(item[\"source_refs\"], list), \"Repair source_refs must be an array\")\n            for ref in item[\"source_refs\"]:\n                sid_hash, locator = ref.split(\"#\", 1)\n                sid, digest = sid_hash.split(\"@\", 1)\n                require(sid in retained and retained[sid][\"sha256\"] == digest and bool(locator), \"Repair source reference does not bind retained evidence\")\n                require(ref in parsed_refs, \"Repair locator is not present in retained parsed evidence\")\n    check(\"repair-queue-traceability\", [run_dir / \"repair-queue.json\", run_dir / \"offline-replay-state.json\"], queue_trace)\n\n    missing_refs = [item[\"item_id\"] for item in queue.get(\"items\", {}).values()\n                    if item.get(\"status\") == \"open\" and not item.get(\"source_refs\")]\n    add(\"repair-evidence-availability\", \"BLOCKED\" if missing_refs else \"PASS\",\n        f\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\",\n        [run_dir / \"repair-queue.json\"], \"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\" if missing_refs else \"No missing repair evidence references.\")\n    checks[-1][\"affected_item_ids\"] = missing_refs\n    open_items = [item[\"item_id\"] for item in queue.get(\"items\", {}).values() if item.get(\"status\") == \"open\"]\n    add(\"unresolved-repairs\", \"BLOCKED\" if open_items else \"PASS\", f\"{len(open_items)} repair items remain open\",\n        [run_dir / \"repair-queue.json\", run_dir / \"follow-up-drafts.md\"],\n        \"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\" if open_items else \"No open repairs.\")\n    checks[-1][\"affected_item_ids\"] = open_items\n\n    def csv_contract():\n        require(snapshots, \"No verified snapshot chain\")\n        with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n            reader = csv.DictReader(stream)\n            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \"claims.csv header must match the exact required columns\")\n            rows = list(reader)\n        claims = json.loads(snapshots[-1].read_text())[\"claims\"]\n        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \"Missing or duplicated claim rows\")\n        by_id = {c[\"claim_id\"]: c for c in claims}\n        for row in rows:\n            require(None not in row and all(v is not None for v in row.values()), \"Malformed CSV row\")\n            claim = by_id[row[\"claim_id\"]]\n            for field in (\"revision\", \"trip_id\", \"paid_cents\", \"balance_cents\"):\n                require(row[field] == (\"\" if claim[field] is None else str(claim[field])), f\"CSV {field} differs from latest snapshot\")\n            require(row[\"allowed_cents\"] == \"\" and row[\"status\"] == \"pending\", \"Offline CSV asserts unsupported entitlement/status\")\n            open_claim_repairs = [item for item in queue.get(\"items\", {}).values()\n                                 if item[\"subject_type\"] == \"claim\" and item[\"subject_id\"] == row[\"claim_id\"] and item[\"status\"] == \"open\"]\n            owner = open_claim_repairs[0][\"owner\"] if open_claim_repairs else claim[\"next_owner\"]\n            reason = open_claim_repairs[0][\"missing_or_return_reason\"] if open_claim_repairs else \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\"\n            require(row[\"next_owner\"] == (owner or \"\") and row[\"reason\"] == reason, \"CSV owner/reason differs from current repair evidence\")\n    check(\"claims-csv-contract\", [run_dir / \"claims.csv\"], csv_contract)\n\n    def report_trace():\n        require(snapshots and queue, \"Verified snapshots and queue required\")\n        paths = {\"claims\": run_dir / \"claims.csv\", \"state\": run_dir / \"offline-replay-state.json\",\n                 \"queue\": run_dir / \"repair-queue.json\", \"drafts\": run_dir / \"follow-up-drafts.md\"}\n        expected = _report(run_id=state[\"run_id\"], parsed=parsed, snapshots=snapshots,\n                           latest={\"domain\": {\"repair_queue\": queue}}, output_paths=paths)\n        require((run_dir / \"report.md\").read_text() == expected, \"Report differs from evidence-derived handoff (sections, references, owners or actions)\")\n    check(\"report-traceability\", [run_dir / \"report.md\"], report_trace)\n\n    def drafts_status():\n        require(queue, \"Verified queue required\")\n        expected, _ = render_follow_up_drafts(run_id=state[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []))\n        require((run_dir / \"follow-up-drafts.md\").read_text() == expected, \"Drafts differ from unresolved evidence or human-review/unsent labels\")\n    check(\"follow-up-draft-status\", [run_dir / \"follow-up-drafts.md\"], drafts_status)\n    issues = parsed.get(\"unresolved_issues\", [])\n    def blocker_shape():\n        require(isinstance(issues, list), \"unresolved_issues must be an array\")\n        for issue in issues:\n            require(isinstance(issue, dict) and all(isinstance(issue.get(field), str) and issue[field] for field in\n                    (\"record_id\", \"subject_type\", \"subject_id\", \"owner\", \"reason\", \"next_action\")), \"Malformed external blocker\")\n    check(\"external-blocker-traceability\", [run_dir / \"parsed-records.json\"], blocker_shape)\n    for issue in issues if isinstance(issues, list) else []:\n        if not isinstance(issue, dict) or not all(field in issue for field in (\"record_id\", \"reason\", \"next_action\")):\n            continue\n        if issue.get(\"status\", \"open\") == \"open\":\n            add(f\"external-blocker:{issue['record_id']}\", \"BLOCKED\", issue[\"reason\"],\n                [run_dir / \"parsed-records.json\"], issue[\"next_action\"])\n\n    def git(*args):\n        result = subprocess.run([\"git\", \"-C\", str(repo_dir), *args], capture_output=True, text=True, check=True)\n        return result.stdout.strip()\n    try:\n        settings = json.loads((repo_dir / \".entire/settings.json\").read_text())\n        head = git(\"rev-parse\", \"HEAD\")\n        message = git(\"log\", \"-1\", \"--format=%B\")\n        worktree_status = git(\"status\", \"--short\")\n        ids = [line.split(\":\", 1)[1].strip() for line in message.splitlines() if line.startswith(\"Entire-Checkpoint:\")]\n        refs = git(\"for-each-ref\", \"--format=%(refname) %(objectname)\", \"refs/entire/checkpoints\").splitlines()\n        matches = [line for line in refs if any(line.split()[0].endswith('/' + identity) for identity in ids)]\n        require(settings.get(\"enabled\") is True and ids and matches, \"Enabled Entire.io and HEAD checkpoint reference required\")\n        for match in matches:\n            git(\"cat-file\", \"-e\", match.split()[1])\n            metadata = json.loads(git(\"show\", match.split()[1] + \":metadata.json\"))\n            require(isinstance(metadata, dict) and metadata, \"Checkpoint metadata is empty or invalid\")\n    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:\n        add(\"entire-local-evidence\", \"BLOCKED\", str(exc), [repo_dir / \".entire/settings.json\", repo_dir / \".git\"],\n            \"Enable Entire.io and preserve a commit-linked local checkpoint; verify remote synchronization separately.\")\n        head, matches, worktree_status = None, [], \"not_checked\"\n    else:\n        add(\"entire-local-evidence\", \"PASS\", f\"HEAD {head}; local checkpoint refs: {'; '.join(matches)}. Remote synchronization is not checked.\",\n            [repo_dir / \".entire/settings.json\", repo_dir / \".git\"], \"Verify remote refs separately before submission; local evidence does not prove remote synchronization.\")\n\n    status = \"FAIL\" if any(c[\"status\"] == \"FAIL\" for c in checks) else \"BLOCKED\" if any(c[\"status\"] == \"BLOCKED\" for c in checks) else \"PASS\"\n    return dict(report_version=\"project-d-readiness/1\", run_id=manifest.get(\"run_id\"), run_dir=str(run_dir),\n                status=status, integrity_status=\"FAIL\" if status == \"FAIL\" else \"PASS\", execution_mode=mode,\n                final_live_source_compliance=False, assignment_scope=\"Retained README, skill, schema and interview only; full native assignment page not verified\",\n                entire_remote_sync=\"not_checked\", git_head=head, worktree_status=worktree_status,\n                checkpoint_scope=\"Local HEAD checkpoint only; uncommitted changes are not certified as submitted\", checks=checks)\n\n\ndef readiness_summary(report: dict[str, Any]) -> str:\n    lines = [\"# Project D submission readiness\", \"\", f\"**{report['status']}** — mode: `{report['execution_mode']}`.\", \"\",\n             \"Structural evidence only. Final live-source compliance: **not established**.\", \"\",\n             report[\"assignment_scope\"], \"\", report[\"checkpoint_scope\"], \"\"]\n    for row in report[\"checks\"]:\n        lines.extend([f\"- **{row['status']}** `{row['check']}`: {row['detail']}\",\n                      \"  - Evidence: \" + \"; \".join(f\"`{path}`\" for path in row[\"evidence_paths\"]),\n                      f\"  - Next action: {row['next_action']}\"])\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef write_readiness_reports(report: dict[str, Any], output_dir: Path) -> None:\n    \"\"\"Exclusive directory creation prevents overwriting prior validation evidence.\"\"\"\n    output_dir.mkdir(parents=True, exist_ok=False)\n    (output_dir / \"readiness.json\").write_text(json.dumps(report, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    (output_dir / \"readiness.md\").write_text(readiness_summary(report), encoding=\"utf-8\")\n\"\"\"Readiness preserves the distinction between evidence integrity and authority.\"\"\"\n\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nfrom test_offline_replay import _capture, SCHEMA\nfrom travel_claim.cli import main\nfrom travel_claim.offline_replay import run_offline_replay\nfrom travel_claim.readiness import validate_readiness\n\n\ndef _repo(tmp_path):\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    def git(*args):\n        return subprocess.run([\"git\", \"-C\", str(repo), *args], check=True, capture_output=True, text=True).stdout.strip()\n    git(\"init\")\n    git(\"config\", \"user.name\", \"Synthetic Test\")\n    git(\"config\", \"user.email\", \"synthetic@example.invalid\")\n    (repo / \".entire\").mkdir()\n    (repo / \".entire/settings.json\").write_text('{\"enabled\": true}')\n    (repo / \"metadata.json\").write_text('{\"synthetic_fixture\": true}')\n    git(\"add\", \".\")\n    git(\"commit\", \"-m\", \"Synthetic evidence\\n\\nEntire-Checkpoint: TEST-CHECKPOINT\")\n    git(\"update-ref\", \"refs/entire/checkpoints/NT/TEST-CHECKPOINT\", \"HEAD\")\n    return repo\n\n\ndef _run(tmp_path, *, complete=False, repairs=False):\n    run, _ = _capture(tmp_path)\n    manifest_path = run / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text())\n    parsed_path = run / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    if complete:\n        # Synthetic fixture values only; never used for the real retained run.\n        policy_path = run / \"sources/policy-pol-2026-2.html\"\n        body = b\"<html>POL-2026.2 synthetic reimbursement fixture</html>\"\n        policy_path.write_bytes(body)\n        manifest[\"files\"][0].update(path=\"sources/policy-pol-2026-2.html\", sha256=hashlib.sha256(body).hexdigest(),\n                                    status=\"read\", error=None, missing_scope=[], version=\"synthetic\")\n        manifest[\"case_clock\"] = \"2026-09-01T00:00:00Z\"\n        parsed.update(case_clock=manifest[\"case_clock\"], case_clock_issue=None, unresolved_issues=[])\n    manifest_path.write_text(json.dumps(manifest))\n    parsed[\"source_manifest\"][\"sha256\"] = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if not repairs:\n        parsed[\"records\"] = {name: [] for name in parsed[\"records\"]}\n    else:\n        # Give fixture records authentic bindings to fixture retained bytes.\n        for kind, rows in parsed[\"records\"].items():\n            source = manifest[\"files\"][1 if kind == \"claim_revisions\" else 4]\n            for row in rows:\n                row.update(source_id=source[\"source_id\"], source_sha256=source[\"sha256\"])\n    parsed_path.write_text(json.dumps(parsed))\n    run_offline_replay(run, schema_path=SCHEMA)\n    return run\n\n\ndef _checks(result):\n    return {row[\"check\"]: row[\"status\"] for row in result[\"checks\"]}\n\n\ndef test_complete_structural_package_passes_integrity_but_offline_is_never_live_compliance(tmp_path):\n    run = _run(tmp_path, complete=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"BLOCKED\"\n    assert result[\"integrity_status\"] == \"PASS\"\n    assert result[\"final_live_source_compliance\"] is False\n    assert _checks(result)[\"authoritative-case-clock\"] == \"PASS\"\n    assert all(_checks(result)[f\"source-completeness:{row['source_id']}\"] == \"PASS\"\n               for row in json.loads((run / \"sources.json\").read_text())[\"files\"])\n    assert _checks(result)[\"execution-scope\"] == \"BLOCKED\"\n    assert _checks(result)[\"entire-local-evidence\"] == \"PASS\"\n    assert result[\"entire_remote_sync\"] == \"not_checked\"\n    assert all(row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\ndef test_policy_clock_and_unresolved_repairs_are_blocked_not_passed(tmp_path):\n    run = _run(tmp_path, repairs=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    checks = _checks(result)\n    assert result[\"status\"] == \"BLOCKED\"\n    assert checks[\"source-completeness:policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"authoritative-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:scenario-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:reimbursement-policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"unresolved-repairs\"] == \"BLOCKED\"\n    assert checks[\"repair-evidence-availability\"] == \"BLOCKED\"\n    assert checks[\"repair-queue-traceability\"] == \"PASS\"\n\n\n@pytest.mark.parametrize(\"missing\", [\"report.md\", \"claims.csv\", \"sources.json\", \"offline-replay-state.json\", \"batches/arrival-002.json\"])\ndef test_incomplete_package_fails_with_evidence_and_next_action(tmp_path, missing):\n    run = _run(tmp_path)\n    (run / missing).unlink()\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert result[\"integrity_status\"] == \"FAIL\"\n    assert any(row[\"status\"] == \"FAIL\" and row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\n@pytest.mark.parametrize(\"target,expected\", [\n    (\"source\", \"manifest-integrity\"), (\"snapshot\", \"snapshot-chain\"),\n    (\"orphan\", \"snapshot-chain\"), (\"terminal-snapshot\", \"snapshot-content-evidence\"), (\"header\", \"claims-csv-contract\"),\n    (\"csv-money\", \"claims-csv-contract\"), (\"report\", \"report-traceability\"),\n    (\"draft\", \"follow-up-draft-status\"), (\"queue\", \"repair-queue-traceability\"),\n    (\"reference\", \"repair-queue-traceability\"), (\"locator\", \"repair-queue-traceability\"),\n    (\"fresh-marker\", \"input-bindings\"),\n    (\"parsed\", \"input-bindings\"),\n])\ndef test_tampered_evidence_fails(tmp_path, target, expected):\n    run = _run(tmp_path, repairs=True)\n    if target == \"source\":\n        (run / \"sources/initial-claim-binder.pdf\").write_bytes(b\"tampered\")\n    elif target == \"snapshot\":\n        path = run / \"batches/arrival-001.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    elif target == \"terminal-snapshot\":\n        path = run / \"batches/arrival-002.json\"\n        snapshot = json.loads(path.read_text())\n        snapshot[\"issues\"][0][\"reason\"] = \"tampered but schema-valid issue\"\n        path.write_text(json.dumps(snapshot))\n    elif target == \"orphan\":\n        (run / \"batches/orphan.json\").write_text('{}')\n    elif target == \"header\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"claim_id,revision\", \"revision,claim_id\", 1))\n    elif target == \"csv-money\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"1250\", \"9999\"))\n    elif target == \"report\":\n        path = run / \"report.md\"\n        path.write_text(path.read_text().replace(\"Exercise facilitator\", \"Invented owner\"))\n    elif target == \"draft\":\n        path = run / \"follow-up-drafts.md\"\n        path.write_text(path.read_text().replace(\"HUMAN REVIEW REQUIRED\", \"READY TO SEND\"))\n    elif target in {\"queue\", \"reference\", \"locator\"}:\n        path = run / \"repair-queue.json\"\n        queue = json.loads(path.read_text())\n        item = next(iter(queue[\"items\"].values()))\n        if target == \"queue\":\n            item[\"request_draft\"][\"sent\"] = True\n        elif target == \"locator\":\n            manifest = json.loads((run / \"sources.json\").read_text())\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + manifest[\"files\"][1][\"sha256\"] + \"#invented page 999\"]\n        else:\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + \"0\" * 64 + \"#page 1\"]\n        path.write_text(json.dumps(queue))\n        if target in {\"reference\", \"locator\"}:\n            path = run / \"offline-replay-state.json\"\n            state = json.loads(path.read_text())\n            state[\"repair_queue\"] = {key: value for key, value in queue.items() if key != \"by_owner\"}\n            path.write_text(json.dumps(state))\n    elif target == \"fresh-marker\":\n        path = run / \"offline-replay-state.json\"\n        obj = json.loads(path.read_text()); obj[\"fresh_native_reads_performed\"] = True\n        path.write_text(json.dumps(obj))\n    else:\n        path = run / \"parsed-records.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert _checks(result)[expected] == \"FAIL\"\n\n\ndef test_entire_absence_is_blocked_and_cli_preserves_existing_evidence(tmp_path):\n    run = _run(tmp_path)\n    before = {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n    output = tmp_path / \"validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 2\n    report = json.loads((output / \"readiness.json\").read_text())\n    assert _checks(report)[\"entire-local-evidence\"] == \"BLOCKED\"\n    assert \"**BLOCKED**\" in (output / \"readiness.md\").read_text()\n    prior = (output / \"readiness.json\").read_bytes()\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(output)]) == 1\n    assert (output / \"readiness.json\").read_bytes() == prior\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(run / \"validation\")]) == 1\n    assert before == {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n\n\n@pytest.mark.parametrize(\"filename,value\", [(\"sources.json\", {\"files\": None}), (\"parsed-records.json\", {\"unresolved_issues\": None}), (\"repair-queue.json\", {\"items\": []}), (\"offline-replay-state.json\", [])])\ndef test_malformed_inputs_produce_fail_report_instead_of_crashing(tmp_path, filename, value):\n    run = _run(tmp_path)\n    (run / filename).write_text(json.dumps(value))\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=tmp_path)\n    assert result[\"status\"] == \"FAIL\"\n\n\ndef test_cli_failed_validation_still_writes_both_readiness_reports(tmp_path):\n    run = _run(tmp_path)\n    (run / \"claims.csv\").write_text(\"wrong,header\\n\")\n    output = tmp_path / \"failed-validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 1\n    assert json.loads((output / \"readiness.json\").read_text())[\"status\"] == \"FAIL\"\n    assert \"**FAIL**\" in (output / \"readiness.md\").read_text()\nmain\nefc7e91 feat: generate owner-specific Project D follow-up drafts\n#!/bin/sh\n# Entire CLI hooks\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \"$1\" \"$2\" 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Pre-push hook: push session logs alongside user's push\n# $1 is the remote name (e.g., \"origin\")\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \"$1\"; else :; fi\n","stderr":"","aggregated_output":" M README.md\n M src/travel_claim/cli.py\n M src/travel_claim/offline_replay.py\n?? artifacts/runs/\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? src/travel_claim/readiness.py\n?? tests/test_readiness.py\ndiff --git a/README.md b/README.md\nindex 6a3d9e8..10bd03c 100644\n--- a/README.md\n+++ b/README.md\n@@ -81,6 +81,16 @@ travel-claim validate-snapshot artifacts/runs/<run-id>/batches/<batch-id>.json\n \n `verify-batch` also checks the source-manifest bytes, predecessor bytes, and cancellation-to-issue references. Do not overwrite a sealed snapshot; create a new run with a documented link if later processing changes its content.\n \n+## Submission-readiness validation\n+\n+```bash\n+travel-claim validate-readiness artifacts/runs/<run-id> --output-dir artifacts/verification/<new-validation-id>\n+```\n+\n+This read-only command writes `readiness.json` and `readiness.md` in a new directory outside the retained run. It checks source scope and byte hashes, input bindings, the complete snapshot chain, required files, the exact CSV contract, evidence-derived report/queue/draft traceability, and local Entire.io checkpoint references for HEAD. It does not contact native sources or verify remote synchronization. Existing validation directories are never overwritten.\n+\n+Each check is `PASS`, `BLOCKED`, or `FAIL`; exit codes are 0, 2, and 1 respectively. Integrity failures take precedence over blockers. Missing policy content and an unconfirmed authoritative case clock remain `BLOCKED`, even when retained artifacts are intact. An offline replay always remains blocked for final live-source submission. This validator covers the retained repository requirements and never certifies policy eligibility, approvals, financial closure, full native assignment compliance, or fresh execution from replay artifacts.\n+\n ## Current implementation boundary\n \n The implementation supports fresh source capture, byte-bound manifests, loss-aware transcription, schema/hash-checked snapshots, policy-neutral arrival-ordered replay, source-classified Finance reconciliation, exact CSV output, and local owner-grouped repair tracking. `offline-replay` is a structural replay only: the inaccessible reimbursement policy and unconfirmed case clock keep policy conclusions, approval readiness, entitlement, and closure unresolved. Human replies are not imported automatically, and the command never sends repair drafts or moves money. Do not treat an offline replay as a fresh source read or completed claim processing.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 54817fb..3be1433 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -11,6 +11,7 @@ from jsonschema import Draft202012Validator, FormatChecker\n \n from .outputs import write_claims_csv\n from .offline_replay import run_offline_replay\n+from .readiness import readiness_summary, validate_readiness, write_readiness_reports\n from .parsing import parse_retained_run\n from .snapshots import seal_batch_snapshot, verify_snapshot\n from .sources import capture_sources, verify_source_manifest\n@@ -92,11 +93,30 @@ def build_parser() -> argparse.ArgumentParser:\n     )\n     replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n     replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n+    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n+    readiness.add_argument(\"run_dir\", type=Path)\n+    readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n+    readiness.add_argument(\"--repo\", type=Path, default=Path(__file__).resolve().parents[2])\n+    readiness.add_argument(\"--output-dir\", type=Path, required=True, help=\"new directory for readiness.json and readiness.md\")\n     return parser\n \n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == \"validate-readiness\":\n+        try:\n+            run_root = args.run_dir.resolve()\n+            output_root = args.output_dir.resolve()\n+            if output_root == run_root or output_root.is_relative_to(run_root):\n+                raise ValueError(\"Readiness outputs must be outside the retained run directory\")\n+            report = validate_readiness(args.run_dir, schema_path=args.schema, repo_dir=args.repo)\n+            write_readiness_reports(report, args.output_dir)\n+        except (OSError, ValueError) as exc:\n+            print(f\"Could not validate readiness: {exc}\", file=sys.stderr)\n+            return 1\n+        print(readiness_summary(report))\n+        print(f\"Readiness reports: {args.output_dir}\")\n+        return {\"PASS\": 0, \"BLOCKED\": 2, \"FAIL\": 1}[report[\"status\"]]\n     if args.command == \"validate-snapshot\":\n         errors = validate_snapshot(args.snapshot, args.schema)\n         if errors:\ndiff --git a/src/travel_claim/offline_replay.py b/src/travel_claim/offline_replay.py\nindex 2c580eb..680831e 100644\n--- a/src/travel_claim/offline_replay.py\n+++ b/src/travel_claim/offline_replay.py\n@@ -35,6 +35,11 @@ def _report(\n     output_paths: dict[str, Path],\n ) -> str:\n     manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n+    clock_issue = parsed.get(\"case_clock_issue\") or {}\n+    policy_retained = any(\n+        row.get(\"source_id\") == \"policy-pol-2026-2\" and row.get(\"status\") == \"read\" and not row.get(\"missing_scope\")\n+        for row in json.loads((snapshots[0].parents[1] / \"sources.json\").read_text())[\"files\"]\n+    )\n     lines = [\n         \"# Project D operations handoff — OFFLINE REPLAY\",\n         \"\",\n@@ -44,8 +49,12 @@ def _report(\n         \"- Mode: `offline-replay`\",\n         \"- Fresh native reads in this run: **no**\",\n         f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n-        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n-        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n+        (f\"- Case clock: **supplied** (`{parsed['case_clock']}`; supplied authority remains subject to human review).\"\n+         if parsed.get(\"case_clock\") else\n+         f\"- Case clock: **unresolved** ({clock_issue.get('owner', 'Exercise facilitator')}; {clock_issue.get('next_action', 'obtain authoritative case clock')})\"),\n+        (\"- Reimbursement policy POL-2026.2: **retained**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"\n+         if policy_retained else\n+         \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"),\n         f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n         \"- Retained source observations: \" + \"; \".join(\n             f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport hashlib\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import integrate_arrival_batch\nfrom .offline_replay import OFFLINE_MARKER, _report\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\nfrom .snapshots import verify_snapshot\nfrom .sources import SOURCES, verify_source_manifest\n\nREQUIRED_FILES = (\n    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n)\n\n\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    checks: list[dict[str, Any]] = []\n    objects: dict[str, dict] = {}\n\n    def add(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") == \"native-source-manifest/1\", \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    clock = manifest.get(\"case_clock\")\n    clock_confirmed = False\n    if clock:\n        try:\n            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n        except (ValueError, TypeError, AttributeError):\n            pass\n    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n\n    mode = state.get(\"mode\", \"unverified\")\n    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n    add(\"execution-scope\", \"BLOCKED\", \"Retained-input offline replay; no fresh native-source execution\" if offline else\n        \"Fresh native-source execution is not established by the supported replay artifacts\",\n        [run_dir / \"offline-replay-state.json\"], \"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\")\n\n    def bindings():\n        manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n        parsed_hash = hashlib.sha256((run_dir / \"parsed-records.json\").read_bytes()).hexdigest()\n        require(parsed[\"source_manifest\"] == {\"path\": \"sources.json\", \"sha256\": manifest_hash}, \"Parsed manifest binding mismatch\")\n        require(state[\"source_manifest_sha256\"] == manifest_hash and state[\"parsed_records_sha256\"] == parsed_hash,\n                \"Replay state input hash mismatch\")\n        require(state[\"parsed_records_path\"] == \"parsed-records.json\", \"Unexpected parsed input path\")\n        require(manifest[\"run_id\"] == parsed[\"run_id\"] == state[\"run_id\"] == run_dir.name, \"Run identities disagree\")\n        require(offline, \"Replay mode/fresh-read markers disagree or are unsupported\")\n    check(\"input-bindings\", [run_dir / name for name in (\"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\")], bindings)\n\n    snapshots: list[Path] = []\n    def chain():\n        batches = parsed[\"arrival_batches\"]\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \"Arrival sequence is incomplete\")\n        expected = [f\"batches/arrival-{n:03d}.json\" for n in batches]\n        require(state[\"sealed_batches\"] == expected, \"Sealed batch list does not match arrival sequence\")\n        require({p.name for p in (run_dir / \"batches\").glob(\"*.json\")} == {Path(p).name for p in expected}, \"Missing or orphaned snapshots\")\n        previous = None\n        for relative in expected:\n            path = run_dir / relative\n            errors = verify_snapshot(path, run_dir, schema_path)\n            require(not errors, f\"{relative}: {'; '.join(errors)}\")\n            obj = json.loads(path.read_text())\n            require(obj[\"batch_id\"] == path.stem, \"Snapshot batch identity mismatch\")\n            require(obj[\"predecessor\"] == previous, \"Snapshot chain order mismatch\")\n            require(any(i[\"record_id\"] == \"offline-replay-mode\" for i in obj[\"issues\"]), \"Snapshot offline marker missing\")\n            previous = {\"path\": relative, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()}\n            snapshots.append(path)\n    check(\"snapshot-chain\", [run_dir / \"batches\", schema_path], chain)\n\n    def snapshot_evidence():\n        require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n        prior_result = None\n        for number, path in enumerate(snapshots, start=1):\n            observed = json.loads(path.read_text())\n            current = integrate_arrival_batch(\n                parsed, arrival_batch=number, run_id=state[\"run_id\"], batch_id=path.stem,\n                source_binding=observed[\"source_binding\"], predecessor=observed[\"predecessor\"],\n                prior_result=prior_result,\n            )\n            current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n            require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n            prior_result = current\n    check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n\n    # Collect only references actually present in retained parsed evidence.\n    parsed_refs: set[str] = set()\n    def collect_refs(value):\n        if isinstance(value, dict):\n            if all(key in value for key in (\"source_id\", \"source_sha256\", \"locator\")):\n                parsed_refs.add(f\"{value['source_id']}@{value['source_sha256']}#{value['locator']}\")\n            for child in value.values():\n                collect_refs(child)\n        elif isinstance(value, list):\n            for child in value:\n                collect_refs(child)\n    collect_refs(parsed)\n    queue: dict = {}\n    def queue_trace():\n        queue.update(load_repair_queue(run_dir / \"repair-queue.json\"))\n        require(queue == state[\"repair_queue\"], \"Queue differs from replay state\")\n        retained = {r[\"source_id\"]: r for r in manifest[\"files\"] if r[\"status\"] == \"read\"}\n        for item in queue[\"items\"].values():\n            require(item[\"subject_type\"] in {\"claim\", \"trip\", \"permit\"} and isinstance(item[\"revision\"], int) and not isinstance(item[\"revision\"], bool) and item[\"revision\"] > 0, \"Invalid repair subject/revision\")\n            require(all(isinstance(item[f], str) and item[f].strip() for f in (\"subject_id\", \"owner\", \"missing_or_return_reason\", \"next_action\")), \"Missing repair trace fields\")\n            require(item[\"run_id\"] == state[\"run_id\"] and f\"batches/{item['batch_id']}.json\" in state[\"sealed_batches\"], \"Repair run/batch reference mismatch\")\n            require(item[\"request_draft\"] == {\"status\": \"draft\", \"sent\": False}, \"Repair request is not an unsent draft\")\n            require(isinstance(item[\"source_refs\"], list), \"Repair source_refs must be an array\")\n            for ref in item[\"source_refs\"]:\n                sid_hash, locator = ref.split(\"#\", 1)\n                sid, digest = sid_hash.split(\"@\", 1)\n                require(sid in retained and retained[sid][\"sha256\"] == digest and bool(locator), \"Repair source reference does not bind retained evidence\")\n                require(ref in parsed_refs, \"Repair locator is not present in retained parsed evidence\")\n    check(\"repair-queue-traceability\", [run_dir / \"repair-queue.json\", run_dir / \"offline-replay-state.json\"], queue_trace)\n\n    missing_refs = [item[\"item_id\"] for item in queue.get(\"items\", {}).values()\n                    if item.get(\"status\") == \"open\" and not item.get(\"source_refs\")]\n    add(\"repair-evidence-availability\", \"BLOCKED\" if missing_refs else \"PASS\",\n        f\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\",\n        [run_dir / \"repair-queue.json\"], \"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\" if missing_refs else \"No missing repair evidence references.\")\n    checks[-1][\"affected_item_ids\"] = missing_refs\n    open_items = [item[\"item_id\"] for item in queue.get(\"items\", {}).values() if item.get(\"status\") == \"open\"]\n    add(\"unresolved-repairs\", \"BLOCKED\" if open_items else \"PASS\", f\"{len(open_items)} repair items remain open\",\n        [run_dir / \"repair-queue.json\", run_dir / \"follow-up-drafts.md\"],\n        \"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\" if open_items else \"No open repairs.\")\n    checks[-1][\"affected_item_ids\"] = open_items\n\n    def csv_contract():\n        require(snapshots, \"No verified snapshot chain\")\n        with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n            reader = csv.DictReader(stream)\n            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \"claims.csv header must match the exact required columns\")\n            rows = list(reader)\n        claims = json.loads(snapshots[-1].read_text())[\"claims\"]\n        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \"Missing or duplicated claim rows\")\n        by_id = {c[\"claim_id\"]: c for c in claims}\n        for row in rows:\n            require(None not in row and all(v is not None for v in row.values()), \"Malformed CSV row\")\n            claim = by_id[row[\"claim_id\"]]\n            for field in (\"revision\", \"trip_id\", \"paid_cents\", \"balance_cents\"):\n                require(row[field] == (\"\" if claim[field] is None else str(claim[field])), f\"CSV {field} differs from latest snapshot\")\n            require(row[\"allowed_cents\"] == \"\" and row[\"status\"] == \"pending\", \"Offline CSV asserts unsupported entitlement/status\")\n            open_claim_repairs = [item for item in queue.get(\"items\", {}).values()\n                                 if item[\"subject_type\"] == \"claim\" and item[\"subject_id\"] == row[\"claim_id\"] and item[\"status\"] == \"open\"]\n            owner = open_claim_repairs[0][\"owner\"] if open_claim_repairs else claim[\"next_owner\"]\n            reason = open_claim_repairs[0][\"missing_or_return_reason\"] if open_claim_repairs else \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\"\n            require(row[\"next_owner\"] == (owner or \"\") and row[\"reason\"] == reason, \"CSV owner/reason differs from current repair evidence\")\n    check(\"claims-csv-contract\", [run_dir / \"claims.csv\"], csv_contract)\n\n    def report_trace():\n        require(snapshots and queue, \"Verified snapshots and queue required\")\n        paths = {\"claims\": run_dir / \"claims.csv\", \"state\": run_dir / \"offline-replay-state.json\",\n                 \"queue\": run_dir / \"repair-queue.json\", \"drafts\": run_dir / \"follow-up-drafts.md\"}\n        expected = _report(run_id=state[\"run_id\"], parsed=parsed, snapshots=snapshots,\n                           latest={\"domain\": {\"repair_queue\": queue}}, output_paths=paths)\n        require((run_dir / \"report.md\").read_text() == expected, \"Report differs from evidence-derived handoff (sections, references, owners or actions)\")\n    check(\"report-traceability\", [run_dir / \"report.md\"], report_trace)\n\n    def drafts_status():\n        require(queue, \"Verified queue required\")\n        expected, _ = render_follow_up_drafts(run_id=state[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []))\n        require((run_dir / \"follow-up-drafts.md\").read_text() == expected, \"Drafts differ from unresolved evidence or human-review/unsent labels\")\n    check(\"follow-up-draft-status\", [run_dir / \"follow-up-drafts.md\"], drafts_status)\n    issues = parsed.get(\"unresolved_issues\", [])\n    def blocker_shape():\n        require(isinstance(issues, list), \"unresolved_issues must be an array\")\n        for issue in issues:\n            require(isinstance(issue, dict) and all(isinstance(issue.get(field), str) and issue[field] for field in\n                    (\"record_id\", \"subject_type\", \"subject_id\", \"owner\", \"reason\", \"next_action\")), \"Malformed external blocker\")\n    check(\"external-blocker-traceability\", [run_dir / \"parsed-records.json\"], blocker_shape)\n    for issue in issues if isinstance(issues, list) else []:\n        if not isinstance(issue, dict) or not all(field in issue for field in (\"record_id\", \"reason\", \"next_action\")):\n            continue\n        if issue.get(\"status\", \"open\") == \"open\":\n            add(f\"external-blocker:{issue['record_id']}\", \"BLOCKED\", issue[\"reason\"],\n                [run_dir / \"parsed-records.json\"], issue[\"next_action\"])\n\n    def git(*args):\n        result = subprocess.run([\"git\", \"-C\", str(repo_dir), *args], capture_output=True, text=True, check=True)\n        return result.stdout.strip()\n    try:\n        settings = json.loads((repo_dir / \".entire/settings.json\").read_text())\n        head = git(\"rev-parse\", \"HEAD\")\n        message = git(\"log\", \"-1\", \"--format=%B\")\n        worktree_status = git(\"status\", \"--short\")\n        ids = [line.split(\":\", 1)[1].strip() for line in message.splitlines() if line.startswith(\"Entire-Checkpoint:\")]\n        refs = git(\"for-each-ref\", \"--format=%(refname) %(objectname)\", \"refs/entire/checkpoints\").splitlines()\n        matches = [line for line in refs if any(line.split()[0].endswith('/' + identity) for identity in ids)]\n        require(settings.get(\"enabled\") is True and ids and matches, \"Enabled Entire.io and HEAD checkpoint reference required\")\n        for match in matches:\n            git(\"cat-file\", \"-e\", match.split()[1])\n            metadata = json.loads(git(\"show\", match.split()[1] + \":metadata.json\"))\n            require(isinstance(metadata, dict) and metadata, \"Checkpoint metadata is empty or invalid\")\n    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:\n        add(\"entire-local-evidence\", \"BLOCKED\", str(exc), [repo_dir / \".entire/settings.json\", repo_dir / \".git\"],\n            \"Enable Entire.io and preserve a commit-linked local checkpoint; verify remote synchronization separately.\")\n        head, matches, worktree_status = None, [], \"not_checked\"\n    else:\n        add(\"entire-local-evidence\", \"PASS\", f\"HEAD {head}; local checkpoint refs: {'; '.join(matches)}. Remote synchronization is not checked.\",\n            [repo_dir / \".entire/settings.json\", repo_dir / \".git\"], \"Verify remote refs separately before submission; local evidence does not prove remote synchronization.\")\n\n    status = \"FAIL\" if any(c[\"status\"] == \"FAIL\" for c in checks) else \"BLOCKED\" if any(c[\"status\"] == \"BLOCKED\" for c in checks) else \"PASS\"\n    return dict(report_version=\"project-d-readiness/1\", run_id=manifest.get(\"run_id\"), run_dir=str(run_dir),\n                status=status, integrity_status=\"FAIL\" if status == \"FAIL\" else \"PASS\", execution_mode=mode,\n                final_live_source_compliance=False, assignment_scope=\"Retained README, skill, schema and interview only; full native assignment page not verified\",\n                entire_remote_sync=\"not_checked\", git_head=head, worktree_status=worktree_status,\n                checkpoint_scope=\"Local HEAD checkpoint only; uncommitted changes are not certified as submitted\", checks=checks)\n\n\ndef readiness_summary(report: dict[str, Any]) -> str:\n    lines = [\"# Project D submission readiness\", \"\", f\"**{report['status']}** — mode: `{report['execution_mode']}`.\", \"\",\n             \"Structural evidence only. Final live-source compliance: **not established**.\", \"\",\n             report[\"assignment_scope\"], \"\", report[\"checkpoint_scope\"], \"\"]\n    for row in report[\"checks\"]:\n        lines.extend([f\"- **{row['status']}** `{row['check']}`: {row['detail']}\",\n                      \"  - Evidence: \" + \"; \".join(f\"`{path}`\" for path in row[\"evidence_paths\"]),\n                      f\"  - Next action: {row['next_action']}\"])\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef write_readiness_reports(report: dict[str, Any], output_dir: Path) -> None:\n    \"\"\"Exclusive directory creation prevents overwriting prior validation evidence.\"\"\"\n    output_dir.mkdir(parents=True, exist_ok=False)\n    (output_dir / \"readiness.json\").write_text(json.dumps(report, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    (output_dir / \"readiness.md\").write_text(readiness_summary(report), encoding=\"utf-8\")\n\"\"\"Readiness preserves the distinction between evidence integrity and authority.\"\"\"\n\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nfrom test_offline_replay import _capture, SCHEMA\nfrom travel_claim.cli import main\nfrom travel_claim.offline_replay import run_offline_replay\nfrom travel_claim.readiness import validate_readiness\n\n\ndef _repo(tmp_path):\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    def git(*args):\n        return subprocess.run([\"git\", \"-C\", str(repo), *args], check=True, capture_output=True, text=True).stdout.strip()\n    git(\"init\")\n    git(\"config\", \"user.name\", \"Synthetic Test\")\n    git(\"config\", \"user.email\", \"synthetic@example.invalid\")\n    (repo / \".entire\").mkdir()\n    (repo / \".entire/settings.json\").write_text('{\"enabled\": true}')\n    (repo / \"metadata.json\").write_text('{\"synthetic_fixture\": true}')\n    git(\"add\", \".\")\n    git(\"commit\", \"-m\", \"Synthetic evidence\\n\\nEntire-Checkpoint: TEST-CHECKPOINT\")\n    git(\"update-ref\", \"refs/entire/checkpoints/NT/TEST-CHECKPOINT\", \"HEAD\")\n    return repo\n\n\ndef _run(tmp_path, *, complete=False, repairs=False):\n    run, _ = _capture(tmp_path)\n    manifest_path = run / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text())\n    parsed_path = run / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    if complete:\n        # Synthetic fixture values only; never used for the real retained run.\n        policy_path = run / \"sources/policy-pol-2026-2.html\"\n        body = b\"<html>POL-2026.2 synthetic reimbursement fixture</html>\"\n        policy_path.write_bytes(body)\n        manifest[\"files\"][0].update(path=\"sources/policy-pol-2026-2.html\", sha256=hashlib.sha256(body).hexdigest(),\n                                    status=\"read\", error=None, missing_scope=[], version=\"synthetic\")\n        manifest[\"case_clock\"] = \"2026-09-01T00:00:00Z\"\n        parsed.update(case_clock=manifest[\"case_clock\"], case_clock_issue=None, unresolved_issues=[])\n    manifest_path.write_text(json.dumps(manifest))\n    parsed[\"source_manifest\"][\"sha256\"] = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if not repairs:\n        parsed[\"records\"] = {name: [] for name in parsed[\"records\"]}\n    else:\n        # Give fixture records authentic bindings to fixture retained bytes.\n        for kind, rows in parsed[\"records\"].items():\n            source = manifest[\"files\"][1 if kind == \"claim_revisions\" else 4]\n            for row in rows:\n                row.update(source_id=source[\"source_id\"], source_sha256=source[\"sha256\"])\n    parsed_path.write_text(json.dumps(parsed))\n    run_offline_replay(run, schema_path=SCHEMA)\n    return run\n\n\ndef _checks(result):\n    return {row[\"check\"]: row[\"status\"] for row in result[\"checks\"]}\n\n\ndef test_complete_structural_package_passes_integrity_but_offline_is_never_live_compliance(tmp_path):\n    run = _run(tmp_path, complete=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"BLOCKED\"\n    assert result[\"integrity_status\"] == \"PASS\"\n    assert result[\"final_live_source_compliance\"] is False\n    assert _checks(result)[\"authoritative-case-clock\"] == \"PASS\"\n    assert all(_checks(result)[f\"source-completeness:{row['source_id']}\"] == \"PASS\"\n               for row in json.loads((run / \"sources.json\").read_text())[\"files\"])\n    assert _checks(result)[\"execution-scope\"] == \"BLOCKED\"\n    assert _checks(result)[\"entire-local-evidence\"] == \"PASS\"\n    assert result[\"entire_remote_sync\"] == \"not_checked\"\n    assert all(row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\ndef test_policy_clock_and_unresolved_repairs_are_blocked_not_passed(tmp_path):\n    run = _run(tmp_path, repairs=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    checks = _checks(result)\n    assert result[\"status\"] == \"BLOCKED\"\n    assert checks[\"source-completeness:policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"authoritative-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:scenario-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:reimbursement-policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"unresolved-repairs\"] == \"BLOCKED\"\n    assert checks[\"repair-evidence-availability\"] == \"BLOCKED\"\n    assert checks[\"repair-queue-traceability\"] == \"PASS\"\n\n\n@pytest.mark.parametrize(\"missing\", [\"report.md\", \"claims.csv\", \"sources.json\", \"offline-replay-state.json\", \"batches/arrival-002.json\"])\ndef test_incomplete_package_fails_with_evidence_and_next_action(tmp_path, missing):\n    run = _run(tmp_path)\n    (run / missing).unlink()\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert result[\"integrity_status\"] == \"FAIL\"\n    assert any(row[\"status\"] == \"FAIL\" and row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\n@pytest.mark.parametrize(\"target,expected\", [\n    (\"source\", \"manifest-integrity\"), (\"snapshot\", \"snapshot-chain\"),\n    (\"orphan\", \"snapshot-chain\"), (\"terminal-snapshot\", \"snapshot-content-evidence\"), (\"header\", \"claims-csv-contract\"),\n    (\"csv-money\", \"claims-csv-contract\"), (\"report\", \"report-traceability\"),\n    (\"draft\", \"follow-up-draft-status\"), (\"queue\", \"repair-queue-traceability\"),\n    (\"reference\", \"repair-queue-traceability\"), (\"locator\", \"repair-queue-traceability\"),\n    (\"fresh-marker\", \"input-bindings\"),\n    (\"parsed\", \"input-bindings\"),\n])\ndef test_tampered_evidence_fails(tmp_path, target, expected):\n    run = _run(tmp_path, repairs=True)\n    if target == \"source\":\n        (run / \"sources/initial-claim-binder.pdf\").write_bytes(b\"tampered\")\n    elif target == \"snapshot\":\n        path = run / \"batches/arrival-001.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    elif target == \"terminal-snapshot\":\n        path = run / \"batches/arrival-002.json\"\n        snapshot = json.loads(path.read_text())\n        snapshot[\"issues\"][0][\"reason\"] = \"tampered but schema-valid issue\"\n        path.write_text(json.dumps(snapshot))\n    elif target == \"orphan\":\n        (run / \"batches/orphan.json\").write_text('{}')\n    elif target == \"header\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"claim_id,revision\", \"revision,claim_id\", 1))\n    elif target == \"csv-money\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"1250\", \"9999\"))\n    elif target == \"report\":\n        path = run / \"report.md\"\n        path.write_text(path.read_text().replace(\"Exercise facilitator\", \"Invented owner\"))\n    elif target == \"draft\":\n        path = run / \"follow-up-drafts.md\"\n        path.write_text(path.read_text().replace(\"HUMAN REVIEW REQUIRED\", \"READY TO SEND\"))\n    elif target in {\"queue\", \"reference\", \"locator\"}:\n        path = run / \"repair-queue.json\"\n        queue = json.loads(path.read_text())\n        item = next(iter(queue[\"items\"].values()))\n        if target == \"queue\":\n            item[\"request_draft\"][\"sent\"] = True\n        elif target == \"locator\":\n            manifest = json.loads((run / \"sources.json\").read_text())\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + manifest[\"files\"][1][\"sha256\"] + \"#invented page 999\"]\n        else:\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + \"0\" * 64 + \"#page 1\"]\n        path.write_text(json.dumps(queue))\n        if target in {\"reference\", \"locator\"}:\n            path = run / \"offline-replay-state.json\"\n            state = json.loads(path.read_text())\n            state[\"repair_queue\"] = {key: value for key, value in queue.items() if key != \"by_owner\"}\n            path.write_text(json.dumps(state))\n    elif target == \"fresh-marker\":\n        path = run / \"offline-replay-state.json\"\n        obj = json.loads(path.read_text()); obj[\"fresh_native_reads_performed\"] = True\n        path.write_text(json.dumps(obj))\n    else:\n        path = run / \"parsed-records.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert _checks(result)[expected] == \"FAIL\"\n\n\ndef test_entire_absence_is_blocked_and_cli_preserves_existing_evidence(tmp_path):\n    run = _run(tmp_path)\n    before = {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n    output = tmp_path / \"validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 2\n    report = json.loads((output / \"readiness.json\").read_text())\n    assert _checks(report)[\"entire-local-evidence\"] == \"BLOCKED\"\n    assert \"**BLOCKED**\" in (output / \"readiness.md\").read_text()\n    prior = (output / \"readiness.json\").read_bytes()\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(output)]) == 1\n    assert (output / \"readiness.json\").read_bytes() == prior\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(run / \"validation\")]) == 1\n    assert before == {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n\n\n@pytest.mark.parametrize(\"filename,value\", [(\"sources.json\", {\"files\": None}), (\"parsed-records.json\", {\"unresolved_issues\": None}), (\"repair-queue.json\", {\"items\": []}), (\"offline-replay-state.json\", [])])\ndef test_malformed_inputs_produce_fail_report_instead_of_crashing(tmp_path, filename, value):\n    run = _run(tmp_path)\n    (run / filename).write_text(json.dumps(value))\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=tmp_path)\n    assert result[\"status\"] == \"FAIL\"\n\n\ndef test_cli_failed_validation_still_writes_both_readiness_reports(tmp_path):\n    run = _run(tmp_path)\n    (run / \"claims.csv\").write_text(\"wrong,header\\n\")\n    output = tmp_path / \"failed-validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 1\n    assert json.loads((output / \"readiness.json\").read_text())[\"status\"] == \"FAIL\"\n    assert \"**FAIL**\" in (output / \"readiness.md\").read_text()\nmain\nefc7e91 feat: generate owner-specific Project D follow-up drafts\n#!/bin/sh\n# Entire CLI hooks\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \"$1\" \"$2\" 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Pre-push hook: push session logs alongside user's push\n# $1 is the remote name (e.g., \"origin\")\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \"$1\"; else :; fi\n","exit_code":0,"duration":{"secs":0,"nanos":83485050},"formatted_output":" M README.md\n M src/travel_claim/cli.py\n M src/travel_claim/offline_replay.py\n?? artifacts/runs/\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? src/travel_claim/readiness.py\n?? tests/test_readiness.py\ndiff --git a/README.md b/README.md\nindex 6a3d9e8..10bd03c 100644\n--- a/README.md\n+++ b/README.md\n@@ -81,6 +81,16 @@ travel-claim validate-snapshot artifacts/runs/<run-id>/batches/<batch-id>.json\n \n `verify-batch` also checks the source-manifest bytes, predecessor bytes, and cancellation-to-issue references. Do not overwrite a sealed snapshot; create a new run with a documented link if later processing changes its content.\n \n+## Submission-readiness validation\n+\n+```bash\n+travel-claim validate-readiness artifacts/runs/<run-id> --output-dir artifacts/verification/<new-validation-id>\n+```\n+\n+This read-only command writes `readiness.json` and `readiness.md` in a new directory outside the retained run. It checks source scope and byte hashes, input bindings, the complete snapshot chain, required files, the exact CSV contract, evidence-derived report/queue/draft traceability, and local Entire.io checkpoint references for HEAD. It does not contact native sources or verify remote synchronization. Existing validation directories are never overwritten.\n+\n+Each check is `PASS`, `BLOCKED`, or `FAIL`; exit codes are 0, 2, and 1 respectively. Integrity failures take precedence over blockers. Missing policy content and an unconfirmed authoritative case clock remain `BLOCKED`, even when retained artifacts are intact. An offline replay always remains blocked for final live-source submission. This validator covers the retained repository requirements and never certifies policy eligibility, approvals, financial closure, full native assignment compliance, or fresh execution from replay artifacts.\n+\n ## Current implementation boundary\n \n The implementation supports fresh source capture, byte-bound manifests, loss-aware transcription, schema/hash-checked snapshots, policy-neutral arrival-ordered replay, source-classified Finance reconciliation, exact CSV output, and local owner-grouped repair tracking. `offline-replay` is a structural replay only: the inaccessible reimbursement policy and unconfirmed case clock keep policy conclusions, approval readiness, entitlement, and closure unresolved. Human replies are not imported automatically, and the command never sends repair drafts or moves money. Do not treat an offline replay as a fresh source read or completed claim processing.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 54817fb..3be1433 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -11,6 +11,7 @@ from jsonschema import Draft202012Validator, FormatChecker\n \n from .outputs import write_claims_csv\n from .offline_replay import run_offline_replay\n+from .readiness import readiness_summary, validate_readiness, write_readiness_reports\n from .parsing import parse_retained_run\n from .snapshots import seal_batch_snapshot, verify_snapshot\n from .sources import capture_sources, verify_source_manifest\n@@ -92,11 +93,30 @@ def build_parser() -> argparse.ArgumentParser:\n     )\n     replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n     replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n+    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n+    readiness.add_argument(\"run_dir\", type=Path)\n+    readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n+    readiness.add_argument(\"--repo\", type=Path, default=Path(__file__).resolve().parents[2])\n+    readiness.add_argument(\"--output-dir\", type=Path, required=True, help=\"new directory for readiness.json and readiness.md\")\n     return parser\n \n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == \"validate-readiness\":\n+        try:\n+            run_root = args.run_dir.resolve()\n+            output_root = args.output_dir.resolve()\n+            if output_root == run_root or output_root.is_relative_to(run_root):\n+                raise ValueError(\"Readiness outputs must be outside the retained run directory\")\n+            report = validate_readiness(args.run_dir, schema_path=args.schema, repo_dir=args.repo)\n+            write_readiness_reports(report, args.output_dir)\n+        except (OSError, ValueError) as exc:\n+            print(f\"Could not validate readiness: {exc}\", file=sys.stderr)\n+            return 1\n+        print(readiness_summary(report))\n+        print(f\"Readiness reports: {args.output_dir}\")\n+        return {\"PASS\": 0, \"BLOCKED\": 2, \"FAIL\": 1}[report[\"status\"]]\n     if args.command == \"validate-snapshot\":\n         errors = validate_snapshot(args.snapshot, args.schema)\n         if errors:\ndiff --git a/src/travel_claim/offline_replay.py b/src/travel_claim/offline_replay.py\nindex 2c580eb..680831e 100644\n--- a/src/travel_claim/offline_replay.py\n+++ b/src/travel_claim/offline_replay.py\n@@ -35,6 +35,11 @@ def _report(\n     output_paths: dict[str, Path],\n ) -> str:\n     manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n+    clock_issue = parsed.get(\"case_clock_issue\") or {}\n+    policy_retained = any(\n+        row.get(\"source_id\") == \"policy-pol-2026-2\" and row.get(\"status\") == \"read\" and not row.get(\"missing_scope\")\n+        for row in json.loads((snapshots[0].parents[1] / \"sources.json\").read_text())[\"files\"]\n+    )\n     lines = [\n         \"# Project D operations handoff — OFFLINE REPLAY\",\n         \"\",\n@@ -44,8 +49,12 @@ def _report(\n         \"- Mode: `offline-replay`\",\n         \"- Fresh native reads in this run: **no**\",\n         f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n-        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n-        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n+        (f\"- Case clock: **supplied** (`{parsed['case_clock']}`; supplied authority remains subject to human review).\"\n+         if parsed.get(\"case_clock\") else\n+         f\"- Case clock: **unresolved** ({clock_issue.get('owner', 'Exercise facilitator')}; {clock_issue.get('next_action', 'obtain authoritative case clock')})\"),\n+        (\"- Reimbursement policy POL-2026.2: **retained**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"\n+         if policy_retained else\n+         \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\"),\n         f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n         \"- Retained source observations: \" + \"; \".join(\n             f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport hashlib\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import integrate_arrival_batch\nfrom .offline_replay import OFFLINE_MARKER, _report\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\nfrom .snapshots import verify_snapshot\nfrom .sources import SOURCES, verify_source_manifest\n\nREQUIRED_FILES = (\n    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n)\n\n\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    checks: list[dict[str, Any]] = []\n    objects: dict[str, dict] = {}\n\n    def add(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") == \"native-source-manifest/1\", \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    clock = manifest.get(\"case_clock\")\n    clock_confirmed = False\n    if clock:\n        try:\n            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n        except (ValueError, TypeError, AttributeError):\n            pass\n    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n\n    mode = state.get(\"mode\", \"unverified\")\n    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n    add(\"execution-scope\", \"BLOCKED\", \"Retained-input offline replay; no fresh native-source execution\" if offline else\n        \"Fresh native-source execution is not established by the supported replay artifacts\",\n        [run_dir / \"offline-replay-state.json\"], \"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\")\n\n    def bindings():\n        manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n        parsed_hash = hashlib.sha256((run_dir / \"parsed-records.json\").read_bytes()).hexdigest()\n        require(parsed[\"source_manifest\"] == {\"path\": \"sources.json\", \"sha256\": manifest_hash}, \"Parsed manifest binding mismatch\")\n        require(state[\"source_manifest_sha256\"] == manifest_hash and state[\"parsed_records_sha256\"] == parsed_hash,\n                \"Replay state input hash mismatch\")\n        require(state[\"parsed_records_path\"] == \"parsed-records.json\", \"Unexpected parsed input path\")\n        require(manifest[\"run_id\"] == parsed[\"run_id\"] == state[\"run_id\"] == run_dir.name, \"Run identities disagree\")\n        require(offline, \"Replay mode/fresh-read markers disagree or are unsupported\")\n    check(\"input-bindings\", [run_dir / name for name in (\"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\")], bindings)\n\n    snapshots: list[Path] = []\n    def chain():\n        batches = parsed[\"arrival_batches\"]\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \"Arrival sequence is incomplete\")\n        expected = [f\"batches/arrival-{n:03d}.json\" for n in batches]\n        require(state[\"sealed_batches\"] == expected, \"Sealed batch list does not match arrival sequence\")\n        require({p.name for p in (run_dir / \"batches\").glob(\"*.json\")} == {Path(p).name for p in expected}, \"Missing or orphaned snapshots\")\n        previous = None\n        for relative in expected:\n            path = run_dir / relative\n            errors = verify_snapshot(path, run_dir, schema_path)\n            require(not errors, f\"{relative}: {'; '.join(errors)}\")\n            obj = json.loads(path.read_text())\n            require(obj[\"batch_id\"] == path.stem, \"Snapshot batch identity mismatch\")\n            require(obj[\"predecessor\"] == previous, \"Snapshot chain order mismatch\")\n            require(any(i[\"record_id\"] == \"offline-replay-mode\" for i in obj[\"issues\"]), \"Snapshot offline marker missing\")\n            previous = {\"path\": relative, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()}\n            snapshots.append(path)\n    check(\"snapshot-chain\", [run_dir / \"batches\", schema_path], chain)\n\n    def snapshot_evidence():\n        require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n        prior_result = None\n        for number, path in enumerate(snapshots, start=1):\n            observed = json.loads(path.read_text())\n            current = integrate_arrival_batch(\n                parsed, arrival_batch=number, run_id=state[\"run_id\"], batch_id=path.stem,\n                source_binding=observed[\"source_binding\"], predecessor=observed[\"predecessor\"],\n                prior_result=prior_result,\n            )\n            current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n            require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n            prior_result = current\n    check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n\n    # Collect only references actually present in retained parsed evidence.\n    parsed_refs: set[str] = set()\n    def collect_refs(value):\n        if isinstance(value, dict):\n            if all(key in value for key in (\"source_id\", \"source_sha256\", \"locator\")):\n                parsed_refs.add(f\"{value['source_id']}@{value['source_sha256']}#{value['locator']}\")\n            for child in value.values():\n                collect_refs(child)\n        elif isinstance(value, list):\n            for child in value:\n                collect_refs(child)\n    collect_refs(parsed)\n    queue: dict = {}\n    def queue_trace():\n        queue.update(load_repair_queue(run_dir / \"repair-queue.json\"))\n        require(queue == state[\"repair_queue\"], \"Queue differs from replay state\")\n        retained = {r[\"source_id\"]: r for r in manifest[\"files\"] if r[\"status\"] == \"read\"}\n        for item in queue[\"items\"].values():\n            require(item[\"subject_type\"] in {\"claim\", \"trip\", \"permit\"} and isinstance(item[\"revision\"], int) and not isinstance(item[\"revision\"], bool) and item[\"revision\"] > 0, \"Invalid repair subject/revision\")\n            require(all(isinstance(item[f], str) and item[f].strip() for f in (\"subject_id\", \"owner\", \"missing_or_return_reason\", \"next_action\")), \"Missing repair trace fields\")\n            require(item[\"run_id\"] == state[\"run_id\"] and f\"batches/{item['batch_id']}.json\" in state[\"sealed_batches\"], \"Repair run/batch reference mismatch\")\n            require(item[\"request_draft\"] == {\"status\": \"draft\", \"sent\": False}, \"Repair request is not an unsent draft\")\n            require(isinstance(item[\"source_refs\"], list), \"Repair source_refs must be an array\")\n            for ref in item[\"source_refs\"]:\n                sid_hash, locator = ref.split(\"#\", 1)\n                sid, digest = sid_hash.split(\"@\", 1)\n                require(sid in retained and retained[sid][\"sha256\"] == digest and bool(locator), \"Repair source reference does not bind retained evidence\")\n                require(ref in parsed_refs, \"Repair locator is not present in retained parsed evidence\")\n    check(\"repair-queue-traceability\", [run_dir / \"repair-queue.json\", run_dir / \"offline-replay-state.json\"], queue_trace)\n\n    missing_refs = [item[\"item_id\"] for item in queue.get(\"items\", {}).values()\n                    if item.get(\"status\") == \"open\" and not item.get(\"source_refs\")]\n    add(\"repair-evidence-availability\", \"BLOCKED\" if missing_refs else \"PASS\",\n        f\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\",\n        [run_dir / \"repair-queue.json\"], \"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\" if missing_refs else \"No missing repair evidence references.\")\n    checks[-1][\"affected_item_ids\"] = missing_refs\n    open_items = [item[\"item_id\"] for item in queue.get(\"items\", {}).values() if item.get(\"status\") == \"open\"]\n    add(\"unresolved-repairs\", \"BLOCKED\" if open_items else \"PASS\", f\"{len(open_items)} repair items remain open\",\n        [run_dir / \"repair-queue.json\", run_dir / \"follow-up-drafts.md\"],\n        \"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\" if open_items else \"No open repairs.\")\n    checks[-1][\"affected_item_ids\"] = open_items\n\n    def csv_contract():\n        require(snapshots, \"No verified snapshot chain\")\n        with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n            reader = csv.DictReader(stream)\n            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \"claims.csv header must match the exact required columns\")\n            rows = list(reader)\n        claims = json.loads(snapshots[-1].read_text())[\"claims\"]\n        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \"Missing or duplicated claim rows\")\n        by_id = {c[\"claim_id\"]: c for c in claims}\n        for row in rows:\n            require(None not in row and all(v is not None for v in row.values()), \"Malformed CSV row\")\n            claim = by_id[row[\"claim_id\"]]\n            for field in (\"revision\", \"trip_id\", \"paid_cents\", \"balance_cents\"):\n                require(row[field] == (\"\" if claim[field] is None else str(claim[field])), f\"CSV {field} differs from latest snapshot\")\n            require(row[\"allowed_cents\"] == \"\" and row[\"status\"] == \"pending\", \"Offline CSV asserts unsupported entitlement/status\")\n            open_claim_repairs = [item for item in queue.get(\"items\", {}).values()\n                                 if item[\"subject_type\"] == \"claim\" and item[\"subject_id\"] == row[\"claim_id\"] and item[\"status\"] == \"open\"]\n            owner = open_claim_repairs[0][\"owner\"] if open_claim_repairs else claim[\"next_owner\"]\n            reason = open_claim_repairs[0][\"missing_or_return_reason\"] if open_claim_repairs else \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\"\n            require(row[\"next_owner\"] == (owner or \"\") and row[\"reason\"] == reason, \"CSV owner/reason differs from current repair evidence\")\n    check(\"claims-csv-contract\", [run_dir / \"claims.csv\"], csv_contract)\n\n    def report_trace():\n        require(snapshots and queue, \"Verified snapshots and queue required\")\n        paths = {\"claims\": run_dir / \"claims.csv\", \"state\": run_dir / \"offline-replay-state.json\",\n                 \"queue\": run_dir / \"repair-queue.json\", \"drafts\": run_dir / \"follow-up-drafts.md\"}\n        expected = _report(run_id=state[\"run_id\"], parsed=parsed, snapshots=snapshots,\n                           latest={\"domain\": {\"repair_queue\": queue}}, output_paths=paths)\n        require((run_dir / \"report.md\").read_text() == expected, \"Report differs from evidence-derived handoff (sections, references, owners or actions)\")\n    check(\"report-traceability\", [run_dir / \"report.md\"], report_trace)\n\n    def drafts_status():\n        require(queue, \"Verified queue required\")\n        expected, _ = render_follow_up_drafts(run_id=state[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []))\n        require((run_dir / \"follow-up-drafts.md\").read_text() == expected, \"Drafts differ from unresolved evidence or human-review/unsent labels\")\n    check(\"follow-up-draft-status\", [run_dir / \"follow-up-drafts.md\"], drafts_status)\n    issues = parsed.get(\"unresolved_issues\", [])\n    def blocker_shape():\n        require(isinstance(issues, list), \"unresolved_issues must be an array\")\n        for issue in issues:\n            require(isinstance(issue, dict) and all(isinstance(issue.get(field), str) and issue[field] for field in\n                    (\"record_id\", \"subject_type\", \"subject_id\", \"owner\", \"reason\", \"next_action\")), \"Malformed external blocker\")\n    check(\"external-blocker-traceability\", [run_dir / \"parsed-records.json\"], blocker_shape)\n    for issue in issues if isinstance(issues, list) else []:\n        if not isinstance(issue, dict) or not all(field in issue for field in (\"record_id\", \"reason\", \"next_action\")):\n            continue\n        if issue.get(\"status\", \"open\") == \"open\":\n            add(f\"external-blocker:{issue['record_id']}\", \"BLOCKED\", issue[\"reason\"],\n                [run_dir / \"parsed-records.json\"], issue[\"next_action\"])\n\n    def git(*args):\n        result = subprocess.run([\"git\", \"-C\", str(repo_dir), *args], capture_output=True, text=True, check=True)\n        return result.stdout.strip()\n    try:\n        settings = json.loads((repo_dir / \".entire/settings.json\").read_text())\n        head = git(\"rev-parse\", \"HEAD\")\n        message = git(\"log\", \"-1\", \"--format=%B\")\n        worktree_status = git(\"status\", \"--short\")\n        ids = [line.split(\":\", 1)[1].strip() for line in message.splitlines() if line.startswith(\"Entire-Checkpoint:\")]\n        refs = git(\"for-each-ref\", \"--format=%(refname) %(objectname)\", \"refs/entire/checkpoints\").splitlines()\n        matches = [line for line in refs if any(line.split()[0].endswith('/' + identity) for identity in ids)]\n        require(settings.get(\"enabled\") is True and ids and matches, \"Enabled Entire.io and HEAD checkpoint reference required\")\n        for match in matches:\n            git(\"cat-file\", \"-e\", match.split()[1])\n            metadata = json.loads(git(\"show\", match.split()[1] + \":metadata.json\"))\n            require(isinstance(metadata, dict) and metadata, \"Checkpoint metadata is empty or invalid\")\n    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:\n        add(\"entire-local-evidence\", \"BLOCKED\", str(exc), [repo_dir / \".entire/settings.json\", repo_dir / \".git\"],\n            \"Enable Entire.io and preserve a commit-linked local checkpoint; verify remote synchronization separately.\")\n        head, matches, worktree_status = None, [], \"not_checked\"\n    else:\n        add(\"entire-local-evidence\", \"PASS\", f\"HEAD {head}; local checkpoint refs: {'; '.join(matches)}. Remote synchronization is not checked.\",\n            [repo_dir / \".entire/settings.json\", repo_dir / \".git\"], \"Verify remote refs separately before submission; local evidence does not prove remote synchronization.\")\n\n    status = \"FAIL\" if any(c[\"status\"] == \"FAIL\" for c in checks) else \"BLOCKED\" if any(c[\"status\"] == \"BLOCKED\" for c in checks) else \"PASS\"\n    return dict(report_version=\"project-d-readiness/1\", run_id=manifest.get(\"run_id\"), run_dir=str(run_dir),\n                status=status, integrity_status=\"FAIL\" if status == \"FAIL\" else \"PASS\", execution_mode=mode,\n                final_live_source_compliance=False, assignment_scope=\"Retained README, skill, schema and interview only; full native assignment page not verified\",\n                entire_remote_sync=\"not_checked\", git_head=head, worktree_status=worktree_status,\n                checkpoint_scope=\"Local HEAD checkpoint only; uncommitted changes are not certified as submitted\", checks=checks)\n\n\ndef readiness_summary(report: dict[str, Any]) -> str:\n    lines = [\"# Project D submission readiness\", \"\", f\"**{report['status']}** — mode: `{report['execution_mode']}`.\", \"\",\n             \"Structural evidence only. Final live-source compliance: **not established**.\", \"\",\n             report[\"assignment_scope\"], \"\", report[\"checkpoint_scope\"], \"\"]\n    for row in report[\"checks\"]:\n        lines.extend([f\"- **{row['status']}** `{row['check']}`: {row['detail']}\",\n                      \"  - Evidence: \" + \"; \".join(f\"`{path}`\" for path in row[\"evidence_paths\"]),\n                      f\"  - Next action: {row['next_action']}\"])\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef write_readiness_reports(report: dict[str, Any], output_dir: Path) -> None:\n    \"\"\"Exclusive directory creation prevents overwriting prior validation evidence.\"\"\"\n    output_dir.mkdir(parents=True, exist_ok=False)\n    (output_dir / \"readiness.json\").write_text(json.dumps(report, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    (output_dir / \"readiness.md\").write_text(readiness_summary(report), encoding=\"utf-8\")\n\"\"\"Readiness preserves the distinction between evidence integrity and authority.\"\"\"\n\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nfrom test_offline_replay import _capture, SCHEMA\nfrom travel_claim.cli import main\nfrom travel_claim.offline_replay import run_offline_replay\nfrom travel_claim.readiness import validate_readiness\n\n\ndef _repo(tmp_path):\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    def git(*args):\n        return subprocess.run([\"git\", \"-C\", str(repo), *args], check=True, capture_output=True, text=True).stdout.strip()\n    git(\"init\")\n    git(\"config\", \"user.name\", \"Synthetic Test\")\n    git(\"config\", \"user.email\", \"synthetic@example.invalid\")\n    (repo / \".entire\").mkdir()\n    (repo / \".entire/settings.json\").write_text('{\"enabled\": true}')\n    (repo / \"metadata.json\").write_text('{\"synthetic_fixture\": true}')\n    git(\"add\", \".\")\n    git(\"commit\", \"-m\", \"Synthetic evidence\\n\\nEntire-Checkpoint: TEST-CHECKPOINT\")\n    git(\"update-ref\", \"refs/entire/checkpoints/NT/TEST-CHECKPOINT\", \"HEAD\")\n    return repo\n\n\ndef _run(tmp_path, *, complete=False, repairs=False):\n    run, _ = _capture(tmp_path)\n    manifest_path = run / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text())\n    parsed_path = run / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    if complete:\n        # Synthetic fixture values only; never used for the real retained run.\n        policy_path = run / \"sources/policy-pol-2026-2.html\"\n        body = b\"<html>POL-2026.2 synthetic reimbursement fixture</html>\"\n        policy_path.write_bytes(body)\n        manifest[\"files\"][0].update(path=\"sources/policy-pol-2026-2.html\", sha256=hashlib.sha256(body).hexdigest(),\n                                    status=\"read\", error=None, missing_scope=[], version=\"synthetic\")\n        manifest[\"case_clock\"] = \"2026-09-01T00:00:00Z\"\n        parsed.update(case_clock=manifest[\"case_clock\"], case_clock_issue=None, unresolved_issues=[])\n    manifest_path.write_text(json.dumps(manifest))\n    parsed[\"source_manifest\"][\"sha256\"] = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if not repairs:\n        parsed[\"records\"] = {name: [] for name in parsed[\"records\"]}\n    else:\n        # Give fixture records authentic bindings to fixture retained bytes.\n        for kind, rows in parsed[\"records\"].items():\n            source = manifest[\"files\"][1 if kind == \"claim_revisions\" else 4]\n            for row in rows:\n                row.update(source_id=source[\"source_id\"], source_sha256=source[\"sha256\"])\n    parsed_path.write_text(json.dumps(parsed))\n    run_offline_replay(run, schema_path=SCHEMA)\n    return run\n\n\ndef _checks(result):\n    return {row[\"check\"]: row[\"status\"] for row in result[\"checks\"]}\n\n\ndef test_complete_structural_package_passes_integrity_but_offline_is_never_live_compliance(tmp_path):\n    run = _run(tmp_path, complete=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"BLOCKED\"\n    assert result[\"integrity_status\"] == \"PASS\"\n    assert result[\"final_live_source_compliance\"] is False\n    assert _checks(result)[\"authoritative-case-clock\"] == \"PASS\"\n    assert all(_checks(result)[f\"source-completeness:{row['source_id']}\"] == \"PASS\"\n               for row in json.loads((run / \"sources.json\").read_text())[\"files\"])\n    assert _checks(result)[\"execution-scope\"] == \"BLOCKED\"\n    assert _checks(result)[\"entire-local-evidence\"] == \"PASS\"\n    assert result[\"entire_remote_sync\"] == \"not_checked\"\n    assert all(row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\ndef test_policy_clock_and_unresolved_repairs_are_blocked_not_passed(tmp_path):\n    run = _run(tmp_path, repairs=True)\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    checks = _checks(result)\n    assert result[\"status\"] == \"BLOCKED\"\n    assert checks[\"source-completeness:policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"authoritative-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:scenario-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:reimbursement-policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"unresolved-repairs\"] == \"BLOCKED\"\n    assert checks[\"repair-evidence-availability\"] == \"BLOCKED\"\n    assert checks[\"repair-queue-traceability\"] == \"PASS\"\n\n\n@pytest.mark.parametrize(\"missing\", [\"report.md\", \"claims.csv\", \"sources.json\", \"offline-replay-state.json\", \"batches/arrival-002.json\"])\ndef test_incomplete_package_fails_with_evidence_and_next_action(tmp_path, missing):\n    run = _run(tmp_path)\n    (run / missing).unlink()\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert result[\"integrity_status\"] == \"FAIL\"\n    assert any(row[\"status\"] == \"FAIL\" and row[\"evidence_paths\"] and row[\"next_action\"] for row in result[\"checks\"])\n\n\n@pytest.mark.parametrize(\"target,expected\", [\n    (\"source\", \"manifest-integrity\"), (\"snapshot\", \"snapshot-chain\"),\n    (\"orphan\", \"snapshot-chain\"), (\"terminal-snapshot\", \"snapshot-content-evidence\"), (\"header\", \"claims-csv-contract\"),\n    (\"csv-money\", \"claims-csv-contract\"), (\"report\", \"report-traceability\"),\n    (\"draft\", \"follow-up-draft-status\"), (\"queue\", \"repair-queue-traceability\"),\n    (\"reference\", \"repair-queue-traceability\"), (\"locator\", \"repair-queue-traceability\"),\n    (\"fresh-marker\", \"input-bindings\"),\n    (\"parsed\", \"input-bindings\"),\n])\ndef test_tampered_evidence_fails(tmp_path, target, expected):\n    run = _run(tmp_path, repairs=True)\n    if target == \"source\":\n        (run / \"sources/initial-claim-binder.pdf\").write_bytes(b\"tampered\")\n    elif target == \"snapshot\":\n        path = run / \"batches/arrival-001.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    elif target == \"terminal-snapshot\":\n        path = run / \"batches/arrival-002.json\"\n        snapshot = json.loads(path.read_text())\n        snapshot[\"issues\"][0][\"reason\"] = \"tampered but schema-valid issue\"\n        path.write_text(json.dumps(snapshot))\n    elif target == \"orphan\":\n        (run / \"batches/orphan.json\").write_text('{}')\n    elif target == \"header\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"claim_id,revision\", \"revision,claim_id\", 1))\n    elif target == \"csv-money\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"1250\", \"9999\"))\n    elif target == \"report\":\n        path = run / \"report.md\"\n        path.write_text(path.read_text().replace(\"Exercise facilitator\", \"Invented owner\"))\n    elif target == \"draft\":\n        path = run / \"follow-up-drafts.md\"\n        path.write_text(path.read_text().replace(\"HUMAN REVIEW REQUIRED\", \"READY TO SEND\"))\n    elif target in {\"queue\", \"reference\", \"locator\"}:\n        path = run / \"repair-queue.json\"\n        queue = json.loads(path.read_text())\n        item = next(iter(queue[\"items\"].values()))\n        if target == \"queue\":\n            item[\"request_draft\"][\"sent\"] = True\n        elif target == \"locator\":\n            manifest = json.loads((run / \"sources.json\").read_text())\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + manifest[\"files\"][1][\"sha256\"] + \"#invented page 999\"]\n        else:\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + \"0\" * 64 + \"#page 1\"]\n        path.write_text(json.dumps(queue))\n        if target in {\"reference\", \"locator\"}:\n            path = run / \"offline-replay-state.json\"\n            state = json.loads(path.read_text())\n            state[\"repair_queue\"] = {key: value for key, value in queue.items() if key != \"by_owner\"}\n            path.write_text(json.dumps(state))\n    elif target == \"fresh-marker\":\n        path = run / \"offline-replay-state.json\"\n        obj = json.loads(path.read_text()); obj[\"fresh_native_reads_performed\"] = True\n        path.write_text(json.dumps(obj))\n    else:\n        path = run / \"parsed-records.json\"\n        path.write_text(path.read_text() + \"\\n\")\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n    assert result[\"status\"] == \"FAIL\"\n    assert _checks(result)[expected] == \"FAIL\"\n\n\ndef test_entire_absence_is_blocked_and_cli_preserves_existing_evidence(tmp_path):\n    run = _run(tmp_path)\n    before = {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n    output = tmp_path / \"validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 2\n    report = json.loads((output / \"readiness.json\").read_text())\n    assert _checks(report)[\"entire-local-evidence\"] == \"BLOCKED\"\n    assert \"**BLOCKED**\" in (output / \"readiness.md\").read_text()\n    prior = (output / \"readiness.json\").read_bytes()\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(output)]) == 1\n    assert (output / \"readiness.json\").read_bytes() == prior\n    assert main([\"validate-readiness\", str(run), \"--output-dir\", str(run / \"validation\")]) == 1\n    assert before == {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\n\n\n@pytest.mark.parametrize(\"filename,value\", [(\"sources.json\", {\"files\": None}), (\"parsed-records.json\", {\"unresolved_issues\": None}), (\"repair-queue.json\", {\"items\": []}), (\"offline-replay-state.json\", [])])\ndef test_malformed_inputs_produce_fail_report_instead_of_crashing(tmp_path, filename, value):\n    run = _run(tmp_path)\n    (run / filename).write_text(json.dumps(value))\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=tmp_path)\n    assert result[\"status\"] == \"FAIL\"\n\n\ndef test_cli_failed_validation_still_writes_both_readiness_reports(tmp_path):\n    run = _run(tmp_path)\n    (run / \"claims.csv\").write_text(\"wrong,header\\n\")\n    output = tmp_path / \"failed-validation\"\n    assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 1\n    assert json.loads((output / \"readiness.json\").read_text())[\"status\"] == \"FAIL\"\n    assert \"**FAIL**\" in (output / \"readiness.md\").read_text()\nmain\nefc7e91 feat: generate owner-specific Project D follow-up drafts\n#!/bin/sh\n# Entire CLI hooks\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \"$1\" \"$2\" 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\n#!/bin/sh\n# Entire CLI hooks\n# Pre-push hook: push session logs alongside user's push\n# $1 is the remote name (e.g., \"origin\")\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \"$1\"; else :; fi\n"},"started_at_ms":1792006689493,"completed_at_ms":1792006689577}}
{"timestamp":"2026-10-14T19:38:09.703Z","ordinal":444,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13bec-13a7-7170-aa02-207d4f83ecfe","call_id":"call_14528fdfe0064277ae15fc3cc8fdfca4","output":[{"type":"input_text","text":"Script completed\nWall time 0.9 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"b589ca\",\"wall_time_seconds\":0.08425527,\"exit_code\":0,\"original_token_count\":9375,\"output\":\" M README.md\\n M src/travel_claim/cli.py\\n M src/travel_claim/offline_replay.py\\n?? artifacts/runs/\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n?? src/travel_claim/readiness.py\\n?? tests/test_readiness.py\\ndiff --git a/README.md b/README.md\\nindex 6a3d9e8..10bd03c 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -81,6 +81,16 @@ travel-claim validate-snapshot artifacts/runs/<run-id>/batches/<batch-id>.json\\n \\n `verify-batch` also checks the source-manifest bytes, predecessor bytes, and cancellation-to-issue references. Do not overwrite a sealed snapshot; create a new run with a documented link if later processing changes its content.\\n \\n+## Submission-readiness validation\\n+\\n+```bash\\n+travel-claim validate-readiness artifacts/runs/<run-id> --output-dir artifacts/verification/<new-validation-id>\\n+```\\n+\\n+This read-only command writes `readiness.json` and `readiness.md` in a new directory outside the retained run. It checks source scope and byte hashes, input bindings, the complete snapshot chain, required files, the exact CSV contract, evidence-derived report/queue/draft traceability, and local Entire.io checkpoint references for HEAD. It does not contact native sources or verify remote synchronization. Existing validation directories are never overwritten.\\n+\\n+Each check is `PASS`, `BLOCKED`, or `FAIL`; exit codes are 0, 2, and 1 respectively. Integrity failures take precedence over blockers. Missing policy content and an unconfirmed authoritative case clock remain `BLOCKED`, even when retained artifacts are intact. An offline replay always remains blocked for final live-source submission. This validator covers the retained repository requirements and never certifies policy eligibility, approvals, financial closure, full native assignment compliance, or fresh execution from replay artifacts.\\n+\\n ## Current implementation boundary\\n \\n The implementation supports fresh source capture, byte-bound manifests, loss-aware transcription, schema/hash-checked snapshots, policy-neutral arrival-ordered replay, source-classified Finance reconciliation, exact CSV output, and local owner-grouped repair tracking. `offline-replay` is a structural replay only: the inaccessible reimbursement policy and unconfirmed case clock keep policy conclusions, approval readiness, entitlement, and closure unresolved. Human replies are not imported automatically, and the command never sends repair drafts or moves money. Do not treat an offline replay as a fresh source read or completed claim processing.\\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\\nindex 54817fb..3be1433 100644\\n--- a/src/travel_claim/cli.py\\n+++ b/src/travel_claim/cli.py\\n@@ -11,6 +11,7 @@ from jsonschema import Draft202012Validator, FormatChecker\\n \\n from .outputs import write_claims_csv\\n from .offline_replay import run_offline_replay\\n+from .readiness import readiness_summary, validate_readiness, write_readiness_reports\\n from .parsing import parse_retained_run\\n from .snapshots import seal_batch_snapshot, verify_snapshot\\n from .sources import capture_sources, verify_source_manifest\\n@@ -92,11 +93,30 @@ def build_parser() -> argparse.ArgumentParser:\\n     )\\n     replay.add_argument(\\\"run_dir\\\", type=Path, help=\\\"existing retained-source run directory\\\")\\n     replay.add_argument(\\\"--schema\\\", type=Path, default=_default_schema_path(), help=\\\"snapshot schema path\\\")\\n+    readiness = commands.add_parser(\\\"validate-readiness\\\", help=\\\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\\\")\\n+    readiness.add_argument(\\\"run_dir\\\", type=Path)\\n+    readiness.add_argument(\\\"--schema\\\", type=Path, default=_default_schema_path())\\n+    readiness.add_argument(\\\"--repo\\\", type=Path, default=Path(__file__).resolve().parents[2])\\n+    readiness.add_argument(\\\"--output-dir\\\", type=Path, required=True, help=\\\"new directory for readiness.json and readiness.md\\\")\\n     return parser\\n \\n \\n def main(argv: list[str] | None = None) -> int:\\n     args = build_parser().parse_args(argv)\\n+    if args.command == \\\"validate-readiness\\\":\\n+        try:\\n+            run_root = args.run_dir.resolve()\\n+            output_root = args.output_dir.resolve()\\n+            if output_root == run_root or output_root.is_relative_to(run_root):\\n+                raise ValueError(\\\"Readiness outputs must be outside the retained run directory\\\")\\n+            report = validate_readiness(args.run_dir, schema_path=args.schema, repo_dir=args.repo)\\n+            write_readiness_reports(report, args.output_dir)\\n+        except (OSError, ValueError) as exc:\\n+            print(f\\\"Could not validate readiness: {exc}\\\", file=sys.stderr)\\n+            return 1\\n+        print(readiness_summary(report))\\n+        print(f\\\"Readiness reports: {args.output_dir}\\\")\\n+        return {\\\"PASS\\\": 0, \\\"BLOCKED\\\": 2, \\\"FAIL\\\": 1}[report[\\\"status\\\"]]\\n     if args.command == \\\"validate-snapshot\\\":\\n         errors = validate_snapshot(args.snapshot, args.schema)\\n         if errors:\\ndiff --git a/src/travel_claim/offline_replay.py b/src/travel_claim/offline_replay.py\\nindex 2c580eb..680831e 100644\\n--- a/src/travel_claim/offline_replay.py\\n+++ b/src/travel_claim/offline_replay.py\\n@@ -35,6 +35,11 @@ def _report(\\n     output_paths: dict[str, Path],\\n ) -> str:\\n     manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \\\"sources.json\\\").read_bytes()).hexdigest()\\n+    clock_issue = parsed.get(\\\"case_clock_issue\\\") or {}\\n+    policy_retained = any(\\n+        row.get(\\\"source_id\\\") == \\\"policy-pol-2026-2\\\" and row.get(\\\"status\\\") == \\\"read\\\" and not row.get(\\\"missing_scope\\\")\\n+        for row in json.loads((snapshots[0].parents[1] / \\\"sources.json\\\").read_text())[\\\"files\\\"]\\n+    )\\n     lines = [\\n         \\\"# Project D operations handoff — OFFLINE REPLAY\\\",\\n         \\\"\\\",\\n@@ -44,8 +49,12 @@ def _report(\\n         \\\"- Mode: `offline-replay`\\\",\\n         \\\"- Fresh native reads in this run: **no**\\\",\\n         f\\\"- Retained `sources.json` SHA-256: `{manifest_hash}`\\\",\\n-        f\\\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\\\",\\n-        \\\"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\",\\n+        (f\\\"- Case clock: **supplied** (`{parsed['case_clock']}`; supplied authority remains subject to human review).\\\"\\n+         if parsed.get(\\\"case_clock\\\") else\\n+         f\\\"- Case clock: **unresolved** ({clock_issue.get('owner', 'Exercise facilitator')}; {clock_issue.get('next_action', 'obtain authoritative case clock')})\\\"),\\n+        (\\\"- Reimbursement policy POL-2026.2: **retained**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\"\\n+         if policy_retained else\\n+         \\\"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\"),\\n         f\\\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\\\",\\n         \\\"- Retained source observations: \\\" + \\\"; \\\".join(\\n             f\\\"`{row['source_id']}`={row['status']}\\\" for row in json.loads(\\n\\\"\\\"\\\"Read-only structural readiness checks; never certify live business compliance.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport csv\\nimport hashlib\\nimport json\\nimport subprocess\\nfrom datetime import datetime\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom .follow_up import render_follow_up_drafts\\nfrom .integration import integrate_arrival_batch\\nfrom .offline_replay import OFFLINE_MARKER, _report\\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\\nfrom .snapshots import verify_snapshot\\nfrom .sources import SOURCES, verify_source_manifest\\n\\nREQUIRED_FILES = (\\n    \\\"sources.json\\\", \\\"parsed-records.json\\\", \\\"offline-replay-state.json\\\",\\n    \\\"claims.csv\\\", \\\"report.md\\\", \\\"repair-queue.json\\\", \\\"follow-up-drafts.md\\\",\\n)\\n\\n\\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\\n    \\\"\\\"\\\"Inspect existing artifacts and local Git evidence without changing either.\\\"\\\"\\\"\\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\\n    checks: list[dict[str, Any]] = []\\n    objects: dict[str, dict] = {}\\n\\n    def add(name, status, detail, evidence, action):\\n        checks.append(dict(check=name, status=status, detail=detail,\\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\\n\\n    def check(name, paths, operation):\\n        try:\\n            operation()\\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\\n            add(name, \\\"FAIL\\\", str(exc) or \\\"Evidence is inconsistent\\\", paths,\\n                \\\"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\\\")\\n        else:\\n            add(name, \\\"PASS\\\", \\\"Local structural evidence verified\\\", paths, \\\"No structural repair required.\\\")\\n\\n    def require(condition, message):\\n        if not condition:\\n            raise ValueError(message)\\n\\n    for name in REQUIRED_FILES:\\n        path = run_dir / name\\n        def read(path=path, name=name):\\n            require(path.is_file(), f\\\"Required output missing: {name}\\\")\\n            if name.endswith(\\\".json\\\"):\\n                obj = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n                require(isinstance(obj, dict), f\\\"{name} must contain an object\\\")\\n                objects[name] = obj\\n        check(f\\\"required:{name}\\\", [path], read)\\n\\n    manifest = objects.get(\\\"sources.json\\\", {})\\n    parsed = objects.get(\\\"parsed-records.json\\\", {})\\n    state = objects.get(\\\"offline-replay-state.json\\\", {})\\n    def manifest_integrity():\\n        errors = verify_source_manifest(run_dir)\\n        require(not errors, \\\"; \\\".join(errors))\\n        require(manifest.get(\\\"source_version\\\") == \\\"native-source-manifest/1\\\", \\\"Unsupported manifest version\\\")\\n        rows = manifest[\\\"files\\\"]\\n        require(len(rows) == len(SOURCES), \\\"Expected exactly five source entries\\\")\\n        require({r[\\\"source_id\\\"]: r[\\\"url\\\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\\n                \\\"Source IDs do not match configured native URLs\\\")\\n    check(\\\"manifest-integrity\\\", [run_dir / \\\"sources.json\\\"], manifest_integrity)\\n    source_rows = manifest.get(\\\"files\\\", [])\\n    if not isinstance(source_rows, list):\\n        source_rows = []\\n    for source in SOURCES:\\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\\\"source_id\\\") == source.source_id), {})\\n        complete = row.get(\\\"status\\\") == \\\"read\\\" and row.get(\\\"missing_scope\\\") == []\\n        add(f\\\"source-completeness:{source.source_id}\\\", \\\"PASS\\\" if complete else \\\"BLOCKED\\\",\\n            \\\"Complete retained scope recorded\\\" if complete else row.get(\\\"error\\\") or \\\"Source scope missing or partial\\\",\\n            [run_dir / \\\"sources.json\\\"], \\\"No source-access repair required.\\\" if complete else\\n            f\\\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\\\")\\n\\n    clock = manifest.get(\\\"case_clock\\\")\\n    clock_confirmed = False\\n    if clock:\\n        try:\\n            clock_confirmed = datetime.fromisoformat(clock.replace(\\\"Z\\\", \\\"+00:00\\\")).utcoffset() is not None\\n        except (ValueError, TypeError, AttributeError):\\n            pass\\n    clock_confirmed = clock_confirmed and parsed.get(\\\"case_clock\\\") == clock and state.get(\\\"case_clock\\\") == clock and not parsed.get(\\\"case_clock_issue\\\")\\n    add(\\\"authoritative-case-clock\\\", \\\"PASS\\\" if clock_confirmed else \\\"BLOCKED\\\",\\n        \\\"Consistent supplied timestamp recorded; authority is caller supplied\\\" if clock_confirmed else \\\"Authoritative scenario clock is unconfirmed or inconsistent\\\",\\n        [run_dir / \\\"sources.json\\\", run_dir / \\\"parsed-records.json\\\"],\\n        \\\"Retain the supplied authority evidence.\\\" if clock_confirmed else \\\"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\\\")\\n\\n    mode = state.get(\\\"mode\\\", \\\"unverified\\\")\\n    offline = mode == \\\"offline-replay\\\" and state.get(\\\"fresh_native_reads_performed\\\") is False\\n    add(\\\"execution-scope\\\", \\\"BLOCKED\\\", \\\"Retained-input offline replay; no fresh native-source execution\\\" if offline else\\n        \\\"Fresh native-source execution is not established by the supported replay artifacts\\\",\\n        [run_dir / \\\"offline-replay-state.json\\\"], \\\"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\\\")\\n\\n    def bindings():\\n        manifest_hash = hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n        parsed_hash = hashlib.sha256((run_dir / \\\"parsed-records.json\\\").read_bytes()).hexdigest()\\n        require(parsed[\\\"source_manifest\\\"] == {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": manifest_hash}, \\\"Parsed manifest binding mismatch\\\")\\n        require(state[\\\"source_manifest_sha256\\\"] == manifest_hash and state[\\\"parsed_records_sha256\\\"] == parsed_hash,\\n                \\\"Replay state input hash mismatch\\\")\\n        require(state[\\\"parsed_records_path\\\"] == \\\"parsed-records.json\\\", \\\"Unexpected parsed input path\\\")\\n        require(manifest[\\\"run_id\\\"] == parsed[\\\"run_id\\\"] == state[\\\"run_id\\\"] == run_dir.name, \\\"Run identities disagree\\\")\\n        require(offline, \\\"Replay mode/fresh-read markers disagree or are unsupported\\\")\\n    check(\\\"input-bindings\\\", [run_dir / name for name in (\\\"sources.json\\\", \\\"parsed-records.json\\\", \\\"offline-replay-state.json\\\")], bindings)\\n\\n    snapshots: list[Path] = []\\n    def chain():\\n        batches = parsed[\\\"arrival_batches\\\"]\\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \\\"Arrival sequence is incomplete\\\")\\n        expected = [f\\\"batches/arrival-{n:03d}.json\\\" for n in batches]\\n        require(state[\\\"sealed_batches\\\"] == expected, \\\"Sealed batch list does not match arrival sequence\\\")\\n        require({p.name for p in (run_dir / \\\"batches\\\").glob(\\\"*.json\\\")} == {Path(p).name for p in expected}, \\\"Missing or orphaned snapshots\\\")\\n        previous = None\\n        for relative in expected:\\n            path = run_dir / relative\\n            errors = verify_snapshot(path, run_dir, schema_path)\\n            require(not errors, f\\\"{relative}: {'; '.join(errors)}\\\")\\n            obj = json.loads(path.read_text())\\n            require(obj[\\\"batch_id\\\"] == path.stem, \\\"Snapshot batch identity mismatch\\\")\\n            require(obj[\\\"predecessor\\\"] == previous, \\\"Snapshot chain order mismatch\\\")\\n            require(any(i[\\\"record_id\\\"] == \\\"offline-replay-mode\\\" for i in obj[\\\"issues\\\"]), \\\"Snapshot offline marker missing\\\")\\n            previous = {\\\"path\\\": relative, \\\"sha256\\\": hashlib.sha256(path.read_bytes()).hexdigest()}\\n            snapshots.append(path)\\n    check(\\\"snapshot-chain\\\", [run_dir / \\\"batches\\\", schema_path], chain)\\n\\n    def snapshot_evidence():\\n        require(snapshots and checks[-1][\\\"status\\\"] == \\\"PASS\\\", \\\"Verified complete snapshot chain required\\\")\\n        prior_result = None\\n        for number, path in enumerate(snapshots, start=1):\\n            observed = json.loads(path.read_text())\\n            current = integrate_arrival_batch(\\n                parsed, arrival_batch=number, run_id=state[\\\"run_id\\\"], batch_id=path.stem,\\n                source_binding=observed[\\\"source_binding\\\"], predecessor=observed[\\\"predecessor\\\"],\\n                prior_result=prior_result,\\n            )\\n            current[\\\"snapshot\\\"][\\\"issues\\\"].append(dict(OFFLINE_MARKER))\\n            require(current[\\\"snapshot\\\"] == observed, f\\\"{path.name} content differs from retained evidence replay\\\")\\n            prior_result = current\\n    check(\\\"snapshot-content-evidence\\\", [run_dir / \\\"batches\\\", run_dir / \\\"parsed-records.json\\\"], snapshot_evidence)\\n\\n    # Collect only references actually present in retained parsed evidence.\\n    parsed_refs: set[str] = set()\\n    def collect_refs(value):\\n        if isinstance(value, dict):\\n            if all(key in value for key in (\\\"source_id\\\", \\\"source_sha256\\\", \\\"locator\\\")):\\n                parsed_refs.add(f\\\"{value['source_id']}@{value['source_sha256']}#{value['locator']}\\\")\\n            for child in value.values():\\n                collect_refs(child)\\n        elif isinstance(value, list):\\n            for child in value:\\n                collect_refs(child)\\n    collect_refs(parsed)\\n    queue: dict = {}\\n    def queue_trace():\\n        queue.update(load_repair_queue(run_dir / \\\"repair-queue.json\\\"))\\n        require(queue == state[\\\"repair_queue\\\"], \\\"Queue differs from replay state\\\")\\n        retained = {r[\\\"source_id\\\"]: r for r in manifest[\\\"files\\\"] if r[\\\"status\\\"] == \\\"read\\\"}\\n        for item in queue[\\\"items\\\"].values():\\n            require(item[\\\"subject_type\\\"] in {\\\"claim\\\", \\\"trip\\\", \\\"permit\\\"} and isinstance(item[\\\"revision\\\"], int) and not isinstance(item[\\\"revision\\\"], bool) and item[\\\"revision\\\"] > 0, \\\"Invalid repair subject/revision\\\")\\n            require(all(isinstance(item[f], str) and item[f].strip() for f in (\\\"subject_id\\\", \\\"owner\\\", \\\"missing_or_return_reason\\\", \\\"next_action\\\")), \\\"Missing repair trace fields\\\")\\n            require(item[\\\"run_id\\\"] == state[\\\"run_id\\\"] and f\\\"batches/{item['batch_id']}.json\\\" in state[\\\"sealed_batches\\\"], \\\"Repair run/batch reference mismatch\\\")\\n            require(item[\\\"request_draft\\\"] == {\\\"status\\\": \\\"draft\\\", \\\"sent\\\": False}, \\\"Repair request is not an unsent draft\\\")\\n            require(isinstance(item[\\\"source_refs\\\"], list), \\\"Repair source_refs must be an array\\\")\\n            for ref in item[\\\"source_refs\\\"]:\\n                sid_hash, locator = ref.split(\\\"#\\\", 1)\\n                sid, digest = sid_hash.split(\\\"@\\\", 1)\\n                require(sid in retained and retained[sid][\\\"sha256\\\"] == digest and bool(locator), \\\"Repair source reference does not bind retained evidence\\\")\\n                require(ref in parsed_refs, \\\"Repair locator is not present in retained parsed evidence\\\")\\n    check(\\\"repair-queue-traceability\\\", [run_dir / \\\"repair-queue.json\\\", run_dir / \\\"offline-replay-state.json\\\"], queue_trace)\\n\\n    missing_refs = [item[\\\"item_id\\\"] for item in queue.get(\\\"items\\\", {}).values()\\n                    if item.get(\\\"status\\\") == \\\"open\\\" and not item.get(\\\"source_refs\\\")]\\n    add(\\\"repair-evidence-availability\\\", \\\"BLOCKED\\\" if missing_refs else \\\"PASS\\\",\\n        f\\\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\\\",\\n        [run_dir / \\\"repair-queue.json\\\"], \\\"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\\\" if missing_refs else \\\"No missing repair evidence references.\\\")\\n    checks[-1][\\\"affected_item_ids\\\"] = missing_refs\\n    open_items = [item[\\\"item_id\\\"] for item in queue.get(\\\"items\\\", {}).values() if item.get(\\\"status\\\") == \\\"open\\\"]\\n    add(\\\"unresolved-repairs\\\", \\\"BLOCKED\\\" if open_items else \\\"PASS\\\", f\\\"{len(open_items)} repair items remain open\\\",\\n        [run_dir / \\\"repair-queue.json\\\", run_dir / \\\"follow-up-drafts.md\\\"],\\n        \\\"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\\\" if open_items else \\\"No open repairs.\\\")\\n    checks[-1][\\\"affected_item_ids\\\"] = open_items\\n\\n    def csv_contract():\\n        require(snapshots, \\\"No verified snapshot chain\\\")\\n        with (run_dir / \\\"claims.csv\\\").open(encoding=\\\"utf-8\\\", newline=\\\"\\\") as stream:\\n            reader = csv.DictReader(stream)\\n            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \\\"claims.csv header must match the exact required columns\\\")\\n            rows = list(reader)\\n        claims = json.loads(snapshots[-1].read_text())[\\\"claims\\\"]\\n        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \\\"Missing or duplicated claim rows\\\")\\n        by_id = {c[\\\"claim_id\\\"]: c for c in claims}\\n        for row in rows:\\n            require(None not in row and all(v is not None for v in row.values()), \\\"Malformed CSV row\\\")\\n            claim = by_id[row[\\\"claim_id\\\"]]\\n            for field in (\\\"revision\\\", \\\"trip_id\\\", \\\"paid_cents\\\", \\\"balance_cents\\\"):\\n                require(row[field] == (\\\"\\\" if claim[field] is None else str(claim[field])), f\\\"CSV {field} differs from latest snapshot\\\")\\n            require(row[\\\"allowed_cents\\\"] == \\\"\\\" and row[\\\"status\\\"] == \\\"pending\\\", \\\"Offline CSV asserts unsupported entitlement/status\\\")\\n            open_claim_repairs = [item for item in queue.get(\\\"items\\\", {}).values()\\n                                 if item[\\\"subject_type\\\"] == \\\"claim\\\" and item[\\\"subject_id\\\"] == row[\\\"claim_id\\\"] and item[\\\"status\\\"] == \\\"open\\\"]\\n            owner = open_claim_repairs[0][\\\"owner\\\"] if open_claim_repairs else claim[\\\"next_owner\\\"]\\n            reason = open_claim_repairs[0][\\\"missing_or_return_reason\\\"] if open_claim_repairs else \\\"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\\\"\\n            require(row[\\\"next_owner\\\"] == (owner or \\\"\\\") and row[\\\"reason\\\"] == reason, \\\"CSV owner/reason differs from current repair evidence\\\")\\n    check(\\\"claims-csv-contract\\\", [run_dir / \\\"claims.csv\\\"], csv_contract)\\n\\n    def report_trace():\\n        require(snapshots and queue, \\\"Verified snapshots and queue required\\\")\\n        paths = {\\\"claims\\\": run_dir / \\\"claims.csv\\\", \\\"state\\\": run_dir / \\\"offline-replay-state.json\\\",\\n                 \\\"queue\\\": run_dir / \\\"repair-queue.json\\\", \\\"drafts\\\": run_dir / \\\"follow-up-drafts.md\\\"}\\n        expected = _report(run_id=state[\\\"run_id\\\"], parsed=parsed, snapshots=snapshots,\\n                           latest={\\\"domain\\\": {\\\"repair_queue\\\": queue}}, output_paths=paths)\\n        require((run_dir / \\\"report.md\\\").read_text() == expected, \\\"Report differs from evidence-derived handoff (sections, references, owners or actions)\\\")\\n    check(\\\"report-traceability\\\", [run_dir / \\\"report.md\\\"], report_trace)\\n\\n    def drafts_status():\\n        require(queue, \\\"Verified queue required\\\")\\n        expected, _ = render_follow_up_drafts(run_id=state[\\\"run_id\\\"], queue=queue, blockers=parsed.get(\\\"unresolved_issues\\\", []))\\n        require((run_dir / \\\"follow-up-drafts.md\\\").read_text() == expected, \\\"Drafts differ from unresolved evidence or human-review/unsent labels\\\")\\n    check(\\\"follow-up-draft-status\\\", [run_dir / \\\"follow-up-drafts.md\\\"], drafts_status)\\n    issues = parsed.get(\\\"unresolved_issues\\\", [])\\n    def blocker_shape():\\n        require(isinstance(issues, list), \\\"unresolved_issues must be an array\\\")\\n        for issue in issues:\\n            require(isinstance(issue, dict) and all(isinstance(issue.get(field), str) and issue[field] for field in\\n                    (\\\"record_id\\\", \\\"subject_type\\\", \\\"subject_id\\\", \\\"owner\\\", \\\"reason\\\", \\\"next_action\\\")), \\\"Malformed external blocker\\\")\\n    check(\\\"external-blocker-traceability\\\", [run_dir / \\\"parsed-records.json\\\"], blocker_shape)\\n    for issue in issues if isinstance(issues, list) else []:\\n        if not isinstance(issue, dict) or not all(field in issue for field in (\\\"record_id\\\", \\\"reason\\\", \\\"next_action\\\")):\\n            continue\\n        if issue.get(\\\"status\\\", \\\"open\\\") == \\\"open\\\":\\n            add(f\\\"external-blocker:{issue['record_id']}\\\", \\\"BLOCKED\\\", issue[\\\"reason\\\"],\\n                [run_dir / \\\"parsed-records.json\\\"], issue[\\\"next_action\\\"])\\n\\n    def git(*args):\\n        result = subprocess.run([\\\"git\\\", \\\"-C\\\", str(repo_dir), *args], capture_output=True, text=True, check=True)\\n        return result.stdout.strip()\\n    try:\\n        settings = json.loads((repo_dir / \\\".entire/settings.json\\\").read_text())\\n        head = git(\\\"rev-parse\\\", \\\"HEAD\\\")\\n        message = git(\\\"log\\\", \\\"-1\\\", \\\"--format=%B\\\")\\n        worktree_status = git(\\\"status\\\", \\\"--short\\\")\\n        ids = [line.split(\\\":\\\", 1)[1].strip() for line in message.splitlines() if line.startswith(\\\"Entire-Checkpoint:\\\")]\\n        refs = git(\\\"for-each-ref\\\", \\\"--format=%(refname) %(objectname)\\\", \\\"refs/entire/checkpoints\\\").splitlines()\\n        matches = [line for line in refs if any(line.split()[0].endswith('/' + identity) for identity in ids)]\\n        require(settings.get(\\\"enabled\\\") is True and ids and matches, \\\"Enabled Entire.io and HEAD checkpoint reference required\\\")\\n        for match in matches:\\n            git(\\\"cat-file\\\", \\\"-e\\\", match.split()[1])\\n            metadata = json.loads(git(\\\"show\\\", match.split()[1] + \\\":metadata.json\\\"))\\n            require(isinstance(metadata, dict) and metadata, \\\"Checkpoint metadata is empty or invalid\\\")\\n    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:\\n        add(\\\"entire-local-evidence\\\", \\\"BLOCKED\\\", str(exc), [repo_dir / \\\".entire/settings.json\\\", repo_dir / \\\".git\\\"],\\n            \\\"Enable Entire.io and preserve a commit-linked local checkpoint; verify remote synchronization separately.\\\")\\n        head, matches, worktree_status = None, [], \\\"not_checked\\\"\\n    else:\\n        add(\\\"entire-local-evidence\\\", \\\"PASS\\\", f\\\"HEAD {head}; local checkpoint refs: {'; '.join(matches)}. Remote synchronization is not checked.\\\",\\n            [repo_dir / \\\".entire/settings.json\\\", repo_dir / \\\".git\\\"], \\\"Verify remote refs separately before submission; local evidence does not prove remote synchronization.\\\")\\n\\n    status = \\\"FAIL\\\" if any(c[\\\"status\\\"] == \\\"FAIL\\\" for c in checks) else \\\"BLOCKED\\\" if any(c[\\\"status\\\"] == \\\"BLOCKED\\\" for c in checks) else \\\"PASS\\\"\\n    return dict(report_version=\\\"project-d-readiness/1\\\", run_id=manifest.get(\\\"run_id\\\"), run_dir=str(run_dir),\\n                status=status, integrity_status=\\\"FAIL\\\" if status == \\\"FAIL\\\" else \\\"PASS\\\", execution_mode=mode,\\n                final_live_source_compliance=False, assignment_scope=\\\"Retained README, skill, schema and interview only; full native assignment page not verified\\\",\\n                entire_remote_sync=\\\"not_checked\\\", git_head=head, worktree_status=worktree_status,\\n                checkpoint_scope=\\\"Local HEAD checkpoint only; uncommitted changes are not certified as submitted\\\", checks=checks)\\n\\n\\ndef readiness_summary(report: dict[str, Any]) -> str:\\n    lines = [\\\"# Project D submission readiness\\\", \\\"\\\", f\\\"**{report['status']}** — mode: `{report['execution_mode']}`.\\\", \\\"\\\",\\n             \\\"Structural evidence only. Final live-source compliance: **not established**.\\\", \\\"\\\",\\n             report[\\\"assignment_scope\\\"], \\\"\\\", report[\\\"checkpoint_scope\\\"], \\\"\\\"]\\n    for row in report[\\\"checks\\\"]:\\n        lines.extend([f\\\"- **{row['status']}** `{row['check']}`: {row['detail']}\\\",\\n                      \\\"  - Evidence: \\\" + \\\"; \\\".join(f\\\"`{path}`\\\" for path in row[\\\"evidence_paths\\\"]),\\n                      f\\\"  - Next action: {row['next_action']}\\\"])\\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\ndef write_readiness_reports(report: dict[str, Any], output_dir: Path) -> None:\\n    \\\"\\\"\\\"Exclusive directory creation prevents overwriting prior validation evidence.\\\"\\\"\\\"\\n    output_dir.mkdir(parents=True, exist_ok=False)\\n    (output_dir / \\\"readiness.json\\\").write_text(json.dumps(report, indent=2, ensure_ascii=False) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\n    (output_dir / \\\"readiness.md\\\").write_text(readiness_summary(report), encoding=\\\"utf-8\\\")\\n\\\"\\\"\\\"Readiness preserves the distinction between evidence integrity and authority.\\\"\\\"\\\"\\n\\nimport hashlib\\nimport json\\nimport subprocess\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom test_offline_replay import _capture, SCHEMA\\nfrom travel_claim.cli import main\\nfrom travel_claim.offline_replay import run_offline_replay\\nfrom travel_claim.readiness import validate_readiness\\n\\n\\ndef _repo(tmp_path):\\n    repo = tmp_path / \\\"repo\\\"\\n    repo.mkdir()\\n    def git(*args):\\n        return subprocess.run([\\\"git\\\", \\\"-C\\\", str(repo), *args], check=True, capture_output=True, text=True).stdout.strip()\\n    git(\\\"init\\\")\\n    git(\\\"config\\\", \\\"user.name\\\", \\\"Synthetic Test\\\")\\n    git(\\\"config\\\", \\\"user.email\\\", \\\"synthetic@example.invalid\\\")\\n    (repo / \\\".entire\\\").mkdir()\\n    (repo / \\\".entire/settings.json\\\").write_text('{\\\"enabled\\\": true}')\\n    (repo / \\\"metadata.json\\\").write_text('{\\\"synthetic_fixture\\\": true}')\\n    git(\\\"add\\\", \\\".\\\")\\n    git(\\\"commit\\\", \\\"-m\\\", \\\"Synthetic evidence\\\\n\\\\nEntire-Checkpoint: TEST-CHECKPOINT\\\")\\n    git(\\\"update-ref\\\", \\\"refs/entire/checkpoints/NT/TEST-CHECKPOINT\\\", \\\"HEAD\\\")\\n    return repo\\n\\n\\ndef _run(tmp_path, *, complete=False, repairs=False):\\n    run, _ = _capture(tmp_path)\\n    manifest_path = run / \\\"sources.json\\\"\\n    manifest = json.loads(manifest_path.read_text())\\n    parsed_path = run / \\\"parsed-records.json\\\"\\n    parsed = json.loads(parsed_path.read_text())\\n    if complete:\\n        # Synthetic fixture values only; never used for the real retained run.\\n        policy_path = run / \\\"sources/policy-pol-2026-2.html\\\"\\n        body = b\\\"<html>POL-2026.2 synthetic reimbursement fixture</html>\\\"\\n        policy_path.write_bytes(body)\\n        manifest[\\\"files\\\"][0].update(path=\\\"sources/policy-pol-2026-2.html\\\", sha256=hashlib.sha256(body).hexdigest(),\\n                                    status=\\\"read\\\", error=None, missing_scope=[], version=\\\"synthetic\\\")\\n        manifest[\\\"case_clock\\\"] = \\\"2026-09-01T00:00:00Z\\\"\\n        parsed.update(case_clock=manifest[\\\"case_clock\\\"], case_clock_issue=None, unresolved_issues=[])\\n    manifest_path.write_text(json.dumps(manifest))\\n    parsed[\\\"source_manifest\\\"][\\\"sha256\\\"] = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\\n    if not repairs:\\n        parsed[\\\"records\\\"] = {name: [] for name in parsed[\\\"records\\\"]}\\n    else:\\n        # Give fixture records authentic bindings to fixture retained bytes.\\n        for kind, rows in parsed[\\\"records\\\"].items():\\n            source = manifest[\\\"files\\\"][1 if kind == \\\"claim_revisions\\\" else 4]\\n            for row in rows:\\n                row.update(source_id=source[\\\"source_id\\\"], source_sha256=source[\\\"sha256\\\"])\\n    parsed_path.write_text(json.dumps(parsed))\\n    run_offline_replay(run, schema_path=SCHEMA)\\n    return run\\n\\n\\ndef _checks(result):\\n    return {row[\\\"check\\\"]: row[\\\"status\\\"] for row in result[\\\"checks\\\"]}\\n\\n\\ndef test_complete_structural_package_passes_integrity_but_offline_is_never_live_compliance(tmp_path):\\n    run = _run(tmp_path, complete=True)\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    assert result[\\\"status\\\"] == \\\"BLOCKED\\\"\\n    assert result[\\\"integrity_status\\\"] == \\\"PASS\\\"\\n    assert result[\\\"final_live_source_compliance\\\"] is False\\n    assert _checks(result)[\\\"authoritative-case-clock\\\"] == \\\"PASS\\\"\\n    assert all(_checks(result)[f\\\"source-completeness:{row['source_id']}\\\"] == \\\"PASS\\\"\\n               for row in json.loads((run / \\\"sources.json\\\").read_text())[\\\"files\\\"])\\n    assert _checks(result)[\\\"execution-scope\\\"] == \\\"BLOCKED\\\"\\n    assert _checks(result)[\\\"entire-local-evidence\\\"] == \\\"PASS\\\"\\n    assert result[\\\"entire_remote_sync\\\"] == \\\"not_checked\\\"\\n    assert all(row[\\\"evidence_paths\\\"] and row[\\\"next_action\\\"] for row in result[\\\"checks\\\"])\\n\\n\\ndef test_policy_clock_and_unresolved_repairs_are_blocked_not_passed(tmp_path):\\n    run = _run(tmp_path, repairs=True)\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    checks = _checks(result)\\n    assert result[\\\"status\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"source-completeness:policy-pol-2026-2\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"authoritative-case-clock\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"external-blocker:scenario-case-clock\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"external-blocker:reimbursement-policy-pol-2026-2\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"unresolved-repairs\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"repair-evidence-availability\\\"] == \\\"BLOCKED\\\"\\n    assert checks[\\\"repair-queue-traceability\\\"] == \\\"PASS\\\"\\n\\n\\n@pytest.mark.parametrize(\\\"missing\\\", [\\\"report.md\\\", \\\"claims.csv\\\", \\\"sources.json\\\", \\\"offline-replay-state.json\\\", \\\"batches/arrival-002.json\\\"])\\ndef test_incomplete_package_fails_with_evidence_and_next_action(tmp_path, missing):\\n    run = _run(tmp_path)\\n    (run / missing).unlink()\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    assert result[\\\"status\\\"] == \\\"FAIL\\\"\\n    assert result[\\\"integrity_status\\\"] == \\\"FAIL\\\"\\n    assert any(row[\\\"status\\\"] == \\\"FAIL\\\" and row[\\\"evidence_paths\\\"] and row[\\\"next_action\\\"] for row in result[\\\"checks\\\"])\\n\\n\\n@pytest.mark.parametrize(\\\"target,expected\\\", [\\n    (\\\"source\\\", \\\"manifest-integrity\\\"), (\\\"snapshot\\\", \\\"snapshot-chain\\\"),\\n    (\\\"orphan\\\", \\\"snapshot-chain\\\"), (\\\"terminal-snapshot\\\", \\\"snapshot-content-evidence\\\"), (\\\"header\\\", \\\"claims-csv-contract\\\"),\\n    (\\\"csv-money\\\", \\\"claims-csv-contract\\\"), (\\\"report\\\", \\\"report-traceability\\\"),\\n    (\\\"draft\\\", \\\"follow-up-draft-status\\\"), (\\\"queue\\\", \\\"repair-queue-traceability\\\"),\\n    (\\\"reference\\\", \\\"repair-queue-traceability\\\"), (\\\"locator\\\", \\\"repair-queue-traceability\\\"),\\n    (\\\"fresh-marker\\\", \\\"input-bindings\\\"),\\n    (\\\"parsed\\\", \\\"input-bindings\\\"),\\n])\\ndef test_tampered_evidence_fails(tmp_path, target, expected):\\n    run = _run(tmp_path, repairs=True)\\n    if target == \\\"source\\\":\\n        (run / \\\"sources/initial-claim-binder.pdf\\\").write_bytes(b\\\"tampered\\\")\\n    elif target == \\\"snapshot\\\":\\n        path = run / \\\"batches/arrival-001.json\\\"\\n        path.write_text(path.read_text() + \\\"\\\\n\\\")\\n    elif target == \\\"terminal-snapshot\\\":\\n        path = run / \\\"batches/arrival-002.json\\\"\\n        snapshot = json.loads(path.read_text())\\n        snapshot[\\\"issues\\\"][0][\\\"reason\\\"] = \\\"tampered but schema-valid issue\\\"\\n        path.write_text(json.dumps(snapshot))\\n    elif target == \\\"orphan\\\":\\n        (run / \\\"batches/orphan.json\\\").write_text('{}')\\n    elif target == \\\"header\\\":\\n        path = run / \\\"claims.csv\\\"\\n        path.write_text(path.read_text().replace(\\\"claim_id,revision\\\", \\\"revision,claim_id\\\", 1))\\n    elif target == \\\"csv-money\\\":\\n        path = run / \\\"claims.csv\\\"\\n        path.write_text(path.read_text().replace(\\\"1250\\\", \\\"9999\\\"))\\n    elif target == \\\"report\\\":\\n        path = run / \\\"report.md\\\"\\n        path.write_text(path.read_text().replace(\\\"Exercise facilitator\\\", \\\"Invented owner\\\"))\\n    elif target == \\\"draft\\\":\\n        path = run / \\\"follow-up-drafts.md\\\"\\n        path.write_text(path.read_text().replace(\\\"HUMAN REVIEW REQUIRED\\\", \\\"READY TO SEND\\\"))\\n    elif target in {\\\"queue\\\", \\\"reference\\\", \\\"locator\\\"}:\\n        path = run / \\\"repair-queue.json\\\"\\n        queue = json.loads(path.read_text())\\n        item = next(iter(queue[\\\"items\\\"].values()))\\n        if target == \\\"queue\\\":\\n            item[\\\"request_draft\\\"][\\\"sent\\\"] = True\\n        elif target == \\\"locator\\\":\\n            manifest = json.loads((run / \\\"sources.json\\\").read_text())\\n            item[\\\"source_refs\\\"] = [\\\"initial-claim-binder@\\\" + manifest[\\\"files\\\"][1][\\\"sha256\\\"] + \\\"#invented page 999\\\"]\\n        else:\\n            item[\\\"source_refs\\\"] = [\\\"initial-claim-binder@\\\" + \\\"0\\\" * 64 + \\\"#page 1\\\"]\\n        path.write_text(json.dumps(queue))\\n        if target in {\\\"reference\\\", \\\"locator\\\"}:\\n            path = run / \\\"offline-replay-state.json\\\"\\n            state = json.loads(path.read_text())\\n            state[\\\"repair_queue\\\"] = {key: value for key, value in queue.items() if key != \\\"by_owner\\\"}\\n            path.write_text(json.dumps(state))\\n    elif target == \\\"fresh-marker\\\":\\n        path = run / \\\"offline-replay-state.json\\\"\\n        obj = json.loads(path.read_text()); obj[\\\"fresh_native_reads_performed\\\"] = True\\n        path.write_text(json.dumps(obj))\\n    else:\\n        path = run / \\\"parsed-records.json\\\"\\n        path.write_text(path.read_text() + \\\"\\\\n\\\")\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    assert result[\\\"status\\\"] == \\\"FAIL\\\"\\n    assert _checks(result)[expected] == \\\"FAIL\\\"\\n\\n\\ndef test_entire_absence_is_blocked_and_cli_preserves_existing_evidence(tmp_path):\\n    run = _run(tmp_path)\\n    before = {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\\n    output = tmp_path / \\\"validation\\\"\\n    assert main([\\\"validate-readiness\\\", str(run), \\\"--repo\\\", str(tmp_path), \\\"--output-dir\\\", str(output)]) == 2\\n    report = json.loads((output / \\\"readiness.json\\\").read_text())\\n    assert _checks(report)[\\\"entire-local-evidence\\\"] == \\\"BLOCKED\\\"\\n    assert \\\"**BLOCKED**\\\" in (output / \\\"readiness.md\\\").read_text()\\n    prior = (output / \\\"readiness.json\\\").read_bytes()\\n    assert main([\\\"validate-readiness\\\", str(run), \\\"--output-dir\\\", str(output)]) == 1\\n    assert (output / \\\"readiness.json\\\").read_bytes() == prior\\n    assert main([\\\"validate-readiness\\\", str(run), \\\"--output-dir\\\", str(run / \\\"validation\\\")]) == 1\\n    assert before == {str(path): path.read_bytes() for path in run.rglob('*') if path.is_file()}\\n\\n\\n@pytest.mark.parametrize(\\\"filename,value\\\", [(\\\"sources.json\\\", {\\\"files\\\": None}), (\\\"parsed-records.json\\\", {\\\"unresolved_issues\\\": None}), (\\\"repair-queue.json\\\", {\\\"items\\\": []}), (\\\"offline-replay-state.json\\\", [])])\\ndef test_malformed_inputs_produce_fail_report_instead_of_crashing(tmp_path, filename, value):\\n    run = _run(tmp_path)\\n    (run / filename).write_text(json.dumps(value))\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=tmp_path)\\n    assert result[\\\"status\\\"] == \\\"FAIL\\\"\\n\\n\\ndef test_cli_failed_validation_still_writes_both_readiness_reports(tmp_path):\\n    run = _run(tmp_path)\\n    (run / \\\"claims.csv\\\").write_text(\\\"wrong,header\\\\n\\\")\\n    output = tmp_path / \\\"failed-validation\\\"\\n    assert main([\\\"validate-readiness\\\", str(run), \\\"--repo\\\", str(tmp_path), \\\"--output-dir\\\", str(output)]) == 1\\n    assert json.loads((output / \\\"readiness.json\\\").read_text())[\\\"status\\\"] == \\\"FAIL\\\"\\n    assert \\\"**FAIL**\\\" in (output / \\\"readiness.md\\\").read_text()\\nmain\\nefc7e91 feat: generate owner-specific Project D follow-up drafts\\n#!/bin/sh\\n# Entire CLI hooks\\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \\\"$1\\\" \\\"$2\\\" 2>/dev/null || true; else :; fi\\n#!/bin/sh\\n# Entire CLI hooks\\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\\n#!/bin/sh\\n# Entire CLI hooks\\n# Pre-push hook: push session logs alongside user's push\\n# $1 is the remote name (e.g., \\\"origin\\\")\\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \\\"$1\\\"; else :; fi\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13beb-f5b1-7430-847f-20bf35334bf7","create_time":1792006689.703435}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
