ed\",\n              \"confirmed\"\n            ]\n          },\n          \"admitted_cancellation_event_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"description\": \"Only lawfully admitted Travel cancellations activity IDs, retaining initiation/confirmation identity and authority through the bound source records.\"\n          },\n          \"requested_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"confirmed_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"effective_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"affected_claim_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"original_request_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"financial_status\": {\n            \"enum\": [\n              \"no-financial-effect\",\n              \"unresolved\",\n              \"resolved\"\n            ]\n          },\n24:    \"ordinary-workflow.json\", \"ordinary-workflow-demo.md\",\n217:        obj = objects['ordinary-workflow.json']\n228:        require((run_dir / 'ordinary-workflow-demo.md').read_text() == ordinary_demo(current), \"Ordinary demonstration differs from retained stage evidence\")\n229:    check('ordinary-workflow-traceability', [run_dir / 'ordinary-