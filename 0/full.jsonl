'authorized_obligation_cents']=authorization['amount_cents'] if authorization else None\n            request['authorized_balance_cents']=result.get('balance_cents') if authorization else None\n    domain.setdefault('budget_history',[]).append({'batch_id':batch_id,'budget':deepcopy(budgets)})\n    for claim_id,workflow in domain['ordinary_workflows'].items():\n        for n,issue in enumerate(workflow['budget_view']['issues']):\n            item_id=f\"budget-detail:{claim_id}:r{workflow['revision']}:{_digest(issue['reason'])[:12]}\"\n            _open_issue_for_subject(domain['repair_queue'],item_id=item_id,subject_type='claim',subject_id=claim_id,\n                revision=workflow['revision'],refs=issue['source_refs'],reason=issue['reason'],owner=issue['owner'],\n                next_action=issue['next_action'],run_id=run_id,batch_id=batch_id)\n        current={_digest(i['reason'])[:12] for i in workflow['budget_view']['issues']}\n        for item_id,item in domain['repair_queue']['items'].items():\n            if item_id.startswith(f\"budget-detail:{claim_id}:r{workflow['revision']}:\") and item_id.rsplit(':',1)[-1] not in current:\n                record_evidence_validation(domain['repair_queue'],item_id=item_id,supported=True,\n                    source_refs=workflow['budget_view']['source_refs'],run_id=run_id,batch_id=batch_id)\n    record_executed_rechecks(domain, before_batch, batch_id=batch_id)\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n    # deliberately remain outside any fabricated claim/decision outcome.\n    blockers = []\n    for row in parsed.get(\"unresolved_issues\", []):\n        blocker = {\n            \"record_id\": row[\"record_id\"],\n            \"reason\": row.get(\"reason\", \"Unresolved source issue\"),\n            \"owner\": row.get(\"owner\", \"Exercise facilitator\"),\n            \"resolution_needed\": row.get(\"next_action\", \"Obtain the missing authoritative evidence\"),\n            \"subject_type\": row.get(\"subject_type\"),\n            \"subject_id\": row.get(\"subject_id\"),\n            \"affected_scope\": row.get(\"affected_scope\"),\n            \"evidence_needed\": row.get(\"evidence_needed\"),\n        }\n        blockers.append(blocker)\n    domain[\"policy_clock_blockers\"] = blockers\n\n    _sync_ordinary_repairs(domain, run_id=run_id, batch_id=batch_id)\n    schema_issues = list(blockers) + list(domain.get(\"structural_blockers\", []))\n    schema_issues.extend(_issue_from_item(item) for item in domain[\"repair_queue\"][\"items\"].values() if item[\"status\"] == \"open\")\n    # Every cancellation issue reference must resolve in issues[].record_id.\n    known_issue_ids = {issue[\"record_id\"] for issue in schema_issues}\n    for cancellation in cancellation_rows:\n        cancellation[\"issue_record_ids\"] = [\n            issue_id for issue_id in cancellation[\"issue_record_ids\"] if issue_id in known_issue_ids\n        ]\n\n    snapshot_claims = []\n    projection_issues = []\n    for claim_id, revision_row in sorted(current_claims.items()):\n        revision = revision_row[\"revision\"]\n        record = revision_row[\"record\"]\n        values = _page_values(record)\n        trip_id = revision_row.get(\"trip_id\")\n\"\"\"Executed correction checks, with immutable evidence and monetary history.\"\"\"\nfrom copy import deepcopy\n\nfrom .ordinary import expense_lines, fields, ref\n\n\ndef correction_changes(before, after):\n    \"\"\"Compare actual claim facts, including evidence changes with unchanged totals.\"\"\"\n    old, new = fields(before), fields(after)\n    changes = {key: {'before': old.get(key), 'after': new.get(key)}\n               for key in sorted(set(old) | set(new))\n               if old.get(key) != new.get(key) and key not in {'Revision', 'Arrival batch'}}\n    previous = {line['cost_id']: line for line in expense_lines(before)}\n    current = {line['cost_id']: line for line in expense_lines(after)}\n    # Source references change with the revision even when the line facts do not.\n    def facts(line):\n        return {k: v for k, v in line.items() if k != 'source_refs'} if line else None\n    lines = [{'cost_id': key, 'before': facts(previous.get(key)), 'after': facts(current.get(key)),\n              'changed': facts(previous.get(key)) != facts(current.get(key))}\n             for key in sorted(set(previous) | set(current))]\n    return {'fields': changes, 'expense_lines': lines,\n            'unchanged_cost_ids': [line['cost_id'] for line in lines if not line['changed']],\n            'source_refs': [ref(before), ref(after)]}\n\n\ndef record_executed_rechecks(domain, previous_domain, *, batch_id):\n    \"\"\"Called after connect_claim and Finance reconciliation actually execute.\"\"\"\n    for correction in domain['material_corrections']:\n        claim_id = correction['claim_id']\n        workflow = domain['ordinary_workflows'][claim_id]\n        if workflow['revision'] != correction['to_revision']:\n            continue\n        if correction['arrival_batch'] == batch_id:\n            revisions = domain['revision_history']['claim'][claim_id]['revisions']\n            before = next(r['record'] for r in revisions if r['revision'] == correction['from_revision'])\n            after = next(r['record'] for r in reversed(revisions) if r['revision'] == correction['to_revision'])\n            correction['changed_dependencies'] = correction_changes(before, after)\n            old = previous_domain.get('ordinary_workflows', {}).get(claim_id)\n            correction['before_workflow'] = deepcopy(old)\n            correction['before_finance'] = deepcopy(previous_domain.get('finance_reconciliations', {}).get(claim_id))\n        correction.setdefault('executed_rechecks', []).append({\n            'batch_id': batch_id, 'revision': workflow['revision'],\n            'checks': deepcopy(workflow['stages']),\n            'lines': deepcopy(workflow['lines']),\n            'observed_reviews': deepcopy(workflow['observed_reviews']),\n            'request': deepcopy(workflow['request']),\n            'finance': deepcopy(domain['finance_reconciliations'][claim_id]),\n            'status': workflow['status'],\n            'basis': 'Current-revision ordinary evidence, approval, request and Finance checks executed; no human response created',\n        })\n\n\ndef verification_document(domain, cancellations, *, run_id):\n    data = {'run_id': run_id, 'mode': 'offline-replay', 'fresh_native_reads_performed': False,\n            'corrections': deepcopy(domain['material_corrections']),\n            'cancellations': deepcopy(cancellations),\n            'cancellation_evidence': deepcopy(domain.get('cancellation_evidence', {})),\n            'cancellation_issues': deepcopy(domain['cancellation_state']['issues'])}\n    lines = ['# Correction and cancellation verification — OFFLINE REPLAY', '',\n             'Retained evidence only. No fresh source execution, approvals, requests or payments generated.',\n             'PASS means the stated local evidence check passed; BLOCKED requires the named evidence or authority.', '',\n             '## Executed correction rechecks', '']\n    for correction in data['corrections']:\n        latest = correction['executed_rechecks'][-1]\n        lines += [f\"### {correction['claim_id']} r{correction['from_revision']} → r{correction['to_revision']}\", '',\n                  f\"Arrival: {correction['arrival_batch']}. Changed facts: `{correction['changed_dependencies']}`\", '',\n                  f\"Historical reviews excluded from current authority: {', '.join(correction['invalidated_decision_ids']) or 'none observed'}.\", '',\n                  '| Executed check | Result | Next action |', '|---|---|---|']\n        for check in latest['checks']:\n            lines.append(f\"| {check['stage']} | {check['status']} | {check['owner']}: {check['next_action']} |\")\n        lines += ['', 'Executed check evidence:', '']\n        for check in latest['checks']:\n            lines.append(f\"- {check['stage']}: {'; '.join(check['source_refs'])}\")\n        old = correction.get('before_finance') or {}\n        new = latest['finance']\n        lines += ['', f\"Known net cash cents: {old.get('net_confirmed_cents')} → {new['net_confirmed_cents']}; \"\n                  f\"recorded ledger difference cents: {old.get('recorded_ledger_balance_cents')} → {new['recorded_ledger_balance_cents']}. \"\n                  'Recorded ledger agreement does not prove current entitlement or closure.', '']\n    lines += ['## Independent cancellation processes', '']\n    for cancellation in cancellations:\n        detail = data['cancellation_evidence'][cancellation['cancellation_id']]\n        lines += [f\"### {cancellation['cancellation_id']} — {cancellation['target_type']}\", '',\n                  f\"State history: {' → '.join(h['action'] for h in detail['history'])}. \"\n                  f\"Current linked claims: {detail['current_claim_ids']}; historical linked claims: {cancellation['affected_claim_ids']}. \"\n                  f\"Observed request IDs: {cancellation['original_request_ids']}.\", '',\n                  f\"Actor verification: {detail['actor_status']}. Finance disposition: {detail['disposition_status']}. \"\n                  f\"Financial completion: {cancellation['financial_status']}; next owner: Finance.\", '',\n                  f\"Source references: {'; '.join(detail['source_refs'])}\", '',\n                  f\"Recorded dispositions (not full claim closure): `{detail['dispositions']}`\", '']\n    lines += ['## Remaining external blockers', '',\n              'The native Notion policy remains inaccessible and the authoritative case clock remains unconfirmed. '\n              'Policy eligibility, current authorization and final closure remain pending where unsupported. '\n              'A cancelled transfer is a noncash event; only confirmed payments and linked refunds affect cash.', '']\n    return data, '\\n'.join(lines)\n\"\"\"POL-2026.2 completion regressions; all changed facts are SYNTHETIC.\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_expenses import setfield\nfrom test_revalidation import corrected\nfrom travel_claim.approvals import table, fields\n\n\ndef activity(p, identity, kind, batch=3, time='2026-09-13T12:00:00', amount=None, obligation=None, revision=1, **extra):\n    event=deepcopy(p['records']['finance_events'][0])\n    for key in ['Amount (EUR)','Obligation (EUR)','Original activity reference']:\n        event['values'].pop(key,None)\n    values={'Activity reference':identity,'Activity type':kind,'Arrival batch':batch,\n            'Activity time (UTC)':time,'Claim revision':revision}\n    if amount is not None:values['Amount (EUR)']=amount\n    if obligation is not None:values['Obligation (EUR)']=obligation\n    values.update(extra)\n    for key,value in values.items():setfield(event,key,value)\n    p['records']['finance_events'].append(event)\n    return event\n\n\ndef cancellation(p, *, confirmation='2026-09-05T12:00:00', amount='100.00', reviews='2026-09-06T12:00:00'):\n    source=json.loads((Path(__file__).parent/'fixtures/retained_finance_records.json').read_text())\n    rows=[deepcopy(r) for r in source['records']['cancellation_activities'] if fields(r).get('Cancellation reference')=='TC018'][:2]\n    for r in rows:\n        r.update(source_id='synthetic-travel-registers-workbook',source_sha256=p['records']['trips'][0]['source_sha256'])\n        action=fields(r)['Action']\n        values={'Cancellation activity reference':'SYN-CANCEL-'+action,'Cancellation reference':'TC-SYN',\n            'Trip reference':'T01','Trip revision':1,'Permit reference':None,'Permit revision':None,\n            'Cancelled subject':'trip','Arrival batch':1 if confirmation<'2026-09-11' else 3,\n            'Acting employee or supervisor':'EMP-01' if action=='requested' else 'SUP-01',\n            'Activity time (UTC)':'2026-09-04T12:00:00' if action=='requested' else confirmation,\n            'Initiation activity reference':None if action=='requested' else 'SYN-CANCEL-requested',\n            'Effective time (UTC)':None if action=='requested' else confirmation}\n        for key,value in values.items():setfield(r,key,value)\n    p['records']['cancellation_activities']=rows\n    claim=p['records']['claim_revisions'][0]\n    for key,value in {'Authorizing Finance officer':'FIN-01','Applies to claim':'SYN-C01','Applies to revision':'1',\n        'Expense reference':'COST-01','Allowed original amount':amount,'Exception reason':'SYNTHETIC cancellation disposition',\n        'Covered issues':'travel_cancellation','Travel cancellation reference':'TC-SYN'}.items():setfield(claim,key,value)\n    for d in p['records']['decisions']:setfield(d,'Decision time (UTC)',reviews)\n    for packet in table(p,'review_packets','Review packets'):setfield(packet,'Travel cancellation references','TC-SYN')\n    setfield(p['records']['reimbursement_requests'][0],'Amount (EUR)',amount)\n    return rows\n\n\ndef test_verified_policy_date_can_close_without_legacy_synthetic_authority_tables():\n    p=synthetic();p['records'].pop('workflow_policy_rules');p['records'].pop('closure_authorities')\n    p['case_clock']=None;p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\n\n\ndef test_supported_personal_zero_closes_without_inventing_finance_request():\n    p=synthetic();setfield(p['records']['receipts'][0],'Category','personal')\n    p['records']['finance_events']=[];p['records']['reimbursement_requests']=[]\n    r=batches(p)[-1];w=workflow(r)\n    assert w['allowed_cents']==0 and w['status']=='closed-no-payment'\n    assert w['request'] is None and w['balance_cents']==0\n    assert r['finance_reconciliations']['SYN-C01']['admitted_events']=={}\n\n92:            event['obligation_cents'] = 0  # Request-bound cancellation is noncash commitment release.\n107:            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n115:        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n169:    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\n205:    prior = deepcopy((previous_reconciliation or {}).get('admitted_events', {}))\n216:                \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n414:        \"admitted_events\": deepcopy(admitted),\n"},"started_at_ms":1792063601532,"completed_at_ms":1792063601568}}
