veries=[])\n    from .finance import _cents\n    subject=deepcopy(trip_record)\n    # Newly parsed workbooks retain the printed source version in their preamble.\n    subject['text']='\\n'.join(str(c.get('value','')) for s in parsed.get('workbook_sheets',[])\n        if s.get('source_id')==trip_record.get('source_id') for c in s.get('preamble',[]))\n    result=evaluate_reviews(parsed=parsed,kind='permit',subject_id=trip.get('Permit reference'),revision=_revision(trip.get('Permit revision')),\n        trip_record=trip_record,employee=trip.get('Employee ID'),subject_record=subject,amount_cents=_cents(trip.get('Estimate (EUR)')),\n        decisions=decisions,arrival_batch=arrival_batch,observations=observations,cost_ids=cost_ids,prior=prior,budget_context=budget_context)\n    result['budget_context']=budget_context\n    result['arrangement_authorized']=False\n    if result['approved'] and trip.get('International') is True:\n        commitment=trip.get('First commitment date')\n        if commitment in (None,''):\n            result['arrangement_authorized']=True\n        else:\n            try:\n                day=local_date(commitment)\n                active=[d for d in result['deliveries'] if d['active']]\n                latest=max(utc_time(d['decision_time']) for d in active).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n                result['arrangement_authorized']=latest<day\n                result['timing_finding']=None if latest<day else 'late_permit' if latest>day else 'same-day-order-unconfirmed'\n            except (ValueError,TypeError): result['timing_finding']='missing-commitment-evidence'\n    result['arrangements_at_commitment_supported']=result['arrangement_authorized']\n    affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n        and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))\n        and (c.get('target_type')=='trip' or (c.get('permit_id')==trip.get('Permit reference')\n             and _revision(c.get('permit_revision'))==_revision(trip.get('Permit revision'))))]\n    result['cancellation_ids']=[c['cancellation_id'] for c in affected]\n    if affected: result['arrangement_authorized']=False\n    return result\n","stderr":"","aggregated_output":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n791c8c787bbd617a7b7d3114f13c000249169151\n\"\"\"POL-2026.2 expense arithmetic and local-calendar filing checks.\n\nThe policy is explicitly bound by its original bytes; this does not convert the\nuser's browser copy into a successful native Notion capture or grant approval.\n\"\"\"\nfrom copy import deepcopy\nfrom calendar import monthrange\nfrom datetime import date\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\nimport hashlib\nfrom pathlib import Path\n\nfrom .exceptions import validate_exception, apply_coverage, finding\n\nPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\n\n\ndef load_expense_policy(path):\n    raw = Path(path).read_bytes()\n    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\n        raise ValueError('POL-2026.2 browser copy hash mismatch')\n    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\n                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\n\n\ndef policy_valid(binding):\n    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\n            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\n            and binding.get('sha256') == POLICY_SHA256)\n\n\ndef local_date(value):\n    \"\"\"Accept native local dates and Excel's naive midnight date serialization.\"\"\"\n    text = str(value)\n    if len(text) == 19 and text.endswith('T00:00:00'):\n        text = text[:10]\n    result = date.fromisoformat(text)\n    if result.isoformat() != text:\n        raise ValueError('Not a local calendar date')\n    return result\n\n\ndef filing_deadline(trip_end):\n    end = local_date(trip_end)\n    month = end.year * 12 + end.month - 1 + 2\n    year, zero_month = divmod(month, 12)\n    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\n\n\ndef number(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError('Missing or invalid number')\n    result = Decimal(str(value).replace(',', ''))\n    if not result.is_finite() or result < 0:\n        raise ValueError('Invalid amount')\n    return result\n\n\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\n    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    binding = parsed.get('expense_policy')\n    verified = policy_valid(binding)\n    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    receipts = parsed.get('records', {}).get('receipts', [])\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    rates = table(parsed, 'fx_rates', 'FX')\n    caps = table(parsed, 'caps', 'Caps')\n    observations = parsed.get('source_observations', []) if observations is None else observations\n    people = table(parsed, 'people', 'People')\n    for line in lines:\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n                    filing_status='