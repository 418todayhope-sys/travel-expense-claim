{"timestamp":"2026-10-14T21:10:17.077Z","ordinal":1818,"type":"token_usage_record","payload":{"thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13c40-3bbc-7d50-8ce8-5e7628d5b3da","session_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","root_turn_id":"01a13c40-3bbc-7d50-8ce8-5e7628d5b3da","response_id":"resp_02f4b2bd528e1b90016acfefb582848190b157566d0db1bebe","usage":{"input_tokens":186794,"cached_input_tokens":183808,"cache_write_input_tokens":0,"output_tokens":141,"reasoning_output_tokens":26,"total_tokens":186935},"turn_token_usage":{"input_tokens":370745,"cached_input_tokens":367232,"cache_write_input_tokens":0,"output_tokens":289,"reasoning_output_tokens":26,"total_tokens":371034},"thread_token_usage":{"input_tokens":38125833,"cached_input_tokens":37062144,"cache_write_input_tokens":0,"output_tokens":151869,"reasoning_output_tokens":43579,"total_tokens":38277702}}}
