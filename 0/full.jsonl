])\n   168\t            accepted=[e for e in controls if e['classification']=='obligation_accepted']\n   169\t            if accepted:\n   170\t                req['commitment_cents']=0 if controls[-1]['classification']=='finance_cancelled' else controls[-1]['obligation_cents']\n   171\t                req['acceptance']=deepcopy(accepted[0])\n   172\t            else:issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'missing-acceptance:'+str(request),'Cash/control has no admitted original accepted obligation',req['source_refs'])\n   173\t            opening=entry['opening_obligations'].get(request)\n   174\t            if opening:\n   175\t                # A native opening summary and full event history for the same\n   176\t                # request must agree; neither is an additional obligation.\n   177\t                if (opening['amount_cents'],opening['settled_cents'],opening['refunded_cents'])!=(req['commitment_cents'],req['confirmed_payment_cents'],req['confirmed_refund_cents']):\n   178\t                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'opening-overlap:'+request,'Opening/request overlap lacks an explicit snapshot boundary; totals disagree',opening['source_refs']+req['source_refs'])\n   179\t                entry['opening_obligations'].pop(request)\n   180\t            req['net_paid_cents']=req['confirmed_payment_cents']-req['confirmed_refund_cents']\n   181\t            req['remaining_commitment_cents']=max(0,req['commitment_cents']-req['net_paid_cents']) if req['commitment_cents'] is not None else None\n   182\t            req['recorded_balance_cents']=req['commitment_cents']-req['net_paid_cents'] if req['commitment_cents'] is not None else None\n   183\t    # Raw unmatched/held imports remain reviewable and cannot disappear from scope risk.\n   184\t    represented={e['event_id'] for f in finances.values() for e in f.get('event_history',[])}\n   185\t    for row in raw_finance:\n   275\t    exact=bool(prior and (prior.get('opening_fingerprint')!=opening or prior.get('requires_exact_source')))\n   276\t    ids={r.split('@',1)[0] for r in ledger['source_refs']}\n   277\t    printed=set()\n   278\t    for sheet in parsed.get('workbook_sheets',[]):\n   279\t        if sheet.get('source_id') in ids:\n   280\t            printed.update(versions({'text':'\\n'.join(str(c.get('value','')) for c in sheet.get('preamble',[]))}))\n   281\t    return dict(opening_fingerprint=opening,requires_exact_source=exact,printed_source_versions=sorted(printed))\n   282\t\n   283\t\n   284\tdef claim_budget_view(*,parsed,claim,lines,budgets,attribution,prior=None,arrival_batch):\n   285\t    record=claim['record'];v=fields(record)\n   286\t    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==v.get('Employee')]\n   287\t    person=fields(people[0]) if len(people)==1 else {};scope=scope_id(scope_of(person));ledger=budgets['scopes'].get(scope)\n   288\t    result=dict(scope_id=scope,owner=person.get('Budget owner') or 'Budget owner',status='BLOCKED',issues=[],source_refs=[ref(record)],\n   289\t                prior_committed_cents=0,prior_net_paid_cents=0,remaining_request_cents=None,lines=[])\n   290\t    related=set(str(v.get('Related earlier claims') or '').splitlines())-{'None'}\n   291\t    for line in lines:\n   292\t        others=[x for x in attribution['costs'].get(line['cost_id'],[]) if x['claim_id']!=claim['subject_id'] and x['reserved_cents']>0]\n   293\t        unknown=[x for x in attribution['unallocated_costs'].get(line['cost_id'],[]) if x['claim_id']!=claim['subject_id']]\n   294\t        valid=[x for x in others if x['claim_id'] in related and x['signature']==list(cost_signature(record,line))]\n   295\t        reason=None\n   296\t        if unknown:reason='Shared cost has an aggregate request without supported cost allocation'\n   297\t        if len(valid)!=len(others) or len(valid)>1:reason='Shared cost needs exact earlier-claim/employee/trip/receipt/amount linkage without duplicate commitments'\n   298\t        consumed=sum(x['reserved_cents'] for x in valid)\n   299\t        allowed=line.get('calculated_cents')\n   300\t        if allowed is not None and consumed>allowed:reason='Prior cost commitments/payments exceed current calculated cost; Finance disposition required'\n   301\t        remaining=allowed-consumed if allowed is not None and not reason else None\n   302\t        refs=[r for x in others+unknown for r in x['source_refs']]\n   303\t        result['source_refs']+=refs\n   304\t        if reason:result['issues'].append(dict(reason=reason,source_refs=line['source_refs']+refs,owner='Finance',next_action='Resolve exact cost/request attribution and any adjustment; never prorate or repay an existing cost'))\n   305\t        result['lines'].append(dict(cost_id=line['cost_id'],remaining_request_cents=remaining,prior_reservations=valid,source_refs=line['source_refs']+refs))\n   140\tdef apply_partial_response(\n   141\t    queue: dict,\n   142\t    *,\n   143\t    response_id: str,\n   144\t    item_outcomes: dict[str, dict],\n   145\t    run_id: str,\n   146\t    batch_id: str,\n   147\t) -> None:\n   148\t    \"\"\"Record a supplied response against explicitly matched repair item IDs.\n   149\t\n   150\t    Only `supported` plus at least one retained source reference resolves an\n   151\t    item. Every other outcome remains open. Unmentioned items are untouched.\n   152\t    \"\"\"\n   153\t    allowed = {\"supported\", \"insufficient\", \"conflicting\", \"unanswered\"}\n   154\t    if not response_id:\n   155\t        raise ValueError(\"response_id is required\")\n   156\t    if not isinstance(item_outcomes, dict):\n   157\t        raise ValueError(\"item_outcomes must map repair item IDs to outcomes\")\n   158\t    planned: list[tuple[str, dict, str, list[str], dict | None]] = []\n   159\t    for item_id, outcome in item_outcomes.items():\n   160\t        if item_id not in queue[\"items\"]:\n   161\t            raise KeyError(f\"response references unknown repair item {item_id}\")\n   162\t        if not isinstance(outcome, dict):\n   163\t            raise ValueError(f\"response outcome for {item_id} must be an object\")\n   164\t        kind = outcome.get(\"outcome\")\n   165\t        if kind not in allowed:\n   166\t            raise ValueError(f\"invalid response outcome for {item_id}: {kind!r}\")\n   167\t        refs = outcome.get(\"source_refs\", [])\n   168\t        if not isinstance(refs, list) or not all(isinstance(ref, str) and ref for ref in refs):\n   169\t            raise ValueError(f\"response source_refs must be a list of references for {item_id}\")\n   170\t        if kind == \"supported\" and not refs:\n   171\t            raise ValueError(f\"supported response {item_id} requires source references\")\n   172\t        item = queue[\"items\"][item_id]\n   173\t        if outcome.get(\"note\") is not None and not isinstance(outcome.get(\"note\"), str):\n   174\t            raise ValueError(f\"response note must be a string or null for {item_id}\")\n   175\t        prior_event = next(\n   176\t            (event for event in reversed(queue[\"events\"])\n   177\t             if event.get(\"event\") == \"response-recorded\"\n   178\t             and event.get(\"response_id\") == response_id\n   179\t             and event.get(\"item_id\") == item_id),\n   180\t            None,\n   181\t        )\n   182\t        normalized_refs = list(dict.fromkeys(refs))\n   183\t        if prior_event is not None:\n   184\t            same = (\n   185\t                prior_event.get(\"outcome\") == kind\n   186\t                and prior_event.get(\"source_refs\") == normalized_refs\n   187\t                and prior_event.get(\"note\") == outcome.get(\"note\")\n   188\t            )\n   189\t            if same:\n   190\t                planned.append((item_id, item, kind, normalized_refs, prior_event))\n   191\t                continue\n   192\t            raise ValueError(f\"conflicting replay for repair response {response_id}/{item_id}\")\n   193\t        planned.append((item_id, item, kind, normalized_refs, None))\n   194\t\n   195\t    # Mutate only after every item in this partial response passed validation.\n   196\t    for item_id, item, kind, normalized_refs, prior_event in planned:\n   197\t        if prior_event is not None:\n   198\t            continue\n   199\t        prior = {\n   200\t            \"response_id\": response_id,\n   201\t            \"outcome\": kind,\n   202\t            \"note\": item_outcomes[item_id].get(\"note\"),\n   203\t            \"source_refs\": normalized_refs,\n   204\t            \"run_id\": run_id,\n   205\t            \"batch_id\": batch_id,\n   206\t            \"previous_status\": item[\"status\"],\n   207\t        }\n   208\t        item[\"history\"].append(prior)\n   209\t        item[\"response_id\"] = response_id\n   210\t        if kind == \"supported\":\n   211\t            item[\"status\"] = \"resolved\"\n   212\t            item[\"resolution_source_refs\"] = normalized_refs\n   213\t        else:\n   214\t            item[\"status\"] = \"open\"\n   215\t        queue[\"events\"].append({\n   216\t            \"event\": \"response-recorded\",\n","exit_code":0,"duration":{"secs":0,"nanos":271170460},"formatted_output":"   182\t\n   183\tdef evaluate_permit(*, parsed, trip_record, decisions, arrival_batch, observations, prior=None, cost_ids=(), cancellations=(), budget_context=None):\n   184\t    trip=fields(trip_record)\n   185\t    if trip.get('International') is False:\n   186\t        affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n   187\t            and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))]\n   188\t        return dict(subject_type='permit',subject_id=None,revision=None,state='not-required',approved=True,\n   189\t                    arrangement_authorized=policy_valid(parsed.get('expense_policy')) and not affected,\n   190\t                    arrangements_at_commitment_supported=policy_valid(parsed.get('expense_policy')),\n   191\t                    cancellation_ids=[c['cancellation_id'] for c in affected], source_refs=[ref(trip_record)],deliveries=[])\n   192\t    from .finance import _cents\n   193\t    subject=deepcopy(trip_record)\n   194\t    # Newly parsed workbooks retain the printed source version in their preamble.\n   195\t    subject['text']='\\n'.join(str(c.get('value','')) for s in parsed.get('workbook_sheets',[])\n   196\t        if s.get('source_id')==trip_record.get('source_id') for c in s.get('preamble',[]))\n   197\t    result=evaluate_reviews(parsed=parsed,kind='permit',subject_id=trip.get('Permit reference'),revision=_revision(trip.get('Permit revision')),\n   198\t        trip_record=trip_record,employee=trip.get('Employee ID'),subject_record=subject,amount_cents=_cents(trip.get('Estimate (EUR)')),\n   199\t        decisions=decisions,arrival_batch=arrival_batch,observations=observations,cost_ids=cost_ids,prior=prior,budget_context=budget_context)\n   200\t    result['budget_context']=budget_context\n   201\t    result['arrangement_authorized']=False\n   202\t    if result['approved'] and trip.get('International') is True:\n   203\t        commitment=trip.get('First commitment date')\n   204\t        if commitment in (None,''):\n   205\t            result['arrangement_authorized']=True\n   206\t        else:\n   207\t            try:\n   208\t                day=local_date(commitment)\n   209\t                active=[d for d in result['deliveries'] if d['active']]\n   210\t                latest=max(utc_time(d['decision_time']) for d in active).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n   211\t                result['arrangement_authorized']=latest<day\n   212\t                result['timing_finding']=None if latest<day else 'late_permit' if latest>day else 'same-day-order-unconfirmed'\n   213\t            except (ValueError,TypeError): result['timing_finding']='missing-commitment-evidence'\n   214\t    result['arrangements_at_commitment_supported']=result['arrangement_authorized']\n   215\t    affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n   216\t        and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))\n   217\t        and (c.get('target_type')=='trip' or (c.get('permit_id')==trip.get('Permit reference')\n   218\t             and _revision(c.get('permit_revision'))==_revision(trip.get('Permit revision'))))]\n   219\t    result['cancellation_ids']=[c['cancellation_id'] for c in affected]\n   220\t    if affected: result['arrangement_authorized']=False\n   221\t    return result\n     1\t\"\"\"Executed correction checks, with immutable evidence and monetary history.\"\"\"\n     2\tfrom copy import deepcopy\n     3\t\n     4\tfrom .ordinary import expense_lines, fields, ref\n     5\t\n     6\t\n     7\tdef correction_changes(before, after):\n     8\t    \"\"\"Compare actual claim facts, including evidence changes with unchanged totals.\"\"\"\n     9\t    old, new = fields(before), fields(after)\n    10\t    changes = {key: {'before': old.get(key), 'after': new.get(key)}\n    11\t               for key in sorted(set(old) | set(new))\n    12\t               if old.get(key) != new.get(key) and key not in {'Revision', 'Arrival batch'}}\n    13\t    previous = {line['cost_id']: line for line in expense_lines(before)}\n    14\t    current = {line['cost_id']: line for line in expense_lines(after)}\n    15\t    # Source references change with the revision even when the line facts do not.\n    16\t    def facts(line):\n    17\t        return {k: v for k, v in line.items() if k != 'source_refs'} if line else None\n    18\t    lines = [{'cost_id': key, 'before': facts(previous.get(key)), 'after': facts(current.get(key)),\n    19\t              'changed': facts(previous.get(key)) != facts(current.get(key))}\n    20\t             for key in sorted(set(previous) | set(current))]\n    21\t    return {'fields': changes, 'expense_lines': lines,\n    22\t            'unchanged_cost_ids': [line['cost_id'] for line in lines if not line['changed']],\n    23\t            'source_refs': [ref(before), ref(after)]}\n    24\t\n    25\t\n    26\tdef record_executed_rechecks(domain, previous_domain, *, batch_id):\n    27\t    \"\"\"Called after connect_claim and Finance reconciliation actually execute.\"\"\"\n    28\t    for correction in domain['material_corrections']:\n    29\t        claim_id = correction['claim_id']\n    30\t        workflow = domain['ordinary_workflows'][claim_id]\n    31\t        if workflow['revision'] != correction['to_revision']:\n    32\t            continue\n    33\t        if correction['arrival_batch'] == batch_id:\n    34\t            revisions = domain['revision_history']['claim'][claim_id]['revisions']\n    35\t            before = next(r['record'] for r in revisions if r['revision'] == correction['from_revision'])\n    36\t            after = next(r['record'] for r in reversed(revisions) if r['revision'] == correction['to_revision'])\n    37\t            correction['changed_dependencies'] = correction_changes(before, after)\n    38\t            old = previous_domain.get('ordinary_workflows', {}).get(claim_id)\n    39\t            correction['before_workflow'] = deepcopy(old)\n    40\t            correction['before_finance'] = deepcopy(previous_domain.get('finance_reconciliations', {}).get(claim_id))\n    41\t        correction.setdefault('executed_rechecks', []).append({\n    42\t            'batch_id': batch_id, 'revision': workflow['revision'],\n    43\t            'checks': deepcopy(workflow['stages']),\n    44\t            'lines': deepcopy(workflow['lines']),\n    45\t            'observed_reviews': deepcopy(workflow['observed_reviews']),\n    46\t            'request': deepcopy(workflow['request']),\n    47\t            'finance': deepcopy(domain['finance_reconciliations'][claim_id]),\n    48\t            'status': workflow['status'],\n    49\t            'basis': 'Current-revision ordinary evidence, approval, request and Finance checks executed; no human response created',\n    50\t        })\n    51\t\n    52\t\n    53\tdef verification_document(domain, cancellations, *, run_id):\n    54\t    data = {'run_id': run_id, 'mode': 'offline-replay', 'fresh_native_reads_performed': False,\n    55\t            'corrections': deepcopy(domain['material_corrections']),\n    56\t            'cancellations': deepcopy(cancellations),\n    57\t            'cancellation_evidence': deepcopy(domain.get('cancellation_evidence', {})),\n    58\t            'cancellation_issues': deepcopy(domain['cancellation_state']['issues'])}\n    59\t    lines = ['# Correction and cancellation verification — OFFLINE REPLAY', '',\n    60\t             'Retained evidence only. No fresh source execution, approvals, requests or payments generated.',\n    61\t             'PASS means the stated local evidence check passed; BLOCKED requires the named evidence or authority.', '',\n    62\t             '## Executed correction rechecks', '']\n    63\t    for correction in data['corrections']:\n    64\t        latest = correction['executed_rechecks'][-1]\n    65\t        lines += [f\"### {correction['claim_id']} r{correction['from_revision']} → r{correction['to_revision']}\", '',\n    66\t                  f\"Arrival: {correction['arrival_batch']}. Changed facts: `{correction['changed_dependencies']}`\", '',\n    67\t                  f\"Historical reviews excluded from current authority: {', '.join(correction['invalidated_decision_ids']) or 'none observed'}.\", '',\n    68\t                  '| Executed check | Result | Next action |', '|---|---|---|']\n    69\t        for check in latest['checks']:\n    70\t            lines.append(f\"| {check['stage']} | {check['status']} | {check['owner']}: {check['next_action']} |\")\n    71\t        lines += ['', 'Executed check evidence:', '']\n    72\t        for check in latest['checks']:\n    73\t            lines.append(f\"- {check['stage']}: {'; '.join(check['source_refs'])}\")\n    74\t        old = correction.get('before_finance') or {}\n    75\t        new = latest['finance']\n    76\t        lines += ['', f\"Known net cash cents: {old.get('net_confirmed_cents')} → {new['net_confirmed_cents']}; \"\n    77\t                  f\"recorded ledger difference cents: {old.get('recorded_ledger_balance_cents')} → {new['recorded_ledger_balance_cents']}. \"\n    78\t                  'Recorded ledger agreement does not prove current entitlement or closure.', '']\n    79\t    lines += ['## Independent cancellation processes', '']\n    80\t    for cancellation in cancellations:\n    81\t        detail = data['cancellation_evidence'][cancellation['cancellation_id']]\n    82\t        lines += [f\"### {cancellation['cancellation_id']} — {cancellation['target_type']}\", '',\n    83\t                  f\"State history: {' → '.join(h['action'] for h in detail['history'])}. \"\n    84\t                  f\"Current linked claims: {detail['current_claim_ids']}; historical linked claims: {cancellation['affected_claim_ids']}. \"\n    85\t                  f\"Observed request IDs: {cancellation['original_request_ids']}.\", '',\n    86\t                  f\"Actor verification: {detail['actor_status']}. Finance disposition: {detail['disposition_status']}. \"\n    87\t                  f\"Financial completion: {cancellation['financial_status']}; next owner: Finance.\", '',\n    88\t                  f\"Source references: {'; '.join(detail['source_refs'])}\", '',\n    89\t                  f\"Recorded dispositions (not full claim closure): `{detail['dispositions']}`\", '']\n    90\t    lines += ['## Remaining external blockers', '',\n    91\t              'The native Notion policy remains inaccessible and the authoritative case clock remains unconfirmed. '\n    92\t              'Policy eligibility, current authorization and final closure remain pending where unsupported. '\n    93\t              'A cancelled transfer is a noncash event; only confirmed payments and linked refunds affect cash.', '']\n    94\t    return data, '\\n'.join(lines)\n    40\t    \"\"\"Rebuild scope ledgers from opening rows plus admitted request/cash history.\"\"\"\n    41\t    prior=prior or {}; scopes={}; issues=[]; people=table(parsed,'people','People')\n    42\t    def ledger(scope):\n    43\t        key=scope_id(scope)\n    44\t        if key not in scopes:\n    45\t            scopes[key]=dict(scope=dict(zip(SCOPE,scope)) if scope else None,currency='EUR',\n    46\t                allocations={},opening_obligations={},requests={},issues=[],source_refs=[],status='BLOCKED')\n    47\t        return scopes[key]\n    48\t    def issue(scope,code,reason,refs,owner='Finance',action='Verify exact source-bound budget/request facts; do not invent amounts'):\n    49\t        item=dict(record_id=f'budget:{scope_id(scope)}:{code}',reason=reason,source_refs=list(dict.fromkeys(refs)),\n    50\t                  owner=owner,next_action=action,scope_id=scope_id(scope))\n    51\t        issues.append(item);ledger(scope)['issues'].append(item)\n    52\t    def directory(employee):\n    53\t        matches=[r for r in people if fields(r).get('Employee ID')==employee and source_bound(r,observations)]\n    54\t        return matches[0] if len(matches)==1 else None\n    55\t    for rows in history.get('claim',{}).values():\n    56\t        current=next(r for r in reversed(rows['revisions']) if r['revision']==rows['current_revision'])\n    57\t        person=directory(fields(current['record']).get('Employee'));ledger(scope_of(fields(person)) if person else None)\n    58\t    grouped=defaultdict(list)\n    59\t    seen_identities={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget') if isinstance(fields(r).get('Ledger reference'),(str,int,float,bool,type(None)))}\n    60\t    for row in table(parsed,'budget','Budget'):\n    61\t        value=fields(row);scope=scope_of(value);entry=ledger(scope)\n    62\t        batch=value.get('Arrival batch')\n    63\t        if batch is not None and (_revision(batch) is None or _revision(batch)>arrival_batch):\n    64\t            if _revision(batch) is None:issue(scope,'bad-arrival:'+str(value.get('Ledger reference')),'Invalid budget arrival membership',[ref(row)])\n    65\t            continue\n    66\t        identity=value.get('Ledger reference')\n    67\t        key=identity if isinstance(identity,(str,int,float,bool,type(None))) else ('invalid',repr(identity))\n    68\t        grouped[key].append(row)\n    69\t    admitted=deepcopy(prior.get('admitted_budget_entries',{}))\n    70\t    for identity,rows in grouped.items():\n    71\t        scope=scope_of(fields(rows[0]));refs=[ref(r) for r in rows];value=fields(rows[0])\n    72\t        valid=bool(text_id(identity) and scope and all(source_bound(r,observations) for r in rows))\n    73\t        for r in rows:\n    74\t            v=fields(r)\n    75\t            valid=valid and v.get('Entry type') in {'allocation','obligation'} and all(_cents(v.get(k)) is not None for k in (\n    76\t                'Allocation or commitment (EUR)','Settled (EUR)','Refunded (EUR)'))\n    77\t            valid=valid and v.get('Currency','EUR')=='EUR' and (v.get('Revision') is None or _revision(v['Revision']) is not None)\n    78\t            valid=valid and _cents(v.get('Refunded (EUR)'))<=_cents(v.get('Settled (EUR)')) if valid else False\n    79\t            if v.get('Entry type')=='obligation':valid=valid and text_id(v.get('Obligation reference'))\n    80\t            if v.get('Entry type')=='allocation':valid=valid and _cents(v.get('Settled (EUR)'))==_cents(v.get('Refunded (EUR)'))==0\n    81\t        conflict=any(payload(r)!=payload(rows[0]) for r in rows[1:])\n    82\t        previous=admitted.get(identity)\n    83\t        # A changed authoritative source version can update an opening record;\n    84\t        # conflicting payloads under the same retained version cannot.\n    85\t        if previous and payload(previous)!=payload(rows[0]) and previous.get('source_sha256')==rows[0].get('source_sha256'):\n    86\t            conflict=True\n    87\t        if not valid or conflict:\n    88\t            for affected in {scope_of(fields(r)) for r in rows}:\n    89\t                issue(affected,'ledger-conflict:'+str(identity),'Invalid/unbound or conflicting budget ledger identity; admitted facts retained',refs)\n    90\t            continue\n    91\t        if not previous or payload(previous)!=payload(rows[0]) or previous.get('source_sha256')!=rows[0].get('source_sha256'):\n    92\t            admitted[identity]=deepcopy(rows[0])\n    93\t    for identity,row in admitted.items():\n    94\t        value=fields(row);scope=scope_of(value);entry=ledger(scope)\n    95\t        # Entries absent from a new input are not silently deleted.\n    96\t        if identity not in seen_identities:\n    97\t            issue(scope,'missing-ledger:'+str(identity),'Previously observed opening entry is absent; confirm explicit replacement/disposition',[ref(row)])\n    98\t        amount=_cents(value['Allocation or commitment (EUR)']);settled=_cents(value['Settled (EUR)']);refund=_cents(value['Refunded (EUR)'])\n    99\t        fact=dict(ledger_id=identity,amount_cents=amount,settled_cents=settled,refunded_cents=refund,\n   100\t                  revision=value.get('Revision'),arrival_batch=value.get('Arrival batch'),source_version=row['source_sha256'],\n   155\t            for event in req['events']:\n   156\t                category=event['classification']\n   157\t                if category=='finance_cancelled' and event.get('original_activity_id'):\n   158\t                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'attempt-cancel:'+event['event_id'],\n   159\t                          'Finance cancellation names a transfer activity; disposition of the accepted request commitment remains unconfirmed',req['source_refs'])\n   160\t                elif category in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'}:\n   161\t                    controls.append(event)\n   162\t                if category=='confirmed_payment':req['confirmed_payment_cents']+=event['amount_cents']\n   163\t                if category=='confirmed_refund':req['confirmed_refund_cents']+=event['amount_cents']\n   164\t            controls.sort(key=lambda e:(utc_time(e['source_record']['Activity time (UTC)']),e['event_id']))\n   165\t            for left,right in zip(controls,controls[1:]):\n   166\t                if utc_time(left['source_record']['Activity time (UTC)'])==utc_time(right['source_record']['Activity time (UTC)']) and left['obligation_cents']!=right['obligation_cents']:\n   167\t                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'control-order:'+request,'Request controls conflict at the same UTC time',req['source_refs'])\n   168\t            accepted=[e for e in controls if e['classification']=='obligation_accepted']\n   169\t            if accepted:\n   170\t                req['commitment_cents']=0 if controls[-1]['classification']=='finance_cancelled' else controls[-1]['obligation_cents']\n   171\t                req['acceptance']=deepcopy(accepted[0])\n   172\t            else:issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'missing-acceptance:'+str(request),'Cash/control has no admitted original accepted obligation',req['source_refs'])\n   173\t            opening=entry['opening_obligations'].get(request)\n   174\t            if opening:\n   175\t                # A native opening summary and full event history for the same\n   176\t                # request must agree; neither is an additional obligation.\n   177\t                if (opening['amount_cents'],opening['settled_cents'],opening['refunded_cents'])!=(req['commitment_cents'],req['confirmed_payment_cents'],req['confirmed_refund_cents']):\n   178\t                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'opening-overlap:'+request,'Opening/request overlap lacks an explicit snapshot boundary; totals disagree',opening['source_refs']+req['source_refs'])\n   179\t                entry['opening_obligations'].pop(request)\n   180\t            req['net_paid_cents']=req['confirmed_payment_cents']-req['confirmed_refund_cents']\n   181\t            req['remaining_commitment_cents']=max(0,req['commitment_cents']-req['net_paid_cents']) if req['commitment_cents'] is not None else None\n   182\t            req['recorded_balance_cents']=req['commitment_cents']-req['net_paid_cents'] if req['commitment_cents'] is not None else None\n   183\t    # Raw unmatched/held imports remain reviewable and cannot disappear from scope risk.\n   184\t    represented={e['event_id'] for f in finances.values() for e in f.get('event_history',[])}\n   185\t    for row in raw_finance:\n   275\t    exact=bool(prior and (prior.get('opening_fingerprint')!=opening or prior.get('requires_exact_source')))\n   276\t    ids={r.split('@',1)[0] for r in ledger['source_refs']}\n   277\t    printed=set()\n   278\t    for sheet in parsed.get('workbook_sheets',[]):\n   279\t        if sheet.get('source_id') in ids:\n   280\t            printed.update(versions({'text':'\\n'.join(str(c.get('value','')) for c in sheet.get('preamble',[]))}))\n   281\t    return dict(opening_fingerprint=opening,requires_exact_source=exact,printed_source_versions=sorted(printed))\n   282\t\n   283\t\n   284\tdef claim_budget_view(*,parsed,claim,lines,budgets,attribution,prior=None,arrival_batch):\n   285\t    record=claim['record'];v=fields(record)\n   286\t    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==v.get('Employee')]\n   287\t    person=fields(people[0]) if len(people)==1 else {};scope=scope_id(scope_of(person));ledger=budgets['scopes'].get(scope)\n   288\t    result=dict(scope_id=scope,owner=person.get('Budget owner') or 'Budget owner',status='BLOCKED',issues=[],source_refs=[ref(record)],\n   289\t                prior_committed_cents=0,prior_net_paid_cents=0,remaining_request_cents=None,lines=[])\n   290\t    related=set(str(v.get('Related earlier claims') or '').splitlines())-{'None'}\n   291\t    for line in lines:\n   292\t        others=[x for x in attribution['costs'].get(line['cost_id'],[]) if x['claim_id']!=claim['subject_id'] and x['reserved_cents']>0]\n   293\t        unknown=[x for x in attribution['unallocated_costs'].get(line['cost_id'],[]) if x['claim_id']!=claim['subject_id']]\n   294\t        valid=[x for x in others if x['claim_id'] in related and x['signature']==list(cost_signature(record,line))]\n   295\t        reason=None\n   296\t        if unknown:reason='Shared cost has an aggregate request without supported cost allocation'\n   297\t        if len(valid)!=len(others) or len(valid)>1:reason='Shared cost needs exact earlier-claim/employee/trip/receipt/amount linkage without duplicate commitments'\n   298\t        consumed=sum(x['reserved_cents'] for x in valid)\n   299\t        allowed=line.get('calculated_cents')\n   300\t        if allowed is not None and consumed>allowed:reason='Prior cost commitments/payments exceed current calculated cost; Finance disposition required'\n   301\t        remaining=allowed-consumed if allowed is not None and not reason else None\n   302\t        refs=[r for x in others+unknown for r in x['source_refs']]\n   303\t        result['source_refs']+=refs\n   304\t        if reason:result['issues'].append(dict(reason=reason,source_refs=line['source_refs']+refs,owner='Finance',next_action='Resolve exact cost/request attribution and any adjustment; never prorate or repay an existing cost'))\n   305\t        result['lines'].append(dict(cost_id=line['cost_id'],remaining_request_cents=remaining,prior_reservations=valid,source_refs=line['source_refs']+refs))\n   140\tdef apply_partial_response(\n   141\t    queue: dict,\n   142\t    *,\n   143\t    response_id: str,\n   144\t    item_outcomes: dict[str, dict],\n   145\t    run_id: str,\n   146\t    batch_id: str,\n   147\t) -> None:\n   148\t    \"\"\"Record a supplied response against explicitly matched repair item IDs.\n   149\t\n   150\t    Only `supported` plus at least one retained source reference resolves an\n   151\t    item. Every other outcome remains open. Unmentioned items are untouched.\n   152\t    \"\"\"\n   153\t    allowed = {\"supported\", \"insufficient\", \"conflicting\", \"unanswered\"}\n   154\t    if not response_id:\n   155\t        raise ValueError(\"response_id is required\")\n   156\t    if not isinstance(item_outcomes, dict):\n   157\t        raise ValueError(\"item_outcomes must map repair item IDs to outcomes\")\n   158\t    planned: list[tuple[str, dict, str, list[str], dict | None]] = []\n   159\t    for item_id, outcome in item_outcomes.items():\n   160\t        if item_id not in queue[\"items\"]:\n   161\t            raise KeyError(f\"response references unknown repair item {item_id}\")\n   162\t        if not isinstance(outcome, dict):\n   163\t            raise ValueError(f\"response outcome for {item_id} must be an object\")\n   164\t        kind = outcome.get(\"outcome\")\n   165\t        if kind not in allowed:\n   166\t            raise ValueError(f\"invalid response outcome for {item_id}: {kind!r}\")\n   167\t        refs = outcome.get(\"source_refs\", [])\n   168\t        if not isinstance(refs, list) or not all(isinstance(ref, str) and ref for ref in refs):\n   169\t            raise ValueError(f\"response source_refs must be a list of references for {item_id}\")\n   170\t        if kind == \"supported\" and not refs:\n   171\t            raise ValueError(f\"supported response {item_id} requires source references\")\n   172\t        item = queue[\"items\"][item_id]\n   173\t        if outcome.get(\"note\") is not None and not isinstance(outcome.get(\"note\"), str):\n   174\t            raise ValueError(f\"response note must be a string or null for {item_id}\")\n   175\t        prior_event = next(\n   176\t            (event for event in reversed(queue[\"events\"])\n   177\t             if event.get(\"event\") == \"response-recorded\"\n   178\t             and event.get(\"response_id\") == response_id\n   179\t             and event.get(\"item_id\") == item_id),\n   180\t            None,\n   181\t        )\n   182\t        normalized_refs = list(dict.fromkeys(refs))\n   183\t        if prior_event is not None:\n   184\t            same = (\n   185\t                prior_event.get(\"outcome\") == kind\n   186\t                and prior_event.get(\"source_refs\") == normalized_refs\n   187\t                and prior_event.get(\"note\") == outcome.get(\"note\")\n   188\t            )\n   189\t            if same:\n   190\t                planned.append((item_id, item, kind, normalized_refs, prior_event))\n   191\t                continue\n   192\t            raise ValueError(f\"conflicting replay for repair response {response_id}/{item_id}\")\n   193\t        planned.append((item_id, item, kind, normalized_refs, None))\n   194\t\n   195\t    # Mutate only after every item in this partial response passed validation.\n   196\t    for item_id, item, kind, normalized_refs, prior_event in planned:\n   197\t        if prior_event is not None:\n   198\t            continue\n   199\t        prior = {\n   200\t            \"response_id\": response_id,\n   201\t            \"outcome\": kind,\n   202\t            \"note\": item_outcomes[item_id].get(\"note\"),\n   203\t            \"source_refs\": normalized_refs,\n   204\t            \"run_id\": run_id,\n   205\t            \"batch_id\": batch_id,\n   206\t            \"previous_status\": item[\"status\"],\n   207\t        }\n   208\t        item[\"history\"].append(prior)\n   209\t        item[\"response_id\"] = response_id\n   210\t        if kind == \"supported\":\n   211\t            item[\"status\"] = \"resolved\"\n   212\t            item[\"resolution_source_refs\"] = normalized_refs\n   213\t        else:\n   214\t            item[\"status\"] = \"open\"\n   215\t        queue[\"events\"].append({\n   216\t            \"event\": \"response-recorded\",\n"},"started_at_ms":1792060484019,"completed_at_ms":1792060484291}}
