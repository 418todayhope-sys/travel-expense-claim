    74\t            f\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \"\n    75\t            f\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\"\n    76\t        )\n    77\t    lines.extend([\n    78\t        \"\",\n    79\t        \"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained. Recorded ledger obligations are separate from entitlement and current-revision authorization. Claim monetary entitlement and balance remain null when unsupported.\",\n    80\t        \"\",\n    81\t        \"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\",\n    82\t        \"\",\n    83\t    ])\n    84\t    lines.extend([\n    85\t        \"## Recorded Finance obligations and cash\", \"\",\n    86\t        \"Obligation (EUR) is the ledger's recorded commitment amount, not a payment or approved reimbursement entitlement. \"\n    87\t        \"Ledger differences below compare that recorded amount with confirmed transfers minus linked refunds. \"\n    88\t        \"They do not establish claim eligibility, payment readiness or closure. Claim balance_cents remains null without a separately supported current-revision authorization.\", \"\",\n    89\t        \"Native Finance rows have no claim-revision column. Arrival revision context identifies the source-observed revision at first delivery; \"\n    90\t        \"it is not an explicit authorization binding, and redelivery never changes it. Adjustments/resolutions record obligation amounts rather than cash. \"\n    91\t        \"Cancellation/retry events are not refunds or proof that an obligation is zero.\", \"\",\n    92\t    ])\n    93\t    latest_snapshot = json.loads(snapshots[-1].read_text(encoding=\"utf-8\"))\n    94\t    for claim in latest_snapshot[\"claims\"]:\n    95\t        evidence = claim.get(\"finance_evidence\", {})\n    96\t        obligation = evidence.get(\"recorded_obligation\")\n    97\t        if obligation is None:\n    98\t            continue\n    99\t        delta = evidence.get(\"recorded_ledger_balance_cents\")\n   100\t        lines.extend([\n   101\t            f\"- Claim `{claim['claim_id']}` current revision {claim['revision']}; request `{obligation['request_id']}`: \"\n   102\t            f\"recorded obligation **{obligation['amount_cents']} cents**, confirmed net cash **{claim['paid_cents']} cents**, \"\n   103\t            f\"recorded ledger difference **{delta if delta is not None else 'unresolved'}** cents.\",\n   104\t            f\"  - Event `{obligation['event_id']}` ({obligation['event_type']}); first arrival batch {obligation['first_arrival_batch']}; \"\n   105\t            f\"arrival revision context {obligation['arrival_revision_context']}; explicit claim revision {obligation['claim_revision']}; \"\n   165\t            f\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\"\n   166\t        )\n   167\t    lines.extend([\n   168\t        \"\",\n   169\t        \"## Outputs\",\n   170\t        \"\",\n   171\t        f\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\",\n   172\t        f\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\",\n   173\t        f\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\",\n   174\t        f\"- Owner follow-up drafts: `{output_paths['drafts'].name}` (human review required; not sent).\",\n   175\t        \"\",\n   176\t        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n   177\t        \"\",\n   178\t    ])\n   179\t    return \"\\n\".join(lines)\n   180\t\n   181\t\n   182\tdef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n   183\t    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n   184\t    errors = verify_source_manifest(run_dir)\n   185\t    if errors:\n   186\t        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n   187\t    manifest_path = run_dir / \"sources.json\"\n   188\t    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n   189\t    parsed_path = run_dir / OUTPUT_NAME\n   190\t    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n   191\t    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n   192\t    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n   193\t        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n   194\t    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n   195\t        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n   196\t    batches = parsed.get(\"arrival_batches\")\n   197\t    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n   198\t        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n   199\t    output_paths = {\n   200\t        \"claims\": run_dir / \"claims.csv\",\n   201\t        \"report\": run_dir / \"report.md\",\n   202\t        \"queue\": run_dir / \"repair-queue.json\",\n   203\t        \"state\": run_dir / \"offline-replay-state.json\",\n   204\t        \"drafts\": run_dir / \"follow-up-drafts.md\",\n   205\t        \"workflow\": run_dir / \"ordinary-workflow.json\",\n   206\t        \"demo\": run_dir / \"ordinary-workflow-demo.md\",\n   207\t        \"revalidation\": run_dir / \"correction-cancellation-verification.json\",\n   208\t        \"revalidation_summary\": run_dir / \"correction-cancellation-verification.md\",\n   209\t    }\n   210\t    occupied = [str(path) for path in output_paths.values() if path.exists()]\n   211\t    if occupied:\n   212\t        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n   213\t    batches_dir = run_dir / \"batches\"\n   214\t    if batches_dir.exists() and any(batches_dir.iterdir()):\n   215\t        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n   216\t\n   217\t    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n   218\t    previous: dict[str, Any] | None = None\n   219\t    previous_path: Path | None = None\n   220\t    sealed: list[Path] = []\n   221\t    for number in batches:\n   222\t        batch_id = f\"arrival-{number:03d}\"\n   223\t        predecessor = None\n   224\t        if previous_path is not None:\n   225\t            predecessor = {\n   226\t                \"path\": f\"batches/{previous_path.name}\",\n   227\t                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n   228\t            }\n   229\t        current = integrate_arrival_batch(\n   230\t            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n   231\t            source_binding=binding, predecessor=predecessor, prior_result=previous,\n   232\t            source_observations=manifest[\"files\"],\n   233\t        )\n   234\t        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n   235\t        path = seal_batch_snapshot(\n   236\t            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n   237\t            predecessor_path=previous_path, schema_path=schema_path,\n   238\t            allow_unconfirmed_case_clock=True, **{\n   239\t                key: current[\"snapshot\"][key]\n   240\t                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\", \"permit_approvals\", \"budget_reconciliation\")\n     1\t\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport csv\n     6\timport hashlib\n     7\timport json\n     8\timport subprocess\n     9\tfrom datetime import datetime\n    10\tfrom pathlib import Path\n    11\tfrom typing import Any\n    12\t\n    13\tfrom .follow_up import render_follow_up_drafts\n    14\tfrom .integration import integrate_arrival_batch\n    15\tfrom .offline_replay import OFFLINE_MARKER, _report\n    16\tfrom .revalidation import verification_document\n    17\tfrom .ordinary import ordinary_demo\n    18\tfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\n    19\tfrom .snapshots import verify_snapshot\n    20\tfrom .sources import SOURCES, verify_source_manifest\n    21\t\n    22\tREQUIRED_FILES = (\n    23\t    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    24\t    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n    25\t    \"ordinary-workflow.json\", \"ordinary-workflow-demo.md\",\n    26\t    \"correction-cancellation-verification.json\", \"correction-cancellation-verification.md\",\n    27\t)\n    28\t\n    29\t\n    30\tdef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    31\t    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    32\t    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    33\t    checks: list[dict[str, Any]] = []\n    34\t    objects: dict[str, dict] = {}\n    35\t\n    36\t    def add(name, status, detail, evidence, action):\n    37\t        checks.append(dict(check=name, status=status, detail=detail,\n    38\t                           evidence_paths=[str(path) for path in evidence], next_action=action))\n    39\t\n    40\t    def check(name, paths, operation):\n    41\t        try:\n    42\t            operation()\n    43\t        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n    44\t            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n    45\t                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n    46\t        else:\n    47\t            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n    48\t\n    49\t    def require(condition, message):\n    50\t        if not condition:\n    51\t            raise ValueError(message)\n    52\t\n    53\t    for name in REQUIRED_FILES:\n    54\t        path = run_dir / name\n    55\t        def read(path=path, name=name):\n    56\t            require(path.is_file(), f\"Required output missing: {name}\")\n    57\t            if name.endswith(\".json\"):\n    58\t                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n    59\t                require(isinstance(obj, dict), f\"{name} must contain an object\")\n    60\t                objects[name] = obj\n    61\t        check(f\"required:{name}\", [path], read)\n    62\t\n    63\t    manifest = objects.get(\"sources.json\", {})\n    64\t    parsed = objects.get(\"parsed-records.json\", {})\n    65\t    state = objects.get(\"offline-replay-state.json\", {})\n    66\t    def manifest_integrity():\n    67\t        errors = verify_source_manifest(run_dir)\n    68\t        require(not errors, \"; \".join(errors))\n    69\t        require(manifest.get(\"source_version\") in {\"native-source-manifest/1\", \"native-source-manifest/2\"}, \"Unsupported manifest version\")\n    70\t        rows = manifest[\"files\"]\n    71\t        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n    72\t        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n    73\t                \"Source IDs do not match configured native URLs\")\n    74\t    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    75\t    source_rows = manifest.get(\"files\", [])\n    76\t    if not isinstance(source_rows, list):\n    77\t        source_rows = []\n    78\t    for source in SOURCES:\n    79\t        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n    80\t        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n    81\t        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n    82\t            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n    83\t            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n    84\t            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n    85\t\n    86\t    clock = manifest.get(\"case_clock\")\n    87\t    clock_confirmed = False\n    88\t    if clock:\n    89\t        try:\n    90\t            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n    91\t        except (ValueError, TypeError, AttributeError):\n    92\t            pass\n    93\t    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    94\t    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n    95\t        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n    96\t        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n    97\t        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n    98\t\n    99\t    mode = state.get(\"mode\", \"unverified\")\n   100\t    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n   160\t        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\n   161\t                \"Correction/cancellation summary differs from executed checks\")\n   162\t    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\n   163\t          run_dir / 'correction-cancellation-verification.md'], correction_trace)\n   164\t\n   165\t    # Collect only references actually present in retained parsed evidence.\n   166\t    parsed_refs: set[str] = set()\n   167\t    def collect_refs(value):\n   168\t        if isinstance(value, dict):\n   169\t            if all(key in value for key in (\"source_id\", \"source_sha256\", \"locator\")):\n   170\t                parsed_refs.add(f\"{value['source_id']}@{value['source_sha256']}#{value['locator']}\")\n   171\t            for child in value.values():\n   172\t                collect_refs(child)\n   173\t        elif isinstance(value, list):\n   174\t            for child in value:\n   175\t                collect_refs(child)\n   176\t    collect_refs(parsed)\n   177\t    queue: dict = {}\n   178\t    def queue_trace():\n   179\t        queue.update(load_repair_queue(run_dir / \"repair-queue.json\"))\n   180\t        require(queue == state[\"repair_queue\"], \"Queue differs from replay state\")\n   181\t        retained = {r[\"source_id\"]: r for r in manifest[\"files\"] if r[\"status\"] == \"read\"}\n   182\t        for item in queue[\"items\"].values():\n   183\t            require(item[\"subject_type\"] in {\"claim\", \"trip\", \"permit\"} and isinstance(item[\"revision\"], int) and not isinstance(item[\"revision\"], bool) and item[\"revision\"] > 0, \"Invalid repair subject/revision\")\n   184\t            require(all(isinstance(item[f], str) and item[f].strip() for f in (\"subject_id\", \"owner\", \"missing_or_return_reason\", \"next_action\")), \"Missing repair trace fields\")\n   185\t            require(item[\"run_id\"] == state[\"run_id\"] and f\"batches/{item['batch_id']}.json\" in state[\"sealed_batches\"], \"Repair run/batch reference mismatch\")\n   186\t            require(item[\"request_draft\"] == {\"status\": \"draft\", \"sent\": False}, \"Repair request is not an unsent draft\")\n   187\t            require(isinstance(item[\"source_refs\"], list), \"Repair source_refs must be an array\")\n   188\t            for ref in item[\"source_refs\"]:\n   189\t                sid_hash, locator = ref.split(\"#\", 1)\n   190\t                sid, digest = sid_hash.split(\"@\", 1)\n   191\t                require(sid in retained and retained[sid][\"sha256\"] == digest and bool(locator), \"Repair source reference does not bind retained evidence\")\n   192\t                require(ref in parsed_refs, \"Repair locator is not present in retained parsed evidence\")\n   193\t    check(\"repair-queue-traceability\", [run_dir / \"repair-queue.json\", run_dir / \"offline-replay-state.json\"], queue_trace)\n   194\t\n   195\t    missing_refs = [item[\"item_id\"] for item in queue.get(\"items\", {}).values()\n   196\t                    if item.get(\"status\") == \"open\" and not item.get(\"source_refs\")]\n   197\t    add(\"repair-evidence-availability\", \"BLOCKED\" if missing_refs else \"PASS\",\n   198\t        f\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\",\n   199\t        [run_dir / \"repair-queue.json\"], \"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\" if missing_refs else \"No missing repair evidence references.\")\n   200\t    checks[-1][\"affected_item_ids\"] = missing_refs\n   201\t    open_items = [item[\"item_id\"] for item in queue.get(\"items\", {}).values() if item.get(\"status\") == \"open\"]\n   202\t    add(\"unresolved-repairs\", \"BLOCKED\" if open_items else \"PASS\", f\"{len(open_items)} repair items remain open\",\n   203\t        [run_dir / \"repair-queue.json\", run_dir / \"follow-up-drafts.md\"],\n   204\t        \"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\" if open_items else \"No open repairs.\")\n   205\t    checks[-1][\"affected_item_ids\"] = open_items\n   206\t\n   207\t    def csv_contract():\n   208\t        require(snapshots, \"No verified snapshot chain\")\n   209\t        with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n   210\t            reader = csv.DictReader(stream)\n   211\t            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \"claims.csv header must match the exact required columns\")\n   212\t            rows = list(reader)\n   213\t        claims = json.loads(snapshots[-1].read_text())[\"claims\"]\n   214\t        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \"Missing or duplicated claim rows\")\n   215\t        by_id = {c[\"claim_id\"]: c for c in claims}\n   216\t        for row in rows:\n   217\t            require(None not in row and all(v is not None for v in row.values()), \"Malformed CSV row\")\n   218\t            claim = by_id[row[\"claim_id\"]]\n   219\t            for field in (\"revision\", \"trip_id\", \"paid_cents\", \"balance_cents\"):\n   220\t                require(row[field] == (\"\" if claim[field] is None else str(claim[field])), f\"CSV {field} differs from latest snapshot\")\n   221\t            require(row[\"allowed_cents\"] == (\"\" if claim[\"allowed_cents\"] is None else str(claim[\"allowed_cents\"]))\n   222\t                    and row[\"status\"] == claim[\"status\"], \"CSV entitlement/status differs from evidence-derived snapshot\")\n   223\t            open_claim_repairs = [item for item in queue.get(\"items\", {}).values()\n   224\t                                 if item[\"subject_type\"] == \"claim\" and item[\"subject_id\"] == row[\"claim_id\"] and item[\"status\"] == \"open\"]\n   225\t            owner = open_claim_repairs[0][\"owner\"] if open_claim_repairs else claim[\"next_owner\"]\n   226\t            reason = open_claim_repairs[0][\"missing_or_return_reason\"] if open_claim_repairs else \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\"\n   227\t            owner = None if claim['status'].startswith('closed-') else owner\n   228\t            require(row[\"next_owner\"] == (owner or \"\") and row[\"reason\"] == reason, \"CSV owner/reason differs from current repair evidence\")\n   229\t    check(\"claims-csv-contract\", [run_dir / \"claims.csv\"], csv_contract)\n   230\t\n   231\t    def ordinary_trace():\n   232\t        require(snapshots, \"Verified snapshots required\")\n   233\t        obj = objects['ordinary-workflow.json']\n   234\t        require(obj['mode'] == 'offline-replay' and obj['fresh_native_reads_performed'] is False\n   235\t                and obj['run_id'] == state['run_id'], \"Ordinary workflow run/mode mismatch\")\n   236\t        current = {c['claim_id']: c['ordinary_workflow'] for c in json.loads(snapshots[-1].read_text())['claims']}\n   237\t        require(obj['claims'] == state['ordinary_workflows'] == current, \"Ordinary current workflow differs from sealed claims\")\n   238\t        expected = {(path.stem, c['claim_id']): c['ordinary_workflow'] for path in snapshots\n   239\t                    for c in json.loads(path.read_text())['claims']}\n   240\t        history = obj['history']\n   241\t        observed = {(r['batch_id'], r['workflow']['claim_id']): r['workflow'] for r in history}\n   242\t        require(len(history) == len(observed) and observed == expected and history == state['ordinary_workflow_history'],\n   243\t                \"Ordinary workflow history differs from the complete sealed batch chain\")\n   244\t        require((run_dir / 'ordinary-workflow-demo.md').read_text() == ordinary_demo(current), \"Ordinary demonstration differs from retained stage evidence\")\n   245\t    check('ordinary-workflow-traceability', [run_dir / 'ordinary-workflow.json', run_dir / 'ordinary-workflow-demo.md'], ordinary_trace)\n   246\t\n   247\t    def report_trace():\n   248\t        require(snapshots and queue, \"Verified snapshots and queue required\")\n   249\t        paths = {\"claims\": run_dir / \"claims.csv\", \"state\": run_dir / \"offline-replay-state.json\",\n   250\t                 \"queue\": run_dir / \"repair-queue.json\", \"drafts\": run_dir / \"follow-up-drafts.md\"}\n   251\t        expected = _report(run_id=state[\"run_id\"], parsed=parsed, snapshots=snapshots,\n   252\t                           latest={\"domain\": {\"repair_queue\": queue}}, output_paths=paths)\n   253\t        require((run_dir / \"report.md\").read_text() == expected, \"Report differs from evidence-derived handoff (sections, references, owners or actions)\")\n   254\t    check(\"report-traceability\", [run_dir / \"report.md\"], report_trace)\n   255\t\n   256\t    def drafts_status():\n   257\t        require(queue, \"Verified queue required\")\n   258\t        expected, _ = render_follow_up_drafts(run_id=state[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []))\n   259\t        require((run_dir / \"follow-up-drafts.md\").read_text() == expected, \"Drafts differ from unresolved evidence or human-review/unsent labels\")\n   260\t    check(\"follow-up-draft-status\", [run_dir / \"follow-up-drafts.md\"], drafts_status)\n   261\t    issues = parsed.get(\"unresolved_issues\", [])\n   262\t    def blocker_shape():\n   263\t        require(isinstance(issues, list), \"unresolved_issues must be an array\")\n   264\t        for issue in issues:\n   265\t            require(isinstance(issue, dict) and all(isinstance(issue.get(field), str) and issue[field] for field in\n   266\t                    (\"record_id\", \"subject_type\", \"subject_id\", \"owner\", \"reason\", \"next_action\")), \"Malformed external blocker\")\n   267\t    check(\"external-blocker-traceability\", [run_dir / \"parsed-records.json\"], blocker_shape)\n   268\t    for issue in issues if isinstance(issues, list) else []:\n   269\t        if not isinstance(issue, dict) or not all(field in issue for field in (\"record_id\", \"reason\", \"next_action\")):\n   270\t            continue\n   271\t        if issue.get(\"status\", \"open\") == \"open\":\n   272\t            add(f\"external-blocker:{issue['record_id']}\", \"BLOCKED\", issue[\"reason\"],\n   273\t                [run_dir / \"parsed-records.json\"], issue[\"next_action\"])\n   274\t\n   275\t    def git(*args):\n   276\t        result = subprocess.run([\"git\", \"-C\", str(repo_dir), *args], capture_output=True, text=True, check=True)\n   277\t        return result.stdout.strip()\n   278\t    try:\n   279\t        settings = json.loads((repo_dir / \".entire/settings.json\").read_text())\n   280\t        head = git(\"rev-parse\", \"HEAD\")\n   281\t        message = git(\"log\", \"-1\", \"--format=%B\")\n   282\t        worktree_status = git(\"status\", \"--short\")\n   283\t        ids = [line.split(\":\", 1)[1].strip() for line in message.splitlines() if line.startswith(\"Entire-Checkpoint:\")]\n   284\t        refs = git(\"for-each-ref\", \"--format=%(refname) %(objectname)\", \"refs/entire/checkpoints\").splitlines()\n   285\t        matches = [line for line in refs if any(line.split()[0].endswith('/' + identity) for identity in ids)]\n   286\t        require(settings.get(\"enabled\") is True a