r\")\n   407\t                        and value.get(\"Allowed original amount\") is not None):\n   408\t                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n   409\t                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n   410\t                        \"expense_reference\": value.get(\"Expense reference\"),\n   411\t                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n   412\t                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n   413\t        if dispositions:\n   414\t            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n   415\t            changes = {\n   416\t                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n   417\t                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n   418\t                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n   419\t            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n   420\t            if changes:\n   421\t                update_repair_item(queue, item_id=task_id,\n   422\t                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n   423\t        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n   424\t                 if row_values(r).get(\"Trip reference\") == trip_id\n   425\t                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n   426\t        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n   427\t        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n   428\t        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n   429\t        actors_ok = bool(employee and supervisor\n   430\t            and request_values.get(\"Acting employee or supervisor\") == employee\n   431\t            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n   432\t        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n   433\t        if not actors_ok:\n   434\t            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n   435\t                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n   436\t                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n   437\t                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n   438\t                run_id=run_id, batch_id=batch_id)\n   439\t        actor_item = f\"cancellation-authority:{cancellation_id}\"\n   440\t        if actor_item in queue[\"items\"]:\n    72\tdef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n    73\t                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    74\t    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n    75\t\n    76\t    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    77\t    claim revision; arrival context is retained separately from explicit links.\n    78\t    Only the first delivery establishes context; redelivery cannot rebind it.\n    79\t    \"\"\"\n    80\t    groups: dict[str, list[dict]] = defaultdict(list)\n    81\t    for event in history:\n    82\t        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n    83\t            groups[event['event_id']].append(event)\n    84\t    records = []\n    85\t    problem = None\n    86\t    for event_id, occurrences in groups.items():\n    87\t        event = occurrences[0]\n    88\t        values = event['source_record']\n    89\t        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n    90\t        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n    91\t        context_rows = [r for r in revisions if first_batch is not None\n    92\t                        and _positive_integer(r.get('arrival_batch')) is not None\n    93\t                        and _positive_integer(r['arrival_batch']) <= first_batch]\n    94\t        context = max((r['revision'] for r in context_rows), default=None)\n    95\t        explicit = _positive_integer(values.get('Claim revision'))\n    96\t        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n    97\t        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n    98\t        refs = [_reference_text(e['source_ref']) for e in occurrences]\n    99\t        record = {\n   100\t            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n   101\t            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n   102\t            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n   103\t            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n   104\t            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n   105\t            'revision_link_status': link, 'first_arrival_batch': first_batch,\n   106\t            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n   107\t            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n   108\t                                  if r['revision'] == (explicit if matches else context)],\n   109\t        }\n   110\t        records.append(record)\n   111\t        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n   112\t                or not all(isinstance(values.get(key), str) and values[key].strip()\n   113\t                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n   114\t                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n   115\t                or (values.get('Claim revision') is not None and not matches)):\n   116\t            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n   117\t    if not records:\n   118\t        return [], None, None\n   119\t    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n   120\t        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n   121\t    # A single observation needs no ordering assumption. Multiple observations\n   122\t    # require explicit UTC event times; arrival numbers do not define business time.\n   123\t    if len(records) > 1:\n   124\t        try:\n   125\t            def stamp(record):\n   126\t                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n   127\t                # The retained header explicitly names UTC even when the cell\n   128\t                # serialization omits an offset.\n   129\t                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n   130\t                    raise ValueError('not UTC')\n   131\t                return dt.replace(tzinfo=None)\n   132\t            records.sort(key=lambda r: (stamp(r), r['event_id']))\n   133\t            for left, right in zip(records, records[1:]):\n   134\t                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n   135\t                    problem = 'Conflicting obligation amounts have the same event time'\n","stderr":"","aggregated_output":"\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\ndef test_categories_and_caps(category, units, amount):\n    parsed, record, trip = setup()\n    receipt = parsed['records']['receipts'][0]\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == amount\n    if category in {'lodging','meals'}:\n        assert lines[0]['conversion']['cap']['units'] == units\n\n\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\ndef test_fractional_or_invalid_units_unresolved(units):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\n    ('Transaction reference',None),('Receipt reference','OTHER')])\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99')])\ndef test_mismatched_receipt(field, value):\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\n\n\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\n\"\"\"Native-shaped review records and explicitly synthetic authority probes.\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_expenses import setfield\nfrom test_revalidation import corrected\nfrom travel_claim.approvals import evaluate_reviews, evaluate_permit, fields, ref, table\nfrom travel_claim.integration import integrate_arrival_batch\n\n\ndef subject(kind='claim',amount=10000):\n    p=synthetic();record=p['records']['claim_revisions'][0];trip=p['records']['trips'][0]\n    if kind=='permit':\n        setfield(trip,'International',True);setfield(trip,'Permit reference','P-SYN');setfield(trip,'Permit revision',1)\n        setfield(trip,'Estimate (EUR)',str(amount/100))\n        record=deepcopy(trip);record['text']='Synthetic source version SRC-D-3'\n        for d in p['records']['decisions']:\n            setfield(d,'Subject type','permit');setfield(d,'Subject reference','P-SYN')\n    for packet in table(p,'review_packets','Review packets'):\n        for key in ('Permit reference','Permit revision'): setfield(packet,key,fields(trip).get(key))\n        if kind=='permit':setfield(packet,'Reviewed estimate (EUR)',str(amount/100))\n    return p,record,trip\n\n\ndef check(p,record,trip,kind='claim',amount=10000,prior=None,batch=4):\n    return evaluate_reviews(parsed=p,kind=kind,subject_id='P-SYN' if kind=='permit' else 'SYN-C01',revision=1,\n        trip_record=trip,employee='EMP-01',subject_record=record,amount_cents=amount,\n        decisions=p['records']['decisions'],arrival_batch=batch,observations=p['source_observations'],\n        cost_ids=['COST-01'],prior=prior)\n\n\ndef director(p):\n    d=deepcopy(p['records']['decisions'][0]);setfield(d,'Decision reference','SYN-DIRECTOR');setfield(d,'Review roles','director');setfield(d,'Reviewer','DIR-01')\n    packet=deepcopy(table(p,'review_packets','Review packets')[0]);setfield(packet,'Decision reference','SYN-DIRECTOR')\n    p['records']['decisions'].append(d)\n    table(p,'review_packets','Review packets').append(packet)\n\n\n@pytest.mark.parametrize('kind',['claim','permit'])\n@pytest.mark.parametrize('amount,needs_director',[(99999,False),(100000,False),(100001,True)])\ndef test_exact_policy_thresholds_for_distinct_subjects(kind,amount,needs_director):\n    p,record,trip=subject(kind,amount)\n    value=check(p,record,trip,kind,amount)\n    assert ('director' in value['required_roles'])==needs_director\n    assert value['approved']==(not needs_director)\n    director(p)\n    assert check(p,record,trip,kind,amount)['approved']\n\n\n@pytest.mark.parametrize('kind',['claim','permit'])\n@pytest.mark.parametrize('field,value',[('Subject type','other'),('Subject reference','OTHER'),('Revision',2),\n    ('Reviewer','OTHER'),('Reviewer','EMP-01'),('Review roles','director'),('Review roles','unknown'),\n    ('Reason',''),('Source revisions','SRC-D-OLD\\nPOL-2026.2'),('Source revisions','SRC-D-3\\nPOL-2026.1')])\ndef test_wrong_role_actor_subject_version_and_reason_never_authorize(kind,field,value):\n    p,record,trip=subject(kind);setfield(p['records']['decisions'][0],field,value)\n    result=check(p,record,trip,kind)\n    assert not result['approved']\n    assert any(d['rejection_reasons'] for d in result['deliveries'])\n    assert result['deliveries'][0]['raw_record']==p['records']['decisions'][0]\n\n\n\"\"\"Policy budget arithmetic and actual retained rows; mutations are synthetic.\"\"\"\nfrom copy import deepcopy\nfrom pathlib import Path\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic,batches,workflow,stages,row\nfrom test_expenses import setfield\nfrom travel_claim.approvals import fields,table,ref\nfrom travel_claim.budget import reconcile_budgets,scope_id,budget_reply_error,claim_budget_view\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.integration import integrate_arrival_batch\n\nSCOPE=scope_id(('Consulting','Client-A','2026'))\n\n\ndef scope(result):return result['domain']['budget']['scopes'][SCOPE]\n\n\ndef native():\n    p=json.loads((Path(__file__).parent/'fixtures/retained_budget_records.json').read_text())\n    p['expense_policy']=load_expense_policy(Path(__file__).parent/'fixtures/POL-2026.2-browser-copy.txt')\n    p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}\n    return p\n\n\ndef run_one(p,batch=1,prior=None):\n    return integrate_arrival_batch(p,arrival_batch=batch,run_id='budget-test',batch_id=f'arrival-{batch: