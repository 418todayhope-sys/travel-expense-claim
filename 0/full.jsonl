{"timestamp":"2026-10-15T01:20:02.749Z","ordinal":3522,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13d25-14bd-7781-89ef-0d2d787c493d","call_id":"call_e5407a4a735d4f7793a93cb2d6485420","output":[{"type":"input_text","text":"Script completed\nWall time 4.9 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 12794)\nTotal output lines: 3\n\n{\"chunk_id\":\"112456\",\"wall_time_seconds\":0.22137698,\"exit_code\":0,\"original_token_count\":12443,\"output\":\"\\\"\\\"\\\"POL-2026.2 budget facts and cross-claim cost attribution.\\n\\nRecorded Finance commitments are encumbrances, not human entitlement approval.\\nCash is read only from the protected Finance admission ledger. Native Budget\\nheaders explicitly specify EUR; absent row revision/batch fields remain null.\\n\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom collections import defaultdict\\nimport hashlib\\nimport json\\n\\nfrom .approvals import fields, ref, table\\nfrom .event_validation import utc_time, text_id\\nfrom .exceptions import source_bound, finding\\nfrom .expenses import evaluate_expenses, policy_valid\\nfrom .finance import _cents\\nfrom .workflow import _revision\\n\\nSCOPE=('Department','Project','Budget period')\\n\\n\\ndef scope_of(value):\\n    parts=[value.get(k) for k in SCOPE]\\n    return tuple(str(v) for v in parts) if all(isinstance(v,(str,int,float)) and not isinstance(v,bool) and str(v).strip() and str(v)==str(v).strip() for v in parts) else None\\n\\n\\ndef scope_id(scope):\\n    return json.dumps(list(scope),separators=(',',':')) if scope else 'unassigned'\\n\\n\\ndef payload(row):\\n    return {k:v for k,v in fields(row).items() if k!='Arrival batch'}\\n\\n\\ndef fingerprint(value):\\n    return hashlib.sha256(json.dumps(value,sort_keys=True,default=str).encode()).hexdigest()\\n\\n\\ndef reconcile_budgets(*, parsed, history, finances, arrival_batch, observations, cancellations=(), prior=None, raw_finance=()):\\n    \\\"\\\"\\\"Rebuild scope ledgers from opening rows plus admitted request/cash history.\\\"\\\"\\\"\\n    prior=prior or {}; scopes={}; issues=[]; people=table(parsed,'people','People')\\n    def ledger(scope):\\n        key=scope_id(scope)\\n        if key not in scopes:\\n            scopes[key]=dict(scope=dict(zip(SCOPE,scope)) if scope else None,currency='EUR',\\n                allocations={},opening_obligations={},requests={},issues=[],source_refs=[],status='BLOCKED')\\n        return scopes[key]\\n    def issue(scope,code,reason,refs,owner='Finance',action='Verify exact source-bound budget/request facts; do not invent amounts'):\\n        item=dict(record_id=f'budget:{scope_id(scope)}:{code}',reason=reason,source_refs=list(dict.fromkeys(refs)),\\n                  owner=owner,next_action=action,scope_id=scope_id(scope))\\n        issues.append(item);ledger(scope)['issues'].append(item)\\n    def directory(employee):\\n        matches=[r for r in people if fields(r).get('Employee ID')==employee and source_bound(r,observations)]\\n        return matches[0] if len(matches)==1 else None\\n    for rows in history.get('claim',{}).values():\\n        current=next(r for r in reversed(rows['revisions']) if r['revision']==rows['current_revision'])\\n        person=directory(fields(current['record']).get('Employee'));ledger(scope_of(fields(person)) if person else None)\\n    grouped=defaultdict(list)\\n    seen_identities={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget') if isinstance(fields(r).get('Ledger reference'),(str,int,float,bool,type(None)))}\\n    for row in table(parsed,'budget','Budget'):\\n        value=fields(row);scope=scope_of(value);entry=ledger(scope)\\n        batch=value.get('Arrival batch')\\n        if batch is not None and (_revision(batch) is None or _revision(batch)>arrival_batch):\\n            if _revision(batch) is None:issue(scope,'bad-arrival:'+str(value.get('Ledger reference')),'Invalid budget arrival membership',[ref(row)])\\n            continue\\n        identity=value.get('Ledger reference')\\n        key=identity if isinstance(identity,(str,int,float,bool,type(None))) else ('invalid',repr(identity))\\n        grouped[key].append(row)\\n    admitted=deepcopy(prior.get('admitted_budget_entries',{}))\\n    for identity,rows in grouped.items():\\n        scope=scope_of(fields(rows[0]));refs=[ref(r) for r in rows];value=fields(rows[0])\\n        valid=bool(text_id(identity) and scope and all(source_bound(r,observations) for r in rows))\\n        for r in rows:\\n            v=fields(r)\\n            valid=valid and v.get('Entry type') in {'allocation','obligation'} and all(_cents(v.get(k)) is not None for k in (\\n                'Allocation or commitment (EUR)','Settled (EUR)','Refunded (EUR)'))\\n            valid=valid and v.get('Currency','EUR')=='EUR' and (v.get('Revision') is None or _revision(v['Revision']) is not None)\\n            valid=valid and _cents(v.get('Refunded (EUR)'))<=_cents(v.get('Settled (EUR)')) if valid else False\\n            if v.get('Entry type')=='obligation':valid=valid and text_id(v.get('Obligation reference'))\\n            if v.get('Entry type')=='allocation':valid=valid and _cents(v.get('Settled (EUR)'))==_cents(v.get('Refunded (EUR)'))==0\\n        conflict=any(payload(r)!=payload(rows[0]) for r in rows[1:])\\n        previous=admitted.get(identity)\\n        # A changed authoritative source version can update an opening record;\\n        # conflicting payloads under the same retained version cannot.\\n        if previous and payload(previous)!=payload(rows[0]) and previous.get('source_sha256')==rows[0].get('source_sha256'):\\n            conflict=True\\n        if not valid or conflict:\\n            for affected in {scope_of(fields(r)) for r in rows}:\\n                issue(affected,'ledger-conflict:'+str(identity),'Invalid/unbound or conflicting budget ledger identity; admitted facts retained',refs)\\n            continue\\n        if not previous or payload(previous)!=payload(rows[0]) or previous.get('source_sha256')!=rows[0].get('source_sha256'):\\n            admitted[identity]=deepcopy(rows[0])\\n    for identity,row in admitted.items():\\n        value=fields(row);scope=scope_of(value);entry=ledger(scope)\\n        # Entries absent from a new input are not silently deleted.\\n        if identity not in seen_identities:\\n            issue(scope,'missing-ledger:'+str(identity),'Previously observed opening entry is absent; confirm explicit replacement/disposition',[ref(row)])\\n        amount=_cents(value['Allocation or commitment (EUR)']);settled=_cents(value['Settled (EUR)']);refund=_cents(value['Refunded (EUR)'])\\n        fact=dict(ledger_id=identity,amount_cents=amount,settled_cents=settled,refunded_cents=refund,\\n                  revision=value.get('Revision'),arrival_batch=value.get('Arrival batch'),source_version=row['source_sha256'],\\n                  source_refs=[ref(row)],source_record=deepcopy(row))\\n        key='allocations' if value['Entry type']=='allocation' else 'opening_obligations'\\n        target=identity if key=='allocations' else value['Obligation reference']\\n        if target in entry[key]:\\n            if {k:v for k,v in entry[key][target].items() if k not in {'source_record','source_refs','ledger_id'}}!={k:v for k,v in fact.items() if k not in {'source_record','source_refs','ledger_id'}}:\\n                issue(scope,'duplicate-obligation:'+target,'Multiple ledger identities disagree about one historical obligation',[ref(row)]+entry[key][target]['source_refs'])\\n            else:entry[key][target]['source_refs'].append(ref(row))\\n        else:entry[key][target]=fact\\n        entry['source_refs'].append(ref(row))\\n    request_scopes={};event_seen={}\\n    def event_scope(value):\\n        if value.get('Request reference') in request_scopes:return request_scopes[value['Request reference']]\\n        matches=[r for r in people if fields(r).get('Payee ID')==value.get('Payee ID') and source_bound(r,observations)]\\n        return scope_of(fields(matches[0])) if len(matches)==1 else None\\n    for claim_id,finance in finances.items():\\n        revisions=history.get('claim',{}).get(claim_id,{}).get('revisions',[])\\n        for event in sorted(finance.get('admitted_events',{}).values(),key=lambda e:(e['classification']!='obligation_accepted',utc_time(e['source_record']['Activity time (UTC)']))):\\n            value=event['source_record'];request=value.get('Request reference');batch=_revision(value.get('Arrival batch'))\\n            available=[r for r in revisions if _revision(r.get('arrival_batch')) and _revision(r['arrival_batch'])<=batch] if batch else []\\n            explicit=_revision(value.get('Claim revision'))\\n            candidates=[r for r in available if r['revision']==explicit] if explicit else [r for r in available if r['revision']==max((x['revision'] for x in available),default=None)]\\n            person=directory(fields(candidates[0]['record']).get('Employee')) if len(candidates)==1 else None\\n            scope=scope_of(fields(person)) if person else None\\n            original_scope=scope\\n            if request in request_scopes:scope=request_scopes[request]\\n            if event['classification']=='obligation_accepted':\\n                if request in request_scopes and request_scopes[request]!=original_scope:\\n                    issue(scope,'request-scope:'+request,'Request ownership conflicts across budget scopes',[ref(event['source_ref'])])\\n                request_scopes.setdefault(request,scope)\\n            entry=ledger(scope);entry['source_refs'].append(ref(event['source_ref']))\\n            if scope is None:issue(None,'event-scope:'+event['event_id'],'Admitted Finance event lacks an unambiguous historical budget scope',[ref(event['source_ref'])])\\n            if event['event_id'] in event_seen:\\n                if event_seen[event['event_id']]!=event:issue(scope,'event-identity:'+event['event_id'],'Finance identity disagrees across admitted histories',[ref(event['source_ref'])])\\n                continue\\n            event_seen[event['event_id']]=deepcopy(event)\\n            if not source_bound(event['source_ref'],observations):\\n                issue(scope,'event-source:'+event['event_id'],'Admitted Finance fact lacks a verified retained source binding for budget use',[ref(event['source_ref'])])\\n            req=entry['requests'].setdefault(request,dict(request_id=request,claim_id=claim_id,events=[],source_refs=[],\\n                commitment_cents=None,confirmed_payment_cents=0,confirmed_refund_cents=0,authorized_obligation_cents=None))\\n            if req['claim_id']!=claim_id:issue(scope,'request-owner:'+request,'Stable request ID is used by different claims',req['source_refs']+[ref(event['source_ref'])])\\n            req['events'].append(deepcopy(event));req['source_refs'].append(ref(event['source_ref']))\\n            if finance.get('authorized_obligation') is not None:\\n                req['authorized_obligation_cents']=finance['authorized_obligation']['amount_cents']\\n        for conflict in finance.get('conflicting_events',[]):\\n            value=next((e['source_record'] for e in finance.get('event_history',[]) if e['event_id']==conflict['event_id']),{})\\n            scope=event_scope(value)\\n            issue(scope,'finance-conflict:'+conflict['event_id'],'Conflicting Finance replay holds the scope without erasing admitted commitments/cash',\\n                  [ref(r) for r in conflict.get('source_refs',[])])\\n        for unresolved in [e for e in finance.get('event_history',[]) if e['event_id'] not in finance.get('admitted_events',{})]:\\n            value=unresolved.get('source_record',{});scope=event_scope(value)\\n            issue(scope,'finance-unresolved:'+str(unresolved.get('event_id')),'Unresolved Finance event may affect available budget',[ref(unresolved['source_ref'])])\\n    for key,entry in list(scopes.items()):\\n        for request,req in entry['requests'].items():\\n            controls=[]\\n            for event in req['events']:\\n                category=event['classification']\\n                if category=='finance_cancelled' and event.get('original_activity_id'):\\n                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'attempt-cancel:'+event['event_id'],\\n                          'Finance cancellation names a transfer activity; disposition of the accepted request commitment remains unconfirmed',req['source_refs'])\\n                elif category in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'}:\\n                    controls.append(event)\\n                if category=='confirmed_payment':req['confirmed_payment_cents']+=event['amount_cents']\\n                if category=='confirmed_refund':req['confirmed_refund_cents']+=event['amount_cents']\\n            controls.sort(key=lambda e:(utc_time(e['source_record']['Activity time (UTC)']),e['event_id']))\\n            for left,right in zip(controls,controls[1:]):\\n                if utc_time(left['source_record']['Activity time (UTC)'])==utc_time(right['source_record']['Activity time (UTC)']) and left['obligation_cents']!=right['obligation_cents']:\\n                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'control-order:'+request,'Request controls conflict at the same UTC time',req['source_refs'])\\n            accepted=[e for e in controls if e['classification']=='obligation_accepted']\\n            if accepted:\\n                req['commitment_cents']=0 if controls[-1]['classification']=='finance_cancelled' else controls[-1]['obligation_cents']\\n                req['acceptance']=deepcopy(accepted[0])\\n            else:issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'missing-acceptance:'+str(request),'Cash/control has no admitted original accepted obligation',req['source_refs'])\\n            opening=entry['opening_obligations'].get(request)\\n            if opening:\\n                # A native opening summary and full event history for the same\\n                # request must agree; neither is an additional obligation.\\n                if (opening['amount_cents'],opening['settled_cents'],opening['refunded_cents'])!=(req['commitment_cents'],req['confirmed_payment_cents'],req['confirmed_refund_cents']):\\n                    issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'opening-overlap:'+request,'Opening/request overlap lacks an explicit snapshot boundary; totals disagree',opening['source_refs']+req['source_refs'])\\n                entry['opening_obligations'].pop(request)\\n            req['net_paid_cents']=req['confirmed_payment_cents']-req['confirmed_refund_cents']\\n            req['remaining_commitment_cents']=max(0,req['commitment_cents']-req['net_paid_cents']) if req['commitment_cents'] is not None else None\\n            req['recorded_balance_cents']=req['commitment_cents']-req['net_paid_cents'] if req['commitment_cents'] is not None else None\\n    # Raw unmatched/held imports remain reviewable and cannot disappear from scope risk.\\n    represented={e['event_id'] for f in finances.values() for e in f.get('event_history',[])}\\n    for row in raw_finance:\\n        v=fields(row)\\n        if v.get('Activity reference') in represented:continue\\n        matches=[r for r in people if fields(r).get('Payee ID')==v.get('Payee ID') and source_bound(r,observations)]\\n        scope=scope_of(fields(matches[0])) if len(matches)==1 else None\\n        issue(scope,'unmatched:'+str(v.get('Activity reference')),'Unmatched Finance import may affect scope budget; retained without cash admission',[ref(row)])\\n    global_unknown_risk=bool(scopes.get('unassigned',{}).get('issues'))\\n    for key,entry in scopes.items():\\n        opening=list(entry['opening_obligations'].values());requests=list(entry['requests'].values())\\n        entry['allocation_cents']=sum(v['amount_cents'] for v in entry['allocations'].values()) if entry['allocations'] else None\\n        entry['historical_net_settled_cents']=sum(v['settled_cents']-v['refunded_cents'] for v in opening)\\n        entry['confirmed_payment_cents']=sum(v['confirmed_payment_cents'] for v in requests)\\n        entry['confirmed_refund_cents']=sum(v['confirmed_refund_cents'] for v in requests)\\n        entry['net_settled_cents']=entry['historical_net_settled_cents']+entry['confirmed_payment_cents']-entry['confirmed_refund_cents']\\n        entry['remaining_commitment_cents']=sum(max(0,v['amount_cents']-(v['settled_cents']-v['refunded_cents'])) for v in opening)+sum(v['remaining_commitment_cents'] or 0 for v in requests)\\n        if not entry['allocations']:\\n            issue(tuple(entry['scope'][k] for k in SCOPE) if entry['scope'] else None,'allocation-missing','No source-backed allocation for this exact department/project/period',entry['source_refs'],owner='Budget owner')\\n        valid=policy_valid(parsed.get('expense_policy')) and not entry['issues'] and not global_unknown_risk\\n        entry['available_cents']=entry['allocation_cents']-entry['net_settled_cents']-entry['remaining_commitment_cents'] if valid else None\\n        entry['known_available_cents']=entry['allocation_cents']-entry['net_settled_cents']-entry['remaining_commitment_cents'] if entry['allocation_cents'] is not None else None\\n        entry['status']='PASS' if valid else 'BLOCKED'\\n        entry['fingerprint']=fingerprint(dict(allocations=entry['allocations'],opening=entry['opening_obligations'],requests={k:dict(amount=v['commitment_cents'],claim=v['claim_id']) for k,v in entry['requests'].items()}))\\n        entry['source_refs']=list(dict.fromkeys(entry['source_refs']))\\n    return dict(scopes=scopes,issues=issues,admitted_budget_entries=admitted,arrival_batch=arrival_batch,\\n                budget_deliveries=deepcopy(table(parsed,'budget','Budget')),\\n                policy_verified=policy_valid(parsed.get('expense_policy')),\\n                policy_source_refs=[f\\\"{(parsed.get('expense_policy') or {}).get('path')}@{(parsed.get('expense_policy') or {}).get('sha256')}#line {n}\\\" for n in (13,17,19)] if policy_valid(parsed.get('expense_policy')) else [])\\n\\n\\ndef cost_signature(record,line):\\n    v=fields(record)\\n    return (v.get('Employee'),v.get('Trip reference'),line['cost_id'],line['receipt_id'],line['currency'],line['original_amount'])\\n\\n\\ndef attribute_costs(*,parsed,history,budgets,arrival_batch,observations,cancellations=()):\\n    \\\"\\\"\\\"Map discrete supported lines to stable requests; never prorate an aggregate.\\\"\\\"\\\"\\n    from .ordinary import expense_lines\\n    index=defaultdict(list);unknown=defaultdict(list);requests={}\\n    for scope in budgets['scopes'].values():\\n        for request,row in scope['requests'].items():requests[request]=row\\n    ordered=sorted((r for r in requests.values() if r.get('acceptance')),\\n                   key=lambda r:(utc_time(r['acceptance']['source_record']['Activity time (UTC)']),r['request_id']))\\n    for request in ordered:\\n        claim_id=request['claim_id'];accept=request['acceptance'];v=accept['source_record']\\n        revisions=history.get('claim',{}).get(claim_id,{}).get('revisions',[])\\n        explicit=_revision(v.get('Claim revision'));batch=_revision(v.get('Arrival batch'))\\n        eligible=[r for r in revisions if _revision(r.get('arrival_batch')) and _revision(r['arrival_batch'])<=batch]\\n        selected=[r for r in eligible if r['revision']==explicit] if explicit else [r for r in eligible if r['revision']==max((x['revision'] for x in eligible),default=None)]\\n        if len(selected)!=1:continue\\n        source=selected[0];record=source['record'];value=fields(record);lines=expense_lines(record)\\n        trips=[r for r in table(parsed,'trips','Trips') if fields(r).get('Trip reference')==value.get('Trip reference')\\n               and _revision(fields(r).get('Trip revision'))==_revision(value.get('Trip revision'))]\\n        context=[finding('travel_cancellation','Retained cancellation disposition context',c.get('source_refs',[]),c['cancellation_id'])\\n                 for c in cancellations if c['cancellation_id']==value.get('Travel cancellation reference')]\\n        evaluate_expenses(lines=lines,parsed=parsed,employee=value.get('Employee'),trip_id=value.get('Trip reference'),\\n            trip=fields(trips[0]) if len(trips)==1 else {},record=record,history=eligible,fields=fields,ref=ref,table=table,\\n            observations=observations,eligibility_findings=context)\\n …2794 tokens truncated…ref(trip_record)],scope_source_refs=ledger['source_refs'],\\n        ledger_refs=list(ledger['allocations'])+[x['ledger_id'] for x in ledger['opening_obligations'].values()],\\n        context_fingerprint=ledger['fingerprint'],available_cents=ledger['available_cents'])\\n    result['material_batch']=(prior.get('material_batch') or arrival_batch) if prior and (prior.get('context_fingerprint')!=result['context_fingerprint'] or prior.get('material_batch')) else None\\n    result['material_event_times']=[e['source_record']['Activity time (UTC)'] for r in ledger['requests'].values() for e in r['events']\\n        if e['classification'] in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'}]\\n    result['status']='PASS' if ledger['status']=='PASS' and amount is not None and ledger['available_cents'] is not None and ledger['available_cents']>=amount else 'BLOCKED'\\n    return result\\n\\\"\\\"\\\"Policy budget arithmetic and actual retained rows; mutations are synthetic.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom pathlib import Path\\nimport json\\n\\nimport pytest\\n\\nfrom test_ordinary import synthetic,batches,workflow,stages,row\\nfrom test_expenses import setfield\\nfrom travel_claim.approvals import fields,table,ref\\nfrom travel_claim.budget import reconcile_budgets,scope_id,budget_reply_error,claim_budget_view\\nfrom travel_claim.expenses import load_expense_policy\\nfrom travel_claim.integration import integrate_arrival_batch\\n\\nSCOPE=scope_id(('Consulting','Client-A','2026'))\\n\\n\\ndef scope(result):return result['domain']['budget']['scopes'][SCOPE]\\n\\n\\ndef native():\\n    p=json.loads((Path(__file__).parent/'fixtures/retained_budget_records.json').read_text())\\n    p['expense_policy']=load_expense_policy(Path(__file__).parent/'fixtures/POL-2026.2-browser-copy.txt')\\n    p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}\\n    return p\\n\\n\\ndef run_one(p,batch=1,prior=None):\\n    return integrate_arrival_batch(p,arrival_batch=batch,run_id='budget-test',batch_id=f'arrival-{batch:03d}',\\n        source_binding={'path':'sources.json','sha256':'a'*64},predecessor={'path':f'batches/arrival-{batch-1:03d}.json','sha256':'b'*64} if prior else None,\\n        prior_result=prior,source_observations=p['source_observations'])\\n\\n\\ndef test_native_opening_ledger_does_not_subtract_settled_part_twice():\\n    p=synthetic();p['records']['claim_revisions']=[];p['records']['finance_events']=[]\\n    value=scope(run_one(p))\\n    assert value['allocation_cents']==2000000\\n    assert value['historical_net_settled_cents']==200000\\n    assert value['remaining_commitment_cents']==300000\\n    assert value['available_cents']==1500000\\n    assert value['opening_obligations']['OLD-1']['revision'] is None\\n    assert value['opening_obligations']['OLD-1']['arrival_batch'] is None\\n    assert value['opening_obligations']['OLD-1']['source_refs']\\n\\n\\ndef test_request_settlement_and_exact_redelivery_never_double_count():\\n    results=batches(synthetic());first,paid,_,final=results\\n    assert scope(first)['available_cents']==scope(paid)['available_cents']==1490000\\n    assert scope(first)['requests']['REQ-SYN-C01']['authorized_obligation_cents']==10000\\n    assert scope(first)['requests']['REQ-SYN-C01']['authorized_balance_cents']==10000\\n    assert scope(paid)['requests']['REQ-SYN-C01']['authorized_balance_cents']==0\\n    assert scope(first)['remaining_commitment_cents']==310000\\n    assert scope(paid)['remaining_commitment_cents']==300000\\n    assert scope(paid)['confirmed_payment_cents']==10000\\n    assert scope(final)['requests']['REQ-SYN-C01']['confirmed_payment_cents']==10000\\n    assert len(scope(final)['requests']['REQ-SYN-C01']['events'])==2\\n    assert final['finance_reconciliations']['SYN-C01']['admitted_events']==paid['finance_reconciliations']['SYN-C01']['admitted_events']\\n\\n\\n@pytest.mark.parametrize('allocation,expected',[(5000,'BLOCKED'),(5100,'PASS'),(5099.99,'BLOCKED')])\\ndef test_budget_exhaustion_and_exact_funding_boundary(allocation,expected):\\n    p=synthetic();budget=table(p,'budget','Budget')[0];setfield(budget,'Allocation or commitment (EUR)',allocation)\\n    current=workflow(batches(p)[-1])\\n    assert current['budget_view']['status']==expected\\n    assert stages(current)['budget_availability']['status']==expected\\n    assert (current['request'] is not None)==(expected=='PASS')\\n    assert current['lines'][0]['calculated_cents']==10000\\n\\n\\n@pytest.mark.parametrize('field,value',[('Allocation or commitment (EUR)',None),('Allocation or commitment (EUR)',True),\\n    ('Settled (EUR)','0.001'),('Refunded (EUR)',1),('Currency','USD'),('Ledger reference',None),\\n    ('Entry type','unknown'),('Revision',True),('Arrival batch','1.5')])\\ndef test_invalid_budget_identity_precision_and_optional_membership_are_held(field,value):\\n    p=synthetic();setfield(table(p,'budget','Budget')[0],field,value)\\n    result=run_one(p)\\n    assert scope(result)['status']=='BLOCKED'\\n    assert scope(result)['available_cents'] is None\\n    assert workflow(result)['request'] is None\\n\\n\\ndef test_missing_scope_allocation_never_defaults_to_zero_or_borrows_other_scope():\\n    p=synthetic();person=table(p,'people','People')[0];setfield(person,'Project','MISSING')\\n    value=workflow(run_one(p))['budget_view']\\n    assert value['status']=='BLOCKED' and value.get('available_cents') is None\\n\\n\\ndef test_exact_duplicate_ledger_is_inert_and_conflict_preserves_admitted_facts():\\n    p=synthetic();budget=table(p,'budget','Budget');budget.append(deepcopy(budget[0]))\\n    initial=run_one(p);assert scope(initial)['allocation_cents']==2000000\\n    setfield(budget[-1],'Allocation or commitment (EUR)',1)\\n    result=run_one(p,2,initial)\\n    assert scope(result)['allocation_cents']==2000000 and scope(result)['available_cents'] is None\\n    assert result['domain']['budget']['admitted_budget_entries']['B-ALLOC']==initial['domain']['budget']['admitted_budget_entries']['B-ALLOC']\\n\\n\\ndef test_version_bound_opening_correction_changes_budget_and_revalidates_only_budget_role():\\n    p=synthetic();first=run_one(p)\\n    # Separate synthetic ledger source isolates this budget change from unchanged trip/directory facts.\\n    new_rows=deepcopy(table(p,'budget','Budget'))\\n    for r in new_rows:r.update(source_id='synthetic-budget-revision',source_sha256='d'*64)\\n    setfield(new_rows[0],'Allocation or commitment (EUR)',19000)\\n    p['records']['budget']=new_rows\\n    p['source_observations'].append(dict(source_id='synthetic-budget-revision',sha256='d'*64,status='read',missing_scope=[]))\\n    changed=run_one(p,2,first);view=workflow(changed)['budget_view']\\n    assert scope(changed)['allocation_cents']==1900000\\n    assert view['material_batch']==2\\n    deliveries=workflow(changed)['claim_approval']['deliveries']\\n    assert next(d for d in deliveries if 'administration' in d['roles'])['evidence_valid']\\n    owner=next(d for d in deliveries if 'budget_owner' in d['roles'])\\n    assert owner['evidence_valid'] and not owner['budget_evidence_valid']\\n    assert stages(workflow(changed))['request_obligation']['status']=='BLOCKED'\\n    decision=deepcopy(p['records']['decisions'][1]);setfield(decision,'Decision reference','SYN-BUDGET-REVIEW-NEW');setfield(decision,'Arrival batch',3)\\n    setfield(decision,'Decision time (UTC)','2026-09-13T12:00:00');setfield(decision,'Source revisions','SRC-D-3\\\\nPOL-2026.2\\\\n'+'d'*64)\\n    packet=deepcopy(table(p,'review_packets','Review packets')[1]);setfield(packet,'Decision reference','SYN-BUDGET-REVIEW-NEW')\\n    p['records']['decisions'].append(decision);table(p,'review_packets','Review packets').append(packet)\\n    # Existing request names old decisions, so recovered budget authority alone never sends a new request.\\n    recovered=run_one(p,3,changed)\\n    assert workflow(recovered)['claim_approval']['approved']\\n    assert workflow(recovered)['request'] is None\\n    assert scope(recovered)['allocation_cents']==1900000\\n\\n\\ndef test_native_prepaid_cost_corrections_cancellations_refunds_and_refs():\\n    results=batches(native());first,paid,changed,final=results\\n    c24=workflow(changed,'C24')['budget_view']\\n    assert c24['prior_committed_cents']==c24['prior_net_paid_cents']==20000\\n    assert c24['remaining_request_cents']==5000\\n    cost=next(l for l in c24['lines'] if l['cost_id']=='COST-03')\\n    assert cost['remaining_request_cents']==0 and cost['prior_reservations'][0]['request_id']=='REQ-C03'\\n    assert any('#PDF page 3' in r for r in cost['source_refs'])\\n    req18=scope(changed)['requests']['REQ-C18'];assert req18['commitment_cents']==0 and req18['net_paid_cents']==0\\n    late18=scope(final)['requests']['REQ-C18'];assert late18['commitment_cents']==0 and late18['net_paid_cents']==10000\\n    assert scope(changed)['requests']['REQ-C19']['recorded_balance_cents']==-2000\\n    req19=scope(final)['requests']['REQ-C19']\\n    assert req19['confirmed_payment_cents']==10000 and req19['confirmed_refund_cents']==2000\\n    assert req19['commitment_cents']==8000 and req19['remaining_commitment_cents']==0\\n    assert scope(final)['available_cents']==1457000\\n    assert all(finance.get('authorized_obligation') is None for finance in final['finance_reconciliations'].values())\\n    assert final['finance_reconciliations']['C18']['net_confirmed_cents']==10000\\n    assert scope(first)['opening_obligations']==scope(final)['opening_obligations']\\n\\n\\ndef test_business_cancellation_alone_does_not_release_finance_commitment():\\n    p=native();p['records']['finance_events']=[r for r in p['records']['finance_events'] if fields(r).get('Activity reference')!='F-C18-2']\\n    result=batches(p)[-1]\\n    assert scope(result)['requests']['REQ-C18']['commitment_cents']==10000\\n    assert result['snapshot']['travel_cancellations']\\n\\n\\ndef test_conflicting_finance_redelivery_holds_without_erasing_paid_money():\\n    p=synthetic();first=run_one(p);paid=run_one(p,2,first)\\n    duplicate=deepcopy(p['records']['finance_events'][1]);setfield(duplicate,'Arrival batch',3);setfield(duplicate,'Amount (EUR)',999)\\n    p['records']['finance_events'].append(duplicate)\\n    held=run_one(p,3,paid)\\n    assert scope(held)['available_cents'] is None and scope(held)['confirmed_payment_cents']==10000\\n    assert held['finance_reconciliations']['SYN-C01']['admitted_events']==paid['finance_reconciliations']['SYN-C01']['admitted_events']\\n\\n\\ndef test_budget_sufficiency_is_not_human_budget_approval():\\n    p=synthetic();p['records']['decisions']=[d for d in p['records']['decisions'] if fields(d).get('Review roles')!='budget_owner']\\n    value=workflow(batches(p)[-1]);assert value['budget_view']['status']=='PASS'\\n    assert not value['claim_approval']['approved'] and value['request'] is None\\n\\n\\ndef test_exact_batch_replay_preserves_scope_prepaid_history_and_admitted_events():\\n    p=synthetic();first=run_one(p)\\n    replay=integrate_arrival_batch(p,arrival_batch=1,run_id='budget-test',batch_id='arrival-001',\\n        source_binding={'path':'sources.json','sha256':'a'*64},prior_result=first,source_observations=p['source_observations'])\\n    assert replay['domain']==first['domain'] and replay['snapshot']==first['snapshot']\\n\\n\\ndef test_refund_alone_does_not_release_an_unchanged_commitment():\\n    p=synthetic();refund=deepcopy(p['records']['finance_events'][1])\\n    setfield(refund,'Activity reference','SYN-REFUND');setfield(refund,'Activity type','refund')\\n    setfield(refund,'Arrival batch',3);setfield(refund,'Amount (EUR)',20)\\n    setfield(refund,'Original activity reference',fields(p['records']['finance_events'][1])['Activity reference'])\\n    setfield(refund,'Activity time (UTC)','2026-09-13T12:00:00');p['records']['finance_events'].append(refund)\\n    results=batches(p);before=scope(results[1]);after=scope(results[-1])\\n    assert after['confirmed_refund_cents']==2000\\n    assert after['requests']['REQ-SYN-C01']['remaining_commitment_cents']==2000\\n    assert before['available_cents']==after['available_cents']\\n\\n\\ndef test_ambiguous_shared_cost_allocation_is_held_not_prorated():\\n    p=synthetic();result=run_one(p);record=p['records']['claim_revisions'][0]\\n    from travel_claim.ordinary import expense_lines\\n    attribution={'costs':{},'unallocated_costs':{'COST-01':[dict(claim_id='EARLIER',request_id='REQ-EARLIER',source_refs=[ref(record)])]}}\\n    view=claim_budget_view(parsed=p,claim=result['domain']['revision_history']['claim']['SYN-C01']['revisions'][0],\\n        lines=[dict(expense_lines(record)[0],calculated_cents=10000)],budgets=result['domain']['budget'],attribution=attribution,arrival_batch=1)\\n    assert view['remaining_request_cents'] is None and view['status']=='BLOCKED'\\n    assert any('allocation' in i['reason'] for i in view['issues'])\\n\\n\\ndef test_budget_owner_packet_must_include_the_whole_scope_ledger():\\n    p=synthetic();packet=table(p,'review_packets','Review packets')[1]\\n    setfield(packet,'Budget record references','B-ALLOC')\\n    value=workflow(batches(p)[-1])\\n    assert value['budget_view']['status']=='PASS' and not value['claim_approval']['approved']\\n    owner=next(d for d in value['claim_approval']['deliveries'] if 'budget_owner' in d['roles'])\\n    assert 'omits' in owner['budget_revalidation_reason']\\n\\n\\ndef test_correction_cannot_offset_a_different_cost_with_an_old_own_commitment():\\n    p=native();p['records']['finance_events']=[r for r in p['records']['finance_events'] if fields(r).get('Activity reference')!='F-C18-2']\\n    result=batches(p)[-1];view=workflow(result,'C18')['budget_view']\\n    assert scope(result)['requests']['REQ-C18']['commitment_cents']==10000\\n    assert view['remaining_request_cents']==10000\\n    assert view['existing_recorded_commitment_cents']==0 and view['incremental_cents']==10000\\n\\n\\ndef test_other_scope_conflict_does_not_block_an_independent_valid_claim():\\n    p=synthetic();other=deepcopy(table(p,'budget','Budget')[0]);setfield(other,'Ledger reference','OTHER-ALLOC');setfield(other,'Project','OTHER')\\n    conflict=deepcopy(other);setfield(conflict,'Allocation or commitment (EUR)',1)\\n    table(p,'budget','Budget').extend([other,conflict]);result=batches(p)[-1]\\n    assert scope(result)['status']=='PASS' and workflow(result)['status']=='closed-reimbursed'\\n    assert result['domain']['budget']['scopes'][scope_id(('Consulting','OTHER','2026'))]['status']=='BLOCKED'\\n\\n\\ndef test_prior_paid_cost_mismatch_requires_finance_repair_instead_of_zero():\\n    p=native();record=next(r for r in p['records']['claim_revisions'] if fields(r).get('Claim reference')=='C24')\\n    # No invented evidence: a deliberately broken link must remain unresolved.\\n    setfield(record,'Related earlier claims','None')\\n    value=workflow(batches(p)[-1],'C24')['budget_view']\\n    assert value['status']=='BLOCKED' and value['remaining_request_cents'] is None\\n    assert any('linkage' in i['reason'] for i in value['issues'])\\n\\n\\ndef test_budget_membership_uses_only_arrived_rows_and_keeps_first_replay_context():\\n    p=synthetic();original=table(p,'budget','Budget')[0];setfield(original,'Arrival batch',1)\\n    first=run_one(p)\\n    duplicate=deepcopy(original);setfield(duplicate,'Arrival batch',2);duplicate['locator']='SYNTHETIC redelivered ledger'\\n    p['records']['budget']=[duplicate]+deepcopy(table(p,'budget','Budget')[1:])\\n    second=run_one(p,2,first)\\n    fact=second['domain']['budget']['admitted_budget_entries']['B-ALLOC']\\n    assert fields(fact)['Arrival batch']==1 and fact['locator']==original['locator']\\n    assert scope(first)['allocation_cents']==scope(second)['allocation_cents']==2000000\\n    assert second['domain']['budget']['budget_deliveries'][0]['locator']==duplicate['locator']\\n    future=deepcopy(original);setfield(future,'Arrival batch',4);setfield(future,'Ledger reference','FUTURE-ALLOCATION')\\n    p['records']['budget'].append(future)\\n    third=run_one(p,3,second)\\n    assert scope(third)['allocation_cents']==2000000\\n\\n\\ndef test_tampered_budget_readiness_state_fails_evidence_replay(tmp_path):\\n    from test_readiness import _run,_repo,SCHEMA\\n    from travel_claim.readiness import validate_readiness\\n    run=_run(tmp_path);path=run/'offline-replay-state.json';state=json.loads(path.read_text())\\n    state['budget_reconciliation']['arrival_batch']=999;path.write_text(json.dumps(state))\\n    report=validate_readiness(run,schema_path=SCHEMA,repo_dir=_repo(tmp_path))\\n    assert report['status']=='FAIL'\\n    assert any(c['status']=='FAIL' and c['check']=='snapshot-content-evidence' for c in report['checks'])\\n\\n\\ndef test_budget_owner_repairs_are_grouped_with_exact_claim_revision_and_sources():\\n    p=synthetic();setfield(table(p,'budget','Budget')[0],'Allocation or commitment (EUR)',1)\\n    result=run_one(p);items=result['repair_queue_by_owner']['LEAD-01']\\n    item=next(i for i in items if 'budget_owner_authorization' in i['item_id'])\\n    assert item['subject_id']=='SYN-C01' and item['revision']==1 and item['status']=='open'\\n    assert item['source_refs'] and all('@' in r and '#' in r for r in item['source_refs'])\\n    assert 'complete scope ledger' in item['next_action']\\n\\n\\ndef test_transfer_attempt_cancellation_is_not_request_release_or_cash_refund():\\n    p=synthetic();transfer=p['records']['finance_events'][1];cancel=deepcopy(transfer)\\n    setfield(cancel,'Activity reference','SYN-ATTEMPT-CANCEL');setfield(cancel,'Activity type','cancelled')\\n    setfield(cancel,'Arrival batch',3);setfield(cancel,'Original activity reference',fields(transfer)['Activity reference'])\\n    setfield(cancel,'Activity time (UTC)','2026-09-13T12:00:00');cancel['values'].pop('Amount (EUR)',None)\\n    p['records']['finance_events'].append(cancel)\\n    result=batches(p)[-1];request=scope(result)['requests']['REQ-SYN-C01']\\n    assert request['commitment_cents']==10000 and request['net_paid_cents']==10000\\n    assert request['confirmed_refund_cents']==0 and scope(result)['status']=='BLOCKED'\\n    assert any('transfer activity' in i['reason'] for i in scope(result)['issues'])\\n\\n\\ndef test_new_finance_batch_can_be_reviewed_using_verified_native_printed_version():\\n    p=synthetic();result=run_one(p);context=deepcopy(workflow(result)['budget_view'])\\n    context.update(material_batch=2,requires_exact_source=False,printed_source_versions=['SRC-D-3'])\\n    decision=deepcopy(p['records']['decisions'][1]);setfield(decision,'Arrival batch',3)\\n    setfield(decision,'Decision time (UTC)','2026-09-13T12:00:00')\\n    assert budget_reply_error(context,decision,table(p,'review_packets','Review packets')[1]) is None\\n    context['requires_exact_source']=True\\n    assert 'version binding' in budget_reply_error(context,decision,table(p,'review_packets','Review packets')[1])\\n\\n\\n@pytest.mark.parametrize('identity',[True,1,' '])\\ndef test_budget_ledger_identity_requires_a_stable_nonblank_string(identity):\\n    p=synthetic();setfield(table(p,'budget','Budget')[0],'Ledger reference',identity)\\n    result=run_one(p)\\n    assert scope(result)['status']=='BLOCKED' and scope(result)['allocation_cents'] is None\\n\\n\\ndef test_future_redelivery_does_not_retire_an_already_observed_opening_fact():\\n    p=synthetic();first=run_one(p)\\n    rows=deepcopy(table(p,'budget','Budget'));setfield(rows[0],'Arrival batch',4);p['records']['budget']=rows\\n    second=run_one(p,2,first)\\n    assert scope(second)['status']=='PASS' and scope(second)['allocation_cents']==2000000\\n\"}\n{\"chunk_id\":\"e47f64\",\"wall_time_seconds\":1.00045825,\"session_id\":66224,\"original_token_count\":0,\"output\":\"\"}\n{\"chunk_id\":\"c4e263\",\"wall_time_seconds\":1.62679605,\"exit_code\":0,\"original_token_count\":93,\"output\":\"129 preserved hashes match; closure block unchanged; fixture matches retained sources; diff checks pass\\nFixture provenance: {'kind': 'verbatim selected retained budget, C03/C24 prepaid linkage, correction and Finance cancellation/refund records; no new retrieval or approvals', 'parsed_records_path': 'artifacts/runs/project-d-live-20261014T204849Z/parsed-records.json'}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13d23-b1d8-7cd0-b6b8-346ddbc0e031","create_time":1792027202.749415}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
