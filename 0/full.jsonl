lemental_policy_binding is not None:\\n+        snapshot['supplemental_policy_binding'] = copy.deepcopy(supplemental_policy_binding)\\n+        snapshot['event_clock'] = copy.deepcopy(event_clock)\\n     if budget_reconciliation is not None:\\n         snapshot[\\\"budget_reconciliation\\\"] = copy.deepcopy(budget_reconciliation)\\n     if permit_approvals is not None:\\n\"}\n{\"chunk_id\":\"61986c\",\"wall_time_seconds\":0.0679778,\"exit_code\":0,\"original_token_count\":4625,\"output\":\"\\\"\\\"\\\"Supplemental browser policy evidence; never a native Notion acquisition.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\n\\nfrom .expenses import load_expense_policy, POLICY_SHA256\\nfrom .sources import verify_source_manifest, SOURCES\\n\\nPOLICY_PATH = 'supplemental/POL-2026.2-browser-copy.txt'\\nEVIDENCE_PATH = 'supplemental-policy.json'\\nCLOCK = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}\\nPROVENANCE = 'user-provided browser-visible copy; not native HTTP/API retrieval'\\n\\n\\ndef digest(path):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\ndef metadata():\\n    return dict(schema_version='supplemental-policy/1', policy_version='POL-2026.2',\\n                path=POLICY_PATH, sha256=POLICY_SHA256, provenance=PROVENANCE,\\n                native_acquisition=False, source_url=SOURCES[0].url,\\n                attestation='User personally copied the complete visible text from the original Notion page; remote block-tree completeness not independently verified',\\n                retrieval_time=None, case_clock=dict(CLOCK, precision='calendar-date'),\\n                source_refs=[f'{POLICY_PATH}@{POLICY_SHA256}#line {n}' for n in range(1, 34)])\\n\\n\\ndef apply_policy(parsed, binding):\\n    \\\"\\\"\\\"Bind verified supplemental evidence without supplying business authority.\\\"\\\"\\\"\\n    parsed = deepcopy(parsed)\\n    # Stable relative paths make references independent of the caller's cwd.\\n    parsed.update(expense_policy=binding, event_clock=deepcopy(CLOCK),\\n                  supplemental_policy=metadata())\\n    # Keep the native clock and policy-access observation intact. Only the\\n    # historical wholly-unknown-clock issue is superseded by explicit evidence.\\n    parsed['case_clock_issue'] = None\\n    parsed['unresolved_issues'] = [i for i in parsed.get('unresolved_issues', [])\\n                                  if i.get('record_id') != 'scenario-case-clock']\\n    for issue in parsed['unresolved_issues']:\\n        if issue.get('record_id') == 'reimbursement-policy-pol-2026-2':\\n            issue.update(reason='Native Notion content remains inaccessible or incomplete; verified supplemental browser policy is separately bound.',\\n                         affected_scope='fresh native-source compliance; supplemental policy wording is available',\\n                         evidence_needed='Complete fresh native Notion acquisition; do not substitute browser provenance')\\n    return parsed\\n\\n\\ndef verify_policy_evidence(run_dir, parsed=None):\\n    \\\"\\\"\\\"Return the bound sidecar identity; reject missing/tampered evidence.\\\"\\\"\\\"\\n    run_dir = Path(run_dir)\\n    obj = json.loads((run_dir / EVIDENCE_PATH).read_text(encoding='utf-8'))\\n    if obj != metadata():\\n        raise ValueError('Supplemental policy provenance/version/date evidence differs from verified policy')\\n    binding = load_expense_policy(run_dir / POLICY_PATH)\\n    binding['path'] = POLICY_PATH\\n    if parsed is not None:\\n        if (parsed.get('expense_policy') != binding or parsed.get('event_clock') != CLOCK\\n                or parsed.get('supplemental_policy') != obj or parsed.get('case_clock_issue')):\\n            raise ValueError('Parsed supplemental policy/clock binding mismatch')\\n    verify_lineage(run_dir, parsed)\\n    return {'path': EVIDENCE_PATH, 'sha256': digest(run_dir / EVIDENCE_PATH)}\\n\\n\\ndef create_policy_replay(source_dir, run_dir, *, run_id, browser_policy, schema_path):\\n    \\\"\\\"\\\"Create a new retained-input run, preserving native observation payloads.\\\"\\\"\\\"\\n    from .offline_replay import run_offline_replay\\n    source_dir, run_dir = Path(source_dir).resolve(), Path(run_dir).resolve()\\n    policy = load_expense_policy(browser_policy)  # Validate before creating anything.\\n    if not run_id or run_dir.name != run_id:\\n        raise ValueError('New run directory name must equal the explicit run ID')\\n    if run_dir == source_dir or run_dir.is_relative_to(source_dir):\\n        raise ValueError('New retained-input run must be outside the source run')\\n    errors = verify_source_manifest(source_dir)\\n    if errors:\\n        raise ValueError('; '.join(errors))\\n    manifest = json.loads((source_dir / 'sources.json').read_text(encoding='utf-8'))\\n    parsed = json.loads((source_dir / 'parsed-records.json').read_text(encoding='utf-8'))\\n    if not isinstance(manifest, dict) or not isinstance(parsed, dict):\\n        raise ValueError('Native manifest and parsed evidence must be objects')\\n    if run_id == manifest['run_id']:\\n        raise ValueError('New retained-input replay needs a distinct run ID')\\n    if parsed.get('run_id') != manifest['run_id'] or parsed.get('source_manifest') != {'path':'sources.json','sha256':digest(source_dir / 'sources.json')}:\\n        raise ValueError('Original parsed records do not bind retained native manifest')\\n    if parsed.get('expense_policy') or parsed.get('supplemental_policy'):\\n        raise ValueError('Use original native parsed inputs, not an already supplemented run')\\n    paths = set()\\n    for row in manifest['files']:\\n        paths.update(p for p in (row.get('path'), row.get('observation', {}).get('response_path')) if p)\\n    for relative in paths:\\n        if not (source_dir / relative).resolve().is_relative_to(source_dir):\\n            raise ValueError('Native evidence path escapes source run')\\n    run_dir.mkdir(parents=True, exist_ok=False)\\n    for relative in paths:\\n        target = run_dir / relative\\n        target.parent.mkdir(parents=True, exist_ok=True)\\n        with target.open('xb') as stream:\\n            stream.write((source_dir / relative).read_bytes())\\n    (run_dir / 'supplemental').mkdir(exist_ok=True)\\n    (run_dir / POLICY_PATH).write_bytes(policy['text'].encode('utf-8'))\\n    for name in ('sources.json', 'parsed-records.json'):\\n        (run_dir / 'supplemental' / ('original-' + name)).write_bytes((source_dir / name).read_bytes())\\n    manifest['run_id'] = run_id  # All five original observation entries remain identical.\\n    (run_dir / 'sources.json').write_text(json.dumps(manifest, indent=2) + '\\\\n')\\n    policy['path'] = POLICY_PATH\\n    parsed = apply_policy(parsed, policy)\\n    parsed.update(run_id=run_id, expense_policy=policy,\\n                  source_manifest={'path':'sources.json','sha256':digest(run_dir / 'sources.json')})\\n    (run_dir / EVIDENCE_PATH).write_text(json.dumps(metadata(), indent=2) + '\\\\n')\\n    (run_dir / 'retained-input-lineage.json').write_text(json.dumps(dict(\\n        mode='offline-replay', fresh_native_reads_performed=False, original_run_id=json.loads((source_dir / 'sources.json').read_text(encoding='utf-8'))['run_id'],\\n        original_inputs={name: {'path':'supplemental/original-'+name, 'sha256':digest(source_dir/name)} for name in ('sources.json','parsed-records.json')}), indent=2) + '\\\\n')\\n    (run_dir / 'parsed-records.json').write_text(json.dumps(parsed, indent=2, ensure_ascii=False) + '\\\\n')\\n    verify_policy_evidence(run_dir, parsed)\\n    return run_offline_replay(run_dir, schema_path=schema_path)\\n\\n\\ndef verify_lineage(run_dir, parsed=None):\\n    lineage = json.loads((run_dir / 'retained-input-lineage.json').read_text(encoding='utf-8'))\\n    if not isinstance(lineage, dict):\\n        raise ValueError('Supplemental lineage must be an object')\\n    if lineage.get('mode') != 'offline-replay' or lineage.get('fresh_native_reads_performed') is not False:\\n        raise ValueError('Supplemental lineage must be retained-input offline replay')\\n    originals = {}\\n    for name in ('sources.json', 'parsed-records.json'):\\n        item = lineage['original_inputs'][name]\\n        expected = 'supplemental/original-' + name\\n        if item['path'] != expected or digest(run_dir / expected) != item['sha256']:\\n            raise ValueError('Original retained input lineage hash mismatch')\\n        originals[name] = json.loads((run_dir / expected).read_text(encoding='utf-8'))\\n    original = originals['sources.json']\\n    native = json.loads((run_dir / 'sources.json').read_text(encoding='utf-8'))\\n    if (original['run_id'] != lineage['original_run_id'] or original['run_id'] == native['run_id']\\n            or {k:v for k,v in original.items() if k != 'run_id'} != {k:v for k,v in native.items() if k != 'run_id'}):\\n        raise ValueError('Native acquisition observations changed in supplemental replay')\\n    base = originals['parsed-records.json']\\n    if base.get('source_manifest') != {'path':'sources.json', 'sha256':digest(run_dir / 'supplemental/original-sources.json')} or base.get('run_id') != original['run_id']:\\n        raise ValueError('Original parsed input manifest binding mismatch')\\n    if parsed is not None:\\n        expected = apply_policy(base, parsed['expense_policy'])\\n        expected.update(run_id=native['run_id'], source_manifest={'path':'sources.json', 'sha256':digest(run_dir / 'sources.json')})\\n        if parsed != expected:\\n            raise ValueError('Supplemental replay changed original parsed source observations')\\n\\\"\\\"\\\"Supplemental browser evidence is reproducible and never native acquisition.\\\"\\\"\\\"\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom test_offline_replay import _capture, SCHEMA\\nfrom test_readiness import _repo\\nfrom travel_claim.cli import main\\nfrom travel_claim.policy_evidence import create_policy_replay, verify_policy_evidence, CLOCK, POLICY_PATH\\nfrom travel_claim.readiness import validate_readiness\\nfrom travel_claim.snapshots import verify_snapshot\\nfrom travel_claim.event_validation import observation_error, utc_time\\n\\nPOLICY = Path(__file__).parent / 'fixtures/POL-2026.2-browser-copy.txt'\\n\\n\\ndef inputs(tmp_path):\\n    source, _ = _capture(tmp_path)\\n    path = source / 'parsed-records.json'\\n    obj = json.loads(path.read_text())\\n    obj['records'] = {k: [] for k in obj['records']}\\n    path.write_text(json.dumps(obj))\\n    return source\\n\\n\\ndef replay(tmp_path):\\n    source = inputs(tmp_path)\\n    run = tmp_path / 'supplemented'\\n    create_policy_replay(source, run, run_id=run.name, browser_policy=POLICY, schema_path=SCHEMA)\\n    return source, run\\n\\n\\ndef test_cli_binds_exact_browser_copy_clock_lineage_and_keeps_native_failures(tmp_path, capsys):\\n    source = inputs(tmp_path)\\n    before = {str(p): p.read_bytes() for p in source.rglob('*') if p.is_file()}\\n    run = tmp_path / 'new-policy-replay'\\n    assert main(['policy-replay', str(source), str(run), '--run-id', run.name, '--browser-policy', str(POLICY)]) == 0\\n    assert 'no time inferred' in capsys.readouterr().out\\n    assert (run / POLICY_PATH).read_bytes() == POLICY.read_bytes()\\n    native = json.loads((run / 'sources.json').read_text())\\n    assert native['files'] == json.loads((source / 'sources.json').read_text())['files']\\n    assert native['case_clock'] is None\\n    assert native['files'][0]['status'] == 'unavailable'\\n    parsed = json.loads((run / 'parsed-records.json').read_text())\\n    assert parsed['event_clock'] == CLOCK and parsed['case_clock'] is None\\n    assert parsed['supplemental_policy']['native_acquisition'] is False\\n    assert parsed['supplemental_policy']['policy_version'] == 'POL-2026.2'\\n    assert 'not native HTTP/API' in parsed['expense_policy']['provenance']\\n    assert not any(i['record_id'] == 'scenario-case-clock' for i in parsed['unresolved_issues'])\\n    for snapshot in sorted((run / 'batches').glob('*.json')):\\n        assert verify_snapshot(snapshot, run, SCHEMA) == []\\n        obj = json.loads(snapshot.read_text())\\n        assert obj['event_clock'] == CLOCK\\n        assert obj['supplemental_policy_binding'] == verify_policy_evidence(run, parsed)\\n    assert before == {str(p): p.read_bytes() for p in source.rglob('*') if p.is_file()}\\n    report = (run / 'report.md').read_text()\\n    assert 'user-provided browser-visible copy' in report and 'Same-day cutoff' in report\\n    assert 'policy-pol-2026-2`=unavailable' in report\\n\\n\\ndef test_readiness_accepts_supplemental_integrity_but_keeps_native_and_offline_blockers(tmp_path):\\n    _, run = replay(tmp_path)\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    checks = {c['check']:c for c in result['checks']}\\n    assert result['integrity_status'] == 'PASS', [c for c in result['checks'] if c['status']=='FAIL']\\n    assert checks['supplemental-policy-evidence']['status'] == 'PASS'\\n    assert checks['authoritative-case-clock']['status'] == 'PASS'\\n    assert 'calendar-date' in checks['authoritative-case-clock']['detail']\\n    assert checks['source-completeness:policy-pol-2026-2']['status'] == 'BLOCKED'\\n    assert result['status'] == 'BLOCKED' and result['final_live_source_compliance'] is False\\n\\n\\n@pytest.mark.parametrize('target', [POLICY_PATH, 'supplemental-policy.json', 'retained-input-lineage.json',\\n    'supplemental/original-sources.json', 'supplemental/original-parsed-records.json'])\\ndef test_missing_or_tampered_evidence_is_integrity_failure(tmp_path, target):\\n    _, run = replay(tmp_path)\\n    path = run / target\\n    if target == POLICY_PATH:\\n        path.write_bytes(path.read_bytes() + b'\\\\n')\\n    else:\\n        path.unlink()\\n    with pytest.raises((OSError, ValueError, KeyError)):\\n        verify_policy_evidence(run)\\n    assert verify_snapshot(run / 'batches/arrival-001.json', run, SCHEMA)\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    assert result['status'] == 'FAIL'\\n\\n\\n@pytest.mark.parametrize('field,value', [('event_clock', {'date':'2026-11-15','timezone':'UTC'}),\\n    ('supplemental_policy', {}), ('expense_policy', {})])\\ndef test_parsed_binding_cannot_change_clock_provenance_or_policy(tmp_path, field, value):\\n    _, run = replay(tmp_path)\\n    parsed = json.loads((run / 'parsed-records.json').read_text())\\n    parsed[field] = value\\n    with pytest.raises(ValueError):\\n        verify_policy_evidence(run, parsed)\\n\\n\\ndef test_wrong_policy_or_missing_file_creates_no_run(tmp_path):\\n    source = inputs(tmp_path)\\n    wrong = tmp_path / 'wrong.txt'\\n    wrong.write_bytes(POLICY.read_bytes() + b'\\\\n')\\n    for policy in (wrong, tmp_path / 'absent.txt'):\\n        output = tmp_path / 'must-not-exist'\\n        assert main(['policy-replay', str(source), str(output), '--run-id', output.name, '--browser-policy', str(policy)]) == 1\\n        assert not output.exists()\\n\\n\\ndef test_existing_runs_are_never_overwritten(tmp_path):\\n    source, run = replay(tmp_path)\\n    before = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in run.rglob('*') if p.is_file()}\\n    with pytest.raises(FileExistsError):\\n        create_policy_replay(source, run, run_id=run.name, browser_policy=POLICY, schema_path=SCHEMA)\\n    assert before == {str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in run.rglob('*') if p.is_file()}\\n    with pytest.raises(ValueError):\\n        create_policy_replay(source, source, run_id=source.name, browser_policy=POLICY, schema_path=SCHEMA)\\n\\n\\n@pytest.mark.parametrize('stamp,expected', [('2026-11-14T22:59:59Z', None),\\n    ('2026-11-14T23:00:00Z', 'same-day'), ('2026-11-15T22:59:59Z', 'same-day'),\\n    ('2026-11-15T23:00:00Z', 'future')])\\ndef test_calendar_clock_preserves_amsterdam_day_and_unknown_cutoff(stamp, expected):\\n    error = observation_error(utc_time(stamp), CLOCK)\\n    assert error is None if expected is None else expected in error\\n\\n\\ndef test_native_observation_cannot_be_reclassified_by_supplemental_replay(tmp_path):\\n    _, run = replay(tmp_path)\\n    path = run / 'sources.json'\\n    obj = json.loads(path.read_text())\\n    obj['files'][0]['status'] = 'read'\\n    path.write_text(json.dumps(obj))\\n    with pytest.raises(ValueError, match='Native acquisition observations changed'):\\n        verify_policy_evidence(run)\\n\\n\\ndef test_state_clock_tamper_never_passes_authoritative_clock_check(tmp_path):\\n    _, run = replay(tmp_path)\\n    path = run / 'offline-replay-state.json'\\n    obj = json.loads(path.read_text())\\n    obj['event_clock'] = '2026-11-15T00:00:00Z'\\n    path.write_text(json.dumps(obj))\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    checks = {c['check']:c['status'] for c in result['checks']}\\n    assert checks['supplemental-policy-evidence'] == 'FAIL'\\n    assert checks['authoritative-case-clock'] == 'BLOCKED'\\n    assert result['status'] == 'FAIL'\\n\\n\\ndef test_date_only_binding_drives_existing_finance_admission_hold(tmp_path):\\n    from test_event_integrity import payment, finance, CONTEXT\\n    from copy import deepcopy\\n    _, run = replay(tmp_path)\\n    parsed = json.loads((run / 'parsed-records.json').read_text())\\n    context = deepcopy(CONTEXT)\\n    context['clock'] = parsed['event_clock']\\n    event = payment()\\n    event['values']['Activity time (UTC)']['value'] = '2026-11-15T12:00:00Z'\\n    result = finance([event], context=context)\\n    assert not result['admitted_events'] and result['net_confirmed_cents'] == 0\\n    assert 'same-day' in str(result['repair_issues'])\\n\\n\\ndef test_representative_retained_claim_preserves_supplemental_line_references(tmp_path):\\n    # Native C01 schema/records in a synthetic retained-byte harness. Rebinding\\n    # fixture hashes here is test data, never a claim about a real acquisition.\\n    source = inputs(tmp_path)\\n    path = source / 'parsed-records.json'\\n    base = json.loads(path.read_text())\\n    native = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\\n    rows = json.loads((source / 'sources.json').read_text())['files']\\n    by_id = {r['source_id']:r for r in rows}\\n    def bind(value):\\n        if isinstance(value, dict):\\n            if value.get('source_id') in by_id and 'source_sha256' in value:\\n                value['source_sha256'] = by_id[value['source_id']]['sha256']\\n            for child in value.values(): bind(child)\\n        elif isinstance(value, list):\\n            for child in value: bind(child)\\n    bind(native)\\n    base.update(records=native['records'], workbook_sheets=native['workbook_sheets'], arrival_batches=[1,2,3,4])\\n    path.write_text(json.dumps(base))\\n    run = tmp_path / 'representative'\\n    create_policy_replay(source, run, run_id=run.name, browser_policy=POLICY, schema_path=SCHEMA)\\n    snapshot = json.loads((run / 'batches/arrival-004.json').read_text())\\n    assert len(snapshot['claims']) == 1\\n    claim = snapshot['claims'][0]\\n    assert claim['claim_id'] == 'C01' and claim['status'] == 'pending'\\n    assert POLICY_PATH in claim['lines'][0]['source_ids']\\n    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\\n    assert result['integrity_status'] == 'PASS', [c for c in result['checks'] if c['status']=='FAIL']\\n    assert next(c['status'] for c in result['checks'] if c['check']=='repair-queue-traceability') == 'PASS'\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13d3a-e781-7d53-937d-65692093e8a5","create_time":1792028641.2955563}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
