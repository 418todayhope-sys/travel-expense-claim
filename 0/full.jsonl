ion; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\\n          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\\n    closed = (all(''')\\n# use native refs for traceability rather than synthetic cancellation reference\\ns=s.replace('    cancellation_refs = [ref for c in affected for ref in (\\\\n        [f\\\"cancellation:{c[\\\\'cancellation_id\\\\']}\\\"])]','    cancellation_refs = [source for c in affected for source in c.get(\\\"source_refs\\\", [])]')\\np.write_text(s)\\np=Path('src/travel_claim/integration.py');s=p.read_text().replace('            \\\"affected_claim_ids\\\": affected,','            \\\"affected_claim_ids\\\": affected,\\\\n            \\\"source_refs\\\": refs,');p.write_text(s)\\np=Path('src/travel_claim/offline_replay.py');s=p.read_text();s=s.replace('from .outputs import', 'from .revalidation import verification_document\\\\nfrom .outputs import',1)\\ns=s.replace('        \\\"demo\\\": run_dir / \\\"ordinary-workflow-demo.md\\\",','        \\\"demo\\\": run_dir / \\\"ordinary-workflow-demo.md\\\",\\\\n        \\\"revalidation\\\": run_dir / \\\"correction-cancellation-verification.json\\\",\\\\n        \\\"revalidation_summary\\\": run_dir / \\\"correction-cancellation-verification.md\\\",')\\ns=s.replace('    workflows = latest[\\\"domain\\\"][\\\"ordinary_workflows\\\"]','    verification, summary = verification_document(latest[\\\"domain\\\"], latest[\\\"snapshot\\\"][\\\"travel_cancellations\\\"], run_id=manifest[\\\"run_id\\\"])\\\\n    _exclusive_json(output_paths[\\\"revalidation\\\"], verification)\\\\n    output_paths[\\\"revalidation_summary\\\"].write_text(summary, encoding=\\\"utf-8\\\")\\\\n    workflows = latest[\\\"domain\\\"][\\\"ordinary_workflows\\\"]')\\ns=s.replace('Full stage evidence and transition history:', 'Executed correction and independent cancellation checks: `c