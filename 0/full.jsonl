owser policy evidence')\n109:    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n119:    if args.command == 'policy-replay':\n129:    if args.command == \"validate-readiness\":\n235:    if args.command == \"offline-replay\":\n[build-system]\nrequires = [\"setuptools>=68\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"alderbridge-travel-claim\"\nversion = \"0.1.0\"\ndescription = \"Alderbridge Consulting travel expense claim tooling\"\nrequires-python = \">=3.11\"\ndependencies = [\"jsonschema>=4.20,<5\", \"openpyxl>=3.1,<4\", \"pypdf>=5,<7\"]\n\n[project.optional-dependencies]\ntest = [\"pytest>=8,<9\"]\n\n[project.scripts]\ntravel-claim = \"travel_claim.cli:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\npythonpath = [\"src\"]\n","stderr":"","aggregated_output":"main\ncc281716d4281fa08829100ef3502486e59db091\n?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n/tmp/project-d-step183-resumed-dcxsswiv/readiness.json\n/tmp/step184-start-hashes.json\n/tmp/step186-retained-start-hashes.json\n98:        \"offline-replay\",\n103:    policy_replay = commands.add_parser('policy-replay', help='new offline retained-input run with separately verified browser policy evidence')\n109:    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never liv