ger', row 310 {'Decision reference': 'D-C19-3-claim-administration-4', 'Arrival batch': 4.0, 'Subject type': 'claim', 'Subject reference': 'C19', 'Revision': 3.0, 'Review roles': 'administration', 'Reviewer': 'ADMIN-01', 'Outcome': 'approve', 'Reason': 'Business purpose, evidence and review packet accepted.', 'Source revisions': 'DW-D-2\\nPOL-2026.2\\nSRC-D-3', 'Affected fields': 'trip\\namount\\nevidence', 'Decision time (UTC)': '2026-09-14T10:00:00'}\ntab 'Review ledger', row 311 {'Decision reference': 'D-C19-3-claim-budget_owner-4', 'Arrival batch': 4.0, 'Subject type': 'claim', 'Subject reference': 'C19', 'Revision': 3.0, 'Review roles': 'budget_owner', 'Reviewer': 'LEAD-01', 'Outcome': 'approve', 'Reason': 'Business purpose, evidence and review packet accepted.', 'Source revisions': 'DW-D-2\\nPOL-2026.2\\nSRC-D-3', 'Affected fields': 'trip\\namount\\nevidence', 'Decision time (UTC)': '2026-09-14T10:00:00'}\ntab 'Review ledger', row 312 {'Decision reference': 'D-C19-3-claim-supervisor-4', 'Arrival batch': 4.0, 'Subject type': 'claim', 'Subject reference': 'C19', 'Revision': 3.0, 'Review roles': 'supervisor', 'Reviewer': 'SUP-01', 'Outcome': 'approve', 'Reason': 'Business purpose, evidence and review packet accepted.', 'Source revisions': 'DW-D-2\\nPOL-2026.2\\nSRC-D-3', 'Affected fields': 'trip\\namount\\nevidence', 'Decision time (UTC)': '2026-09-14T10:00:00'}\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    cancellation_rows = _cancellation_rows(domain, history=history, run_id=run_id, batch_id=batch_id, parsed=parsed)\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n            event_context=finance_context(parsed, record_set[\"revisions\"], domain[\"finance_records\"], claim_id, arrival_batch),\n        )\n        workflow = connect_claim(parsed=parsed, claim=claim_revision, decisions=domain[\"decision_records\"],\n            finance_events=domain[\"finance_records\"], finance=finance_results[claim_id],\n            cancellations=cancellation_rows, arrival_batch=arrival_batch,\n            source_observations=source_observations or [], prior_finance=prior_finance,\n            source_classifications=domain[\"source_classifications\"])\n        finance_results[claim_id] = workflow.pop(\"finance\")\n        domain[\"ordinary_workflows\"][claim_id] = workflow\n        domain[\"ordinary_workflow_history\"].append({\"batch_id\": batch_id, \"workflow\": deepcopy(workflow)})\n    domain[\"finance_reconciliations\"] = finance_results\n    record_executed_rechecks(domain, before_batch, batch_id=batch_id)\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n\"\"\"Regression examples transcribed verbatim from the retained native workbook.\"\"\"\n\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\n\n\ndef reconcile_finance_events(*args, **kwargs):\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\n    return _reconcile(*args, **kwargs)\nfrom travel_claim.integration import integrate_arrival_batch\n\nFIXTURE = Path(__file__).parent / \"fixtures/retained_finance_records.json\"\n\n\ndef _fixture():\n    parsed = json.loads(FIXTURE.read_text())\n    # Exact retained directory records extend the selected-record test fixture.\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\n    return parsed\n\n\ndef _batches(parsed):\n    prior = None\n    results = []\n    for batch in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior,\n        )\n        results.append(prior)\n    return results\n\n\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\n    parsed = _fixture()\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\n    results = _batches(parsed)\n    final = results[-1]\n    c1 = final['finance_reconciliations']['C01']\n    obligation = c1['recorded_obligation']\n    assert obligation['event_id'] == 'F-C01-accepted'\n    assert obligation['request_id'] == 'REQ-C01'\n    assert obligation['finance_officer'] == 'FIN-01'\n    assert obligation['payee_id'] == 'EMP-01'\n    assert obligation['amount_cents'] == 10000\n    assert obligation['claim_revision'] is None\n    assert obligation['arrival_revision_context'] == 1\n    assert obligation['revision_link_status'] == 'arrival_context_only'\n    assert obligation['first_arrival_batch'] == 1\n    assert obligation['source_refs'] == [\n        'travel-registers-workbook@' + parsed['provenance']['workbook_sha256'] + \"#tab 'Finance activity', row 33\"\n","exit_code":0,"duration":{"secs":0,"nanos":145789820},"formatted_output":"Review packets ['Alternatives considered', 'Budget owner position', 'Budget record references', 'Business purpose', 'Client', 'Decision reference', 'Employee ID', 'Expense references', 'Permit reference', 'Permit revision', 'Policy revision', 'Reviewed estimate (EUR)', 'Schedule coverage', 'Travel cancellation references', 'Trip reference', 'Trip revis