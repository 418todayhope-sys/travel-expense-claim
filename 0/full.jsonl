 63\t    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    64\t    receipts = parsed.get('records', {}).get('receipts', [])\n    65\t    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    66\t    rates = table(parsed, 'fx_rates', 'FX')\n    67\t    caps = table(parsed, 'caps', 'Caps')\n    68\t    observations = parsed.get('source_observations', []) if observations is None else observations\n    69\t    people = table(parsed, 'people', 'People')\n    70\t    for line in lines:\n    71\t        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n    72\t                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n    73\t        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\n    74\t        line['eligibility_status'] = 'BLOCKED'\n    75\t        exception = validate_exception(record=record, line=line, employee=employee, people=people,\n    76\t            observations=observations, fields=fields, ref=ref)\n    77\t        # An exception for another *present* cost has no effect on this line.\n    78\t        target = fields(record).get('Expense reference')\n    79\t        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\n    80\t            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n    81\t        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\n    82\t                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\n    83\t                            for f in line['eligibility_findings'])):\n    84\t            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\n    85\t        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\n    86\t        line['exception'] = exception\n    87\t        line['source_refs'] += exception['source_refs']\n    88\t        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n    89\t        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n    90\t        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n    91\t        try:\n    92\t            gross = number(line['original_amount'])\n   120\t    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n   121\t        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n   122\t        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n   123\t    if trip.get('International') is True and not permit_review['approved'] and not any(f['issue']=='permit_unapproved' for f in eligibility):\n   124\t        from .exceptions import finding\n   125\t        eligibility.append(finding('permit_unapproved', 'Current permit replies/packets do not establish required approval authority', permit_review['source_refs']))\n   126\t    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n   127\t        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n   128\t        eligibility_findings=eligibility, observations=source_observations)\n   129\t    from .budget import claim_budget_view\n   130\t    budget_view=claim_budget_view(parsed=parsed,claim=claim,lines=lines,budgets=budget_data or {'scopes':{}},\n   131\t        attribution=prepaid_data or {'costs':{},'unallocated_costs':{}},prior=prior_budget_view,arrival_batch=arrival_batch)\n   132\t    stage('budget_availability',budget_view['status']=='PASS',budget_view['source_refs'],\n   133\t        '; '.join(i['reason'] for i in budget_view['issues']) or 'Complete scope ledger supports the incremental request; funds do not constitute approval',\n   134\t        budget_view['owner'],'Review the complete department/project/period ledger and obtain current budget-owner authorization')\n   135\t    stage('prior_cost_attribution',budget_view['remaining_request_cents'] is not None,budget_view['source_refs'],\n   136\t        'Each cost is linked to supported earlier obligations or remains unresolved; no aggregate prorating',finance_owner,\n   137\t        'Resolve exact original claim/cost/request links before any replacement or additional reimbursement')\n   138\t    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n   139\t        line['evidence_status'] == 'PASS' for line in lines)\n   140\t    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n   141\t    stage('supporting_evidence', evidence_ok, evidence_refs,\n   142\t          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n   143\t          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n   144\t    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n   145\t    stage('filing_deadline', filing_ok, evidence_refs,\n   146\t          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n   147\t          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n   148\t    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n   149\t        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n   150\t    reimbursement_permission = permission or (linked and permit_review.get('arrangements_at_commitment_supported',False)) or (linked and policy_supported and waived_permission)\n   151\t    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS' and budget_view['remaining_request_cents'] is not None\n   152\t    for line in lines:\n   153\t        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n   154\t        if not policy_ok:\n   155\t            line['status'] = 'unresolved'\n   233\t    exception_revalidated = not replacement_review or approvals\n   234\t    stage('exception_revalidation', exception_revalidated, evidence_refs + review_refs,\n   235\t          'Replacement amounts require current claim reviews bound to the replacement source version; earlier reviews remain historical',\n   236\t          lead, 'Obtain current revision/source-bound reviews of the Finance replacement amount and a matching reimbursement authorization')\n   237\t\n   238\t    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\n   239\t                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n   240\t    request = fields(requests[0]) if len(requests) == 1 else {}\n   241\t    obligation = finance.get('recorded_obligation')\n   242\t    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid'] and d['active']}\n   243\t    request_ok = bool(linked and reimbursement_permission and policy_ok and approvals and obligation and len(requests) == 1\n   244\t                      and request.get('Request reference') == obligation['request_id']\n   245\t                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\n   246\t                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['amount_cents']\n   247\t                      and obligation['claim_revision'] == revision and obligation['finance_officer'] == finance_owner\n   248\t                      and set(str(request.get('Decision references') or '').splitlines()) == approved_ids\n   249\t                      and bool(approved_ids))\n   250\t    request_refs = [ref(r) for r in requests] + (obligation['source_refs'] if obligation else [])\n   251\t    stage('request_obligation', request_ok, request_refs,\n   252\t          'Recorded request/obligation linkage requires explicit claim revision, payee, amount and approval references; ledger arrival context is not authorization',\n   253\t          finance_owner, 'Provide the exact-revision reimbursement request and Finance acceptance linked to its approvals and authorized amount')\n   254\t    if request_ok:\n   255\t        authorization = dict(amount_cents=allowed, claim_revision=revision, source_refs=request_refs + review_refs + policy_refs)\n   256\t        finance = reconcile_finance_events(finance_events, claim_id=claim_id, current_revision=revision,\n   257\t            revision_history=finance['revision_history'], previous_reconciliation=prior_finance,\n   258\t            authorized_obligation=authorization, source_classifications=source_classifications, event_context=finance.get(\"event_context\"))\n   259\t    reconciled = finance.get('recorded_ledger_balance_cents') is not None and not finance['unresolved_event_ids'] and not finance['conflicting_events']\n   260\t    stage('financial_reconciliation', reconciled,\n   261\t          [ref(e) for e in finance_events if fields(e).get('Claim reference') == claim_id],\n   262\t          f\"Confirmed net cash {finance['net_confirmed_cents']} cents; recorded ledger difference {finance.get('recorded_ledger_balance_cents')}; authorized balance {finance['balance_cents']}\",\n   263\t          finance_owner, 'Resolve missing obligations, conflicting or unclassified events, request/payee links and outstanding balances')\n   264\t\n   265\t    authorities = [r for r in table(parsed, 'closure_authorities', 'Closure authorities') if trusted(r) and visible(r)\n   266\t                   and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n   267\t    clock_ok = False\n   268\t    try:\n   269\t        clock_ok = datetime.fromisoformat(parsed['case_clock'].replace('Z', '+00:00')).utcoffset() is not None\n   270\t    except (KeyError, ValueError, TypeError, AttributeError):\n   271\t        pass\n   272\t    closure_authority = (len(authorities) == 1 and fields(authorities[0]).get('Confirmation') == 'financial-completion-conditions'\n   273\t                         and bool(fields(authorities[0]).get('Authority')) and fields(authorities[0]).get('Case clock') == parsed.get('case_clock'))\n   274\t    external = [i for i in parsed.get('unresolved_issues', []) if i.get('status', 'open') == 'open'\n   275\t                and (i.get('subject_type') in {'policy', 'scenario'} or i.get('subject_id') in {claim_id, trip_id, trip.get('Permit reference')})]\n   276\t    control_events = [e for e in finance['event_history'] if e['classification'] in {\n   277\t        'failed_transfer', 'retry_authorization', 'finance_cancellation_requested', 'finance_cancelled'}]\n   278\t    resolved_controls = set()\n   279\t    def event_stamp(event):\n   280\t        stamp = datetime.fromisoformat(event['source_record']['Activity time (UTC)'].replace('Z', '+00:00'))\n   281\t        return stamp.replace(tzinfo=timezone.utc) if stamp.utcoffset() is None else stamp\n   282\t    for event in finance['event_history']:\n   283\t        value = event['source_record']\n   284\t        if (event['classification'] == 'finance_resolution' and value.get('Claim revision') == revision\n   285\t                and obligation and value.get('Request reference') == obligation['request_id']\n   286\t                and value.get('Finance officer') == finance_owner):\n   287\t            named = set(str(value.get('Resolved activity references') or '').splitlines())\n   288\t            for control in control_events:\n   289\t                try:\n   290\t                    if (control['event_id'] in named\n   291\t                            and control['source_record'].get('Request reference') == value['Request reference']\n   292\t                            and event_stamp(event) >= event_stamp(control)):\n   293\t                        resolved_controls.add(control['event_id'])\n   294\t                except (KeyError, ValueError, TypeError, AttributeError):\n   295\t                    pass\n   296\t    controls_clear = not finance['pending_transfer_event_ids'] and all(e['event_id'] in resolved_controls for e in control_events)\n   297\t    cancellation_refs = [source for c in affected for source in c.get(\"source_refs\", [])]\n   298\t    stage('cancellation_readiness', not affected, cancellation_refs,\n   299\t          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\n   300\t          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\n   301\t    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\n   302\t              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\n   303\t    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\n   304\t          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\n   305\t          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\n   306\t    business_state=claim_review['state']\n   307\t    financial_clean=(len(trips)==1 and trusted(trips[0]) and not finance.get('recorded_obligation') and not finance['net_confirmed_cents']\n   308\t        and not finance['event_history'] and not requests and not affected)\n   309\t    disposition=business_state if business_state in {'rejected','withdrawn'} and financial_clean else None\n   310\t    if business_state in {'rejected','withdrawn'} and not financial_clean:\n    15\tdef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\n    16\t    \"\"\"Always capture all five URLs into a new directory before reading inputs.\"\"\"\n    17\t    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\n    18\t    errors = verify_source_manifest(run_dir)\n    19\t    parsed = None\n    20\t    if not errors:\n    21\t        try:\n    22\t            parsed = parse_retained_run(run_dir)\n    23\t        except Exception as exc:\n    24\t            errors.append(f\"Native transcription failed: {type(exc).__name__}: {exc}\")\n    25\t    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\n    26\t               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\n    27\t               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\n    28\t    for row in manifest['files']:\n    29\t        checks.append({'check': f\"source:{row['source_id']}\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\n    30\t                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\n    31\t                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\n    32\t                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\n    33\t    for issue in (parsed or {}).get('transcription_issues', []):\n    34\t        checks.append({'check': f\"transcription:{issue['source_id']}\", 'status': 'BLOCKED',\n    35\t                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\n    36\t    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\n    37\t                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\n    38\t                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\n    39\t    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\n    40\t                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\n    41\t                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\n    42\t    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\n    43\t    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\n    44\t    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\n    45\t              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\n    46\t              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\n    47\t              'final_live_source_compliance': Fal