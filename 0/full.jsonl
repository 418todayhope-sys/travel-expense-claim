\\n   161\\t\\n   162\\tdef capture_sources(\\n   163\\t    run_dir: Path, *, run_id: str, case_clock: str | None,\\n   164\\t    source_specs: tuple[NativeSource, ...] = SOURCES,\\n   165\\t    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\\n   166\\t    observed_at: Callable[[], str] = _utc_now, timeout: float = 30.0,\\n   167\\t) -> dict:\\n   168\\t    \\\"\\\"\\\"Attempt fresh requests; retain every returned body, including error evidence.\\n   169\\t\\n   170\\t    A new, empty run directory is required. There is no retained-input option.\\n   171\\t    Observation timestamps are retrieval facts, never the scenario case clock.\\n   172\\t    \\\"\\\"\\\"\\n   173\\t    if not run_id or Path(run_id).name != run_id or run_id in {\\\".\\\", \\\"..\\\"}:\\n   174\\t        raise ValueError(\\\"run_id must be a single safe path component\\\")\\n   175\\t    if run_dir.name != run_id:\\n   176\\t        raise ValueError(\\\"run_dir basename must equal run_id\\\")\\n   177\\t    if timeout <= 0:\\n   178\\t        raise ValueError(\\\"timeout must be positive\\\")\\n   179\\t    if case_clock is not None:\\n   180\\t        try:\\n   181\\t            clock = datetime.fromisoformat(case_clock.replace(\\\"Z\\\", \\\"+00:00\\\"))\\n   182\\t            if clock.utcoffset() is None:\\n   183\\t                raise ValueError(\\\"timezone required\\\")\\n   184\\t        except (ValueError, AttributeError, TypeError) as exc:\\n   185\\t            raise ValueError(\\\"case_clock must be an explicit date/time with timezone, never an observation default\\\") from exc\\n   186\\t    if set(source_specs) != set(SOURCES) or len(source_specs) != 5:\\n   187\\t        raise ValueError(\\\"Every live capture must attempt exactly all five original source identities and URLs\\\")\\n   188\\t    if run_dir.exists() and any(run_dir.iterdir()):\\n   189\\t        raise FileExistsError(f\\\"Refusing to reuse nonempty run directory: {run_dir}\\\")\\n   190\\t    run_dir.mkdir(parents=True, exist_ok=True)\\n   191\\t    manifest_path = run_dir / \\\"sources.json\\\"\\n   192\\t    (run_dir / \\\"sources\\\").mkdir()\\n   193\\t    (run_dir / \\\"responses\\\").mkdir()\\n   194\\t    entries = []\\n   195\\t    for source in source_specs:\\n   196\\t        started = observed_at()\\n   197\\t        attempted = source.export_url or source.url\\n   198\\t        body, headers, final_url, status_code, failure = None, {}, None, None, None\\n   199\\t        try:\\n   200\\t            body, headers, final_url = fetch(attempted, timeout)\\n    15\\tdef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\\n    16\\t    \\\"\\\"\\\"Always capture all five URLs into a new directory before reading inputs.\\\"\\\"\\\"\\n    17\\t    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\\n    18\\t    errors = verify_source_manifest(run_dir)\\n    19\\t    parsed = None\\n    20\\t    if not errors:\\n    21\\t        try:\\n    22\\t            parsed = parse_retained_run(run_dir)\\n    23\\t        except Exception as exc:\\n    24\\t            errors.append(f\\\"Native transcription failed: {type(exc).__name__}: {exc}\\\")\\n    25\\t    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\\n    26\\t               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\\n    27\\t               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\\n    28\\t    for row in manifest['files']:\\n    29\\t        checks.append({'check': f\\\"source:{row['source_id']}\\\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\\n    30\\t                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\\n    31\\t                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\\n    32\\t                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\\n    33\\t    for issue in (parsed or {}).get('transcription_issues', []):\\n    34\\t        checks.append({'check': f\\\"transcription:{issue['source_id']}\\\", 'status': 'BLOCKED',\\n    35\\t                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\\n    36\\t    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\\n    37\\t                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\\n    38\\t                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\\n    39\\t    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\\n    40\\t                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\\n    41\\t                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\\n    42\\t    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\\n    43\\t    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\\n    44\\t    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\\n    45\\t              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\\n    46\\t              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\\n    47\\t              'final_live_source_compliance': False, 'batches_consumed': [],\\n    48\\t              'source_manifest': {'path': 'sources.json', 'sha256': sha256_bytes((run_dir / 'sources.json').read_bytes())},\\n    49\\t              'parsed_records': {'path': 'parsed-records.json', 'sha256': sha256_bytes((run_dir / 'parsed-records.json').read_bytes())} if parsed else None,\\n    50\\t              'arrival_batches_observed': (parsed or {}).get('arrival_batches', []), 'checks': checks}\\n    51\\t    with (run_dir / 'live-run.json').open('x', encoding='utf-8') as stream:\\n    52\\t        stream.write(json.dumps(report, indent=2, ensure_ascii=False) + '\\\\n')\\n    53\\t    lines = ['# Project D fresh native-source attempt', '', f\\\"**{status}** — `{run_id}`; mode: `live-source-attempt`.\\\", '',\\n    54\\t             'All five original source locations were attempted in this invocation using native HTTP/export routes. '\\n\\\"\\\"\\\"Synthetic fixtures for policy-independent financial reconciliation.\\\"\\\"\\\"\\n\\nfrom copy import deepcopy\\n\\nfrom travel_claim.finance import reconcile_finance_events\\n\\n\\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\\\"C-SYN-01\\\", amount=None,\\n                 obligation=None, original=None, currency=\\\"EUR\\\"):\\n    values = {\\n        \\\"Activity reference\\\": event_id,\\n        \\\"Arrival batch\\\": batch,\\n        \\\"Activity type\\\": event_type,\\n        \\\"Claim reference\\\": claim,\\n        \\\"Currency\\\": currency,\\n        \\\"Reason\\\": f\\\"SYNTHETIC fixture {event_type}\\\",\\n    }\\n    if amount is not None:\\n        values[\\\"Amount (EUR)\\\"] = amount\\n    if obligation is not None:\\n        values[\\\"Obligation (EUR)\\\"] = obligation\\n    if original is not None:\\n        values[\\\"Original activity reference\\\"] = original\\n    return {\\n        \\\"source_id\\\": \\\"synthetic-finance-ledger\\\",\\n        \\\"source_sha256\\\": \\\"c\\\" * 64,\\n        \\\"locator\\\": f\\\"synthetic tab 'Finance activity', row {row}\\\",\\n        \\\"row\\\": row,\\n        \\\"values\\\": {\\n            key: {\\\"value\\\": value, \\\"source_text\\\": str(value), \\\"cell\\\": f\\\"A{row}\\\"}\\n            for key, value in values.items()\\n        },\\n    }\\n\\n\\ndef _obligation(amount=15_000, revision=1):\\n    return {\\\"amount_cents\\\": amount, \\\"claim_revision\\\": revision, \\\"source_refs\\\": [\\\"synthetic:authorization#1\\\"]}\\n\\n\\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-ACCEPT\\\", \\\"accepted\\\", obligation=150.00),\\n        _finance_row(2, \\\"F-SYN-PAY-1\\\", \\\"settled\\\", amount=100.01),\\n        _finance_row(3, \\\"F-SYN-PAY-2\\\", \\\"settled\\\", amount=50.00),\\n        _finance_row(4, \\\"F-SYN-REFUND\\\", \\\"refund\\\", amount=20.00, original=\\\"F-SYN-PAY-1\\\"),\\n        _finance_row(5, \\\"F-SYN-PENDING\\\", \\\"transfer_pending\\\", amount=79.99),\\n    ]\\n    result = reconcile_finance_events(\\n        events,\\n        claim_id=\\\"C-SYN-01\\\",\\n        current_revision=1,\\n        authorized_obligation=_obligation(),\\n        source_classifications={\\\"transfer_pending\\\": \\\"pending_transfer\\\"},\\n    )\\n    assert result[\\\"finance_obligation_events\\\"][0][\\\"obligation_cents\\\"] == 15_000\\n    assert result[\\\"authorized_obligation\\\"][\\\"amount_cents\\\"] == 15_000\\n    assert result[\\\"confirmed_payment_cents\\\"] == 15_001\\n    assert result[\\\"confirmed_refund_cents\\\"] == 2_000\\n    assert result[\\\"net_confirmed_cents\\\"] == 13_001\\n    assert result[\\\"balance_cents\\\"] == 1_999\\n    assert result[\\\"pending_transfer_event_ids\\\"] == [\\\"F-SYN-PENDING\\\"]\\n    assert \\\"F-SYN-PENDING\\\" not in result[\\\"confirmed_payment_event_ids\\\"]\\n    assert result[\\\"event_history\\\"][0][\\\"source_record\\\"][\\\"Activity type\\\"] == \\\"accepted\\\"\\n    assert result[\\\"event_history\\\"][3][\\\"original_activity_id\\\"] == \\\"F-SYN-PAY-1\\\"\\n\\n\\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\\n    payment = _finance_row(5, \\\"F-SYN-PAY\\\", \\\"settled\\\", batch=1, amount=10.00)\\n    replay = _finance_row(22, \\\"F-SYN-PAY\\\", \\\"settled\\\", batch=4, amount=10.00)\\n    result = reconcile_finance_events(\\n        [payment, replay], claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(amount=1_000),\\n    )\\n    assert result[\\\"event_ids\\\"] == [\\\"F-SYN-PAY\\\", \\\"F-SYN-PAY\\\"]\\n    assert len(result[\\\"event_history\\\"]) == 2\\n    assert len(result[\\\"confirmed_payment_event_ids\\\"]) == 1\\n    assert result[\\\"confirmed_payment_cents\\\"] == 1_000\\n    assert result[\\\"duplicate_events\\\"][0][\\\"delivery_batches\\\"] == [1, 4]\\n    assert [item[\\\"source_ref\\\"][\\\"locator\\\"] for item in result[\\\"event_history\\\"]] == [\\n        \\\"synthetic tab 'Finance activity', row 5\\\",\\n        \\\"synthetic tab 'Finance activity', row 22\\\",\\n    ]\\n\\n\\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-CONFLICT\\\", \\\"settled\\\", amount=10.00),\\n        _finance_row(2, \\\"F-SYN-CONFLICT\\\", \\\"settled\\\", amount=11.00, batch=2),\\n        _finance_row(3, \\\"F-SYN-UNKNOWN\\\", \\\"mystery_state\\\", amount=20.00),\\n    ]\\n    result = reconcile_finance_events(\\n        events, claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(), owner=\\\"FIN-SYN-01\\\",\\n    )\\n    assert result[\\\"conflicting_events\\\"][0][\\\"event_id\\\"] == \\\"F-SYN-CONFLICT\\\"\\n    assert len(result[\\\"conflicting_events\\\"][0][\\\"source_refs\\\"]) == 2\\n    assert result[\\\"confirmed_payment_cents\\\"] == 0\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"unresolved_event_ids\\\"] == [\\\"F-SYN-UNKNOWN\\\"]\\n    assert list(result[\\\"repair_issues_by_owner\\\"]) == [\\\"FIN-SYN-01\\\"]\\n    assert {issue[\\\"record_id\\\"] for issue in result[\\\"repair_issues_by_owner\\\"][\\\"FIN-SYN-01\\\"]} == {\\n        \\\"finance-event-conflict:F-SYN-CONFLICT\\\", \\\"finance-unresolved:F-SYN-UNKNOWN\\\",\\n    }\\n    assert all(issue[\\\"source_refs\\\"] for issue in result[\\\"repair_issues\\\"])\\n\\n\\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=10.00),\\n        _finance_row(2, \\\"F-SYN-REFUND\\\", \\\"refund\\\", amount=10.01, original=\\\"F-SYN-PAY\\\"),\\n        _finance_row(3, \\\"F-SYN-REFUND-ORPHAN\\\", \\\"refund\\\", amount=1.00, original=\\\"F-NOT-FOUND\\\"),\\n    ]\\n    result = reconcile_finance_events(\\n        events, claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(amount=1_000),\\n    )\\n    assert result[\\\"confirmed_payment_cents\\\"] == 1_000\\n    assert result[\\\"confirmed_refund_cents\\\"] == 0\\n    assert result[\\\"net_confirmed_cents\\\"] == 1_000\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert set(result[\\\"unresolved_event_ids\\\"]) == {\\\"F-SYN-REFUND\\\", \\\"F-SYN-REFUND-ORPHAN\\\"}\\n\\n\\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\\n    prior = {\\n        \\\"claim_revision\\\": 1,\\n        \\\"net_confirmed_cents\\\": 10_000,\\n        \\\"balance_cents\\\": 5_000,\\n        \\\"event_history\\\": [{\\\"event_id\\\": \\\"F-SYN-PAY\\\", \\\"source_ref\\\": \\\"prior\\\"}],\\n    }\\n    prior_copy = deepcopy(prior)\\n    revisions = [\\n        {\\\"revision\\\": 1, \\\"source_ref\\\": \\\"synthetic:claim#1\\\"},\\n        {\\\"revision\\\": 2, \\\"source_ref\\\": \\\"synthetic:claim#2\\\"},\\n    ]\\n    result = reconcile_finance_events(\\n        [_finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=100.00)],\\n        claim_id=\\\"C-SYN-01\\\",\\n        current_revision=2,\\n        authorized_obligation=_obligation(amount=15_000, revision=1),\\n        revision_history=revisions,\\n        previous_reconciliation=prior,\\n    )\\n    assert result[\\\"revision_history\\\"] == revisions\\n    assert result[\\\"confirmed_payment_cents\\\"] == 10_000\\n    assert result[\\\"authorized_obligation\\\"] is None\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"invalidated_previous_reconciliation\\\"][\\\"claim_revision\\\"] == 1\\n    assert result[\\\"repair_issues_by_owner\\\"][\\\"Finance\\\"][0][\\\"record_id\\\"] == \\\"finance-obligation-invalid:C-SYN-01:2\\\"\\n    assert prior == prior_copy\\n\\n\\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\\n    result = reconcile_finance_events(\\n        [_finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=10.00)],\\n        claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n    )\\n    assert result[\\\"net_confirmed_cents\\\"] == 1_000\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"repair_issues_by_owner\\\"][\\\"Finance\\\"][0][\\\"record_id\\\"] == \\\"finance-obligation-missing:C-SYN-01:1\\\"\\n    conflict = deepcopy(parsed['records']['decisions'][0])\\n    conflict['values']['Outcome']['value'] = 'return'\\n    parsed['records']['decisions'].append(conflict)\\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\\n\\n\\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\\n    parsed = synthetic()\\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\\n    policy['Uncapped categories']['value'] = []\\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\\n    })\\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\\n    for event in parsed['records']['finance_events']:\\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\\n            if field in event['values']: event['values'][field]['value'] = 40\\n    value = workflow(batches(parsed)[-1])\\n    assert value['lines'][0]['original_cents'] == 10000\\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\\n    assert value['status'] == 'closed-reimbursed'\\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\\n\\n\\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\\n    parsed = synthetic()\\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\\n    value = workflow(batches(parsed)[-1])\\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\\n    assert value['status'] == 'pending'\\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\\n\\n\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"835a2a\",\"wall_time_seconds\":0.19535065,\"exit_code\":0,\"original_token_count\":1449,\"output\":\"People ['Employee ID', 'Department', 'Project', 'Budget period', 'Payee ID', 'Administration reviewer', 'Budget owner', 'Supervisor', 'Director', 'Finance officer']\\nTrips ['Trip reference', 'Employee ID', 'Destination', 'International', 'Start date', 'End date', 'First commitment date', 'Estimate (EUR)', 'Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Trip revision', 'Permit revision']\\nFX ['Rate reference', 'Rate date', 