 cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef _reference_text(ref: dict[str, Any]) -> str:\n    return f\"{ref.get('source_id')}@{ref.get('source_sha256')}#{ref.get('locator')}\"\n\n\ndef _positive_integer(value: Any) -> int | None:\n    try:\n        return int(value) if not isinstance(value, bool) and int(value) > 0 and float(value) == int(value) else None\n    except (ValueError, TypeError, OverflowError):\n        return None\n\n\ndef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    claim revision; arrival context is retained separately from explicit links.\n    Only the first delivery establishes context; redelivery cannot rebind it.\n    \"\"\"\n    groups: dict[str, list[dict]] = defaultdict(list)\n    for event in history:\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n            groups[event['event_id']].append(event)\n    records = []\n    problem = None\n    for event_id, occurrences in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n    event_context: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\n            and any(previous_reconciliation.get(k) for k in ('confirmed_payment_event_ids', 'confirmed_refund_event_ids',\n                'confirmed_payment_cents', 'confirmed_refund_cents', 'net_confirmed_cents'))):\n        raise ValueError('Legacy admission state requires explicit verified migration; refusing to erase or invent admitted money')\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    # Accept full-history or delta calls without dropping earlier raw deliveries.\n    retained = [{**deepcopy(h['source_ref']), 'values': {k: {'value': v} for k, v in h['source_record'].items()}}\n                for h in (previous_reconciliation or {}).get('event_history', []) if isinstance(h.get('source_ref'), dict) and 'source_record' in h]\n    deliveries = []\n    for record in retained + events:\n        if not any(_source_ref(r) == _source_ref(record) and _values(r) == _values(record) for r in deliveries):\n            deliveries.append(record)\n    events = deliveries\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    prior = deepcopy((previous_reconciliation or {}).get('admitted_events', {}))\n    admitted = deepcopy(prior)\n    history, duplicate_events, conflicting_events, unresolved = [], [], [], []\n    event_issue_by_id = {}\n\n    def item_for(record):\n        values = _values(record)\n        return {\"event_id\": values.get(\"Activity reference\"), \"source_ref\": _source_ref(record),\n                \"source_record\": deepcopy(values), \"event_type\": values.get(\"Activity type\"),\n                \"classification\": classes.get(values.get(\"Activity type\"), \"unresolved\"),\n                \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n                \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n                \"currency\": values.get(\"Currency\"), \"original_activity_id\": values.get(\"Original activity reference\")}\n\n    for event_id, occurrences in by_id.items():\n        relevant = [r for r in occurrences if _values(r).get('Claim reference') == claim_id]\n        if not relevant and event_id not in prior:\n            continue\n        payloads = [_payload(_values(r)) for r in occurrences]\n        if event_id in prior:\n            payloads.append(_payload(prior[event_id]['source_record']))\n        conflict = any(v != payloads[0] for v in payloads[1:])\n        if conflict:\n            conflicting_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences], 'payloads': payloads})\n            event_issue_by_id[event_id] = {\n                'record_id': f'finance-event-conflict:{event_id}', 'event_id': event_id,\n                'subject_type': 'claim', 'subject_id': claim_id, 'revision': current_revision,\n                'missing_or_return_reason': 'Conflicting immutable event replay; admitted history retained, new payload held',\n                'source_refs': [_source_ref(r) for r in occurrences], 'owner': owner,\n                'next_action': 'Finance to resolve the conflicting delivery without erasing admitted money'}\n        elif len(occurrences) > 1:\n            duplicate_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences],\n                                     'delivery_batches': [_values(r).get('Arrival batch') for r in occurrences]})\n        if event_id not in admitted:\n            batches = [_positive_integer(_values(r).get('Arrival batch')) for r in occurrences]\n            first_batch = min((v for v in batches if v is not None), default=None)\n            first = [r for r in occurrences if first_batch is not None and _positive_integer(_values(r).get('Arrival batch')) == first_batch]\n            if not first:\n                candidate = item_for(relevant[0])\n                candidate['validation_errors'] = ['missing or invalid positive integer arrival batch']\n                unresolved.append(candidate)\n            # Same-batch conflicting payloads have no supplied authority order.\n            if first and all(_payload(_values(r)) == _payload(_values(first[0])) for r in first):\n                candidate = item_for(first[0])\n                values = candidate['source_record']\n                reasons = finance_errors(values, candidate['classification'], event_context, _cents)\n                if candidate['classification'] == 'unresolved':\n                    reasons.append('unknown Finance event vocabulary')\n                if values.get('Claim reference') == claim_id and not reasons:\n                    candidate['validation_context'] = deepcopy(event_context)\n                    admitted[event_id] = candidate\n                elif values.get('Claim reference') == claim_id:\n                    candidate['validation_errors'] = reasons\n                    unresolved.append(candidate)\n        for record in relevant:\n            item = item_for(record)\n            canonical = admitted.get(event_id)\n            same = canonical is not None and _payload(item['source_record']) == _payload(canonical['source_record'])\n            item['admission_status'] = 'admitted-or-exact-replay' if same else 'held'\n            if not same:\n                item['classification'] = 'conflicting_event_id' if conflict else 'unresolved'\n            history.append(item)\n    for record in missing_id_records:\n        item = item_for(record); item['classification'] = 'missing_event_id'\n        item['validation_errors'] = ['immutable event identity missing']; history.append(item); unresolved.append(item)\n    # Previously admitted facts remain observable even on a delta-only invocation.\n    for event_id, item in prior.items():\n        if not any(h['event_id'] == event_id and _payload(h['source_record']) == _payload(item['source_record']) for h in history):\n            history.append(deepcopy(item))\n    typed = list(admitted.values())\n    payments = {item['event_id']: item for item in typed if item['classification'] == 'confirmed_payment'}\n    confirmed_refunds = [deepcopy(item) for item in prior.values() if item['classification'] == 'confirmed_refund']\n    recovered = defaultdict(int)\n    for item in confirmed_refunds:\n        recovered[item['original_activity_id']] += item['amount_cents']\n    refund_candidates = [item for item in typed if item['classification'] == 'confirmed_refund' and item['event_id'] not in prior]\n    refund_candidates.sort(key=lambda h: (_positive_integer(h['source_record'].get('Arrival batch')) or 0,\n                                         utc_time(h['source_record']['Activity time (UTC)']), h['event_id']))\n    for item in refund_candidates:\n        original = payments.get(item['original_activity_id'])\n        valid = original is not None and all(item['source_record'].get(k) == original['source_record'].get(k)\n                                             for k in ('Request reference', 'Payee ID', 'Currency', 'Claim reference'))\n        if valid:\n            valid = (utc_time(item['source_record']['Activity time (UTC)']) >= utc_time(original['source_record']['Activity time (UTC)'])\n                     and recovered[item['original_activity_id']] + item['amount_cents'] <= original['amount_cents'])\n        if not valid:\n            item['validation_errors'] = ['refund lacks matching settled request/payee/time or exceeds unrecovered transfer']\n            unresolved.append(item); admitted.pop(item['event_id'], None)\n        else:\n            confirmed_refunds.append(item); recovered[item['original_activity_id']] += item['amount_cents']\n    typed = list(admitted.values())\n    invalid_ids = {item['event_id'] for item in unresolved}\n    for item in history:\n        if item['event_id'] in invalid_ids and item['event_id'] not in admitted:\n            item['classification'] = 'unresolved'; item['admission_status'] = 'held'\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} held: {', '.join(item.get('validation_errors', ['unmatched event']))}\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n    )\n    if recorded_problem:\n        issues.append({\n            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n        })\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"missing_or_return_reason\": (\"recorded Finance obligation exists, but current-revision reimbursement authorization and entitlement remain unconfirmed\"\n                                         if recorded_obligation else \"no supported authorized obligation was supplied for this claim revision\"),\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    ledger_balance = None\n    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n        # Cash for a different/missing request cannot be silently applied to this ledger.\n        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n    if recorded_obligation is not None and event_set_complete and ledger_balance is None:\n        issues.append({\n            \"record_id\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n            \"owner\": owner,\n            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n        })\n    issues_by_owner = {}\n    for issue in issues:\n        issues_by_owner.setdefault(issue['owner'], []).append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row['record_id']) for key, value in sorted(issues_by_owner.items())}\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n                \"prior_recorded_obligation\": deepcopy(previous_reconciliation.get(\"recorded_obligation\")),\n                \"next_action\": \"Revalidate exact revision authorization; historical ledger and cash remain retained\",\n            }\n    revalidation_history = deepcopy((previous_reconciliation or {}).get(\"financial_revalidation_history\", []))\n    if invalidated is not None:\n        revalidation_history.append(deepcopy(invalidated))\n    return {\n        \"admitted_events\": deepcopy(admitted),\n        \"event_context\": deepcopy(event_context),\n        \"admitted_event_ids\": list(admitted),\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"recorded_obligation_history\": obligation_history,\n        \"recorded_obligation\": recorded_obligation,\n        \"recorded_ledger_balance_cents\": ledger_balance,\n        \"reimbursement_entitlement_confirmed\": False,\n        \"closure_authority_confirmed\": False,\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n        \"financial_revalidation_history\": revalidation_history,\n    }\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str, parsed: dict[str, Any],\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"],\n        trips=parsed.get(\"records\", {}).get(\"trips\", []), people=table(parsed, \"people\", \"People\"),\n        clock=parsed.get(\"event_clock\") or parsed.get(\"case_clock\"), arrival_batch=domain[\"processed_batches\"][-1],\n        previous_state=domain.get(\"cancellation_state\"))\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {}\n    for record in domain[\"cancellation_records\"]:\n        raw_by_id.setdefault(row_values(record).get(\"Cancellation activity reference\"), record)\n    domain[\"cancellation_evidence\"] = {}\n    for index, issue in enumerate(reduced[\"issues\"]):\n        event = next((r for r in domain[\"cancellation_records\"] if _ref(r) == issue.get(\"source_ref\")),\n                     raw_by_id.get(issue.get(\"event_id\")))\n        value = row_values(event) if event else {}\n        kind = value.get(\"Cancelled subject\")\n        subject = value.get(\"Trip reference\") if kind == \"trip\" else value.get(\"Permit reference\")\n        revision = _as_batch(value.get(\"Trip revision\") if kind == \"trip\" else value.get(\"Permit revision\"))\n        if kind in {\"trip\", \"permit\"} and subject and revision:\n            _open_issue_for_subject(domain[\"repair_queue\"], item_id=f\"cancellation-evidence:{issue.get('event_id')}:{index}\",\n                subject_type=kind, subject_id=subject, revision=revision, refs=[_ref_text(_ref(event))],\n                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n                run_id=run_id, batch_id=batch_id)\n    current_invalid = {i.get('event_id') for i in reduced['issues']}\n    for item_id, item in domain['repair_queue']['items'].items():\n        if item_id.startswith('cancellation-evidence:'):\n            for event_id, record in reduced['admitted_records'].items():\n                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\n                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\n                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        if not record_order:\n            continue  # Orphan evidence remains in cancellation_state and owned issues.\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        current_affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n                        current_affected.append(claim_id)\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"source_refs\": refs,\n            \"original_request_ids\": sorted({row_values(r).get(\"Request reference\") for r in domain[\"finance_records\"]\n                if row_values(r).get(\"Claim reference\") in affected and row_values(r).get(\"Request reference\")}),\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n        # Finance dispositions are explicit claim/revision/cancellation-bound source\n        # statements. They do not establish the missing policy or closure authority.\n        dispositions = []\n        for claim_id in affected:\n            for revision in claim_revisions[claim_id][\"revisions\"]:\n                value = _page_values(revision[\"record\"])\n                if (value.get(\"Travel cancellation reference\") == cancellation_id\n                        and value.get(\"Applies to claim\") == claim_id\n                        and str(value.get(\"Applies to revision\")) == str(revision[\"revision\"])\n                        and value.get(\"Authorizing Finance officer\")\n                        and value.get(\"Allowed original amount\") is not None):\n                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n                        \"expense_reference\": value.get(\"Expense reference\"),\n                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n        if dispositions:\n            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n            changes = {\n                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n            if changes:\n                update_repair_item(queue, item_id=task_id,\n                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n                 if row_values(r).get(\"Trip reference\") == trip_id\n                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n        actors_ok = bool(employee and supervisor\n            and request_values.get(\"Acting employee or supervisor\") == employee\n            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n        if not actors_ok:\n            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n                run_id=run_id, batch_id=batch_id)\n        actor_item = f\"cancellation-authority:{cancellation_id}\"\n        if actor_item in queue[\"items\"]:\n            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n        domain[\"cancellation_evidence\"][cancellation_id] = {\n            \"current_claim_ids\": sorted(set(current_affected)),\n            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n            \"history\": deepcopy(process[\"history\"]),\n            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n            \"dispositions\": dispositions,\n            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n        }\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n","stderr":"","aggregated_output":"\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom datetime import datetime\nfrom .event_validation import finance_errors, utc_time\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef _reference_text(ref: dict[str, Any]) -> str:\n    return f\"{ref.get('source_id')}@{ref.get('source_sha256')}#{ref.get('locator')}\"\n\n\ndef _positive_integer(value: Any) -> int | None:\n    try:\n        return int(value) if not isinstance(value, bool) and int(value) > 0 and float(value) == int(value) else None\n    except (ValueError, TypeError, OverflowError):\n        return None\n\n\ndef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    claim revision; arrival context is retained separately from explicit links.\n    Only the first delivery establishes context; redelivery cannot rebind it.\n    \"\"\"\n    groups: dict[str, list[dict]] = defaultdict(list)\n    for event in history:\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n            groups[event['event_id']].append(event)\n    records = []\n    problem = None\n    for event_id, occurrences in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n    event_context: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\n            and any(previous_reconciliation.get(k) for k in ('confirmed_payment_event_ids', 'confirmed_refund_event_ids',\n                'confirmed_payment_cents', 'confirmed_refund_cents', 'net_confirmed_cents'))):\n        raise ValueError('Legacy admission state requires explicit verified migration; refusing to erase or invent admitted money')\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    # Accept full-history or delta calls without dropping earlier raw deliveries.\n    retained = [{**deepcopy(h['source_ref']), 'values': {k: {'value': v} for k, v in h['source_record'].items()}}\n                for h in (previous_reconciliation or {}).get('event_history', []) if isinstance(h.get('source_ref'), dict) and 'source_record' in h]\n    deliveries = []\n    for record in retained + events:\n        if not any(_source_ref(r) == _source_ref(record) and _values(r) == _values(record) for r in deliveries):\n            deliveries.append(record)\n    events = deliveries\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    prior = deepcopy((previous_reconciliation or {}).get('admitted_events', {}))\n    admitted = deepcopy(prior)\n    history, duplicate_events, conflicting_events, unresolved = [], [], [], []\n    event_issue_by_id = {}\n\n    def item_for(record):\n        values = _values(record)\n        return {\"event_id\": values.get(\"Activity reference\"), \"source_ref\": _source_ref(record),\n                \"source_record\": deepcopy(values), \"event_type\": values.get(\"Activity type\"),\n                \"classification\": classes.get(values.get(\"Activity type\"), \"unresolved\"),\n                \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n                \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n                \"currency\": values.get(\"Currency\"), \"original_activity_id\": values.get(\"Original activity reference\")}\n\n    for event_id, occurrences in by_id.items():\n        relevant = [r for r in occurrences if _values(r).get('Claim reference') == claim_id]\n        if not relevant and event_id not in prior:\n            continue\n        payloads = [_payload(_values(r)) for r in occurrences]\n        if event_id in prior:\n            payloads.append(_payload(prior[event_id]['source_record']))\n        conflict = any(v != payloads[0] for v in payloads[1:])\n        if conflict:\n            conflicting_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences], 'payloads': payloads})\n            event_issue_by_id[event_id] = {\n                'record_id': f'finance-event-conflict:{event_id}', 'event_id': event_id,\n                'subject_type': 'claim', 'subject_id': claim_id, 'revision': current_revision,\n                'missing_or_return_reason': 'Conflicting immutable event replay; admitted history retained, new payload held',\n                'source_refs': [_source_ref(r) for r in occurrences], 'owner': owner,\n                'next_action': 'Finance to resolve the conflicting delivery without erasing admitted money'}\n        elif len(occurrences) > 1:\n            duplicate_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences],\n                                     'delivery_batches': [_values(r).get('Arrival batch') for r in occurrences]})\n        if event_id not in admitted:\n            batches = [_positive_integer(_values(r).get('Arrival batch')) for r in occurrences]\n            first_batch = min((v for v in batches if v is not None), default=None)\n            first = [r for r in occurrences if first_batch is not None and _positive_integer(_values(r).get('Arrival batch')) == first_batch]\n            if not first:\n                candidate = item_for(relevant[0])\n                candidate['validation_errors'] = ['missing or invalid positive integer arrival batch']\n                unresolved.append(candidate)\n            # Same-batch conflicting payloads have no supplied authority order.\n            if first and all(_payload(_values(r)) == _payload(_values(first[0])) for r in first):\n                candidate = item_for(first[0])\n                values = candidate['source_record']\n                reasons = finance_errors(values, candidate['classification'], event_context, _cents)\n                if candidate['classification'] == 'unresolved':\n                    reasons.append('unknown Finance event vocabulary')\n                if values.get('Claim reference') == claim_id and not reasons:\n                    candidate['validation_context'] = deepcopy(event_context)\n                    admitted[event_id] = candidate\n                elif values.get('Claim reference') == claim_id:\n                    candidate['validation_errors'] = reasons\n                    unresolved.append(candidate)\n        for record in relevant:\n            item = item_for(record)\n            canonical = admitted.get(event_id)\n            same = canonical is not None and _payload(item['source_record']) == _payload(canonical['source_record'])\n            item['admission_status'] = 'admitted-or-exact-replay' if same else 'held'\n            if not same:\n                item['classification'] = 'conflicting_event_id' if conflict else 'unresolved'\n            history.append(item)\n    for record in missing_id_records:\n        item = item_for(record); item['classification'] = 'missing_event_id'\n        item['validation_errors'] = ['immutable event identity missing']; history.append(item); unresolved.append(item)\n    # Previously admitted facts remain observable even on a delta-only invocation.\n    for event_id, item in prior.items():\n        if not any(h['event_id'] == event_id and _payload(h['source_record']) == _payload(item['source_record']) for h in history):\n            history.append(deepcopy(item))\n    typed = list(admitted.values())\n    payments = {item['event_id']: item for item in typed if item['classification'] == 'confirmed_payment'}\n    confirmed_refunds = [deepcopy(item) for item in prior.values() if item['classification'] == 'confirmed_refund']\n    recovered = defaultdict(int)\n    for item in confirmed_refunds:\n        recovered[item['original_activity_id']] += item['amount_cents']\n    refund_candidates = [item for item in typed if item['classification'] == 'confirmed_refund' and item['event_id'] not in prior]\n    refund_candidates.sort(key=lambda h: (_positive_integer(h['source_record'].get('Arrival batch')) or 0,\n                                         utc_time(h['source_record']['Activity time (UTC)']), h['event_id']))\n    for item in refund_candidates:\n        original = payments.get(item['original_activity_id'])\n        valid = original is not None and all(item['source_record'].get(k) == original['source_record'].get(k)\n                                             for k in ('Request reference', 'Payee ID', 'Currency', 'Claim reference'))\n        if valid:\n            valid = (utc_time(item['source_record']['Activity time (UTC)']) >= utc_time(original['source_record']['Activity time (UTC)'])\n                     and recovered[item['original_activity_id']] + item['amount_cents'] <= original['amount_cents'])\n        if not valid:\n            item['validation_errors'] = ['refund lacks matching settled request/payee/time or exceeds unrecovered transfer']\n            unresolved.append(item); admitted.pop(item['event_id'], None)\n        else:\n            confirmed_refunds.append(item); recovered[item['original_activity_id']] += item['amount_cents']\n    typed = list(admitted.values())\n    invalid_ids = {item['event_id'] for item in unresolved}\n    for item in history:\n        if item['event_id'] in invalid_ids and item['event_id'] not in admitted:\n            item['classification'] = 'unresolved'; item['admission_status'] = 'held'\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} held: {', '.join(item.get('validation_errors', ['unmatched event']))}\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n    )\n    if recorded_problem:\n        issues.append({\n            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n        })\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"missing_or_return_reason\": (\"recorded Finance obligation exists, but current-revision reimbursement authorization and entitlement remain unconfirmed\"\n                                         if recorded_obligation else \"no supported authorized obligation was supplied for this claim revision\"),\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    ledger_balance = None\n    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n        # Cash for a different/missing request cannot be silently applied to this ledger.\n        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n    if recorded_obligation is not None and event_set_complete and ledger_balance is None:\n        issues.append({\n            \"record_id\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n            \"owner\": owner,\n            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n        })\n    issues_by_owner = {}\n    for issue in issues:\n        issues_by_owner.setdefault(issue['owner'], []).append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row['record_id']) for key, value in sorted(issues_by_owner.items())}\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n                \"prior_recorded_obligation\": deepcopy(previous_reconciliation.get(\"recorded_obligation\")),\n                \"next_action\": \"Revalidate exact revision authorization; historical ledger and cash remain retained\",\n            }\n    revalidation_history = deepcopy((previous_reconciliation or {}).get(\"financial_revalidation_history\", []))\n    if invalidated is not None:\n        revalidation_history.append(deepcopy(invalidated))\n    return {\n        \"admitted_events\": deepcopy(admitted),\n        \"event_context\": deepcopy(event_context),\n        \"admitted_event_ids\": list(admitted),\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"recorded_obligation_history\": obligation_history,\n        \"recorded_obligation\": recorded_obligation,\n        \"recorded_ledger_balance_cents\": ledger_balance,\n        \"reimbursement_entitlement_confirmed\": False,\n        \"closure_authority_confirmed\": False,\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n        \"financial_revalidation_history\": revalidation_history,\n    }\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str, parsed: dict[str, Any],\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"],\n        trips=parsed.get(\"records\", {}).get(\"trips\", []), people=table(parsed, \"people\", \"People\"),\n        clock=parsed.get(\"event_clock\") or parsed.get(\"case_clock\"), arrival_batch=domain[\"processed_batches\"][-1],\n        previous_state=domain.get(\"cancellation_state\"))\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {}\n    for record in domain[\"cancellation_records\"]:\n        raw_by_id.setdefault(row_values(record).get(\"Cancellation activity reference\"), record)\n    domain[\"cancellation_evidence\"] = {}\n    for index, issue in enumerate(reduced[\"issues\"]):\n        event = next((r for r in domain[\"cancellation_records\"] if _ref(r) == issue.get(\"source_ref\")),\n                     raw_by_id.get(issue.get(\"event_id\")))\n        value = row_values(event) if event else {}\n        kind = value.get(\"Cancelled subject\")\n        subject = value.get(\"Trip reference\") if kind == \"trip\" else value.get(\"Permit reference\")\n        revision = _as_batch(value.get(\"Trip revision\") if kind == \"trip\" else value.get(\"Permit revision\"))\n        if kind in {\"trip\", \"permit\"} and subject and revision:\n            _open_issue_for_subject(domain[\"repair_queue\"], item_id=f\"cancellation-evidence:{issue.get('event_id')}:{index}\",\n                subject_type=kind, subject_id=subject, revision=revision, refs=[_ref_text(_ref(event))],\n                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n                run_id=run_id, batch_id=batch_id)\n    current_invalid = {i.get('event_id') for i in reduced['issues']}\n    for item_id, item in domain['repair_queue']['items'].items():\n        if item_id.startswith('cancellation-evidence:'):\n            for event_id, record in reduced['admitted_records'].items():\n                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\n                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\n                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        if not record_order:\n            continue  # Orphan evidence remains in cancellation_state and owned issues.\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        current_affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n                        current_affected.append(claim_id)\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"source_refs\": refs,\n            \"original_request_ids\": sorted({row_values(r).get(\"Request reference\") for r in domain[\"finance_records\"]\n                if row_values(r).get(\"Claim reference\") in affected and row_values(r).get(\"Request reference\")}),\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n        # Finance dispositions are explicit claim/revision/cancellation-bound source\n        # statements. They do not establish the missing policy or closure authority.\n        dispositions = []\n        for claim_id in affected:\n            for revision in claim_revisions[claim_id][\"revisions\"]:\n                value = _page_values(revision[\"record\"])\n                if (value.get(\"Travel cancellation reference\") == cancellation_id\n                        and value.get(\"Applies to claim\") == claim_id\n                        and str(value.get(\"Applies to revision\")) == str(revision[\"revision\"])\n                        and value.get(\"Authorizing Finance officer\")\n                        and value.get(\"Allowed original amount\") is not None):\n                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n                        \"expense_reference\": value.get(\"Expense reference\"),\n                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n        if dispositions:\n            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n            changes = {\n                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n            if changes:\n                update_repair_item(queue, item_id=task_id,\n                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n                 if row_values(r).get(\"Trip reference\") == trip_id\n                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n        actors_ok = bool(employee and supervisor\n            and request_values.get(\"Acting employee or supervisor\") == employee\n            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n        if not actors_ok:\n            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n                run_id=run_id, batch_id=batch_id)\n        actor_item = f\"cancellation-authority:{cancellation_id}\"\n        if actor_item in queue[\"items\"]:\n            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n        domain[\"cancellation_evidence\"][cancellation_id] = {\n            \"current_claim_ids\": sorted(set(current_affected)),\n            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n            \"history\": deepcopy(process[\"history\"]),\n            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n            \"dispositions\": dispositions,\n            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n        }\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n","exit_code":0,"duration":{"secs":0,"nanos":62012708},"formatted_output":"Warning: truncated output (original token count: 10301)\nTotal output lines: 661\n\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom datetime import datetime\nfrom .event_validation import finance_errors, utc_time\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef _reference_text(ref: dict[str, Any]) -> str:\n    return f\"{ref.get('source_id')}@{ref.get('source_sha256')}#{ref.get('locator')}\"\n\n\ndef _positive_integer(value: Any) -> int | None:\n    try:\n        return int(value) if not isinstance(value, bool) and int(value) > 0 and float(value) == int(value) else None\n    except (ValueError, TypeError, OverflowError):\n        return None\n\n\ndef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    claim revision; arrival context is retained separately from explicit links.\n    Only the first delivery establishes context; redelivery cannot rebind it.\n    \"\"\"\n    groups: dict[str, list[dict]] = defaultdict(list)\n    for event in history:\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n            groups[event['event_id']].append(event)\n    records = []\n    problem = None\n    for event_id, occurrences in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n    event_context: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\n            and any(previous_reconciliation.get(k) for k in ('confirmed_payment_event_ids', 'confirmed_refund_event_ids',\n                'confirmed_payment_cents', 'confirmed_refund_cents', 'net_confirmed_cents'))):\n        raise ValueError('Legacy admission state requires explicit verified migration; refusing to erase or invent admitted money')\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    # Accept full-history or delta calls without dropping earlier raw deliveries.\n    retained = [{**deepcopy(h['source_ref']), 'values': {k: {'value': v} for k, v in h['source_record'].items()}}\n                for h in (previous_reconciliation or {}).get('event_history', []) if isinstance(h.get('source_ref'), dict) and 'source_record' in h]\n    deliveries = []\n    for record in retained + events:\n        if not any(_source_ref(r) == _source_ref(record) and _values(r) == _values(record) for r in deliveries):\n            deliveries.append(record)\n    events = deliveries\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    prior = deepcopy((previous_reconciliation or {}).get('admitted_events', {}))\n    admitted = deepcopy(prior)\n    history, duplicate_events, conflicting_events, unresolved = [], [], [], []\n    event_issue_by_id = {}\n\n    def item_for(record):\n        values = _values(record)\n        return {\"event_id\": values.get(\"Activity reference\"), \"source_ref\": _source_ref(record),\n                \"source_record\": deepcopy(values), \"event_type\": values.get(\"Activity type\"),\n                \"classification\": classes.get(values.get(\"Activity type\"), \"unresolved\"),\n                \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n                \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n                \"currency\": values.get(\"Currency\"), \"original_activity_id\": values.get(\"Original activity reference\")}\n\n    for event_id, occurrences in by_id.items():\n        relevant = [r for r in occurrences if _values(r).get('Claim reference') == claim_id]\n        if not relevant and event_id not in prior:\n            continue\n        payloads = [_payload(_values(r)) for r in occurrences]\n        if event_id in prior:\n            payloads.append(_payload(prior[event_id]['source_record']))\n        conflict = any(v != payloads[0] for v in payloads[1:])\n        if conflict:\n            conflicting_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences], 'payloads': payloads})\n            event_issue_by_id[event_id] = {\n                'record_id': f'finance-event-conflict:{event_id}', 'event_id': event_id,\n                'subject_type': 'claim', 'subject_id': claim_id, 'revision': current_revision,\n                'missing_or_return_reason': 'Conflicting immutable event replay; admitted history retained, new payload held',\n                'source_refs': [_source_ref(r) for r in occurrences], 'owner': owner,\n                'next_action': 'Finance to resolve the conflicting delivery without erasing admitted money'}\n        elif len(occurrences) > 1:\n            duplicate_events.append({'event_id': event_id, 'source_refs': [_source_ref(r) for r in occurrences],\n                                     'delivery_batches': [_values(r).get('Arrival batch') for r in occurrences]})\n        if event_id not in admitted:\n            batches = [_positive_integer(_values(r).get('Arrival batch')) for r in occurrences]\n            first_batch = min((v for v in batches if v is not None), default=None)\n            first = [r for r in occurrences if first_batch is not None and _positive_integer(_values(r).get('Arrival batch')) == first_batch]\n            if not first:\n                candidate = item_for(relevant[0])\n                candidate['validation_errors'] = ['missing or invalid positive integer arrival batch']\n                unresolved.append(candidate)\n            # Same-batch conflicting payloads have no supplied authority order.\n            if first and all(_payload(_values(r)) == _payload(_values(first[0])) for r in first):\n                candidate = item_for(first[0])\n                values = candidate['source_record']\n                reasons = finance_errors(values, candidate['classification'], event_context, _cents)\n                if candidate['classification'] == 'unresolved':\n                    reasons.append('unknown Finance event vocabulary')\n                if values.get('Claim reference') == claim_id and not reasons:\n                    candidate['validation_context'] = deepcopy(event_context)\n                    admitted[event_id] = candidate\n                elif values.get('Claim reference') == claim_id:\n                    candidate['validation_errors'] = reasons\n                    unresolved.append(candidate)\n        for record in relevant:\n            item = item_for(record)\n            canonical = admitted.get(event_id)\n            same = canonical is not None and _payload(item['source_record']) == _payload(canonical['source_record'])\n            item['admission_status'] = 'admitted-or-exact-replay' if same else 'held'\n            if not same:\n                item['classification'] = 'conflicting_event_id' if conflict else 'unresolved'\n            history.append(item)\n    for record in missing_id_records:\n        item = item_for(record); item['classification'] = 'missing_event_id'\n        item['validation_errors'] = ['immutable event identity missing']; history.append(item); unresolved.append(item)\n    # Previously admitted facts remain observable even on a delta-only invocation.\n    for event_id, item in prior.items():\n        if not any(h['event_id'] == event_id and _payload(h['source_record']) == _payload(item['source_record']) for h in history):\n            history.append(deepcopy(item))\n    typed = list(admitted.values())\n    payments = {item['event_id']: item for item in typed if item['classification'] == 'confirmed_payment'}\n    confirmed_refunds = [deepcopy(item) for item in prior.values() if item['classification'] == 'confirmed_refund']\n    recovered = defaultdict(int)\n    for item in confirmed_refunds:\n        recovered[item['original_activity_id']] += item['amount_cents']\n    refund_candidates = [item for item in typed if item['classification'] == 'confirmed_refund' and item['event_id'] not in prior]\n    refund_candidates.sort(key=lambda h: (_positive_integer(h['source_record'].get('Arrival batch')) or 0,\n                                         utc_time(h['source_record']['Activity time (UTC)']), h['event_id']))\n    for item in refund_candidates:\n        original = payments.get(item['original_activity_id'])\n        valid = original is not None and all(item['source_record'].get(k) == original['source_record'].get(k)\n                                             for k in ('Request reference', 'Payee ID', 'Currency', 'Claim reference'))\n        if valid:\n            valid = (utc_time(item['source_record']['Activity time (UTC)']) >= utc_time(original['source_record']['Activity time (UTC)'])\n                     and recovered[item['original_activity_id']] + item['amount_cents'] <= original['amount_cents'])\n        if not valid:\n            item['validation_errors'] = ['refund lacks matching settled request/payee/time or exceeds unrecovered transfer']\n            unresolved.append(item); admitted.pop(item['event_id'], None)\n        else:\n            confirmed_refunds.append(item); recovered[item['original_activity_id']] += item['amount_cents']\n    typed = list(admitted.values())\n    invalid_ids = {item['event_id'] for item in unresolved}\n    for item in history:\n        if item['event_id'] in invalid_ids and item['event_id'] not in admitted:\n            item['classification'] = 'unresolved'; item['admission_status'] = 'held'\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} held: {', '.join(item.get('validation_errors', ['unmatched event']))}\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n    )\n    if recorded_problem:\n        issues.append({\n            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n        })\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n          …301 tokens truncated…confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    ledger_balance = None\n    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n        # Cash for a different/missing request cannot be silently applied to this ledger.\n        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n    if recorded_obligation is not None and event_set_complete and ledger_balance is None:\n        issues.append({\n            \"record_id\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n            \"owner\": owner,\n            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n        })\n    issues_by_owner = {}\n    for issue in issues:\n        issues_by_owner.setdefault(issue['owner'], []).append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row['record_id']) for key, value in sorted(issues_by_owner.items())}\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n                \"prior_recorded_obligation\": deepcopy(previous_reconciliation.get(\"recorded_obligation\")),\n                \"next_action\": \"Revalidate exact revision authorization; historical ledger and cash remain retained\",\n            }\n    revalidation_history = deepcopy((previous_reconciliation or {}).get(\"financial_revalidation_history\", []))\n    if invalidated is not None:\n        revalidation_history.append(deepcopy(invalidated))\n    return {\n        \"admitted_events\": deepcopy(admitted),\n        \"event_context\": deepcopy(event_context),\n        \"admitted_event_ids\": list(admitted),\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"recorded_obligation_history\": obligation_history,\n        \"recorded_obligation\": recorded_obligation,\n        \"recorded_ledger_balance_cents\": ledger_balance,\n        \"reimbursement_entitlement_confirmed\": False,\n        \"closure_authority_confirmed\": False,\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n        \"financial_revalidation_history\": revalidation_history,\n    }\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str, parsed: dict[str, Any],\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"],\n        trips=parsed.get(\"records\", {}).get(\"trips\", []), people=table(parsed, \"people\", \"People\"),\n        clock=parsed.get(\"event_clock\") or parsed.get(\"case_clock\"), arrival_batch=domain[\"processed_batches\"][-1],\n        previous_state=domain.get(\"cancellation_state\"))\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {}\n    for record in domain[\"cancellation_records\"]:\n        raw_by_id.setdefault(row_values(record).get(\"Cancellation activity reference\"), record)\n    domain[\"cancellation_evidence\"] = {}\n    for index, issue in enumerate(reduced[\"issues\"]):\n        event = next((r for r in domain[\"cancellation_records\"] if _ref(r) == issue.get(\"source_ref\")),\n                     raw_by_id.get(issue.get(\"event_id\")))\n        value = row_values(event) if event else {}\n        kind = value.get(\"Cancelled subject\")\n        subject = value.get(\"Trip reference\") if kind == \"trip\" else value.get(\"Permit reference\")\n        revision = _as_batch(value.get(\"Trip revision\") if kind == \"trip\" else value.get(\"Permit revision\"))\n        if kind in {\"trip\", \"permit\"} and subject and revision:\n            _open_issue_for_subject(domain[\"repair_queue\"], item_id=f\"cancellation-evidence:{issue.get('event_id')}:{index}\",\n                subject_type=kind, subject_id=subject, revision=revision, refs=[_ref_text(_ref(event))],\n                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n                run_id=run_id, batch_id=batch_id)\n    current_invalid = {i.get('event_id') for i in reduced['issues']}\n    for item_id, item in domain['repair_queue']['items'].items():\n        if item_id.startswith('cancellation-evidence:'):\n            for event_id, record in reduced['admitted_records'].items():\n                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\n                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\n                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        if not record_order:\n            continue  # Orphan evidence remains in cancellation_state and owned issues.\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        current_affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n                        current_affected.append(claim_id)\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"source_refs\": refs,\n            \"original_request_ids\": sorted({row_values(r).get(\"Request reference\") for r in domain[\"finance_records\"]\n                if row_values(r).get(\"Claim reference\") in affected and row_values(r).get(\"Request reference\")}),\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n        # Finance dispositions are explicit claim/revision/cancellation-bound source\n        # statements. They do not establish the missing policy or closure authority.\n        dispositions = []\n        for claim_id in affected:\n            for revision in claim_revisions[claim_id][\"revisions\"]:\n                value = _page_values(revision[\"record\"])\n                if (value.get(\"Travel cancellation reference\") == cancellation_id\n                        and value.get(\"Applies to claim\") == claim_id\n                        and str(value.get(\"Applies to revision\")) == str(revision[\"revision\"])\n                        and value.get(\"Authorizing Finance officer\")\n                        and value.get(\"Allowed original amount\") is not None):\n                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n                        \"expense_reference\": value.get(\"Expense reference\"),\n                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n        if dispositions:\n            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n            changes = {\n                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n            if changes:\n                update_repair_item(queue, item_id=task_id,\n                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n                 if row_values(r).get(\"Trip reference\") == trip_id\n                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n        actors_ok = bool(employee and supervisor\n            and request_values.get(\"Acting employee or supervisor\") == employee\n            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n        if not actors_ok:\n            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n                run_id=run_id, batch_id=batch_id)\n        actor_item = f\"cancellation-authority:{cancellation_id}\"\n        if actor_item in queue[\"items\"]:\n            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n        domain[\"cancellation_evidence\"][cancellation_id] = {\n            \"current_claim_ids\": sorted(set(current_affected)),\n            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n            \"history\": deepcopy(process[\"history\"]),\n            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n            \"dispositions\": dispositions,\n            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n        }\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n"},"started_at_ms":1792063088387,"completed_at_ms":1792063088449}}
{"timestamp":"2026-10-15T11:18:09.130Z","ordinal":4526,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4","item":{"type":"CommandExecution","id":"exec-e4d5e138-d2a9-4271-bd4a-149582020e07","process_id":"1808","command":["/bin/bash","-lc","cat tests/test_ordinary.py; cat tests/test_revalidation.py; cat tests/test_retained_finance.py | head -115; ls /tmp/*hash* 2>/dev/null"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"cat tests/test_ordinary.py; cat tests/test_revalidation.py; cat tests/test_retained_finance.py | head -115; ls /tmp/*hash* 2>/dev/null"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation', 'travel_permission', 'required_approvals'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('policy_eligibility', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_untrusted_synthetic_threshold_cannot_override_policy_director_threshold():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'PASS'\n    assert value['status'] == 'closed-reimbursed'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'BLOCKED'\n    assert value['permit_approval']['arrangements_at_commitment_supported']\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n\"\"\"Correction execution and independent cancellation regression evidence.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_retained_finance import _fixture, _batches\nfrom travel_claim.revalidation import correction_changes, verification_document\nfrom travel_claim.workflow import reduce_cancellation_activities\n\n\ndef corrected(parsed, *, receipt=None, amount=None):\n    record = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in record['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    record['locator'] = 'SYNTHETIC Step157 correction'\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\n    if amount: record['text'] = record['text'].replace('100.00', amount)\n    parsed['records']['claim_revisions'].append(record)\n    return record\n\n\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\n    parsed = synthetic()\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\n                       amount='120.00' if change == 'amount' else None)\n    before, paid, revised, final = batches(parsed)\n    correction = final['domain']['material_corrections'][0]\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\n    assert len(correction['executed_rechecks']) == 2\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\n    assert checks['required_approvals']['status'] == 'BLOCKED'\n    assert checks['request_obligation']['status'] == 'BLOCKED'\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert workflow(paid)['status'] == 'closed-reimbursed'\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\n    assert all(c['source_refs'] for c in checks.values())\n\n\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\n    results = _batches(_fixture()); final = results[-1]\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\n    detail = final['domain']['cancellation_evidence']['TC018']\n    assert detail['current_claim_ids'] == []\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\n    assert cancellation['affected_claim_ids'] == ['C18']\n    assert cancellation['original_request_ids'] == ['REQ-C18']\n    finance = final['finance_reconciliations']['C18']\n    assert finance['net_confirmed_cents'] == 10000\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\n\n\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\n    final = _batches(_fixture())[-1]\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\n    history = final['domain']['cancellation_evidence']['TC122']['history']\n    assert [h['arrival_batch'] for h in history] == [1, 2]\n    assert history[0]['actor'] == 'EMP-01'\n    assert \"row 7\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\n\n\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\ndef test_partial_and_independent_permit_cancellation(fault):\n    parsed = _fixture()\n    rows = [r for r in parsed['records']['cancellation_activities']\n            if r['values']['Cancellation reference']['value'] == 'TC121']\n    parsed['records']['cancellation_activities'] = rows\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\n    else:\n        parsed['records']['claim_revisions'] = []\n        parsed['records']['finance_events'] = []\n    final = _batches(parsed)[-1]\n    process = final['domain']['cancellation_state']['processes']['TC121']\n    if fault == 'no-claim-permit':\n        assert process['state'] == 'confirmed'\n        cancel = final['snapshot']['travel_cancellations'][0]\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\n    else:\n        assert process['state'] != 'confirmed'\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\n\n\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\n    parsed = synthetic(); corrected(parsed)\n    final = batches(parsed)[-1]\n    data, summary = verification_document(final['domain'], final['snapshot']['travel_cancellations'], run_id='test')\n    assert data['fresh_native_reads_performed'] is False\n    assert 'OFFLINE REPLAY' in summary and 'required_approvals | BLOCKED' in summary\n    assert 'SYNTHETIC Step157 correction' in summary\n    assert data['corrections'][0]['executed_rechecks']\n\n\ndef test_retained_dispositions_are_exact_revision_bound_observations_not_closure():\n    final = _batches(_fixture())[-1]\n    for cancellation_id, claim, revision, amount, page in (\n            ('TC121', 'C121', 2, '20.00', 'PDF page 6'),\n            ('TC019', 'C19', 3, '80.00', 'PDF page 7')):\n        detail = final['domain']['cancellation_evidence'][cancellation_id]\n        disposition, = detail['dispositions']\n        assert (disposition['claim_id'], disposition['revision'], disposition['allowed_original_amount']) == (claim, revision, amount)\n        assert disposition['source_ref'].endswith(page)\n        assert final['domain']['ordinary_workflows'][claim]['status'] == 'pending'\n        item = final['domain']['repair_queue']['items'][f'cancellation-financial:{cancellation_id}']\n        assert item['status'] == 'open'\n        assert 'disposition recorded' in item['missing_or_return_reason']\n    assert final['finance_reconciliations']['C19']['net_confirmed_cents'] == 8000\n    assert final['finance_reconciliations']['C121']['net_confirmed_cents'] == 2000\n\"\"\"Regression examples transcribed verbatim from the retained native workbook.\"\"\"\n\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\n\n\ndef reconcile_finance_events(*args, **kwargs):\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\n    return _reconcile(*args, **kwargs)\nfrom travel_claim.integration import integrate_arrival_batch\n\nFIXTURE = Path(__file__).parent / \"fixtures/retained_finance_records.json\"\n\n\ndef _fixture():\n    parsed = json.loads(FIXTURE.read_text())\n    # Exact retained directory records extend the selected-record test fixture.\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\n    return parsed\n\n\ndef _batches(parsed):\n    prior = None\n    results = []\n    for batch in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior,\n        )\n        results.append(prior)\n    return results\n\n\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\n    parsed = _fixture()\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\n    results = _batches(parsed)\n    final = results[-1]\n    c1 = final['finance_reconciliations']['C01']\n    obligation = c1['recorded_obligation']\n    assert obligation['event_id'] == 'F-C01-accepted'\n    assert obligation['request_id'] == 'REQ-C01'\n    assert obligation['finance_officer'] == 'FIN-01'\n    assert obligation['payee_id'] == 'EMP-01'\n    assert obligation['amount_cents'] == 10000\n    assert obligation['claim_revision'] is None\n    assert obligation['arrival_revision_context'] == 1\n    assert obligation['revision_link_status'] == 'arrival_context_only'\n    assert obligation['first_arrival_batch'] == 1\n    assert obligation['source_refs'] == [\n        'travel-registers-workbook@' + parsed['provenance']['workbook_sha256'] + \"#tab 'Finance activity', row 33\"\n    ]\n    assert obligation['claim_source_refs'][0]['locator'] == 'PDF page 1'\n    assert c1['net_confirmed_cents'] == 10000  # delivered twice, counted once\n    assert c1['duplicate_events'][0]['delivery_batches'] == [2, 4]\n    assert c1['recorded_ledger_balance_cents'] == 0\n    assert c1['authorized_obligation'] is None\n    assert c1['balance_cents'] is None\n    assert c1['closure_authority_confirmed'] is False\n    projected = next(c for c in final['snapshot']['claims'] if c['claim_id'] == 'C01')\n    assert projected['finance_evidence']['recorded_ledger_balance_cents'] == 0\n    assert projected['allowed_cents'] is None and projected['status'] == 'pending'\n\n\ndef test_native_corrections_keep_ledger_history_and_revalidate_authority_only_where_affected():\n    results = _batches(_fixture())\n    first, _, third, final = results\n    initial = deepcopy(first)\n    c19 = final['finance_reconciliations']['C19']\n    assert [(r['event_id'], r['amount_cents'], r['arrival_revision_context']) for r in c19['recorded_obligation_history']] == [\n        ('F-C19-accepted', 10000, 1), ('F-C19-2', 8000, 2), ('F-C19-4', 8000, 3),\n    ]\n    assert c19['confirmed_payment_cents'] == 10000\n    assert c19['confirmed_refund_cents'] == 2000\n    assert c19['recorded_ledger_balance_cents'] == 0\n    assert c19['recorded_obligation']['claim_revision'] is None\n    assert c19['invalidated_previous_reconciliation']['claim_revision'] == 2\n    assert final['finance_reconciliations']['C09']['recorded_obligation']['arrival_revision_context'] == 2\n    assert final['finance_reconciliations']['C12']['recorded_obligation']['amount_cents'] == 7000\n    assert final['finance_reconciliations']['C01']['recorded_obligation'] == first['finance_reconciliations']['C01']['recorded_obligation']\n    # C18 correction has no newly bound accepted amount. Retain r1 context;\n    # neither cancellation nor a fresh payment silently reauthorizes revision 2.\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['claim_revision'] == 2\n    assert c18['recorded_obligation']['arrival_revision_context'] == 1\n    assert c18['authorized_obligation'] is None\n    assert c18['confirmed_payment_cents'] == 10000\n    item = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:1']\n    # Historic question remains historic; r2 has its own current authorization question.\n    assert item['revision'] == 1\n    current = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:2']\n    assert current['source_refs']\n    assert 'recorded Finance obligation exists' in current['missing_or_return_reason']\n    assert current['status'] == 'open'\n    assert first == initial\n\n\ndef test_native_refund_and_finance_cancellation_are_independent_of_business_cancellations():\n    final = _batches(_fixture())[-1]\n    cancellations = {c['cancellation_id']: c for c in final['snapshot']['travel_cancellations']}\n    assert cancellations['TC122']['affected_claim_ids'] == []\n    assert cancellations['TC122']['target_type'] == 'trip'\n    assert cancellations['TC121']['target_type'] == 'permit'\n    assert all(c['financial_status'] == 'unresolved' for c in cancellations.values())\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['recorded_obligation']['amount_cents'] == 10000\n/tmp/step184-start-hashes.json\n","stderr":"","aggregated_output":"\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation', 'travel_permission', 'required_approvals'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('policy_eligibility', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_untrusted_synthetic_threshold_cannot_override_policy_director_threshold():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'PASS'\n    assert value['status'] == 'closed-reimbursed'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'BLOCKED'\n    assert value['permit_approval']['arrangements_at_commitment_supported']\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n\"\"\"Correction execution and independent cancellation regression evidence.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_retained_finance import _fixture, _batches\nfrom travel_claim.revalidation import correction_changes, verification_document\nfrom travel_claim.workflow import reduce_cancellation_activities\n\n\ndef corrected(parsed, *, receipt=None, amount=None):\n    record = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in record['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    record['locator'] = 'SYNTHETIC Step157 correction'\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\n    if amount: record['text'] = record['text'].replace('100.00', amount)\n    parsed['records']['claim_revisions'].append(record)\n    return record\n\n\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\n    parsed = synthetic()\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\n                       amount='120.00' if change == 'amount' else None)\n    before, paid, revised, final = batches(parsed)\n    correction = final['domain']['material_corrections'][0]\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\n    assert len(correction['executed_rechecks']) == 2\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\n    assert checks['required_approvals']['status'] == 'BLOCKED'\n    assert checks['request_obligation']['status'] == 'BLOCKED'\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert workflow(paid)['status'] == 'closed-reimbursed'\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\n    assert all(c['source_refs'] for c in checks.values())\n\n\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\n    results = _batches(_fixture()); final = results[-1]\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\n    detail = final['domain']['cancellation_evidence']['TC018']\n    assert detail['current_claim_ids'] == []\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\n    assert cancellation['affected_claim_ids'] == ['C18']\n    assert cancellation['original_request_ids'] == ['REQ-C18']\n    finance = final['finance_reconciliations']['C18']\n    assert finance['net_confirmed_cents'] == 10000\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\n\n\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\n    final = _batches(_fixture())[-1]\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\n    history = final['domain']['cancellation_evidence']['TC122']['history']\n    assert [h['arrival_batch'] for h in history] == [1, 2]\n    assert history[0]['actor'] == 'EMP-01'\n    assert \"row 7\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\n\n\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\ndef test_partial_and_independent_permit_cancellation(fault):\n    parsed = _fixture()\n    rows = [r for r in parsed['records']['cancellation_activities']\n            if r['values']['Cancellation reference']['value'] == 'TC121']\n    parsed['records']['cancellation_activities'] = rows\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\n    else:\n        parsed['records']['claim_revisions'] = []\n        parsed['records']['finance_events'] = []\n    final = _batches(parsed)[-1]\n    process = final['domain']['cancellation_state']['processes']['TC121']\n    if fault == 'no-claim-permit':\n        assert process['state'] == 'confirmed'\n        cancel = final['snapshot']['travel_cancellations'][0]\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\n    else:\n        assert process['state'] != 'confirmed'\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\n\n\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\n    parsed = synthetic(); corrected(parsed)\n    final = batches(parsed)[-1]\n    data, summary = verification_document(final['domain'], final['snapshot']['travel_cancellations'], run_id='test')\n    assert data['fresh_native_reads_performed'] is False\n    assert 'OFFLINE REPLAY' in summary and 'required_approvals | BLOCKED' in summary\n    assert 'SYNTHETIC Step157 correction' in summary\n    assert data['corrections'][0]['executed_rechecks']\n\n\ndef test_retained_dispositions_are_exact_revision_bound_observations_not_closure():\n    final = _batches(_fixture())[-1]\n    for cancellation_id, claim, revision, amount, page in (\n            ('TC121', 'C121', 2, '20.00', 'PDF page 6'),\n            ('TC019', 'C19', 3, '80.00', 'PDF page 7')):\n        detail = final['domain']['cancellation_evidence'][cancellation_id]\n        disposition, = detail['dispositions']\n        assert (disposition['claim_id'], disposition['revision'], disposition['allowed_original_amount']) == (claim, revision, amount)\n        assert disposition['source_ref'].endswith(page)\n        assert final['domain']['ordinary_workflows'][claim]['status'] == 'pending'\n        item = final['domain']['repair_queue']['items'][f'cancellation-financial:{cancellation_id}']\n        assert item['status'] == 'open'\n        assert 'disposition recorded' in item['missing_or_return_reason']\n    assert final['finance_reconciliations']['C19']['net_confirmed_cents'] == 8000\n    assert final['finance_reconciliations']['C121']['net_confirmed_cents'] == 2000\n\"\"\"Regression examples transcribed verbatim from the retained native workbook.\"\"\"\n\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\n\n\ndef reconcile_finance_events(*args, **kwargs):\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\n    return _reconcile(*args, **kwargs)\nfrom travel_claim.integration import integrate_arrival_batch\n\nFIXTURE = Path(__file__).parent / \"fixtures/retained_finance_records.json\"\n\n\ndef _fixture():\n    parsed = json.loads(FIXTURE.read_text())\n    # Exact retained directory records extend the selected-record test fixture.\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\n    return parsed\n\n\ndef _batches(parsed):\n    prior = None\n    results = []\n    for batch in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior,\n        )\n        results.append(prior)\n    return results\n\n\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\n    parsed = _fixture()\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\n    results = _batches(parsed)\n    final = results[-1]\n    c1 = final['finance_reconciliations']['C01']\n    obligation = c1['recorded_obligation']\n    assert obligation['event_id'] == 'F-C01-accepted'\n    assert obligation['request_id'] == 'REQ-C01'\n    assert obligation['finance_officer'] == 'FIN-01'\n    assert obligation['payee_id'] == 'EMP-01'\n    assert obligation['amount_cents'] == 10000\n    assert obligation['claim_revision'] is None\n    assert obligation['arrival_revision_context'] == 1\n    assert obligation['revision_link_status'] == 'arrival_context_only'\n    assert obligation['first_arrival_batch'] == 1\n    assert obligation['source_refs'] == [\n        'travel-registers-workbook@' + parsed['provenance']['workbook_sha256'] + \"#tab 'Finance activity', row 33\"\n    ]\n    assert obligation['claim_source_refs'][0]['locator'] == 'PDF page 1'\n    assert c1['net_confirmed_cents'] == 10000  # delivered twice, counted once\n    assert c1['duplicate_events'][0]['delivery_batches'] == [2, 4]\n    assert c1['recorded_ledger_balance_cents'] == 0\n    assert c1['authorized_obligation'] is None\n    assert c1['balance_cents'] is None\n    assert c1['closure_authority_confirmed'] is False\n    projected = next(c for c in final['snapshot']['claims'] if c['claim_id'] == 'C01')\n    assert projected['finance_evidence']['recorded_ledger_balance_cents'] == 0\n    assert projected['allowed_cents'] is None and projected['status'] == 'pending'\n\n\ndef test_native_corrections_keep_ledger_history_and_revalidate_authority_only_where_affected():\n    results = _batches(_fixture())\n    first, _, third, final = results\n    initial = deepcopy(first)\n    c19 = final['finance_reconciliations']['C19']\n    assert [(r['event_id'], r['amount_cents'], r['arrival_revision_context']) for r in c19['recorded_obligation_history']] == [\n        ('F-C19-accepted', 10000, 1), ('F-C19-2', 8000, 2), ('F-C19-4', 8000, 3),\n    ]\n    assert c19['confirmed_payment_cents'] == 10000\n    assert c19['confirmed_refund_cents'] == 2000\n    assert c19['recorded_ledger_balance_cents'] == 0\n    assert c19['recorded_obligation']['claim_revision'] is None\n    assert c19['invalidated_previous_reconciliation']['claim_revision'] == 2\n    assert final['finance_reconciliations']['C09']['recorded_obligation']['arrival_revision_context'] == 2\n    assert final['finance_reconciliations']['C12']['recorded_obligation']['amount_cents'] == 7000\n    assert final['finance_reconciliations']['C01']['recorded_obligation'] == first['finance_reconciliations']['C01']['recorded_obligation']\n    # C18 correction has no newly bound accepted amount. Retain r1 context;\n    # neither cancellation nor a fresh payment silently reauthorizes revision 2.\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['claim_revision'] == 2\n    assert c18['recorded_obligation']['arrival_revision_context'] == 1\n    assert c18['authorized_obligation'] is None\n    assert c18['confirmed_payment_cents'] == 10000\n    item = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:1']\n    # Historic question remains historic; r2 has its own current authorization question.\n    assert item['revision'] == 1\n    current = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:2']\n    assert current['source_refs']\n    assert 'recorded Finance obligation exists' in current['missing_or_return_reason']\n    assert current['status'] == 'open'\n    assert first == initial\n\n\ndef test_native_refund_and_finance_cancellation_are_independent_of_business_cancellations():\n    final = _batches(_fixture())[-1]\n    cancellations = {c['cancellation_id']: c for c in final['snapshot']['travel_cancellations']}\n    assert cancellations['TC122']['affected_claim_ids'] == []\n    assert cancellations['TC122']['target_type'] == 'trip'\n    assert cancellations['TC121']['target_type'] == 'permit'\n    assert all(c['financial_status'] == 'unresolved' for c in cancellations.values())\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['recorded_obligation']['amount_cents'] == 10000\n/tmp/step184-start-hashes.json\n","exit_code":0,"duration":{"secs":0,"nanos":71375417},"formatted_output":"\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation', 'travel_permission', 'required_approvals'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('policy_eligibility', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_untrusted_synthetic_threshold_cannot_override_policy_director_threshold():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'PASS'\n    assert value['status'] == 'closed-reimbursed'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'BLOCKED'\n    assert value['permit_approval']['arrangements_at_commitment_supported']\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n\"\"\"Correction execution and independent cancellation regression evidence.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_retained_finance import _fixture, _batches\nfrom travel_claim.revalidation import correction_changes, verification_document\nfrom travel_claim.workflow import reduce_cancellation_activities\n\n\ndef corrected(parsed, *, receipt=None, amount=None):\n    record = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in record['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    record['locator'] = 'SYNTHETIC Step157 correction'\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\n    if amount: record['text'] = record['text'].replace('100.00', amount)\n    parsed['records']['claim_revisions'].append(record)\n    return record\n\n\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\n    parsed = synthetic()\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\n                       amount='120.00' if change == 'amount' else None)\n    before, paid, revised, final = batches(parsed)\n    correction = final['domain']['material_corrections'][0]\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\n    assert len(correction['executed_rechecks']) == 2\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\n    assert checks['required_approvals']['status'] == 'BLOCKED'\n    assert checks['request_obligation']['status'] == 'BLOCKED'\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert workflow(paid)['status'] == 'closed-reimbursed'\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\n    assert all(c['source_refs'] for c in checks.values())\n\n\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\n    results = _batches(_fixture()); final = results[-1]\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\n    detail = final['domain']['cancellation_evidence']['TC018']\n    assert detail['current_claim_ids'] == []\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\n    assert cancellation['affected_claim_ids'] == ['C18']\n    assert cancellation['original_request_ids'] == ['REQ-C18']\n    finance = final['finance_reconciliations']['C18']\n    assert finance['net_confirmed_cents'] == 10000\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\n\n\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\n    final = _batches(_fixture())[-1]\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\n    history = final['domain']['cancellation_evidence']['TC122']['history']\n    assert [h['arrival_batch'] for h in history] == [1, 2]\n    assert history[0]['actor'] == 'EMP-01'\n    assert \"row 7\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\n\n\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\ndef test_partial_and_independent_permit_cancellation(fault):\n    parsed = _fixture()\n    rows = [r for r in parsed['records']['cancellation_activities']\n            if r['values']['Cancellation reference']['value'] == 'TC121']\n    parsed['records']['cancellation_activities'] = rows\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\n    else:\n        parsed['records']['claim_revisions'] = []\n        parsed['records']['finance_events'] = []\n    final = _batches(parsed)[-1]\n    process = final['domain']['cancellation_state']['processes']['TC121']\n    if fault == 'no-claim-permit':\n        assert process['state'] == 'confirmed'\n        cancel = final['snapshot']['travel_cancellations'][0]\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\n    else:\n        assert process['state'] != 'confirmed'\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\n\n\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\n    parsed = synthetic(); corrected(parsed)\n    final = batches(parsed)[-1]\n    data, summary = verification_document(final['domain'], final['snapshot']['travel_cancellations'], run_id='test')\n    assert data['fresh_native_reads_performed'] is False\n    assert 'OFFLINE REPLAY' in summary and 'required_approvals | BLOCKED' in summary\n    assert 'SYNTHETIC Step157 correction' in summary\n    assert data['corrections'][0]['executed_rechecks']\n\n\ndef test_retained_dispositions_are_exact_revision_bound_observations_not_closure():\n    final = _batches(_fixture())[-1]\n    for cancellation_id, claim, revision, amount, page in (\n            ('TC121', 'C121', 2, '20.00', 'PDF page 6'),\n            ('TC019', 'C19', 3, '80.00', 'PDF page 7')):\n        detail = final['domain']['cancellation_evidence'][cancellation_id]\n        disposition, = detail['dispositions']\n        assert (disposition['claim_id'], disposition['revision'], disposition['allowed_original_amount']) == (claim, revision, amount)\n        assert disposition['source_ref'].endswith(page)\n        assert final['domain']['ordinary_workflows'][claim]['status'] == 'pending'\n        item = final['domain']['repair_queue']['items'][f'cancellation-financial:{cancellation_id}']\n        assert item['status'] == 'open'\n        assert 'disposition recorded' in item['missing_or_return_reason']\n    assert final['finance_reconciliations']['C19']['net_confirmed_cents'] == 8000\n    assert final['finance_reconciliations']['C121']['net_confirmed_cents'] == 2000\n\"\"\"Regression examples transcribed verbatim from the retained native workbook.\"\"\"\n\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\n\n\ndef reconcile_finance_events(*args, **kwargs):\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\n    return _reconcile(*args, **kwargs)\nfrom travel_claim.integration import integrate_arrival_batch\n\nFIXTURE = Path(__file__).parent / \"fixtures/retained_finance_records.json\"\n\n\ndef _fixture():\n    parsed = json.loads(FIXTURE.read_text())\n    # Exact retained directory records extend the selected-record test fixture.\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\n    return parsed\n\n\ndef _batches(parsed):\n    prior = None\n    results = []\n    for batch in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior,\n        )\n        results.append(prior)\n    return results\n\n\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\n    parsed = _fixture()\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\n    results = _batches(parsed)\n    final = results[-1]\n    c1 = final['finance_reconciliations']['C01']\n    obligation = c1['recorded_obligation']\n    assert obligation['event_id'] == 'F-C01-accepted'\n    assert obligation['request_id'] == 'REQ-C01'\n    assert obligation['finance_officer'] == 'FIN-01'\n    assert obligation['payee_id'] == 'EMP-01'\n    assert obligation['amount_cents'] == 10000\n    assert obligation['claim_revision'] is None\n    assert obligation['arrival_revision_context'] == 1\n    assert obligation['revision_link_status'] == 'arrival_context_only'\n    assert obligation['first_arrival_batch'] == 1\n    assert obligation['source_refs'] == [\n        'travel-registers-workbook@' + parsed['provenance']['workbook_sha256'] + \"#tab 'Finance activity', row 33\"\n    ]\n    assert obligation['claim_source_refs'][0]['locator'] == 'PDF page 1'\n    assert c1['net_confirmed_cents'] == 10000  # delivered twice, counted once\n    assert c1['duplicate_events'][0]['delivery_batches'] == [2, 4]\n    assert c1['recorded_ledger_balance_cents'] == 0\n    assert c1['authorized_obligation'] is None\n    assert c1['balance_cents'] is None\n    assert c1['closure_authority_confirmed'] is False\n    projected = next(c for c in final['snapshot']['claims'] if c['claim_id'] == 'C01')\n    assert projected['finance_evidence']['recorded_ledger_balance_cents'] == 0\n    assert projected['allowed_cents'] is None and projected['status'] == 'pending'\n\n\ndef test_native_corrections_keep_ledger_history_and_revalidate_authority_only_where_affected():\n    results = _batches(_fixture())\n    first, _, third, final = results\n    initial = deepcopy(first)\n    c19 = final['finance_reconciliations']['C19']\n    assert [(r['event_id'], r['amount_cents'], r['arrival_revision_context']) for r in c19['recorded_obligation_history']] == [\n        ('F-C19-accepted', 10000, 1), ('F-C19-2', 8000, 2), ('F-C19-4', 8000, 3),\n    ]\n    assert c19['confirmed_payment_cents'] == 10000\n    assert c19['confirmed_refund_cents'] == 2000\n    assert c19['recorded_ledger_balance_cents'] == 0\n    assert c19['recorded_obligation']['claim_revision'] is None\n    assert c19['invalidated_previous_reconciliation']['claim_revision'] == 2\n    assert final['finance_reconciliations']['C09']['recorded_obligation']['arrival_revision_context'] == 2\n    assert final['finance_reconciliations']['C12']['recorded_obligation']['amount_cents'] == 7000\n    assert final['finance_reconciliations']['C01']['recorded_obligation'] == first['finance_reconciliations']['C01']['recorded_obligation']\n    # C18 correction has no newly bound accepted amount. Retain r1 context;\n    # neither cancellation nor a fresh payment silently reauthorizes revision 2.\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['claim_revision'] == 2\n    assert c18['recorded_obligation']['arrival_revision_context'] == 1\n    assert c18['authorized_obligation'] is None\n    assert c18['confirmed_payment_cents'] == 10000\n    item = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:1']\n    # Historic question remains historic; r2 has its own current authorization question.\n    assert item['revision'] == 1\n    current = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:2']\n    assert current['source_refs']\n    assert 'recorded Finance obligation exists' in current['missing_or_return_reason']\n    assert current['status'] == 'open'\n    assert first == initial\n\n\ndef test_native_refund_and_finance_cancellation_are_independent_of_business_cancellations():\n    final = _batches(_fixture())[-1]\n    cancellations = {c['cancellation_id']: c for c in final['snapshot']['travel_cancellations']}\n    assert cancellations['TC122']['affected_claim_ids'] == []\n    assert cancellations['TC122']['target_type'] == 'trip'\n    assert cancellations['TC121']['target_type'] == 'permit'\n    assert all(c['financial_status'] == 'unresolved' for c in cancellations.values())\n    c18 = final['finance_reconciliations']['C18']\n    assert c18['recorded_obligation']['amount_cents'] == 10000\n/tmp/step184-start-hashes.json\n"},"started_at_ms":1792063089058,"completed_at_ms":1792063089130}}
{"timestamp":"2026-10-15T11:18:09.712Z","ordinal":4527,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13f48-ac30-7472-a747-9f049577d715","call_id":"call_4cbfdc0ca01049d0821ffdef5e29c52f","output":[{"type":"input_text","text":"Script completed\nWall time 2.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 25930)\nTotal output lines: 3\n\n{\"chunk_id\":\"9dcba1\",\"wall_time_seconds\":0.027053,\"exit_code\":0,\"original_token_count\":7084,\"output\":\"faf1f780728c17440f133d8c334222fe6a6cb0cb\\n?? artifacts/runs/\\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n?? artifacts/verification/project-d-step157-revalidation/\\n?? artifacts/verification/project-d-step167-audit-probes.json\\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\\n?? user-provided-sources/\\n\\\"\\\"\\\"Connected claim evaluation from retained facts and explicitly sourced rules.\\n\\nNo native policy definitions are inferred from interview descriptions, caps,\\nreview outcomes, or Finance acceptance. Missing authority remains blocked.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom copy import deepcopy\\nfrom datetime import datetime, timezone\\nfrom decimal import Decimal\\nimport re\\n\\nfrom .finance import _cents, reconcile_finance_events\\nfrom .workflow import row_values\\nfrom .expenses import evaluate_expenses, policy_valid\\nfrom .exceptions import travel_findings, review_binds_exception, source_bound\\nfrom .approvals import evaluate_reviews, evaluate_permit\\n\\nROLE_FIELDS = {\\\"administration\\\": \\\"Administration reviewer\\\", \\\"budget_owner\\\": \\\"Budget owner\\\",\\n               \\\"supervisor\\\": \\\"Supervisor\\\", \\\"director\\\": \\\"Director\\\"}\\n\\n\\ndef ref(row):\\n    return f\\\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\\\"\\n\\n\\ndef fields(row):\\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\\n\\n\\ndef table(parsed, key, tab):\\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == tab), []))\\n\\n\\ndef expense_lines(record):\\n    \\\"\\\"\\\"Read complete rows from the retained PDF layout; never guess a row.\\\"\\\"\\\"\\n    lines = []\\n    for raw in record.get('text', '').splitlines():\\n        if not re.match(r'^\\\\s*\\\\d+\\\\s+', raw):\\n            continue\\n        tokens = raw.split()\\n        if len(tokens) == 6:\\n            number, cost, receipt, submitted, amount, currency = tokens\\n        else:\\n            number = tokens[0]; cost = tokens[1] if len(tokens) > 1 else 'unknown'\\n            receipt = submitted = amount = currency = None\\n        lines.append(dict(line=int(number), cost_id=cost, receipt_id=receipt,\\n            first_submitted_date=submitted, original_amount=amount.replace(',', '') if amount else None,\\n            original_cents=_cents(amount.replace(',', '')) if amount else None,\\n            currency=currency, source_refs=[ref(record)]))\\n    return lines\\n\\n\\ndef connect_claim(*, parsed, claim, decisions, finance_events, finance, cancellations,\\n                  arrival_batch, source_observations, prior_finance=None, source_classifications=None, prior_workflow=None, budget_data=None, prepaid_data=None, prior_budget_view=None):\\n    \\\"\\\"\\\"Evaluate an ordinary path; each result keeps its evidence and owner.\\\"\\\"\\\"\\n    record = claim['record']; values = fields(record)\\n    claim_id, revision = claim['subject_id'], claim['revision']\\n    employee, trip_id = values.get('Employee'), claim.get('trip_id')\\n    stages = []\\n    def stage(name, condition, refs, detail, owner, action, fail=False):\\n        row = dict(stage=name, status='PASS' if condition else 'FAIL' if fail else 'BLOCKED',\\n                   source_refs=list(dict.fromkeys([ref(record)] + refs)), detail=detail, owner=owner, next_action=action)\\n        stages.append(row)\\n        return bool(condition)\\n    def trusted(row):\\n        return bool(row.get('locator')) and any(o.get('source_id') == row.get('source_id') and\\n            o.get('sha256') == row.get('source_sha256') and o.get('status') == 'read' and not o.get('missing_scope')\\n            for o in source_observations)\\n    def visible(row):\\n        try:\\n            batch = fields(row).get('Arrival batch')\\n            return not isinstance(batch, bool) and int(batch) == float(batch) and 0 < int(batch) <= arrival_batch\\n        except (ValueError, TypeError, OverflowError):\\n            return False\\n\\n    trips = [r for r in table(parsed, 'trips', 'Trips') if fields(r).get('Trip reference') == trip_id\\n             and str(fields(r).get('Trip revision')) in {str(claim.get('trip_revision')), f\\\"{claim.get('trip_revision')}.0\\\"}]\\n    trip = fields(trips[0]) if len(trips) == 1 else {}\\n    linked = stage('claim_trip_link', len(trips) == 1 and trip.get('Employee ID') == employee\\n                   and len([r for r in finance['revision_history'] if r['revision'] == revision]) == 1,\\n                   [ref(record)] + [ref(r) for r in trips], 'Exact claim, trip revision and employee linkage',\\n                   'Travel Administration Lead', 'Verify the exact employee, trip ID and trip revision binding')\\n    people = [r for r in table(parsed, 'people', 'People') if fields(r).get('Employee ID') == employee]\\n    person = fields(people[0]) if len(people) == 1 else {}\\n    lead = person.get('Administration reviewer') or 'Travel Administration Lead'\\n    finance_owner = person.get('Finance officer') or 'Finance'\\n\\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\\n    policy_record = rules[0] if len(rules) == 1 else None\\n    policy = fields(policy_record) if policy_record else {}\\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\\n                        and isinstance(policy.get('Eligible categories'), list)\\n                        and isinstance(policy.get('Uncapped categories'), list)\\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\\n                        and isinstance(policy.get('Domestic permit required'), bool))\\n    policy_refs = [ref(policy_record)] if policy_record else []\\n    affected = [c for c in cancellations if claim_id in c['affected_claim_ids']]\\n    from .budget import permit_budget_context\\n    permit_budget=permit_budget_context(parsed=parsed,trip_record=trips[0] if len(trips)==1 else {},\\n        budgets=budget_data or {'scopes':{}},prior=((prior_workflow or {}).get('permit_approval') or {}).get('budget_context'),arrival_batch=arrival_batch)\\n    permit_review = evaluate_permit(parsed=parsed, trip_record=trips[0] if len(trips)==1 else {},\\n        decisions=decisions, arrival_batch=arrival_batch, observations=source_observations,\\n        prior=(prior_workflow or {}).get('permit_approval'),\\n        cost_ids=[line['cost_id'] for line in expense_lines(record)],cancellations=cancellations,budget_context=permit_budget)\\n    permission = linked and permit_review['arrangement_authorized']\\n    permission_refs = [ref(r) for r in trips] + policy_refs + permit_review['source_refs']\\n    stage('travel_permission', permission, permission_refs,\\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\\n\\n    lines = expense_lines(record)\\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\\n    if trip.get('International') is True and not permit_review['approved'] and not any(f['issue']=='permit_unapproved' for f in eligibility):\\n        from .exceptions import finding\\n        eligibility.append(finding('permit_unapproved', 'Current permit replies/packets do not establish required approval authority', permit_review['source_refs']))\\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\\n        eligibility_findings=eligibility, observations=source_observations)\\n    from .budget import claim_budget_view\\n    budget_view=claim_budget_view(parsed=parsed,claim=claim,lines=lines,budgets=budget_data or {'scopes':{}},\\n        attribution=prepaid_data or {'costs':{},'unallocated_costs':{}},prior=prior_budget_view,arrival_batch=arrival_batch)\\n    stage('budget_availability',budget_view['status']=='PASS',budget_view['source_refs'],\\n        '; '.join(i['reason'] for i in budget_view['issues']) or 'Complete scope ledger supports the incremental request; funds do not constitute approval',\\n        budget_view['owner'],'Review the complete department/project/period ledger and obtain current budget-owner authorization')\\n    stage('prior_cost_attribution',budget_view['remaining_request_cents'] is not None,budget_view['source_refs'],\\n        'Each cost is linked to supported earlier obligations or remains unresolved; no aggregate prorating',finance_owner,\\n        'Resolve exact original claim/cost/request links before any replacement or additional reimbursement')\\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\\n        line['evidence_status'] == 'PASS' for line in lines)\\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\\n    stage('supporting_evidence', evidence_ok, evidence_refs,\\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\\n    stage('filing_deadline', filing_ok, evidence_refs,\\n          '; '.join(f\\\"{line['cost_id']}: {line['reason']}\\\" for line in lines) or 'Missing expense submissions',\\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\\n    reimbursement_permission = permission or (linked and permit_review.get('arrangements_at_commitment_supported',False)) or (linked and policy_supported and waived_permission)\\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS' and budget_view['remaining_request_cents'] is not None\\n    for line in lines:\\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\\n        if not policy_ok:\\n            line['status'] = 'unresolved'\\n    attributed={l['cost_id']:l for l in budget_view['lines']}\\n    for line in lines:\\n        if policy_ok:\\n            line['allowed_cents']=attributed[line['cost_id']]['remaining_request_cents']\\n            if line['allowed_cents'] is None:\\n                line['status']='unresolved';line['reason']='Prior cost attribution is unresolved; original calculation retained'\\n            if line['allowed_cents']==0 and attributed[line['cost_id']]['prior_reservations']:\\n                line['status']='excluded';line['reason']='Prior cost obligation linked and excluded from this request; gross/conversion evidence retained'\\n    allowed = budget_view['remaining_request_cents'] if policy_ok else None\\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\\n\\n    for line in lines:\\n        exception = line['exception']\\n        if exception['status'] != 'absent':\\n            stage(f\\\"finance_exception:{line['cost_id']}\\\", exception['status'] == 'valid', line['source_refs'],\\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\\n        for item in line['eligibility_findings']:\\n            name = f\\\"eligibility:{line['cost_id']}:{item['issue']}\\\" + (f\\\":{item['travel_cancellation_id']}\\\" if item.get('travel_cancellation_id') else '')\\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\\n\\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\\n    def changed_exception_amount(line):\\n        old = prior_lines.get(line['cost_id'], {})\\n        before = old.get('conversion', {}).get('allowed_original_amount')\\n        after = line.get('conversion', {}).get('allowed_original_amount')\\n        # Unknown-to-known evidence and decimal display precision are not proof\\n        # of a material replacement-amount change.\\n        return bool(before is not None and after is not None\\n            and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\\n            and Decimal(before) != Decimal(after))\\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\\n        any(changed_exception_amount(line) for line in lines)\\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\\n    replacement_review = same_revision_change or any(\\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\\n    line_refs={r for line in lines for r in line['source_refs']}\\n    dependencies=[r for key,tab in [('receipts','Receipts'),('merchant_payments','Merchant payments'),('caps','Caps'),('fx_rates','FX')]\\n                  for r in table(parsed,key,tab) if ref(r) in line_refs]\\n    claim_review=evaluate_reviews(parsed=parsed,kind='claim',subject_id=claim_id,revision=revision,\\n        trip_record=trips[0] if len(trips)==1 else {},employee=employee,subject_record=record,\\n        amount_cents=budget_view['remaining_request_cents'] if calculation['status']=='PASS' else None,decisions=decisions,arrival_batch=arrival_batch,\\n        observations=source_observations,cost_ids=[line['cost_id'] for line in lines],\\n        dependency_rows=dependencies,prior=(prior_workflow or {}).get('claim_approval'),\\n        withdrawn=linked and values.get('Status')=='withdrawn' and trusted(record),\\n        cancellation_ids=[f['travel_cancellation_id'] for f in eligibility if f['issue']=='travel_cancellation'],budget_context=budget_view)\\n    observed=claim_review['deliveries']\\n    # Preserve Step 175's extra binding requirement on material Finance replacements.\\n    for decision in observed:\\n        decision['exception_binding_valid']=(not replacement_review or review_binds_exception(\\n            decision['raw_record'],record,same_revision_change=same_revision_change,fields=fields,ref=ref))\\n        if not decision['exception_binding_valid']:\\n            decision['evidence_valid']=False\\n    approvals=claim_review['approved'] and all(d['evidence_valid'] for d in observed if d['active'])\\n    budget_replies=[d for d in observed if 'budget_owner' in d['roles']]\\n    budget_authorized=any(d['active'] and d['evidence_valid'] and d.get('budget_evidence_valid',True) and d['outcome']=='approve' for d in budget_replies)\\n    stage('budget_owner_authorization',budget_authorized,budget_view['source_refs']+[r for d in budget_replies for r in d['source_refs']],\\n        '; '.join(dict.fromkeys(d['budget_revalidation_reason'] for d in budget_replies if d.get('budget_revalidation_reason'))) or 'Current discretionary budget-owner authorization required; funds alone are insufficient',\\n        budget_view['owner'],'Supply a current budget-owner response bound to the complete scope ledger and this claim/version')\\n    review_refs=claim_review['source_refs']\\n    reviews_ok=all(claim_review['role_states'].get(role) not in {'missing','conflicting'} for role in claim_review['required_roles']) and all(d['evidence_valid'] for d in observed if d['active'])\\n    stage('review_evidence',reviews_ok,review_refs,\\n          'Current subject/version/role/actor/source/reason and complete review packets; rejected imports remain in history',\\n          lead,'Supply current source-bound replies and complete packets; answer the concrete return repair requests')\\n    stage('required_approvals',approvals,review_refs + policy_refs,\\n          f\\\"Claim approval state: {claim_review['state']}; required roles: {', '.join(claim_review['required_roles'])}\\\",\\n          lead,'Obtain the outstanding current-version human decisions; permit replies never approve a claim')\\n\\n    for reply in observed:\\n        if reply['outcome']=='return' and reply['evidence_valid']:\\n            stage(f\\\"review_return:{reply['decision_id']}\\\",not reply['active'],reply['source_refs'],\\n                  f\\\"{reply['reason']}; repair requested: {reply['repair_requested']}\\\",employee or 'Employee',reply['repair_requested'])\\n\\n    exception_revalidated = not replacement_review or approvals\\n    stage('exception_revalidation', exception_revalidated, evidence_refs + review_refs,\\n          'Replacement amounts require current claim reviews bound to the replacement source version; earlier reviews remain historical',\\n          lead, 'Obtain current revision/source-bound reviews of the Finance replacement amount and a matching reimbursement authorization')\\n\\n    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\\n                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\\n    request = fields(requests[0]) if len(requests) == 1 else {}\\n    obligation = finance.get('recorded_obligation')\\n    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid'] and d['active']}\\n    request_ok = bool(linked and reimbursement_permission and policy_ok and approvals and obligation and len(requests) == 1\\n                      and request.get('Request reference') == obligation['request_id']\\n                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\\n                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['amount_cents']\\n                      and obligation['claim_revision'] == revision and obligation['finance_officer'] ==…15930 tokens truncated…'][0]\\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\\n    assert cancellation['financial_status'] == 'unresolved'\\n\\n\\ndef test_current_review_packet_must_match_current_trip_facts():\\n    parsed = synthetic()\\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\\n    value = workflow(batches(parsed)[-1])\\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\\n    assert value['status'] == 'pending'\\n\\n\\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\\n    parsed = synthetic()\\n    pending = deepcopy(parsed['records']['finance_events'][1])\\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\\n    pending['values']['Activity type']['value'] = 'mystery-pending'\\n    pending['values']['Arrival batch']['value'] = 3\\n    parsed['records']['finance_events'].append(pending)\\n    result = batches(parsed)[-1]\\n    assert workflow(result)['status'] == 'pending'\\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\\n\\n\\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\\n    parsed = synthetic()\\n    conflict = deepcopy(parsed['records']['decisions'][0])\\n    conflict['values']['Outcome']['value'] = 'return'\\n    parsed['records']['decisions'].append(conflict)\\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\\n\\n\\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\\n    parsed = synthetic()\\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\\n    policy['Eligible categories']['value'] = ['lodging']\\n    policy['Uncapped categories']['value'] = []\\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\\n    })\\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\\n    for event in parsed['records']['finance_events']:\\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\\n            if field in event['values']: event['values'][field]['value'] = 40\\n    value = workflow(batches(parsed)[-1])\\n    assert value['lines'][0]['original_cents'] == 10000\\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\\n    assert value['status'] == 'closed-reimbursed'\\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\\n\\n\\ndef test_untrusted_synthetic_threshold_cannot_override_policy_director_threshold():\\n    parsed = synthetic()\\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\\n    value = workflow(batches(parsed)[-1])\\n    assert stages(value)['required_approvals']['status'] == 'PASS'\\n    assert value['status'] == 'closed-reimbursed'\\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\\n\\n\\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\\n    parsed = synthetic()\\n    failed = deepcopy(parsed['records']['finance_events'][1])\\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\\n    failed['values']['Activity type']['value'] = 'failed'\\n    failed['values']['Arrival batch']['value'] = 3\\n    failed['values'].pop('Amount (EUR)', None)\\n    parsed['records']['finance_events'].append(failed)\\n    result = batches(parsed)[-1]\\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\\n    assert workflow(result)['status'] == 'pending'\\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\\n\\n\\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\\n    parsed = synthetic()\\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\\n    duplicate['text'] += '\\\\nSYNTHETIC conflicting evidence'\\n    parsed['records']['claim_revisions'].append(duplicate)\\n    value = workflow(batches(parsed)[-1])\\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\\n    assert value['status'] == 'pending'\\n\\n\\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\\n    parsed = synthetic()\\n    policy = parsed['records']['workflow_policy_rules'][0]\\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\\n\\n\\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\\n    parsed = synthetic()\\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\\n    for source in native_rows:\\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\\n        record = deepcopy(source)\\n        record['source_id'] = 'synthetic-travel-registers-workbook'\\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\\n        record['values']['Trip reference']['value'] = 'T01'\\n        parsed['records']['cancellation_activities'].append(record)\\n    final = batches(parsed)[-1]\\n    value = workflow(final)\\n    assert stages(value)['travel_permission']['status'] == 'BLOCKED'\\n    assert value['permit_approval']['arrangements_at_commitment_supported']\\n    assert value['allowed_cents'] is None\\n    assert value['lines'][0]['calculated_cents'] == 10000\\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\\n    assert value['status'] == 'pending'\\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\\n\\\"\\\"\\\"Correction execution and independent cancellation regression evidence.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport json\\n\\nimport pytest\\n\\nfrom test_ordinary import synthetic, batches, workflow, stages\\nfrom test_retained_finance import _fixture, _batches\\nfrom travel_claim.revalidation import correction_changes, verification_document\\nfrom travel_claim.workflow import reduce_cancellation_activities\\n\\n\\ndef corrected(parsed, *, receipt=None, amount=None):\\n    record = deepcopy(parsed['records']['claim_revisions'][0])\\n    for field in record['fields']:\\n        if field['label'] == 'Revision': field['value'] = '2'\\n        if field['label'] == 'Arrival batch': field['value'] = '3'\\n    record['locator'] = 'SYNTHETIC Step157 correction'\\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\\n    if amount: record['text'] = record['text'].replace('100.00', amount)\\n    parsed['records']['claim_revisions'].append(record)\\n    return record\\n\\n\\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\\n    parsed = synthetic()\\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\\n                       amount='120.00' if change == 'amount' else None)\\n    before, paid, revised, final = batches(parsed)\\n    correction = final['domain']['material_corrections'][0]\\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\\n    assert len(correction['executed_rechecks']) == 2\\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\\n    assert checks['required_approvals']['status'] == 'BLOCKED'\\n    assert checks['request_obligation']['status'] == 'BLOCKED'\\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\\n    assert workflow(paid)['status'] == 'closed-reimbursed'\\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\\n    assert all(c['source_refs'] for c in checks.values())\\n\\n\\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\\n    results = _batches(_fixture()); final = results[-1]\\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\\n    detail = final['domain']['cancellation_evidence']['TC018']\\n    assert detail['current_claim_ids'] == []\\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\\n    assert cancellation['affected_claim_ids'] == ['C18']\\n    assert cancellation['original_request_ids'] == ['REQ-C18']\\n    finance = final['finance_reconciliations']['C18']\\n    assert finance['net_confirmed_cents'] == 10000\\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\\n\\n\\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\\n    final = _batches(_fixture())[-1]\\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\\n    history = final['domain']['cancellation_evidence']['TC122']['history']\\n    assert [h['arrival_batch'] for h in history] == [1, 2]\\n    assert history[0]['actor'] == 'EMP-01'\\n    assert \\\"row 7\\\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\\n\\n\\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\\ndef test_partial_and_independent_permit_cancellation(fault):\\n    parsed = _fixture()\\n    rows = [r for r in parsed['records']['cancellation_activities']\\n            if r['values']['Cancellation reference']['value'] == 'TC121']\\n    parsed['records']['cancellation_activities'] = rows\\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\\n    else:\\n        parsed['records']['claim_revisions'] = []\\n        parsed['records']['finance_events'] = []\\n    final = _batches(parsed)[-1]\\n    process = final['domain']['cancellation_state']['processes']['TC121']\\n    if fault == 'no-claim-permit':\\n        assert process['state'] == 'confirmed'\\n        cancel = final['snapshot']['travel_cancellations'][0]\\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\\n    else:\\n        assert process['state'] != 'confirmed'\\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\\n\\n\\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\\n    parsed = synthetic(); corrected(parsed)\\n    final = batches(parsed)[-1]\\n    data, summary = verification_document(final['domain'], final['snapshot']['travel_cancellations'], run_id='test')\\n    assert data['fresh_native_reads_performed'] is False\\n    assert 'OFFLINE REPLAY' in summary and 'required_approvals | BLOCKED' in summary\\n    assert 'SYNTHETIC Step157 correction' in summary\\n    assert data['corrections'][0]['executed_rechecks']\\n\\n\\ndef test_retained_dispositions_are_exact_revision_bound_observations_not_closure():\\n    final = _batches(_fixture())[-1]\\n    for cancellation_id, claim, revision, amount, page in (\\n            ('TC121', 'C121', 2, '20.00', 'PDF page 6'),\\n            ('TC019', 'C19', 3, '80.00', 'PDF page 7')):\\n        detail = final['domain']['cancellation_evidence'][cancellation_id]\\n        disposition, = detail['dispositions']\\n        assert (disposition['claim_id'], disposition['revision'], disposition['allowed_original_amount']) == (claim, revision, amount)\\n        assert disposition['source_ref'].endswith(page)\\n        assert final['domain']['ordinary_workflows'][claim]['status'] == 'pending'\\n        item = final['domain']['repair_queue']['items'][f'cancellation-financial:{cancellation_id}']\\n        assert item['status'] == 'open'\\n        assert 'disposition recorded' in item['missing_or_return_reason']\\n    assert final['finance_reconciliations']['C19']['net_confirmed_cents'] == 8000\\n    assert final['finance_reconciliations']['C121']['net_confirmed_cents'] == 2000\\n\\\"\\\"\\\"Regression examples transcribed verbatim from the retained native workbook.\\\"\\\"\\\"\\n\\nfrom copy import deepcopy\\nimport json\\nfrom pathlib import Path\\n\\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\\n\\n\\ndef reconcile_finance_events(*args, **kwargs):\\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\\n    return _reconcile(*args, **kwargs)\\nfrom travel_claim.integration import integrate_arrival_batch\\n\\nFIXTURE = Path(__file__).parent / \\\"fixtures/retained_finance_records.json\\\"\\n\\n\\ndef _fixture():\\n    parsed = json.loads(FIXTURE.read_text())\\n    # Exact retained directory records extend the selected-record test fixture.\\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\\n    return parsed\\n\\n\\ndef _batches(parsed):\\n    prior = None\\n    results = []\\n    for batch in parsed['arrival_batches']:\\n        prior = integrate_arrival_batch(\\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\\n            prior_result=prior,\\n        )\\n        results.append(prior)\\n    return results\\n\\n\\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\\n    parsed = _fixture()\\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\\n    results = _batches(parsed)\\n    final = results[-1]\\n    c1 = final['finance_reconciliations']['C01']\\n    obligation = c1['recorded_obligation']\\n    assert obligation['event_id'] == 'F-C01-accepted'\\n    assert obligation['request_id'] == 'REQ-C01'\\n    assert obligation['finance_officer'] == 'FIN-01'\\n    assert obligation['payee_id'] == 'EMP-01'\\n    assert obligation['amount_cents'] == 10000\\n    assert obligation['claim_revision'] is None\\n    assert obligation['arrival_revision_context'] == 1\\n    assert obligation['revision_link_status'] == 'arrival_context_only'\\n    assert obligation['first_arrival_batch'] == 1\\n    assert obligation['source_refs'] == [\\n        'travel-registers-workbook@' + parsed['provenance']['workbook_sha256'] + \\\"#tab 'Finance activity', row 33\\\"\\n    ]\\n    assert obligation['claim_source_refs'][0]['locator'] == 'PDF page 1'\\n    assert c1['net_confirmed_cents'] == 10000  # delivered twice, counted once\\n    assert c1['duplicate_events'][0]['delivery_batches'] == [2, 4]\\n    assert c1['recorded_ledger_balance_cents'] == 0\\n    assert c1['authorized_obligation'] is None\\n    assert c1['balance_cents'] is None\\n    assert c1['closure_authority_confirmed'] is False\\n    projected = next(c for c in final['snapshot']['claims'] if c['claim_id'] == 'C01')\\n    assert projected['finance_evidence']['recorded_ledger_balance_cents'] == 0\\n    assert projected['allowed_cents'] is None and projected['status'] == 'pending'\\n\\n\\ndef test_native_corrections_keep_ledger_history_and_revalidate_authority_only_where_affected():\\n    results = _batches(_fixture())\\n    first, _, third, final = results\\n    initial = deepcopy(first)\\n    c19 = final['finance_reconciliations']['C19']\\n    assert [(r['event_id'], r['amount_cents'], r['arrival_revision_context']) for r in c19['recorded_obligation_history']] == [\\n        ('F-C19-accepted', 10000, 1), ('F-C19-2', 8000, 2), ('F-C19-4', 8000, 3),\\n    ]\\n    assert c19['confirmed_payment_cents'] == 10000\\n    assert c19['confirmed_refund_cents'] == 2000\\n    assert c19['recorded_ledger_balance_cents'] == 0\\n    assert c19['recorded_obligation']['claim_revision'] is None\\n    assert c19['invalidated_previous_reconciliation']['claim_revision'] == 2\\n    assert final['finance_reconciliations']['C09']['recorded_obligation']['arrival_revision_context'] == 2\\n    assert final['finance_reconciliations']['C12']['recorded_obligation']['amount_cents'] == 7000\\n    assert final['finance_reconciliations']['C01']['recorded_obligation'] == first['finance_reconciliations']['C01']['recorded_obligation']\\n    # C18 correction has no newly bound accepted amount. Retain r1 context;\\n    # neither cancellation nor a fresh payment silently reauthorizes revision 2.\\n    c18 = final['finance_reconciliations']['C18']\\n    assert c18['claim_revision'] == 2\\n    assert c18['recorded_obligation']['arrival_revision_context'] == 1\\n    assert c18['authorized_obligation'] is None\\n    assert c18['confirmed_payment_cents'] == 10000\\n    item = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:1']\\n    # Historic question remains historic; r2 has its own current authorization question.\\n    assert item['revision'] == 1\\n    current = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:2']\\n    assert current['source_refs']\\n    assert 'recorded Finance obligation exists' in current['missing_or_return_reason']\\n    assert current['status'] == 'open'\\n    assert first == initial\\n\\n\\ndef test_native_refund_and_finance_cancellation_are_independent_of_business_cancellations():\\n    final = _batches(_fixture())[-1]\\n    cancellations = {c['cancellation_id']: c for c in final['snapshot']['travel_cancellations']}\\n    assert cancellations['TC122']['affected_claim_ids'] == []\\n    assert cancellations['TC122']['target_type'] == 'trip'\\n    assert cancellations['TC121']['target_type'] == 'permit'\\n    assert all(c['financial_status'] == 'unresolved' for c in cancellations.values())\\n    c18 = final['finance_reconciliations']['C18']\\n    assert c18['recorded_obligation']['amount_cents'] == 10000\\n/tmp/step184-start-hashes.json\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4","create_time":1792063089.7127616}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
