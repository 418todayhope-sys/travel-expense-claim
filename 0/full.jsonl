56\\\": hashlib.sha256(first.read_bytes()).hexdigest(),\\n    }\\n    assert \\\"offline-replay-mode\\\" in {row[\\\"record_id\\\"] for row in first_obj[\\\"issues\\\"]}\\n    replay_state = json.loads((run_dir / \\\"offline-replay-state.json\\\").read_text(encoding=\\\"utf-8\\\"))\\n    assert [row[\\\"revision\\\"] for row in replay_state[\\\"revision_history\\\"][\\\"claim\\\"][\\\"C-SYN-RUN\\\"][\\\"revisions\\\"]] == [1, 2]\\n    assert [row[\\\"decision_id\\\"] for row in replay_state[\\\"decision_history\\\"]] == [\\\"D-SYN-RUN-R1\\\"]\\n    assert [row[\\\"values\\\"][\\\"Activity reference\\\"][\\\"value\\\"] for row in replay_state[\\\"source_record_history\\\"][\\\"finance_events\\\"]] == [\\\"F-SYN-RUN-SETTLED\\\"]\\n\\n    with (run_dir / \\\"claims.csv\\\").open(encoding=\\\"utf-8\\\", newline=\\\"\\\") as stream:\\n        rows = list(csv.DictReader(stream))\\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\\n        assert len(rows) == 1\\n\\\"\\\"\\\"Structural workflow tests use conspicuously synthetic records unless noted.\\\"\\\"\\\"\\n\\nimport json\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom travel_claim.outputs import (\\n    add_repair_item,\\n    apply_partial_response,\\n    load_repair_queue,\\n    new_repair_queue,\\n    owner_grouped_view,\\n    update_repair_item,\\n    write_repair_queue,\\n)\\nfrom travel_claim.parsing import parse_retained_run\\nfrom travel_claim.workflow import (\\n    build_revision_history,\\n    deduplicate_activity_records,\\n    match_decisions_to_subjects,\\n    reduce_cancellation_activities,\\n)\\n\\n\\nROOT = Path(__file__).resolve().parents[1]\\nCAPTURE = ROOT / \\\"artifacts/runs/source-capture-20261014T100034Z\\\"\\n\\n\\ndef _claim(claim_id, revision, trip_id=\\\"T-SYN-01\\\", trip_revision=\\\"1\\\", batch=\\\"1\\\"):\\n    return {\\n        \\\"source_id\\\": \\\"synthetic-claims\\\",\\n        \\\"source_sha256\\\": \\\"a\\\" * 64,\\n        \\\"locator\\\": f\\\"synthetic fixture