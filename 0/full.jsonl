re remain pending where unsupported. '\n               'A cancelled transfer is a noncash event; only confirmed payments and linked refunds affect cash.', '']\n     return data, '\\n'.join(lines)\ndiff --git a/tests/test_ordinary.py b/tests/test_ordinary.py\nindex 42ca454..2bc79f0 100644\n--- a/tests/test_ordinary.py\n+++ b/tests/test_ordinary.py\n@@ -93,13 +93,14 @@ def test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_cl\n     assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n     for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation', 'travel_permission', 'required_approvals'):\n         assert checks[name]['status'] == 'PASS'\n-    for name in ('policy_eligibility', 'request_obligation', 'financial_closure'):\n+    assert checks['policy_eligibility']['status'] == 'PASS'\n+    for name in ('request_obligation', 'financial_closure'):\n         assert checks[name]['status'] == 'BLOCKED'\n         assert checks[name]['owner'] and checks[name]['next_action']\n-    assert current['status'] == 'pending' and current['allowed_cents'] is None\n+    assert current['status'] == 'pending' and current['allowed_cents'] == 10000\n     line = current['lines'][0]\n     assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n-    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n+    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] == 10000\n     assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n     assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n     assert len(current['observed_reviews']) == 3\n@@ -138,20 +139,19 @@ def test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_ke\n \n \n @pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n-                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\n+                                  'request', 'request-amount', 'revision', 'clock'])\n def test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n     parsed = synthetic(); records = parsed['records']\n     if missing == 'receipt': records['receipts'] = []\n     elif missing == 'settled-proof':\n         next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n-    elif missing == 'policy': records['workflow_policy_rules'] = []\n-    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n+    elif missing == 'policy': parsed.pop('expense_policy')\n+    elif missing == 'policy-source': parsed['expense_policy']['sha256'] = '0' * 64\n     elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n     elif missing == 'request': records['reimbursement_requests'] = []\n     elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n     elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n-    elif missing == 'closure-authority': records['closure_authorities'] = []\n-    else: parsed['case_clock'] = None\n+    else: parsed['case_clock'] = None; parsed['event_clock'] = None\n     result = batches(parsed)[-1]\n     assert workflow(result)['status'] == 'pending'\n     assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n@@ -283,6 +283,7 @@ def test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_com\n \n def test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n     parsed = synthetic()\n+    parsed.pop('expense_policy')\n     policy = parsed['records']['workflow_policy_rules'][0]\n     policy['source_id'] = 'synthetic-travel-registers-workbook'\n     policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\ndiff --git a/tests/test_retained_finance.py b/tests/test_retained_finance.py\nindex 2a68fd1..586b0cf 100644\n--- a/tests/test_retained_finance.py\n+++ b/tests/test_retained_finance.py\n@@ -87,11 +87,11 @@ def test_native_corrections_keep_ledger_history_and_revalidate_authority_only_wh\n     assert final['finance_reconciliations']['C09']['recorded_obligation']['arrival_revision_context'] == 2\n     assert final['finance_reconciliations']['C12']['recorded_obligation']['amount_cents'] == 7000\n     assert final['finance_reconciliations']['C01']['recorded_obligation'] == first['finance_reconciliations']['C01']['recorded_obligation']\n-    # C18 correction has no newly bound accepted amount. Retain r1 context;\n-    # neither cancellation nor a fresh payment silently reauthorizes revision 2.\n+    # Request-bound Finance cancellation releases the old commitment, preserving\n+    # acceptance history and cash. It supplies no revised entitlement.\n     c18 = final['finance_reconciliations']['C18']\n     assert c18['claim_revision'] == 2\n-    assert c18['recorded_obligation']['arrival_revision_context'] == 1\n+    assert c18['recorded_obligation_history'][0]['arrival_revision_context'] == 1\n     assert c18['authorized_obligation'] is None\n     assert c18['confirmed_payment_cents'] == 10000\n     item = final['domain']['repair_queue']['items']['finance:finance-obligation-missing:C09:1']\n@@ -112,7 +112,8 @@ def test_native_refund_and_finance_cancellation_are_independent_of_business_canc\n     assert cancellations['TC121']['target_type'] == 'permit'\n     assert all(c['financial_status'] == 'unresolved' for c in cancellations.values())\n     c18 = final['finance_reconciliations']['C18']\n-    assert c18['recorded_obligation']['amount_cents'] == 10000\n+    assert c18['recorded_obligation']['amount_cents'] == 0\n+    assert c18['recorded_ledger_balance_cents'] == -10000\n     assert c18['confirmed_refund_cents'] == 0  # cancelled transfer is not a refund\n     c20 = final['finance_reconciliations']['C20']\n     assert c20['recorded_obligation']['amount_cents'] == 10000\n@@ -133,10 +134,12 @@ def test_duplicate_refund_and_accepted_redelivery_keep_identity_and_original_rev\n     parsed['records']['finance_events'].extend([accepted, refund])\n     final = _batches(parsed)[-1]\n     c18 = final['finance_reconciliations']['C18']\n-    assert len(c18['recorded_obligation_history']) == 1\n-    assert c18['recorded_obligation']['delivery_batches'] == [1, 4]\n-    assert c18['recorded_obligation']['arrival_revision_context'] == 1\n-    assert len(c18['recorded_obligation']['source_refs']) == 2\n+    assert len(c18['recorded_obligation_history']) == 2\n+    acceptance=c18['recorded_obligation_history'][0]\n+    assert acceptance['delivery_batches'] == [1, 4]\n+    assert acceptance['arrival_revision_context'] == 1\n+    assert len(acceptance['source_refs']) == 2\n+    assert c18['recorded_obligation']['amount_cents'] == 0\n     assert final['finance_reconciliations']['C20']['confirmed_refund_cents'] == 1000\n \n \n\"\"\"POL-2026.2 financial completion dependencies, separate from event admission.\"\"\"\nfrom datetime import date, datetime\nfrom zoneinfo import ZoneInfo\n\nfrom .event_validation import utc_time\nfrom .finance import _cents\nfrom .workflow import _revision\n\n\ndef supported_clock(parsed):\n    clock = parsed.get('event_clock') or parsed.get('case_clock')\n    try:\n        if isinstance(clock, dict):\n            return date.fromisoformat(clock['date']).isoformat() == clock['date'] and bool(ZoneInfo(clock['timezone']))\n        return isinstance(clock, str) and datetime.fromisoformat(clock.replace('Z', '+00:00')).utcoffset() is not None\n    except (ValueError, TypeError, KeyError):\n        return False\n\n\ndef financial_dependencies(*, finance, revision, allowed, cancellations, review):\n    \"\"\"Require current, admitted, request-bound resolutions; never turn them into cash.\n\n    Native rows lacking explicit revision/resolution links stay unresolved. Arrival\n    revision context is historical evidence, never current human authorization.\n    \"\"\"\n    events = list(finance.get('admitted_events', {}).values())\n    accepted = [e for e in events if e['classification'] == 'obligation_accepted']\n    resolutions = [e for e in events if e['classification'] == 'finance_resolution'\n                   and _revision(e['source_record'].get('Claim revision')) == revision]\n    requirements = []\n    def need(event, reason, cancellation=None, after=None):\n        requirements.append(dict(event_id=event['event_id'], request_id=event['source_record']['Request reference'],\n            reason=reason, cancellation_id=cancellation, after=after or event['source_record']['Activity time (UTC)'],\n            source_ref=event['source_ref']))\n    controls = {'failed_transfer','retry_authorization','finance_cancellation_requested','finance_cancelled','pending_transfer'}\n    for event in events:\n        if event['classification'] in controls:\n            need(event, 'Finance attempt/status requires explicit disposition')\n        if event['classification'] == 'finance_adjustment' and any(\n                p['classification']=='confirmed_payment' and utc_time(p['source_record']['Activity time (UTC)']) <= utc_time(event['source_record']['Activity time (UTC)'])\n                for p in events):\n            need(event, 'Post-payment adjustment requires Finance resolution even if cash matches')\n    contexts = {r['event_id']: r.get('arrival_revision_context') for r in finance.get('recorded_obligation_history', [])}\n    for event in accepted:\n        old = _revision(event['source_record'].get('Claim revision')) or contexts.get(event['event_id'])\n        if old is not None and old != revision or review.get('material_same_revision'):\n            need(event, 'Material correction of an accepted obligation requires current Finance resolution')\n    cancellation_clear = True\n    for cancellation in cancellations:\n        if cancellation['status'] != 'confirmed' or cancellation.get('validation_status','PASS') != 'PASS':\n            cancellation_clear = False\n            continue\n        confirmed = cancellation['confirmed_at']\n        for event in accepted:\n            # Equality cannot prove the pre-acceptance branch. A bound resolution\n            # can resolve it without fabricating an ordering.\n            if utc_time(confirmed) >= utc_time(event['source_record']['Activity time (UTC)']):\n                need(event, 'Cancellation after acceptance/dispatch requires Finance resolution',\n                     cancellation=cancellation['cancellation_id'], after=confirmed)\n    for requirement in requirements:\n        requirement['resolved_by'] = []\n        for resolution in resolutions:\n            value = resolution['source_record']\n            named = set(str(value.get('Resolved activity references') or '').splitlines())\n            cancellations_named = set(str(value.get('Travel cancellation references') or value.get('Travel cancellation reference') or '').splitlines())\n            named_cancel = requirement['cancellation_id'] in (named | cancellations_named)\n            linked = named_cancel if requirement['cancellation_id'] else requirement['event_id'] in named\n            if (linked and value.get('Request reference') == requirement['request_id']\n                    and resolution['obligation_cents'] == allowed\n                    and utc_time(value['Activity time (UTC)']) >= utc_time(requirement['after'])):\n                requirement['resolved_by'].append(resolution['event_id'])\n    return dict(status='PASS' if cancellation_clear and all(r['resolved_by'] for r in requirements) else 'BLOCKED',\n                cancellation_clear=cancellation_clear, requirements=requirements,\n                source_refs=list(dict.fromkeys(f\"{e['source_ref']['source_id']}@{e['source_ref']['source_sha256']}#{e['source_ref']['locator']}\"\n                    for e in events if e['classification'] in controls | {'finance_resolution','finance_adjustment','obligation_accepted'})))\n\n\ndef no_claim_financial_effect_refs(parsed, domain, cancellation, observations, arrival_batch):\n    \"\"\"Prove absence only from a complete, observed four-batch native-shaped package.\n\n    A filtered fixture, missing page, unclassified delivery, known cost or unmatched\n    Finance record cannot establish absence. Blank Trips commitment cells have\n    the explicit policy meaning 'no commitment yet'. No claim is synthesized.\n    \"\"\"\n    from .exceptions import source_bound\n    from .ordinary import fields, ref, table\n    from .expenses import policy_valid\n\n    if (cancellation['affected_claim_ids'] or cancellation['status'] != 'confirmed'\n            or cancellation.get('validation_status') != 'PASS'\n            or not policy_valid(parsed.get('expense_policy')) or not supported_clock(parsed)\n            or parsed.get('arrival_batches') != [1, 2, 3, 4] or arrival_batch != 4\n            or parsed.get('transcription_issues') != []):\n        return []\n    prefix = 'synthetic-' if parsed.get('evidence_mode') == 'synthetic-test' else ''\n    required = {prefix + name for name in ('initial-claim-binder', 'claim-updates-binder',\n                                         'receipt-binder', 'travel-registers-workbook')}\n    inventory = [i for i in parsed.get('source_inventory', []) if i['source_id'] in required]\n    if len(inventory) != 4 or {i['source_id'] for i in inventory} != required:\n        return []\n    refs = []\n    for item in inventory:\n        sid = item['source_id']\n        matches = [o for o in observations if o.get('source_id') == sid]\n        if len(matches) != 1 or matches[0].get('status') != 'read' or matches[0].get('missing_scope'):\n            return []\n        if item['kind'] == 'pdf':\n            rows = [r for r in parsed.get('pdf_pages', []) if r.get('source_id') == sid]\n            if (not rows or len(rows) != item.get('page_count')\n                    or {r.get('page') for r in rows} != set(range(1, len(rows) + 1))\n                    or not all(source_bound(r, observations) for r in rows)):\n                return []\n            refs.extend(ref(r) for r in rows)\n        elif item['kind'] == 'xlsx':\n            sheets = [s for s in parsed.get('workbook_sheets', []) if s.get('source_id') == sid]\n            names = {'People', 'Trips', 'Merchant payments', 'FX', 'Caps', 'Budget',\n                     'Review ledger', 'Review packets', 'Finance activity', 'Travel cancellations'}\n            if (len(sheets) != item.get('sheet_count') or len(sheets) != len(names)\n                    or {s.get('name') for s in sheets} != names\n                    or any(s.get('source_sha256') != matches[0].get('sha256') for s in sheets)):\n                return []\n            refs.append(f\"{sid}@{matches[0]['sha256']}#complete workbook inventory\")\n        else:\n            return []\n    trips = [r for r in table(parsed, 'trips', 'Trips') if fields(r).get('Trip reference') == cancellation['trip_id']\n             and _revision(fields(r).get('Trip revision')) == cancellation['trip_revision']]\n    if (len(trips) != 1 or not source_bound(trips[0], observations)\n            or fields(trips[0]).get('First commitment date') not in (None, '')):\n        return []\n    for key, name in [('receipts', 'Receipts'), ('merchant_payments', 'Merchant payments')]:\n        rows = table(parsed, key, name)\n        if any(not source_bound(r, observations) or not fields(r).get('Trip reference')\n               or fields(r)['Trip reference'] == cancellation['trip_id'] for r in rows):\n            return []\n    claims = domain['revision_history'].get('claim', {})\n    if any(not source_bound(r, observations) or fields(r).get('Claim reference') not in claims for r in domain['finance_records']):\n        return []\n    if any(f.get('unresolved_event_ids') or f.get('conflicting_events') for f in domain['finance_reconciliations'].values()):\n        return []\n    if any(not source_bound(r, observations) or fields(r).get('Claim reference') not in claims for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')):\n        return []\n    return list(dict.fromkeys(refs + [ref(trips[0])] + cancellation['source_refs']))\n\"\"\"POL-2026.2 completion regressions; all changed facts are SYNTHETIC.\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_expenses import setfield\nfrom test_revalidation import corrected\nfrom travel_claim.approvals import table, fields\n\n\ndef activity(p, identity, kind, batch=3, time='2026-09-13T12:00:00', amount=None, obligation=None, revision=1, **extra):\n    event=deepcopy(p['records']['finance_events'][0])\n    for key in ['Amount (EUR)','Obligation (EUR)','Original activity reference']:\n        event['values'].pop(key,None)\n    values={'Activity reference':identity,'Activity type':kind,'Arrival batch':batch,\n            'Activity time (UTC)':time,'Claim revision':revision}\n    if amount is not None:values['Amount (EUR)']=amount\n    if obligation is not None:values['Obligation (EUR)']=obligation\n    values.update(extra)\n    for key,value in values.items():setfield(event,key,value)\n    p['records']['finance_events'].append(event)\n    return event\n\n\ndef cancellation(p, *, confirmation='2026-09-05T12:00:00', amount='100.00', reviews='2026-09-06T12:00:00'):\n    source=json.loads((Path(__file__).parent/'fixtures/retained_finance_records.json').read_text())\n    rows=[deepcopy(r) for r in source['records']['cancellation_activities'] if fields(r).get('Cancellation reference')=='TC018'][:2]\n    for r in rows:\n        r.update(source_id='synthetic-travel-registers-workbook',source_sha256=p['records']['trips'][0]['source_sha256'])\n        action=fields(r)['Action']\n        values={'Cancellation activity reference':'SYN-CANCEL-'+action,'Cancellation reference':'TC-SYN',\n            'Trip reference':'T01','Trip revision':1,'Permit reference':None,'Permit revision':None,\n            'Cancelled subject':'trip','Arrival batch':1 if confirmation<'2026-09-11' else 3,\n            'Acting employee or supervisor':'EMP-01' if action=='requested' else 'SUP-01',\n            'Activity time (UTC)':'2026-09-04T12:00:00' if action=='requested' else confirmation,\n            'Initiation activity reference':None if action=='requested' else 'SYN-CANCEL-requested',\n            'Effective time (UTC)':None if action=='requested' else confirmation}\n        for key,value in values.items():setfield(r,key,value)\n    p['records']['cancellation_activities']=rows\n    claim=p['records']['claim_revisions'][0]\n    for key,value in {'Authorizing Finance officer':'FIN-01','Applies to claim':'SYN-C01','Applies to revision':'1',\n        'Expense reference':'COST-01','Allowed original amount':amount,'Exception reason':'SYNTHETIC cancellation disposition',\n        'Covered issues':'travel_cancellation','Travel cancellation reference':'TC-SYN'}.items():setfield(claim,key,value)\n    for d in p['records']['decisions']:\n        setfield(d,'Decision time (UTC)',reviews)\n        setfield(d,'Arrival batch',1 if confirmation<'2026-09-11' else 4)\n        if confirmation>='2026-09-11':setfield(d,'Source revisions',claim['source_sha256']+'\\nPOL-2026.2')\n    for packet in table(p,'review_packets','Review packets'):setfield(packet,'Travel cancellation references','TC-SYN')\n    setfield(p['records']['reimbursement_requests'][0],'Amount (EUR)',amount)\n    return rows\n\n\ndef test_verified_policy_date_can_close_without_legacy_synthetic_authority_tables():\n    p=synthetic();p['records'].pop('workflow_policy_rules');p['records'].pop('closure_authorities')\n    p['case_clock']=None;p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\n\n\ndef test_supported_personal_zero_closes_without_inventing_finance_request():\n    p=synthetic();setfield(p['records']['receipts'][0],'Category','personal')\n    p['records']['finance_events']=[];p['records']['reimbursement_requests']=[]\n    r=batches(p)[-1];w=workflow(r)\n    assert w['allowed_cents']==0 and w['status']=='closed-no-payment'\n    assert w['request'] is None and w['balance_cents']==0\n    assert r['finance_reconciliations']['SYN-C01']['admitted_events']=={}\n\n\ndef test_correction_after_payment_requires_explicit_finance_resolution_even_at_same_total():\n    p=synthetic();corrected(p)\n    old=deepcopy(p['records']['decisions'])\n    for d in old:\n        setfield(d,'Revision',2);setfield(d,'Arrival batch',3)\n        setfield(d,'Decision reference',fields(d)['Decision reference']+'-r2');setfield(d,'Decision time (UTC)','2026-09-14T12:00:00')\n    packets=deepcopy(table(p,'review_packets','Review packets'))\n    for packet in packets:setfield(packet,'Decision reference',fields(packet)['Decision reference']+'-r2')\n    table(p,'review_packets','Review packets').extend(packets);p['records']['decisions'].extend(old)\n    request=deepcopy(p['records']['reimbursement_requests'][0]);setfield(request,'Revision',2);setfield(request,'Arrival batch',3)\n    setfield(request,'Decision references','\\n'.join(fields(d)['Decision reference'] for d in old))\n    p['records']['reimbursement_requests'].append(request)\n    authority=deepcopy(p['records']['closure_authorities'][0]);setfield(authority,'Revision',2);setfield(authority,'Arrival batch',3)\n    p['records']['closure_authorities'].append(authority)\n    activity(p,'SYN-ADJUST','adjustment',obligation=100,revision=2)\n    result=batches(p)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\n    assert workflow(result)['status']=='pending'\n    activity(p,'SYN-RESOLVE','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,revision=2,\n        **{'Resolved activity references':'F-SYN-C01-accepted\\nSYN-ADJUST'})\n    # Use the actual immutable accepted identity from the synthetic fixture.\n    accepted=next(fields(e)['Activity reference'] for e in p['records']['finance_events'] if fields(e)['Activity type']=='accepted')\n    setfield(p['records']['finance_events'][-1],'Resolved activity references',accepted+'\\nSYN-ADJUST')\n    for d in old:setfield(d,'Arrival batch',4);setfield(d,'Decision time (UTC)','2026-09-14T14:00:00')\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\n\n\ndef test_pre_acceptance_business_cancellation_can_complete_without_extra_resolution():\n    p=synthetic();cancellation(p)\n    result=batches(p)[-1]\n    assert workflow(result)['status']=='closed-reimbursed'\n    assert workflow(result)['permit_approval']['arrangement_authorized'] is False\n    assert result['snapshot']['travel_cancellations'][0]['financial_status']=='resolved'\n\n\ndef test_post_acceptance_cancellation_requires_current_bound_resolution():\n    p=synthetic();cancellation(p,confirmation='2026-09-13T12:00:00',reviews='2026-09-14T14:00:00')\n    assert workflow(batches(p)[-1])['status']=='pending'\n    activity(p,'SYN-CANCEL-RESOLVE','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,\n        **{'Travel cancellation reference':'TC-SYN','Resolved activity references':'F-SYN-C01-accepted'})\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\n\n\ndef test_pre_confirmation_review_packet_is_not_current_cancellation_authority():\n    p=synthetic();cancellation(p,reviews='2026-09-04T13:00:00')\n    r=batches(p)[-1]\n    assert not workflow(r)['claim_approval']['approved']\n    assert workflow(r)['status']=='pending'\n\n\ndef test_pending_transfer_can_be_cleared_only_by_explicit_admitted_resolution():\n    from travel_claim.integration import integrate_arrival_batch\n    def batches(p):\n        prior=None;results=[]\n        for number in p['arrival_batches']:\n            prior=integrate_arrival_batch(p,arrival_batch=number,run_id='synthetic',batch_id=f'arrival-{number:03d}',\n                source_binding={'path':'sources.json','sha256':'a'*64},prior_result=prior,\n                predecessor={'path':'previous.json','sha256':'b'*64} if prior else None,\n                source_observations=p['source_observations'],source_classifications={'synthetic_pending':'pending_transfer'})\n            results.append(prior)\n        return results\n    p=synthetic();activity(p,'SYN-PENDING','synthetic_pending',amount=100)\n    assert workflow(batches(p)[-1])['status']=='pending'\n    activity(p,'SYN-PENDING-RESOLVE','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,\n        **{'Resolved activity references':'SYN-PENDING'})\n    for d in p['records']['decisions']:\n        setfield(d,'Arrival batch',4);setfield(d,'Decision time (UTC)','2026-09-14T14:00:00')\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\n\n\ndef test_request_cancellation_releases_commitment_but_never_refunds_cash():\n    p=synthetic();activity(p,'SYN-REQUEST-CANCEL','cancelled')\n    f=batches(p)[-1]['finance_reconciliations']['SYN-C01']\n    assert f['recorded_obligation']['amount_cents']==0\n    assert f['net_confirmed_cents']==10000 and f['recorded_ledger_balance_cents']==-10000\n\n\ndef test_report_uses_verified_date_precision_instead_of_claiming_missing_clock():\n    from travel_claim.revalidation import verification_document\n    r=batches(synthetic())[-1]\n    _,text=verification_document(r['domain'],[],run_id='synthetic')\n    assert 'authoritative case clock remains unconfirmed' not in text\n\n\ndef test_unverified_finance_obligation_cannot_close_but_cash_is_preserved():\n    p=synthetic()\n    accepted=next(e for e in p['records']['finance_events'] if fields(e)['Activity type']=='accepted')\n    accepted['source_sha256']='0'*64\n    r=batches(p)[-1]\n    assert workflow(r)['status']=='pending'\n    assert r['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\n\n\n@pytest.mark.parametrize('paid,balance', [(40,6000),(120,-2000)])\ndef test_partial_or_excess_payment_never_closes_and_duplicates_do_not_change_cash(paid,balance):\n    p=synthetic()\n    for e in p['records']['finance_events']:\n        if fields(e)['Activity type']=='settled':setfield(e,'Amount (EUR)',paid)\n    if paid>100:\n        for d in p['records']['decisions']:\n            setfield(d,'Arrival batch',3);setfield(d,'Decision time (UTC)','2026-09-14T14:00:00')\n    r=batches(p)[-1];w=workflow(r)\n    assert w['status']=='pending' and w['balance_cents']==balance\n    assert r['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==paid*100\n    assert len(r['finance_reconciliations']['SYN-C01']['confirmed_payment_event_ids'])==1\n\n\ndef test_late_transfer_reopens_closed_case_and_preserves_prior_snapshot():\n    p=synthetic();activity(p,'SYN-LATE','settled',batch=4,time='2026-09-14T12:00:00',amount=10)\n    results=batches(p)\n    assert workflow(results[1])['status']=='closed-reimbursed'\n    assert workflow(results[-1])['status']=='pending'\n    assert results[-1]['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==11000\n    assert results[1]['snapshot']['claims'][0]['paid_cents']==10000\n\n\ndef test_post_payment_zero_adjustment_requires_linked_refund_resolution_and_current_reviews():\n    p=synthetic();setfield(p['records']['receipts'][0],'Category','personal')\n    setfield(p['records']['reimbursement_requests'][0],'Amount (EUR)',0)\n    activity(p,'SYN-ZERO','adjustment',obligation=0)\n    payment=next(fields(e)['Activity reference'] for e in p['records']['finance_events'] if fields(e)['Activity type']=='settled')\n    refund=activity(p,'SYN-REFUND','refund',amount=100,**{'Original activity reference':payment})\n    assert workflow(batches(p)[-1])['status']=='pending'\n    activity(p,'SYN-ZERO-RESOLVE','resolution',batch=4,time='2026-09-14T13:00:00',obligation=0,\n        **{'Resolved activity references':'SYN-ZERO'})\n    for d in p['records']['decisions']:\n        setfield(d,'Arrival batch',4);setfield(d,'Decision time (UTC)','2026-09-14T14:00:00')\n    r=batches(p)[-1]\n    assert workflow(r)['status']=='closed-no-payment'\n    assert r['finance_reconciliations']['SYN-C01']['confirmed_payment_cents']==10000\n    assert r['finance_reconciliations']['SYN-C01']['confirmed_refund_cents']==10000\n    duplicate=deepcopy(refund);setfield(duplicate,'Arrival batch',4);p['records']['finance_events'].append(duplicate)\n    assert workflow(batches(p)[-1])['status']=='closed-no-payment'\n\n\n@pytest.mark.parametrize('change', ['stale','unlinked','wrong-cancellation','early'])\ndef test_cancellation_resolution_must_bind_current_revision_target_and_time(change):\n    p=synthetic();cancellation(p,confirmation='2026-09-13T12:00:00',reviews='2026-09-14T14:00:00')\n    e=activity(p,'SYN-RES','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,\n        **{'Travel cancellation reference':'TC-SYN','Resolved activity references':'F-SYN-C01-accepted'})\n    if change=='stale':setfield(e,'Claim revision',2)\n    if change=='unlinked':setfield(e,'Resolved activity references','unrelated')\n    if change=='wrong-cancellation':setfield(e,'Travel cancellation reference','TC-OTHER')\n    if change=='early':setfield(e,'Activity time (UTC)','2026-09-12T13:00:00')\n    assert workflow(batches(p)[-1])['status']=='pending'\n\n\ndef test_pending_business_cancellation_never_changes_finance_or_establishes_disposition():\n    p=synthetic();rows=cancellation(p);p['records']['cancellation_activities']=rows[:1]\n    r=batches(p)[-1]\n    assert workflow(r)['status']=='pending'\n    assert r['snapshot']['travel_cancellations'][0]['status']=='requested'\n    assert r['finance_reconciliations']['SYN-C01']['recorded_obligation']['amount_cents']==10000\n    assert r['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\n\n\ndef test_cancellation_completion_updates_queue_and_request_projection():\n    p=synthetic();cancellation(p)\n    r=batches(p)[-1]\n    assert r['domain']['repair_queue']['items']['cancellation-financial:TC-SYN']['status']=='resolved'\n    assert r['snapshot']['requests'][0]['status']=='accepted'\n    assert not any(i['status']=='open' and i['item_id'].startswith('ordinary:SYN-C01') for i in r['domain']['repair_queue']['items'].values())\n\n\n@pytest.mark.parametrize('commitment', [None,''])\ndef test_explicit_blank_first_commitment_is_not_a_late_permit(commitment):\n    from travel_claim.exceptions import travel_findings\n    from travel_claim.ordinary import ref\n    p=synthetic();trip=fields(p['records']['trips'][0]);trip.update({'International':True,\n        'Permit reference':'P-SYN','Permit revision':1,'Estimate (EUR)':100,'First commitment date':commitment})\n    decisions=deepcopy(p['records']['decisions'])\n    for d in decisions:\n        setfield(d,'Subject type','permit');setfield(d,'Subject reference','P-SYN')\n    assert travel_findings(trip=trip,employee='EMP-01',decisions=decisions,people=table(p,'people','People'),\n        cancellations=[],fields=fields,ref=ref,observations=p['source_observations'])==[]\n\n\ndef test_confirmation_does_not_reactivate_arrangements_after_reimbursement_completion():\n    p=synthetic();cancellation(p)\n    r=batches(p)[-1];w=workflow(r)\n    assert w['status']=='closed-reimbursed'\n    assert w['permit_approval']['arrangements_at_commitment_supported'] is True\n    assert w['permit_approval']['arrangement_authorized'] is False\n    assert r['domain']['cancellation_state']['processes']['TC-SYN']['state']=='confirmed'\n    assert r['snapshot']['travel_cancellations'][0]['admitted_cancellation_event_ids']==['SYN-CANCEL-requested','SYN-CANCEL-confirmed']\n\n\ndef test_resolution_alone_cannot_recreate_a_cancelled_finance_commitment():\n    p=synthetic();activity(p,'SYN-REQUEST-CANCEL','cancelled')\n    activity(p,'SYN-RESURRECT','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,\n        **{'Resolved activity references':'SYN-REQUEST-CANCEL'})\n    for d in p['records']['decisions']:\n        setfield(d,'Arrival batch',4);setfield(d,'Decision time (UTC)','2026-09-14T14:00:00')\n    r=batches(p)[-1]\n    assert workflow(r)['status']=='pending'\n    assert r['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\n\n    request=next(req for scope in r['domain']['budget']['scopes'].values() for req in scope['requests'].values() if req['request_id']=='REQ-SYN-C01')\n    assert request['commitment_cents']==0\n    assert request['confirmed_payment_cents']==10000\n\n\ndef no_claim_package():\n    \"\"\"Explicitly synthetic complete inventories, never a native acquisition.\"\"\"\n    import hashlib\n    p=synthetic()\n    retained=json.loads((Path(__file__).parent/'fixtures/retained_finance_records.json').read_text())\n    trip=deepcopy(next(r for r in retained['records']['trips'] if fields(r).get('Trip reference')=='T122'))\n    rows=[deepcopy(r) for r in retained['records']['cancellation_activities'] if fields(r).get('Cancellation reference')=='TC122']\n    sid=p['records']['trips'][0]['source_id'];sha=p['records']['trips'][0]['source_sha256']\n    for r in [trip]+rows:r.update(source_id=sid,source_sha256=sha)\n    setfield(trip,'First commitment date',None)\n    p['records']['trips'].append(trip);p['records']['cancellation_activities']=rows\n    p['pdf_pages']=[];p['source_inventory']=[];p['transcription_issues']=[]\n    for name in ['initial-claim-binder','claim-updates-binder','receipt-binder']:\n        source='synthetic-'+name;digest=hashlib.sha256(source.encode()).hexdigest()\n        p['pdf_pages'].append(dict(source_id=source,source_sha256=digest,locator='PDF page 1',page=1,text='SYNTHETIC complete document'))\n        p['source_inventory'].append(dict(source_id=source,kind='pdf',page_count=1))\n        if not any(o['source_id']==source for o in p['source_observations']):p['source_observations'].append(dict(source_id=source,sha256=digest,status='read',missing_scope=[]))\n    for name in ['Trips','Caps','Review ledger','Finance activity','Travel cancellations']:\n        p['workbook_sheets'].append(dict(name=name,records=[]))\n    for sheet in p['workbook_sheets']:sheet.update(source_id=sid,source_sha256=sha)\n    p['source_inventory'].append(dict(source_id=sid,kind='xlsx',sheet_count=10))\n    return p\n\n\ndef test_complete_no_claim_cancellation_can_prove_no_financial_effect_without_inventing_claim():\n    p=no_claim_package();r=batches(p)[-1];c=r['snapshot']['travel_cancellations'][0]\n    assert c['cancellation_id']=='TC122' and c['affected_claim_ids']==[]\n    assert c['financial_status']=='no-financial-effect' and c['next_owner'] is None\n    assert list(r['domain']['ordinary_workflows'])==['SYN-C01']\n    assert workflow(r)['status']=='closed-reimbursed'\n    assert r['domain']['repair_queue']['items']['cancellation-financial:TC122']['status']=='resolved'\n\n\n@pytest.mark.parametrize('missing',['inventory','page','cost','unmatched-finance'])\ndef test_absence_of_claim_alone_never_proves_absence_of_financial_effect(missing):\n    p=no_claim_package()\n    if missing=='inventory':p.pop('source_inventory')\n    if missing=='page':p['pdf_pages'].pop()\n    if missing=='cost':setfield(p['records']['receipts'][0],'Trip reference','T122')\n    if missing=='unmatched-finance':setfield(activity(p,'SYN-UNMATCHED','accepted',obligation=10),'Claim reference','UNKNOWN')\n    c=batches(p)[-1]['snapshot']['travel_cancellations'][0]\n    assert c['financial_status']=='unresolved'\n\n\ndef test_trip_cancellation_projection_preserves_source_associated_permit():\n    p=no_claim_package();r=batches(p)[-1];c=r['snapshot']['travel_cancellations'][0]\n    assert c['target_type']=='trip' and c['trip_id']=='T122'\n    assert c['permit_id']=='P122' and c['permit_revision']==1\n","stderr":"","aggregated_output":"diff --git a/README.md b/README.md\nindex c308f14..57da0ae 100644\n--- a/README.md\n+++ b/README.md\n@@ -111,7 +111,7 @@ Offline replay connects Finance ledger observations to claim IDs and request IDs\n \n The interview's acceptance description is retained at `interviews/project-d-travel-expense-claim-20261013-2210.md:425`; native headers and examples are retained in `Finance activity`, row 5 and rows 23–25/33. Native Finance rows have no claim-revision column. Replay therefore records the source-observed revision context at **first delivery**, leaving the explicit revision null. Redelivery never rebinds an old event to a corrected revision. An explicit `Claim revision` field, if supplied in source records, is checked against retained revision history.\n \n-The sidecar and optional claim `finance_evidence` projection expose recorded obligation history and `recorded_ledger_balance_cents` (recorded obligation minus confirmed net cash for the same request/payee). Adjustments/resolutions record amounts, not additive payment events. Unknown ordering, conflicting events, missing links, or undefined reversal semantics leave the affected ledger difference unresolved. Transfer cancellation does not itself erase the obligation or reverse cash. Corrections preserve historical cash/commitments and reopen revision-dependent review; unrelated claim evidence remains intact.\n+The sidecar and optional claim `finance_evidence` projection expose recorded obligation history and `recorded_ledger_balance_cents` (recorded obligation minus confirmed net cash for the same request/payee). Adjustments record commitment amounts, not additive payments. A resolution must agree with an existing accepted/adjusted commitment; it cannot create or change one. A request-bound Finance cancellation releases that commitment to zero while preserving its history and all cash. Cancellation naming a transfer attempt does not establish release of the request commitment. Unknown ordering, conflicting events, missing links, or undefined reversal semantics leave the affected ledger difference unresolved. Corrections preserve historical cash/commitments and reopen revision-dependent review; unrelated claim evidence remains intact.\n \n This ledger arithmetic is separate from current-revision authorization and reviewed entitlement. Without separately supported authorization, `allowed_cents` and `balance_cents` remain null/blank and claims remain pending. A zero ledger difference does not establish policy eligibility, complete approvals, or closure. The exact CSV header is unchanged; `report.md` explains recorded financial facts separately from unresolved repairs and external blockers.\n \n@@ -392,3 +392,38 @@ separately identified later reply is inadmissible. No cutoff time is inferred.\n These checks do not change Finance event admission, budget accounting, exception\n coverage, cancellation resolution or financial closure rules. Passing source\n admission is not a new human approval or evidence of final submission compliance.\n+\n+## Step 186: financial completion and cancellation dependencies\n+\n+The verified supplemental POL-2026.2 browser policy now supplies the connected\n+workflow's policy definitions and completion conditions directly. Legacy\n+synthetic rule and generic closure-authority tables are not required. The\n+policy's calendar date is sufficient for clock validation; event/review admission\n+still holds ambiguous same-day observations. Native Notion acquisition remains\n+separately blocked and an offline replay never certifies fresh execution.\n+\n+Closure requires current evidence, approvals, request/obligation authorization,\n+balanced admitted net cash and every required Finance resolution. A material\n+correction after acceptance or an adjustment after payment requires an admitted,\n+current-revision resolution naming the affected event/request and agreeing with\n+the supported amount. Partial settlement, overpayment, conflicting deliveri