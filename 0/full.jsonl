 reference') == value['Request reference']\n   292\t                            and event_stamp(event) >= event_stamp(control)):\n   293\t                        resolved_controls.add(control['event_id'])\n   294\t                except (KeyError, ValueError, TypeError, AttributeError):\n   295\t                    pass\n   296\t    controls_clear = not finance['pending_transfer_event_ids'] and all(e['event_id'] in resolved_controls for e in control_events)\n   297\t    cancellation_refs = [source for c in affected for source in c.get(\"source_refs\", [])]\n   298\t    stage('cancellation_readiness', not affected, cancellation_refs,\n   299\t          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\n   300\t          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\n   301\t    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\n   302\t              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\n   303\t    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\n   304\t          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\n   305\t          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\n   145\t    return records\n   146\t\n   147\t\n   148\tdef _value(row: dict[str, Any], key: str) -> Any:\n   149\t    return row.get(\"values\", {}).get(key, {}).get(\"value\")\n   150\t\n   151\t\n   152\tdef parse_retained_run(run_dir: Path, *, output_path: Path | None = None) -> dict[str, Any]:\n   153\t    \"\"\"Parse all readable retained sources after verifying their manifest hashes.\"\"\"\n   154\t    errors = verify_source_manifest(run_dir)\n   155\t    if errors:\n   156\t        raise ValueError(\"Cannot parse unverified retained sources: \" + \"; \".join(errors))\n   157\t    manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n   158\t    read = {row[\"source_id\"]: row for row in manifest[\"files\"] if row[\"status\"] in {\"read\", \"partial\"}}\n   159\t    parsed_sources: list[dict[str, Any]] = []\n   160\t    transcription_issues = []\n   161\t    pages: list[dict[str, Any]] = []\n   162\t    sheets: list[dict[str, Any]] = []\n   163\t    for source_id, meta in read.items():\n   164\t        source_path = run_dir / meta[\"path\"]\n   165\t        if hashlib.sha256(source_path.read_bytes()).hexdigest() != meta[\"sha256\"]:\n   166\t            raise ValueError(f\"Retained-source hash changed during parse: {source_id}\")\n   167\t        try:\n   168\t            if source_path.suffix.lower() == \".pdf\":\n   169\t                extracted = _pdf_pages(source_path, source_id, meta[\"sha256\"])\n   170\t                pages.extend(extracted)\n   171\t                parsed_sources.append({\"source_id\": source_id, \"kind\": \"pdf\", \"page_count\": len(extracted)})\n   172\t            elif source_path.suffix.lower() == \".xlsx\":\n   173\t                extracted_sheets = _workbook_sheets(source_path, source_id, meta[\"sha256\"])\n   174\t                sheets.extend(extracted_sheets)\n   175\t                parsed_sources.append({\"source_id\": source_id, \"kind\": \"xlsx\", \"sheet_count\": len(extracted_sheets)})\n   176\t\n   177\t            elif source_path.suffix.lower() == \".html\":\n   178\t                parsed_sources.append({\"source_id\": source_id, \"kind\": \"html\", \"path\": meta[\"path\"],\n   179\t                    \"sha256\": meta[\"sha256\"], \"status\": meta[\"status\"],\n   180\t                    \"interpretation\": \"Raw HTML retained verbatim; no policy rules inferred or normalized\"})\n   181\t        except Exception as exc:\n   182\t            transcription_issues.append({\"source_id\": source_id, \"source_sha256\": meta[\"sha256\"],\n   183\t                \"path\": meta[\"path\"], \"error\": f\"{type(exc).__name__}: {exc}\",\n   184\t                \"owner\": \"Travel Administration Lead\", \"next_action\": \"Obtain readable native content and retry in a new run\"})\n   185\t\n   186\t    # Preserve separate record categories. These are source transcriptions,\n   187\t    # not assessments; trip and permit revisions remain independent fields.\n   188\t    claim_revisions = [p for p in pages if p[\"claim_id\"]]\n   189\t    receipt_records = _receipt_records(pages)\n   190\t    tab_by_name = {sheet[\"name\"]: sheet for sheet in sheets}\n   191\t    trips = tab_by_name.get(\"Trips\", {}).get(\"records\", [])\n   192\t    decisions = tab_by_name.get(\"Review ledger\", {}).get(\"records\", [])\n   193\t    finance = tab_by_name.get(\"Finance activity\", {}).get(\"records\", [])\n   194\t    cancellations = tab_by_name.get(\"Travel cancellations\", {}).get(\"records\", [])\n   195\t    permits = []\n   196\t    for row in trips:\n   197\t        permit_id = _value(row, \"Permit reference\")\n   198\t        if permit_id:\n   199\t            permits.append({\n   200\t                \"permit_id\": permit_id,\n   201\t                \"trip_id\": _value(row, \"Trip reference\"),\n   202\t                \"trip_revision\": _value(row, \"Trip revision\"),\n   203\t                \"permit_revision\": _value(row, \"Permit revision\"),\n   204\t                \"source_id\": row[\"source_id\"], \"source_sha256\": row[\"source_sha256\"],\n   205\t                \"locator\": row[\"locator\"], \"source_record\": row[\"values\"],\n   175\t        \"\",\n   176\t        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n   177\t        \"\",\n   178\t    ])\n   179\t    return \"\\n\".join(lines)\n   180\t\n   181\t\n   182\tdef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n   183\t    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n   184\t    errors = verify_source_manifest(run_dir)\n   185\t    if errors:\n   186\t        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n   187\t    manifest_path = run_dir / \"sources.json\"\n   188\t    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n   189\t    parsed_path = run_dir / OUTPUT_NAME\n   190\t    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n   191\t    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n   192\t    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n   193\t        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n   194\t    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n   195\t        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n   196\t    batches = parsed.get(\"arrival_batches\")\n   197\t    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n   198\t        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n   199\t    output_paths = {\n   200\t        \"claims\": run_dir / \"claims.csv\",\n   201\t        \"report\": run_dir / \"report.md\",\n   202\t        \"queue\": run_dir / \"repair-queue.json\",\n   203\t        \"state\": run_dir / \"offline-replay-state.json\",\n   204\t        \"drafts\": run_dir / \"follow-up-drafts.md\",\n   205\t        \"workflow\": run_dir / \"ordinary-workflow.json\",\n   206\t        \"demo\": run_dir / \"ordinary-workflow-demo.md\",\n   207\t        \"revalidation\": run_dir / \"correction-cancellation-verification.json\",\n   208\t        \"revalidation_summary\": run_dir / \"correction-cancellation-verification.md\",\n   209\t    }\n   210\t    occupied = [str(path) for path in output_paths.values() if path.exists()]\n   211\t    if occupied:\n   212\t        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n   213\t    batches_dir = run_dir / \"batches\"\n   214\t    if batches_dir.exists() and any(batches_dir.iterdir()):\n   215\t        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n   216\t\n   217\t    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n   218\t    previous: dict[str, Any] | None = None\n     1\t\"\"\"POL-2026.2 expense arithmetic and local-calendar filing checks.\n     2\t\n     3\tThe policy is explicitly bound by its original bytes; this does not convert the\n     4\tuser's browser copy into a successful native Notion capture or grant approval.\n     5\t\"\"\"\n     6\tfrom copy import deepcopy\n     7\tfrom calendar import monthrange\n     8\tfrom datetime import date\n     9\tfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\n    10\timport hashlib\n    11\tfrom pathlib import Path\n    12\t\n    13\tfrom .exceptions import validate_exception, apply_coverage, finding\n    14\t\n    15\tPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\n    16\t\n    17\t\n    18\tdef load_expense_policy(path):\n    19\t    raw = Path(path).read_bytes()\n    20\t    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\n    21\t        raise ValueError('POL-2026.2 browser copy hash mismatch')\n    22\t    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\n    23\t                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\n    24\t\n    25\t\n    26\tdef policy_valid(binding):\n    27\t    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\n    28\t            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\n    29\t            and binding.get('sha256') == POLICY_SHA256)\n    30\t\n    31\t\n    32\tdef local_date(value):\n    33\t    \"\"\"Accept native local dates and Excel's naive midnight date serialization.\"\"\"\n    34\t    text = str(value)\n    35\t    if len(text) == 19 and text.endswith('T00:00:00'):\n    36\t        text = text[:10]\n    37\t    result = date.fromisoformat(text)\n    38\t    if result.isoformat() != text:\n    39\t        raise ValueError('Not a local calendar date')\n    40\t    return result\n    41\t\n    42\t\n    43\tdef filing_deadline(trip_end):\n    44\t    end = local_date(trip_end)\n    45\t    month = end.year * 12 + end.month - 1 + 2\n    46\t    year, zero_month = divmod(month, 12)\n    47\t    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\n    48\t\n    49\t\n    50\tdef number(value):\n    51\t    if isinstance(value, bool) or value is None:\n    52\t        raise ValueError('Missing or invalid number')\n    53\t    result = Decimal(str(value).replace(',', ''))\n    54\t    if not result.is_finite() or result < 0:\n    55\t        raise ValueError('Invalid amount')\n    56\t    return result\n    57\t\n    58\t\n    59\tdef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\n    60\t    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    61\t    binding = parsed.get('expense_policy')\n    62\t    verified = policy_valid(binding)\n    63\t    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    64\t    receipts = parsed.get('records', {}).get('receipts', [])\n    65\t    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    66\t    rates = table(parsed, 'fx_rates', 'FX')\n    67\t    caps = table(parsed, 'caps', 'Caps')\n    68\t    observations = parsed.get('source_observations', []) if observations is None else observations\n    69\t    people = table(parsed, 'people', 'People')\n    70\t    for line in lines:\n    71\t        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n    72\t                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n    73\t        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\n    74\t        line['eligibility_status'] = 'BLOCKED'\n    75\t        exception = validate_exception(record=record, line=line, employee=employee, people=people,\nnl: write error: Broken pipe\n1:# Project D — Travel Expense Claim Interview\n5:## Travel Administration Lead · Travel Administration Lead\n21:We follow policy POL-2026.2, which governs how expenses are reviewed and reimbursed. It outlines separate requirements for international permits and claims, specifies approval roles like the budget owner and supervisor, and sets limits on categories like lodging and meals. You can find all the details in the Travel reimbursement policy.\n465:The main difference is the permit stage. For international trips, you must obtain all necessary approvals before any travel arrangements are made. For domestic travel, that entire permit process is skipped, and you proceed directly to reviewing paid costs and receipts. Did you want to explore the specific approval requirements for international permits?\n792:No, core evidence such as a receipt or settled merchant 