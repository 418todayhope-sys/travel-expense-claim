4T10:01:34Z', 'version': 'Wed, 14 Oct 2026 10:01:32 GMT', 'scope': 'Travel registers workbook', 'missing_scope': []}]\ndict_keys(['claim_revisions', 'receipts', 'trips', 'decisions', 'finance_events', 'cancellation_activities'])\ndict_keys(['claim_revisions', 'trips', 'permits', 'receipts', 'decisions', 'finance_events', 'cancellation_activities'])\n{'permit_id': 'P02', 'trip_id': 'T02', 'trip_revision': 1.0, 'permit_revision': 1.0, 'source_id': 'travel-registers-workbook', 'source_sha256': '3cf8b225b20b9ac99b8d493b14a95fdde261d677aab77daaf399a37fb4dcef2f', 'locator': \"tab 'Trips', row 7\", 'source_record': {'Trip reference': {'value': 'T02', 'source_text': 'T02', 'number_format': 'General', 'data_type': 's', 'cell': 'A7'}, 'Employee ID': {'value': 'EMP-01', 'source_text': 'EMP-01', 'number_format': 'General', 'data_type': 's', 'cell': 'B7'}, 'Destination': {'value': 'US', 'source_text': 'US', 'number_format': 'General', 'data_type': 's', 'cell': 'C7'}, 'International': {'value': True, 'source_text': 'True', 'number_format': 'General', 'data_type': 'b', 'cell': 'D7'}, 'Start date': {'value': '2026-09-02T00:00:00', 'source_text': '2026-09-02 00:00:00', 'number_format': 'yyyy-mm-dd', 'data_type': 'd', 'cell': 'E7'}, 'End date': {'value': '2026-09-05T00:00:00', 'source_text': '2026-09-05 00:00:00', 'number_format': 'yyyy-mm-dd', 'data_type': 'd', 'cell': 'F7'}, 'First commitment date': {'value': '2026-09-01T00:00:00', 'source_text': '2026-09-01 00:00:00', 'number_format': 'yyyy-mm-dd', 'data_type': 'd', 'cell': 'G7'}, 'Estimate (EUR)': {'value': 1100.0, 'source_text': '1100.0', 'number_format': '#,##0.00', 'data_type': 'n', 'cell': 'H7'}, 'Business purpose': {'value': 'Client workshop and delivery planning', 'source_text': 'Client workshop and delivery planning', 'number_format': 'General', 'data_type': 's', 'cell': 'I7'}, 'Client': {'value': 'Client-A', 'source_text': 'Client-A', 'number_format': 'General', 'data_type': 's', 'cell': 'J7'}, 'Schedule coverage': {'value': 'Team colleague covers routine support', 'source_text': 'Team colleague covers routine support', 'number_format': 'General', 'data_type': 's', 'cell': 'K7'}, 'Alternatives considered': {'value': 'Remote participation considered; onsite workshop requested', 'source_text': 'Remote participation considered; onsite workshop requested', 'number_format': 'General', 'data_type': 's', 'cell': 'L7'}, 'Permit reference': {'value': 'P02', 'source_text': 'P02', 'number_format': 'General', 'data_type': 's', 'cell': 'M7'}, 'Trip revision': {'value': 1.0, 'source_text': '1.0', 'number_format': '0', 'data_type': 'n', 'cell': 'N7'}, 'Permit revision': {'value': 1.0, 'source_text': '1.0', 'number_format': '0', 'data_type': 'n', 'cell': 'O7'}}}\n{'Decision reference': 'D-C02-1-permit-administration-1', 'Arrival batch': 1.0, 'Subject type': 'permit', 'Subject reference': 'P02', 'Revision': 1.0, 'Review roles': 'administration', 'Reviewer': 'ADMIN-01', 'Outcome': 'approve', 'Reason': 'Business purpose, evidence and review packet accepted.', 'Source revisions': 'DW-D-2\\nPOL-2026.2\\nSRC-D-3', 'Affected fields': 'trip\\namount\\nevidence', 'Decision time (UTC)': '2026-08-31T12:00:00'}\nAdministration checks identity, receipt/paid proof, trip/permit, category, deadline, rates/caps, prior cost obligations and calculated amount. Budget review receives the whole department/project/period ledger: allocation less net settled expenditure less remaining commitments. A commitment includes its settled portion; do not subtract the full commitment and its settled portion again. Include prior obligations outside the current batch and all accepted new requests. Adequate funds alone are not a budget approval. Supervisor considers business purpose, client commitment, schedule coverage and permit consistency. Director considers high spend, the documented exception, alternatives and budget-owner position. Reviewers may approve, return with a concrete repair request, or reject with a reason; their discretionary judgment is supplied by the scenario, not performed by the learner.\n\nRequests and replies identify subject type, subject ID/revision, role(s), stable actor, relevant source versions and reason. Consume only the trainer-supplied decision batches and the directory's applicable actor/roles. Missing responses for otherwise complete requests wait; missing policy/input definitions are package defects. Reject wrong-role, stale-version or wrong-subject replies for current authorization. Keep rejected imports visible. A return reopens the appropriate review; explicit rejection or clean withdrawal can close with a non-payment reason.\n\nA material change to employee, trip, dates, money, policy/evidence or authority invalidates dependent review, approvals and payment readiness even if the total is unchanged. Full recheck and justified dependency recheck are both valid. Preserve old versions and decisions as history. Before dispatch, rebuild readiness from current facts. After dispatch, hold replacement requests until Finance confirms cancellation/status. Pending cancellation is not confirmed cancellation. Withdrawal never erases an actual payment.\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n            event_context=finance_context(parsed, record_set[\"revisions\"], domain[\"finance_records\"], claim_id, arrival_batch),\n        )\n        workflow = connect_claim(parsed=parsed, claim=claim_revision, decisions=domain[\"decision_records\"],\n            finance_events=domain[\"finance_records\"], finance=finance_results[claim_id],\n            cancellations=cancellation_rows, arrival_batch=arrival_batch,\n            source_observations=source_observations or [], prior_finance=prior_finance,\n            source_classifications=domain[\"source_classifications\"])\n        finance_results[claim_id] = workflow.pop(\"finance\")\n        domain[\"ordinary_workflows\"][claim_id] = workflow\n        domain[\"ordinary_workflow_history\"].append({\"batch_id\": batch_id, \"workflow\": deepcopy(workflow)})\n    domain[\"finance_reconciliations\"] = finance_results\n    record_executed_rechecks(domain, before_batch, batch_id=batch_id)\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n    # deliberately remain outside any fabricated claim/decision outcome.\n    blockers = []\n\"\"\"Correction execution and independent cancellation regression evidence.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_retained_finance import _fixture, _batches\nfrom travel_claim.revalidation import correction_changes, verification_document\nfrom travel_claim.workflow import reduce_cancellation_activities\n\n\ndef corrected(parsed, *, receipt=None, amount=None):\n    record = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in record['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    record['locator'] = 'SYNTHETIC Step157 correction'\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\n    if amount: record['text'] = record['text'].replace('100.00', amount)\n    parsed['records']['claim_revisions'].append(record)\n    return record\n\n\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\n    parsed = synthetic()\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\n                       amount='120.00' if change == 'amount' else None)\n    before, paid, revised, final = batches(parsed)\n    correction = final['domain']['material_corrections'][0]\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\n    assert len(correction['executed_rechecks']) == 2\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\n    assert checks['required_approvals']['status'] == 'BLOCKED'\n    assert checks['request_obligation']['status'] == 'BLOCKED'\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert workflow(paid)['status'] == 'closed-reimbursed'\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\n    assert all(c['source_refs'] for c in checks.values())\n\n\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\n    results = _batches(_fixture()); final = results[-1]\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\n    detail = final['domain']['cancellation_evidence']['TC018']\n    assert detail['current_claim_ids'] == []\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\n    assert cancellation['affected_claim_ids'] == ['C18']\n    assert cancellation['original_request_ids'] == ['REQ-C18']\n    finance = final['finance_reconciliations']['C18']\n    assert finance['net_confirmed_cents'] == 10000\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\n\n\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\n    final = _batches(_fixture())[-1]\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\n    history = final['domain']['cancellation_evidence']['TC122']['history']\n    assert [h['arrival_batch'] for h in history] == [1, 2]\n    assert history[0]['actor'] == 'EMP-01'\n    assert \"row 7\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\n\n\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\ndef test_partial_and_independent_permit_cancellation(fault):\n    parsed = _fixture()\n    rows = [r for r in parsed['records']['cancellation_activities']\n            if r['values']['Cancellation reference']['value'] == 'TC121']\n    parsed['records']['cancellation_activities'] = rows\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\n    else:\n        parsed['records']['claim_revisions'] = []\n        parsed['records']['finance_events'] = []\n    final = _batches(parsed)[-1]\n    process = final['domain']['cancellation_state']['processes']['TC121']\n    if fault == 'no-claim-permit':\n        assert process['state'] == 'confirmed'\n        cancel = final['snapshot']['travel_cancellations'][0]\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\n    else:\n        assert process['state'] != 'confirmed'\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\n\n\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\n    parsed = synthetic(); corrected(parsed)\n    final = batches(parsed)[-1]\n","stderr":"","aggregated_output":"dict_keys(['evidence_mode', 'case_clock', 'arrival_batches', 'unresolved_issues', 'source_observations', 'records', 'workbook_sheets'])\n[{'source_id': 'policy-pol-2026-2', 'path': None, 'sha256': None, 'status': 'unavailable', 'error': 'HTTP response contained a generic Notion shell; policy page content was not accessible', 'url': 'https://private-pecorino-70e.notion.site/REDACTED', 'locator': 'Notion policy page body', 'observed_at': '2026-10-14T10:01:29Z', 'version': None, 'scope': 'Travel reimbursement policy POL-2026.2', 'missing_scope': ['Travel reimbursement policy POL-2026.2']}, {'source_id': 'initial-claim-binder', 'path': 'sources/initial-claim-binder.pdf', 'sha256': 'b42a28754b1877363e1a25ed4fa1f3865915f44ec9995f7ed15fc9b6eefb08b7', 'status': 'read', 'error': None, 'url': 'https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view', 'locator': 'Complete PDF document', 'observed_at': '2026-10-14T10:01:30Z', 'version': 'Sat, 12 Sep 2026 02:56:31 GMT', 'scope': 'Initial claim binder', 'missing_scope': []}, {'source_id': 'claim-updates-binder', 'path': 'sources/claim-updates-binder.pdf', 'sha256': '03c15787d18e2928457cd0164b573dc03a3baade0ed26a391ba79c73a568da3b', 'status': 'read', 'error': None, 'url': 'https://drive.google.com/file/d/REDACTED/view', 'locator': 'Complete PDF document', 'observed_at': '2026-10-14T10:01:31Z', 've