laims\"]:\n    86\t            for line in claim[\"lines\"]:\n    87\t                missing_sources = set(line[\"source_ids\"]) - retained_ids\n    88\t                if missing_sources:\n    89\t                    errors.append(\n    90\t                        f\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\"\n    91\t                    )\n    92\t    except (OSError, json.JSONDecodeError, ValueError):\n    93\t        manifest = {}\n    94\t    source_binding = snapshot[\"source_binding\"]\n    95\t    source_path = run_dir / source_binding[\"path\"]\n    96\t    if not source_path.resolve().is_relative_to(run_dir.resolve()):\n    97\t        errors.append(\"source_binding path escapes the run directory\")\n    98\t        return errors\n    99\t    if source_path.resolve() != (run_dir / \"sources.json\").resolve():\n   100\t        errors.append(\"source_binding must identify this run's sources.json\")\n   101\t        return errors\n   102\t    try:\n   103\t        actual = sha256_bytes(source_path.read_bytes())\n   104\t    except OSError as exc:\n   105\t        errors.append(f\"Cannot read bound sources file {source_binding['path']}: {exc}\")\n   106\t    else:\n   107\t        if actual != source_binding[\"sha256\"]:\n   108\t            errors.append(\"source_binding SHA-256 does not match retained sources.json\")\n   109\t    predecessor = snapshot[\"predecessor\"]\n   110\t    if predecessor is not None:\n   111\t        previous_path = run_dir / predecessor[\"path\"]\n   112\t        if not previous_path.resolve().is_relative_to((run_dir / \"batches\").resolve()):\n   113\t            errors.append(\"predecessor path escapes the run's batches directory\")\n   114\t            return errors\n   115\t        try:\n   116\t            actual = sha256_bytes(previous_path.read_bytes())\n   117\t        except OSError as exc:\n   118\t            errors.append(f\"Cannot read predecessor {predecessor['path']}: {exc}\")\n   119\t        else:\n   120\t            if actual != predecessor[\"sha256\"]:\n   121\t                errors.append(\"predecessor SHA-256 does not match retained snapshot\")\n   122\t            else:\n   123\t                errors.extend(\n   124\t                    f\"predecessor chain: {error}\"\n   125\t                    for error in _verify_snapshot(previous_path, run_dir, schema_path, seen_paths)\n   126\t                )\n   127\t    return errors\n   128\t\n   129\t\n   130\tdef seal_batch_snapshot(\n   131\t    run_dir: Path,\n   132\t    *,\n   133\t    run_id: str,\n   134\t    batch_id: str,\n   135\t    claims: list[dict],\n    30\t| [POL-2026.2-browser-copy.txt:17](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:17) | Material corrections and dispatch/replacement readiness | **Partial; affected authority gaps** | All current ordinary/Finance checks rerun after revision increases with before/after audit and historical decisions retained. However inherited checks omit deadlines, exceptions, budget and cancellation-aware approvals. The audit trigger is revision increase; changed source authority under an unchanged claim revision is not independently represented as correction history. No dispatched/replacement-request state machine waits for explicit Finance status. [integration.py:212](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:212); [revalidation.py:26](/home/maxg/travel-expense-claim/src/travel_claim/revalidation.py:26); [integration.py:725](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:725). | [test_revalidation.py:25](/home/maxg/travel-expense-claim/tests/test_revalidation.py:25) covers stale approvals/receipt/amount changes; add source-policy/authority-only change and before/after-dispatch replacement holds. |\n    31\t| [POL-2026.2-browser-copy.txt:19](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:19) | Stable requests, shared/prepaid costs, linked adjustments | **Major missing cross-claim ledger** | Recorded request IDs and historical obligations are retained, but formal request linkage requires a separate normalized request record and explicit Finance claim revision absent from native headers. There is no cross-claim cost obligation index or subtraction of already committed/settled cost. C24 update page 3 reuses COST-03 and adds COST-24; this is a retained regression candidate, not a new entitlement result. [ordinary.py:250](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:250); [finance.py:94](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:94). | [test_retained_finance.py:31](/home/maxg/travel-expense-claim/tests/test_retained_finance.py:31) covers ledger observations only. Add shared cost C03/C24, stable request redelivery, original request/cost/claim adjustment links and no duplicate reimbursement. |\n    32\t| [POL-2026.2-browser-copy.txt:21](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:21) | Finance event admission, failed/retry authorization and immutable conflicts | **Critical defects** | Cash admission checks EUR and exact nonnegative cents, but does not require a valid request, payee, directory Finance actor or event time; zero cash is allowed. Conflict recomputation excludes all occurrences including already admitted payments, reducing synthetic prior net cash 1000 to 0. Native retry-authorized events are classified but new attempts are not validated against them. [finance.py:177](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:177); [finance.py:239](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:239); [finance.py:268](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:268). | [test_finance.py:85](/home/maxg/travel-expense-claim/tests/test_finance.py:85) currently asserts zero cash for a conflict; distinguish first-seen conflicted event from a later conflicting redelivery of admitted money. Existing synthetic payment tests omit mandatory authority fields. |\n    33\t| [POL-2026.2-browser-copy.txt:21](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:21) | Confirmed refunds and unrecovered transfer amount | **Partial** | Only supplied refund events change cash; linked original payment and aggregate upper bound exist. Refund request/payee/actor/time are not independently validated, and no chronological admission ledger preserves an already admitted refund when later invalid refund candidates exceed the original. [finance.py:274](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:274). | [test_finance.py:107](/home/maxg/travel-expense-claim/tests/test_finance.py:107) covers orphan/over-refund and [test_retained_finance.py:111](/home/maxg/travel-expense-claim/tests/test_retained_finance.py:111) duplicate refund. Add wrong payee/request/actor/time, sequential remaining-recoverable limit and preservation of earlier admitted refunds. |\n    34\t| [POL-2026.2-browser-copy.txt:23](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:23) | Balance, overpayment, partial settlement and financial closure | **Partial; excessive and missing gates** | Authorized obligation minus net paid exists, including negative balances; incomplete/unclassified events hold. Closure demands extra per-claim closure_authorities and an exact timestamp, which this policy does not require as separate blanket documents. It also holds every linked cancellation permanently, even after a possible valid disposition, and generic failed/cancelled controls require synthetic resolved-ID fields. Conversely correction after acceptance/payment does not universally require explicit current Finance resolution unless it happens to be a listed control event. [finance.py:365](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:365); [ordinary.py:277](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:277); [ordinary.py:294](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:294). | [test_ordinary.py:108](/home/maxg/travel-expense-claim/tests/test_ordinary.py:108) closes only a synthetic extra-authority path. Add policy-native closure, overpayment repair, partial settlement, negative balance, correction/post-payment resolution, late transfer reopening and no-payment closure. |\n    35\t| [POL-2026.2-browser-copy.txt:25](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:25) | Independent progress, human authority and imported instructions as data | **Mostly covered; incomplete-policy caveat** | Integration processes claims independently and preserves owner-specific repairs. It does not send drafts, book travel or create human decisions. Imported text is transcribed data rather than execution permission. Passing local stages must not be advertised as full policy compliance while these gaps exist. [integration.py:588](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:588); [live_run.py:44](/home/maxg/travel-expense-claim/src/travel_claim/live_run.py:44). | [test_ordinary.py:181](/home/maxg/travel-expense-claim/tests/test_ordinary.py:181) checks unaffected claim closure; add malicious imported comment/receipt text and all-policy readiness reporting. |\n    36\t| [POL-2026.2-browser-copy.txt:27](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:27) | Cancellation actors, exact targets, initiation and strict times | **Critical defects** | Reducer admits structural confirmation before integration checks actors; wrong actor can remain confirmed in snapshot. It does not enforce no initiation/effective fields on request, full associated trip+permit target equality (trip-target projections also null the associated permit fields), strictly-later confirmation or effective==occurrence. Equal times and scheduled effective times pass synthetic probes. Blank commitment is not implemented as explicit no-commitment. [workflow.py:216](/home/maxg/travel-expense-claim/src/travel_claim/workflow.py:216); [workflow.py:247](/home/maxg/travel-expense-claim/src/travel_claim/workflow.py:247); [integration.py:371](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:371); [integration.py:417](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:417). | [test_revalidation.py:75](/home/maxg/travel-expense-claim/tests/test_revalidation.py:75) covers orphan/missing-effective/backward time but not equal time, scheduled/backdated effective, wrong actor or complete target tuples. |\n    37\t| [POL-2026.2-browser-copy.txt:29](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:29) | Arrival dependency recheck, conflicting redelivery and authority retirement | **Critical/missing lifecycle behavior** | Sorting by arrival batch then row causes a confirmation before its request in row/delivery order to remain unresolved even after the initiation is present. Conflicting IDs are excluded wholesale, so prior admitted history can disappear. No active/retired travel-authority state prevents old approval replies or later claim versions restoring permission; current versus historical claim linkage alone is insufficient. Future observations have no case-date cutoff. [workflow.py:169](/home/maxg/travel-expense-claim/src/travel_claim/workflow.py:169); [workflow.py:200](/home/maxg/travel-expense-claim/src/travel_claim/workflow.py:200); [workflow.py:234](/home/maxg/travel-expense-claim/src/travel_claim/workflow.py:234); [ordinary.py:94](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:94). | [test_workflow_structure.py:111](/home/maxg/travel-expense-claim/tests/test_workflow_structure.py:111) and [test_revalidation.py:63](/home/maxg/travel-expense-claim/tests/test_revalidation.py:63) cover structural lifecycle/dedup. Add deferred reference resolution, stale targets, future observations, process action conflicts and trip-versus-permit retirement/renewal. |\n    38\t| [POL-2026.2-browser-copy.txt:31](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:31) | Requested holds, no-financial-effect and cancellation-aware eligibility/reviews | **Major missing semantics** | Linked payment readiness holds, but new-arrangement pause is not modeled. Every process is projected financial_status=unresolved; supported no-cost/no-obligation processes cannot resolve to no-financial-effect. Cancellation exceptions are observed without covered-issue validation/application. Packet Travel cancellation references is present in retained evidence but ignored by current review checks. Existing lawful arrangements must not gain permit_unapproved solely from later cancellation. [integration.py:330](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:330); [integration.py:380](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:380); [integration.py:391](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:391); [ordinary.py:220](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:220). | [test_revalidation.py:63](/home/maxg/travel-expense-claim/tests/test_revalidation.py:63) currently expects an unresolved no-claim process; absence of a claim alone is not proof of no financial effect. Add scoped disposition coverage, post-confirmation packets, preserved planned end/initial filings and same-day ambiguity. |\n    39\t| [POL-2026.2-browser-copy.txt:33](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:33) | Pre-acceptance versus post-acceptance/payment cancellation | **Major lifecycle over-hold and missing resolution linkage** | Ordinary closure rejects any affected cancellation, regardless of timing/disposition. Policy permits pre-acceptance cancellation with bound disposition and fresh cancellation-aware reviews without a separate Finance resolution event. Post-acceptance/payment requires explicit resolution while preserving original obligations and observing late money; business confirmation cannot release commitment. Current Finance-cancelled classification does not update an accepted-commitment state, and financial_status never becomes resolved. [ordinary.py:309](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:309); [integration.py:380](/home/maxg/travel-expense-claim/src/travel_claim/integration.py:380); [finance.py:81](/home/maxg/travel-expense-claim/src/travel_claim/finance.py:81). | [test_retained_finance.py:95](/home/maxg/travel-expense-claim/tests/test_retained_finance.py:95) distinguishes transfer cancellation/refund and [test_revalidation.py:108](/home/maxg/travel-expense-claim/tests/test_revalidation.py:108) retains dispositions; add both timing branches, original-request late transfer, post-payment refund/resolution agreement and eventual supported cancellation closure. |\n    40\t\n    41\t## Prioritized findings\n    42\t\n    43\t1. **Admission/history defects:** prevent unsupported Finance money and wrong-actor/invalid-time cancellation admission; preserve previously admitted money and process history on conflicting redelivery. These are correctness defects, not newly missing human approvals.\n    44\t2. **Policy calculations:** implement native category/personal-zero behavior, integer cap units, EUR=1, line half-up FX, date-based deadlines and scoped Finance exceptions. Budget accounting and shared-cost/prepayment exclusion are missing.\n    45\t3. **Authority/lifecycle:** validate complete review packets/source versions, permit director/combined-role rules, returns/rejections/withdrawals, dispatch/replacement holds and cancellation authority retirement. Add the separate pre-/post-acceptance cancellation resolution paths.\n    46\t4. **Source/clock integration:** retain user-copy provenance and derive reviewed policy definitions without masquerading as native HTTP content; represent date+zone without invented time. Revisit extra exact-clock/per-claim closure-authority gates now that policy completion conditions are supplied.\n    47\t\n    48\t## Resolved knowledge blockers versus remaining evidence\n    49\t\n    50\t**Resolved for this audit:** the exact supplied policy wording and POL-2026.2 identifier; policy definition of category eligibility, amounts/caps/FX, roles/threshold, filing, correction, money and cancellation rules; the authoritative case date and timezone; the general financial-completion rule. The earlier “policy unknown” and “clock completely unknown” descriptions are historical evidence, not current audit findings. No earlier run is retroactively reclassified.\n    51\t**Still not established:** a fresh programmatic native Notion read and independent remote completeness; a provenance-aware adapter linking this browser copy to future runs; implementation coverage; any missing claim-specific receipt/payment/rate/cap/role/review/exception/status/refund/resolution evidence; discretionary human decisions; timing only where actually material. Do not demand a separate generic facilitator closure approval or fabricated timestamp merely because the old synthetic implementation expects those fields.\n    52\t**Concrete retained cases (observations, not new closure decisions):**\n    53\t- C121: claim-updates-binder PDF page 6 contains the TC121-bound Finance exception; Review ledger/Review packets rows 307–309 contain r2 reviews with TC121 context; Travel cancellations rows 8–9 show the permit process; Finance activity row 224 first accepts REQ-C121 on 2026-09-13 and row 225 settles on 2026-09-14, after the 2026-09-12 confirmation. This is the policy line-33 pre-acceptance branch candidate. Absence of a separate resolution event is not automatically an external defect for that branch; full source validation and the other policy checks still remain.\n    54\t- C19: claim-updates-binder PDF page 7 and Review ledger/Review packets rows 310–312 contain current TC019 disposition/context. Finance activity rows 44, 22–25 retain acceptance, payment, adjustment, linked refund and resolution. Those observations exist and must be semantically validated, not replaced by invented new approvals/events.\n    55\t- C18: claim-updates-binder PDF page 4 reassigns T18 to T18B. Review ledger contains r1 decisions at rows 47–49 but no C18 r2 claim decisions in the retained input. Current r2 reviews are an independent missing scenario input; old-trip Finance request REQ-C18 and late payment must remain observable. Do not let the historical cancellation retire the different T18B travel basis.\n    56\t- Source anchors above refer to `artifacts/runs/project-d-live-20261014T204849Z/parsed-records.json` and its byte-bound PDFs/XLSX in `sources/`; workbook SHA-256 `3cf8b225b20b9ac99b8d493b14a95fdde261d677aab77daaf399a37fb4dcef2f`. The audit does not change existing allowed/paid/balance/status projections.\n    57\t\n    58\t## Validation and preservation\n    59\t\n    60\t- **131 existing tests passed in 23.34 seconds; `git diff --check` passed.** Tests were rerun unchanged. Passing existing tests does not establish compliance with the recovered policy; several synthetic fixtures deliberately omit newly grounded mandatory fields, and the conflict test currently codifies blanket cash exclusion.\n    61\t- Nine read-only synthetic diagnostic probes are retained in `artifacts/verification/project-d-step167-audit-probes.json`; they do not represent real claims or new automated regression tests. No implementation or test files were edited.\n    62\t- **All 120 pre-audit files are verified byte-for-byte unchanged**, including raw policy bytes, all earlier artifact bytes and the original interview. Tracked implementation and staging area have no changes. No new live capture, replay, financial projection, commit or push is performed.\n    63\t\n    64\tStop point: evidence audit complete. Findings require a separately authorized implementation milestone; no fixes applied here.\n22:    \"failed\": \"failed_transfer\",\n23:    \"retry_authorized\": \"retry_authorization\",\n29:    \"resolution\": \"finance_resolution\",\n82:        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n174:            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n176:            \"finance_adjustment\", \"finance_resolution\",\n","exit_code":0,"duration":{"secs":0,"nanos":37218093},"formatted_output":"    48\t                            values={k:v for k,v in value.items() if k not in {'Arrival batch', 'Status', 'Claim reason'}}))\n    49\t    return hashlib.sha256(json.dumps(dict(rows=content, amount=amount), sort_keys=True, default=str).encode()).hexdigest()\n    50\t\n    51\t\n    52\tdef evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employee,\n    53\t                     subject_record, amount_cents, decisions, arrival_batch, observations,\n    54\t                     cost_ids=(), prior=None, dependency_rows=(), withdrawn=False, cancellation_ids=(), budget_context=None):\n    55\t    \"\"\"Evaluate supplied replies only. Invalid/stale imports stay in deliveries.\"\"\"\n    56\t    trip=fields(trip_record); policy=policy_valid(parsed.get('expense_policy'))\n    57\t    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==employee]\n    58\t    person=fields(people[0]) if len(people)==1 else {}\n    59\t    packets=table(parsed,'review_packets','Review packets')\n    60\t    required=['administration','budget_owner','supervisor']\n    61\t    amount_known=isinstance(amount_cents,int) and not isinstance(amount_cents,bool) and amount_cents>=0\n    62\t    if amount_known and amount_cents>100000: required.append('director')\n    63\t    basis_rows=[subject_record,trip_record]+people+list(dependency_rows)\n    64\t    digest=evidence_digest(basis_rows,dict(amount_cents=amount_cents,cost_ids=sorted(cost_ids) if kind=='claim' else [],cancellation_ids=sorted(cancellation_ids)))\n    65\t    material_same_revision=bool(prior and prior.get('revision')==revision and\n    66\t        (prior.get('evidence_digest')!=digest or prior.get('material_same_revision')))\n    67\t    invalidated_batch=(prior.get('invalidated_batch') if prior and prior.get('material_same_revision') and prior.get('revision')==revision else arrival_batch) if material_same_revision else None\n    68\t    deliveries=[]; identities={}; conflicts=set()\n    69\t    budget_ids={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget')}\n    70\t    for decision in decisions:\n    71\t        dv=fields(decision); identity=dv.get('Decision reference')\n    72\t        ps=[p for p in packets if fields(p).get('Decision reference')==identity]\n    73\t        relevant=(dv.get('Subject reference')==subject_id or any(fields(p).get('Trip reference')==trip.get('Trip reference')\n    74\t                  and fields(p).get('Employee ID')==employee for p in ps))\n    75\t        if not relevant: continue\n    76\t        item=dict(decision_id=identity, outcome=dv.get('Outcome'), roles=str(dv.get('Review roles') or '').splitlines(),\n    77\t                  reason=dv.get('Reason'), repair_requested=dv.get('Repair requested'), evidence_valid=False,\n    78\t                  active=False, import_status='rejected-import', source_refs=[ref(decision)]+[ref(p) for p in ps],\n    79\t                  raw_record=deepcopy(decision), rejection_reasons=[])\n    80\t        deliveries.append(item)\n   140\t            item.update(evidence_valid=True,import_status='valid',order=stamp.isoformat(),decision_time=stamp.isoformat())\n   141\t        except (ValueError,TypeError,InvalidOperation) as exc:\n   142\t            item['rejection_reasons'].append(str(exc))\n   143\t    # Conflicting redelivery must hold an identity even when its later payload fails validation.\n   144\t    all_payloads={}\n   145\t    for item in deliveries:\n   146\t        dv=fields(item['raw_record']); identity=item['decision_id']\n   147\t        if (identity and dv.get('Subject reference')==subject_id and _revision(dv.get('Revision'))==revision\n   148\t                and _revision(dv.get('Arrival batch')) is not None and _revision(dv.get('Arrival batch'))<=arrival_batch):\n   149\t            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n   150\t            if identity in all_payloads and all_payloads[identity]!=payload: conflicts.add(identity)\n   151\t            all_payloads[identity]=payload\n   152\t    for item in deliveries:\n   153\t        if item['decision_id'] in conflicts:\n   154\t            item.update(evidence_valid=False,import_status='conflicting-replay')\n   155\t            item['rejection_reasons'].append('Immutable decision identity has conflicting deliveries')\n   156\t    role_states={}; selected=[]\n   157\t    for role in required:\n   158\t        candidates=[d for d in deliveries if d['evidence_valid'] and role in d['roles'] and (role!='budget_owner' or d.get('budget_evidence_valid',True))]\n   159\t        if not candidates: role_states[role]='missing'; continue\n   160\t        latest=max(d['order'] for d in candidates)\n   161\t        matches=[d for d in candidates if d['order']==latest]\n   162\t        if len(matches)!=1:\n   163\t            role_states[role]='conflicting';continue\n   164\t        chosen=matches[0];chosen['active']=True;role_states[role]=chosen['outcome']\n   165\t        if chosen not in selected: selected.append(chosen)\n   166\t    withdrawal_valid=bool(withdrawn and source_bound(subject_record,observations) and source_bound(trip_record,observations)\n   167\t        and trip.get('Employee ID')==employee and len(people)==1 and source_bound(people[0],observations)\n   168\t        and isinstance(fields(subject_record).get('Claim reason'),str) and fields(subject_record)['Claim reason'].strip())\n   169\t    states=set(role_states.values())\n   170\t    state=('withdrawn' if withdrawal_valid else 'rejected' if 'reject' in states else 'returned' if 'return' in states\n   171\t           else 'approved' if states=={'approve'} and policy and amount_known else 'pending')\n   172\t    if not policy or conflicts and not withdrawal_valid: state='pending'\n   173\t    policy_binding=parsed.get('expense_policy') or {}\n   174\t    policy_refs=[f\"{policy_binding.get('path')}@{policy_binding.get('sha256')}#line {n}\" for n in (9,13,15,17)] if policy else []\n   175\t    return dict(policy_source_refs=policy_refs,subject_type=kind,subject_id=subject_id,revision=revision,state=state,required_roles=required,\n   176\t                amount_cents=amount_cents,amount_known=amount_known,evidence_digest=digest,withdrawal_requested=withdrawn,withdrawal_valid=withdrawal_valid,\n   177\t                material_same_revision=material_same_revision,invalidated_batch=invalidated_batch,policy_verified=policy,role_states=role_states,\n   178\t                deliveries=deliveries,active_decision_ids=[d['decision_id'] for d in selected],\n   179\t                source_refs=list(dict.fromkeys([ref(r) for r in basis_rows]+[r for d in deliveries for r in d['source_refs']])),\n   180\t                approved=state=='approved',repair_requests=[d['repair_requested'] for d in selected if d['outcome']=='return'])\n   195\t    subject['text']='\\n'.join(str(c.get('value','')) for s in parsed.get('workbook_sheets',[])\n   196\t        if s.get('source_id')==trip_record.get('source_id') for c in s.get('preamble',[]))\n   197\t    result=evaluate_reviews(parsed=parsed,kind='permit',subject_id=trip.get('Permit reference'),revision=_revision(trip.get('Permit revision')),\n   198\t        trip_record=trip_record,employee=trip.get('Employee ID'),subject_record=subject,amount_cents=_cents(trip.get('Estimate (EUR)')),\n   199\t        decisions=decisions,arrival_batch=arrival_batch,observations=observations,cost_ids=cost_ids,prior=prior,budget_context=budget_context)\n   200\t    result['budget_context']=budget_context\n   201\t    result['arrangement_authorized']=False\n   202\t    if result['approved'] and trip.get('International') is True:\n   203\t        commitment=trip.get('First commitment date')\n   204\t        if commitment in (None,''):\n   205\t            result['arrangement_authorized']=True\n   206\t        else:\n   207\t            try:\n   208\t                day=local_date(commitment)\n   209\t                active=[d for d in result['deliveries'] if d['active']]\n   210\t                latest=max(utc_time(d['decision_time']) for d in active).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n   211\t                result['arrangement_authorized']=latest<day\n   212\t                result['timing_finding']=None if latest<day else 'late_permit' if latest>day else 'same-day-order-unconfirmed'\n   213\t            except (ValueError,TypeError): result['timing_finding']='missing-commitment-evidence'\n   214\t    result['arrangements_at_commitment_supported']=result['arrangement_authorized']\n   215\t    affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n   216\t        and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))\n   217\t        and (c.get('target_type')=='trip' or (c.get('permit_id')==trip.get('Permit reference')\n   218\t             and _revision(c.get('permit_revision'))==_revision(trip.get('Permit revision'))))]\n   219\t    result['cancellation_ids']=[c['cancellation_id'] for c in affected]\n   220\t    if affected: result['arrangement_authorized']=False\n   221\t    return result\n   285\t                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n   286\t                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n   287\t                run_id=run_id, batch_id=batch_id)\n   288\t    current_invalid = {i.get('event_id') for i in reduced['issues']}\n   289\t    for item_id, item in domain['repair_queue']['items'].items():\n   290\t        if item_id.startswith('cancellation-evidence:'):\n   291\t            for event_id, record in reduced['admitted_records'].items():\n   292\t                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\n   293\t                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\n   294\t                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\n   295\t    claim_revisions = _subject_claim_revisions(history)\n   296\t    snapshot_rows = []\n   297\t    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n   298\t        target = process[\"target\"]\n   299\t        target_revision = target.get(\"revision\")\n   300\t        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n   301\t                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n   302\t            domain[\"projection_issues\"].append({\n   303\t                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n   304\t                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n   305\t                \"owner\": \"Travel Administration Lead\",\n   306\t                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n   307\t            })\n   308\t            continue\n   309\t        record_order = process[\"activity_ids\"]\n   310\t        if not record_order:\n   311\t            continue  # Orphan evidence remains in cancellation_state and owned issues.\n   312\t        request_id = record_order[0]\n   313\t        request = raw_by_id[request_id]\n   314\t        request_values = row_values(request)\n   315\t        confirmation = next((raw_by_id[event_id] for event_id in record_order\n   316\t                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n   317\t        confirmation_values = row_values(confirmation) if confirmation else {}\n   318\t        trip_id = request_values.get(\"Trip reference\")\n   319\t        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n   320\t        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n   780\t    snapshot = {\n   781\t        \"schema_version\": \"travel-claim-snapshot/2\",\n   782\t        \"run_id\": run_id,\n   783\t        \"batch_id\": batch_id,\n   784\t        \"predecessor\": deepcopy(predecessor),\n   785\t        \"source_binding\": deepcopy(source_binding),\n   786\t        \"claims\": snapshot_claims,\n   787\t        \"permit_approvals\": deepcopy(domain[\"permit_approvals\"]),\n   788\t        \"budget_reconciliation\": deepcopy(budgets),\n   789\t        \"requests\": [{\"request_id\": row_values(w[\"request\"])[\"Request reference\"], \"claim_id\": w[\"claim_id\"],\n   790\t                      \"revision\": w[\"revision\"], \"amount_cents\": w[\"allowed_cents\"],\n   791\t                      \"payee\": row_values(w[\"request\"])[\"Payee ID\"], \"currency\": \"EUR\", \"status\": \"held\" if any(w[\"claim_id\"] in c[\"affected_claim_ids\"] for c in cancellation_rows) else \"accepted\",\n   792\t                      \"decision_ids\": list(dict.fromkeys(d[\"decision_id\"] for d in w[\"observed_reviews\"] if d[\"outcome\"] == \"approve\" and d.get('active') and d.get('evidence_valid'))),\n   793\t                      \"source_refs\": [_ref_text(_ref(w[\"request\"]))], \"origin\": \"observed source request; no request sent\"}\n   794\t                     for w in domain[\"ordinary_workflows\"].values() if w[\"request\"] is not None],\n   795\t        \"travel_cancellations\": cancellation_rows,\n   796\t        \"admitted_event_ids\": finance_ids,\n   797\t        \"issues\": schema_issues,\n   798\t    }\n   799\t    domain[\"processed_batches\"] = list(domain[\"processed_batches\"])\n   800\t    return {\n   801\t        \"snapshot\": snapshot,\n   802\t        \"domain\": domain,\n   803\t        \"decision_history\": deepcopy(domain[\"decision_history\"]),\n   804\t        \"finance_reconciliations\": deepcopy(finance_results),\n   805\t        \"revision_history\": deepcopy(history),\n   806\t        \"repair_queue_by_owner\": _owner_view(domain[\"repair_queue\"]),\n   807\t        \"batch_delta_counts\": {key: len(value) for key, value in delta.items()},\n   208\t    batch_ids: set[int] = set()\n   209\t    invalid_batches = set()\n   210\t    def explicit_batch(value, record):\n   211\t        try:\n   212\t            number = Decimal(str(value))\n   213\t            if isinstance(value, bool) or not number.is_finite() or number < 1 or number != number.to_integral_value():\n   214\t                raise ValueError(\"not a positive integer batch\")\n   215\t            return int(number)\n   216\t        except (InvalidOperation, ValueError, TypeError):\n   217\t            key = (record.get('source_id'), record.get('locator'), str(value))\n   218\t            if key not in invalid_batches:\n   219\t                invalid_batches.add(key)\n   220\t                transcription_issues.append({'source_id': record.get('source_id'),\n   221\t                    'source_sha256': record.get('source_sha256'), 'path': record.get('locator'),\n   222\t                    'error': f\"Arrival batch is not an explicit positive integer: {value!r}; raw value preserved\",\n   223\t                    'owner': 'Travel Administration Lead', 'next_action': 'Obtain the authoritative arrival membership without rounding or defaulting'})\n   224\t            return None\n   2