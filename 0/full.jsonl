    unique = {}\n   102\t            for row in ms:\n   103\t                mv = fields(row); identity = mv.get('Transaction reference')\n   104\t                # Identity is global: a redelivery under a different cost also conflicts.\n   105\t                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n   106\t                if not identity or any(d != mv for d in deliveries):\n   107\t                    raise ValueError('Conflicting merchant transaction identity')\n   108\t                unique[identity] = row\n   109\t            ms = list(unique.values())\n   110\t            if not ms:\n   111\t                raise ValueError('Missing settled merchant transaction')\n   112\t            for row in ms:\n   113\t                mv = fields(row)\n   114\t                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n   115\t                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n   116\t                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n   117\t                    raise ValueError('Merchant payment is unsettled or mismatched')\n   118\t            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n   119\t                raise ValueError('Merchant payments do not match gross amount')\n   120\t            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n   121\t            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n   122\t            if not verified:\n   123\t                raise ValueError('Verified expense policy binding required')\n   124\t            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n   125\t            if len(dates) != 1:\n   126\t                raise ValueError('Multiple payment dates require source-supported allocation')\n   127\t            paid = local_date(dates[0])\n   128\t            if paid.year != 2026:\n   129\t                raise ValueError('Payment outside supplied policy effective year')\n   130\t            category = rv.get('Category')\n   131\t            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n   132\t                raise ValueError('Unknown expense category')\n   133\t            allowed = Decimal(0) if category == 'personal' else gross\n   134\t            cap_evidence = None\n   135\t            if category in {'lodging', 'meals'}:\n   136\t                if not trip.get('Destination'):\n   137\t                    raise ValueError('Missing destination for applicable cap')\n   138\t                units = number(rv.get('Documented units'))\n   139\t                if units <= 0 or units != units.to_integral_value():\n   140\t                    raise ValueError('Capped units must be positive integers')\n   141\t                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n   142\t                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n   143\t                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n   144\t                if len(cs) != 1:\n   145\t                    raise ValueError('Missing or ambiguous applicable cap')\n   146\t                cap = number(fields(cs[0]).get('Amount per unit'))\n   147\t                with localcontext() as ctx:\n   148\t                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n   149\t                    allowed = min(gross, cap * units)\n   150\t                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n   151\t                line['source_refs'].append(ref(cs[0]))\n   152\t            line['base_allowed_original_amount'] = str(allowed)\n   153\t            deadline = filing_deadline(trip.get('End date'))\n   154\t            submitted = local_date(line['first_submitted_date'])\n   155\t            # Earlier, unchanged cost submissions remain authoritative after a correction.\n   156\t            from .ordinary import expense_lines\n   157\t            first_supported = False\n   158\t            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n   159\t                pr = prior.get('record', {})\n   160\t                for old in expense_lines(pr):\n   161\t                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n   162\t                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n   163\t                            and number(old['original_amount']) == gross):\n   164\t                        submitted = local_date(old['first_submitted_date'])\n   165\t                        line['source_refs'] += old['source_refs']\n   166\t                        first_supported = True\n   167\t                        break\n   168\t                if first_supported:\n   169\t                    break\n   170\t            if submitted > local_date(fields(record).get('Submitted date')):\n   171\t                raise ValueError('Cost submission is later than claim submission')\n   172\t            if submitted < paid:\n   173\t                raise ValueError('Submission precedes established employee payment')\n   174\t            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n   175\t                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n   176\t            if submitted > deadline:\n   177\t                original = 'Late filing held pending explicit version-bound Finance exception'\n   178\t                line['filing']['original_finding'] = original\n   179\t                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n   180\t            if exception['status'] == 'valid':\n   181\t                replacement = Decimal(exception['replacement_original_amount'])\n   182\t                if category == 'personal' and replacement != 0:\n   183\t                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n   184\t                allowed = replacement\n   185\t                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n   186\t            apply_coverage(line['eligibility_findings'], exception)\n   187\t            if line['currency'] == 'EUR':\n   188\t                rate = Decimal(1); rate_refs = policy_refs\n   189\t            else:\n   190\t                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n   191\t                      and local_date(fields(r).get('Rate date')) == paid]\n   192\t                if len(fx) != 1:\n   193\t                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n   194\t                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n   195\t                if rate <= 0:\n   196\t                    raise ValueError('FX rate must be positive')\n   197\t            with localcontext() as ctx:\n   198\t                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n   199\t                converted = allowed * rate\n   200\t                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n   201\t            line['source_refs'] += rate_refs\n   202\t            line.update(calculated_cents=cents, calculation_status='PASS',\n   203\t                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n   204\t                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n   205\t                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n   206\t                                        rate_source_refs=rate_refs, cap=cap_evidence))\n   207\t            line['filing_status'] = 'BLOCKED' if any(\n   208\t                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n   209\t            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n   210\t                                                    for f in line['eligibility_findings']):\n   211\t                line['filing']['exception'] = deepcopy(exception)\n   212\t            if exception['status'] == 'BLOCKED':\n   213\t                raise ValueError(exception['reason'])\n   214\t            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n   215\t                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n   216\t            line.update(eligibility_status='PASS', status='supported',\n   217\t                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n   218\t                        else 'Supported paid expense calculation and timely filing')\n   219\t        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n   220\t            line['reason'] = str(exc)\n   221\t    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n   222\t        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n   223\t    return dict(status='PASS' if complete else 'BLOCKED',\n   224\t                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n   225\t                policy_source_refs=policy_refs, policy_verified=verified)\n     1\t\"\"\"Source-bound POL-2026.2 reimbursement exceptions, never travel authority.\n     2\t\n     3\tNative PDF display labels are mapped explicitly, not by substring or fuzzy\n     4\tmatching. Currency comes from the exception's exact claim/revision/cost line:\n     5\tPOL-2026.2 line 7 defines the replacement as an original-currency amount.\n     6\t\"\"\"\n     7\tfrom datetime import datetime\n     8\tfrom decimal import Decimal, InvalidOperation\n     9\timport re\n    10\tfrom zoneinfo import ZoneInfo\n    11\t\n    12\tISSUES = {'late_filing', 'late_permit', 'permit_unapproved', 'travel_cancellation'}\n    13\tNATIVE_ISSUES = {'Late filing': 'late_filing', 'Late permit': 'late_permit',\n    14\t                 'Permit unapproved': 'permit_unapproved', 'Travel cancellation': 'travel_cancellation'}\n    15\tEXCEPTION_FIELDS = ('Authorizing Finance officer', 'Applies to claim', 'Applies to revision',\n    16\t                    'Expense reference', 'Allowed original amount', 'Exception reason', 'Covered issues')\n    17\t\n    18\t\n    19\tdef source_bound(row, observations):\n    20\t    return bool(row.get('source_id') and row.get('source_sha256') and row.get('locator')) and any(\n    21\t        o.get('source_id') == row['source_id'] and o.get('sha256') == row['source_sha256']\n    22\t        and o.get('status') == 'read' and not o.get('missing_scope') for o in observations)\n    23\t\n    24\t\n    25\tdef covered_issues(raw):\n    26\t    if raw == 'None':  # Exact native PDF wording for an amount-only exception.\n    27\t        return []\n    28\t    if isinstance(raw, str) and raw:\n    29\t        raw = raw.splitlines()\n    30\t    if not isinstance(raw, list) or any(not isinstance(v, str) for v in raw):\n    31\t        raise ValueError('Missing or malformed covered_issues list')\n    32\t    result = [NATIVE_ISSUES.get(v, v) for v in raw]\n    33\t    if any(v not in ISSUES for v in result) or len(set(result)) != len(result):\n    34\t        raise ValueError('Unknown or duplicate covered_issues; exact matching required')\n    35\t    return sorted(result)\n    36\t\n    37\t\n    38\tdef validate_exception(*, record, line, employee, people, observations, fields, ref):\n    39\t    value = fields(record)\n    40\t    supplied = any(key in value for key in EXCEPTION_FIELDS)\n    41\t    result = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n    42\t    if not supplied:\n    43\t        return result\n    44\t    result.update(status='BLOCKED', source_refs=[ref(record)],\n    45\t                  raw_fields={k: value.get(k) for k in EXCEPTION_FIELDS + ('Travel cancellation reference',)})\n    46\t    try:\n    47\t        labels = [f.get('label', '').strip() for f in record.get('fields', [])]\n    48\t        if any(labels.count(key) > 1 for key in EXCEPTION_FIELDS + ('Claim reference', 'Revision', 'Travel cancellation reference')):\n    49\t            raise ValueError('Repeated Finance exception authority field requires source resolution')\n    50\t        if any(key not in value for key in EXCEPTION_FIELDS):\n    51\t            raise ValueError('Missing required Finance exception field')\n    52\t        directory = [r for r in people if fields(r).get('Employee ID') == employee]\n    53\t        if not source_bound(record, observations) or len(directory) != 1 or not source_bound(directory[0], observations):\n    54\t            raise ValueError('Exception or Finance directory source binding is unverified')\n    55\t        actor = fields(directory[0]).get('Finance officer')\n    56\t        if not actor or value['Authorizing Finance officer'] != actor or actor == employee:\n    57\t            raise ValueError('Exception actor is not the directory Finance officer')\n    58\t        from .workflow import _revision\n    59\t        revision = _revision(value.get('Revision'))\n    60\t        if (not value.get('Claim reference') or value['Applies to claim'] != value['Claim reference']\n    61\t                or revision is None or _revision(value['Applies to revision']) != revision\n    62\t                or value['Expense reference'] != line['cost_id']):\n    63\t            raise ValueError('Exception claim/revision/cost authority does not match current expense')\n    64\t        if not isinstance(value['Exception reason'], str) or not value['Exception reason'].strip():\n    65\t            raise ValueError('Exception requires a documented reason')\n    66\t        amount = value['Allowed original amount']\n    67\t        if isinstance(amount, bool) or amount is None:\n    68\t            raise ValueError('Invalid replacement original amount')\n    69\t        replacement = Decimal(str(amount).replace(',', ''))\n    70\t        if not replacement.is_finite() or replacement < 0:\n    71\t            raise ValueError('Invalid replacement original amount')\n    72\t        coverage = covered_issues(value['Covered issues'])\n    73\t        cancellation = value.get('Travel cancellation reference')\n    74\t        if 'travel_cancellation' in coverage and (not isinstance(cancellation, str) or not cancellation):\n    75\t            raise ValueError('Travel cancellation exception requires exact travel_cancellation_id')\n    76\t        result.update(status='valid', actor=actor, claim_id=value['Applies to claim'], revision=revision,\n    77\t                      cost_id=line['cost_id'], currency=line['currency'], replacement_original_amount=str(replacement),\n    78\t                      reason=value['Exception reason'], covered_issues=coverage, travel_cancellation_id=cancellation,\n    79\t                      source_refs=[ref(record), ref(directory[0])])\n    80\t    except (ValueError, TypeError, InvalidOperation) as exc:\n    81\t        result['reason'] = str(exc)\n    82\t    return result\n    83\t\n    84\t\n    85\tdef finding(issue, reason, refs, cancellation_id=None):\n    86\t    return dict(issue=issue, original_finding=reason, source_refs=refs, status='unresolved',\n    87\t                travel_cancellation_id=cancellation_id, exception_source_refs=[])\n    88\t\n    89\t\n    90\tdef apply_coverage(findings, exception):\n    91\t    for item in findings:\n    92\t        if (exception['status'] == 'valid' and item['issue'] in exception['covered_issues']\n    93\t                and (item['issue'] != 'travel_cancellation'\n    94\t                     or item['travel_cancellation_id'] == exception.get('travel_cancellation_id'))):\n    95\t            item.update(status='covered_for_reimbursement', exception_source_refs=exception['source_refs'])\n    96\t    return findings\n    97\t\n    98\t\n    99\tdef travel_findings(*, trip, employee, decisions, people, cancellations, fields, ref, observations, trip_source_refs=()):\n   100\t    \"\"\"Find eligibility defects without granting or retiring arrangement authority.\"\"\"\n   101\t    result = []\n   102\t    directory = [fields(r) for r in people if fields(r).get('Employee ID') == employee]\n   103\t    if trip.get('International') is True:\n   104\t        permit = trip.get('Permit reference'); revision = trip.get('Permit revision')\n   105\t        from .workflow import _revision\n   106\t        rows = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n   107\t                and fields(r).get('Subject reference') == permit and _revision(fields(r).get('Revision')) == _revision(revision)]\n   108\t        # Exact redelivery is inert; conflicting immutable decision IDs cannot establish permission.\n   109\t        unique = {}; conflict = False\n   110\t        for r in rows:\n   111\t            v = fields(r); identity = v.get('Decision reference')\n   112\t            payload = {k: val for k, val in v.items() if k != 'Arrival batch'}\n   113\t            if not identity or identity in unique and unique[identity][1] != payload:\n   114\t                conflict = True\n   115\t            unique[identity] = (r, payload)\n   116\t        rows = [v[0] for v in unique.values()]\n   117\t        refs = list(trip_source_refs) + [ref(r) for r in rows] + [ref(r) for r in people if fields(r).get('Employee ID') == employee]\n   118\t        roles = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner', 'supervisor': 'Supervisor'}\n   119\t        try:\n   120\t            estimate = Decimal(str(trip.get('Estimate (EUR)')))\n   121\t            if not estimate.is_finite() or estimate < 0:\n   122\t                raise ValueError('Invalid reviewed estimate')\n   123\t            if estimate > 1000:\n   124\t                roles['director'] = 'Director'\n   125\t            approved = bool(permit and _revision(revision) and len(directory) == 1 and not conflict\n   126\t                            and all(source_bound(r, observations) for r in people if fields(r).get('Employee ID') == employee))\n   127\t            times = []\n   128\t            for role, label in roles.items():\n   129\t                matching = [r for r in rows if role in str(fields(r).get('Review roles', '')).splitlines()]\n   130\t                if len(matching) != 1:\n   131\t                    approved = False; continue\n   132\t                r = matching[0]; v = fields(r)\n   133\t                review_roles = str(v.get('Review roles') or '').splitlines()\n   134\t                roles_valid = (bool(review_roles) and len(set(review_roles)) == len(review_roles)\n   135\t                    and set(review_roles) <= set(roles)\n   136\t                    and (len(review_roles) == 1 or set(review_roles) == {'budget_owner', 'supervisor'}))\n   137\t                valid = (roles_valid and v.get('Outcome') == 'approve' and v.get('Reviewer') == directory[0].get(label)\n   138\t                         and v.get('Reviewer') != employee and source_bound(r, observations)) if len(directory) == 1 else False\n   139\t                approved = approved and valid\n   140\t                if valid:\n   141\t                    # XLSX column explicitly says UTC, though Excel serialization lacks an offset.\n   142\t                    time = v.get('Decision time (UTC)')\n   143\t                    if not isinstance(time, str):\n   144\t                        raise ValueError('Missing permit decision UTC time')\n   145\t                    stamp = datetime.fromisoformat(time.replace('Z', '+00:00'))\n   146\t                    if stamp.tzinfo is None:\n   147\t                        stamp = stamp.replace(tzinfo=ZoneInfo('UTC'))\n   148\t                    times.append(stamp)\n   149\t            if not approved:\n   150\t                result.append(finding('permit_unapproved', 'Matching approved permit roles are missing or invalid; cancellation does not revoke historical approvals', refs))\n   151\t            else:\n   152\t                from .expenses import local_date\n   153\t                commitment = local_date(trip.get('First commitment date'))\n   154\t                approval_day = max(times).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n   155\t                if approval_day >= commitment:\n   156\t                    result.append(finding('late_permit', 'Permit approved after first commitment' if approval_day > commitment\n   157\t                                          else 'Same-day permit/commitment ordering is unconfirmed', refs))\n   158\t        except (ValueError, TypeError, InvalidOperation, KeyError) as exc:\n   159\t            result.append(finding('late_permit', f'Permit timing/amount evidence unresolved: {exc}', refs))\n   160\t    elif trip.get('International') is not False:\n   161\t        result.append(finding('permit_unapproved', 'International/permit requirement is missing', []))\n   162\t    for cancellation in cancellations:\n   163\t        from .workflow import _revision\n   164\t        current_target = (bool(trip.get('Trip reference') and _revision(trip.get('Trip revision')))\n   165\t                          and cancellation.get('trip_id') == trip.get('Trip reference')\n   166\t                          and _revision(cancellation.get('trip_revision')) == _revision(trip.get('Trip revision')))\n   167\t        if cancellation.get('target_type') == 'permit':\n   168\t            current_target = (current_target and cancellation.get('permit_id') == trip.get('Permit reference')\n   169\t                              and _revision(cancellation.get('permit_revision')) == _revision(trip.get('Permit revision')))\n   170\t        if current_target:\n   171\t            result.append(finding('travel_cancellation', 'Current travel basis has a requested or confirmed business cancellation',\n   172\t                                  list(trip_source_refs) + cancellation.get('source_refs', []), cancellation['cancellation_id']))\n   173\t    return result\n   174\t\n   175\t\n   176\tdef review_binds_exception(decision, record, *, same_revision_change, fields, ref):\n   177\t    \"\"\"Require current version evidence when a replacement changes the review basis.\n   178\t\n   179\t    Native Source revisions may name the binder's printed SRC-D-* version. A\n   180\t    same-revision source replacement needs the exact retained page/hash instead;\n   181\t    the unchanged binder label cannot establish review of changed content.\n   182\t    \"\"\"\n   183\t    versions = str(fields(decision).get('Source revisions') or '').splitlines()\n   184\t    exact = ref(record) in versions or record.get('source_sha256') in versions\n   185\t    printed = re.findall(r'\\bSRC-D-\\d+\\b', record.get('text', ''))\n   186\t    return exact or (not same_revision_change and any(v in versions for v in printed))\n","stderr":"","aggregated_output":"    90\t        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n    91\t        try:\n    92\t            gross = number(line['original_amount'])\n   