e)\n   365\t    persisted[\"by_owner\"] = {\n   366\t        owner: [item[\"item_id\"] for item in items]\n   367\t        for owner, items in owner_grouped_view(queue).items()\n   368\t    }\n   369\t    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=path.parent)\n   370\t    try:\n   371\t        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n   372\t            json.dump(persisted, stream, indent=2, ensure_ascii=False)\n   373\t            stream.write(\"\\n\")\n   374\t            stream.flush()\n   375\t            os.fsync(stream.fileno())\n   376\t        os.replace(tmp_name, path)\n   377\t    finally:\n   378\t        if os.path.exists(tmp_name):\n   379\t            os.unlink(tmp_name)\n   380\t\n   381\t\n   382\tdef record_evidence_validation(queue: dict, *, item_id: str, supported: bool,\n   383\t                               source_refs: list[str], run_id: str, batch_id: str) -> None:\n   384\t    \"\"\"Record a local evidence recheck, not a fabricated human response.\"\"\"\n   385\t    item = queue['items'][item_id]\n   386\t    status = 'resolved' if supported else 'open'\n   387\t    if supported and not source_refs:\n   388\t        raise ValueError('Evidence-supported resolution requires retained references')\n   389\t    if item['status'] == status:\n   390\t        return\n   391\t    event = dict(event='evidence-revalidated', item_id=item_id, previous_status=item['status'],\n   392\t                 status=status, source_refs=list(dict.fromkeys(source_refs)), run_id=run_id,\n   393\t                 batch_id=batch_id, origin='local-evidence-check; no human response created')\n   394\t    item['history'].append(dict(event))\n   395\t    queue['events'].append(event)\n   396\t    item['status'] = status\n   225\t          f\"Claim approval state: {claim_review['state']}; required roles: {', '.join(claim_review['required_roles'])}\",\n   226\t          lead,'Obtain the outstanding current-version human decisions; permit