extend([\n                        f\"  - Evidence needed: {row.get('evidence_needed') or 'not specified in retained issue; human review required'}\",\n                        f\"  - Retained issue reference: `parsed-records.json#unresolved_issues/{identity}` in run `{run_id}`.\",\n                    ])\n                else:\n                    lines.append(f\"  - Queue reference: `repair-queue.json#items/{identity}`; opened in run `{row['run_id']}`, batch `{row['batch_id']}`.\")\n                    refs = \"; \".join(f\"`{ref}`\" for ref in row[\"source_refs\"])\n                    lines.append(f\"  - Retained evidence references: {refs or 'none retained; human review required'}\")\n            lines.append(\"\")\n    if not grouped:\n        lines.extend([\"No unresolved items; no draft messages generated.\", \"\"])\n    return \"\\n\".join(lines), len(grouped)\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('src/travel_claim/offline_replay.py');s=p.read_text().replace('from .integration import', 'from .follow_up import render_follow_up_drafts\\nfrom .integration import')\ns=s.replace('f\"- Repair queue: `{output_paths[\\'queue\\'].name}` (grouped by owner, item identity retained).\",','f\"- Repair queue: `{output_paths[\\'queue\\'].name}` (grouped by owner, item identity retained).\",\\n        f\"- Owner follow-up drafts: `{output_paths[\\'drafts\\'].name}` (human review required; not sent).\",')\ns=s.replace('\"state\": run_dir / \"offline-replay-state.json\",','\"state\": run_dir / \"offline-replay-state.json\",\\n        \"drafts\": run_dir / \"follow-up-drafts.md\",')\ns=s.replace('    report = _report(','''    drafts, draft_count = render_follow_up_drafts(\n        run_id=manifest[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []),\n    )\n    with output_paths[\"drafts\"].open(\"x\", encoding=\"utf-8\", newline=\"\\\\n\") as stream:\n        stream.write(drafts)\n    report = _report(''')\ns=s.replace('\"outputs\": output_