_id'] == 'F-C01-accepted'\\n\\n\\ndef test_unknown_reversal_semantics_are_unresolved_and_never_turned_into_cash():\\n    event, revisions = _accepted_and_revision()\\n    reversal = deepcopy(event)\\n    reversal['values']['Activity reference']['value'] = 'SYNTHETIC-REVERSAL'\\n    reversal['values']['Activity type']['value'] = 'reversal'\\n    reversal['values']['Amount (EUR)'] = {'value': 100}\\n    result = reconcile_finance_events([event, reversal], claim_id='C01', current_revision=1, revision_history=revisions)\\n    assert result['net_confirmed_cents'] == 0\\n    assert result['recorded_ledger_balance_cents'] is None\\n    assert result['unresolved_event_ids'] == ['SYNTHETIC-REVERSAL']\\n\\n\\ndef test_cash_request_mismatch_keeps_ledger_difference_unresolved_with_owned_repair():\\n    parsed = _fixture()\\n    for row in parsed['records']['finance_events']:\\n        if row['values']['Activity reference']['value'] == 'F-C01-1':\\n            row['values']['Request reference']['value'] = 'SYNTHETIC-WRONG-REQUEST'\\n    final = _batches(parsed)[-1]['finance_reconciliations']['C01']\\n    assert final['net_confirmed_cents'] == 10000  # still an observed claim payment\\n    assert final['recorded_ledger_balance_cents'] is None\\n    assert 'finance-recorded-cash-link:C01:1' in {i['record_id'] for i in final['repair_issues']}\\n\\n        path = run / \\\"claims.csv\\\"\\n        path.write_text(path.read_text().replace(\\\"claim_id,revision\\\", \\\"revision,claim_id\\\", 1))\\n    elif target == \\\"csv-money\\\":\\n        path = run / \\\"claims.csv\\\"\\n        path.write_text(path.read_text().replace(\\\"1250\\\", \\\"9999\\\"))\\n    elif target == \\\"report\\\":\\n        path = run / \\\"report.md\\\"\\n        path.write_text(path.read_text().replace(\\\"Exercise facilitator\\\", \\\"Invented owner\\\"))\\n    elif target == \\\"draft\\\":\\n        path = run / \\\"follow-up-drafts.md\\\"\\n        path.write_text(path.read_text().replace(\\\"HUMAN REVIEW REQUIRED\\\", \\\"READY TO SEND\\\"))\\n    elif target in {\\\"queue\\\", \\\"reference\\\", \\\"locator\\\"}:\\n        path = run / \\\"repair-queue.json\\\"\\n        queue = json.loads(path.read_text())\\n        item = next(iter(queue[\\\"items\\\"].values()))\\n        if target == \\\"queue\\\":\\n            item[\\\"request_draft\\\"][\\\"sent\\\"] = True\\n        elif target == \\\"locator\\\":\\n            manifest = json.loads((run / \\\"sources.json\\\").read_text())\\n            item[\\\"source_refs\\\"] = [\\\"initial-claim-binder@\\\" + manifest[\\\"files\\\"][1][\\\"sha256\\\"] + \\\"#invented page 999\\\"]\\n        else:\\n            item[\\\"source_refs\\\"] = [\\\"initial-claim-binder@\\\" + \\\"0\\\" * 64 + \\\"#page 1\\\"]\\n        path.write_text(json.dumps(queue))\\n        if target in {\\\"reference\\\", \\\"locator\\\"}:\\n            path = run / \\\"offline-replay-state.json\\\"\\n            state = json.loads(path.read_text())\\n            state[\\\"repair_queue\\\"] = {key: value for key, value in queue.items() if key != \\\"by_owner\\\"}\\n            path.write_text(json.dumps(state))\\n    elif target == \\\"fresh-marker\\\":\\n        path = run / \\\"offline-replay-state.json\\\"\\n        obj = json.loads(path.read_text()); obj[\\\"fresh_native_reads_performed\\\"] = True\\n        path.write_text(json.dumps(obj))\\n    else:\\n        path = run / \\\"parsed-records.json\\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13c45-9846-7111-9cb7-eca8b1cc3957","create_time":1792012773.5493858}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
