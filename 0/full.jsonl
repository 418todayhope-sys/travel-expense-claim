JSON snapshot against snapshot.schema.json\"\n    )\n    validate.add_argument(\"snapshot\", type=Path, help=\"path to the snapshot JSON file\")\n    validate.add_argument(\n        \"--schema\", type=Path, default=_default_schema_path(), help=\"schema JSON path\"\n    )\n\n    capture = commands.add_parser(\"capture-sources\", help=\"freshly retrieve and retain all five native sources\")\n    capture.add_argument(\"run_id\", help=\"new, stable run identifier\")\n    capture.add_argument(\"run_dir\", type=Path, help=\"new artifacts/runs/<run-id> directory\")\n    capture.add_argument(\"--case-clock\", help=\"supplied scenario clock; omit only for source-only capture\")\n\n    verify_sources = commands.add_parser(\"verify-sources\", help=\"verify source manifest and retained-byte hashes\")\n    verify_sources.add_argument(\"run_dir\", type=Path)\n\n    parse_sources = commands.add_parser(\"parse-retained\", help=\"transcribe hash-verified PDFs and workbook into traceable records\")\n    parse_sources.add_argument(\"run_dir\", type=Path)\n    parse_sources.add_argument(\"--output\", type=Path, help=\"optional new output path; defaults to parsed-records.json in the run\")\n\n    seal = commands.add_parser(\"seal-batch\", help=\"schema-check and immutably seal one batch state JSON\")\n    seal.add_argument(\"run_dir\", type=Path)\n    seal.add_argument(\"batch_id\")\n    seal.add_argument(\"state\", type=Path, help=\"JSON object containing claims, requests, cancellations, events, issues\")\n    seal.add_argument(\"--run-id\", required=True)\n    seal.add_argument(\"--predecessor\", type=Path)\n    seal.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    verify_batch = commands.add_parser(\"verify-batch\", help=\"verify schema and source/predecessor bindings\")\n    verify_batch.add_argument(\"run_dir\", type=Path)\n    verify_batch.add_argument(\"snapshot\", type=Path)\n    verify_batch.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    csv_cmd = commands.add_parser(\"write-claims-csv\", help=\"write the exact current-claim CSV contract\")\n    csv_cmd.add_argument(\"claims_json\", type=Path, help=\"JSON array of current claim summary objects\")\n    csv_cmd.add_argument(\"output\", type=Path)\n\n    replay = commands.add_parser(\n        \"offline-replay\",\n        help=\"replay verified retained records in arrival order without fresh native-source reads\",\n    )\n    replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n    replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n    readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n    readiness.add_argument(\"run_dir\", type=Path)\n    readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n    readiness.add_argument(\"--repo\", type=Path, default=Path(__file__).resolve().parents[2])\n    readiness.add_argument(\"--output-dir\", type=Path, required=True, help=\"new directory for readiness.json and readiness.md\")\n","exit_code":0,"duration":{"secs":0,"nanos":91981670},"formatted_output":"    dedup = deduplicate_activity_records(records, id_field=\"Cancellation activity reference\")\n    conflicting_ids = {issue[\"event_id\"] for issue in dedup[\"conflicts\"]}\n    events = [record for record in dedup[\"unique_events\"]\n              if row_values(record).get(\"Cancellation activity reference\") not in conflicting_ids]\n    events.sort(key=lambda row: (\n        _revision(row_values(row).get(\"Arrival batch\")) or 0,\n        row.get(\"row\", 0),\n    ))\n    processes: dict[str, dict[str, Any]] = {}\n    issues = list(dedup[\"conflicts\"])\n    id_lookup: dict[str, tuple[str, dict[str, Any]]] = {}\n    for record in events:\n        values = row_values(record)\n        event_id = values.get(\"Cancellation activity reference\")\n        cancellation_id = values.get(\"Cancellation reference\")\n        action = values.get(\"Action\")\n        subject_type = values.get(\"Cancelled subject\")\n        if not cancellation_id or subject_type not in {\"trip\", \"permit\"}:\n            issues.append({\"event_id\": event_id, \"source_ref\": _source_ref(record), \"reason\": \"missing cancellation ID or unsupported target type\"})\n            continue\n        target_id = values.get(\"Trip reference\") if subject_type == \"trip\" else values.get(\"Permit reference\")\n        target_revision = _revision(values.get(\"Trip revision\") if subject_type == \"trip\" else values.get(\"Permit revision\"))\n        target = {\"subject_type\": subject_type, \"subject_id\": target_id, \"revision\": target_revision}\n        process = processes.setdefault(str(cancellation_id), {\n            \"cancellation_id\": cancellation_id, \"target\": target, \"state\": \"unseen\",\n            \"activity_ids\": [], \"history\": [], \"next_action\": \"await request activity\",\n        })\n        if process[\"target\"] != target:\n            issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                           \"source_ref\": _source_ref(record), \"reason\": \"cancellation target identity/revision conflicts with prior activity\"})\n            continue\n        if action == \"requested\":\n            if process[\"state\"] != \"unseen\":\n                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                               \"source_ref\": _source_ref(record), \"reason\": f\"request is not valid after state {process['state']}\"})\n                continue\n            process[\"state\"] = \"requested\"\n            process[\"next_action\"] = \"await a linked confirmation activity\"\n        elif action == \"confirmed\":\n            initiation = values.get(\"Initiation activity reference\")\n            linked = id_lookup.get(str(initiation)) if initiation else None\n            if process[\"state\"] != \"requested\" or not linked or linked[0] != cancellation_id or row_values(linked[1]).get(\"Action\") != \"requested\":\n                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                               \"source_ref\": _source_ref(record), \"reason\": \"confirmation does not link to a prior request activity\"})\n                continue\n            if not values.get(\"Effective time (UTC)\"):\n                process[\"state\"] = \"requested\"\n                process[\"next_action\"] = \"obtain the missing effective time or confirmation record\"\n                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                               \"source_ref\": _source_ref(record), \"reason\": \"confirmation has no effective time\"})\n                continue\n            process[\"state\"] = \"confirmed\"\n            process[\"next_action\"] = None\n        else:\n            issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                           \"source_ref\": _source_ref(record), \"reason\": f\"unsupported action {action!r}\"})\n            continue\n        process[\"activity_ids\"].append(event_id)\n        process[\"history\"].append({\n            \"event_id\": event_id, \"action\": action,\n            \"arrival_batch\": values.get(\"Arrival batch\"),\n            \"effective_time\": values.get(\"Effective time (UTC)\"),\n            \"source_ref\": _source_ref(record),\n        })\n        id_lookup[str(event_id)] = (str(cancellation_id), record)\n    return {\"processes\": processes, \"issues\": issues,\n            \"duplicate_events\": dedup[\"duplicates\"], \"conflicting_events\": dedup[\"conflicts\"],\n            \"finance_effects\": [], \"claim_effects\": []}\n13:    \"travel_cancellations\",\n335:      \"description\": \"Admitted Finance activity IDs only. Travel cancellation activi