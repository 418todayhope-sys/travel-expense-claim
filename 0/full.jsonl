{"timestamp":"2026-10-14T19:50:44.073Z","ordinal":607,"type":"token_usage_record","payload":{"thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13bf7-84ed-7580-8f9b-351b17474778","session_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","root_turn_id":"01a13bf7-84ed-7580-8f9b-351b17474778","response_id":"resp_02f4b2bd528e1b90016acfdd1042ac81909ae5c70f49d0d036","usage":{"input_tokens":179294,"cached_input_tokens":178176,"cache_write_input_tokens":0,"output_tokens":138,"reasoning_output_tokens":0,"total_tokens":179432},"turn_token_usage":{"input_tokens":179294,"cached_input_tokens":178176,"cache_write_input_tokens":0,"output_tokens":138,"reasoning_output_tokens":0,"total_tokens":179432},"thread_token_usage":{"input_tokens":7753533,"cached_input_tokens":7438336,"cache_write_input_tokens":0,"output_tokens":37676,"reasoning_output_tokens":5751,"total_tokens":7791209}}}
{"timestamp":"2026-10-14T19:50:44.273Z","ordinal":608,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13bf7-84ed-7580-8f9b-351b17474778","item":{"type":"CommandExecution","id":"exec-a9fdc679-5f22-4b0d-b38e-b44d5b9d6f4f","process_id":"46228","command":["/bin/bash","-lc","git status --short; cat src/travel_claim/finance.py; cat tests/test_finance.py; sed -n '1,160p' src/travel_claim/integration.py; sed -n '370,475p' src/travel_claim/integration.py"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"git status --short; cat src/travel_claim/finance.py; cat tests/test_finance.py; sed -n '1,160p' src/travel_claim/integration.py; sed -n '370,475p' src/travel_claim/integration.py"}],"source":"unified_exec_startup","status":"completed","stdout":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\n    duplicate_events = []\n    conflicting_events = []\n    for event_id, occurrences in by_id.items():\n        relevant = [record for record in occurrences if _values(record).get(\"Claim reference\") == claim_id]\n        if not relevant:\n            continue\n        payloads = [_payload(_values(record)) for record in occurrences]\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\n        for record in relevant:\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\n        if conflict:\n            conflicting_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"payloads\": payloads,\n            })\n        elif len(occurrences) > 1:\n            duplicate_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"delivery_batches\": [_values(record).get(\"Arrival batch\") for record in occurrences],\n            })\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\n    relevant_occurrences.sort(key=lambda row: (\n        str(row[2].get(\"Arrival batch\") or \"\"),\n        int(row[1].get(\"row\") or 0),\n        row[0] or \"\",\n    ))\n\n    history = []\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\n    typed = []\n    unresolved = []\n    for event_id, record, values, conflict in relevant_occurrences:\n        event_type = values.get(\"Activity type\")\n        classification = classes.get(event_type, \"unresolved\")\n        item = {\n            \"event_id\": event_id,\n            \"source_ref\": _source_ref(record),\n            \"source_record\": deepcopy(values),\n            \"event_type\": event_type,\n            \"classification\": (\n                \"conflicting_event_id\" if conflict and event_id else\n                \"missing_event_id\" if conflict else classification\n            ),\n            \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n            \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n            \"currency\": values.get(\"Currency\"),\n            \"original_activity_id\": values.get(\"Original activity reference\"),\n        }\n        history.append(item)\n        if conflict:\n            if event_id:\n                event_issue_by_id[event_id] = {\n                    \"record_id\": f\"finance-event-conflict:{event_id}\",\n                    \"event_id\": event_id,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"same Finance event ID has conflicting source content; none of its occurrences were counted\",\n                    \"source_refs\": [_source_ref(row) for row in by_id[event_id]],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to resolve the source record conflict\",\n                }\n            else:\n                event_issue_by_id[f\"missing:{record.get('locator')}\"] = {\n                    \"record_id\": f\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\",\n                    \"event_id\": None,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"Finance event has no activity reference and cannot be safely deduplicated or counted\",\n                    \"source_refs\": [_source_ref(record)],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n                }\n            continue\n        if classification == \"unresolved\":\n            unresolved.append(item)\n            continue\n        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n                unresolved.append(item)\n                continue\n        typed.append(item)\n\n    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n    confirmed_refunds: list[dict[str, Any]] = []\n    refund_candidates = [item for item in typed if item[\"classification\"] == \"confirmed_refund\"]\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for item in refund_candidates:\n        original_id = item[\"original_activity_id\"]\n        original = payments.get(original_id) if isinstance(original_id, str) else None\n        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n            unresolved.append(item)\n            continue\n        refund_groups[original_id].append(item)\n    for original_id, refunds in refund_groups.items():\n        original = payments[original_id]\n        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n        if refund_total > original[\"amount_cents\"]:\n            unresolved.extend(refunds)\n            continue\n        confirmed_refunds.extend(refunds)\n\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    issues_by_owner: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for issue in issues:\n        issues_by_owner[issue[\"owner\"]].append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row[\"record_id\"]) for key, value in sorted(issues_by_owner.items())}\n\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [],\n            \"missing_or_return_reason\": \"no supported authorized obligation was supplied for this claim revision\",\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n        issues_by_owner.setdefault(owner, []).append(obligation_issue)\n        issues_by_owner[owner].sort(key=lambda row: row[\"record_id\"])\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n            }\n    return {\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n    }\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            if item_id in queue[\"items\"]:\n                continue\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n    expected_batch = processed[-1] + 1 if processed else 1\n    if arrival_batch != expected_batch:\n        raise ValueError(f\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\")\n    if prior_result is None and predecessor is not None:\n        raise ValueError(\"the first integrated batch must have a null predecessor\")\n    if prior_result is not None:\n        if prior_result.get(\"snapshot\", {}).get(\"run_id\") != run_id:\n            raise ValueError(\"prior integration state belongs to a different run\")\n        if predecessor is None:\n            raise ValueError(\"a later integrated batch must carry a predecessor binding\")\n\n    domain = previous_domain\n    if authorized_obligations:\n        domain[\"authorized_obligations\"].update(deepcopy(authorized_obligations))\n    if source_classifications:\n        domain[\"source_classifications\"].update(deepcopy(source_classifications))\n    previous_claim_revisions = {\n        subject_id: value[\"current_revision\"]\n        for subject_id, value in (domain.get(\"revision_history\") or {}).get(\"claim\", {}).items()\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n        )\n    domain[\"finance_reconciliations\"] = finance_results\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n","stderr":"","aggregated_output":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\n    duplicate_events = []\n    conflicting_events = []\n    for event_id, occurrences in by_id.items():\n        relevant = [record for record in occurrences if _values(record).get(\"Claim reference\") == claim_id]\n        if not relevant:\n            continue\n        payloads = [_payload(_values(record)) for record in occurrences]\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\n        for record in relevant:\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\n        if conflict:\n            conflicting_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"payloads\": payloads,\n            })\n        elif len(occurrences) > 1:\n            duplicate_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"delivery_batches\": [_values(record).get(\"Arrival batch\") for record in occurrences],\n            })\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\n    relevant_occurrences.sort(key=lambda row: (\n        str(row[2].get(\"Arrival batch\") or \"\"),\n        int(row[1].get(\"row\") or 0),\n        row[0] or \"\",\n    ))\n\n    history = []\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\n    typed = []\n    unresolved = []\n    for event_id, record, values, conflict in relevant_occurrences:\n        event_type = values.get(\"Activity type\")\n        classification = classes.get(event_type, \"unresolved\")\n        item = {\n            \"event_id\": event_id,\n            \"source_ref\": _source_ref(record),\n            \"source_record\": deepcopy(values),\n            \"event_type\": event_type,\n            \"classification\": (\n                \"conflicting_event_id\" if conflict and event_id else\n                \"missing_event_id\" if conflict else classification\n            ),\n            \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n            \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n            \"currency\": values.get(\"Currency\"),\n            \"original_activity_id\": values.get(\"Original activity reference\"),\n        }\n        history.append(item)\n        if conflict:\n            if event_id:\n                event_issue_by_id[event_id] = {\n                    \"record_id\": f\"finance-event-conflict:{event_id}\",\n                    \"event_id\": event_id,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"same Finance event ID has conflicting source content; none of its occurrences were counted\",\n                    \"source_refs\": [_source_ref(row) for row in by_id[event_id]],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to resolve the source record conflict\",\n                }\n            else:\n                event_issue_by_id[f\"missing:{record.get('locator')}\"] = {\n                    \"record_id\": f\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\",\n                    \"event_id\": None,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"Finance event has no activity reference and cannot be safely deduplicated or counted\",\n                    \"source_refs\": [_source_ref(record)],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n                }\n            continue\n        if classification == \"unresolved\":\n            unresolved.append(item)\n            continue\n        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n                unresolved.append(item)\n                continue\n        typed.append(item)\n\n    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n    confirmed_refunds: list[dict[str, Any]] = []\n    refund_candidates = [item for item in typed if item[\"classification\"] == \"confirmed_refund\"]\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for item in refund_candidates:\n        original_id = item[\"original_activity_id\"]\n        original = payments.get(original_id) if isinstance(original_id, str) else None\n        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n            unresolved.append(item)\n            continue\n        refund_groups[original_id].append(item)\n    for original_id, refunds in refund_groups.items():\n        original = payments[original_id]\n        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n        if refund_total > original[\"amount_cents\"]:\n            unresolved.extend(refunds)\n            continue\n        confirmed_refunds.extend(refunds)\n\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    issues_by_owner: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for issue in issues:\n        issues_by_owner[issue[\"owner\"]].append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row[\"record_id\"]) for key, value in sorted(issues_by_owner.items())}\n\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [],\n            \"missing_or_return_reason\": \"no supported authorized obligation was supplied for this claim revision\",\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n        issues_by_owner.setdefault(owner, []).append(obligation_issue)\n        issues_by_owner[owner].sort(key=lambda row: row[\"record_id\"])\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n            }\n    return {\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n    }\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            if item_id in queue[\"items\"]:\n                continue\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n    expected_batch = processed[-1] + 1 if processed else 1\n    if arrival_batch != expected_batch:\n        raise ValueError(f\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\")\n    if prior_result is None and predecessor is not None:\n        raise ValueError(\"the first integrated batch must have a null predecessor\")\n    if prior_result is not None:\n        if prior_result.get(\"snapshot\", {}).get(\"run_id\") != run_id:\n            raise ValueError(\"prior integration state belongs to a different run\")\n        if predecessor is None:\n            raise ValueError(\"a later integrated batch must carry a predecessor binding\")\n\n    domain = previous_domain\n    if authorized_obligations:\n        domain[\"authorized_obligations\"].update(deepcopy(authorized_obligations))\n    if source_classifications:\n        domain[\"source_classifications\"].update(deepcopy(source_classifications))\n    previous_claim_revisions = {\n        subject_id: value[\"current_revision\"]\n        for subject_id, value in (domain.get(\"revision_history\") or {}).get(\"claim\", {}).items()\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n        )\n    domain[\"finance_reconciliations\"] = finance_results\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n","exit_code":0,"duration":{"secs":0,"nanos":40576470},"formatted_output":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\n    duplicate_events = []\n    conflicting_events = []\n    for event_id, occurrences in by_id.items():\n        relevant = [record for record in occurrences if _values(record).get(\"Claim reference\") == claim_id]\n        if not relevant:\n            continue\n        payloads = [_payload(_values(record)) for record in occurrences]\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\n        for record in relevant:\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\n        if conflict:\n            conflicting_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"payloads\": payloads,\n            })\n        elif len(occurrences) > 1:\n            duplicate_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"delivery_batches\": [_values(record).get(\"Arrival batch\") for record in occurrences],\n            })\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\n    relevant_occurrences.sort(key=lambda row: (\n        str(row[2].get(\"Arrival batch\") or \"\"),\n        int(row[1].get(\"row\") or 0),\n        row[0] or \"\",\n    ))\n\n    history = []\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\n    typed = []\n    unresolved = []\n    for event_id, record, values, conflict in relevant_occurrences:\n        event_type = values.get(\"Activity type\")\n        classification = classes.get(event_type, \"unresolved\")\n        item = {\n            \"event_id\": event_id,\n            \"source_ref\": _source_ref(record),\n            \"source_record\": deepcopy(values),\n            \"event_type\": event_type,\n            \"classification\": (\n                \"conflicting_event_id\" if conflict and event_id else\n                \"missing_event_id\" if conflict else classification\n            ),\n            \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n            \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n            \"currency\": values.get(\"Currency\"),\n            \"original_activity_id\": values.get(\"Original activity reference\"),\n        }\n        history.append(item)\n        if conflict:\n            if event_id:\n                event_issue_by_id[event_id] = {\n                    \"record_id\": f\"finance-event-conflict:{event_id}\",\n                    \"event_id\": event_id,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"same Finance event ID has conflicting source content; none of its occurrences were counted\",\n                    \"source_refs\": [_source_ref(row) for row in by_id[event_id]],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to resolve the source record conflict\",\n                }\n            else:\n                event_issue_by_id[f\"missing:{record.get('locator')}\"] = {\n                    \"record_id\": f\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\",\n                    \"event_id\": None,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"Finance event has no activity reference and cannot be safely deduplicated or counted\",\n                    \"source_refs\": [_source_ref(record)],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n                }\n            continue\n        if classification == \"unresolved\":\n            unresolved.append(item)\n            continue\n        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n                unresolved.append(item)\n                continue\n        typed.append(item)\n\n    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n    confirmed_refunds: list[dict[str, Any]] = []\n    refund_candidates = [item for item in typed if item[\"classification\"] == \"confirmed_refund\"]\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for item in refund_candidates:\n        original_id = item[\"original_activity_id\"]\n        original = payments.get(original_id) if isinstance(original_id, str) else None\n        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n            unresolved.append(item)\n            continue\n        refund_groups[original_id].append(item)\n    for original_id, refunds in refund_groups.items():\n        original = payments[original_id]\n        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n        if refund_total > original[\"amount_cents\"]:\n            unresolved.extend(refunds)\n            continue\n        confirmed_refunds.extend(refunds)\n\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    issues_by_owner: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for issue in issues:\n        issues_by_owner[issue[\"owner\"]].append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row[\"record_id\"]) for key, value in sorted(issues_by_owner.items())}\n\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [],\n            \"missing_or_return_reason\": \"no supported authorized obligation was supplied for this claim revision\",\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n        issues_by_owner.setdefault(owner, []).append(obligation_issue)\n        issues_by_owner[owner].sort(key=lambda row: row[\"record_id\"])\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n            }\n    return {\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n    }\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            if item_id in queue[\"items\"]:\n                continue\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n    expected_batch = processed[-1] + 1 if processed else 1\n    if arrival_batch != expected_batch:\n        raise ValueError(f\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\")\n    if prior_result is None and predecessor is not None:\n        raise ValueError(\"the first integrated batch must have a null predecessor\")\n    if prior_result is not None:\n        if prior_result.get(\"snapshot\", {}).get(\"run_id\") != run_id:\n            raise ValueError(\"prior integration state belongs to a different run\")\n        if predecessor is None:\n            raise ValueError(\"a later integrated batch must carry a predecessor binding\")\n\n    domain = previous_domain\n    if authorized_obligations:\n        domain[\"authorized_obligations\"].update(deepcopy(authorized_obligations))\n    if source_classifications:\n        domain[\"source_classifications\"].update(deepcopy(source_classifications))\n    previous_claim_revisions = {\n        subject_id: value[\"current_revision\"]\n        for subject_id, value in (domain.get(\"revision_history\") or {}).get(\"claim\", {}).items()\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n        )\n    domain[\"finance_reconciliations\"] = finance_results\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n"},"started_at_ms":1792007444231,"completed_at_ms":1792007444272}}
{"timestamp":"2026-10-14T19:50:44.849Z","ordinal":609,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13bf7-9970-76f3-95e6-4b012480ed6e","call_id":"call_be478cb7c4dc4c6b9309a3957d79dc36","output":[{"type":"input_text","text":"Script completed\nWall time 0.8 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"edb849\",\"wall_time_seconds\":0.04129851,\"exit_code\":0,\"original_token_count\":8651,\"output\":\"?? artifacts/runs/\\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n\\\"\\\"\\\"Source-traceable Finance reconciliation primitives.\\n\\nOnly explicit, source-classified settled and refund events affect confirmed\\ncash. Finance obligations remain separate from caller-supplied authorized\\nobligations. No policy entitlement or approval decision is made here.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom collections import defaultdict\\nfrom copy import deepcopy\\nfrom decimal import Decimal, InvalidOperation\\nfrom typing import Any\\n\\n\\n_NATIVE_EVENT_CLASSES = {\\n    \\\"accepted\\\": \\\"obligation_accepted\\\",\\n    \\\"settled\\\": \\\"confirmed_payment\\\",\\n    \\\"refund\\\": \\\"confirmed_refund\\\",\\n    \\\"failed\\\": \\\"failed_transfer\\\",\\n    \\\"retry_authorized\\\": \\\"retry_authorization\\\",\\n    \\\"cancellation_requested\\\": \\\"finance_cancellation_requested\\\",\\n    \\\"cancelled\\\": \\\"finance_cancelled\\\",\\n    # These are retained as non-cash Finance records; their amount describes\\n    # an obligation, not a payment.\\n    \\\"adjustment\\\": \\\"finance_adjustment\\\",\\n    \\\"resolution\\\": \\\"finance_resolution\\\",\\n}\\n\\n\\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\\n    return {key: cell.get(\\\"value\\\") for key, cell in record.get(\\\"values\\\", {}).items()}\\n\\n\\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\\n    return {key: record.get(key) for key in (\\\"source_id\\\", \\\"source_sha256\\\", \\\"locator\\\")}\\n\\n\\ndef _cents(value: Any) -> int | None:\\n    \\\"\\\"\\\"Convert exact EUR decimal input to integer cents; reject rounding.\\\"\\\"\\\"\\n    if value is None or isinstance(value, bool):\\n        return None\\n    try:\\n        amount = Decimal(str(value))\\n    except (InvalidOperation, ValueError):\\n        return None\\n    if not amount.is_finite():\\n        return None\\n    scaled = amount * 100\\n    if scaled != scaled.to_integral_value() or scaled < 0:\\n        return None\\n    return int(scaled)\\n\\n\\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\\n    return {key: values[key] for key in sorted(values) if key != \\\"Arrival batch\\\"}\\n\\n\\ndef reconcile_finance_events(\\n    events: list[dict[str, Any]],\\n    *,\\n    claim_id: str,\\n    current_revision: int,\\n    authorized_obligation: dict[str, Any] | None = None,\\n    revision_history: list[dict[str, Any]] | None = None,\\n    previous_reconciliation: dict[str, Any] | None = None,\\n    owner: str = \\\"Finance\\\",\\n    source_classifications: dict[str, str] | None = None,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Reconcile source events for a claim without making policy decisions.\\n\\n    `authorized_obligation` is an independent, already-authorized input of\\n    `{amount_cents, claim_revision, source_refs}`. This function neither\\n    derives nor authorizes it. `source_classifications` may extend the native\\n    workbook vocabulary when a retained source defines another event type;\\n    unrecognized types otherwise remain unresolved.\\n    \\\"\\\"\\\"\\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\\n        raise ValueError(\\\"claim_id and a positive current_revision are required\\\")\\n    if not owner:\\n        raise ValueError(\\\"owner is required for reconciliation issues\\\")\\n\\n    classes = dict(_NATIVE_EVENT_CLASSES)\\n    if source_classifications:\\n        allowed_classes = {\\n            \\\"confirmed_payment\\\", \\\"confirmed_refund\\\", \\\"pending_transfer\\\",\\n            \\\"obligation_accepted\\\", \\\"failed_transfer\\\", \\\"retry_authorization\\\",\\n            \\\"finance_cancellation_requested\\\", \\\"finance_cancelled\\\",\\n            \\\"finance_adjustment\\\", \\\"finance_resolution\\\",\\n        }\\n        for event_type, classification in source_classifications.items():\\n            if not isinstance(event_type, str) or classification not in allowed_classes:\\n                raise ValueError(f\\\"unsupported source event classification: {event_type!r} -> {classification!r}\\\")\\n            classes[event_type] = classification\\n\\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\\n    missing_id_records: list[dict[str, Any]] = []\\n    for record in events:\\n        event_id = _values(record).get(\\\"Activity reference\\\")\\n        if not isinstance(event_id, str) or not event_id:\\n            if _values(record).get(\\\"Claim reference\\\") == claim_id:\\n                missing_id_records.append(record)\\n        else:\\n            by_id[event_id].append(record)\\n\\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\\n    duplicate_events = []\\n    conflicting_events = []\\n    for event_id, occurrences in by_id.items():\\n        relevant = [record for record in occurrences if _values(record).get(\\\"Claim reference\\\") == claim_id]\\n        if not relevant:\\n            continue\\n        payloads = [_payload(_values(record)) for record in occurrences]\\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\\n        for record in relevant:\\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\\n        if conflict:\\n            conflicting_events.append({\\n                \\\"event_id\\\": event_id,\\n                \\\"source_refs\\\": [_source_ref(record) for record in occurrences],\\n                \\\"payloads\\\": payloads,\\n            })\\n        elif len(occurrences) > 1:\\n            duplicate_events.append({\\n                \\\"event_id\\\": event_id,\\n                \\\"source_refs\\\": [_source_ref(record) for record in occurrences],\\n                \\\"delivery_batches\\\": [_values(record).get(\\\"Arrival batch\\\") for record in occurrences],\\n            })\\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\\n    relevant_occurrences.sort(key=lambda row: (\\n        str(row[2].get(\\\"Arrival batch\\\") or \\\"\\\"),\\n        int(row[1].get(\\\"row\\\") or 0),\\n        row[0] or \\\"\\\",\\n    ))\\n\\n    history = []\\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\\n    typed = []\\n    unresolved = []\\n    for event_id, record, values, conflict in relevant_occurrences:\\n        event_type = values.get(\\\"Activity type\\\")\\n        classification = classes.get(event_type, \\\"unresolved\\\")\\n        item = {\\n            \\\"event_id\\\": event_id,\\n            \\\"source_ref\\\": _source_ref(record),\\n            \\\"source_record\\\": deepcopy(values),\\n            \\\"event_type\\\": event_type,\\n            \\\"classification\\\": (\\n                \\\"conflicting_event_id\\\" if conflict and event_id else\\n                \\\"missing_event_id\\\" if conflict else classification\\n            ),\\n            \\\"amount_cents\\\": _cents(values.get(\\\"Amount (EUR)\\\")),\\n            \\\"obligation_cents\\\": _cents(values.get(\\\"Obligation (EUR)\\\")),\\n            \\\"currency\\\": values.get(\\\"Currency\\\"),\\n            \\\"original_activity_id\\\": values.get(\\\"Original activity reference\\\"),\\n        }\\n        history.append(item)\\n        if conflict:\\n            if event_id:\\n                event_issue_by_id[event_id] = {\\n                    \\\"record_id\\\": f\\\"finance-event-conflict:{event_id}\\\",\\n                    \\\"event_id\\\": event_id,\\n                    \\\"subject_type\\\": \\\"claim\\\",\\n                    \\\"subject_id\\\": claim_id,\\n                    \\\"revision\\\": current_revision,\\n                    \\\"missing_or_return_reason\\\": \\\"same Finance event ID has conflicting source content; none of its occurrences were counted\\\",\\n                    \\\"source_refs\\\": [_source_ref(row) for row in by_id[event_id]],\\n                    \\\"owner\\\": owner,\\n                    \\\"next_action\\\": \\\"Finance to resolve the source record conflict\\\",\\n                }\\n            else:\\n                event_issue_by_id[f\\\"missing:{record.get('locator')}\\\"] = {\\n                    \\\"record_id\\\": f\\\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\\\",\\n                    \\\"event_id\\\": None,\\n                    \\\"subject_type\\\": \\\"claim\\\",\\n                    \\\"subject_id\\\": claim_id,\\n                    \\\"revision\\\": current_revision,\\n                    \\\"missing_or_return_reason\\\": \\\"Finance event has no activity reference and cannot be safely deduplicated or counted\\\",\\n                    \\\"source_refs\\\": [_source_ref(record)],\\n                    \\\"owner\\\": owner,\\n                    \\\"next_action\\\": \\\"Finance to identify this ledger event and provide its native activity reference\\\",\\n                }\\n            continue\\n        if classification == \\\"unresolved\\\":\\n            unresolved.append(item)\\n            continue\\n        if classification in {\\\"confirmed_payment\\\", \\\"confirmed_refund\\\"}:\\n            if values.get(\\\"Currency\\\") != \\\"EUR\\\" or item[\\\"amount_cents\\\"] is None:\\n                unresolved.append(item)\\n                continue\\n        typed.append(item)\\n\\n    payments = {item[\\\"event_id\\\"]: item for item in typed if item[\\\"classification\\\"] == \\\"confirmed_payment\\\"}\\n    confirmed_refunds: list[dict[str, Any]] = []\\n    refund_candidates = [item for item in typed if item[\\\"classification\\\"] == \\\"confirmed_refund\\\"]\\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\\n    for item in refund_candidates:\\n        original_id = item[\\\"original_activity_id\\\"]\\n        original = payments.get(original_id) if isinstance(original_id, str) else None\\n        if original is None or original.get(\\\"currency\\\") != item.get(\\\"currency\\\"):\\n            unresolved.append(item)\\n            continue\\n        refund_groups[original_id].append(item)\\n    for original_id, refunds in refund_groups.items():\\n        original = payments[original_id]\\n        refund_total = sum(item[\\\"amount_cents\\\"] for item in refunds)\\n        if refund_total > original[\\\"amount_cents\\\"]:\\n            unresolved.extend(refunds)\\n            continue\\n        confirmed_refunds.extend(refunds)\\n\\n    invalid_payments = [item for item in payments.values() if item[\\\"amount_cents\\\"] is None]\\n    unresolved.extend(invalid_payments)\\n    confirmed_payment_cents = sum(item[\\\"amount_cents\\\"] for item in payments.values() if item[\\\"amount_cents\\\"] is not None)\\n    confirmed_refund_cents = sum(item[\\\"amount_cents\\\"] for item in confirmed_refunds)\\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\\n\\n    issues = list(event_issue_by_id.values())\\n    for number, item in enumerate(unresolved, 1):\\n        issue_id = f\\\"finance-unresolved:{item['event_id'] or number}\\\"\\n        issue = {\\n            \\\"record_id\\\": issue_id,\\n            \\\"event_id\\\": item[\\\"event_id\\\"],\\n            \\\"subject_type\\\": \\\"claim\\\",\\n            \\\"subject_id\\\": claim_id,\\n            \\\"revision\\\": current_revision,\\n            \\\"source_refs\\\": [item[\\\"source_ref\\\"]],\\n            \\\"missing_or_return_reason\\\": (\\n                f\\\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\\\"\\n            ),\\n            \\\"owner\\\": owner,\\n            \\\"next_action\\\": \\\"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\\\",\\n        }\\n        issues.append(issue)\\n    issues_by_owner: dict[str, list[dict[str, Any]]] = defaultdict(list)\\n    for issue in issues:\\n        issues_by_owner[issue[\\\"owner\\\"]].append(issue)\\n    issues_by_owner = {key: sorted(value, key=lambda row: row[\\\"record_id\\\"]) for key, value in sorted(issues_by_owner.items())}\\n\\n    obligation = None\\n    obligation_issue = None\\n    if authorized_obligation is not None:\\n        amount = authorized_obligation.get(\\\"amount_cents\\\")\\n        obligation_revision = authorized_obligation.get(\\\"claim_revision\\\")\\n        refs = authorized_obligation.get(\\\"source_refs\\\")\\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\\n                and obligation_revision == current_revision and isinstance(refs, list)\\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\\n            obligation = {\\\"amount_cents\\\": amount, \\\"claim_revision\\\": obligation_revision, \\\"source_refs\\\": list(dict.fromkeys(refs))}\\n        else:\\n            obligation_issue = {\\n                \\\"record_id\\\": f\\\"finance-obligation-invalid:{claim_id}:{current_revision}\\\",\\n                \\\"event_id\\\": None,\\n                \\\"subject_type\\\": \\\"claim\\\",\\n                \\\"subject_id\\\": claim_id,\\n                \\\"revision\\\": current_revision,\\n                \\\"source_refs\\\": list(refs) if isinstance(refs, list) else [],\\n                \\\"missing_or_return_reason\\\": \\\"authorized obligation is missing exact cents, current-revision match, or supporting source reference\\\",\\n                \\\"owner\\\": owner,\\n                \\\"next_action\\\": \\\"Finance to provide or confirm the authorized obligation for this claim revision\\\",\\n            }\\n    else:\\n        obligation_issue = {\\n            \\\"record_id\\\": f\\\"finance-obligation-missing:{claim_id}:{current_revision}\\\",\\n            \\\"event_id\\\": None,\\n            \\\"subject_type\\\": \\\"claim\\\",\\n            \\\"subject_id\\\": claim_id,\\n            \\\"revision\\\": current_revision,\\n            \\\"source_refs\\\": [],\\n            \\\"missing_or_return_reason\\\": \\\"no supported authorized obligation was supplied for this claim revision\\\",\\n            \\\"owner\\\": owner,\\n            \\\"next_action\\\": \\\"Finance to provide or confirm the authorized obligation for this claim revision\\\",\\n        }\\n    if obligation_issue is not None:\\n        issues.append(obligation_issue)\\n        issues_by_owner.setdefault(owner, []).append(obligation_issue)\\n        issues_by_owner[owner].sort(key=lambda row: row[\\\"record_id\\\"])\\n\\n    has_unclassified_cash_event = any(item[\\\"classification\\\"] == \\\"unresolved\\\" for item in history)\\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\\n    balance = None\\n    if obligation is not None and event_set_complete:\\n        balance = obligation[\\\"amount_cents\\\"] - net_confirmed_cents\\n\\n    invalidated = None\\n    if previous_reconciliation is not None:\\n        previous_revision = previous_reconciliation.get(\\\"claim_revision\\\")\\n        if previous_revision != current_revision:\\n            invalidated = {\\n                \\\"claim_revision\\\": previous_revision,\\n                \\\"reason\\\": \\\"material revision change invalidates the prior reconciliation basis\\\",\\n                \\\"prior_net_confirmed_cents\\\": previous_reconciliation.get(\\\"net_confirmed_cents\\\"),\\n                \\\"prior_balance_cents\\\": previous_reconciliation.get(\\\"balance_cents\\\"),\\n            }\\n    return {\\n        \\\"claim_id\\\": claim_id,\\n        \\\"claim_revision\\\": current_revision,\\n        \\\"revision_history\\\": deepcopy(revision_history or []),\\n        \\\"event_history\\\": history,\\n        \\\"event_ids\\\": [item[\\\"event_id\\\"] for item in history if item[\\\"event_id\\\"] is not None],\\n        \\\"duplicate_events\\\": duplicate_events,\\n        \\\"conflicting_events\\\": conflicting_events,\\n        \\\"confirmed_payment_event_ids\\\": [item[\\\"event_id\\\"] for item in payments.values() if item[\\\"amount_cents\\\"] is not None],\\n        \\\"confirmed_refund_event_ids\\\": [item[\\\"event_id\\\"] for item in confirmed_refunds],\\n        \\\"pending_transfer_event_ids\\\": [item[\\\"event_id\\\"] for item in typed if item[\\\"classification\\\"] == \\\"pending_transfer\\\"],\\n        \\\"unresolved_event_ids\\\": list(dict.fromkeys(item[\\\"event_id\\\"] for item in unresolved if item[\\\"event_id\\\"] is not None)),\\n        \\\"finance_obligation_events\\\": [item for item in history if item[\\\"classification\\\"] == \\\"obligation_accepted\\\"],\\n        \\\"authorized_obligation\\\": obligation,\\n        \\\"confirmed_payment_cents\\\": confirmed_payment_cents,\\n        \\\"confirmed_refund_cents\\\": confirmed_refund_cents,\\n        \\\"net_confirmed_cents\\\": net_confirmed_cents,\\n        \\\"balance_cents\\\": balance,\\n        \\\"inputs_complete\\\": balance is not None,\\n        \\\"repair_issues\\\": issues,\\n        \\\"repair_issues_by_owner\\\": issues_by_owner,\\n        \\\"invalidated_previous_reconciliation\\\": invalidated,\\n    }\\n\\\"\\\"\\\"Synthetic fixtures for policy-independent financial reconciliation.\\\"\\\"\\\"\\n\\nfrom copy import deepcopy\\n\\nfrom travel_claim.finance import reconcile_finance_events\\n\\n\\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\\\"C-SYN-01\\\", amount=None,\\n                 obligation=None, original=None, currency=\\\"EUR\\\"):\\n    values = {\\n        \\\"Activity reference\\\": event_id,\\n        \\\"Arrival batch\\\": batch,\\n        \\\"Activity type\\\": event_type,\\n        \\\"Claim reference\\\": claim,\\n        \\\"Currency\\\": currency,\\n        \\\"Reason\\\": f\\\"SYNTHETIC fixture {event_type}\\\",\\n    }\\n    if amount is not None:\\n        values[\\\"Amount (EUR)\\\"] = amount\\n    if obligation is not None:\\n        values[\\\"Obligation (EUR)\\\"] = obligation\\n    if original is not None:\\n        values[\\\"Original activity reference\\\"] = original\\n    return {\\n        \\\"source_id\\\": \\\"synthetic-finance-ledger\\\",\\n        \\\"source_sha256\\\": \\\"c\\\" * 64,\\n        \\\"locator\\\": f\\\"synthetic tab 'Finance activity', row {row}\\\",\\n        \\\"row\\\": row,\\n        \\\"values\\\": {\\n            key: {\\\"value\\\": value, \\\"source_text\\\": str(value), \\\"cell\\\": f\\\"A{row}\\\"}\\n            for key, value in values.items()\\n        },\\n    }\\n\\n\\ndef _obligation(amount=15_000, revision=1):\\n    return {\\\"amount_cents\\\": amount, \\\"claim_revision\\\": revision, \\\"source_refs\\\": [\\\"synthetic:authorization#1\\\"]}\\n\\n\\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-ACCEPT\\\", \\\"accepted\\\", obligation=150.00),\\n        _finance_row(2, \\\"F-SYN-PAY-1\\\", \\\"settled\\\", amount=100.01),\\n        _finance_row(3, \\\"F-SYN-PAY-2\\\", \\\"settled\\\", amount=50.00),\\n        _finance_row(4, \\\"F-SYN-REFUND\\\", \\\"refund\\\", amount=20.00, original=\\\"F-SYN-PAY-1\\\"),\\n        _finance_row(5, \\\"F-SYN-PENDING\\\", \\\"transfer_pending\\\", amount=79.99),\\n    ]\\n    result = reconcile_finance_events(\\n        events,\\n        claim_id=\\\"C-SYN-01\\\",\\n        current_revision=1,\\n        authorized_obligation=_obligation(),\\n        source_classifications={\\\"transfer_pending\\\": \\\"pending_transfer\\\"},\\n    )\\n    assert result[\\\"finance_obligation_events\\\"][0][\\\"obligation_cents\\\"] == 15_000\\n    assert result[\\\"authorized_obligation\\\"][\\\"amount_cents\\\"] == 15_000\\n    assert result[\\\"confirmed_payment_cents\\\"] == 15_001\\n    assert result[\\\"confirmed_refund_cents\\\"] == 2_000\\n    assert result[\\\"net_confirmed_cents\\\"] == 13_001\\n    assert result[\\\"balance_cents\\\"] == 1_999\\n    assert result[\\\"pending_transfer_event_ids\\\"] == [\\\"F-SYN-PENDING\\\"]\\n    assert \\\"F-SYN-PENDING\\\" not in result[\\\"confirmed_payment_event_ids\\\"]\\n    assert result[\\\"event_history\\\"][0][\\\"source_record\\\"][\\\"Activity type\\\"] == \\\"accepted\\\"\\n    assert result[\\\"event_history\\\"][3][\\\"original_activity_id\\\"] == \\\"F-SYN-PAY-1\\\"\\n\\n\\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\\n    payment = _finance_row(5, \\\"F-SYN-PAY\\\", \\\"settled\\\", batch=1, amount=10.00)\\n    replay = _finance_row(22, \\\"F-SYN-PAY\\\", \\\"settled\\\", batch=4, amount=10.00)\\n    result = reconcile_finance_events(\\n        [payment, replay], claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(amount=1_000),\\n    )\\n    assert result[\\\"event_ids\\\"] == [\\\"F-SYN-PAY\\\", \\\"F-SYN-PAY\\\"]\\n    assert len(result[\\\"event_history\\\"]) == 2\\n    assert len(result[\\\"confirmed_payment_event_ids\\\"]) == 1\\n    assert result[\\\"confirmed_payment_cents\\\"] == 1_000\\n    assert result[\\\"duplicate_events\\\"][0][\\\"delivery_batches\\\"] == [1, 4]\\n    assert [item[\\\"source_ref\\\"][\\\"locator\\\"] for item in result[\\\"event_history\\\"]] == [\\n        \\\"synthetic tab 'Finance activity', row 5\\\",\\n        \\\"synthetic tab 'Finance activity', row 22\\\",\\n    ]\\n\\n\\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-CONFLICT\\\", \\\"settled\\\", amount=10.00),\\n        _finance_row(2, \\\"F-SYN-CONFLICT\\\", \\\"settled\\\", amount=11.00, batch=2),\\n        _finance_row(3, \\\"F-SYN-UNKNOWN\\\", \\\"mystery_state\\\", amount=20.00),\\n    ]\\n    result = reconcile_finance_events(\\n        events, claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(), owner=\\\"FIN-SYN-01\\\",\\n    )\\n    assert result[\\\"conflicting_events\\\"][0][\\\"event_id\\\"] == \\\"F-SYN-CONFLICT\\\"\\n    assert len(result[\\\"conflicting_events\\\"][0][\\\"source_refs\\\"]) == 2\\n    assert result[\\\"confirmed_payment_cents\\\"] == 0\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"unresolved_event_ids\\\"] == [\\\"F-SYN-UNKNOWN\\\"]\\n    assert list(result[\\\"repair_issues_by_owner\\\"]) == [\\\"FIN-SYN-01\\\"]\\n    assert {issue[\\\"record_id\\\"] for issue in result[\\\"repair_issues_by_owner\\\"][\\\"FIN-SYN-01\\\"]} == {\\n        \\\"finance-event-conflict:F-SYN-CONFLICT\\\", \\\"finance-unresolved:F-SYN-UNKNOWN\\\",\\n    }\\n    assert all(issue[\\\"source_refs\\\"] for issue in result[\\\"repair_issues\\\"])\\n\\n\\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\\n    events = [\\n        _finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=10.00),\\n        _finance_row(2, \\\"F-SYN-REFUND\\\", \\\"refund\\\", amount=10.01, original=\\\"F-SYN-PAY\\\"),\\n        _finance_row(3, \\\"F-SYN-REFUND-ORPHAN\\\", \\\"refund\\\", amount=1.00, original=\\\"F-NOT-FOUND\\\"),\\n    ]\\n    result = reconcile_finance_events(\\n        events, claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n        authorized_obligation=_obligation(amount=1_000),\\n    )\\n    assert result[\\\"confirmed_payment_cents\\\"] == 1_000\\n    assert result[\\\"confirmed_refund_cents\\\"] == 0\\n    assert result[\\\"net_confirmed_cents\\\"] == 1_000\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert set(result[\\\"unresolved_event_ids\\\"]) == {\\\"F-SYN-REFUND\\\", \\\"F-SYN-REFUND-ORPHAN\\\"}\\n\\n\\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\\n    prior = {\\n        \\\"claim_revision\\\": 1,\\n        \\\"net_confirmed_cents\\\": 10_000,\\n        \\\"balance_cents\\\": 5_000,\\n        \\\"event_history\\\": [{\\\"event_id\\\": \\\"F-SYN-PAY\\\", \\\"source_ref\\\": \\\"prior\\\"}],\\n    }\\n    prior_copy = deepcopy(prior)\\n    revisions = [\\n        {\\\"revision\\\": 1, \\\"source_ref\\\": \\\"synthetic:claim#1\\\"},\\n        {\\\"revision\\\": 2, \\\"source_ref\\\": \\\"synthetic:claim#2\\\"},\\n    ]\\n    result = reconcile_finance_events(\\n        [_finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=100.00)],\\n        claim_id=\\\"C-SYN-01\\\",\\n        current_revision=2,\\n        authorized_obligation=_obligation(amount=15_000, revision=1),\\n        revision_history=revisions,\\n        previous_reconciliation=prior,\\n    )\\n    assert result[\\\"revision_history\\\"] == revisions\\n    assert result[\\\"confirmed_payment_cents\\\"] == 10_000\\n    assert result[\\\"authorized_obligation\\\"] is None\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"invalidated_previous_reconciliation\\\"][\\\"claim_revision\\\"] == 1\\n    assert result[\\\"repair_issues_by_owner\\\"][\\\"Finance\\\"][0][\\\"record_id\\\"] == \\\"finance-obligation-invalid:C-SYN-01:2\\\"\\n    assert prior == prior_copy\\n\\n\\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\\n    result = reconcile_finance_events(\\n        [_finance_row(1, \\\"F-SYN-PAY\\\", \\\"settled\\\", amount=10.00)],\\n        claim_id=\\\"C-SYN-01\\\", current_revision=1,\\n    )\\n    assert result[\\\"net_confirmed_cents\\\"] == 1_000\\n    assert result[\\\"balance_cents\\\"] is None\\n    assert result[\\\"repair_issues_by_owner\\\"][\\\"Finance\\\"][0][\\\"record_id\\\"] == \\\"finance-obligation-missing:C-SYN-01:1\\\"\\n\\\"\\\"\\\"Arrival-ordered, policy-neutral integration of Project D records.\\n\\nThis module prepares schema-shaped batch state but never seals snapshots,\\ninfers eligibility, applies review decisions, or authorizes obligations.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport json\\nfrom copy import deepcopy\\nfrom typing import Any\\n\\nfrom .finance import reconcile_finance_events\\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\\nfrom .workflow import (\\n    build_revision_history,\\n    match_decisions_to_subjects,\\n    reduce_cancellation_activities,\\n    row_values,\\n)\\n\\n\\n_REVALIDATION_AREAS = (\\n    (\\\"expense-evidence\\\", \\\"recheck expense evidence against the corrected claim revision\\\", \\\"employee\\\"),\\n    (\\\"calculations\\\", \\\"recalculate and verify amounts for the corrected claim revision\\\", \\\"Travel Administration Lead\\\"),\\n    (\\\"trip-permit\\\", \\\"recheck trip and permit identity and revision consistency\\\", \\\"Travel Administration Lead\\\"),\\n    (\\\"approvals\\\", \\\"obtain current-revision decisions; prior decisions remain historical only\\\", \\\"Travel Administration Lead\\\"),\\n    (\\\"finance-authorization\\\", \\\"revalidate Finance authorization for the corrected claim revision\\\", \\\"Finance\\\"),\\n)\\n\\n\\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\\n    return {field.get(\\\"label\\\", \\\"\\\").strip(): field.get(\\\"value\\\") for field in record.get(\\\"fields\\\", [])}\\n\\n\\ndef _page_batch(record: dict[str, Any]) -> int | None:\\n    value = _page_values(record).get(\\\"Arrival batch\\\")\\n    return _as_batch(value)\\n\\n\\ndef _as_batch(value: Any) -> int | None:\\n    if isinstance(value, bool) or value is None:\\n        return None\\n    try:\\n        number = int(value)\\n    except (ValueError, TypeError, OverflowError):\\n        return None\\n    return number if number > 0 and float(value) == number else None\\n\\n\\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\\n    return {key: record.get(key) for key in (\\\"source_id\\\", \\\"source_sha256\\\", \\\"locator\\\")}\\n\\n\\ndef _ref_text(reference: dict[str, Any]) -> str:\\n    return f\\\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\\\"\\n\\n\\ndef _stamp(value: Any) -> str | None:\\n    \\\"\\\"\\\"Project an explicitly UTC source field into the schema's date-time form.\\\"\\\"\\\"\\n    if not isinstance(value, str) or not value:\\n        return None\\n    if value.endswith(\\\"Z\\\") or \\\"+\\\" in value[10:] or \\\"-\\\" in value[10:]:\\n        return value\\n    return f\\\"{value}Z\\\"\\n\\n\\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\\n    records = parsed.get(\\\"records\\\", {})\\n    selected = {\\n        \\\"claim_revisions\\\": [row for row in records.get(\\\"claim_revisions\\\", []) if _page_batch(row) == arrival_batch],\\n        \\\"decisions\\\": [row for row in records.get(\\\"decisions\\\", []) if _as_batch(row_values(row).get(\\\"Arrival batch\\\")) == arrival_batch],\\n        \\\"finance_events\\\": [row for row in records.get(\\\"finance_events\\\", []) if _as_batch(row_values(row).get(\\\"Arrival batch\\\")) == arrival_batch],\\n        \\\"cancellation_activities\\\": [row for row in records.get(\\\"cancellation_activities\\\", []) if _as_batch(row_values(row).get(\\\"Arrival batch\\\")) == arrival_batch],\\n    }\\n    selected[\\\"claim_revisions\\\"].sort(key=lambda row: (row.get(\\\"page\\\", 0), _ref(row).get(\\\"locator\\\") or \\\"\\\"))\\n    for kind in (\\\"decisions\\\", \\\"finance_events\\\", \\\"cancellation_activities\\\"):\\n        selected[kind].sort(key=lambda row: (row.get(\\\"row\\\", 0), _ref(row).get(\\\"locator\\\") or \\\"\\\"))\\n    return selected\\n\\n\\ndef _digest(value: Any) -> str:\\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\\\",\\\", \\\":\\\"), default=str).encode(\\\"utf-8\\\")\\n    return hashlib.sha256(payload).hexdigest()\\n\\n\\ndef _domain_seed() -> dict[str, Any]:\\n    return {\\n        \\\"processed_batches\\\": [],\\n        \\\"batch_input_hashes\\\": {},\\n        \\\"claim_records\\\": [],\\n        \\\"decision_records\\\": [],\\n        \\\"finance_records\\\": [],\\n        \\\"cancellation_records\\\": [],\\n        \\\"revision_history\\\": None,\\n        \\\"decision_history\\\": [],\\n        \\\"finance_reconciliations\\\": {},\\n        \\\"authorized_obligations\\\": {},\\n        \\\"source_classifications\\\": {},\\n        \\\"cancellation_state\\\": {},\\n        \\\"material_corrections\\\": [],\\n        \\\"repair_queue\\\": new_repair_queue(),\\n        \\\"policy_clock_blockers\\\": [],\\n        \\\"structural_blockers\\\": [],\\n        \\\"projection_issues\\\": [],\\n    }\\n\\n\\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\\n    return {\\n        \\\"record_id\\\": item[\\\"item_id\\\"],\\n        \\\"reason\\\": item[\\\"missing_or_return_reason\\\"],\\n        \\\"owner\\\": item[\\\"owner\\\"],\\n        \\\"resolution_needed\\\": item[\\\"next_action\\\"],\\n        \\\"subject_type\\\": item[\\\"subject_type\\\"],\\n        \\\"subject_id\\\": item[\\\"subject_id\\\"],\\n        \\\"revision\\\": item[\\\"revision\\\"],\\n        \\\"source_refs\\\": item[\\\"source_refs\\\"],\\n        \\\"run_id\\\": item[\\\"run_id\\\"],\\n        \\\"batch_id\\\": item[\\\"batch_id\\\"],\\n    }\\n\\n\\ndef _open_issue_for_subject(\\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\\n    run_id: str, batch_id: str,\\n) -> None:\\n    if item_id not in queue[\\\"items\\\"]:\\n        add_repair_item(\\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\\n        )\\n\\n\\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\\n    queue = domain[\\\"repair_queue\\\"]\\n    for claim_id, result in reconciliations.items():\\n        for issue in result[\\\"repair_issues\\\"]:\\n            item_id = f\\\"finance:{issue['record_id']}\\\"\\n            if item_id in queue[\\\"items\\\"]:\\n                continue\\n            refs = [_ref_text(ref) for ref in issue.get(\\\"source_refs\\\", []) if isinstance(ref, dict)]\\n            _open_issue_for_subject(\\n                queue, item_id=item_id, subject_type=\\\"claim\\\", subject_id=claim_id,\\n                revision=result[\\\"claim_revision\\\"], refs=refs,\\n                reason=issue.get(\\\"missing_or_return_reason\\\", issue.get(\\\"reason\\\", \\\"Finance evidence unresolved\\\")),\\n                owner=issue[\\\"owner\\\"],\\n                next_action=issue.get(\\\"next_action\\\", \\\"Finance to resolve the identified item\\\"),\\n                run_id=run_id, batch_id=batch_id,\\n            )\\n\\n\\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\\n    return history.get(\\\"claim\\\", {})\\n\\n\\ndef _material_correction_tasks(\\n\\ndef integrate_arrival_batch(\\n    parsed: dict[str, Any],\\n    *,\\n    arrival_batch: int,\\n    run_id: str,\\n    batch_id: str,\\n    source_binding: dict[str, str],\\n    predecessor: dict[str, str] | None = None,\\n    prior_result: dict[str, Any] | None = None,\\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\\n    source_classifications: dict[str, str] | None = None,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Integrate exactly the next arrival batch into a schema-shaped projection.\\n\\n    The function retains raw subject/activity rows in a sidecar `domain`,\\n    carries earlier state forward, and supports exact same-batch replay. It\\n    does not consume or seal a scenario snapshot; callers must separately\\n    verify access, case clock, policy, and authorities before doing that.\\n    \\\"\\\"\\\"\\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\\n        raise ValueError(\\\"arrival_batch must be a positive integer\\\")\\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\\n        raise ValueError(\\\"run_id, batch_id, and source_binding are required\\\")\\n    delta = _delta(parsed, arrival_batch)\\n    digest = _digest({\\n        \\\"delta\\\": delta,\\n        \\\"run_id\\\": run_id,\\n        \\\"batch_id\\\": batch_id,\\n        \\\"source_binding\\\": source_binding,\\n        \\\"predecessor\\\": predecessor,\\n        \\\"authorized_obligations\\\": authorized_obligations or {},\\n        \\\"source_classifications\\\": source_classifications or {},\\n        \\\"trip_reference_records\\\": parsed.get(\\\"records\\\", {}).get(\\\"trips\\\", []),\\n        \\\"unresolved_issues\\\": parsed.get(\\\"unresolved_issues\\\", []),\\n    })\\n    previous_domain = deepcopy(prior_result[\\\"domain\\\"]) if prior_result else _domain_seed()\\n    processed = previous_domain[\\\"processed_batches\\\"]\\n    if processed and arrival_batch == processed[-1]:\\n        if previous_domain[\\\"batch_input_hashes\\\"].get(str(arrival_batch)) == digest:\\n            return deepcopy(prior_result)\\n        raise ValueError(f\\\"conflicting replay for arrival batch {arrival_batch}\\\")\\n    expected_batch = processed[-1] + 1 if processed else 1\\n    if arrival_batch != expected_batch:\\n        raise ValueError(f\\\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\\\")\\n    if prior_result is None and predecessor is not None:\\n        raise ValueError(\\\"the first integrated batch must have a null predecessor\\\")\\n    if prior_result is not None:\\n        if prior_result.get(\\\"snapshot\\\", {}).get(\\\"run_id\\\") != run_id:\\n            raise ValueError(\\\"prior integration state belongs to a different run\\\")\\n        if predecessor is None:\\n            raise ValueError(\\\"a later integrated batch must carry a predecessor binding\\\")\\n\\n    domain = previous_domain\\n    if authorized_obligations:\\n        domain[\\\"authorized_obligations\\\"].update(deepcopy(authorized_obligations))\\n    if source_classifications:\\n        domain[\\\"source_classifications\\\"].update(deepcopy(source_classifications))\\n    previous_claim_revisions = {\\n        subject_id: value[\\\"current_revision\\\"]\\n        for subject_id, value in (domain.get(\\\"revision_history\\\") or {}).get(\\\"claim\\\", {}).items()\\n    }\\n    for name in (\\\"claim_revisions\\\", \\\"decisions\\\", \\\"finance_events\\\", \\\"cancellation_activities\\\"):\\n        target_name = {\\n            \\\"claim_revisions\\\": \\\"claim_records\\\", \\\"decisions\\\": \\\"decision_records\\\",\\n            \\\"finance_events\\\": \\\"finance_records\\\", \\\"cancellation_activities\\\": \\\"cancellation_records\\\",\\n        }[name]\\n        domain[target_name].extend(deepcopy(delta[name]))\\n    domain[\\\"processed_batches\\\"].append(arrival_batch)\\n    domain[\\\"batch_input_hashes\\\"][str(arrival_batch)] = digest\\n\\n    history = build_revision_history({\\n        \\\"records\\\": {\\\"claim_revisions\\\": domain[\\\"claim_records\\\"], \\\"trips\\\": parsed.get(\\\"records\\\", {}).get(\\\"trips\\\", [])}\\n    })\\n    domain[\\\"revision_history\\\"] = history\\n    domain[\\\"decision_history\\\"] = match_decisions_to_subjects(domain[\\\"decision_records\\\"], history)\\n    for decision, raw in zip(domain[\\\"decision_history\\\"], domain[\\\"decision_records\\\"]):\\n        decision[\\\"arrival_batch\\\"] = row_values(raw).get(\\\"Arrival batch\\\")\\n        decision[\\\"applied\\\"] = False\\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\\n    _material_correction_tasks(\\n        domain, history=history, run_id=run_id, batch_id=batch_id,\\n        previous_revisions=previous_claim_revisions,\\n    )\\n\\n    current_claims = {}\\n    for claim_id, record_set in history.get(\\\"claim\\\", {}).items():\\n        current_revision = record_set[\\\"current_revision\\\"]\\n        claim_revision = next(row for row in reversed(record_set[\\\"revisions\\\"]) if row[\\\"revision\\\"] == current_revision)\\n        current_claims[claim_id] = claim_revision\\n    finance_results = {}\\n    for claim_id, claim_revision in current_claims.items():\\n        record_set = history[\\\"claim\\\"][claim_id]\\n        prior_finance = domain[\\\"finance_reconciliations\\\"].get(claim_id)\\n        finance_results[claim_id] = reconcile_finance_events(\\n            domain[\\\"finance_records\\\"], claim_id=claim_id,\\n            current_revision=claim_revision[\\\"revision\\\"],\\n            authorized_obligation=domain[\\\"authorized_obligations\\\"].get(claim_id),\\n            revision_history=record_set[\\\"revisions\\\"],\\n            previous_reconciliation=prior_finance,\\n            source_classifications=domain[\\\"source_classifications\\\"],\\n        )\\n    domain[\\\"finance_reconciliations\\\"] = finance_results\\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\\n\\n    # Policy and case-clock blockers are copied from parser/source evidence and\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13bf7