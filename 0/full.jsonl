   15\t\n    16\tROLE_FIELDS = {\"administration\": \"Administration reviewer\", \"budget_owner\": \"Budget owner\",\n    17\t               \"supervisor\": \"Supervisor\", \"director\": \"Director\"}\n    18\t\n    19\t\n    20\tdef ref(row):\n    21\t    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n    22\t\n    23\t\n    24\tdef fields(row):\n    25\t    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n    26\t\n    27\t\n    28\tdef table(parsed, key, tab):\n    29\t    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == tab), []))\n    30\t\n    31\t\n    32\tdef expense_lines(record):\n    33\t    \"\"\"Read complete rows from the retained PDF layout; never guess a row.\"\"\"\n    34\t    pattern = re.compile(r'^\\s*(\\d+)\\s+(\\S+)\\s+(\\S+)\\s+(\\d{4}-\\d{2}-\\d{2})\\s+([\\d,]+\\.\\d{2})\\s+([A-Z]{3})\\s*$', re.M)\n    35\t    return [dict(line=int(m[1]), cost_id=m[2], receipt_id=m[3], first_submitted_date=m[4],\n    36\t                 original_cents=_cents(m[5].replace(',', '')), currency=m[6], source_refs=[ref(record)])\n    37\t            for m in pattern.finditer(record.get('text', ''))]\n    38\t\n    39\t\n    40\tdef connect_claim(*, parsed, claim, decisions, finance_events, finance, cancellations,\n    41\t                  arrival_batch, source_observations, prior_finance=None, source_classifications=None):\n    42\t    \"\"\"Evaluate an ordinary path; each result keeps its evidence and owner.\"\"\"\n    43\t    record = claim['record']; values = fields(record)\n    44\t    claim_id, revision = claim['subject_id'], claim['revision']\n    45\t    employee, trip_id = values.get('Employee'), claim.get('trip_id')\n    46\t    stages = []\n    47\t    def stage(name, condition, refs, detail, owner, action, fail=False):\n    48\t        row = dict(stage=name, status='PASS' if condition