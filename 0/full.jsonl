e__ import annotations\n\nimport hashlib\nimport io\nfrom http.client import HTTPException, IncompleteRead\nimport json\nimport re\nimport urllib.error\nimport urllib.request\nimport zipfile\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Callable, Mapping\n\n\n@dataclass(frozen=True)\nclass NativeSource:\n    source_id: str\n    title: str\n    url: str\n    locator: str\n    export_url: str | None = None\n    kind: str = \"binary\"\n\n\nSOURCES: tuple[NativeSource, ...] = (\n    NativeSource(\n        \"policy-pol-2026-2\",\n        \"Travel reimbursement policy POL-2026.2\",\n        \"https://private-pecorino-70e.notion.site/REDACTED\",\n        \"Notion policy page body\",\n        kind=\"notion\",\n    ),\n    NativeSource(\n        \"initial-claim-binder\",\n        \"Initial claim binder\",\n        \"https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"claim-updates-binder\",\n        \"Claim updates binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"receipt-binder\",\n        \"Receipt binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"travel-registers-workbook\",\n        \"Travel registers workbook\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/edit\",\n        \"All workbook tabs via native XLSX export\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/export?format=xlsx\",\n        \"xlsx\",\n    ),\n)\n\n\ndef _utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef sha256_bytes(content: bytes) -> str:\n    return hashlib.sha256(content).hexdigest()\n\n\ndef _policy_page_is_relevant_html(content: bytes) -> bool:\n    text = content.decode(\"utf-8\", \"replace\")\n    # A successful response can still be only a generic Notion app/login shell.\n    has_policy_id = bool(re.search(r\"POL[- ]2026(?:\\.2|[- ]2)\", text, re.I))\n    has_policy_body = bool(re.search(r\"lodging|meal cap|permit approval|reimbursement\", text, re.I))\n    return has_policy_id and has_policy_body\n\n\ndef _validate_payload(source: NativeSource, content: bytes) -> tuple[bool, str | None, str | None]:\n    \"\"\"Return (usable, filename suffix, failure reason), without parsing case answers.\"\"\"\n    if source.kind == \"notion\":\n        if not content or not _policy_page_is_relevant_html(content):\n            return False, None, \"HTTP response contained a generic Notion shell; policy page content was not accessible\"\n        return True, \"html\", None\n    if source.kind == \"pdf\":\n        if not content.startswith(b\"%PDF-\") or b\"%%EOF\" not in content[-2048:]:\n            return False, None, \"Export did not contain a complete PDF signature and trailer\"\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n    source_observations: list[dict[str, Any]] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n        \"ordinary_evidence\": {key: parsed.get(key) for key in (\"records\", \"workbook_sheets\", \"case_clock\", \"event_clock\", \"evidence_mode\", \"expense_policy\")},\n        \"source_observations\": source_observations or [],\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n","stderr":"","aggregated_output":"90\t11\tsrc/travel_claim/completion.py\n58\t3\tsrc/travel_claim/expenses.py\n18\t6\tsrc/travel_claim/ordinary.py\n{\n  \"status\": \"BLOCKED\",\n  \"fresh_run\": \"artifacts/runs/project-d-live-20261014T204849Z\",\n  \"tests_passed\": 131,\n  \"git_diff_check\"