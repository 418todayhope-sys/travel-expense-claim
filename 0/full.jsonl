           raise ValueError('Missing/mismatched reviewed permit estimate')\\n   124\\t            if not set(cancellation_ids)<=set(str(pv.get('Travel cancellation references') or '').splitlines()):\\n   125\\t                raise ValueError('Packet lacks current cancellation context')\\n   126\\t            budget_refs=set(str(pv.get('Budget record references') or '').splitlines())\\n   127\\t            if not budget_refs or not budget_refs<=budget_ids: raise ValueError('Missing referenced budget records; no budget decision inferred')\\n   128\\t            stamp=utc_time(dv.get('Decision time (UTC)'))\\n   129\\t            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\\n   130\\t            if identity in identities and identities[identity][0]!=payload:\\n   131\\t                conflicts.add(identity)\\n   132\\t            elif identity not in identities: identities[identity]=(payload,item)\\n   133\\t            else:\\n   134\\t                item.update(import_status='exact-replay',replayed_decision_id=identity)\\n   135\\t                continue\\n   136\\t            from .budget import budget_reply_error\\n   137\\t            budget_error=budget_reply_error(budget_context,decision,ps[0]) if 'budget_owner' in roles else None\\n   138\\t            item['budget_evidence_valid']=not budget_error\\n   139\\t            item['budget_revalidation_reason']=budget_error\\n   140\\t            item.update(evidence_valid=True,import_status='valid',order=stamp.isoformat(),decision_time=stamp.isoformat())\\n   141\\t        except (ValueError,TypeError,InvalidOperation) as exc:\\n76:def _utc_now() -> str:\\n80:def sha256_bytes(content: bytes) -> str:\\n81:    return hashlib.sha256(content).hexdigest()\\n84:def _policy_page_is_relevant_html(content: bytes) -> bool:\\n86:    # A successful response can still be only a generic Notion app/login shell.\\n92:def _validate_payload(source: NativeSource, content: bytes) -> tuple[bool, str | None, str | None]:\\n96:            return False, None, \\\"HTTP response contained a generic Notion shell; policy page content was not accessible\\\"\\n112:    return (bool(content), \\\"bin\\\" if content else None, None if content else \\\"Empty response body\\\")\\n115:def _request(url: str, timeout: float) -> tuple[bytes, Mapping[str, str], str]:\\n117:    with urllib.request.urlopen(req, timeout=timeout) as response:\\n118:        headers = dict(response.headers.items())\\n119:        headers[\\\"X-Travel-Claim-HTTP-Status\\\"] = str(response.status)\\n121:            body = response.read()\\n123:            body = exc.partial\\n125:        return body, headers, response.geturl()\\n132:def assess_payload(source: NativeSource, body: bytes) -> tuple[str, str | None, str | None, list[str]]:\\n138:        return \\\"partial\\\", suffix, \\\"Policy-related HTML accessed, but complete native Notion page content is not established\\\", [\\\"Complete authoritative policy page body and all relevant blocks\\\"]\\n149:                return \\\"partial\\\", suffix, \\\"One or more PDF pages have no extractable text; visual/OCR verification required\\\", [\\\"Readable text or verified visual transcription of every PDF page\\\"]\\n156:                return \\\"partial\\\", suffix, \\\"Workbook export lacks required retained-source tabs\\\", missing\\n162:def capture_sources(\\n193:    (run_dir / \\\"responses\\\").mkdir()\\n215:        response_path = None\\n217:            response_path = f\\\"responses/{source.source_id}.body\\\"\\n218:            with (run_dir / response_path).open(\\\"xb\\\") as stream:\\n225:                state, error, missing = \\\"partial\\\" if suffix else \\\"unavailable\\\", f\\\"Incomplete HTTP response: status {status_code}, content range {normalized.get('content-range')}\\\", [source.title]\\n227:                state, error, missing = \\\"partial\\\" if suffix else \\\"unavailable\\\", normalized[\\\"x-travel-claim-read-error\\\"], [source.title]\\n231:                        state, error, missing = \\\"partial\\\" if suffix else \\\"unavailable\\\", \\\"Response byte length differs from Content-Length\\\", [source.title]\\n241:            \\\"sha256\\\": sha256_bytes(body) if rel_path else None,\\n247:                \\\"started_at\\\": started, \\\"completed_at\\\": completed, \\\"response_headers\\\": selected_headers,\\n248:                \\\"response_path\\\": response_path, \\\"response_sha256\\\": sha256_bytes(body) if body is not None else None,\\n249:                \\\"response_bytes\\\": len(body) if body is not None else None,\\n250:                \\\"content_version\\\": sha256_bytes(body) if body is not None else None,\\n259:def verify_source_manifest(run_dir: Path) -> list[str]:\\n289:            \\\"source_id\\\", \\\"path\\\", \\\"sha256\\\", \\\"status\\\", \\\"error\\\", \\\"url\\\", \\\"locator\\\",\\n313:        if record[\\\"status\\\"] in {\\\"read\\\", \\\"partial\\\"}:\\n41:def _money(value: Any, field: str, allow_negative: bool = False) -> int | None:\\n51:def write_claims_csv(claims: list[dict], path: Path) -> None:\\n68:            raise ValueError(f\\\"unsupported claim status {row['status']!r}\\\")\\n84:def new_repair_queue() -> dict:\\n88:def add_repair_item(\\n125:        \\\"response_id\\\": None,\\n140:def apply_partial_response(\\n143:    response_id: str,\\n148:    \\\"\\\"\\\"Record a supplied response against explicitly matched repair item IDs.\\n150:    Only `supported` plus at least one retained source reference resolves an\\n153:    allowed = {\\\"supported\\\", \\\"insufficient\\\", \\\"conflicting\\\", \\\"unanswered\\\"}\\n154:    if not response_id:\\n155:        raise ValueError(\\\"response_id is required\\\")\\n161:            raise KeyError(f\\\"response references unknown repair item {item_id}\\\")\\n163:            raise ValueError(f\\\"response outcome for {item_id} must be an object\\\")\\n166:            raise ValueError(f\\\"invalid response outcome for {item_id}: {kind!r}\\\")\\n169:            raise ValueError(f\\\"response source_refs must be a list of references for {item_id}\\\")\\n170:        if kind == \\\"supported\\\" and not refs:\\n171:            raise ValueError(f\\\"supported response {item_id} requires source references\\\")\\n174:            raise ValueError(f\\\"response note must be a string or null for {item_id}\\\")\\n177:             if event.get(\\\"event\\\") == \\\"response-recorded\\\"\\n178:             and event.get(\\\"response_id\\\") == response_id\\n192:            raise ValueError(f\\\"conflicting replay for repair response {response_id}/{item_id}\\\")\\n195:    # Mutate only after every item in this partial response passed validation.\\n200:            \\\"response_id\\\": response_id,\\n209:        item[\\\"response_id\\\"] = response_id\\n210:        if kind == \\\"supported\\\":\\n216:            \\\"event\\\": \\\"response-recorded\\\",\\n218:            \\\"response_id\\\": response_id,\\n228:def update_repair_item(\\n245:    the prior response and fields in the append-only history.\\n284:        \\\"previous_status\\\": item[\\\"status\\\"], \\\"previous_response_id\\\": item[\\\"response_id\\\"],\\n292:        item[\\\"response_id\\\"] = None\\n301:def owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\\n308:def load_repair_queue(path: Path) -> dict:\\n317:        raise ValueError(\\\"unsupported repair queue version\\\")\\n335:def write_repair_queue(queue: dict, path: Path) -> None:\\n382:def record_evidence_validation(queue: dict, *, item_id: str, supported: bool,\\n384:    \\\"\\\"\\\"Record a local evidence recheck, not a fabricated human response.\\\"\\\"\\\"\\n386:    status = 'resolved' if supported else 'open'\\n387:    if supported and not source_refs:\\n388:        raise ValueError('Evidence-supported resolution requires retained references')\\n393:                 batch_id=batch_id, origin='local-evidence-check; no human response created')\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"01d8d6\",\"wall_time_seconds\":1.14542329,\"exit_code\":0,\"original_token_count\":169,\"output\":\"Preservation manifest /tmp/step179-hashes.json: 129 entries\\nMismatches: []\\nuser-provided-sources/step-167/POL-2026.2-browser-copy.txt f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2\\ntests/fixtures/POL-2026.2-browser-copy.txt f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2\\nSource counts: {'claim_revisions': 127, 'trips': 123, 'permits': 5, 'receipts': 203, 'decisions': 307, 'finance_events': 220, 'cancellation_activities': 9}\\nSheets: [('People', 14), ('Trips', 123), ('Merchant payments', 201), ('FX', 2), ('Caps', 2), ('Budget', 3), ('Review ledger', 307), ('Review packets', 307), ('Finance activity', 220), ('Travel cancellations', 9)]\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13f1f-9521-7531-be06-284a2c693388","create_time":1792060437.2284217}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
