and Decimal(before) != Decimal(after))\n   191\t    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n   192\t        any(changed_exception_amount(line) for line in lines)\n   193\t        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n   194\t    replacement_review = same_revision_change or any(\n   195\t        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n   196\t    line_refs={r for line in lines for r in line['source_refs']}\n   197\t    dependencies=[r for key,tab in [('receipts','Receipts'),('merchant_payments','Merchant payments'),('caps','Caps'),('fx_rates','FX')]\n   198\t                  for r in table(parsed,key,tab) if ref(r) in line_refs]\n   199\t    claim_review=evaluate_reviews(parsed=parsed,kind='claim',subject_id=claim_id,revision=revision,\n   200\t        trip_record=trips[0] if len(trips)==1 else {},employee=employee,subject_record=record,\n   201\t        amount_cents=budget_view['remaining_request_cents'] if calculation['status']=='PASS' else None,decisions=decisions,arrival_batch=arrival_batch,\n   202\t        observations=source_observations,cost_ids=[line['cost_id'] for line in lines],\n   203\t        dependency_rows=dependencies,prior=(prior_workflow or {}).get('claim_approval'),\n   204\t        withdrawn=linked and values.get('Status')=='withdrawn' and trusted(record),\n   205\t        cancellation_ids=[f['travel_cancellation_id'] for f in eligibility if f['issue']=='travel_cancellation'],budget_context=budget_view)\n   206\t    observed=claim_review['deliveries']\n   207\t    # Preserve Step 175's extra binding requirement on material Finance replacements.\n   208\t    for decision in observed:\n   209\t        decision['exception_binding_valid']=(not replacement_review or review_binds_exception(\n   210\t            decision['raw_record'],record,same_revision_change=same_revision_change,fields=fields,ref