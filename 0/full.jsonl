    \\\"revision\\\",\\n          \\\"trip_id\\\",\\n          \\\"trip_revision\\\",\\n          \\\"status\\\",\\n          \\\"lines\\\",\\n          \\\"allowed_cents\\\",\\n          \\\"paid_cents\\\",\\n          \\\"balance_cents\\\",\\n          \\\"decision_ids\\\",\\n          \\\"next_owner\\\",\\n          \\\"reason\\\"\\n        ],\\n        \\\"properties\\\": {\\n          \\\"claim_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"revision\\\": {\\n            \\\"type\\\": \\\"integer\\\",\\n            \\\"minimum\\\": 1\\n          },\\n          \\\"trip_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"status\\\": {\\n            \\\"enum\\\": [\\n              \\\"pending\\\",\\n              \\\"held\\\",\\n              \\\"ready\\\",\\n              \\\"closed-reimbursed\\\",\\n              \\\"closed-no-payment\\\",\\n              \\\"rejected\\\",\\n              \\\"withdrawn\\\"\\n            ]\\n          },\\n          \\\"lines\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n              \\\"type\\\": \\\"object\\\",\\n              \\\"required\\\": [\\n                \\\"cost_id\\\",\\n                \\\"source_ids\\\",\\n                \\\"status\\\",\\n                \\\"allowed_cents\\\",\\n                \\\"reason\\\"\\n              ],\\n              \\\"properties\\\": {\\n                \\\"cost_id\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"minLength\\\": 1\\n                },\\n                \\\"source_ids\\\": {\\n                  \\\"type\\\": \\\"array\\\",\\n                  \\\"items\\\": {\\n                    \\\"type\\\": \\\"string\\\",\\n                    \\\"minLength\\\": 1\\n                  },\\n                  \\\"uniqueItems\\\": true\\n                },\\n                \\\