dmitted_events',{}).values(),key=lambda e:(e['classification']!='obligation_accepted',utc_time(e['source_record']['Activity time (UTC)']))):\n142:            if finance.get('authorized_obligation') is not None:\n143:                req['authorized_obligation_cents']=finance['authorized_obligation']['amount_cents']\n144:        for conflict in finance.get('conflicting_events',[]):\n145:            value=next((e['source_record'] for e in finance.get('event_history',[]) if e['event_id']==conflict['event_id']),{})\n147:            issue(scope,'finance-conflict:'+conflict['event_id'],'Conflicting Finance replay holds the scope without erasing admitted commitments/cash',\n149:        for unresolved in [e for e in finance.get('event_history',[]) if e['event_id'] not in finance.get('admitted_events',{})]:\n151:            issue(scope,'finance-unresolved:'+str(unresolved.get('event_id')),'Unresolved Finance event may affect available budget',[ref(unresolved['source_ref'])])\n157:                if category=='finance_cancelled' and event.get('original_activity_id'):\n160:                elif category in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'}:\n170:                req['commitment_cents']=0 if controls[-1]['classification']=='finance_cancelled' else controls[-1]['obligation_cents']\n182:            req['recorded_balance_cents']=req['commitment_cents']-req['net_paid_cents'] if req['commitment_cents'] is not None else None\n184:    represented={e['event_id'] for f in finances.values() for e in f.get('event_history',[])}\n185:    for row in raw_finance:\n317:        result['existing_recorded_commitment_cents']=sum(r['commitment_cents'] or 0 for r in own if r['request_id'] in matching_own)\n318:        result['incremental_cents']=max(0,result['remaining_request_cents']-result['existing_recorded_commitment_cents']) if complete else None\n325:            if (r['claim_id']!=claim['subject_id'] and e['classification'] in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'})\n326:            or (r['claim_id']==claim['subject_id'] and e['classification'] in {'finance_adjustment','finance_resolution','finance_cancelled'})\n371:        if e['classification'] in {'obligation_accepted','finance_adjustment','finance_resolution','finance_cancelled'}]\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    