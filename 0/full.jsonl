rate generic facilitator closure approval or fabricated timestamp merely because the old synthetic implementation expects those fields.\n52:**Concrete retained cases (observations, not new closure decisions):**\n\"\"\"Fresh native-source retrieval and byte-bound source manifests.\n\nThis module deliberately has no cache/fallback path. Every capture invokes the\nconfigured native URL or its documented export route again.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport io\nfrom http.client import HTTPException, IncompleteRead\nimport json\nimport re\nimport urllib.error\nimport urllib.request\nimport zipfile\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Callable, Mapping\n\n\n@dataclass(frozen=True)\nclass NativeSource:\n    source_id: str\n    title: str\n    url: str\n    locator: str\n    export_url: str | None = None\n    kind: str = \"binary\"\n\n\nSOURCES: tuple[NativeSource, ...] = (\n    NativeSource(\n        \"policy-pol-2026-2\",\n        \"Travel reimbursement policy POL-2026.2\",\n        \"https://private-pecorino-70e.notion.site/REDACTED\",\n        \"Notion policy page body\",\n        kind=\"notion\",\n    ),\n    NativeSource(\n        \"initial-claim-binder\",\n        \"Initial claim binder\",\n        \"https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"claim-updates-binder\",\n        \"Claim updates binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"receipt-binder\",\n        \"Receipt binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"travel-registers-workbook\",\n        \"Travel registers workbook\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/edit\",\n        \"All workbook tabs via native XLSX export\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/export?format=xlsx\",\n        \"xlsx\",\n    ),\n)\n\n\ndef _utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef sha256_bytes(content: bytes) -> str:\n    return hashlib.sha256(content).hexdigest()\n\n\ndef _policy_page_is_relevant_html(content: bytes) -> bool:\n    text = content.decode(\"utf-8\", \"replace\")\n    # A successful response can still be only a generic Notion app/login shell.\n    has_policy_id = bool(re.search(r\"POL[- ]2026(?:\\.2|[- ]2)\", text, re.I))\n    has_policy_body = bool(re.search(r\"lodging|meal cap|permit approval|reimbursement\", text, re.I))\n    return has_policy_id and has_policy_body\n\n","exit_code":0,"duration":{"secs":0,"nanos":38413808},"formatted_output":"\ndef test_same_revision_material_change_requires_new_source_binding_and_hold_survives_replay():\n    from travel_claim.ordinary import connect_claim\n    parsed=synthetic(); paid=batches(parsed)[1]; record=parsed['records']['claim_revisions'][0]\n    prior=deepcopy(workflow(paid)); exception(record)\n    record['source_sha256']='c'*64\n    parsed['source_observations'].append(dict(source_id=record['source_id'],sha256='c'*64,status='read',missing_scope=[]))\n    claim=deepcopy(paid['domain']['revision_history']['claim']['SYN-C01']['revisions'][0]);claim['record']=record\n    finance=deepcopy(paid['finance_reconciliations']['SYN-C01']);finance['revision_history']=[claim]\n    args=dict(parsed=parsed,claim=claim,decisions=parsed['records']['decisions'],finance_events=paid['domain']['finance_records'],\n        finance=finance,cancellations=[],arrival_batch=3,source_observations=parsed['source_observations'],\n        prior_finance=paid['finance_reconciliations']['SYN-C01'],budget_data=paid['domain']['budget'],prepaid_data=paid['domain']['budget']['cost_attribution'])\n    held=connect_claim(**args,prior_workflow=prior)\n    assert held['exception_revalidation']['same_revision_change']\n    assert stages(held)['required_approvals']['status']=='BLOCKED'\n    replay=connect_claim(**args,prior_workflow=held)\n    assert stages(replay)['exception_revalidation']['status']=='BLOCKED'\n    assert replay['finance']['admitted_events']==held['finance']['admitted_events']\n    for d in args['decisions']:\n        setfield(d,'Source revisions',ref(record)+'\\nPOL-2026.2')\n        setfield(d,'Arrival batch',3)\n    reviewed=connect_claim(**args,prior_workflow=replay)\n    assert stages(reviewed)['exception_revalidation']['status']=='PASS'\n    assert stages(reviewed)['required_approvals']['status']=='PASS'\n    assert stages(reviewed)['request_obligation']['status']=='BLOCKED'  # old authorized amount cannot be reused\n    assert reviewed['finance']['net_confirmed_cents']==10000\n\n\ndef test_exact_batch_replay_with_exception_preserves_state_and_cash():\n    from travel_claim.integration import integrate_arrival_batch\n    parsed=synthetic();exception(parsed['records']['claim_revisions'][0])\n    result=batches(parsed)[0]\n    replay=integrate_arrival_batch(parsed,arrival_batch=1,run_id='ordinary-test',batch_id='arrival-001',\n        source_binding={'path':'sources.json','sha256':'a'*64},prior_result=result,\n        source_observations=parsed['source_observations'])\n    assert replay['domain']==result['domain']\n    assert replay['snapshot']==result['snapshot']\n\n\ndef test_conflicting_same_revision_exception_delivery_holds_without_losing_paid_history():\n    parsed=synthetic(); original=parsed['records']['claim_revisions'][0]\n    conflict=deepcopy(original);setfield(conflict,'Arrival batch','3');conflict['locator']='SYNTHETIC conflicting same-revision exception'\n    exception(conflict);parsed['records']['claim_revisions'].append(conflict)\n    results=batches(parsed)\n    final=workflow(results[-1])\n    assert stages(final)['claim_trip_link']['status']=='BLOCKED'\n    assert final['status']=='pending' and stages(final)['request_obligation']['status']=='BLOCKED'\n    assert results[-1]['finance_reconciliations']['SYN-C01']['admitted_events']==results[1]['finance_reconciliations']['SYN-C01']['admitted_events']\n    assert results[-1]['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\n\n\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    checks: list[dict[str, Any]] = []\n    objects: dict[str, dict] = {}\n\n    def add(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") in {\"native-source-manifest/1\", \"native-source-manifest/2\"}, \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    supplemental_binding = None\n    def supplemental_evidence():\n        nonlocal supplemental_binding\n        from .policy_evidence import verify_policy_evidence, CLOCK\n        verified_binding = verify_policy_evidence(run_dir, parsed)\n        require(state.get('supplemental_policy_binding') == verified_binding and state.get('event_clock') == CLOCK,\n                'Replay state supplemental policy/clock binding mismatch')\n        supplemental_binding = verified_binding\n    supplemental_present = bool(parsed.get('supplemental_policy') or state.get('supplemental_policy_binding') or (run_dir / 'supplemental-policy.json').exists())\n    if supplemental_present:\n        check('supplemental-policy-evidence', [run_dir / 'supplemental-policy.json', run_dir / 'supplemental', run_dir / 'retained-input-lineage.json'], supplemental_evidence)\n    else:\n        add('supplemental-policy-evidence', 'BLOCKED', 'No supplemental browser policy supplied',\n            [run_dir / 'parsed-records.json'], 'Supply verified browser policy explicitly in a new policy-replay run if required.')\n\n14:Each row summarizes a requirement; the original policy file remains the exact wording authority. Code/test links are exact audit anchors. “Missing” means no corresponding policy execution was found in the inspected source/tests, not missing user policy text.\n19:| [POL-2026.2-browser-copy.txt:3](/home/maxg/travel-expense-claim/user-provided-sources/step-167/POL-2026.2-browser-copy.txt:3) | Case date, timezone, local dates and UTC events | **Resolved date evidence; representation defect** | Authoritative local case date is 2026-11-15 in Europe/Amsterdam, with no time of day. Current capture and closure gates require an offset-bearing datetime and live-run never consumes batches. Do not manufacture midnight or a UTC instant. Date-based decisions can use the declared local date; same-day instant ordering stays uncertain where material. [sources.py:179](/home/maxg/travel-expense-claim/src/travel_claim/sources.py:179); [ordinary.py:279](/home/maxg/travel-expense-claim/src/travel_claim/ordinary.py:279); [l