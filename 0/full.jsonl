 and remaining policy/permission evidence before treating calculated amounts as entitlement')\n \n     current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n                and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n@@ -318,7 +275,7 @@ def connect_claim(*, parsed, claim, decisions, finance_events, finance, cancella\n     pending = next((s for s in stages if s['status'] != 'PASS'), None)\n     return dict(claim_id=claim_id, revision=revision, trip_id=trip_id, trip_revision=claim.get('trip_revision'),\n                 mode=parsed.get('evidence_mode', 'offline-replay'), status=('closed-reimbursed' if allowed else 'closed-no-payment') if closed else 'pending',\n-                allowed_cents=allowed, balance_cents=finance['balance_cents'], lines=lines, stages=stages,\n+                expense_calculation=calculation, allowed_cents=allowed, balance_cents=finance['balance_cents'], lines=lines, stages=stages,\n                 observed_reviews=observed, request=deepcopy(requests[0]) if request_ok else None,\n                 source_refs=list(dict.fromkeys([ref(record)] + [r for s in stages for r in s['source_refs']])),\n                 next_owner=None if closed else pending['owner'], reason='Supported financial closure' if closed else pending['detail'],\ndiff --git a/tests/test_ordinary.py b/tests/test_ordinary.py\nindex 51776ae..ef4c94d 100644\n--- a/tests/test_ordinary.py\n+++ b/tests/test_ordinary.py\n@@ -8,6 +8,7 @@ from jsonschema import Draft202012Validator, FormatChecker\n import pytest\n \n from travel_claim.integration import integrate_arrival_batch\n+from travel_claim.expenses import load_expense_policy\n from travel_claim.outputs import load_repair_queue, write_repair_queue\n \n ROOT = Path(__file__).resolve().parents[1]\n@@ -15,6 +16,7 @@ ROOT = Path(__file__).resolve().parents[1]\n \n def native():\n     parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n+    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n     parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n     return parsed\n \n@@ -226,9 +228,11 @@ def test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n def test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n     parsed = synthetic()\n     policy = parsed['records']['workflow_policy_rules'][0]['values']\n+    policy['Eligible categories']['value'] = ['lodging']\n     policy['Uncapped categories']['value'] = []\n+    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n     cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n-        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\n+        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n         'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n     })\n     parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n\"\"\"POL-2026.2 expense arithmetic and local-calendar filing checks.\n\nThe policy is explicitly bound by its original bytes; this does not convert the\nuser's browser copy into a successful native Notion capture or grant approval.\n\"\"\"\nfrom calendar import monthrange\nfrom datetime import date\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\nimport hashlib\nfrom pathlib import Path\n\nPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\n\n\ndef load_expense_policy(path):\n    raw = Path(path).read_bytes()\n    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\n        raise ValueError('POL-2026.2 browser copy hash mismatch')\n    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\n                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\n\n\ndef policy_valid(binding):\n    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\n            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\n            and binding.get('sha256') == POLICY_SHA256)\n\n\ndef local_date(value):\n    \"\"\"Accept native local dates and Excel's naive midnight date serialization.\"\"\"\n    text = str(value)\n    if len(text) == 19 and text.endswith('T00:00:00'):\n        text = text[:10]\n    result = date.fromisoformat(text)\n    if result.isoformat() != text:\n        raise ValueError('Not a local calendar date')\n    return result\n\n\ndef filing_deadline(trip_end):\n    end = local_date(trip_end)\n    month = end.year * 12 + end.month - 1 + 2\n    year, zero_month = divmod(month, 12)\n    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\n\n\ndef number(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError('Missing or invalid number')\n    result = Decimal(str(value).replace(',', ''))\n    if not result.is_finite() or result < 0:\n        raise ValueError('Invalid amount')\n    return result\n\n\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table):\n    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    binding = parsed.get('expense_policy')\n    verified = policy_valid(binding)\n    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    receipts = parsed.get('records', {}).get('receipts', [])\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    rates = table(parsed, 'fx_rates', 'FX')\n    caps = table(parsed, 'caps', 'Caps')\n    for line in lines:\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n        try:\n            gross = number(line['original_amount'])\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\n                raise ValueError('Missing receipt or nonpositive purchase')\n            rv = fields(rs[0])\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\n                    and line['currency'].isalpha() and line['currency'].isupper()):\n                raise ValueError('Receipt identity, currency or gross mismatch')\n            unique = {}\n            for row in ms:\n                mv = fields(row); identity = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                finding = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = finding\n                ev = fields(record)\n                people = [fields(r) for r in table(parsed, 'people', 'People') if fields(r).get('Employee ID') == employee]\n                covered = {v.strip() for v in str(ev.get('Covered issues', '')).splitlines()}\n                valid_exception = (len(people) == 1 and people[0].get('Finance officer')\n                    and ev.get('Authorizing Finance officer') == people[0]['Finance officer']\n                    and ev.get('Applies to claim') == ev.get('Claim reference')\n                    and str(ev.get('Applies to revision')) == str(ev.get('Revision'))\n                    and ev.get('Expense reference') == line['cost_id'] and ev.get('Exception reason')\n                    and bool(covered & {'Late filing', 'late_filing'}))\n                if not valid_exception:\n                    raise ValueError(finding)\n                replacement = number(ev.get('Allowed original amount'))\n                if replacement != allowed:\n                    raise ValueError('Finance exception changes amount; replacement eligibility needs separate review')\n                line['filing']['exception'] = dict(source_ref=ref(record), actor=ev['Authorizing Finance officer'],\n                    claim_id=ev['Applies to claim'], revision=ev['Applies to revision'], cost_id=line['cost_id'],\n                    reason=ev['Exception reason'], covered_issues=sorted(covered), replacement_original_amount=str(replacement))\n            line.update(filing_status='PASS', status='supported', reason='Supported paid expense calculation; filing supported by explicit Finance exception'\n                        if line.get('filing', {}).get('exception') else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\ndef test_categories_and_caps(category, units, amount):\n    parsed, record, trip = setup()\n    receipt = parsed['records']['receipts'][0]\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == amount\n    if category in {'lodging','meals'}:\n        assert lines[0]['conversion']['cap']['units'] == units\n\n\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\ndef test_fractional_or_invalid_units_unresolved(units):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\n    ('Transaction reference',None),('Receipt reference','OTHER')])\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99')])\ndef test_mismatched_receipt(field, value):\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\n\n\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\n    parsed, record, trip = setup()\n    duplicate = deepcopy(merchant(parsed)); parsed['records']['merchant_payments'] = [merchant(parsed), duplicate]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n    setfield(duplicate,'Gross amount','200.00')\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('rate,expected', [('0.90005',9001),('0.900049',9000),('0.90015',9002)])\ndef test_exact_payment_date_fx_half_up(rate, expected):\n    parsed, record, trip = setup()\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == expected\n    assert lines[0]['conversion']['eur_rate'] == rate\n    assert lines[0]['conversion']['rounding'] == 'ROUND_HALF_UP'\n\n\n@pytest.mark.parametrize('missing', ['policy','tampered-policy','receipt','merchant','rate','cap','category'])\ndef test_missing_inputs_stay_unresolved(missing):\n    parsed, record, trip = setup()\n    if missing == 'policy': parsed.pop('expense_policy')\n    if missing == 'tampered-policy': parsed['expense_policy']['text'] += '\\n'\n    if missing == 'receipt': parsed['records']['receipts'] = []\n    if missing == 'merchant': parsed['records']['merchant_payments'] = []\n    if missing == 'category': setfield(parsed['records']['receipts'][0],'Category','entertainment')\n    if missing == 'cap':\n        setfield(parsed['records']['receipts'][0],'Category','lodging'); parsed['records']['caps'] = []\n    if missing == 'rate':\n        record['text'] = record['text'].replace('EUR','USD')\n        setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n        parsed['records']['fx_rates'] = []\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('submitted,status', [('2026-10-31','PASS'),('2026-11-01','BLOCKED'),('2026-08-31','BLOCKED')])\ndef test_inclusive_deadline_and_paid_before_submission(submitted,status):\n    parsed, record, trip = setup(); trip['End date'] = '2026-08-31'\n    record['text'] = record['text'].replace('2026-09-01',submitted); setfield(record,'Submitted date',submitted)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == status\n    if submitted > '2026-10-31': assert 'Late filing' in lines[0]['reason']\n\n\ndef test_paid_pretravel_submission_is_allowed_and_import_date_is_ignored():\n    parsed, record, trip = setup(); trip.update({'Start date':'2026-10-01','End date':'2026-10-10'})\n    parsed['import_date'] = '2099-01-01'\n    assert evaluate(parsed,record,trip)[0]['status'] == 'PASS'\n\n\ndef test_unchanged_cost_keeps_submission_date_but_new_cost_does_not_inherit_it():\n    parsed, record, trip = setup(); old = deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-11-01'); setfield(record,'Submitted date','2026-11-01')\n    trip['End date'] = '2026-08-31'\n    history = [dict(record=old)]\n    result, lines = evaluate(parsed,record,trip,history)\n    assert result['status'] == 'PASS' and lines[0]['filing']['first_submission_date'] == '2026-09-01'\n    record['text'] = record['text'].replace('COST-01','COST-NEW')\n    for row in [parsed['records']['receipts'][0],merchant(parsed)]:\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    result, lines = evaluate(parsed,record,trip,history)\n    assert lines[0]['filing']['first_submission_date'] == '2026-11-01'\n    assert result['status'] == 'BLOCKED'\n\n\ndef test_late_exception_requires_exact_finance_actor_revision_cost_and_covered_issue():\n    parsed, record, trip = setup(); trip['End date'] = '2026-06-01'\n    person = fields(table(parsed,'people','People')[0])\n    exception = {'Authorizing Finance officer':person['Finance officer'],'Applies to claim':'C01',\n        'Applies to revision':'1','Expense reference':'COST-01','Allowed original amount':'100.00',\n        'Covered issues':'Late filing','Exception reason':'SYNTHETIC explicit exception'}\n    for key,value in exception.items(): setfield(record,key,value)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'PASS'\n    assert 'Late filing' in lines[0]['filing']['original_finding']\n    for key in ('Authorizing Finance officer','Applies to claim','Applies to revision','Expense reference','Covered issues'):\n        changed = deepcopy(record); setfield(changed,key,'WRONG')\n        assert evaluate(parsed,changed,trip)[0]['status'] == 'BLOCKED'\n\n\ndef test_malformed_extra_line_blocks_total_without_losing_valid_line():\n    parsed, record, trip = setup()\n    record['text'] += '\\n 2 COST-BAD malformed\\n'\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and len(lines) == 2\n    assert lines[0]['calculated_cents'] == 10000\n    assert lines[1]['calculated_cents'] is None\n\n\ndef test_round_each_line_then_sum_and_independent_missing_evidence():\n    parsed, record, trip = setup()\n    first_receipt = parsed['records']['receipts'][0]\n    first_merchant = merchant(parsed)\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(first_receipt,'Currency','USD'); setfield(first_merchant,'Currency','USD')\n    second_receipt=deepcopy(first_receipt); second_merchant=deepcopy(first_merchant)\n    for row in (second_receipt,second_merchant):\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    setfield(second_merchant,'Transaction reference','SYNTHETIC-SECOND')\n    parsed['records']['receipts'].append(second_receipt)\n    parsed['records']['merchant_payments'] = [first_merchant,second_merchant]\n    record['text'] += '\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\n'\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] == 18002\n    assert [l['calculated_cents'] for l in lines] == [9001,9001]\n    parsed['recor