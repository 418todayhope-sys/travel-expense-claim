 fetch(attempted, timeout)\n+            status_code = int(next((v for k, v in headers.items() if k.lower() == \"x-travel-claim-http-status\"), \"200\"))\n+        except urllib.error.HTTPError as exc:\n+            status_code, final_url = exc.code, exc.geturl()\n+            headers = dict(exc.headers.items()) if exc.headers else {}\n+            try:\n+                body = exc.read()\n+            except OSError:\n+                pass\n+            failure = f\"HTTPError: {exc.code} {exc.reason}\"\n+        except (urllib.error.URLError, TimeoutError, OSError, ValueError, HTTPException) as exc:\n+            failure = f\"{type(exc).__name__}: {exc}\"\n+        completed = observed_at()\n+        normalized = {k.lower(): v for k, v in headers.items()}\n+        selected_headers = {k: normalized[k] for k in (\"etag\", \"last-modified\", \"content-type\", \"content-length\", \"content-range\", \"x-travel-claim-read-error\") if k in normalized}\n+        response_path = None\n+        if body is not None:\n+            response_path = f\"responses/{source.source_id}.body\"\n+            with (run_dir / response_path).open(\"xb\") as stream:\n+                stream.write(body)\n+        if failure:\n+            state, suffix, error, missing = \"unavailable\", None, failure, [source.title]\n+        else:\n+            state, suffix, error, missing = assess_payload(source, body or b\"\")\n+            if status_code != 200 or \"content-range\" in normalized:\n+                state, error, missing = \"partial\" if suffix else \"unavailable\", f\"Incomplete HTTP response: status {status_code}, content range {normalized.get('content-range')}\", [source.title]\n+            if \"x-travel-claim-read-error\" in normalized:\n+                state, error, missing = \"partial\" if suffix else \"unavailable\", normalized[\"x-travel-claim-read-error\"], [source.title]\n+            if \"content-length\" in normalized:\n+                try:\n+                    if int(normalized[\"content-length\"]) != len(body or b\"\"):\n+                        state, error, missing = \"partial\" if suffix else \"unavailable\", \"Response byte length differs from Content-Length\", [source.title]\n+                except ValueError:\n+                    state, error, missing = \"unavailable\", \"Invalid Content-Length\", [source.title]\n+        rel_path = None\n+        if suffix and body is not None and state != \"unavailable\":\n+            rel_path = f\"sources/{source.source_id}.{suffix}\"\n+            with (run_dir / rel_path).open(\"xb\") as stream:\n+                stream.write(body)\n+        entries.append({\n+            \"source_id\": source.source_id, \"path\": rel_path,\n+            \"sha256\": sha256_bytes(body) if rel_path else None,\n+            \"status\": state, \"error\": error, \"url\": source.url, \"locator\": source.locator,\n+            \"observed_at\": completed, \"version\": (normalized.get(\"etag\") or normalized.get(\"last-modified\")) if rel_path else None,\n+            \"scope\": source.title, \"missing_scope\": missing,\n+            \"observation\": {\"method\": \"fresh-http-export\" if source.export_url else \"fresh-http-native\",\n+                \"requested_url\": attempted, \"final_url\": final_url, \"http_status\": status_code,\n+                \"started_at\": started, \"completed_at\": completed, \"response_headers\": selected_headers,\n+                \"response_path\": response_path, \"response_sha256\": sha256_bytes(body) if body is not None else None,\n+                \"response_bytes\": len(body) if body is not None else None,\n+                \"content_version\": sha256_bytes(body) if body is not None else None,\n+                \"cache_fallback_used\": False},\n+        })\n+    manifest = {\"run_id\": run_id, \"source_version\": \"native-source-manifest/2\", \"case_clock\": case_clock, \"files\": entries}\n     with manifest_path.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n         stream.write(json.dumps(manifest, indent=2, ensure_ascii=False) + \"\\n\")\n     return manifest\n@@ -226,6 +272,9 @@ def verify_source_manifest(run_dir: Path) -> list[str]:\n         errors.append(\"sources.json run_id must match its run directory\")\n     if not isinstance(manifest.get(\"files\"), list):\n         return errors + [\"sources.json files must be an array\"]\n+    if manifest.get(\"source_version\") not in {\"native-source-manifest/1\", \"native-source-manifest/2\"}:\n+        errors.append(\"Unsupported source manifest version\")\n+    specs = {source.source_id: source for source in SOURCES}\n     seen: set[str] = set()\n     for record in manifest[\"files\"]:\n         if not isinstance(record, dict):\n@@ -257,7 +306,15 @@ def verify_source_manifest(run_dir: Path) -> list[str]:\n             errors.append(f\"{sid}: observed_at must be an ISO UTC timestamp\")\n         if record[\"error\"] is not None and not isinstance(record[\"error\"], str):\n             errors.append(f\"{sid}: error must be a string or null\")\n-        if record[\"status\"] == \"read\":\n+        if sid in specs and record[\"url\"] != specs[sid].url:\n+            errors.append(f\"{sid}: source identity does not match its original native URL\")\n+        if manifest.get(\"source_version\") == \"native-source-manifest/2\":\n+            errors.extend(_verify_observation(run_dir, record, specs.get(sid)))\n+        if record[\"status\"] in {\"read\", \"partial\"}:\n+            if record[\"status\"] == \"read\" and (record[\"missing_scope\"] or record[\"error\"]):\n+                errors.append(f\"{sid}: read scope cannot contain missing scope or errors\")\n+            if record[\"status\"] == \"partial\" and (not record[\"missing_scope\"] or not record[\"error\"]):\n+                errors.append(f\"{sid}: partial scope must identify missing content and an error\")\n             if not isinstance(record[\"path\"], str) or not record[\"path\"] or not isinstance(record[\"sha256\"], str) or not record[\"sha256\"]:\n                 errors.append(f\"{sid}: read record has no retained path or hash\")\n                 continue\n@@ -275,10 +332,12 @@ def verify_source_manifest(run_dir: Path) -> list[str]:\n         elif record[\"status\"] == \"unavailable\":\n             if any(record[k] is not None for k in (\"path\", \"sha256\", \"version\")):\n                 errors.append(f\"{sid}: unavailable scope must have null path, sha256, and version\")\n-            if not record[\"error\"]:\n-                errors.append(f\"{sid}: unavailable scope has no error\")\n+            if not record[\"error\"] or not record[\"missing_scope\"]:\n+                errors.append(f\"{sid}: unavailable scope has no error or missing scope\")\n         else:\n             errors.append(f\"{sid}: invalid status {record['status']!r}\")\n+    if seen != set(specs) or len(manifest[\"files\"]) != 5:\n+        errors.append(\"manifest must cover exactly all five configured native source identities\")\n     expected_urls = {source.url for source in SOURCES}\n     observed_urls = {\n         record.get(\"url\")\n@@ -288,3 +347,46 @@ def verify_source_manifest(run_dir: Path) -> list[str]:\n     if observed_urls != expected_urls:\n         errors.append(\"manifest must cover exactly all five configured native source URLs\")\n     return errors\n+\n+\n+def _verify_observation(run_dir: Path, record: dict, source: NativeSource | None) -> list[str]:\n+    errors = []\n+    sid = record.get(\"source_id\")\n+    observation = record.get(\"observation\")\n+    if not source or record.get(\"url\") != source.url or not isinstance(observation, dict):\n+        return [f\"{sid}: native identity, URL or fresh retrieval observation missing\"]\n+    if (observation.get(\"requested_url\") != (source.export_url or source.url)\n+            or observation.get(\"method\") != (\"fresh-http-export\" if source.export_url else \"fresh-http-native\")\n+            or observation.get(\"cache_fallback_used\") is not False):\n+        errors.append(f\"{sid}: fresh native request binding or no-fallback evidence invalid\")\n+    try:\n+        start, end = [datetime.fromisoformat(str(observation[k]).replace(\"Z\", \"+00:00\")) for k in (\"started_at\", \"completed_at\")]\n+        if any(t.utcoffset() is None or t.utcoffset().total_seconds() != 0 for t in (start, end)) or end < start or observation['completed_at'] != record['observed_at']:\n+            raise ValueError(\"retrieval timestamps must be ordered UTC observations\")\n+    except (ValueError, TypeError, KeyError):\n+        errors.append(f\"{sid}: invalid retrieval observation times\")\n+    path = observation.get(\"response_path\")\n+    if path is None:\n+        if record.get(\"status\") != \"unavailable\" or any(observation.get(k) is not None for k in (\"response_sha256\", \"response_bytes\", \"content_version\")):\n+            errors.append(f\"{sid}: missing response cannot establish accessible content\")\n+        return errors\n+    try:\n+        response_path = run_dir / path\n+        if not response_path.resolve().is_relative_to(run_dir.resolve()):\n+            raise ValueError(\"response path escapes run directory\")\n+        body = response_path.read_bytes()\n+        digest = sha256_bytes(body)\n+        if digest != observation.get(\"response_sha256\") or digest != observation.get(\"content_version\") or len(body) != observation.get(\"response_bytes\"):\n+            errors.append(f\"{sid}: response evidence hash or size mismatch\")\n+        if record.get(\"status\") in {\"read\", \"partial\"} and record.get(\"sha256\") != digest:\n+            errors.append(f\"{sid}: retained source differs from fresh response evidence\")\n+        if record.get(\"status\") == \"read\":\n+            state, _, reason, _ = assess_payload(source, body)\n+            headers = observation.get(\"response_headers\", {})\n+            if state != \"read\" or observation.get(\"http_status\") != 200 or \"content-range\" in headers or \"x-travel-claim-read-error\" in headers:\n+                errors.append(f\"{sid}: complete read not supported by native response: {reason}\")\n+            if \"content-length\" in headers and int(headers['content-length']) != len(body):\n+                errors.append(f\"{sid}: complete read has inconsistent Content-Length\")\n+    except (OSError, ValueError, TypeError) as exc:\n+        errors.append(f\"{sid}: cannot verify response evidence: {exc}\")\n+    return errors\n\"\"\"Fresh native acquisition and transcription, separate from retained replay.\n\nThis command never consumes an old manifest or seals business decisions with\nmissing clock/policy authority. Acquisition and business readiness are separate.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom .parsing import parse_retained_run\nfrom .sources import capture_sources, sha256_bytes, verify_source_manifest\n\n\ndef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\n    \"\"\"Always capture all five URLs into a new directory before reading inputs.\"\"\"\n    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\n    errors = verify_source_manifest(run_dir)\n    parsed = None\n    if not errors:\n        try:\n            parsed = parse_retained_run(run_dir)\n        except Exception as exc:\n            errors.append(f\"Native transcription failed: {type(exc).__name__}: {exc}\")\n    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\n               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\n               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\n    for row in manifest['files']:\n        checks.append({'check': f\"source:{row['source_id']}\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\n                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\n                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\n                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\n    for issue in (parsed or {}).get('transcription_issues', []):\n        checks.append({'check': f\"transcription:{issue['source_id']}\", 'status': 'BLOCKED',\n                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\n    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\n                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\n                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\n    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\n                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\n                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\n    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\n    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\n    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\n              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\n              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\n              'final_live_source_compliance': False, 'batches_consumed': [],\n              'source_manifest': {'path': 'sources.json', 'sha256': sha256_bytes((run_dir / 'sources.json').read_bytes())},\n              'parsed_records': {'path': 'parsed-records.json', 'sha256': sha256_bytes((run_dir / 'parsed-records.json').read_bytes())} if parsed else None,\n              'arrival_batches_observed': (parsed or {}).get('arrival_batches', []), 'checks': checks}\n    with (run_dir / 'live-run.json').open('x', encoding='utf-8') as stream:\n        stream.write(json.dumps(report, indent=2, ensure_ascii=False) + '\\n')\n    lines = ['# Project D fresh native-source attempt', '', f\"**{status}** — `{run_id}`; mode: `live-source-attempt`.\", '',\n             'All five original source locations were attempted in this invocation using native HTTP/export routes. '\n             'No previous retained input was substituted. Retrieval observations are not a case clock.', '',\n             f\"Acquisition: **{report['acquisition_status']}**. Final live-source compliance: **not established**. No arrival batches consumed.\", '',\n             'Complete relevant returned bytes, usable partial content and diagnostic responses are retained in this run and bound in `sources.json`.', '']\n    for check in checks:\n        lines += [f\"- **{check['status']}** `{check['check']}`: {check['detail']}\",\n                  f\"  - Evidence: `{check['evidence']}`; next action: {check['next_action']}\"]\n    with (run_dir / 'live-run.md').open('x', encoding='utf-8') as stream:\n        stream.write('\\n'.join(lines) + '\\n')\n    return report\n\"\"\"Structurally valid documents containing explicitly synthetic source content.\"\"\"\nimport io\n\nfrom openpyxl import Workbook\nfrom pypdf import PdfWriter\nfrom pypdf.generic import DictionaryObject, NameObject, DecodedStreamObject\n\nfrom travel_claim.sources import WORKBOOK_TABS\n\n\ndef pdf_bytes(text='SYNTHETIC source document only'):\n    writer = PdfWriter()\n    page = writer.add_blank_page(width=600, height=800)\n    font = DictionaryObject({NameObject('/Type'): NameObject('/Font'), NameObject('/Subtype'): NameObject('/Type1'), NameObject('/BaseFont'): NameObject('/Helvetica')})\n    page[NameObject('/Resources')] = DictionaryObject({NameObject('/Font'): DictionaryObject({NameObject('/F1'): font})})\n    stream = DecodedStreamObject()\n    stream.set_data(f'BT /F1 12 Tf 20 750 Td ({text}) Tj ET'.encode())\n    page[NameObject('/Contents')] = writer._add_object(stream)\n    buffer = io.BytesIO(); writer.write(buffer)\n    return buffer.getvalue()\n\n\ndef xlsx_bytes():\n    workbook = Workbook(); workbook.remove(workbook.active)\n    for name in sorted(WORKBOOK_TABS):\n        workbook.create_sheet(name).append(['SYNTHETIC source document only'])\n    buffer = io.BytesIO(); workbook.save(buffer); workbook.close()\n    return buffer.getvalue()\n\"\"\"Fresh source requests never borrow retained inputs or assert missing content.\"\"\"\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom source_fixtures import pdf_bytes, xlsx_bytes\nfrom travel_claim.cli import main\nfrom travel_claim.live_run import run_live_sources\nfrom travel_claim.parsing import parse_retained_run\nfrom travel_claim.sources import SOURCES, capture_sources, verify_source_manifest\n\n\ndef fetcher(*, fault=None, calls=None):\n    def fetch(url, timeout):\n        if calls is not None: calls.append(url)\n        source = next(s for s in SOURCES if (s.export_url or s.url) == url)\n        if fault == 'all-fail': raise URLError('SYNTHETIC network unavailable')\n        if source.kind == 'notion':\n            if fault == 'http-error':\n                raise HTTPError(url, 403, 'SYNTHETIC denied', {'ETag': 'denied-v1'}, io.BytesIO(b'SYNTHETIC access denied'))\n            return b'<article>POL-2026.2 reimbursement SYNTHETIC fragment</article>', {}, url\n        body = xlsx_bytes() if source.kind == 'xlsx' else pdf_bytes()\n        headers = {'etag': 'synthetic-version', 'content-length': str(len(body))}\n        if source.source_id == 'initial-claim-binder':\n            if fault == 'range': headers.update({'X-Travel-Claim-HTTP-Status': '206', 'Content-Range': 'bytes 0-9/100'})\n            elif fault == 'truncated': headers['content-length'] = str(len(body) + 100)\n            elif fault == 'corrupt': body = b'%PDF-1.4 broken %%EOF'\n        return body, headers, url + '#SYNTHETIC-final-url'\n    return fetch\n\n\ndef test_successful_native_document_retrieval_preserves_bytes_versions_and_all_five_requests(tmp_path):\n    calls = []\n    run = tmp_path / 'fresh-a'\n    m = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(calls=calls))\n    assert calls == [s.export_url or s.url for s in SOURCES]\n    assert [r['status'] for r in m['files']] == ['partial', 'read', 'read', 'read', 'read']\n    for row in m['files']:\n        observation = row['observation']\n        assert observation['cache_fallback_used'] is False\n        body = (run / observation['response_path']).read_bytes()\n        assert hashlib.sha256(body).hexdigest() == observation['response_sha256'] == row['sha256']\n        assert body == (run / row['path']).read_bytes()\n    assert m['files'][1]['version'] == 'synthetic-version'\n    assert m['case_clock'] is None and verify_source_manifest(run) == []\n\n\n@pytest.mark.parametrize('fault', ['range', 'truncated', 'corrupt', 'all-fail', 'http-error'])\ndef test_partial_or_failed_live_run_never_reports_complete_success(tmp_path, fault):\n    run = tmp_path / fault\n    report = run_live_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(fault=fault))\n    assert report['status'] == report['acquisition_status'] == 'BLOCKED'\n    assert report['final_live_source_compliance'] is False and report['batches_consumed'] == []\n    assert report['fresh_reads_attempted'] == 5\n    assert not (run / 'batches').exists()\n    assert verify_source_manifest(run) == []\n    assert 'BLOCKED' in (run / 'live-run.md').read_text()\n    if fault == 'http-error':\n        row = json.loads((run / 'sources.json').read_text())['files'][0]\n        assert row['observation']['http_status'] == 403\n        assert (run / row['observation']['response_path']).read_bytes() == b'SYNTHETIC access denied'\n    if fault in {'range', 'truncated'}:\n        m = json.loads((run / 'sources.json').read_text())\n        assert m['files'][1]['status'] == 'partial'\n        assert 'initial-claim-binder' in {s['source_id'] for s in json.loads((run / 'parsed-records.json').read_text())['source_inventory']}\n\n\ndef test_failed_new_run_does_not_fall_back_to_successful_prior_inputs(tmp_path):\n    first, second = tmp_path / 'prior', tmp_path / 'new'\n    capture_sources(first, run_id=first.name, case_clock=None, fetch=fetcher())\n    before = {str(p): p.read_bytes() for p in first.rglob('*') if p.is_file()}\n    calls = []\n    run_live_sources(second, run_id=second.name, case_clock=None, fetch=fetcher(fault='all-fail', calls=calls))\n    assert len(calls) == 5\n    m = json.loads((second / 'sources.json').read_text())\n    assert all(r['status'] == 'unavailable' and r['path'] is None for r in m['files'])\n    assert all(Path(p).read_bytes() == data for p, data in before.items())\n    with pytest.raises(FileExistsError):\n        capture_sources(first, run_id=first.name, case_clock=None, fetch=lambda *_: pytest.fail('must not request'))\n\n\ndef test_preexisting_cached_inputs_and_incomplete_source_list_are_rejected(tmp_path):\n    run = tmp_path / 'cached'; run.mkdir(); (run / 'parsed-records.json').write_text('SYNTHETIC stale')\n    with pytest.raises(FileExistsError):\n        run_live_sources(run, run_id=run.name, case_clock=None, fetch=lambda *_: pytest.fail('must reject first'))\n    with pytest.raises(ValueError):\n        capture_sources(tmp_path / 'subset', run_id='subset', case_clock=None, source_specs=SOURCES[1:])\n\n\ndef test_forged_complete_policy_and_response_tampering_fail_verification(tmp_path):\n    run = tmp_path / 'tampered'\n    m = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher())\n    m['files'][0].update(status='read', error=None, missing_scope=[])\n    (run / 'sources.json').write_text(json.dumps(m))\n    assert any('complete read not supported' in e for e in verify_source_manifest(run))\n    (run / m['files'][1]['observation']['response_path']).write_bytes(b'changed')\n    assert any('response evidence hash' in e for e in verify_source_manifest(run))\n\n\ndef test_cli_live_and_capture_partial_return_blocked_and_no_clock_default(tmp_path, monkeypatch, capsys):\n    import travel_claim.cli as cli\n    original = cli.run_live_sources\n    monkeypatch.setattr(cli, 'run_live_sources', lambda *a, **kw: original(*a, **kw, fetch=fetcher()))\n    assert main(['live-run', 'cli-live', str(tmp_path / 'cli-live')]) == 2\n    assert 'BLOCKED' in capsys.readouterr().out\n    monkeypatch.setattr(cli, 'capture_sources', lambda *a, **kw: capture_sources(*a, **kw, fetch=fetcher()))\n    assert main(['capture-sources', 'cli-capture', str(tmp_path / 'cli-capture')]) == 2\n    assert 'partial' in capsys.readouterr().out\n\n\ndef test_each_new_run_makes_five_new_calls_even_if_versions_and_bytes_match(tmp_path):\n    calls=[]\n    for name in ('fresh-one', 'fresh-two'):\n        capture_sources(tmp_path/name, run_id=name, case_clock=None, fetch=fetcher(calls=calls))\n    assert len(calls) == 10 and calls[:5] == calls[5:]\n\n\ndef test_missing_workbook_scope_and_scanned_pdf_are_partial(tmp_path):\n    from openpyxl import Workbook\n    from pypdf import PdfWriter\n    workbook = Workbook(); workbook.active.title = 'Trips'\n    xlsx = io.BytesIO(); workbook.save(xlsx); workbook.close()\n    writer = PdfWriter(); writer.add_blank_page(width=100, height=100)\n    pdf = io.BytesIO(); writer.write(pdf)\n    ordinary = fetcher()\n    def fetch(url, timeout):\n        if url == SOURCES[-1].export_url: return xlsx.getvalue(), {}, url\n        if url == SOURCES[1].export_url: return pdf.getvalue(), {}, url\n        return ordinary(url, timeout)\n    run = tmp_path/'partial-documents'\n    manifest = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetch)\n    assert manifest['files'][1]['status'] == manifest['files'][-1]['status'] == 'partial'\n    assert 'People' in manifest['files'][-1]['missing_scope']\n    assert verify_source_manifest(run) == []\n    parsed = parse_retained_run(run)\n    assert len(parsed['pdf_pages']) == 3  # partial page preserved alongside readable documents\n    assert parsed['pdf_pages'][0]['text'] == ''\n    assert parsed['missing_sources']\n\n\n@pytest.mark.parametrize('clock', ['2026-09-01', '2026-09-01T12:00:00', 'invented-default'])\ndef test_incomplete_clock_values_are_rejected_before_capture(tmp_path, clock):\n    with pytest.raises(ValueError, match='timezone'):\n        run_live_sources(tmp_path/'bad-clock', run_id='bad-clock', case_clock=clock,\n                         fetch=lambda *_: pytest.fail('must reject before fetching'))\n\n\ndef test_parser_preserves_fractional_batch_as_an_issue_instead_of_rounding(tmp_path):\n    run=tmp_path/'fractional-batch'\n    manifest=capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher())\n    from openpyxl import load_workbook\n    source=manifest['files'][-1]\n    path=run/source['path']\n    workbook=load_workbook(path)\n    sheet=workbook['Finance activity']\n    sheet.append(['Activity reference', 'Arrival batch', 'Activity type', 'Amount (EUR)'])\n    sheet.append(['SYN-EVENT', 1.5, 'settled', 12.34])\n    workbook.save(path); workbook.close()\n    # Deliberately reconstruct a legacy synthetic parser fixture, not a fresh observation.\n    manifest['source_version']='native-source-m