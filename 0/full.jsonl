)\n        stream.write(\"\\n\")\n\n\ndef _report(\n    *, run_id: str, parsed: dict[str, Any], snapshots: list[Path], latest: dict[str, Any],\n    output_paths: dict[str, Path],\n) -> str:\n    manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n    lines = [\n        \"# Project D operations handoff — OFFLINE REPLAY\",\n        \"\",\n        \"> This is a structural replay from previously retained inputs. It did not perform fresh native-source reads and does not establish policy eligibility, reimbursement entitlement, approval readiness, or closure.\",\n        \"\",\n        f\"- Run ID: `{run_id}`\",\n        \"- Mode: `offline-replay`\",\n        \"- Fresh native reads in this run: **no**\",\n        f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n        f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n        \"- Retained source observations: \" + \"; \".join(\n            f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n                (snapshots[0].parents[1] / \"sources.json\").read_text(encoding=\"utf-8\")\n            )[\"files\"]\n        ) + \".\",\n        \"\",\n        \"## Batch projections\",\n        \"\",\n    ]\n    for path in snapshots:\n        snapshot = json.loads(path.read_text(encoding=\"utf-8\"))\n        lines.append(\n            f\"- `{path.relative_to(path.parents[1])}` — {len(snapshot['claims'])} current claim rows, \"\n            f\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \"\n            f\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\"\n        )\n    lines.extend([\n        \"\",\n        \"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained; no obligation or entitlement is inferred. Claim monetary entitlement and balance remain null when unsupported.\",\n        \"\",\n        \"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\",\n        \"\",\n    ])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    for title, subject_types in (\n        (\"Claim-specific actionable repairs by owner\", {\"claim\"}),\n        (\"Trip and permit actionable repairs by owner\", {\"trip\", \"permit\"}),\n    ):\n        open_queue = {\"items\": {\n            key: item for key, item in queue[\"items\"].items()\n            if item[\"status\"] == \"open\" and item[\"subject_type\"] in subject_types\n        }}\n        lines.extend([\n            f\"## {title}\", \"\",\n            f\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\",\n            \"\",\n        ])\n        if not open_queue[\"items\"]:\n            lines.extend([\"No open repair items in this category; this does not establish policy readiness or closure.\", \"\"])\n        for owner, items in owner_grouped_view(open_queue).items():\n            lines.extend([f\"### {owner}\", \"\"])\n            for item in items:\n                lines.extend([\n                    f\"- Repair `{item['item_id']}` — subject {item['subject_type']} `{item['subject_id']}`, revision {item['revision']} (**open**).\",\n                    f\"  - Reason: {item['missing_or_return_reason']}.\",\n                    f\"  - Next action: {item['next_action']}.\",\n                    f\"  - Opened in run `{item['run_id']}`, batch `{item['batch_id']}`.\",\n                    \"  - Retained source references: \" + \"; \".join(\n                        f\"`{ref}`\" for ref in item['source_refs']\n                    ) if item['source_refs'] else \"  - Retained source references: unavailable; obtain authoritative evidence.\",\n                ])\n            lines.append(\"\")\n    lines.extend([\n        \"## Run-level external blockers\", \"\",\n        \"These retained policy and clock issues apply to the run as a whole and are separate from claim repairs. They remain unresolved in this offline replay; no case-clock date or policy rule is inferred.\",\n        \"\",\n    ])\n    for blocker in parsed.get(\"unresolved_issues\", []):\n        lines.append(\n            f\"- `{blocker['record_id']}` ({blocker.get('subject_type')} `{blocker.get('subject_id')}`): \"\n            f\"{blocker['reason']} Owner: {blocker['owner']}. Next: {blocker['next_action']} \"\n            f\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\"\n        )\n    lines.extend([\n        \"\",\n        \"## Outputs\",\n        \"\",\n        f\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\",\n        f\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\",\n        f\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\",\n        \"\",\n        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n        \"\",\n    ])\n    return \"\\n\".join(lines)\n\n\ndef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n    manifest_path = run_dir / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    parsed_path = run_dir / OUTPUT_NAME\n    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n    batches = parsed.get(\"arrival_batches\")\n    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n    output_paths = {\n        \"claims\": run_dir / \"claims.csv\",\n        \"report\": run_dir / \"report.md\",\n        \"queue\": run_dir / \"repair-queue.json\",\n        \"state\": run_dir / \"offline-replay-state.json\",\n    }\n    occupied = [str(path) for path in output_paths.values() if path.exists()]\n    if occupied:\n        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n    batches_dir = run_dir / \"batches\"\n    if batches_dir.exists() and any(batches_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n\n    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n    previous: dict[str, Any] | None = None\n    previous_path: Path | None = None\n    sealed: list[Path] = []\n    for number in batches:\n        batch_id = f\"arrival-{number:03d}\"\n        predecessor = None\n        if previous_path is not None:\n            predecessor = {\n                \"path\": f\"batches/{previous_path.name}\",\n                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n            }\n        current = integrate_arrival_batch(\n            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            source_binding=binding, predecessor=predecessor, prior_result=previous,\n        )\n        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n        path = seal_batch_snapshot(\n            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            predecessor_path=previous_path, schema_path=schema_path,\n            allow_unconfirmed_case_clock=True, **{\n                key: current[\"snapshot\"][key]\n                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\")\n            },\n        )\n        validation = verify_snapshot(path, run_dir, schema_path)\n        if validation:\n            raise ValueError(f\"Snapshot verification failed for {path}: \" + \"; \".join(validation))\n        sealed.append(path)\n        previous, previous_path = current, path\n\n    latest = previous\n    assert latest is not None\n    current_claims = []\n    owner_by_claim: dict[str, str] = {}\n    reason_by_claim: dict[str, str] = {}\n    for item in latest[\"domain\"][\"repair_queue\"][\"items\"].values():\n        if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\":\n            owner_by_claim.setdefault(item[\"subject_id\"], item[\"owner\"])\n            reason_by_claim.setdefault(item[\"subject_id\"], item[\"missing_or_return_reason\"])\n    for claim in latest[\"snapshot\"][\"claims\"]:\n        claim_id = claim[\"claim_id\"]\n        current_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": claim[\"revision\"],\n            \"trip_id\": claim[\"trip_id\"],\n            \"status\": \"pending\",\n            \"allowed_cents\": None,\n            \"paid_cents\": claim[\"paid_cents\"],\n            \"balance_cents\": claim[\"balance_cents\"],\n            \"next_owner\": owner_by_claim.get(claim_id, claim[\"next_owner\"]),\n            \"reason\": reason_by_claim.get(\n                claim_id,\n                \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\",\n            ),\n        })\n    write_claims_csv(current_claims, output_paths[\"claims\"])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    write_repair_queue(queue, output_paths[\"queue\"])\n    _exclusive_json(output_paths[\"state\"], {\n        \"mode\": \"offline-replay\",\n        \"fresh_native_reads_performed\": False,\n        \"run_id\": manifest[\"run_id\"],\n        \"case_clock\": manifest.get(\"case_clock\"),\n        \"source_manifest_sha256\": actual_manifest_hash,\n        \"parsed_records_path\": OUTPUT_NAME,\n        \"parsed_records_sha256\": hashlib.sha256(parsed_path.read_bytes()).hexdigest(),\n        \"parsed_record_counts\": {name: len(rows) for name, rows in parsed.get(\"records\", {}).items()},\n        \"sealed_batches\": [path.relative_to(run_dir).as_posix() for path in sealed],\n        \"revision_history\": latest[\"revision_history\"],\n        \"decision_history\": latest[\"decision_history\"],\n        \"finance_reconciliations\": latest[\"finance_reconciliations\"],\n        \"cancellation_state\": latest[\"domain\"][\"cancellation_state\"],\n        \"material_corrections\": latest[\"domain\"][\"material_corrections\"],\n        \"source_record_history\": {\n            \"claim_revisions\": latest[\"domain\"][\"claim_records\"],\n            \"decisions\": latest[\"domain\"][\"decision_records\"],\n            \"finance_events\": latest[\"domain\"][\"finance_records\"],\n            \"cancellation_activities\": latest[\"domain\"][\"cancellation_records\"],\n        },\n        \"repair_queue\": queue,\n    })\n    report = _report(\n        run_id=manifest[\"run_id\"], parsed=parsed, snapshots=sealed, latest=latest,\n        output_paths=output_paths,\n    )\n    output_paths[\"report\"].write_text(report, encoding=\"utf-8\", newline=\"\\n\")\n    return {\"run_id\": manifest[\"run_id\"], \"snapshots\": sealed, \"outputs\": output_paths, \"state\": latest}\n        raise ValueError(\"repair item update does not change any field\")\n    history = {\n        \"event\": \"item-updated\", \"update_id\": update_id,\n        \"previous\": before, \"changes\": normalized,\n        \"previous_status\": item[\"status\"], \"previous_response_id\": item[\"response_id\"],\n        \"previous_resolution_source_refs\": list(item[\"resolution_source_refs\"]),\n        \"run_id\": run_id, \"batch_id\": batch_id,\n    }\n    item[\"history\"].append(history)\n    item.update(changes)\n    if \"revision\" in changes and changes[\"revision\"] != before[\"revision\"]:\n        item[\"status\"] = \"open\"\n        item[\"response_id\"] = None\n        item[\"resolution_source_refs\"] = []\n    queue[\"events\"].append({\n        \"event\": \"item-updated\", \"item_id\": item_id, \"update_id\": update_id,\n        \"changes\": normalized, \"run_id\": run_id, \"batch_id\": batch_id,\n        \"status\": item[\"status\"],\n    })\n\n\ndef owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\n    grouped: dict[str, list[dict]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n\n\ndef load_repair_queue(path: Path) -> dict:\n    \"\"\"Load the persisted queue, validating individual item and audit structure.\"\"\"\n    try:\n        persisted = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"cannot read repair queue: {exc}\") from exc\n    if not isinstance(persisted, dict):\n        raise ValueError(\"repair queue must contain an object\")\n    if persisted.get(\"queue_version\") != \"owner-queue/1\":\n        raise ValueError(\"unsupported repair queue version\")\n    queue = {key: value for key, value in persisted.items() if key != \"by_owner\"}\n    if not isinstance(queue.get(\"items\"), dict) or not isinstance(queue.get(\"events\"), list):\n        raise ValueError(\"repair queue must contain item map and event history\")\n    for item_id, item in queue[\"items\"].items():\n        if item.get(\"item_id\") != item_id or item.get(\"status\") not in {\"open\", \"resolved\"}:\n            raise ValueError(f\"invalid repair queue item {item_id}\")\n        if any(field not in item for field in REPAIR_ITEM_FIELDS):\n            raise ValueError(f\"repair queue item {item_id} is missing trace fields\")\n    expected_grouping = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    if persisted.get(\"by_owner\") != expected_grouping:\n        raise ValueError(\"persisted owner grouping does not match item owners\")\n    return queue\n\n\ndef write_repair_queue(queue: dict, path: Path) -> None:\n    \"\"\"Persist queue and history atomically without dropping prior item events.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    if path.exists():\n        old = json.loads(path.read_text(encoding=\"utf-8\"))\n        if old.get(\"queue_version\") != queue.get(\"queue_version\"):\n            raise ValueError(\"cannot replace repair queue with an incompatible version\")\n        # The caller passes the updated in-memory queue; enforce prefix-preserved\n        # audit history rather than allowing a rewrite to erase previous events.\n        old_events = old.get(\"events\", [])\n        if queue.get(\"events\", [])[: len(old_events)] != old_events:\n            raise ValueError(\"repair queue update would rewrite or remove prior events\")\n        for item_id, prior in old.get(\"items\", {}).items():\n            current = queue.get(\"items\", {}).get(item_id)\n            if current is None or current.get(\"history\", [])[: len(prior.get(\"history\", []))] != prior.get(\"history\", []):\n                raise ValueError(f\"repair queue update would remove history for {item_id}\")\n            for key in (\"item_id\", \"subject_type\", \"subject_id\"):\n                if current.get(key) != prior.get(key):\n                    raise ValueError(f\"repair queue update would rewrite {key} for {item_id}\")\n            mutable = (\"revision\", \"source_refs\", \"missing_or_return_reason\", \"owner\", \"next_action\")\n            appended_updates = [event for event in current.get(\"history\", [])[len(prior.get(\"history\", [])):]\n                                if event.get(\"event\") == \"item-updated\"]\n            for key in mutable:\n                expected = prior.get(key)\n                for event in appended_updates:\n                    if key in event.get(\"changes\", {}):\n                        expected = event[\"changes\"][key]\n                if current.get(key) != expected:\n                    raise ValueError(f\"repair queue update changed {key} without matching item history for {item_id}\")\n    persisted = dict(queue)\n    persisted[\"by_owner\"] = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=path.parent)\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n            json.dump(persisted, stream, indent=2, ensure_ascii=False)\n            stream.write(\"\\n\")\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(tmp_name, path)\n    finally:\n        if os.path.exists(tmp_name):\n            os.unlink(tmp_name)\n\"\"\"Synthetic CLI coverage for the explicitly labelled retained-input replay.\"\"\"\n\nimport hashlib\nimport io\nimport json\nimport zipfile\nimport csv\nfrom pathlib import Path\n\nfrom travel_claim.cli import main\nfrom travel_claim.outputs import CLAIMS_COLUMNS\nfrom travel_claim.snapshots import verify_snapshot\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA = ROOT / \"snapshot.schema.json\"\n\n\ndef _xlsx_bytes():\n    buffer = io.BytesIO()\n    with zipfile.ZipFile(buffer, \"w\") as archive:\n        archive.writestr(\"xl/workbook.xml\", \"<workbook><sheets/></workbook>\")\n    return buffer.getvalue()\n\n\ndef _capture(tmp_path):\n    run_id = \"offline-synthetic\"\n    run_dir = tmp_path / run_id\n    bodies = {\n        \"policy-pol-2026-2\": b\"generic policy shell\",\n        \"initial-claim-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"claim-updates-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"receipt-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"travel-registers-workbook\": _xlsx_bytes(),\n    }\n    attempts = []\n\n    def fetch(url, timeout):\n        attempts.append(url)\n        source = next(row for row in SOURCES if (row.export_url or row.url) == url)\n        return bodies[source.source_id], {\"ETag\": \"synthetic-fixture\"}, url\n\n    manifest = capture_sources(\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\n        observed_at=iter([f\"2026-09-01T00:00:{i:02d}Z\" for i in range(10)]).__next__,\n    )\n    manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n\n    def claim(revision, batch):\n        return {\n            \"source_id\": \"synthetic-claim-binder\",\n            \"source_sha256\": \"a\" * 64,\n            \"locator\": f\"PDF page {revision} synthetic\",\n            \"page\": revision,\n            \"fields\": [\n                {\"label\": \"Claim reference\", \"value\": \"C-SYN-RUN\"},\n                {\"label\": \"Revision\", \"value\": str(revision)},\n                {\"label\": \"Arrival batch\", \"value\": str(batch)},\n                {\"label\": \"Trip reference\", \"value\": \"T-SYN-RUN\"},\n                {\"label\": \"Trip revision\", \"value\": \"1\"},\n            ],\n            \"text\": \"SYNTHETIC TEST DATA ONLY\",\n        }\n\n    parsed = {\n        \"schema_version\": \"travel-claim-parsed-records/1\",\n        \"run_id\": run_id,\n        \"source_manifest\": {\"path\": \"sources.json\", \"sha256\": manifest_hash},\n        \"case_clock\": None,\n        \"case_clock_issue\": {\"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\"},\n        \"arrival_batches\": [1, 2],\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\", \"subject_type\": \"scenario\",\n                \"subject_id\": \"clock\", \"reason\": \"synthetic clock withheld\",\n                \"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\",\n                \"evidence_needed\": \"scenario clock\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\", \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\", \"reason\": \"synthetic policy withheld\",\n                \"owner\": \"Travel Administration Lead\", \"next_action\": \"provide native policy\",\n                \"evidence_needed\": \"complete policy content\",\n            },\n        ],\n        \"records\": {\n            \"claim_revisions\": [claim(1, 1), claim(2, 2)],\n            \"trips\": [{\n                \"source_id\": \"synthetic-trips\", \"source_sha256\": \"b\" * 64,\n                \"locator\": \"Trips tab row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Trip reference\": {\"value\": \"T-SYN-RUN\"},\n                    \"Trip revision\": {\"value\": 1},\n                    \"Permit reference\": {\"value\": \"P-SYN-RUN\"},\n                    \"Permit revision\": {\"value\": 1},\n                },\n            }],\n            \"decisions\": [{\n                \"source_id\": \"synthetic-review-ledger\", \"source_sha256\": \"c\" * 64,\n                \"locator\": \"Review ledger row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Decision reference\": {\"value\": \"D-SYN-RUN-R1\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Subject type\": {\"value\": \"claim\"},\n                    \"Subject reference\": {\"value\": \"C-SYN-RUN\"}, \"Revision\": {\"value\": 1},\n                    \"Outcome\": {\"value\": \"approve\"},\n                },\n            }],\n            \"finance_events\": [{\n                \"source_id\": \"synthetic-finance-ledger\", \"source_sha256\": \"d\" * 64,\n                \"locator\": \"Finance activity row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Activity reference\": {\"value\": \"F-SYN-RUN-SETTLED\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Activity type\": {\"value\": \"settled\"},\n                    \"Claim reference\": {\"value\": \"C-SYN-RUN\"}, \"Currency\": {\"value\": \"EUR\"},\n                    \"Amount (EUR)\": {\"value\": 12.5},\n                },\n            }],\n            \"cancellation_activities\": [],\n        },\n    }\n    (run_dir / \"parsed-records.json\").write_text(json.dumps(parsed), encoding=\"utf-8\")\n    return run_dir, attempts\n\n\ndef test_offline_replay_cli_seals_ordered_batches_and_writes_traceable_outputs(tmp_path):\n    run_dir, attempts = _capture(tmp_path)\n    attempts_before_replay = list(attempts)\n\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    assert attempts == attempts_before_replay\n\n    first = run_dir / \"batches/arrival-001.json\"\n    second = run_dir / \"batches/arrival-002.json\"\n    first_obj = json.loads(first.read_text(encoding=\"utf-8\"))\n    second_obj = json.loads(second.read_text(encoding=\"utf-8\"))\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\n    assert first_obj[\"predecessor\"] is None\n    assert second_obj[\"predecessor\"] == {\n        \"path\": \"batches/arrival-001.json\",\n        \"sha256\": hashlib.sha256(first.read_bytes()).hexdigest(),\n    }\n    assert \"offline-replay-mode\" in {row[\"record_id\"] for row in first_obj[\"issues\"]}\n    replay_state = json.loads((run_dir / \"offline-replay-state.json\").read_text(encoding=\"utf-8\"))\n    assert [row[\"revision\"] for row in replay_state[\"revision_history\"][\"claim\"][\"C-SYN-RUN\"][\"revisions\"]] == [1, 2]\n    assert [row[\"decision_id\"] for row in replay_state[\"decision_history\"]] == [\"D-SYN-RUN-R1\"]\n    assert [row[\"values\"][\"Activity reference\"][\"value\"] for row in replay_state[\"source_record_history\"][\"finance_events\"]] == [\"F-SYN-RUN-SETTLED\"]\n\n    with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n        rows = list(csv.DictReader(stream))\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\n        assert len(rows) == 1\n        assert rows[0][\"claim_id\"] == \"C-SYN-RUN\"\n        assert rows[0][\"revision\"] == \"2\"\n        assert rows[0][\"allowed_cents\"] == \"\"\n        assert rows[0][\"paid_cents\"] == \"1250\"\n        assert rows[0][\"balance_cents\"] == \"\"\n    report = (run_dir / \"report.md\").read_text(encoding=\"utf-8\")\n    assert \"OFFLINE REPLAY\" in report\n    assert \"Fresh native reads in this run: **no**\" in report\n    assert \"Case clock: **unresolved**\" in report\n    assert \"POL-2026.2: **unavailable**\" in report\n    queue = json.loads((run_dir / \"repair-queue.json\").read_text(encoding=\"utf-8\"))\n    assert \"by_owner\" in queue\n\n\ndef test_offline_replay_cli_refuses_to_overwrite_outputs(tmp_path):\n    run_dir, _ = _capture(tmp_path)\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    first = (run_dir / \"batches/arrival-001.json\").read_bytes()\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 1\n    assert (run_dir / \"batches/arrival-001.json\").read_bytes() == first\n\n\ndef test_report_separates_owner_grouped_open_repairs_and_external_blockers(tmp_path):\n    from travel_claim.offline_replay import _report, run_offline_replay\n    from travel_claim.outputs import add_repair_item\n\n    run_dir, _ = _capture(tmp_path)\n    parsed_path = run_dir / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    # A second claim has an unresolved trip binding. The first claim's cash\n    # evidence and both revisions must still survive the complete replay.\n    independent = json.loads(json.dumps(parsed[\"records\"][\"claim_revisions\"][0]))\n    independent[\"fields\"][0][\"value\"] = \"C-UNRESOLVED\"\n    independent[\"fields\"][3][\"value\"] = \"T-MISSING\"\n    parsed[\"records\"][\"claim_revisions\"].append(independent)\n    parsed_path.write_text(json.dumps(parsed))\n    result = run_offline_replay(run_dir, schema_path=SCHEMA)\n    claims = {row[\"claim_id\"]: row for row in result[\"state\"][\"snapshot\"][\"claims\"]}\n    assert set(claims) == {\"C-SYN-RUN\", \"C-UNRESOLVED\"}\n    assert claims[\"C-SYN-RUN\"][\"revision\"] == 2\n    assert claims[\"C-SYN-RUN\"][\"paid_cents\"] == 1250\n    assert claims[\"C-SYN-RUN\"][\"allowed_cents\"] is None\n    queue = result[\"state\"][\"domain\"][\"repair_queue\"]\n    report = result[\"outputs\"][\"report\"].read_text()\n    claim_section = report.split(\"## Claim-specific actionable repairs by owner\\n\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    blockers = report.split(\"## Run-level external blockers\\n\", 1)[1].split(\"## Outputs\", 1)[0]\n    assert \"offline replay\" in blockers\n    assert \"scenario-case-clock\" in blockers\n    assert \"reimbursement-policy-pol-2026-2\" in blockers\n    assert \"scenario-case-clock\" not in claim_section\n    assert \"reimbursement-policy-pol-2026-2\" not in claim_section\n    assert \"Independent valid records continue\" in report\n    for item in queue[\"items\"].values():\n        if item[\"subject_type\"] != \"claim\" or item[\"status\"] != \"open\":\n            continue\n        owner_section = claim_section.split(f\"### {item['owner']}\\n\", 1)[1].split(\"\\n### \", 1)[0]\n        assert f\"Repair `{item['item_id']}`\" in owner_section\n        assert f\"subject claim `{item['subject_id']}`, revision {item['revision']}\" in owner_section\n        assert f\"Next action: {item['next_action']}\" in owner_section\n        assert f\"run `{item['run_id']}`, batch `{item['batch_id']}`\" in owner_section\n        for ref in item[\"source_refs\"]:\n            assert f\"`{ref}`\" in owner_section\n    assert claim_section.count(\"### \") == len({item[\"owner\"] for item in queue[\"items\"].values() if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\"})\n\n    # Report filtering must leave persisted queue history untouched and must\n    # keep non-claim repairs in their own section, even with the same owner.\n    resolved_id = next(iter(queue[\"items\"]))\n    queue[\"items\"][resolved_id][\"status\"] = \"resolved\"\n    add_repair_item(\n        queue, item_id=\"permit-repair\", subject_type=\"permit\", subject_id=\"P-SYN\",\n        revision=1, source_refs=[\"retained-permit@hash#row 2\"],\n        missing_or_return_reason=\"missing permit evidence\", owner=\"Travel Administration Lead\",\n        next_action=\"obtain permit evidence\", run_id=parsed[\"run_id\"], batch_id=\"arrival-002\",\n    )\n    rendered = _report(run_id=parsed[\"run_id\"], parsed=parsed,\n                       snapshots=result[\"snapshots\"], latest=result[\"state\"],\n                       output_paths=result[\"outputs\"])\n    assert f\"Repair `{resolved_id}`\" not in rendered\n    assert queue[\"items\"][resolved_id][\"status\"] == \"resolved\"\n    claim_section = rendered.split(\"## Claim-specific\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    permit_section = rendered.split(\"## Trip and permit\", 1)[1].split(\"## Run-level\", 1)[0]\n    assert \"permit-repair\" not in claim_section\n    assert \"subject permit `P-SYN`, revision 1\" in permit_section\n    assert \"Next action: obtain permit evidence\" in permit_section\n        except (OSError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not write claims CSV: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Wrote claims CSV: {args.output}\")\n        return 0\n    if args.command == \"offline-replay\":\n        try:\n            result = run_offline_replay(args.run_dir, schema_path=args.schema)\n        except (OSError, KeyError, json.JSONDecodeError, ValueError, FileExistsError) as exc:\n            print(f\"Offline replay failed: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"OFFLINE REPLAY complete: {result['run_id']} (no fresh native-source reads)\")\n        for snapshot in result[\"snapshots\"]:\n            print(f\"Snapshot: {snapshot}\")\n        for label, output in result[\"outputs\"].items():\n            print(f\"{label}: {output}\")\n        return 0\n    return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","stderr":"","aggregated_output":"?? artifacts/runs/\n\"\"\"Run a labelled, integrity-checked replay over previously retained records.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .integration import integrate_arrival_batch\nfrom .outputs import owner_grouped_view, write_claims_csv, write_repair_queue\nfrom .parsing import OUTPUT_NAME\nfrom .snapshots import seal_batch_snapshot, verify_snapshot\nfrom .sources import verify_source_manifest\n\n\nOFFLINE_MARKER = {\n    \"record_id\": \"offline-replay-mode\",\n    \"reason\": \"Offline replay of previously retained source content; this run did not attempt fresh native-source reads.\",\n    \"owner\": \"Travel Administration Lead\",\n    \"resolution_needed\": \"Perform a new authorized run with fresh reads of all five native sources before relying on current source state.\",\n}\n\n\ndef _exclusive_json(path: Path, value: Any) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        json.dump(value, stream, indent=2, ensure_ascii=False)\n        stream.write(\"\\n\")\n\n\ndef _report(\n    *, run_id: str, parsed: dict[str, Any], snapshots: list[Path], latest: dict[str, Any],\n    output_paths: dict[str, Path],\n) -> str:\n    manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n    lines = [\n        \"# Project D operations handoff — OFFLINE REPLAY\",\n        \"\",\n        \"> This is a structural replay from previously retained inputs. It did not perform fresh native-source reads and does not establish policy eligibility, reimbursement entitlement, approval readiness, or closure.\",\n        \"\",\n        f\"- Run ID: `{run_id}`\",\n        \"- Mode: `offline-replay`\",\n        \"- Fresh native reads in this run: **no**\",\n        f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n        f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n        \"- Retained source observations: \" + \"; \".join(\n            f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n                (snapshots[0].parents[1] / \"sources.json\").read_text(encoding=\"utf-8\")\n            )[\"files\"]\n        ) + \".\",\n        \"\",\n        \"## Batch projections\",\n        \"\",\n    ]\n    for path in snapshots:\n        snapshot = json.loads(path.read_text(encoding=\"utf-8\"))\n        lines.append(\n            f\"- `{path.relative_to(path.parents[1])}` — {len(snapshot['claims'])} current claim rows, \"\n            f\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \"\n            f\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\"\n        )\n    lines.extend([\n        \"\",\n        \"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained; no obligation or entitlement is inferred. Claim monetary entitlement and balance remain null when unsupported.\",\n        \"\",\n        \"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\",\n        \"\",\n    ])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    for title, subject_types in (\n        (\"Claim-specific actionable repairs by owner\", {\"claim\"}),\n        (\"Trip and permit actionable repairs by owner\", {\"trip\", \"permit\"}),\n    ):\n        open_queue = {\"items\": {\n            key: item for key, item in queue[\"items\"].items()\n            if item[\"status\"] == \"open\" and item[\"subject_type\"] in subject_types\n        }}\n        lines.extend([\n            f\"## {title}\", \"\",\n            f\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\",\n            \"\",\n        ])\n        if not open_queue[\"items\"]:\n            lines.extend([\"No open repair items in this category; this does not establish policy readiness or closure.\", \"\"])\n        for owner, items in owner_grouped_view(open_queue).items():\n            lines.extend([f\"### {owner}\", \"\"])\n            for item in items:\n                lines.extend([\n                    f\"- Repair `{item['item_id']}` — subject {item['subject_type']} `{item['subject_id']}`, revision {item['revision']} (**open**).\",\n                    f\"  - Reason: {item['missing_or_return_reason']}.\",\n                    f\"  - Next action: {item['next_action']}.\",\n                    f\"  - Opened in run `{item['run_id']}`, batch `{item['batch_id']}`.\",\n                    \"  - Retained source references: \" + \"; \".join(\n                        f\"`{ref}`\" for ref in item['source_refs']\n                    ) if item['source_refs'] else \"  - Retained source references: unavailable; obtain authoritative evidence.\",\n                ])\n            lines.append(\"\")\n    lines.extend([\n        \"## Run-level external blockers\", \"\",\n        \"These retained policy and clock issues apply to the run as a whole and are separate from claim repairs. They remain unresolved in this offline replay; no case-clock date or policy rule is inferred.\",\n        \"\",\n    ])\n    for blocker in parsed.get(\"unresolved_issues\", []):\n        lines.append(\n            f\"- `{blocker['record_id']}` ({blocker.get('subject_type')} `{blocker.get('subject_id')}`): \"\n            f\"{blocker['reason']} Owner: {blocker['owner']}. Next: {blocker['next_action']} \"\n            f\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\"\n        )\n    lines.extend([\n        \"\",\n        \"## Outputs\",\n        \"\",\n        f\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\",\n        f\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\",\n        f\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\",\n        \"\",\n        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n        \"\",\n    ])\n    return \"\\n\".join(lines)\n\n\ndef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n    manifest_path = run_dir / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    parsed_path = run_dir / OUTPUT_NAME\n    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n    batches = parsed.get(\"arrival_batches\")\n    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n    output_paths = {\n        \"claims\": run_dir / \"claims.csv\",\n        \"report\": run_dir / \"report.md\",\n        \"queue\": run_dir / \"repair-queue.json\",\n        \"state\": run_dir / \"offline-replay-state.json\",\n    }\n    occupied = [str(path) for path in output_paths.values() if path.exists()]\n    if occupied:\n        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n    batches_dir = run_dir / \"batches\"\n    if batches_dir.exists() and any(batches_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n\n    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n    previous: dict[str, Any] | None = None\n    previous_path: Path | None = None\n    sealed: list[Path] = []\n    for number in batches:\n        batch_id = f\"arrival-{number:03d}\"\n        predecessor = None\n        if previous_path is not None:\n            predecessor = {\n                \"path\": f\"batches/{previous_path.name}\",\n                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n            }\n        current = integrate_arrival_batch(\n            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            source_binding=binding, predecessor=predecessor, prior_result=previous,\n        )\n        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n        path = seal_batch_snapshot(\n            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            predecessor_path=previous_path, schema_path=schema_path,\n            allow_unconfirmed_case_clock=True, **{\n                key: current[\"snapshot\"][key]\n                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\")\n            },\n        )\n        validation = verify_snapshot(path, run_dir, schema_path)\n        if validation:\n            raise ValueError(f\"Snapshot verification failed for {path}: \" + \"; \".join(validation))\n        sealed.append(path)\n        previous, previous_path = current, path\n\n    latest = previous\n    assert latest is not None\n    current_claims = []\n    owner_by_claim: dict[str, str] = {}\n    reason_by_claim: dict[str, str] = {}\n    for item in latest[\"domain\"][\"repair_queue\"][\"items\"].values():\n        if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\":\n            owner_by_claim.setdefault(item[\"subject_id\"], item[\"owner\"])\n            reason_by_claim.setdefault(item[\"subject_id\"], item[\"missing_or_return_reason\"])\n    for claim in latest[\"snapshot\"][\"claims\"]:\n        claim_id = claim[\"claim_id\"]\n        current_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": claim[\"revision\"],\n            \"trip_id\": claim[\"trip_id\"],\n            \"status\": \"pending\",\n            \"allowed_cents\": None,\n            \"paid_cents\": claim[\"paid_cents\"],\n            \"balance_cents\": claim[\"balance_cents\"],\n            \"next_owner\": owner_by_claim.get(claim_id, claim[\"next_owner\"]),\n            \"reason\": reason_by_claim.get(\n                claim_id,\n                \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\",\n            ),\n        })\n    write_claims_csv(current_claims, output_paths[\"claims\"])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    write_repair_queue(queue, output_paths[\"queue\"])\n    _exclusive_json(output_paths[\"state\"], {\n        \"mode\": \"offline-replay\",\n        \"fresh_native_reads_performed\": False,\n        \"run_id\": manifest[\"run_id\"],\n        \"case_clock\": manifest.get(\"case_clock\"),\n        \"source_manifest_sha256\": actual_manifest_hash,\n        \"parsed_records_path\": OUTPUT_NAME,\n        \"parsed_records_sha256\": hashlib.sha256(parsed_path.read_bytes()).hexdigest(),\n        \"parsed_record_counts\": {name: len(rows) for name, rows in parsed.get(\"records\", {}).items()},\n        \"sealed_batches\": [path.relative_to(run_dir).as_posix() for path in sealed],\n        \"revision_history\": latest[\"revision_history\"],\n        \"decision_history\": latest[\"decision_history\"],\n        \"finance_reconciliations\": latest[\"finance_reconciliations\"],\n        \"cancellation_state\": latest[\"domain\"][\"cancellation_state\"],\n        \"material_corrections\": latest[\"domain\"][\"material_corrections\"],\n        \"source_record_history\": {\n            \"claim_revisions\": latest[\"domain\"][\"claim_records\"],\n            \"decisions\": latest[\"domain\"][\"decision_records\"],\n            \"finance_events\": latest[\"domain\"][\"finance_records\"],\n            \"cancellation_activities\": latest[\"domain\"][\"cancellation_records\"],\n        },\n        \"repair_queue\": queue,\n    })\n    report = _report(\n        run_id=manifest[\"run_id\"], parsed=parsed, snapshots=sealed, latest=latest,\n        output_paths=output_paths,\n    )\n    output_paths[\"report\"].write_text(report, encoding=\"utf-8\", newline=\"\\n\")\n    return {\"run_id\": manifest[\"run_id\"], \"snapshots\": sealed, \"outputs\": output_paths, \"state\": latest}\n        raise ValueError(\"repair item update does not change any field\")\n    history = {\n        \"event\": \"item-updated\", \"update_id\": update_id,\n        \"previous\": before, \"changes\": normalized,\n        \"previous_status\": item[\"status\"], \"previous_response_id\": item[\"response_id\"],\n        \"previous_resolution_source_refs\": list(item[\"resolution_source_refs\"]),\n        \"run_id\": run_id, \"batch_id\": batch_id,\n    }\n    item[\"history\"].append(history)\n    item.update(changes)\n    if \"revision\" in changes and changes[\"revision\"] != before[\"revision\"]:\n        item[\"status\"] = \"open\"\n        item[\"response_id\"] = None\n        item[\"resolution_source_refs\"] = []\n    queue[\"events\"].append({\n        \"event\": \"item-updated\", \"item_id\": item_id, \"update_id\": update_id,\n        \"changes\": normalized, \"run_id\": run_id, \"batch_id\": batch_id,\n        \"status\": item[\"status\"],\n    })\n\n\ndef owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\n    grouped: dict[str, list[dict]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n\n\ndef load_repair_queue(path: Path) -> dict:\n    \"\"\"Load the persisted queue, validating individual item and audit structure.\"\"\"\n    try:\n        persisted = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"cannot read repair queue: {exc}\") from exc\n    if not isinstance(persisted, dict):\n        raise ValueError(\"repair queue must contain an object\")\n    if persisted.get(\"queue_version\") != \"owner-queue/1\":\n        raise ValueError(\"unsupported repair queue version\")\n    queue = {key: value for key, value in persisted.items() if key != \"by_owner\"}\n    if not isinstance(queue.get(\"items\"), dict) or not isinstance(queue.get(\"events\"), list):\n        raise ValueError(\"repair queue must contain item map and event history\")\n    for item_id, item in queue[\"items\"].items():\n        if item.get(\"item_id\") != item_id or item.get(\"status\") not in {\"open\", \"resolved\"}:\n            raise ValueError(f\"invalid repair queue item {item_id}\")\n        if any(field not in item for field in REPAIR_ITEM_FIELDS):\n            raise ValueError(f\"repair queue item {item_id} is missing trace fields\")\n    expected_grouping = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    if persisted.get(\"by_owner\") != expected_grouping:\n        raise ValueError(\"persisted owner grouping does not match item owners\")\n    return queue\n\n\ndef write_repair_queue(queue: dict, path: Path) -> None:\n    \"\"\"Persist queue and history atomically without dropping prior item events.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    if path.exists():\n        old = json.loads(path.read_text(encoding=\"utf-8\"))\n        if old.get(\"queue_version\") != queue.get(\"queue_version\"):\n            raise ValueError(\"cannot replace repair queue with an incompatible version\")\n        # The caller passes the updated in-memory queue; enforce prefix-preserved\n        # audit history rather than allowing a rewrite to erase previous events.\n        old_events = old.get(\"events\", [])\n        if queue.get(\"events\", [])[: len(old_events)] != old_events:\n            raise ValueError(\"repair queue update would rewrite or remove prior events\")\n        for item_id, prior in old.get(\"items\", {}).items():\n            current = queue.get(\"items\", {}).get(item_id)\n            if current is None or current.get(\"history\", [])[: len(prior.get(\"history\", []))] != prior.get(\"history\", []):\n                raise ValueError(f\"repair queue update would remove history for {item_id}\")\n            for key in (\"item_id\", \"subject_type\", \"subject_id\"):\n                if current.get(key) != prior.get(key):\n                    raise ValueError(f\"repair queue update would rewrite {key} for {item_id}\")\n            mutable = (\"revision\", \"source_refs\", \"missing_or_return_reason\", \"owner\", \"next_action\")\n            appended_updates = [event for event in current.get(\"history\", [])[len(prior.get(\"history\", [])):]\n                                if event.get(\"event\") == \"item-updated\"]\n            for key in mutable:\n                expected = prior.get(key)\n                for event in appended_updates:\n                    if key in event.get(\"changes\", {}):\n                        expected = event[\"changes\"][key]\n                if current.get(key) != expected:\n                    raise ValueError(f\"repair queue update changed {key} without matching item history for {item_id}\")\n    persisted = dict(queue)\n    persisted[\"by_owner\"] = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=path.parent)\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n            json.dump(persisted, stream, indent=2, ensure_ascii=False)\n            stream.write(\"\\n\")\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(tmp_name, path)\n    finally:\n        if os.path.exists(tmp_name):\n            os.unlink(tmp_name)\n\"\"\"Synthetic CLI coverage for the explicitly labelled retained-input replay.\"\"\"\n\nimport hashlib\nimport io\nimport json\nimport zipfile\nimport csv\nfrom pathlib import Path\n\nfrom travel_claim.cli import main\nfrom travel_claim.outputs import CLAIMS_COLUMNS\nfrom travel_claim.snapshots import verify_snapshot\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA = ROOT / \"snapshot.schema.json\"\n\n\ndef _xlsx_bytes():\n    buffer = io.BytesIO()\n    with zipfile.ZipFile(buffer, \"w\") as archive:\n        archive.writestr(\"xl/workbook.xml\", \"<workbook><sheets/></workbook>\")\n    return buffer.getvalue()\n\n\ndef _capture(tmp_path):\n    run_id = \"offline-synthetic\"\n    run_dir = tmp_path / run_id\n    bodies = {\n        \"policy-pol-2026-2\": b\"generic policy shell\",\n        \"initial-claim-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"claim-updates-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"receipt-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"travel-registers-workbook\": _xlsx_bytes(),\n    }\n    attempts = []\n\n    def fetch(url, timeout):\n        attempts.append(url)\n        source = next(row for row in SOURCES if (row.export_url or row.url) == url)\n        return bodies[source.source_id], {\"ETag\": \"synthetic-fixture\"}, url\n\n    manifest = capture_sources(\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\n        observed_at=iter([f\"2026-09-01T00:00:{i:02d}Z\" for i in range(10)]).__next__,\n    )\n    manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n\n    def claim(revision, batch):\n        return {\n            \"source_id\": \"synthetic-claim-binder\",\n            \"source_sha256\": \"a\" * 64,\n            \"locator\": f\"PDF page {revision} synthetic\",\n            \"page\": revision,\n            \"fields\": [\n                {\"label\": \"Claim reference\", \"value\": \"C-SYN-RUN\"},\n                {\"label\": \"Revision\", \"value\": str(revision)},\n                {\"label\": \"Arrival batch\", \"value\": str(batch)},\n                {\"label\": \"Trip reference\", \"value\": \"T-SYN-RUN\"},\n                {\"label\": \"Trip revision\", \"value\": \"1\"},\n            ],\n            \"text\": \"SYNTHETIC TEST DATA ONLY\",\n        }\n\n    parsed = {\n        \"schema_version\": \"travel-claim-parsed-records/1\",\n        \"run_id\": run_id,\n        \"source_manifest\": {\"path\": \"sources.json\", \"sha256\": manifest_hash},\n        \"case_clock\": None,\n        \"case_clock_issue\": {\"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\"},\n        \"arrival_batches\": [1, 2],\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\", \"subject_type\": \"scenario\",\n                \"subject_id\": \"clock\", \"reason\": \"synthetic clock withheld\",\n                \"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\",\n                \"evidence_needed\": \"scenario clock\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\", \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\", \"reason\": \"synthetic policy withheld\",\n                \"owner\": \"Travel Administration Lead\", \"next_action\": \"provide native policy\",\n                \"evidence_needed\": \"complete policy content\",\n            },\n        ],\n        \"records\": {\n            \"claim_revisions\": [claim(1, 1), claim(2, 2)],\n            \"trips\": [{\n                \"source_id\": \"synthetic-trips\", \"source_sha256\": \"b\" * 64,\n                \"locator\": \"Trips tab row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Trip reference\": {\"value\": \"T-SYN-RUN\"},\n                    \"Trip revision\": {\"value\": 1},\n                    \"Permit reference\": {\"value\": \"P-SYN-RUN\"},\n                    \"Permit revision\": {\"value\": 1},\n                },\n            }],\n            \"decisions\": [{\n                \"source_id\": \"synthetic-review-ledger\", \"source_sha256\": \"c\" * 64,\n                \"locator\": \"Review ledger row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Decision reference\": {\"value\": \"D-SYN-RUN-R1\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Subject type\": {\"value\": \"claim\"},\n                    \"Subject reference\": {\"value\": \"C-SYN-RUN\"}, \"Revision\": {\"value\": 1},\n                    \"Outcome\": {\"value\": \"approve\"},\n                },\n            }],\n            \"finance_events\": [{\n                \"source_id\": \"synthetic-finance-ledger\", \"source_sha256\": \"d\" * 64,\n                \"locator\": \"Finance activity row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Activity reference\": {\"value\": \"F-SYN-RUN-SETTLED\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Activity type\": {\"value\": \"settled\"},\n                    \"Claim reference\": {\"value\": \"C-SYN-RUN\"}, \"Currency\": {\"value\": \"EUR\"},\n                    \"Amount (EUR)\": {\"value\": 12.5},\n                },\n            }],\n            \"cancellation_activities\": [],\n        },\n    }\n    (run_dir / \"parsed-records.json\").write_text(json.dumps(parsed), encoding=\"utf-8\")\n    return run_dir, attempts\n\n\ndef test_offline_replay_cli_seals_ordered_batches_and_writes_traceable_outputs(tmp_path):\n    run_dir, attempts = _capture(tmp_path)\n    attempts_before_replay = list(attempts)\n\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    assert attempts == attempts_before_replay\n\n    first = run_dir / \"batches/arrival-001.json\"\n    second = run_dir / \"batches/arrival-002.json\"\n    first_obj = json.loads(first.read_text(encoding=\"utf-8\"))\n    second_obj = json.loads(second.read_text(encoding=\"utf-8\"))\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\n    assert first_obj[\"predecessor\"] is None\n    assert second_obj[\"predecessor\"] == {\n        \"path\": \"batches/arrival-001.json\",\n        \"sha256\": hashlib.sha256(first.read_bytes()).hexdigest(),\n    }\n    assert \"offline-replay-mode\" in {row[\"record_id\"] for row in first_obj[\"issues\"]}\n    replay_state = json.loads((run_dir / \"offline-replay-state.json\").read_text(encoding=\"utf-8\"))\n    assert [row[\"revision\"] for row in replay_state[\"revision_history\"][\"claim\"][\"C-SYN-RUN\"][\"revisions\"]] == [1, 2]\n    assert [row[\"decision_id\"] for row in replay_state[\"decision_history\"]] == [\"D-SYN-RUN-R1\"]\n    assert [row[\"values\"][\"Activity reference\"][\"value\"] for row in replay_state[\"source_record_history\"][\"finance_events\"]] == [\"F-SYN-RUN-SETTLED\"]\n\n    with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n        rows = list(csv.DictReader(stream))\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\n        assert len(rows) == 1\n        assert rows[0][\"claim_id\"] == \"C-SYN-RUN\"\n        assert rows[0][\"revision\"] == \"2\"\n        assert rows[0][\"allowed_cents\"] == \"\"\n        assert rows[0][\"paid_cents\"] == \"1250\"\n        assert rows[0][\"balance_cents\"] == \"\"\n    report = (run_dir / \"report.md\").read_text(encoding=\"utf-8\")\n    assert \"OFFLINE REPLAY\" in report\n    assert \"Fresh native reads in this run: **no**\" in report\n    assert \"Case clock: **unresolved**\" in report\n    assert \"POL-2026.2: **unavailable**\" in report\n    queue = json.loads((run_dir / \"repair-queue.json\").read_text(encoding=\"utf-8\"))\n    assert \"by_owner\" in queue\n\n\ndef test_offline_replay_cli_refuses_to_overwrite_outputs(tmp_path):\n    run_dir, _ = _capture(tmp_path)\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    first = (run_dir / \"batches/arrival-001.json\").read_bytes()\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 1\n    assert (run_dir / \"batches/arrival-001.json\").read_bytes() == first\n\n\ndef test_report_separates_owner_grouped_open_repairs_and_external_blockers(tmp_path):\n    from travel_claim.offline_replay import _report, run_offline_replay\n    from travel_claim.outputs import add_repair_item\n\n    run_dir, _ = _capture(tmp_path)\n    parsed_path = run_dir / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    # A second claim has an unresolved trip binding. The first claim's cash\n    # evidence and both revisions must still survive the complete replay.\n    independent = json.loads(json.dumps(parsed[\"records\"][\"claim_revisions\"][0]))\n    independent[\"fields\"][0][\"value\"] = \"C-UNRESOLVED\"\n    independent[\"fields\"][3][\"value\"] = \"T-MISSING\"\n    parsed[\"records\"][\"claim_revisions\"].append(independent)\n    parsed_path.write_text(json.dumps(parsed))\n    result = run_offline_replay(run_dir, schema_path=SCHEMA)\n    claims = {row[\"claim_id\"]: row for row in result[\"state\"][\"snapshot\"][\"claims\"]}\n    assert set(claims) == {\"C-SYN-RUN\", \"C-UNRESOLVED\"}\n    assert claims[\"C-SYN-RUN\"][\"revision\"] == 2\n    assert claims[\"C-SYN-RUN\"][\"paid_cents\"] == 1250\n    assert claims[\"C-SYN-RUN\"][\"allowed_cents\"] is None\n    queue = result[\"state\"][\"domain\"][\"repair_queue\"]\n    report = result[\"outputs\"][\"report\"].read_text()\n    claim_section = report.split(\"## Claim-specific actionable repairs by owner\\n\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    blockers = report.split(\"## Run-level external blockers\\n\", 1)[1].split(\"## Outputs\", 1)[0]\n    assert \"offline replay\" in blockers\n    assert \"scenario-case-clock\" in blockers\n    assert \"reimbursement-policy-pol-2026-2\" in blockers\n    assert \"scenario-case-clock\" not in claim_section\n    assert \"reimbursement-policy-pol-2026-2\" not in claim_section\n    assert \"Independent valid records continue\" in report\n    for item in queue[\"items\"].values():\n        if item[\"subject_type\"] != \"claim\" or item[\"status\"] != \"open\":\n            continue\n        owner_section = claim_section.split(f\"### {item['owner']}\\n\", 1)[1].split(\"\\n### \", 1)[0]\n        assert f\"Repair `{item['item_id']}`\" in owner_section\n        assert f\"subject claim `{item['subject_id']}`, revision {item['revision']}\" in owner_section\n        assert f\"Next action: {item['next_action']}\" in owner_section\n        assert f\"run `{item['run_id']}`, batch `{item['batch_id']}`\" in owner_section\n        for ref in item[\"source_refs\"]:\n            assert f\"`{ref}`\" in owner_section\n    assert claim_section.count(\"### \") == len({item[\"owner\"] for item in queue[\"items\"].values() if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\"})\n\n    # Report filtering must leave persisted queue history untouched and must\n    # keep non-claim repairs in their own section, even with the same owner.\n    resolved_id = next(iter(queue[\"items\"]))\n    queue[\"items\"][resolved_id][\"status\"] = \"resolved\"\n    add_repair_item(\n        queue, item_id=\"permit-repair\", subject_type=\"permit\", subject_id=\"P-SYN\",\n        revision=1, source_refs=[\"retained-permit@hash#row 2\"],\n        missing_or_return_reason=\"missing permit evidence\", owner=\"Travel Administration Lead\",\n        next_action=\"obtain permit evidence\", run_id=parsed[\"run_id\"], batch_id=\"arrival-002\",\n    )\n    rendered = _report(run_id=parsed[\"run_id\"], parsed=parsed,\n                       snapshots=result[\"snapshots\"], latest=result[\"state\"],\n                       output_paths=result[\"outputs\"])\n    assert f\"Repair `{resolved_id}`\" not in rendered\n    assert queue[\"items\"][resolved_id][\"status\"] == \"resolved\"\n    claim_section = rendered.split(\"## Claim-specific\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    permit_section = rendered.split(\"## Trip and permit\", 1)[1].split(\"## Run-level\", 1)[0]\n    assert \"permit-repair\" not in claim_section\n    assert \"subject permit `P-SYN`, revision 1\" in permit_section\n    assert \"Next action: obtain permit evidence\" in permit_section\n        except (OSError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not write claims CSV: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Wrote claims CSV: {args.output}\")\n        return 0\n    if args.command == \"offline-replay\":\n        try:\n            result = run_offline_replay(args.run_dir, schema_path=args.schema)\n        except (OSError, KeyError, json.JSONDecodeError, ValueError, FileExistsError) as exc:\n            print(f\"Offline replay failed: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"OFFLINE REPLAY complete: {result['run_id']} (no fresh native-source reads)\")\n        for snapshot in result[\"snapshots\"]:\n            print(f\"Snapshot: {snapshot}\")\n        for label, output in result[\"outputs\"].items():\n            print(f\"{label}: {output}\")\n        return 0\n    return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"duration":{"secs":0,"nanos":34731620},"formatted_output":"?? artifacts/runs/\n\"\"\"Run a labelled, integrity-checked replay over previously retained records.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .integration import integrate_arrival_batch\nfrom .outputs import owner_grouped_view, write_claims_csv, write_repair_queue\nfrom .parsing import OUTPUT_NAME\nfrom .snapshots import seal_batch_snapshot, verify_snapshot\nfrom .sources import verify_source_manifest\n\n\nOFFLINE_MARKER = {\n    \"record_id\": \"offline-replay-mode\",\n    \"reason\": \"Offline replay of previously retained source content; this run did not attempt fresh native-source reads.\",\n    \"owner\": \"Travel Administration Lead\",\n    \"resolution_needed\": \"Perform a new authorized run with fresh reads of all five native sources before relying on current source state.\",\n}\n\n\ndef _exclusive_json(path: Path, value: Any) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        json.dump(value, stream, indent=2, ensure_ascii=False)\n        stream.write(\"\\n\")\n\n\ndef _report(\n    *, run_id: str, parsed: dict[str, Any], snapshots: list[Path], latest: dict[str, Any],\n    output_paths: dict[str, Path],\n) -> str:\n    manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \"sources.json\").read_bytes()).hexdigest()\n    lines = [\n        \"# Project D operations handoff — OFFLINE REPLAY\",\n        \"\",\n        \"> This is a structural replay from previously retained inputs. It did not perform fresh native-source reads and does not establish policy eligibility, reimbursement entitlement, approval readiness, or closure.\",\n        \"\",\n        f\"- Run ID: `{run_id}`\",\n        \"- Mode: `offline-replay`\",\n        \"- Fresh native reads in this run: **no**\",\n        f\"- Retained `sources.json` SHA-256: `{manifest_hash}`\",\n        f\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\",\n        \"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\",\n        f\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\",\n        \"- Retained source observations: \" + \"; \".join(\n            f\"`{row['source_id']}`={row['status']}\" for row in json.loads(\n                (snapshots[0].parents[1] / \"sources.json\").read_text(encoding=\"utf-8\")\n            )[\"files\"]\n        ) + \".\",\n        \"\",\n        \"## Batch projections\",\n        \"\",\n    ]\n    for path in snapshots:\n        snapshot = json.loads(path.read_text(encoding=\"utf-8\"))\n        lines.append(\n            f\"- `{path.relative_to(path.parents[1])}` — {len(snapshot['claims'])} current claim rows, \"\n            f\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \"\n            f\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\"\n        )\n    lines.extend([\n        \"\",\n        \"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained; no obligation or entitlement is inferred. Claim monetary entitlement and balance remain null when unsupported.\",\n        \"\",\n        \"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\",\n        \"\",\n    ])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    for title, subject_types in (\n        (\"Claim-specific actionable repairs by owner\", {\"claim\"}),\n        (\"Trip and permit actionable repairs by owner\", {\"trip\", \"permit\"}),\n    ):\n        open_queue = {\"items\": {\n            key: item for key, item in queue[\"items\"].items()\n            if item[\"status\"] == \"open\" and item[\"subject_type\"] in subject_types\n        }}\n        lines.extend([\n            f\"## {title}\", \"\",\n            f\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\",\n            \"\",\n        ])\n        if not open_queue[\"items\"]:\n            lines.extend([\"No open repair items in this category; this does not establish policy readiness or closure.\", \"\"])\n        for owner, items in owner_grouped_view(open_queue).items():\n            lines.extend([f\"### {owner}\", \"\"])\n            for item in items:\n                lines.extend([\n                    f\"- Repair `{item['item_id']}` — subject {item['subject_type']} `{item['subject_id']}`, revision {item['revision']} (**open**).\",\n                    f\"  - Reason: {item['missing_or_return_reason']}.\",\n                    f\"  - Next action: {item['next_action']}.\",\n                    f\"  - Opened in run `{item['run_id']}`, batch `{item['batch_id']}`.\",\n                    \"  - Retained source references: \" + \"; \".join(\n                        f\"`{ref}`\" for ref in item['source_refs']\n                    ) if item['source_refs'] else \"  - Retained source references: unavailable; obtain authoritative evidence.\",\n                ])\n            lines.append(\"\")\n    lines.extend([\n        \"## Run-level external blockers\", \"\",\n        \"These retained policy and clock issues apply to the run as a whole and are separate from claim repairs. They remain unresolved in this offline replay; no case-clock date or policy rule is inferred.\",\n        \"\",\n    ])\n    for blocker in parsed.get(\"unresolved_issues\", []):\n        lines.append(\n            f\"- `{blocker['record_id']}` ({blocker.get('subject_type')} `{blocker.get('subject_id')}`): \"\n            f\"{blocker['reason']} Owner: {blocker['owner']}. Next: {blocker['next_action']} \"\n            f\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\"\n        )\n    lines.extend([\n        \"\",\n        \"## Outputs\",\n        \"\",\n        f\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\",\n        f\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\",\n        f\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\",\n        \"\",\n        \"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\",\n        \"\",\n    ])\n    return \"\\n\".join(lines)\n\n\ndef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n    manifest_path = run_dir / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    parsed_path = run_dir / OUTPUT_NAME\n    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n    batches = parsed.get(\"arrival_batches\")\n    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n    output_paths = {\n        \"claims\": run_dir / \"claims.csv\",\n        \"report\": run_dir / \"report.md\",\n        \"queue\": run_dir / \"repair-queue.json\",\n        \"state\": run_dir / \"offline-replay-state.json\",\n    }\n    occupied = [str(path) for path in output_paths.values() if path.exists()]\n    if occupied:\n        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n    batches_dir = run_dir / \"batches\"\n    if batches_dir.exists() and any(batches_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n\n    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n    previous: dict[str, Any] | None = None\n    previous_path: Path | None = None\n    sealed: list[Path] = []\n    for number in batches:\n        batch_id = f\"arrival-{number:03d}\"\n        predecessor = None\n        if previous_path is not None:\n            predecessor = {\n                \"path\": f\"batches/{previous_path.name}\",\n                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n            }\n        current = integrate_arrival_batch(\n            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            source_binding=binding, predecessor=predecessor, prior_result=previous,\n        )\n        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n        path = seal_batch_snapshot(\n            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            predecessor_path=previous_path, schema_path=schema_path,\n            allow_unconfirmed_case_clock=True, **{\n                key: current[\"snapshot\"][key]\n                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\")\n            },\n        )\n        validation = verify_snapshot(path, run_dir, schema_path)\n        if validation:\n            raise ValueError(f\"Snapshot verification failed for {path}: \" + \"; \".join(validation))\n        sealed.append(path)\n        previous, previous_path = current, path\n\n    latest = previous\n    assert latest is not None\n    current_claims = []\n    owner_by_claim: dict[str, str] = {}\n    reason_by_claim: dict[str, str] = {}\n    for item in latest[\"domain\"][\"repair_queue\"][\"items\"].values():\n        if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\":\n            owner_by_claim.setdefault(item[\"subject_id\"], item[\"owner\"])\n            reason_by_claim.setdefault(item[\"subject_id\"], item[\"missing_or_return_reason\"])\n    for claim in latest[\"snapshot\"][\"claims\"]:\n        claim_id = claim[\"claim_id\"]\n        current_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": claim[\"revision\"],\n            \"trip_id\": claim[\"trip_id\"],\n            \"status\": \"pending\",\n            \"allowed_cents\": None,\n            \"paid_cents\": claim[\"paid_cents\"],\n            \"balance_cents\": claim[\"balance_cents\"],\n            \"next_owner\": owner_by_claim.get(claim_id, claim[\"next_owner\"]),\n            \"reason\": reason_by_claim.get(\n                claim_id,\n                \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\",\n            ),\n        })\n    write_claims_csv(current_claims, output_paths[\"claims\"])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    write_repair_queue(queue, output_paths[\"queue\"])\n    _exclusive_json(output_paths[\"state\"], {\n        \"mode\": \"offline-replay\",\n        \"fresh_native_reads_performed\": False,\n        \"run_id\": manifest[\"run_id\"],\n        \"case_clock\": manifest.get(\"case_clock\"),\n        \"source_manifest_sha256\": actual_manifest_hash,\n        \"parsed_records_path\": OUTPUT_NAME,\n        \"parsed_records_sha256\": hashlib.sha256(parsed_path.read_bytes()).hexdigest(),\n        \"parsed_record_counts\": {name: len(rows) for name, rows in parsed.get(\"records\", {}).items()},\n        \"sealed_batches\": [path.relative_to(run_dir).as_posix() for path in sealed],\n        \"revision_history\": latest[\"revision_history\"],\n        \"decision_history\": latest[\"decision_history\"],\n        \"finance_reconciliations\": latest[\"finance_reconciliations\"],\n        \"cancellation_state\": latest[\"domain\"][\"cancellation_state\"],\n        \"material_corrections\": latest[\"domain\"][\"material_corrections\"],\n        \"source_record_history\": {\n            \"claim_revisions\": latest[\"domain\"][\"claim_records\"],\n            \"decisions\": latest[\"domain\"][\"decision_records\"],\n            \"finance_events\": latest[\"domain\"][\"finance_records\"],\n            \"cancellation_activities\": latest[\"domain\"][\"cancellation_records\"],\n        },\n        \"repair_queue\": queue,\n    })\n    report = _report(\n        run_id=manifest[\"run_id\"], parsed=parsed, snapshots=sealed, latest=latest,\n        output_paths=output_paths,\n    )\n    output_paths[\"report\"].write_text(report, encoding=\"utf-8\", newline=\"\\n\")\n    return {\"run_id\": manifest[\"run_id\"], \"snapshots\": sealed, \"outputs\": output_paths, \"state\": latest}\n        raise ValueError(\"repair item update does not change any field\")\n    history = {\n        \"event\": \"item-updated\", \"update_id\": update_id,\n        \"previous\": before, \"changes\": normalized,\n        \"previous_status\": item[\"status\"], \"previous_response_id\": item[\"response_id\"],\n        \"previous_resolution_source_refs\": list(item[\"resolution_source_refs\"]),\n        \"run_id\": run_id, \"batch_id\": batch_id,\n    }\n    item[\"history\"].append(history)\n    item.update(changes)\n    if \"revision\" in changes and changes[\"revision\"] != before[\"revision\"]:\n        item[\"status\"] = \"open\"\n        item[\"response_id\"] = None\n        item[\"resolution_source_refs\"] = []\n    queue[\"events\"].append({\n        \"event\": \"item-updated\", \"item_id\": item_id, \"update_id\": update_id,\n        \"changes\": normalized, \"run_id\": run_id, \"batch_id\": batch_id,\n        \"status\": item[\"status\"],\n    })\n\n\ndef owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\n    grouped: dict[str, list[dict]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n\n\ndef load_repair_queue(path: Path) -> dict:\n    \"\"\"Load the persisted queue, validating individual item and audit structure.\"\"\"\n    try:\n        persisted = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"cannot read repair queue: {exc}\") from exc\n    if not isinstance(persisted, dict):\n        raise ValueError(\"repair queue must contain an object\")\n    if persisted.get(\"queue_version\") != \"owner-queue/1\":\n        raise ValueError(\"unsupported repair queue version\")\n    queue = {key: value for key, value in persisted.items() if key != \"by_owner\"}\n    if not isinstance(queue.get(\"items\"), dict) or not isinstance(queue.get(\"events\"), list):\n        raise ValueError(\"repair queue must contain item map and event history\")\n    for item_id, item in queue[\"items\"].items():\n        if item.get(\"item_id\") != item_id or item.get(\"status\") not in {\"open\", \"resolved\"}:\n            raise ValueError(f\"invalid repair queue item {item_id}\")\n        if any(field not in item for field in REPAIR_ITEM_FIELDS):\n            raise ValueError(f\"repair queue item {item_id} is missing trace fields\")\n    expected_grouping = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    if persisted.get(\"by_owner\") != expected_grouping:\n        raise ValueError(\"persisted owner grouping does not match item owners\")\n    return queue\n\n\ndef write_repair_queue(queue: dict, path: Path) -> None:\n    \"\"\"Persist queue and history atomically without dropping prior item events.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    if path.exists():\n        old = json.loads(path.read_text(encoding=\"utf-8\"))\n        if old.get(\"queue_version\") != queue.get(\"queue_version\"):\n            raise ValueError(\"cannot replace repair queue with an incompatible version\")\n        # The caller passes the updated in-memory queue; enforce prefix-preserved\n        # audit history rather than allowing a rewrite to erase previous events.\n        old_events = old.get(\"events\", [])\n        if queue.get(\"events\", [])[: len(old_events)] != old_events:\n            raise ValueError(\"repair queue update would rewrite or remove prior events\")\n        for item_id, prior in old.get(\"items\", {}).items():\n            current = queue.get(\"items\", {}).get(item_id)\n            if current is None or current.get(\"history\", [])[: len(prior.get(\"history\", []))] != prior.get(\"history\", []):\n                raise ValueError(f\"repair queue update would remove history for {item_id}\")\n            for key in (\"item_id\", \"subject_type\", \"subject_id\"):\n                if current.get(key) != prior.get(key):\n                    raise ValueError(f\"repair queue update would rewrite {key} for {item_id}\")\n            mutable = (\"revision\", \"source_refs\", \"missing_or_return_reason\", \"owner\", \"next_action\")\n            appended_updates = [event for event in current.get(\"history\", [])[len(prior.get(\"history\", [])):]\n                                if event.get(\"event\") == \"item-updated\"]\n            for key in mutable:\n                expected = prior.get(key)\n                for event in appended_updates:\n                    if key in event.get(\"changes\", {}):\n                        expected = event[\"changes\"][key]\n                if current.get(key) != expected:\n                    raise ValueError(f\"repair queue update changed {key} without matching item history for {item_id}\")\n    persisted = dict(queue)\n    persisted[\"by_owner\"] = {\n        owner: [item[\"item_id\"] for item in items]\n        for owner, items in owner_grouped_view(queue).items()\n    }\n    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=path.parent)\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as stream:\n            json.dump(persisted, stream, indent=2, ensure_ascii=False)\n            stream.write(\"\\n\")\n            stream.flush()\n            os.fsync(stream.fileno())\n        os.replace(tmp_name, path)\n    finally:\n        if os.path.exists(tmp_name):\n            os.unlink(tmp_name)\n\"\"\"Synthetic CLI coverage for the explicitly labelled retained-input replay.\"\"\"\n\nimport hashlib\nimport io\nimport json\nimport zipfile\nimport csv\nfrom pathlib import Path\n\nfrom travel_claim.cli import main\nfrom travel_claim.outputs import CLAIMS_COLUMNS\nfrom travel_claim.snapshots import verify_snapshot\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA = ROOT / \"snapshot.schema.json\"\n\n\ndef _xlsx_bytes():\n    buffer = io.BytesIO()\n    with zipfile.ZipFile(buffer, \"w\") as archive:\n        archive.writestr(\"xl/workbook.xml\", \"<workbook><sheets/></workbook>\")\n    return buffer.getvalue()\n\n\ndef _capture(tmp_path):\n    run_id = \"offline-synthetic\"\n    run_dir = tmp_path / run_id\n    bodies = {\n        \"policy-pol-2026-2\": b\"generic policy shell\",\n        \"initial-claim-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"claim-updates-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"receipt-binder\": b\"%PDF-1.4\\nsynthetic\\n%%EOF\",\n        \"travel-registers-workbook\": _xlsx_bytes(),\n    }\n    attempts = []\n\n    def fetch(url, timeout):\n        attempts.append(url)\n        source = next(row for row in SOURCES if (row.export_url or row.url) == url)\n        return bodies[source.source_id], {\"ETag\": \"synthetic-fixture\"}, url\n\n    manifest = capture_sources(\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\n        observed_at=iter([f\"2026-09-01T00:00:{i:02d}Z\" for i in range(10)]).__next__,\n    )\n    manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n\n    def claim(revision, batch):\n        return {\n            \"source_id\": \"synthetic-claim-binder\",\n            \"source_sha256\": \"a\" * 64,\n            \"locator\": f\"PDF page {revision} synthetic\",\n            \"page\": revision,\n            \"fields\": [\n                {\"label\": \"Claim reference\", \"value\": \"C-SYN-RUN\"},\n                {\"label\": \"Revision\", \"value\": str(revision)},\n                {\"label\": \"Arrival batch\", \"value\": str(batch)},\n                {\"label\": \"Trip reference\", \"value\": \"T-SYN-RUN\"},\n                {\"label\": \"Trip revision\", \"value\": \"1\"},\n            ],\n            \"text\": \"SYNTHETIC TEST DATA ONLY\",\n        }\n\n    parsed = {\n        \"schema_version\": \"travel-claim-parsed-records/1\",\n        \"run_id\": run_id,\n        \"source_manifest\": {\"path\": \"sources.json\", \"sha256\": manifest_hash},\n        \"case_clock\": None,\n        \"case_clock_issue\": {\"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\"},\n        \"arrival_batches\": [1, 2],\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\", \"subject_type\": \"scenario\",\n                \"subject_id\": \"clock\", \"reason\": \"synthetic clock withheld\",\n                \"owner\": \"Exercise facilitator\", \"next_action\": \"provide clock\",\n                \"evidence_needed\": \"scenario clock\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\", \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\", \"reason\": \"synthetic policy withheld\",\n                \"owner\": \"Travel Administration Lead\", \"next_action\": \"provide native policy\",\n                \"evidence_needed\": \"complete policy content\",\n            },\n        ],\n        \"records\": {\n            \"claim_revisions\": [claim(1, 1), claim(2, 2)],\n            \"trips\": [{\n                \"source_id\": \"synthetic-trips\", \"source_sha256\": \"b\" * 64,\n                \"locator\": \"Trips tab row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Trip reference\": {\"value\": \"T-SYN-RUN\"},\n                    \"Trip revision\": {\"value\": 1},\n                    \"Permit reference\": {\"value\": \"P-SYN-RUN\"},\n                    \"Permit revision\": {\"value\": 1},\n                },\n            }],\n            \"decisions\": [{\n                \"source_id\": \"synthetic-review-ledger\", \"source_sha256\": \"c\" * 64,\n                \"locator\": \"Review ledger row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Decision reference\": {\"value\": \"D-SYN-RUN-R1\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Subject type\": {\"value\": \"claim\"},\n                    \"Subject reference\": {\"value\": \"C-SYN-RUN\"}, \"Revision\": {\"value\": 1},\n                    \"Outcome\": {\"value\": \"approve\"},\n                },\n            }],\n            \"finance_events\": [{\n                \"source_id\": \"synthetic-finance-ledger\", \"source_sha256\": \"d\" * 64,\n                \"locator\": \"Finance activity row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Activity reference\": {\"value\": \"F-SYN-RUN-SETTLED\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Activity type\": {\"value\": \"settled\"},\n                    \"Claim reference\": {\"value\": \"C-SYN-RUN\"}, \"Currency\": {\"value\": \"EUR\"},\n                    \"Amount (EUR)\": {\"value\": 12.5},\n                },\n            }],\n            \"cancellation_activities\": [],\n        },\n    }\n    (run_dir / \"parsed-records.json\").write_text(json.dumps(parsed), encoding=\"utf-8\")\n    return run_dir, attempts\n\n\ndef test_offline_replay_cli_seals_ordered_batches_and_writes_traceable_outputs(tmp_path):\n    run_dir, attempts = _capture(tmp_path)\n    attempts_before_replay = list(attempts)\n\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    assert attempts == attempts_before_replay\n\n    first = run_dir / \"batches/arrival-001.json\"\n    second = run_dir / \"batches/arrival-002.json\"\n    first_obj = json.loads(first.read_text(encoding=\"utf-8\"))\n    second_obj = json.loads(second.read_text(encoding=\"utf-8\"))\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\n    assert first_obj[\"predecessor\"] is None\n    assert second_obj[\"predecessor\"] == {\n        \"path\": \"batches/arrival-001.json\",\n        \"sha256\": hashlib.sha256(first.read_bytes()).hexdigest(),\n    }\n    assert \"offline-replay-mode\" in {row[\"record_id\"] for row in first_obj[\"issues\"]}\n    replay_state = json.loads((run_dir / \"offline-replay-state.json\").read_text(encoding=\"utf-8\"))\n    assert [row[\"revision\"] for row in replay_state[\"revision_history\"][\"claim\"][\"C-SYN-RUN\"][\"revisions\"]] == [1, 2]\n    assert [row[\"decision_id\"] for row in replay_state[\"decision_history\"]] == [\"D-SYN-RUN-R1\"]\n    assert [row[\"values\"][\"Activity reference\"][\"value\"] for row in replay_state[\"source_record_history\"][\"finance_events\"]] == [\"F-SYN-RUN-SETTLED\"]\n\n    with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n        rows = list(csv.DictReader(stream))\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\n        assert len(rows) == 1\n        assert rows[0][\"claim_id\"] == \"C-SYN-RUN\"\n        assert rows[0][\"revision\"] == \"2\"\n        assert rows[0][\"allowed_cents\"] == \"\"\n        assert rows[0][\"paid_cents\"] == \"1250\"\n        assert rows[0][\"balance_cents\"] == \"\"\n    report = (run_dir / \"report.md\").read_text(encoding=\"utf-8\")\n    assert \"OFFLINE REPLAY\" in report\n    assert \"Fresh native reads in this run: **no**\" in report\n    assert \"Case clock: **unresolved**\" in report\n    assert \"POL-2026.2: **unavailable**\" in report\n    queue = json.loads((run_dir / \"repair-queue.json\").read_text(encoding=\"utf-8\"))\n    assert \"by_owner\" in queue\n\n\ndef test_offline_replay_cli_refuses_to_overwrite_outputs(tmp_path):\n    run_dir, _ = _capture(tmp_path)\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 0\n    first = (run_dir / \"batches/arrival-001.json\").read_bytes()\n    assert main([\"offline-replay\", str(run_dir), \"--schema\", str(SCHEMA)]) == 1\n    assert (run_dir / \"batches/arrival-001.json\").read_bytes() == first\n\n\ndef test_report_separates_owner_grouped_open_repairs_and_external_blockers(tmp_path):\n    from travel_claim.offline_replay import _report, run_offline_replay\n    from travel_claim.outputs import add_repair_item\n\n    run_dir, _ = _capture(tmp_path)\n    parsed_path = run_dir / \"parsed-records.json\"\n    parsed = json.loads(parsed_path.read_text())\n    # A second claim has an unresolved trip binding. The first claim's cash\n    # evidence and both revisions must still survive the complete replay.\n    independent = json.loads(json.dumps(parsed[\"records\"][\"claim_revisions\"][0]))\n    independent[\"fields\"][0][\"value\"] = \"C-UNRESOLVED\"\n    independent[\"fields\"][3][\"value\"] = \"T-MISSING\"\n    parsed[\"records\"][\"claim_revisions\"].append(independent)\n    parsed_path.write_text(json.dumps(parsed))\n    result = run_offline_replay(run_dir, schema_path=SCHEMA)\n    claims = {row[\"claim_id\"]: row for row in result[\"state\"][\"snapshot\"][\"claims\"]}\n    assert set(claims) == {\"C-SYN-RUN\", \"C-UNRESOLVED\"}\n    assert claims[\"C-SYN-RUN\"][\"revision\"] == 2\n    assert claims[\"C-SYN-RUN\"][\"paid_cents\"] == 1250\n    assert claims[\"C-SYN-RUN\"][\"allowed_cents\"] is None\n    queue = result[\"state\"][\"domain\"][\"repair_queue\"]\n    report = result[\"outputs\"][\"report\"].read_text()\n    claim_section = report.split(\"## Claim-specific actionable repairs by owner\\n\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    blockers = report.split(\"## Run-level external blockers\\n\", 1)[1].split(\"## Outputs\", 1)[0]\n    assert \"offline replay\" in blockers\n    assert \"scenario-case-clock\" in blockers\n    assert \"reimbursement-policy-pol-2026-2\" in blockers\n    assert \"scenario-case-clock\" not in claim_section\n    assert \"reimbursement-policy-pol-2026-2\" not in claim_section\n    assert \"Independent valid records continue\" in report\n    for item in queue[\"items\"].values():\n        if item[\"subject_type\"] != \"claim\" or item[\"status\"] != \"open\":\n            continue\n        owner_section = claim_section.split(f\"### {item['owner']}\\n\", 1)[1].split(\"\\n### \", 1)[0]\n        assert f\"Repair `{item['item_id']}`\" in owner_section\n        assert f\"subject claim `{item['subject_id']}`, revision {item['revision']}\" in owner_section\n        assert f\"Next action: {item['next_action']}\" in owner_section\n        assert f\"run `{item['run_id']}`, batch `{item['batch_id']}`\" in owner_section\n        for ref in item[\"source_refs\"]:\n            assert f\"`{ref}`\" in owner_section\n    assert claim_section.count(\"### \") == len({item[\"owner\"] for item in queue[\"items\"].values() if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\"})\n\n    # Report filtering must leave persisted queue history untouched and must\n    # keep non-claim repairs in their own section, even with the same owner.\n    resolved_id = next(iter(queue[\"items\"]))\n    queue[\"items\"][resolved_id][\"status\"] = \"resolved\"\n    add_repair_item(\n        queue, item_id=\"permit-repair\", subject_type=\"permit\", subject_id=\"P-SYN\",\n        revision=1, source_refs=[\"retained-permit@hash#row 2\"],\n        missing_or_return_reason=\"missing permit evidence\", owner=\"Travel Administration Lead\",\n        next_action=\"obtain permit evidence\", run_id=parsed[\"run_id\"], batch_id=\"arrival-002\",\n    )\n    rendered = _report(run_id=parsed[\"run_id\"], parsed=parsed,\n                       snapshots=result[\"snapshots\"], latest=result[\"state\"],\n                       output_paths=result[\"outputs\"])\n    assert f\"Repair `{resolved_id}`\" not in rendered\n    assert queue[\"items\"][resolved_id][\"status\"] == \"resolved\"\n    claim_section = rendered.split(\"## Claim-specific\", 1)[1].split(\"## Trip and permit\", 1)[0]\n    permit_section = rendered.split(\"## Trip and permit\", 1)[1].split(\"## Run-level\", 1)[0]\n    assert \"permit-repair\" not in claim_section\n    assert \"subject permit `P-SYN`, revision 1\" in permit_section\n    assert \"Next action: obtain permit evidence\" in permit_section\n        except (OSError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not write claims CSV: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Wrote claims CSV: {args.output}\")\n        return 0\n    if args.command == \"offline-replay\":\n        try:\n            result = run_offline_replay(args.run_dir, schema_path=args.schema)\n        except (OSError, KeyError, json.JSONDecodeError, ValueError, FileExistsError) as exc:\n            print(f\"Offline replay failed: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"OFFLINE REPLAY complete: {result['run_id']} (no fresh native-source reads)\")\n        for snapshot in result[\"snapshots\"]:\n            print(f\"Snapshot: {snapshot}\")\n        for label, output in result[\"outputs\"].items():\n            print(f\"{label}: {output}\")\n        return 0\n    return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"started_at_ms":1792005735006,"completed_at_ms":1792005735042}}
{"timestamp":"2026-10-14T19:22:15.533Z","ordinal":170,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13bdd-846d-7570-83c2-df5dbf637770","call_id":"call_1e3c847a768c4d989198f97b600e9b82","output":[{"type":"input_text","text":"Script completed\nWall time 0.7 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"b3ba2e\",\"wall_time_seconds\":0.03482347,\"exit_code\":0,\"original_token_count\":7708,\"output\":\"?? artifacts/runs/\\n\\\"\\\"\\\"Run a labelled, integrity-checked replay over previously retained records.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom .integration import integrate_arrival_batch\\nfrom .outputs import owner_grouped_view, write_claims_csv, write_repair_queue\\nfrom .parsing import OUTPUT_NAME\\nfrom .snapshots import seal_batch_snapshot, verify_snapshot\\nfrom .sources import verify_source_manifest\\n\\n\\nOFFLINE_MARKER = {\\n    \\\"record_id\\\": \\\"offline-replay-mode\\\",\\n    \\\"reason\\\": \\\"Offline replay of previously retained source content; this run did not attempt fresh native-source reads.\\\",\\n    \\\"owner\\\": \\\"Travel Administration Lead\\\",\\n    \\\"resolution_needed\\\": \\\"Perform a new authorized run with fresh reads of all five native sources before relying on current source state.\\\",\\n}\\n\\n\\ndef _exclusive_json(path: Path, value: Any) -> None:\\n    path.parent.mkdir(parents=True, exist_ok=True)\\n    with path.open(\\\"x\\\", encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\") as stream:\\n        json.dump(value, stream, indent=2, ensure_ascii=False)\\n        stream.write(\\\"\\\\n\\\")\\n\\n\\ndef _report(\\n    *, run_id: str, parsed: dict[str, Any], snapshots: list[Path], latest: dict[str, Any],\\n    output_paths: dict[str, Path],\\n) -> str:\\n    manifest_hash = hashlib.sha256((snapshots[0].parents[1] / \\\"sources.json\\\").read_bytes()).hexdigest()\\n    lines = [\\n        \\\"# Project D operations handoff — OFFLINE REPLAY\\\",\\n        \\\"\\\",\\n        \\\"> This is a structural replay from previously retained inputs. It did not perform fresh native-source reads and does not establish policy eligibility, reimbursement entitlement, approval readiness, or closure.\\\",\\n        \\\"\\\",\\n        f\\\"- Run ID: `{run_id}`\\\",\\n        \\\"- Mode: `offline-replay`\\\",\\n        \\\"- Fresh native reads in this run: **no**\\\",\\n        f\\\"- Retained `sources.json` SHA-256: `{manifest_hash}`\\\",\\n        f\\\"- Case clock: **unresolved** ({parsed.get('case_clock_issue', {}).get('owner', 'Exercise facilitator')}; {parsed.get('case_clock_issue', {}).get('next_action', 'obtain authoritative case clock')})\\\",\\n        \\\"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\",\\n        f\\\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\\\",\\n        \\\"- Retained source observations: \\\" + \\\"; \\\".join(\\n            f\\\"`{row['source_id']}`={row['status']}\\\" for row in json.loads(\\n                (snapshots[0].parents[1] / \\\"sources.json\\\").read_text(encoding=\\\"utf-8\\\")\\n            )[\\\"files\\\"]\\n        ) + \\\".\\\",\\n        \\\"\\\",\\n        \\\"## Batch projections\\\",\\n        \\\"\\\",\\n    ]\\n    for path in snapshots:\\n        snapshot = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n        lines.append(\\n            f\\\"- `{path.relative_to(path.parents[1])}` — {len(snapshot['claims'])} current claim rows, \\\"\\n            f\\\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \\\"\\n            f\\\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\\\"\\n        )\\n    lines.extend([\\n        \\\"\\\",\\n        \\\"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained; no obligation or entitlement is inferred. Claim monetary entitlement and balance remain null when unsupported.\\\",\\n        \\\"\\\",\\n        \\\"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\\\",\\n        \\\"\\\",\\n    ])\\n    queue = latest[\\\"domain\\\"][\\\"repair_queue\\\"]\\n    for title, subject_types in (\\n        (\\\"Claim-specific actionable repairs by owner\\\", {\\\"claim\\\"}),\\n        (\\\"Trip and permit actionable repairs by owner\\\", {\\\"trip\\\", \\\"permit\\\"}),\\n    ):\\n        open_queue = {\\\"items\\\": {\\n            key: item for key, item in queue[\\\"items\\\"].items()\\n            if item[\\\"status\\\"] == \\\"open\\\" and item[\\\"subject_type\\\"] in subject_types\\n        }}\\n        lines.extend([\\n            f\\\"## {title}\\\", \\\"\\\",\\n            f\\\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\\\",\\n            \\\"\\\",\\n        ])\\n        if not open_queue[\\\"items\\\"]:\\n            lines.extend([\\\"No open repair items in this category; this does not establish policy readiness or closure.\\\", \\\"\\\"])\\n        for owner, items in owner_grouped_view(open_queue).items():\\n            lines.extend([f\\\"### {owner}\\\", \\\"\\\"])\\n            for item in items:\\n                lines.extend([\\n                    f\\\"- Repair `{item['item_id']}` — subject {item['subject_type']} `{item['subject_id']}`, revision {item['revision']} (**open**).\\\",\\n                    f\\\"  - Reason: {item['missing_or_return_reason']}.\\\",\\n                    f\\\"  - Next action: {item['next_action']}.\\\",\\n                    f\\\"  - Opened in run `{item['run_id']}`, batch `{item['batch_id']}`.\\\",\\n                    \\\"  - Retained source references: \\\" + \\\"; \\\".join(\\n                        f\\\"`{ref}`\\\" for ref in item['source_refs']\\n                    ) if item['source_refs'] else \\\"  - Retained source references: unavailable; obtain authoritative evidence.\\\",\\n                ])\\n            lines.append(\\\"\\\")\\n    lines.extend([\\n        \\\"## Run-level external blockers\\\", \\\"\\\",\\n        \\\"These retained policy and clock issues apply to the run as a whole and are separate from claim repairs. They remain unresolved in this offline replay; no case-clock date or policy rule is inferred.\\\",\\n        \\\"\\\",\\n    ])\\n    for blocker in parsed.get(\\\"unresolved_issues\\\", []):\\n        lines.append(\\n            f\\\"- `{blocker['record_id']}` ({blocker.get('subject_type')} `{blocker.get('subject_id')}`): \\\"\\n            f\\\"{blocker['reason']} Owner: {blocker['owner']}. Next: {blocker['next_action']} \\\"\\n            f\\\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\\\"\\n        )\\n    lines.extend([\\n        \\\"\\\",\\n        \\\"## Outputs\\\",\\n        \\\"\\\",\\n        f\\\"- Current claims: `{output_paths['claims'].name}` (exact required CSV columns).\\\",\\n        f\\\"- Full integration state and source-linked histories: `{output_paths['state'].name}`.\\\",\\n        f\\\"- Repair queue: `{output_paths['queue'].name}` (grouped by owner, item identity retained).\\\",\\n        \\\"\\\",\\n        \\\"For an authoritative live-source run, resume only after obtaining the authoritative case clock and an accessible native reimbursement policy, then perform fresh reads of all five source locations. This replay does not modify source content or send requests.\\\",\\n        \\\"\\\",\\n    ])\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\\n    \\\"\\\"\\\"Consume retained parsed records in batch order and write immutable outputs.\\\"\\\"\\\"\\n    errors = verify_source_manifest(run_dir)\\n    if errors:\\n        raise ValueError(\\\"Retained source manifest verification failed: \\\" + \\\"; \\\".join(errors))\\n    manifest_path = run_dir / \\\"sources.json\\\"\\n    manifest = json.loads(manifest_path.read_text(encoding=\\\"utf-8\\\"))\\n    parsed_path = run_dir / OUTPUT_NAME\\n    parsed = json.loads(parsed_path.read_text(encoding=\\\"utf-8\\\"))\\n    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\\n    if parsed.get(\\\"run_id\\\") != manifest.get(\\\"run_id\\\"):\\n        raise ValueError(\\\"Parsed records run_id does not match the retained source manifest\\\")\\n    if parsed.get(\\\"source_manifest\\\") != {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": actual_manifest_hash}:\\n        raise ValueError(\\\"Parsed records are not bound to the current retained sources.json bytes\\\")\\n    batches = parsed.get(\\\"arrival_batches\\\")\\n    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\\n        raise ValueError(\\\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\\\")\\n    output_paths = {\\n        \\\"claims\\\": run_dir / \\\"claims.csv\\\",\\n        \\\"report\\\": run_dir / \\\"report.md\\\",\\n        \\\"queue\\\": run_dir / \\\"repair-queue.json\\\",\\n        \\\"state\\\": run_dir / \\\"offline-replay-state.json\\\",\\n    }\\n    occupied = [str(path) for path in output_paths.values() if path.exists()]\\n    if occupied:\\n        raise FileExistsError(\\\"Refusing to overwrite offline replay outputs: \\\" + \\\", \\\".join(occupied))\\n    batches_dir = run_dir / \\\"batches\\\"\\n    if batches_dir.exists() and any(batches_dir.iterdir()):\\n        raise FileExistsError(f\\\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\\\")\\n\\n    binding = {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": actual_manifest_hash}\\n    previous: dict[str, Any] | None = None\\n    previous_path: Path | None = None\\n    sealed: list[Path] = []\\n    for number in batches:\\n        batch_id = f\\\"arrival-{number:03d}\\\"\\n        predecessor = None\\n        if previous_path is not None:\\n            predecessor = {\\n                \\\"path\\\": f\\\"batches/{previous_path.name}\\\",\\n                \\\"sha256\\\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\\n            }\\n        current = integrate_arrival_batch(\\n            parsed, arrival_batch=number, run_id=manifest[\\\"run_id\\\"], batch_id=batch_id,\\n            source_binding=binding, predecessor=predecessor, prior_result=previous,\\n        )\\n        current[\\\"snapshot\\\"][\\\"issues\\\"].append(dict(OFFLINE_MARKER))\\n        path = seal_batch_snapshot(\\n            run_dir, run_id=manifest[\\\"run_id\\\"], batch_id=batch_id,\\n            predecessor_path=previous_path, schema_path=schema_path,\\n            allow_unconfirmed_case_clock=True, **{\\n                key: current[\\\"snapshot\\\"][key]\\n                for key in (\\\"claims\\\", \\\"requests\\\", \\\"travel_cancellations\\\", \\\"admitted_event_ids\\\", \\\"issues\\\")\\n            },\\n        )\\n        validation = verify_snapshot(path, run_dir, schema_path)\\n        if validation:\\n            raise ValueError(f\\\"Snapshot verification failed for {path}: \\\" + \\\"; \\\".join(validation))\\n        sealed.append(path)\\n        previous, previous_path = current, path\\n\\n    latest = previous\\n    assert latest is not None\\n    current_claims = []\\n    owner_by_claim: dict[str, str] = {}\\n    reason_by_claim: dict[str, str] = {}\\n    for item in latest[\\\"domain\\\"][\\\"repair_queue\\\"][\\\"items\\\"].values():\\n        if item[\\\"subject_type\\\"] == \\\"claim\\\" and item[\\\"status\\\"] == \\\"open\\\":\\n            owner_by_claim.setdefault(item[\\\"subject_id\\\"], item[\\\"owner\\\"])\\n            reason_by_claim.setdefault(item[\\\"subject_id\\\"], item[\\\"missing_or_return_reason\\\"])\\n    for claim in latest[\\\"snapshot\\\"][\\\"claims\\\"]:\\n        claim_id = claim[\\\"claim_id\\\"]\\n        current_claims.append({\\n            \\\"claim_id\\\": claim_id,\\n            \\\"revision\\\": claim[\\\"revision\\\"],\\n            \\\"trip_id\\\": claim[\\\"trip_id\\\"],\\n            \\\"status\\\": \\\"pending\\\",\\n            \\\"allowed_cents\\\": None,\\n            \\\"paid_cents\\\": claim[\\\"paid_cents\\\"],\\n            \\\"balance_cents\\\": claim[\\\"balance_cents\\\"],\\n            \\\"next_owner\\\": owner_by_claim.get(claim_id, claim[\\\"next_owner\\\"]),\\n            \\\"reason\\\": reason_by_claim.get(\\n                claim_id,\\n                \\\"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\\\",\\n            ),\\n        })\\n    write_claims_csv(current_claims, output_paths[\\\"claims\\\"])\\n    queue = latest[\\\"domain\\\"][\\\"repair_queue\\\"]\\n    write_repair_queue(queue, output_paths[\\\"queue\\\"])\\n    _exclusive_json(output_paths[\\\"state\\\"], {\\n        \\\"mode\\\": \\\"offline-replay\\\",\\n        \\\"fresh_native_reads_performed\\\": False,\\n        \\\"run_id\\\": manifest[\\\"run_id\\\"],\\n        \\\"case_clock\\\": manifest.get(\\\"case_clock\\\"),\\n        \\\"source_manifest_sha256\\\": actual_manifest_hash,\\n        \\\"parsed_records_path\\\": OUTPUT_NAME,\\n        \\\"parsed_records_sha256\\\": hashlib.sha256(parsed_path.read_bytes()).hexdigest(),\\n        \\\"parsed_record_counts\\\": {name: len(rows) for name, rows in parsed.get(\\\"records\\\", {}).items()},\\n        \\\"sealed_batches\\\": [path.relative_to(run_dir).as_posix() for path in sealed],\\n        \\\"revision_history\\\": latest[\\\"revision_history\\\"],\\n        \\\"decision_history\\\": latest[\\\"decision_history\\\"],\\n        \\\"finance_reconciliations\\\": latest[\\\"finance_reconciliations\\\"],\\n        \\\"cancellation_state\\\": latest[\\\"domain\\\"][\\\"cancellation_state\\\"],\\n        \\\"material_corrections\\\": latest[\\\"domain\\\"][\\\"material_corrections\\\"],\\n        \\\"source_record_history\\\": {\\n            \\\"claim_revisions\\\": latest[\\\"domain\\\"][\\\"claim_records\\\"],\\n            \\\"decisions\\\": latest[\\\"domain\\\"][\\\"decision_records\\\"],\\n            \\\"finance_events\\\": latest[\\\"domain\\\"][\\\"finance_records\\\"],\\n            \\\"cancellation_activities\\\": latest[\\\"domain\\\"][\\\"cancellation_records\\\"],\\n        },\\n        \\\"repair_queue\\\": queue,\\n    })\\n    report = _report(\\n        run_id=manifest[\\\"run_id\\\"], parsed=parsed, snapshots=sealed, latest=latest,\\n        output_paths=output_paths,\\n    )\\n    output_paths[\\\"report\\\"].write_text(report, encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\")\\n    return {\\\"run_id\\\": manifest[\\\"run_id\\\"], \\\"snapshots\\\": sealed, \\\"outputs\\\": output_paths, \\\"state\\\": latest}\\n        raise ValueError(\\\"repair item update does not change any field\\\")\\n    history = {\\n        \\\"event\\\": \\\"item-updated\\\", \\\"update_id\\\": update_id,\\n        \\\"previous\\\": before, \\\"changes\\\": normalized,\\n        \\\"previous_status\\\": item[\\\"status\\\"], \\\"previous_response_id\\\": item[\\\"response_id\\\"],\\n        \\\"previous_resolution_source_refs\\\": list(item[\\\"resolution_source_refs\\\"]),\\n        \\\"run_id\\\": run_id, \\\"batch_id\\\": batch_id,\\n    }\\n    item[\\\"history\\\"].append(history)\\n    item.update(changes)\\n    if \\\"revision\\\" in changes and changes[\\\"revision\\\"] != before[\\\"revision\\\"]:\\n        item[\\\"status\\\"] = \\\"open\\\"\\n        item[\\\"response_id\\\"] = None\\n        item[\\\"resolution_source_refs\\\"] = []\\n    queue[\\\"events\\\"].append({\\n        \\\"event\\\": \\\"item-updated\\\", \\\"item_id\\\": item_id, \\\"update_id\\\": update_id,\\n        \\\"changes\\\": normalized, \\\"run_id\\\": run_id, \\\"batch_id\\\": batch_id,\\n        \\\"status\\\": item[\\\"status\\\"],\\n    })\\n\\n\\ndef owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\\n    grouped: dict[str, list[dict]] = {}\\n    for item in queue[\\\"items\\\"].values():\\n        grouped.setdefault(item[\\\"owner\\\"], []).append(item)\\n    return {owner: sorted(items, key=lambda row: row[\\\"item_id\\\"]) for owner, items in sorted(grouped.items())}\\n\\n\\ndef load_repair_queue(path: Path) -> dict:\\n    \\\"\\\"\\\"Load the persisted queue, validating individual item and audit structure.\\\"\\\"\\\"\\n    try:\\n        persisted = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n    except (OSError, json.JSONDecodeError) as exc:\\n        raise ValueError(f\\\"cannot read repair queue: {exc}\\\") from exc\\n    if not isinstance(persisted, dict):\\n        raise ValueError(\\\"repair queue must contain an object\\\")\\n    if persisted.get(\\\"queue_version\\\") != \\\"owner-queue/1\\\":\\n        raise ValueError(\\\"unsupported repair queue version\\\")\\n    queue = {key: value for key, value in persisted.items() if key != \\\"by_owner\\\"}\\n    if not isinstance(queue.get(\\\"items\\\"), dict) or not isinstance(queue.get(\\\"events\\\"), list):\\n        raise ValueError(\\\"repair queue must contain item map and event history\\\")\\n    for item_id, item in queue[\\\"items\\\"].items():\\n        if item.get(\\\"item_id\\\") != item_id or item.get(\\\"status\\\") not in {\\\"open\\\", \\\"resolved\\\"}:\\n            raise ValueError(f\\\"invalid repair queue item {item_id}\\\")\\n        if any(field not in item for field in REPAIR_ITEM_FIELDS):\\n            raise ValueError(f\\\"repair queue item {item_id} is missing trace fields\\\")\\n    expected_grouping = {\\n        owner: [item[\\\"item_id\\\"] for item in items]\\n        for owner, items in owner_grouped_view(queue).items()\\n    }\\n    if persisted.get(\\\"by_owner\\\") != expected_grouping:\\n        raise ValueError(\\\"persisted owner grouping does not match item owners\\\")\\n    return queue\\n\\n\\ndef write_repair_queue(queue: dict, path: Path) -> None:\\n    \\\"\\\"\\\"Persist queue and history atomically without dropping prior item events.\\\"\\\"\\\"\\n    path.parent.mkdir(parents=True, exist_ok=True)\\n    if path.exists():\\n        old = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n        if old.get(\\\"queue_version\\\") != queue.get(\\\"queue_version\\\"):\\n            raise ValueError(\\\"cannot replace repair queue with an incompatible version\\\")\\n        # The caller passes the updated in-memory queue; enforce prefix-preserved\\n        # audit history rather than allowing a rewrite to erase previous events.\\n        old_events = old.get(\\\"events\\\", [])\\n        if queue.get(\\\"events\\\", [])[: len(old_events)] != old_events:\\n            raise ValueError(\\\"repair queue update would rewrite or remove prior events\\\")\\n        for item_id, prior in old.get(\\\"items\\\", {}).items():\\n            current = queue.get(\\\"items\\\", {}).get(item_id)\\n            if current is None or current.get(\\\"history\\\", [])[: len(prior.get(\\\"history\\\", []))] != prior.get(\\\"history\\\", []):\\n                raise ValueError(f\\\"repair queue update would remove history for {item_id}\\\")\\n            for key in (\\\"item_id\\\", \\\"subject_type\\\", \\\"subject_id\\\"):\\n                if current.get(key) != prior.get(key):\\n                    raise ValueError(f\\\"repair queue update would rewrite {key} for {item_id}\\\")\\n            mutable = (\\\"revision\\\", \\\"source_refs\\\", \\\"missing_or_return_reason\\\", \\\"owner\\\", \\\"next_action\\\")\\n            appended_updates = [event for event in current.get(\\\"history\\\", [])[len(prior.get(\\\"history\\\", [])):]\\n                                if event.get(\\\"event\\\") == \\\"item-updated\\\"]\\n            for key in mutable:\\n                expected = prior.get(key)\\n                for event in appended_updates:\\n                    if key in event.get(\\\"changes\\\", {}):\\n                        expected = event[\\\"changes\\\"][key]\\n                if current.get(key) != expected:\\n                    raise ValueError(f\\\"repair queue update changed {key} without matching item history for {item_id}\\\")\\n    persisted = dict(queue)\\n    persisted[\\\"by_owner\\\"] = {\\n        owner: [item[\\\"item_id\\\"] for item in items]\\n        for owner, items in owner_grouped_view(queue).items()\\n    }\\n    fd, tmp_name = tempfile.mkstemp(prefix=f\\\".{path.name}.\\\", dir=path.parent)\\n    try:\\n        with os.fdopen(fd, \\\"w\\\", encoding=\\\"utf-8\\\") as stream:\\n            json.dump(persisted, stream, indent=2, ensure_ascii=False)\\n            stream.write(\\\"\\\\n\\\")\\n            stream.flush()\\n            os.fsync(stream.fileno())\\n        os.replace(tmp_name, path)\\n    finally:\\n        if os.path.exists(tmp_name):\\n            os.unlink(tmp_name)\\n\\\"\\\"\\\"Synthetic CLI coverage for the explicitly labelled retained-input replay.\\\"\\\"\\\"\\n\\nimport hashlib\\nimport io\\nimport json\\nimport zipfile\\nimport csv\\nfrom pathlib import Path\\n\\nfrom travel_claim.cli import main\\nfrom travel_claim.outputs import CLAIMS_COLUMNS\\nfrom travel_claim.snapshots import verify_snapshot\\nfrom travel_claim.sources import SOURCES, capture_sources\\n\\n\\nROOT = Path(__file__).resolve().parents[1]\\nSCHEMA = ROOT / \\\"snapshot.schema.json\\\"\\n\\n\\ndef _xlsx_bytes():\\n    buffer = io.BytesIO()\\n    with zipfile.ZipFile(buffer, \\\"w\\\") as archive:\\n        archive.writestr(\\\"xl/workbook.xml\\\", \\\"<workbook><sheets/></workbook>\\\")\\n    return buffer.getvalue()\\n\\n\\ndef _capture(tmp_path):\\n    run_id = \\\"offline-synthetic\\\"\\n    run_dir = tmp_path / run_id\\n    bodies = {\\n        \\\"policy-pol-2026-2\\\": b\\\"generic policy shell\\\",\\n        \\\"initial-claim-binder\\\": b\\\"%PDF-1.4\\\\nsynthetic\\\\n%%EOF\\\",\\n        \\\"claim-updates-binder\\\": b\\\"%PDF-1.4\\\\nsynthetic\\\\n%%EOF\\\",\\n        \\\"receipt-binder\\\": b\\\"%PDF-1.4\\\\nsynthetic\\\\n%%EOF\\\",\\n        \\\"travel-registers-workbook\\\": _xlsx_bytes(),\\n    }\\n    attempts = []\\n\\n    def fetch(url, timeout):\\n        attempts.append(url)\\n        source = next(row for row in SOURCES if (row.export_url or row.url) == url)\\n        return bodies[source.source_id], {\\\"ETag\\\": \\\"synthetic-fixture\\\"}, url\\n\\n    manifest = capture_sources(\\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\\n        observed_at=iter([f\\\"2026-09-01T00:00:{i:02d}Z\\\" for i in range(10)]).__next__,\\n    )\\n    manifest_hash = hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n\\n    def claim(revision, batch):\\n        return {\\n            \\\"source_id\\\": \\\"synthetic-claim-binder\\\",\\n            \\\"source_sha256\\\": \\\"a\\\" * 64,\\n            \\\"locator\\\": f\\\"PDF page {revision} synthetic\\\",\\n            \\\"page\\\": revision,\\n            \\\"fields\\\": [\\n                {\\\"label\\\": \\\"Claim reference\\\", \\\"value\\\": \\\"C-SYN-RUN\\\"},\\n                {\\\"label\\\": \\\"Revision\\\", \\\"value\\\": str(revision)},\\n                {\\\"label\\\": \\\"Arrival batch\\\", \\\"value\\\": str(batch)},\\n                {\\\"label\\\": \\\"Trip reference\\\", \\\"value\\\": \\\"T-SYN-RUN\\\"},\\n                {\\\"label\\\": \\\"Trip revision\\\", \\\"value\\\": \\\"1\\\"},\\n            ],\\n            \\\"text\\\": \\\"SYNTHETIC TEST DATA ONLY\\\",\\n        }\\n\\n    parsed = {\\n        \\\"schema_version\\\": \\\"travel-claim-parsed-records/1\\\",\\n        \\\"run_id\\\": run_id,\\n        \\\"source_manifest\\\": {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": manifest_hash},\\n        \\\"case_clock\\\": None,\\n        \\\"case_clock_issue\\\": {\\\"owner\\\": \\\"Exercise facilitator\\\", \\\"next_action\\\": \\\"provide clock\\\"},\\n        \\\"arrival_batches\\\": [1, 2],\\n        \\\"unresolved_issues\\\": [\\n            {\\n                \\\"record_id\\\": \\\"scenario-case-clock\\\", \\\"subject_type\\\": \\\"scenario\\\",\\n                \\\"subject_id\\\": \\\"clock\\\", \\\"reason\\\": \\\"synthetic clock withheld\\\",\\n                \\\"owner\\\": \\\"Exercise facilitator\\\", \\\"next_action\\\": \\\"provide clock\\\",\\n                \\\"evidence_needed\\\": \\\"scenario clock\\\",\\n            },\\n            {\\n                \\\"record_id\\\": \\\"reimbursement-policy-pol-2026-2\\\", \\\"subject_type\\\": \\\"policy\\\",\\n                \\\"subject_id\\\": \\\"POL-2026.2\\\", \\\"reason\\\": \\\"synthetic policy withheld\\\",\\n                \\\"owner\\\": \\\"Travel Administration Lead\\\", \\\"next_action\\\": \\\"provide native policy\\\",\\n                \\\"evidence_needed\\\": \\\"complete policy content\\\",\\n            },\\n        ],\\n        \\\"records\\\": {\\n            \\\"claim_revisions\\\": [claim(1, 1), claim(2, 2)],\\n            \\\"trips\\\": [{\\n                \\\"source_id\\\": \\\"synthetic-trips\\\", \\\"source_sha256\\\": \\\"b\\\" * 64,\\n                \\\"locator\\\": \\\"Trips tab row 2 synthetic\\\", \\\"row\\\": 2,\\n                \\\"values\\\": {\\n                    \\\"Trip reference\\\": {\\\"value\\\": \\\"T-SYN-RUN\\\"},\\n                    \\\"Trip revision\\\": {\\\"value\\\": 1},\\n                    \\\"Permit reference\\\": {\\\"value\\\": \\\"P-SYN-RUN\\\"},\\n                    \\\"Permit revision\\\": {\\\"value\\\": 1},\\n                },\\n            }],\\n            \\\"decisions\\\": [{\\n                \\\"source_id\\\": \\\"synthetic-review-ledger\\\", \\\"source_sha256\\\": \\\"c\\\" * 64,\\n                \\\"locator\\\": \\\"Review ledger row 2 synthetic\\\", \\\"row\\\": 2,\\n                \\\"values\\\": {\\n                    \\\"Decision reference\\\": {\\\"value\\\": \\\"D-SYN-RUN-R1\\\"},\\n                    \\\"Arrival batch\\\": {\\\"value\\\": 1}, \\\"Subject type\\\": {\\\"value\\\": \\\"claim\\\"},\\n                    \\\"Subject reference\\\": {\\\"value\\\": \\\"C-SYN-RUN\\\"}, \\\"Revision\\\": {\\\"value\\\": 1},\\n                    \\\"Outcome\\\": {\\\"value\\\": \\\"approve\\\"},\\n                },\\n            }],\\n            \\\"finance_events\\\": [{\\n                \\\"source_id\\\": \\\"synthetic-finance-ledger\\\", \\\"source_sha256\\\": \\\"d\\\" * 64,\\n                \\\"locator\\\": \\\"Finance activity row 2 synthetic\\\", \\\"row\\\": 2,\\n                \\\"values\\\": {\\n                    \\\"Activity reference\\\": {\\\"value\\\": \\\"F-SYN-RUN-SETTLED\\\"},\\n                    \\\"Arrival batch\\\": {\\\"value\\\": 1}, \\\"Activity type\\\": {\\\"value\\\": \\\"settled\\\"},\\n                    \\\"Claim reference\\\": {\\\"value\\\": \\\"C-SYN-RUN\\\"}, \\\"Currency\\\": {\\\"value\\\": \\\"EUR\\\"},\\n                    \\\"Amount (EUR)\\\": {\\\"value\\\": 12.5},\\n                },\\n            }],\\n            \\\"cancellation_activities\\\": [],\\n        },\\n    }\\n    (run_dir / \\\"parsed-records.json\\\").write_text(json.dumps(parsed), encoding=\\\"utf-8\\\")\\n    return run_dir, attempts\\n\\n\\ndef test_offline_replay_cli_seals_ordered_batches_and_writes_traceable_outputs(tmp_path):\\n    run_dir, attempts = _capture(tmp_path)\\n    attempts_before_replay = list(attempts)\\n\\n    assert main([\\\"offline-replay\\\", str(run_dir), \\\"--schema\\\", str(SCHEMA)]) == 0\\n    assert attempts == attempts_before_replay\\n\\n    first = run_dir / \\\"batches/arrival-001.json\\\"\\n    second = run_dir / \\\"batches/arrival-002.json\\\"\\n    first_obj = json.loads(first.read_text(encoding=\\\"utf-8\\\"))\\n    second_obj = json.loads(second.read_text(encoding=\\\"utf-8\\\"))\\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\\n    assert first_obj[\\\"predecessor\\\"] is None\\n    assert second_obj[\\\"predecessor\\\"] == {\\n        \\\"path\\\": \\\"batches/arrival-001.json\\\",\\n        \\\"sha256\\\": hashlib.sha256(first.read_bytes()).hexdigest(),\\n    }\\n    assert \\\"offline-replay-mode\\\" in {row[\\\"record_id\\\"] for row in first_obj[\\\"issues\\\"]}\\n    replay_state = json.loads((run_dir / \\\"offline-replay-state.json\\\").read_text(encoding=\\\"utf-8\\\"))\\n    assert [row[\\\"revision\\\"] for row in replay_state[\\\"revision_history\\\"][\\\"claim\\\"][\\\"C-SYN-RUN\\\"][\\\"revisions\\\"]] == [1, 2]\\n    assert [row[\\\"decision_id\\\"] for row in replay_state[\\\"decision_history\\\"]] == [\\\"D-SYN-RUN-R1\\\"]\\n    assert [row[\\\"values\\\"][\\\"Activity reference\\\"][\\\"value\\\"] for row in replay_state[\\\"source_record_history\\\"][\\\"finance_events\\\"]] == [\\\"F-SYN-RUN-SETTLED\\\"]\\n\\n    with (run_dir / \\\"claims.csv\\\").open(encoding=\\\"utf-8\\\", newline=\\\"\\\") as stream:\\n        rows = list(csv.DictReader(stream))\\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\\n        assert len(rows) == 1\\n        assert rows[0][\\\"claim_id\\\"] == \\\"C-SYN-RUN\\\"\\n        assert rows[0][\\\"revision\\\"] == \\\"2\\\"\\n        assert rows[0][\\\"allowed_cents\\\"] == \\\"\\\"\\n        assert rows[0][\\\"paid_cents\\\"] == \\\"1250\\\"\\n        assert rows[0][\\\"balance_cents\\\"] == \\\"\\\"\\n    report = (run_dir / \\\"report.md\\\").read_text(encoding=\\\"utf-8\\\")\\n    assert \\\"OFFLINE REPLAY\\\" in report\\n    assert \\\"Fresh native reads in this run: **no**\\\" in report\\n    assert \\\"Case clock: **unresolved**\\\" in report\\n    assert \\\"POL-2026.2: **unavailable**\\\" in report\\n    queue = json.loads((run_dir / \\\"repair-queue.json\\\").read_text(encoding=\\\"utf-8\\\"))\\n    assert \\\"by_owner\\\" in queue\\n\\n\\ndef test_offline_replay_cli_refuses_to_overwrite_outputs(tmp_path):\\n    run_dir, _ = _capture(tmp_path)\\n    assert main([\\\"offline-replay\\\", str(run_dir), \\\"--schema\\\", str(SCHEMA)]) == 0\\n    first = (run_dir / \\\"batches/arrival-001.json\\\").read_bytes()\\n    assert main([\\\"offline-replay\\\", str(run_dir), \\\"--schema\\\", str(SCHEMA)]) == 1\\n    assert (run_dir / \\\"batches/arrival-001.json\\\").read_bytes() == first\\n\\n\\ndef test_report_separates_owner_grouped_open_repairs_and_external_blockers(tmp_path):\\n    from travel_claim.offline_replay import _report, run_offline_replay\\n    from travel_claim.outputs import add_repair_item\\n\\n    run_dir, _ = _capture(tmp_path)\\n    parsed_path = run_dir / \\\"parsed-records.json\\\"\\n    parsed = json.loads(parsed_path.read_text())\\n    # A second claim has an unresolved trip binding. The first claim's cash\\n    # evidence and both revisions must still survive the complete replay.\\n    independent = json.loads(json.dumps(parsed[\\\"records\\\"][\\\"claim_revisions\\\"][0]))\\n    independent[\\\"fields\\\"][0][\\\"value\\\"] = \\\"C-UNRESOLVED\\\"\\n    independent[\\\"fields\\\"][3][\\\"value\\\"] = \\\"T-MISSING\\\"\\n    parsed[\\\"records\\\"][\\\"claim_revisions\\\"].append(independent)\\n    parsed_path.write_text(json.dumps(parsed))\\n    result = run_offline_replay(run_dir, schema_path=SCHEMA)\\n    claims = {row[\\\"claim_id\\\"]: row for row in result[\\\"state\\\"][\\\"snapshot\\\"][\\\"claims\\\"]}\\n    assert set(claims) == {\\\"C-SYN-RUN\\\", \\\"C-UNRESOLVED\\\"}\\n    assert claims[\\\"C-SYN-RUN\\\"][\\\"revision\\\"] == 2\\n    assert claims[\\\"C-SYN-RUN\\\"][\\\"paid_cents\\\"] == 1250\\n    assert claims[\\\"C-SYN-RUN\\\"][\\\"allowed_cents\\\"] is None\\n    queue = result[\\\"state\\\"][\\\"domain\\\"][\\\"repair_queue\\\"]\\n    report = result[\\\"outputs\\\"][\\\"report\\\"].read_text()\\n    claim_section = report.split(\\\"## Claim-specific actionable repairs by owner\\\\n\\\", 1)[1].split(\\\"## Trip and permit\\\", 1)[0]\\n    blockers = report.split(\\\"## Run-level external blockers\\\\n\\\", 1)[1].split(\\\"## Outputs\\\", 1)[0]\\n    assert \\\"offline replay\\\" in blockers\\n    assert \\\"scenario-case-clock\\\" in blockers\\n    assert \\\"reimbursement-policy-pol-2026-2\\\" in blockers\\n    assert \\\"scenario-case-clock\\\" not in claim_section\\n    assert \\\"reimbursement-policy-pol-2026-2\\\" not in claim_section\\n    assert \\\"Independent valid records continue\\\" in report\\n    for item in queue[\\\"items\\\"].values():\\n        if item[\\\"subject_type\\\"] != \\\"claim\\\" or item[\\\"status\\\"] != \\\"open\\\":\\n            continue\\n        owner_section = claim_section.split(f\\\"### {item['owner']}\\\\n\\\", 1)[1].split(\\\"\\\\n### \\\", 1)[0]\\n        assert f\\\"Repair `{item['item_id']}`\\\" in owner_section\\n        assert f\\\"subject claim `{item['subject_id']}`, revision {item['revision']}\\\" in owner_section\\n        assert f\\\"Next action: {item['next_action']}\\\" in owner_section\\n        assert f\\\"run `{item['run_id']}`, batch `{item['batch_id']}`\\\" in owner_section\\n        for ref in item[\\\"source_refs\\\"]:\\n            assert f\\\"`{ref}`\\\" in owner_section\\n    assert claim_section.count(\\\"### \\\") == len({item[\\\"owner\\\"] for item in queue[\\\"items\\\"].values() if item[\\\"subject_type\\\"] == \\\"claim\\\" and item[\\\"status\\\"] == \\\"open\\\"})\\n\\n    # Report filtering must leave persisted queue history untouched and must\\n    # keep non-claim repairs in their own section, even 