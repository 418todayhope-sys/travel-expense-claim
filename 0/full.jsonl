nclude_the_whole_scope_ledger():\\ntests/test_budget.py:203:def test_correction_cannot_offset_a_different_cost_with_an_old_own_commitment():\\ntests/test_budget.py:211:def test_other_scope_conflict_does_not_block_an_independent_valid_claim():\\ntests/test_budget.py:219:def test_prior_paid_cost_mismatch_requires_finance_repair_instead_of_zero():\\ntests/test_budget.py:228:def test_budget_membership_uses_only_arrived_rows_and_keeps_first_replay_context():\\ntests/test_budget.py:244:def test_tampered_budget_readiness_state_fails_evidence_replay(tmp_path):\\ntests/test_budget.py:254:def test_budget_owner_repairs_are_grouped_with_exact_claim_revision_and_sources():\\ntests/test_budget.py:263:def test_transfer_attempt_cancellation_is_not_request_release_or_cash_refund():\\ntests/test_budget.py:275:def test_new_finance_batch_can_be_reviewed_using_verified_native_printed_version():\\ntests/test_budget.py:286:def test_budget_ledger_identity_requires_a_stable_nonblank_string(identity):\\ntests/test_budget.py:292:def test_future_redelivery_does_not_retire_an_already_observed_opening_fact():\\ntests/test_retained_finance.py:43:def test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\\ntests/test_retained_finance.py:74:def test_native_corrections_keep_ledger_history_and_revalidate_authority_only_where_affected():\\ntests/test_retained_finance.py:107:def test_native_refund_and_finance_cancellation_are_independent_of_business_cancellations():\\ntests/test_retained_finance.py:123:def test_duplicate_refund_and_accepted_redelivery_keep_identity_and_original_revision_context():\\ntests/test_retained_finance.py:150:def test_explicit_revision_link_is_distinct_from_arrival_context_and_does_not_approve():\\ntests/test_retained_finance.py:161:def test_missing_amount_and_conflicting_obligation_events_do_not_produce_known_ledger_balance():\\ntests/test_retained_finance.py:176:def test_unknown_reversal_semantics_are_unresolved_and_never_turned_into_cash():\\ntests/test_retained_finance.py:188:def test_cash_request_mismatch_keeps_ledger_difference_unresolved_with_owned_repair():\\ntests/test_retained_finance.py:200:def test_queue_updates_missing_evidence_question_without_erasing_its_history():\\ntests/test_retained_finance.py:223:def test_finance_report_separates_observed_ledger_difference_from_authority(tmp_path):\\n# Project D fresh native-source attempt\\n\\n**BLOCKED** — `project-d-live-20261014T204849Z`; mode: `live-source-attempt`.\\n\\nAll five original source locations were attempted in this invocation using native HTTP/export routes. No previous retained input was substituted. Retrieval observations are not a case clock.\\n\\nAcquisition: **BLOCKED**. Final live-source compliance: **not established**. No arrival batches consumed.\\n\\nComplete relevant returned bytes, usable partial content and diagnostic responses are retained in this run and bound in `sources.json`.\\n\\n- **PASS** `manifest-integrity`: Fresh observations and retained bytes verified\\n  - Evidence: `sources.json`; next action: No integrity repair needed\\n- **BLOCKED** `source:policy-pol-2026-2`: HTTP response contained a generic Notion shell; policy page content was not accessible\\n  - Evidence: `responses/policy-pol-2026-2.body`; next action: Obtain authorized native content and retry in a new run\\n- **PASS** `source:initial-claim-binder`: Complete supported export read; retained bytes bound by SHA-256\\n  - Evidence: `sources/initial-claim-binder.pdf`; next action: Retain observed source version and wording\\n- **PASS** `source:claim-updates-binder`: Complete supported export read; retained bytes bound by SHA-256\\n  - Evidence: `sources/claim-updates-binder.pdf`; next action: Retain observed source version and wording\\n- **PASS** `source:receipt-binder`: Complete supported export read; retained bytes bound by SHA-256\\n  - Evidence: `sources/receipt-binder.pdf`; next action: Retain observed source version and wording\\n- **PASS** `source:travel