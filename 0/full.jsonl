.encode()).hexdigest(),\\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\\n    return parsed\\n\\n\\ndef batches(parsed):\\n    prior = None; results = []\\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\\n    for number in parsed['arrival_batches']:\\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\\n            prior_result=prior, source_observations=parsed['source_observations'])\\n        assert list(validator.iter_errors(prior['snapshot'])) == []\\n        results.append(prior)\\n    return results\\n\\n\\ndef workflow(result, claim='SYN-C01'):\\n    return result['domain']['ordinary_workflows'][claim]\\n\\n\\ndef stages(value):\\n    return {stage['stage']: stage for stage in value['stages']}\\n\\n\\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\\n    results = batches(native())\\n    current = workflow(results[-1], 'C01'); checks = stages(current)\\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation'):\\n        assert checks[name]['status'] == 'PASS'\\n    for name in ('travel_permission', 'policy_eligibility', 'required_approvals', 'request_obligation', 'financial_closure'):\\n        assert checks[name]['status'] == 'BLOCKED'\\n        assert checks[name]['owner'] and checks[name]['next_action']\\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\\n    line = current['lines'][0]\\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\\n    assert any(\\\"#tab 'Merchant payments', row 6\\\" in ref for ref in line['source_refs'])\\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\\n    assert len(current['observed_reviews']) == 3\\n    finance = results[-1]['finance_reconciliations']['C01']\\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\\n    assert results[-1]['snapshot']['requests'] == []\\n\\n\\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\\n\\n\\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\\n    parsed = synthetic()\\n    conflict = deepcopy(parsed['records']['decisions'][0])\\n    conflict['values']['Outcome']['value'] = 'return'\\n    parsed['records']['decisions'].append(conflict)\\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\\n\\n\\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\\n    parsed = synthetic()\\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\\n    policy['Uncapped categories']['value'] = []\\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\\n    })\\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\\n    for event in parsed['records']['finance_events']:\\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\\n            if field in event['values']: event['values'][field]['value'] = 40\\n    value = workflow(batches(parsed)[-1])\\n    assert value['lines'][0]['original_cents'] == 10000\\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\\n    assert value['status'] == 'closed-reimbursed'\\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\\n\\n\\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\\n    parsed = synthetic()\\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\\n    value = workflow(batches(parsed)[-1])\\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\\n    stage('cancellation_readiness', not affected, cancellation_refs,\\n          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\\n          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\\n    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\\n              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\\n    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\\n          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\\n          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\\n    pending = next((s for s in stages if s['status'] != 'PASS'), None)\\n    return dict(claim_id=claim_id, revision=revision, trip_id=trip_id, trip_revision=claim.get('trip_revision'),\\n                mode=parsed.get('evidence_mode', 'offline-replay'), status=('closed-reimbursed' if allowed else 'closed-no-payment') if closed else 'pending',\\n                allowed_cents=allowed, balance_cents=finance['balance_cents'], lines=lines, stages=stages,\\n                observed_reviews=observed, request=deepcopy(requests[0]) if request_ok else None,\\n                source_refs=list(dict.fromkeys([ref(record)] + [r for s in stages for r in s['source_refs']])),\\n                next_owner=None if closed else pending['owner'], reason='Supported financial closure' if closed else pending['detail'],\\n                finance=finance)\\n\\n\\ndef ordinary_demo(workflows):\\n    \\\"\\\"\\\"Render one observed claim with every stage, owner and retained reference.\\\"\\\"\\\"\\n    claim_id = \\\"C01\\\" if \\\"C01\\\" in workflows else next(iter(sorted(workflows)), None)\\n    delta = _delta(parsed, arrival_batch)\\n    digest = _digest({\\n        \\\"delta\\\": delta,\\n        \\\"run_id\\\": run_id,\\n        \\\"batch_id\\\": batch_id,\\n        \\\"source_binding\\\": source_binding,\\n        \\\"predecessor\\\": predecessor,\\n        \\\"authorized_obligations\\\": authorized_obligations or {},\\n        \\\"source_classifications\\\": source_classifications or {},\\n        \\\"trip_reference_records\\\": parsed.get(\\\"records\\\", {}).get(\\\"trips\\\", []),\\n        \\\"unresolved_issues\\\": parsed.get(\\\"unresolved_issues\\\", []),\\n        \\\"ordinary_evidence\\\": {key: parsed.get(key) for key in (\\\"records\\\", \\\"workbook_sheets\\\", \\\"case_clock\\\", \\\"event_clock\\\", \\\"evidence_mode\\\")},\\n        \\\"source_observations\\\": source_observations or [],\\n    })\\n    previous_domain = deepcopy(prior_result[\\\"domain\\\"]) if prior_result else _domain_seed()\\n    processed = previous_domain[\\\"processed_batches\\\"]\\n20:    build_revision_history,\\n99:        \\\"revision_history\\\": None,\\n569:        for subject_id, value in (domain.get(\\\"revision_history\\\") or {}).get(\\\"claim\\\", {}).items()\\n580:    history = build_revision_history({\\n583:    domain[\\\"revision_history\\\"] = history\\n608:            revision_history=record_set[\\\"revisions\\\"],\\n751:        \\\"revision_history\\\": deepcopy(history),\\n{\\n  \\\"schema_version\\\": \\\"project-d-user-provided-policy/1\\\",\\n  \\\"source_id\\\": \\\"user-browser-policy-pol-2026-2-step167\\\",\\n  \\\"path\\\": \\\"user-provided-sources/step-167/POL-2026.2-browser-copy.txt\\\",\\n  \\\"sha256\\\": \\\"f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2\\\",\\n  \\\"expected_sha256_supplied_by\\\": \\\"user\\\",\\n  \\\"hash_verified\\\": true,\\n  \\\"encoding\\\": \\\"UTF-8\\\",\\n  \\\"utf8_decoding\\\": \\\"strict; successful\\\",\\n  \\\"bytes\\\": 13381,\\n  \\\"lines\\\": 33,\\n  \\\"preserved_original_bytes\\\": true,\\n  \\\"policy_identifier\\\": \\\"POL-2026.2\\\",\\n  \\\"identifier_reference\\\": \\\"line 1\\\",\\n  \\\"provenance_type\\\": \\\"user-provided authenticated/browser-visible copy\\\",\\n  \\\"source_url\\\": \\\"https://private-pecorino-70e.notion.site/REDACTED\\\",\\n  \\\"acquisition_attestation\\\": \\\"User states they personally copied the complete visible text from the original Notion page.\\\",\\n  \\\"browser_retrieval_time\\\": null,\\n  \\\"remote_block_tree_completeness_independently_verified\\\": false,\\n  \\\"complete_visible_text_user_attested\\\": true,\\n  \\\"native_http_or_api_read_performed_for_this_copy\\\": false,\\n  \\\"earlier_native_captures_reclassified\\\": false,\\n  \\\"audit_base_commit\\\": \\\"cae2e5279b1b139bfc26d7a699b661c872db7544\\\",\\n  \\\"verification_observed_at_utc\\\": \\\"2026-10-14T21:13:51.830631+00:00\\\",\\n  \\\"case_clock\\\": {\\n    \\\"case_date\\\": \\\"20