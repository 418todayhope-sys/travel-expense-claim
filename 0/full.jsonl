\\s*Claim reference:\\s*(.+)$\", text, re.M)\n        receipt_refs = re.findall(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M)\n        pages.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"locator\": f\"PDF page {page_no}\",\n            \"page\": page_no,\n            \"record_types\": ([\"claim_revision\"] if claim else []) + ([\"receipt\"] if receipt_refs else []),\n            \"claim_id\": claim.group(1).strip() if claim else None,\n            \"receipt_ids\": [item.strip() for item in receipt_refs],\n            \"fields\": _extract_labels(text),\n            \"text\": text,\n        })\n    return pages\n\n\ndef _workbook_sheets(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    workbook = load_workbook(path, data_only=False, read_only=False)\n    sheets: list[dict[str, Any]] = []\n    for sheet in workbook.worksheets:\n        rows = list(sheet.iter_rows())\n        header_row = next((i for i, row in enumerate(rows) if any(cell.value is not None for cell in row)), None)\n        if header_row is None:\n            continue\n        headers = [cell.value for cell in rows[header_row]]\n        # Workbook tabs begin with a title, notes, and a blank row. The row\n        # whose first cell names an ID/reference is the native table header.\n        table_row = next((i for i, row in enumerate(rows)\n                          if any(str(c.value).strip().lower() in {\"employee id\", \"trip reference\",\n                             \"transaction reference\", \"rate reference\", \"cap reference\",\n                             \"ledger reference\", \"decision reference\", \"activity reference\",\n                             \"cancellation activity reference\"} for c in row if c.value is not None)), None)\n        if table_row is None:\n            table_row = header_row\n        headers = [cell.value for cell in rows[table_row]]\n        records: list[dict[str, Any]] = []\n        for row_idx, row in enumerate(rows[table_row + 1:], table_row + 2):\n            if not any(cell.value is not None for cell in row):\n                continue\n            values = {}\n            for col_idx, cell in enumerate(row):\n                if col_idx >= len(headers) or headers[col_idx] is None or cell.value is None:\n                    continue\n                header = str(headers[col_idx])\n                values[header] = {\n                    \"value\": _scalar(cell.value),\n                    \"source_text\": str(cell.value),\n                    \"number_format\": cell.number_format,\n                    \"data_type\": cell.data_type,\n                    \"cell\": cell.coordinate,\ntests/test_approvals.py:62:    assert any(d['rejection_reasons'] for d in result['deliveries'])\ntests/test_approvals.py:85:@pytest.mark.parametrize('outcome,state',[('return','returned'),('reject','rejected')])\ntests/test_approvals.py:102:    assert result['state']=='pending' and 'repair' in result['deliveries'][0]['rejection_reasons'][0]\ntests/test_approvals.py:149:@pytest.mark.parametrize('status,outcome,expected',[('withdrawn',None,'withdrawn'),('submitted','reject','rejected'),('submitted','return','pending')])\ntests/test_approvals.py:161:def test_withdrawal_after_payment_preserves_cash_and_requires_finance_disposition():\ntests/test_approvals.py:162:    p=synthetic();new=corrected(p);setfield(new,'Status','withdrawn')\ntests/test_approvals.py:166:    assert current['claim_approval']['state']=='withdrawn' and current['request'] is None\ntests/test_approvals.py:177:                                 ('C14',4000,'rejected'),('C21',8000,'returned'),('C46',4500,'approved')]:\ntests/test_approvals.py:249:def test_untrusted_withdrawal_cannot_be_treated_as_a_clean_terminal_state():\ntests/test_approvals.py:250:    p=synthetic();setfield(p['records']['claim_revisions'][0],'Status','withdrawn')\n"},"started_at_ms":1792066234232,"completed_at_ms":1792066234381}}
