format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"D6\"\n    },\n    \"Currency\": {\n      \"value\": \"EUR\",\n      \"source_text\": \"EUR\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"E6\"\n    },\n    \"Gross amount\": {\n      \"value\": 100.0,\n      \"source_text\": \"100.0\",\n      \"number_format\": \"0.00\",\n      \"data_type\": \"n\",\n      \"cell\": \"F6\"\n    },\n    \"Paid date\": {\n      \"value\": \"2026-09-01T00:00:00\",\n      \"source_text\": \"2026-09-01 00:00:00\",\n      \"number_format\": \"yyyy-mm-dd\",\n      \"data_type\": \"d\",\n      \"cell\": \"G6\"\n    },\n    \"Payment status\": {\n      \"value\": \"settled\",\n      \"source_text\": \"settled\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"H6\"\n    },\n    \"Receipt reference\": {\n      \"value\": \"R-COST-01\",\n      \"source_text\": \"R-COST-01\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"I6\"\n    }\n  }\n}\nFX {\n  \"source_id\": \"travel-registers-workbook\",\n  \"source_sha256\": \"579691b671acc735d1fdbb4944a2daf397b13307075ba74f15fa8bc24daa75b8\",\n  \"locator\": \"tab 'FX', row 6\",\n  \"row\": 6,\n  \"values\": {\n    \"Rate reference\": {\n      \"value\": \"FX-EUR\",\n      \"source_text\": \"FX-EUR\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"A6\"\n    },\n    \"Rate date\": {\n      \"value\": \"2026-09-01T00:00:00\",\n      \"source_text\": \"2026-09-01 00:00:00\",\n      \"number_format\": \"yyyy-mm-dd\",\n      \"data_type\": \"d\",\n      \"cell\": \"B6\"\n    },\n    \"Currency\": {\n      \"value\": \"EUR\",\n      \"source_text\": \"EUR\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"C6\"\n    },\n    \"EUR per currency unit\": {\n      \"value\": 1.0,\n      \"source_text\": \"1.0\",\n      \"number_format\": \"0.0000\",\n      \"data_type\": \"n\",\n      \"cell\": \"D6\"\n    }\n  }\n}\nCaps {\n  \"source_id\": \"travel-registers-workbook\",\n  \"source_sha256\": \"579691b671acc735d1fdbb4944a2daf397b13307075ba74f15fa8bc24daa75b8\",\n  \"locator\": \"tab 'Caps', row 6\",\n  \"row\": 6,\n  \"values\": {\n    \"Cap reference\": {\n      \"value\": \"CAP-lodging\",\n      \"source_text\": \"CAP-lodging\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"A6\"\n    },\n    \"Destination\": {\n      \"value\": \"NL\",\n      \"source_text\": \"NL\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"B6\"\n    },\n    \"Category\": {\n      \"value\": \"lodging\",\n      \"source_text\": \"lodging\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"C6\"\n    },\n    \"Currency\": {\n      \"value\": \"EUR\",\n      \"source_text\": \"EUR\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"D6\"\n    },\n    \"Effective from\": {\n      \"value\": \"2026-01-01T00:00:00\",\n      \"source_text\": \"2026-01-01 00:00:00\",\n      \"number_format\": \"yyyy-mm-dd\",\n      \"data_type\": \"d\",\n      \"cell\": \"E6\"\n    },\n    \"Effective to\": {\n      \"value\": \"2026-12-31T00:00:00\",\n      \"source_text\": \"2026-12-31 00:00:00\",\n      \"number_format\": \"yyyy-mm-dd\",\n      \"data_type\": \"d\",\n      \"cell\": \"F6\"\n    },\n    \"Amount per unit\": {\n      \"value\": 150.0,\n      \"source_text\": \"150.0\",\n      \"number_format\": \"0.00\",\n      \"data_type\": \"n\",\n      \"cell\": \"G6\"\n    }\n  }\n}\nReview packets {\n  \"source_id\": \"travel-registers-workbook\",\n  \"source_sha256\": \"579691b671acc735d1fdbb4944a2daf397b13307075ba74f15fa8bc24daa75b8\",\n  \"locator\": \"tab 'Review packets', row 6\",\n  \"row\": 6,\n  \"values\": {\n    \"Decision reference\": {\n      \"value\": \"D-C01-1-claim-administration-1\",\n      \"source_text\": \"D-C01-1-claim-administration-1\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"A6\"\n    },\n    \"Employee ID\": {\n      \"value\": \"EMP-01\",\n      \"source_text\": \"EMP-01\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"B6\"\n    },\n    \"Trip reference\": {\n      \"value\": \"T01\",\n      \"source_text\": \"T01\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"C6\"\n    },\n    \"Business purpose\": {\n      \"value\": \"Client workshop and delivery planning\",\n      \"source_text\": \"Client workshop and delivery planning\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"D6\"\n    },\n    \"Client\": {\n      \"value\": \"Client-A\",\n      \"source_text\": \"Client-A\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"E6\"\n    },\n    \"Schedule coverage\": {\n      \"value\": \"Team colleague covers routine support\",\n      \"source_text\": \"Team colleague covers routine support\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"F6\"\n    },\n    \"Alternatives considered\": {\n      \"value\": \"Remote participation considered; onsite workshop requested\",\n      \"source_text\": \"Remote participation considered; onsite workshop requested\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"G6\"\n    },\n    \"Expense references\": {\n      \"value\": \"COST-01\",\n      \"source_text\": \"COST-01\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"I6\"\n    },\n    \"Policy revision\": {\n      \"value\": \"POL-2026.2\",\n      \"source_text\": \"POL-2026.2\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"J6\"\n    },\n    \"Budget record references\": {\n      \"value\": \"B-ALLOC\\nB-OLD1\\nB-OLD2\",\n      \"source_text\": \"B-ALLOC\\nB-OLD1\\nB-OLD2\",\n      \"number_format\": \"General\",\n      \"data_type\": \"s\",\n      \"cell\": \"K6\"\n    },\n    \"Budget owner\n\nfrom .sources import verify_source_manifest\n\nOUTPUT_NAME = \"parsed-records.json\"\nRECORD_SCHEMA = \"travel-claim-parsed-records/1\"\n\n\ndef _scalar(value: Any) -> Any:\n    if isinstance(value, (datetime, date, time)):\n        return value.isoformat()\n    if isinstance(value, (str, int, float, bool)) or value is None:\n        return value\n    return str(value)\n\n\ndef _extract_labels(text: str) -> list[dict[str, str]]:\n    \"\"\"Keep every colon-labelled line verbatim as a field/value occurrence.\"\"\"\n    found = []\n    for line_no, line in enumerate(text.splitlines(), 1):\n        match = re.match(r\"^\\s*([^:\\n]+):\\s?(.*)$\", line)\n        if match:\n            found.append({\"line\": str(line_no), \"label\": match.group(1), \"value\": match.group(2)})\n    return found\n\n\ndef _pdf_pages(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    reader = PdfReader(path, strict=True)\n    pages: list[dict[str, Any]] = []\n    for page_no, page in enumerate(reader.pages, 1):\n        text = page.extract_text(extraction_mode=\"layout\") or \"\"\n        claim = re.search(r\"^\\s*Claim reference:\\s*(.+)$\", text, re.M)\n        receipt_refs = re.findall(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M)\n        pages.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"locator\": f\"PDF page {page_no}\",\n            \"page\": page_no,\n            \"record_types\": ([\"claim_revision\"] if claim else []) + ([\"receipt\"] if receipt_refs else []),\n            \"claim_id\": claim.group(1).strip() if claim else None,\n            \"receipt_ids\": [item.strip() for item in receipt_refs],\n            \"fields\": _extract_labels(text),\n            \"text\": text,\n        })\n    return pages\n\n\n\"\"\"Deterministic claim summary CSV and owner-grouped local repair queue.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport os\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\n\nCLAIMS_COLUMNS = (\n    \"claim_id\",\n    \"revision\",\n    \"trip_id\",\n    \"status\",\n    \"allowed_cents\",\n    \"paid_cents\",\n    \"balance_cents\",\n    \"next_owner\",\n    \"reason\",\n)\n\nCLAIM_STATUSES = {\n    \"pending\", \"held\", \"ready\", \"closed-reimbursed\", \"closed-no-payment\", \"rejected\", \"withdrawn\"\n}\n\nREPAIR_ITEM_FIELDS = (\n    \"item_id\",\n    \"subject_type\",\n    \"subject_id\",\n    \"revision\",\n    \"source_refs\",\n    \"missing_or_return_reason\",\n    \"owner\",\n    \"next_action\",\n)\n\n\ndef _money(value: Any, field: str, allow_negative: bool = False) -> int | None:\n    if value is None:\n        return None\n    if isinstance(value, bool) or not isinstance(value, int):\n        raise ValueError(f\"{field} must be integer cents or null\")\n    if not allow_negative and value < 0:\n        raise ValueError(f\"{field} cannot be negative\")\n    return value\n\n\ndef write_claims_csv(claims: list[dict], path: Path) -> None:\n    \"\"\"Write one row per supplied current claim with the required exact header.\"\"\"\n    ids = [claim.get(\"claim_id\") for claim in claims]\n    if any(not value for value in ids) or len(ids) != len(set(ids)):\n        raise ValueError(\"claims must contain one nonempty, unique current row per claim_id\")\n    prepared = []\n    for claim in sorted(claims, key=lambda row: row[\"claim_id\"]):\n        missing = set(CLAIMS_COLUMNS) - set(claim)\n        if missing:\n            raise ValueError(f\"claim {claim.get('claim_id')} is missing CSV fields: {sorted(missing)}\")\n        row = {key: claim[key] for key in CLAIMS_COLUMNS}\n        if isinstance(row[\"revision\"], bool) or not isinstance(row[\"revision\"], int) or row[\"revision\"] < 1:\n            raise ValueError(f\"claim {claim['claim_id']} revision must be a positive integer\")\n        for key in (\"claim_id\", \"trip_id\", \"status\", \"reason\"):\n            if not isinstance(row[key], str) or not row[key]:\n                raise ValueError(f\"{key} must be a nonempty string\")\n        if row[\"status\"] not in CLAIM_STATUSES:\n            raise ValueError(f\"unsupported claim status {row['status']!r}\")\n        row[\"allowed_cents\"] = _money(row[\"allowed_cents\"], \"allowed_cents\")\n        row[\"paid_cents\"] = _money(row[\"paid_cents\"], \"paid_cents\")\n        row[\"balance_cents\"] = _money(row[\"balance_cents\"], \"balance_cents\", allow_negative=True)\n        for key in (\"next_owner\", \"reason\"):\n            if row[key] is not None and not isinstance(row[key], str):\n                raise ValueError(f\"{key} must be a string or null\")\n            row[key] = \"\" if row[key] is None else row[key]\n        prepared.append(row)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"x\", encoding=\"utf-8\", newline=\"\") as stream:\n        writer = csv.DictWriter(stream, fieldnames=CLAIMS_COLUMNS, extrasaction=\"raise\")\n        writer.writeheader()\n        writer.writerows(prepared)\n\n\ndef new_repair_queue() -> dict:\n    return {\"queue_version\": \"owner-queue/1\", \"items\": {}, \"events\": []}\n\n\ndef add_repair_item(\n    queue: dict,\n    *,\n    ])\n    return \"\\n\".join(lines)\n\n\ndef run_offline_replay(run_dir: Path, *, schema_path: Path) -> dict[str, Any]:\n    \"\"\"Consume retained parsed records in batch order and write immutable outputs.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Retained source manifest verification failed: \" + \"; \".join(errors))\n    manifest_path = run_dir / \"sources.json\"\n    manifest = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    parsed_path = run_dir / OUTPUT_NAME\n    parsed = json.loads(parsed_path.read_text(encoding=\"utf-8\"))\n    actual_manifest_hash = hashlib.sha256(manifest_path.read_bytes()).hexdigest()\n    if parsed.get(\"run_id\") != manifest.get(\"run_id\"):\n        raise ValueError(\"Parsed records run_id does not match the retained source manifest\")\n    if parsed.get(\"source_manifest\") != {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}:\n        raise ValueError(\"Parsed records are not bound to the current retained sources.json bytes\")\n    batches = parsed.get(\"arrival_batches\")\n    if not isinstance(batches, list) or not batches or batches != list(range(1, len(batches) + 1)):\n        raise ValueError(\"Retained arrival batches must be a nonempty contiguous explicit sequence starting at 1\")\n    output_paths = {\n        \"claims\": run_dir / \"claims.csv\",\n        \"report\": run_dir / \"report.md\",\n        \"queue\": run_dir / \"repair-queue.json\",\n        \"state\": run_dir / \"offline-replay-state.json\",\n        \"drafts\": run_dir / \"follow-up-drafts.md\",\n    }\n    occupied = [str(path) for path in output_paths.values() if path.exists()]\n    if occupied:\n        raise FileExistsError(\"Refusing to overwrite offline replay outputs: \" + \", \".join(occupied))\n    batches_dir = run_dir / \"batches\"\n    if batches_dir.exists() and any(batches_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to overwrite or append to existing sealed batch chain: {batches_dir}\")\n\n    binding = {\"path\": \"sources.json\", \"sha256\": actual_manifest_hash}\n    previous: dict[str, Any] | None = None\n    previous_path: Path | None = None\n    sealed: list[Path] = []\n    for number in batches:\n        batch_id = f\"arrival-{number:03d}\"\n        predecessor = None\n        if previous_path is not None:\n            predecessor = {\n                \"path\": f\"batches/{previous_path.name}\",\n                \"sha256\": hashlib.sha256(previous_path.read_bytes()).hexdigest(),\n            }\n        current = integrate_arrival_batch(\n            parsed, arrival_batch=number, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            source_binding=binding, predecessor=predecessor, prior_result=previous,\n        )\n        current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n        path = seal_batch_snapshot(\n            run_dir, run_id=manifest[\"run_id\"], batch_id=batch_id,\n            predecessor_path=previous_path, schema_path=schema_path,\n            allow_unconfirmed_case_clock=True, **{\n                key: current[\"snapshot\"][key]\n                for key in (\"claims\", \"requests\", \"travel_cancellations\", \"admitted_event_ids\", \"issues\")\n            },\n        )\n        validation = verify_snapshot(path, run_dir, schema_path)\n        if validation:\n            raise ValueError(f\"Snapshot verification failed for {path}: \" + \"; \".join(validation))\n        sealed.append(path)\n        previous, previous_path = current, path\n\n    latest = previous\n    assert latest is not None\n    current_claims = []\n    owner_by_claim: dict[str, str] = {}\n    reason_by_claim: dict[str, str] = {}\n    for item in latest[\"domain\"][\"repair_queue\"][\"items\"].values():\n        if item[\"subject_type\"] == \"claim\" and item[\"status\"] == \"open\":\n            owner_by_claim.setdefault(item[\"subject_id\"], item[\"owner\"])\n            reason_by_claim.setdefault(item[\"subject_id\"], item[\"missing_or_return_reason\"])\n    for claim in latest[\"snapshot\"][\"claims\"]:\n        claim_id = claim[\"claim_id\"]\n        current_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": claim[\"revision\"],\n            \"trip_id\": claim[\"trip_id\"],\n            \"status\": \"pending\",\n            \"allowed_cents\": None,\n            \"paid_cents\": claim[\"paid_cents\"],\n            \"balance_cents\": claim[\"balance_cents\"],\n            \"next_owner\": owner_by_claim.get(claim_id, claim[\"next_owner\"]),\n            \"reason\": reason_by_claim.get(\n                claim_id,\n                \"Offline structural replay; policy eligibility and reimbursement entitlement remain unresolved.\",\n            ),\n        })\n    write_claims_csv(current_claims, output_paths[\"claims\"])\n    queue = latest[\"domain\"][\"repair_queue\"]\n    write_repair_queue(queue, output_paths[\"queue\"])\n    _exclusive_json(output_paths[\"state\"], {\n        \"mode\": \"offline-replay\",\n        \"fresh_native_reads_performed\": False,\n        \"run_id\": manifest[\"run_id\"],\n        \"case_clock\": manifest.get(\"case_clock\"),\n        \"source_manifest_sha256\": actual_manifest_hash,\n        \"parsed_records_path\": OUTPUT_NAME,\n        \"parsed_records_sha256\": hashlib.sha256(parsed_path.read_bytes()).hexdigest(),\n        \"parsed_record_counts\": {name: len(rows) for name, rows in parsed.get(\"records\", {}).items()},\n        \"sealed_batches\": [path.relative_to(run_dir).as_posix() for path in sealed],\n        \"revision_history\": latest[\"revision_history\"],\n        \"decision_history\": latest[\"decision_history\"],\n        \"finance_reconciliations\": latest[\"finance_reconciliations\"],\n        \"cancellation_state\": latest[\"domain\"][\"cancellation_state\"],\n        \"material_corrections\": latest[\"domain\"][\"material_corrections\"],\n        \"source_record_history\": {\n            \"claim_revisions\": latest[\"domain\"][\"claim_records\"],\n            \"decisions\": latest[\"domain\"][\"decision_records\"],\n            \"finance_events\": latest[\"domain\"][\"finance_records\"],\n            \"cancellation_activities\": latest[\"domain\"][\"cancellation_records\"],\n        },\n        \"repair_queue\": queue,\n    })\n    drafts, draft_count = render_follow_up_drafts(\n        run_id=manifest[\"run_id\"], queue=queue, blockers=parsed.get(\"unresolved_issues\", []),\n    )\n    with output_paths[\"drafts\"].open(\"x\", encodin