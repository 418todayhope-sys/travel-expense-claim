em[\\\"event_id\\\"] is not None],\\n   418\\t        \\\"duplicate_events\\\": duplicate_events,\\n   419\\t        \\\"conflicting_events\\\": conflicting_events,\\n   420\\t        \\\"confirmed_payment_event_ids\\\": [item[\\\"event_id\\\"] for item in payments.values() if item[\\\"amount_cents\\\"] is not None],\\n   421\\t        \\\"confirmed_refund_event_ids\\\": [item[\\\"event_id\\\"] for item in confirmed_refunds],\\n   422\\t        \\\"pending_transfer_event_ids\\\": [item[\\\"event_id\\\"] for item in typed if item[\\\"classification\\\"] == \\\"pending_transfer\\\"],\\n   423\\t        \\\"unresolved_event_ids\\\": list(dict.fromkeys(item[\\\"event_id\\\"] for item in unresolved if item[\\\"event_id\\\"] is not None)),\\n   424\\t        \\\"finance_obligation_events\\\": [item for item in history if item[\\\"classification\\\"] == \\\"obligation_accepted\\\"],\\n   425\\t        \\\"recorded_obligation_history\\\": obligation_history,\\n   426\\t        \\\"recorded_obligation\\\": recorded_obligation,\\n   427\\t        \\\"recorded_ledger_balance_cents\\\": ledger_balance,\\n   428\\t        \\\"reimbursement_entitlement_confirmed\\\": False,\\n   429\\t        \\\"closure_authority_confirmed\\\": False,\\n   430\\t        \\\"authorized_obligation\\\": obligation,\\n   431\\t        \\\"confirmed_payment_cents\\\": confirmed_payment_cents,\\n   432\\t        \\\"confirmed_refund_cents\\\": confirmed_refund_cents,\\n   433\\t        \\\"net_confirmed_cents\\\": net_confirmed_cents,\\n   434\\t        \\\"balance_cents\\\": balance,\\n   435\\t        \\\"inputs_complete\\\": balance is not None,\\n   436\\t        \\\"repair_issues\\\": issues,\\n   437\\t        \\\"repair_issues_by_owner\\\": issues_by_owner,\\n   438\\t        \\\"invalidated_previous_reconciliation\\\": invalidated,\\n   439\\t        \\\"financial_revalidation_history\\\": revalidation_history,\\n   440\\t    }\\ntests/test_revalidation.py:47:def test_retained_correction_moves