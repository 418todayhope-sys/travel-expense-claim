():\n         require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n         prior_result = None\n@@ -144,8 +147,19 @@ def validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> d\n             current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n             require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n             prior_result = current\n+        data, summary = verification_document(current['domain'], current['snapshot']['travel_cancellations'], run_id=state['run_id'])\n+        revalidation_expected.update(data=data, summary=summary)\n     check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n \n+    def correction_trace():\n+        require(revalidation_expected, \"Deterministic retained evidence replay required\")\n+        require(objects['correction-cancellation-verification.json'] == revalidation_expected['data'],\n+                \"Correction/cancellation checks differ from executed retained evidence replay\")\n+        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\n+                \"Correction/cancellation summary differs from executed checks\")\n+    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\n+          run_dir / 'correction-cancellation-verification.md'], correction_trace)\n+\n     # Collect only references actually present in retained parsed evidence.\n     parsed_refs: set[str] = set()\n     def collect_refs(value):\ndiff --git a/src/travel_claim/workflow.py b/src/travel_claim/workflow.py\nindex 6007c12..69618ae 100644\n--- a/src/travel_claim/workflow.py\n+++ b/src/travel_claim/workflow.py\n@@ -8,6 +8,7 @@ declare any claim ready or reimbursed.\n from __future__ import annotations\n \n from collections import defaultdict\n+from datetime import datetime\n from typing import Any\n \n \n@@ -243,6 +244,20 @@ def reduce_cancellation_activities(records: list[dict[str, Any]]) -> dict[str, A\n                 issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n                                \"source_ref\": _source_ref(record), \"reason\": \"confirmation has no effective time\"})\n                 continue\n+            # Explicitly UTC columns give timezone context, but never a case clock.\n+            stamps = [row_values(linked[1]).get(\"Activity time (UTC)\"),\n+                      values.get(\"Activity time (UTC)\"), values.get(\"Effective time (UTC)\")]\n+            try:\n+                times = [datetime.fromisoformat(t.replace(\"Z\", \"+00:00\")) for t in stamps]\n+                if times[1] < times[0] or times[2] < times[0]:\n+                    raise ValueError(\"confirmation precedes initiation\")\n+            except (TypeError, ValueError, AttributeError):\n+                # Older structural-only inputs may omit all activity timestamps;\n+                # they remain structural observations, not verified authority.\n+                if any(stamps[:2]):\n+                    issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n+                                   \"source_ref\": _source_ref(record), \"reason\": \"missing, invalid or inconsistent UTC cancellation chronology\"})\n+                    continue\n             process[\"state\"] = \"confirmed\"\n             process[\"next_action\"] = None\n         else:\n@@ -254,6 +269,8 @@ def reduce_cancellation_activities(records: list[dict[str, Any]]) -> dict[str, A\n             \"event_id\": event_id, \"action\": action,\n             \"arrival_batch\": values.get(\"Arrival batch\"),\n             \"effective_time\": values.get(\"Effective time (UTC)\"),\n+            \"activity_time_utc\": values.get(\"Activity time (UTC)\"),\n+            \"actor\": values.get(\"Acting employee or supervisor\"),\n             \"source_ref\": _source_ref(record),\n         })\n         id_lookup[str(event_id)] = (str(cancellation_id), record)\ndiff --git a/tests/test_readiness.py b/tests/test_readiness.py\nindex fe3e903..2f4c9a1 100644\n--- a/tests/test_readiness.py\n+++ b/tests/test_readiness.py\n@@ -197,3 +197,13 @@ def test_cli_failed_validation_still_writes_both_readiness_reports(tmp_path):\n     assert main([\"validate-readiness\", str(run), \"--repo\", str(tmp_path), \"--output-dir\", str(output)]) == 1\n     assert json.loads((output / \"readiness.json\").read_text())[\"status\"] == \"FAIL\"\n     assert \"**FAIL**\" in (output / \"readiness.md\").read_text()\n+\n+\n+def test_readiness_detects_tampered_executed_correction_verification(tmp_path):\n+    run = _run(tmp_path, complete=True)\n+    path = run / 'correction-cancellation-verification.json'\n+    value = json.loads(path.read_text())\n+    value['fresh_native_reads_performed'] = True\n+    path.write_text(json.dumps(value))\n+    result = validate_readiness(run, schema_path=SCHEMA, repo_dir=_repo(tmp_path))\n+    assert _checks(result)['correction-cancellation-traceability'] == 'FAIL'\n\"\"\"Executed correction checks, with immutable evidence and monetary history.\"\"\"\nfrom copy import deepcopy\n\nfrom .ordinary import expense_lines, fields, ref\n\n\ndef correction_changes(before, after):\n    \"\"\"Compare actual claim facts, including evidence changes with unchanged totals.\"\"\"\n    old, new = fields(before), fields(after)\n    changes = {key: {'before': old.get(key), 'after': new.get(key)}\n               for key in sorted(set(old) | set(new))\n               if old.get(key) != new.get(key) and key not in {'Revision', 'Arrival batch'}}\n    previous = {line['cost_id']: line for line in expense_lines(before)}\n    current = {line['cost_id']: line for line in expense_lines(after)}\n    # Source references change with the revision even when the line facts do not.\n    def facts(line):\n        return {k: v for k, v in line.items() if k != 'source_refs'} if line else None\n    lines = [{'cost_id': key, 'before': facts(previous.get(key)), 'after': facts(current.get(key)),\n              'changed': facts(previous.get(key)) != facts(current.get(key))}\n             for key in sorted(set(previous) | set(current))]\n    return {'fields': changes, 'expense_lines': lines,\n            'unchanged_cost_ids': [line['cost_id'] for line in lines if not line['changed']],\n            'source_refs': [ref(before), ref(after)]}\n\n\ndef record_executed_rechecks(domain, previous_domain, *, batch_id):\n    \"\"\"Called after connect_claim and Finance reconciliation actually execute.\"\"\"\n    for correction in domain['material_corrections']:\n        claim_id = correction['claim_id']\n        workflow = domain['ordinary_workflows'][claim_id]\n        if workflow['revision'] != correction['to_revision']:\n            continue\n        if correction['arrival_batch'] == batch_id:\n            revisions = domain['revision_history']['claim'][claim_id]['revisions']\n            before = next(r['record'] for r in revisions if r['revision'] == correction['from_revision'])\n            after = next(r['record'] for r in reversed(revisions) if r['revision'] == correction['to_revision'])\n            correction['changed_dependencies'] = correction_changes(before, after)\n            old = previous_domain.get('ordinary_workflows', {}).get(claim_id)\n            correction['before_workflow'] = deepcopy(old)\n            correction['before_finance'] = deepcopy(previous_domain.get('finance_reconciliations', {}).get(claim_id))\n        correction.setdefault('executed_rechecks', []).append({\n            'batch_id': batch_id, 'revision': workflow['revision'],\n            'checks': deepcopy(workflow['stages']),\n            'lines': deepcopy(workflow['lines']),\n            'observed_reviews': deepcopy(workflow['observed_reviews']),\n            'request': deepcopy(workflow['request']),\n            'finance': deepcopy(domain['finance_reconciliations'][claim_id]),\n            'status': workflow['status'],\n            'basis': 'Current-revision ordinary evidence, approval, request and Finance checks executed; no human response created',\n        })\n\n\ndef verification_document(domain, cancellations, *, run_id):\n    data = {'run_id': run_id, 'mode': 'offline-replay', 'fresh_native_reads_performed': False,\n            'corrections': deepcopy(domain['material_corrections']),\n            'cancellations': deepcopy(cancellations),\n            'cancellation_evidence': deepcopy(domain.get('cancellation_evidence', {})),\n            'cancellation_issues': deepcopy(domain['cancellation_state']['issues'])}\n    lines = ['# Correction and cancellation verification — OFFLINE REPLAY', '',\n             'Retained evidence only. No fresh source execution, approvals, requests or payments generated.',\n             'PASS means the stated local evidence check passed; BLOCKED requires the named evidence or authority.', '',\n             '## Executed correction rechecks', '']\n    for correction in data['corrections']:\n        latest = correction['executed_rechecks'][-1]\n        lines += [f\"### {correction['claim_id']} r{correction['from_revision']} → r{correction['to_revision']}\", '',\n                  f\"Arrival: {correction['arrival_batch']}. Changed facts: `{correction['changed_dependencies']}`\", '',\n                  f\"Historical reviews excluded from current authority: {', '.join(correction['invalidated_decision_ids']) or 'none observed'}.\", '',\n                  '| Executed check | Result | Next action |', '|---|---|---|']\n        for check in latest['checks']:\n            lines.append(f\"| {check['stage']} | {check['status']} | {check['owner']}: {check['next_action']} |\")\n        lines += ['', 'Executed check evidence:', '']\n        for check in latest['checks']:\n            lines.append(f\"- {check['stage']}: {'; '.join(check['source_refs'])}\")\n        old = correction.get('before_finance') or {}\n        new = latest['finance']\n        lines += ['', f\"Known net cash cents: {old.get('net_confirmed_cents')} → {new['net_confirmed_cents']}; \"\n                  f\"recorded ledger difference cents: {old.get('recorded_ledger_balance_cents')} → {new['recorded_ledger_balance_cents']}. \"\n                  'Recorded ledger agreement does not prove current entitlement or closure.', '']\n    lines += ['## Independent cancellation processes', '']\n    for cancellation in cancellations:\n        detail = data['cancellation_evidence'][cancellation['cancellation_id']]\n        lines += [f\"### {cancellation['cancellation_id']} — {cancellation['target_type']}\", '',\n                  f\"State history: {' → '.join(h['action'] for h in detail['history'])}. \"\n                  f\"Current linked claims: {detail['current_claim_ids']}; historical linked claims: {cancellation['affected_claim_ids']}. \"\n                  f\"Observed request IDs: {cancellation['original_request_ids']}.\", '',\n                  f\"Actor verification: {detail['actor_status']}. Finance disposition: {detail['disposition_status']}. \"\n                  f\"Financial completion: {cancellation['financial_status']}; next owner: Finance.\", '',\n                  f\"Source references: {'; '.join(detail['source_refs'])}\", '',\n                  f\"Recorded dispositions (not full claim closure): `{detail['dispositions']}`\", '']\n    lines += ['## Remaining external blockers', '',\n              'The native Notion policy remains inaccessible and the authoritative case clock remains unconfirmed. '\n              'Policy eligibility, current authorization and final closure remain pending where unsupported. '\n              'A cancelled transfer is a noncash event; only confirmed payments and linked refunds affect cash.', '']\n    return data, '\\n'.join(lines)\n\"\"\"Correction execution and independent cancellation regression evidence.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_ordinary import synthetic, batches, workflow, stages\nfrom test_retained_finance import _fixture, _batches\nfrom travel_claim.revalidation import correction_changes, verification_document\nfrom travel_claim.workflow import reduce_cancellation_activities\n\n\ndef corrected(parsed, *, receipt=None, amount=None):\n    record = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in record['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    record['locator'] = 'SYNTHETIC Step157 correction'\n    if receipt: record['text'] = record['text'].replace('R-COST-01', receipt)\n    if amount: record['text'] = record['text'].replace('100.00', amount)\n    parsed['records']['claim_revisions'].append(record)\n    return record\n\n\n@pytest.mark.parametrize('change', ['unchanged', 'receipt', 'amount'])\ndef test_executed_rechecks_reject_stale_approvals_and_requests_and_preserve_cash(change):\n    parsed = synthetic()\n    record = corrected(parsed, receipt='SYN-MISSING-RECEIPT' if change == 'receipt' else None,\n                       amount='120.00' if change == 'amount' else None)\n    before, paid, revised, final = batches(parsed)\n    correction = final['domain']['material_corrections'][0]\n    assert correction['before_workflow']['status'] == 'closed-reimbursed'\n    assert correction['before_finance']['net_confirmed_cents'] == 10000\n    assert len(correction['executed_rechecks']) == 2\n    checks = {s['stage']: s for s in correction['executed_rechecks'][0]['checks']}\n    assert checks['required_approvals']['status'] == 'BLOCKED'\n    assert checks['request_obligation']['status'] == 'BLOCKED'\n    assert checks['supporting_evidence']['status'] == ('PASS' if change == 'unchanged' else 'BLOCKED')\n    assert final['finance_reconciliations']['SYN-C01']['net_confirmed_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert workflow(paid)['status'] == 'closed-reimbursed'\n    changes = correction_changes(parsed['records']['claim_revisions'][0], record)\n    assert changes['expense_lines'][0]['changed'] == (change != 'unchanged')\n    assert all(c['source_refs'] for c in checks.values())\n\n\ndef test_retained_correction_moves_trip_but_keeps_historical_cancellation_and_non_cash_event():\n    results = _batches(_fixture()); final = results[-1]\n    c18 = next(c for c in final['domain']['material_corrections'] if c['claim_id'] == 'C18')\n    assert c18['changed_dependencies']['fields']['Trip reference'] == {'before': 'T18', 'after': 'T18B'}\n    detail = final['domain']['cancellation_evidence']['TC018']\n    assert detail['current_claim_ids'] == []\n    cancellation = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC018')\n    assert cancellation['affected_claim_ids'] == ['C18']\n    assert cancellation['original_request_ids'] == ['REQ-C18']\n    finance = final['finance_reconciliations']['C18']\n    assert finance['net_confirmed_cents'] == 10000\n    assert any(e['event_id'] == 'F-C18-2' and e['classification'] == 'finance_cancelled' for e in finance['event_history'])\n    assert final['finance_reconciliations']['C01']['net_confirmed_cents'] == 10000\n    assert not any(c['claim_id'] == 'C01' for c in final['domain']['material_corrections'])\n\n\ndef test_no_claim_cancellation_and_duplicate_confirmation_keep_independent_history():\n    final = _batches(_fixture())[-1]\n    cancel = next(c for c in final['snapshot']['travel_cancellations'] if c['cancellation_id'] == 'TC122')\n    assert cancel['status'] == 'confirmed' and cancel['affected_claim_ids'] == []\n    assert cancel['original_request_ids'] == [] and cancel['financial_status'] == 'unresolved'\n    assert cancel['admitted_cancellation_event_ids'] == ['TC122-requested', 'TC122-confirmed']\n    history = final['domain']['cancellation_evidence']['TC122']['history']\n    assert [h['arrival_batch'] for h in history] == [1, 2]\n    assert history[0]['actor'] == 'EMP-01'\n    assert \"row 7\" in cancel['source_refs'][1]  # first delivery, not batch-4 redelivery\n\n\n@pytest.mark.parametrize('fault', ['orphan', 'missing-effective', 'bad-time', 'no-claim-permit'])\ndef test_partial_and_independent_permit_cancellation(fault):\n    parsed = _fixture()\n    rows = [r for r in parsed['records']['cancellation_activities']\n            if r['values']['Cancellation reference']['value'] == 'TC121']\n    parsed['records']['cancellation_activities'] = rows\n    if fault == 'orphan': parsed['records']['cancellation_activities'] = rows[1:]\n    elif fault == 'missing-effective': rows[1]['values'].pop('Effective time (UTC)', None)\n    elif fault == 'bad-time': rows[1]['values']['Activity time (UTC)']['value'] = '2026-09-01T00:00:00'\n    else:\n        parsed['records']['claim_revisions'] = []\n        parsed['records']['finance_events'] = []\n    final = _batches(parsed)[-1]\n    process = final['domain']['cancellation_state']['processes']['TC121']\n    if fault == 'no-claim-permit':\n        assert process['state'] == 'confirmed'\n        cancel = final['snapshot']['travel_cancellations'][0]\n        assert cancel['target_type'] == 'permit' and cancel['affected_claim_ids'] == []\n    else:\n        assert process['state'] != 'confirmed'\n        assert any(k.startswith('cancellation-evidence:') for k in final['domain']['repair_queue']['items'])\n\n\ndef test_verification_is_derived_from_executed_checks_and_labeled_offline():\n    parsed = synthetic(); corrected(parsed)\n    final = batches(parsed)[-1]\n    data, summary = verification_document(final['domain'], final['snapshot']['travel_cancellations'], run_id='test')\n    assert data['fresh_native_reads_performed'] is False\n    assert 'OFFLINE REPLAY' in summary and 'required_approvals | BLOCKED' in summary\n    assert 'SYNTHETIC Step157 correction' in summary\n    assert data['corrections'][0]['executed_rechecks']\n\n\ndef test_retained_dispositions_are_exact_revision_bound_observations_not_closure():\n    final = _batches(_fixture())[-1]\n    for cancellation_id, claim, revision, amount, page in (\n            ('TC121', 'C121', 2, '20.00', 'PDF page 6'),\n            ('TC019', 'C19', 3, '80.00', 'PDF page 7')):\n        detail = final['domain']['cancellation_evidence'][cancellation_id]\n        disposition, = detail['dispositions']\n        assert (disposition['claim_id'], disposition['revision'], disposition['allowed_original_amount']) == (claim, revision, amount)\n        assert disposition['source_ref'].endswith(page)\n        assert final['domain']['ordinary_workflows'][claim]['status'] == 'pending'\n        item = final['domain']['repair_queue']['items'][f'cancellation-financial:{cancellation_id}']\n        assert item['status'] == 'open'\n        assert 'disposition recorded' in item['missing_or_return_reason']\n    assert final['finance_reconciliations']['C19']['net_confirmed_cents'] == 8000\n    assert final['finance_reconciliations']['C121']['net_confirmed_cents'] == 2000\n"},"started_at_ms":1792010361649,"completed_at_ms":1792010361679}}
