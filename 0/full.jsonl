ROLE_FIELDS)\n    86\t                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n    87\t                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n    88\t                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n    89\t                        and isinstance(policy.get('Domestic permit required'), bool))\n    90\t    policy_refs = [ref(policy_record)] if policy_record else []\n    91\t    affected = [c for c in cancellations if claim_id in c['affected_claim_ids']]\n    92\t    permission = False\n    93\t    permission_refs = [ref(r) for r in trips] + policy_refs\n    94\t    if linked and policy_supported:\n    95\t        if trip.get('International') is False and policy.get('Domestic permit required') is False:\n    96\t            permission = True\n    97\t        else:\n    98\t            # UTC timing must be expressly supplied; local calendar dates do\n    99\t            # not establish an exact commitment instant.\n   100\t            permit_roles = policy.get('Required permit roles')\n   101\t            commitment = trip.get('First commitment time (UTC)')\n   102\t            relevant = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n   103\t                        and fields(r).get('Subject reference') == trip.get('Permit reference')\n   104\t                        and fields(r).get('Revision') == trip.get('Permit revision')]\n   105\t            permission_refs += [ref(r) for r in relevant]\n   106\t            try:\n   107\t                stamp = lambda text: datetime.fromisoformat(text.replace('Z', '+00:00'))\n   108\t                commit = stamp(commitment)\n   109\t                permission = bool(trip.get('Permit reference') and permit_roles and set(permit_roles) <= set(ROLE_FIELDS)\n   110\t                                  and commit.utcoffset() is not None)\n   111\t                for role in permit_roles or []:\n   112\t                    matching = [fields(r) for r in relevant if fields(r).get('Review roles') == role]\n   113\t                    permission = permission and len(matching) == 1 and matching[0].get('Outcome') == 'approve'\n   114\t                    if permission:\n   115\t                        permission = (matching[0].get('Reviewer') == person.get(ROLE_FIELDS[role])\n   116\t                                      and matching[0].get('Reviewer') != employee\n   117\t                                      and stamp(matching[0].get('Decision time (UTC)')).utcoffset() is not None\n   118\t                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n   119\t            except (ValueError, TypeError, AttributeError):\n   120\t                permission = False\n   121\t    stage('travel_permission', permission, permission_refs,\n   122\t          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n   123\t          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n   124\t\n   125\t    lines = expense_lines(record)\n   126\t    receipts = parsed.get('records', {}).get('receipts', [])\n   127\t    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n   128\t    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines)\n   129\t    for line in lines:\n   130\t        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n   131\t        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n   132\t        # Stable merchant transaction identity: duplicates are not extra proof\n   133\t        # or additional money; conflicting payloads cannot pass validation.\n   134\t        unique = {}; conflict = False\n   135\t        for row in ms:\n   136\t            mv = fields(row); identity = mv.get('Transaction reference')\n   137\t            if not identity or identity in unique and fields(unique[identity]) != mv:\n   138\t                conflict = True\n   139\t            unique[identity] = row\n   140\t        ms = list(unique.values())\n   141\t        rv = fields(rs[0]) if len(rs) == 1 else {}\n   142\t        receipt_ok = (len(rs) == 1 and rv.get('Expense reference') == line['cost_id']\n   143\t                      and rv.get('Employee') == employee and rv.get('Trip reference') == trip_id\n   144\t                      and rv.get('Currency') == line['currency'] and _cents(rv.get('Gross amount')) == line['original_cents'])\n   145\t        merchant_ok = bool(ms) and not conflict and all(\n   146\t            fields(m).get('Employee ID') == employee and fields(m).get('Trip reference') == trip_id\n   147\t            and fields(m).get('Receipt reference') == line['receipt_id']\n   148\t            and fields(m).get('Currency') == line['currency'] and fields(m).get('Payment status') == 'settled'\n   149\t            and _cents(fields(m).get('Gross amount')) is not None and fields(m).get('Paid date') for m in ms)\n   150\t        merchant_ok = merchant_ok and sum(_cents(fields(m)['Gross amount']) for m in ms) == line['original_cents']\n   151\t        line.update(evidence_status='PASS' if receipt_ok and merchant_ok else 'BLOCKED',\n   152\t                    category=rv.get('Category'), documented_units=rv.get('Documented units'),\n   153\t                    paid_dates=sorted({str(fields(m).get('Paid date'))[:10] for m in ms}),\n   154\t                    allowed_cents=None, status='unresolved',\n   155\t                    reason='Evidence matched; policy eligibility remains separate' if receipt_ok and merchant_ok else 'Receipt or settled merchant proof is missing, conflicting or mismatched')\n   156\t        line['source_refs'] += [ref(r) for r in rs + ms]\n   157\t        evidence_ok = evidence_ok and receipt_ok and merchant_ok\n   158\t    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n   159\t    stage('supporting_evidence', evidence_ok, evidence_refs,\n   160\t          'Current revision expense IDs, receipts, settled merchant transactions, identities, currencies and amounts',\n   161\t          employee or 'Employee', 'Supply matching receipts and settled merchant proof for each current-revision expense line')\n   162\t\n   163\t    policy_ok = policy_supported and evidence_ok and linked and permission\n   164\t    rates = table(parsed, 'fx_rates', 'FX'); caps = table(parsed, 'caps', 'Caps')\n   165\t    for line in lines:\n   166\t        if not policy_ok:\n   167\t            break\n   168\t        if line['category'] not in policy['Eligible categories'] or len(line['paid_dates']) != 1:\n   169\t            policy_ok = False; break\n   170\t        date = line['paid_dates'][0]; original = line['original_cents']\n   171\t        if line['category'] not in policy['Uncapped categories']:\n   172\t            cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n   173\t                  and fields(c).get('Category') == line['category'] and fields(c).get('Currency') == line['currency']\n   174\t                  and str(fields(c).get('Effective from'))[:10] <= date <= str(fields(c).get('Effective to'))[:10]]\n   175\t            try:\n   176\t                units = Decimal(str(line['documented_units']))\n   177\t                limit = _cents(fields(cs[0]).get('Amount per unit')) if len(cs) == 1 else None\n   178\t                total_limit = units * limit if limit is not None else None\n   179\t                if not units.is_finite() or units <= 0 or total_limit is None or total_limit != total_limit.to_integral_value():\n   180\t                    policy_ok = False; break\n   181\t                original = min(original, int(total_limit)); line['source_refs'] += [ref(cs[0])]\n   182\t            except (InvalidOperation, TypeError):\n   183\t                policy_ok = False; break\n   184\t        fx = [r for r in rates if fields(r).get('Currency') == line['currency'] and str(fields(r).get('Rate date'))[:10] == date]\n   185\t        try:\n   186\t            rate = Decimal(str(fields(fx[0]).get('EUR per currency unit'))) if len(fx) == 1 else None\n   187\t            converted = Decimal(original) * rate if rate is not None else None\n   188\t            if rate is None or not rate.is_finite() or rate <= 0 or converted != converted.to_integral_value():\n   189\t                policy_ok = False; break\n   190\t            line['allowed_cents'] = int(converted); line['status'] = 'supported'\n   191\t            line['source_refs'] += [ref(fx[0])]\n   192\t        except (InvalidOperation, TypeError):\n   193\t            policy_ok = False; break\n   194\t    if not policy_ok:\n   195\t        for line in lines:\n   196\t            line.update(allowed_cents=None, status='unresolved')\n   197\t    allowed = sum(line['allowed_cents'] for line in lines) if policy_ok else None\n   198\t    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n   199\t          'Eligibility and exact-cent entitlement require a verified source-backed rule definition; interview summaries and Finance acceptance are insufficient',\n   200\t          lead, 'Obtain complete native policy and a reviewed source-referenced rule definition; verify dates, FX, caps and exceptions')\n   201\t\n   202\t    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n   203\t               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n   204\t    unique_decisions = {}; decision_conflict = False\n   205\t    for decision in current:\n   206\t        identity = fields(decision).get('Decision reference')\n   207\t        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n   208\t        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n   209\t            decision_conflict = True\n   210\t        unique_decisions[identity] = (decision, payload)\n   211\t    current = [pair[0] for pair in unique_decisions.values()]\n   212\t    packets = table(parsed, 'review_packets', 'Review packets')\n   213\t    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n   214\t    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n   215\t    for decision in current:\n   216\t        dv = fields(decision)\n   217\t        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n   218\t        pv = fields(ps[0]) if len(ps) == 1 else {}\n   219\t        roles = str(dv.get('Review roles') or '').splitlines()\n   220\t        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n   221\t                 and pv.get('Trip revision') == claim.get('trip_revision')\n   222\t                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n   223\t                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n   224\t                 and bool(pv.get('Policy revision')) and bool(str(pv.get('Budget record references') or '').splitlines())\n   225\t                 and set(str(pv.get('Budget record references') or '').splitlines()) <= budget_ids\n   226\t                 and roles and all(role in ROLE_FIELDS and dv.get('Reviewer') == person.get(ROLE_FIELDS[role])\n   227\t                                   and dv.get('Reviewer') != employee for role in roles))\n   228\t        if policy_record:\n   229\t            valid = valid and pv.get('Policy revision') == policy.get('Policy revision')\n   230\t        observed.append(dict(decision_id=dv.get('Decision reference'), outcome=dv.get('Outcome'), roles=roles,\n   231\t                             evidence_valid=bool(valid), source_refs=[ref(decision)] + [ref(p) for p in ps]))\n   232\t        reviews_ok = reviews_ok and valid\n   233\t    review_refs = [r for d in observed for r in d['source_refs']] + [ref(p) for p in people]\n   234\t    stage('review_evidence', reviews_ok, review_refs, 'Observed current-revision human decisions matched to reviewers and preserved review packets; completeness is checked separately',\n   235\t          lead, 'Provide exact-revision decisions and packets matching the employee, trip, expense list, policy and budget references')\n   236\t    required = policy.get('Required claim roles', []) if policy_supported else []\n   237\t    if policy_supported and policy.get('Director threshold cents') is not None:\n   238\t        threshold = policy['Director threshold cents']\n   239\t        if isinstance(threshold, int) and not isinstance(threshold, bool) and threshold >= 0 and allowed is not None:\n   240\t            required = list(required) + (['director'] if allowed > threshold else [])\n   241\t        else:\n   242\t            reviews_ok = False\n   243\t    approvals = reviews_ok and policy_supported and all(\n   244\t        len([d for d in observed if role in d['roles'] and d['outcome'] == 'approve']) == 1\n   245\t        and all(d['outcome'] == 'approve' for d in observed if role in d['roles']) for role in required)\n   246\t    stage('required_approvals', approvals, review_refs + policy_refs,\n   247\t          'All policy-required roles must have matching current-revision approvals; no decisions are created',\n   248\t          lead, 'Confirm policy-required review roles and obtain their current-revision human approvals')\n   249\t\n   250\t    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\n   251\t                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n   252\t    request = fields(requests[0]) if len(requests) == 1 else {}\n   253\t    obligation = finance.get('recorded_obligation')\n   254\t    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid']}\n   255\t    request_ok = bool(linked and permission and policy_ok and approvals and obligation and len(requests) == 1\n   256\t                      and request.get('Request reference') == obligation['request_id']\n   257\t                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\n   258\t                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['a…263 tokens truncated…urrent_revision=revision,\n   269\t            revision_history=finance['revision_history'], previous_reconciliation=prior_finance,\n   270\t            authorized_obligation=authorization, source_classifications=source_classifications)\n   271\t    reconciled = finance.get('recorded_ledger_balance_cents') is not None and not finance['unresolved_event_ids'] and not finance['conflicting_events']\n   272\t    stage('financial_reconciliation', reconciled,\n   273\t          [ref(e) for e in finance_events if fields(e).get('Claim reference') == claim_id],\n   274\t          f\"Confirmed net cash {finance['net_confirmed_cents']} cents; recorded ledger difference {finance.get('recorded_ledger_balance_cents')}; authorized balance {finance['balance_cents']}\",\n   275\t          finance_owner, 'Resolve missing obligations, conflicting or unclassified events, request/payee links and outstanding balances')\n   276\t\n   277\t    authorities = [r for r in table(parsed, 'closure_authorities', 'Closure authorities') if trusted(r) and visible(r)\n   278\t                   and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n   279\t    clock_ok = False\n   280\t    try:\n   281\t        clock_ok = datetime.fromisoformat(parsed['case_clock'].replace('Z', '+00:00')).utcoffset() is not None\n   282\t    except (KeyError, ValueError, TypeError, AttributeError):\n   283\t        pass\n   284\t    closure_authority = (len(authorities) == 1 and fields(authorities[0]).get('Confirmation') == 'financial-completion-conditions'\n   285\t                         and bool(fields(authorities[0]).get('Authority')) and fields(authorities[0]).get('Case clock') == parsed.get('case_clock'))\n   286\t    external = [i for i in parsed.get('unresolved_issues', []) if i.get('status', 'open') == 'open'\n   287\t                and (i.get('subject_type') in {'policy', 'scenario'} or i.get('subject_id') in {claim_id, trip_id, trip.get('Permit reference')})]\n   288\t    control_events = [e for e in finance['event_history'] if e['classification'] in {\n   289\t        'failed_transfer', 'retry_authorization', 'finance_cancellation_requested', 'finance_cancelled'}]\n   290\t    resolved_controls = set()\n   291\t    def event_stamp(event):\n   292\t        stamp = datetime.fromisoformat(event['source_record']['Activity time (UTC)'].replace('Z', '+00:00'))\n   293\t        return stamp.replace(tzinfo=timezone.utc) if stamp.utcoffset() is None else stamp\n   294\t    for event in finance['event_history']:\n   295\t        value = event['source_record']\n   296\t        if (event['classification'] == 'finance_resolution' and value.get('Claim revision') == revision\n   297\t                and obligation and value.get('Request reference') == obligation['request_id']\n   298\t                and value.get('Finance officer') == finance_owner):\n   299\t            named = set(str(value.get('Resolved activity references') or '').splitlines())\n   300\t            for control in control_events:\n   301\t                try:\n   302\t                    if (control['event_id'] in named\n   303\t                            and control['source_record'].get('Request reference') == value['Request reference']\n   304\t                            and event_stamp(event) >= event_stamp(control)):\n   305\t                        resolved_controls.add(control['event_id'])\n   306\t                except (KeyError, ValueError, TypeError, AttributeError):\n   307\t                    pass\n   308\t    controls_clear = not finance['pending_transfer_event_ids'] and all(e['event_id'] in resolved_controls for e in control_events)\n   309\t    cancellation_refs = [source for c in affected for source in c.get(\"source_refs\", [])]\n   310\t    stage('cancellation_readiness', not affected, cancellation_refs,\n   311\t          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\n   312\t          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\n   313\t    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\n   314\t              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\n   315\t    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\n   316\t          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\n   317\t          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\n   318\t    pending = next((s for s in stages if s['status'] != 'PASS'), None)\n   319\t    return dict(claim_id=claim_id, revision=revision