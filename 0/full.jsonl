 baseline remain unchanged**, including retained artifacts and protected financial modules. The original historical 129-file manifest is unavailable; a fresh comparison against it cannot be claimed.\n\nLegacy closure, cancellation-resolution, and reporting defects identified in Step 183 remain outside this milestone. Native Notion access also remains unresolved.\n\nNothing staged, committed, or pushed. HEAD remains `791c8c787bbd617a7b7d3114f13c000249169151`.","type":"output_text"}],"guardian_metadata":{"client_authored":false,"user_input_order":254},"id":"msg_02f4b2bd528e1b90016ad0b263b4c88190b81aa016593106bb","internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"],"create_time":1792062051.7215664,"turn_id":"01a13f30-dcaa-7053-8391-0211a28144b2"},"phase":"final_answer","role":"assistant","type":"message"},{"content":[{"text":"Project D — Step 185: Verify, commit, and push the Step 184 evidence-admission milestone.\n\nStarting from HEAD 791c8c787bbd617a7b7d3114f13c000249169151:\n\nVerify the current branch, HEAD, Git status, and complete diff.\n\nConfirm implementation changes are limited to the seven reviewed Step 184 files.\n\nRerun the full automated test suite and Git diff checks.\n\nVerify all 132 files in the Step 184 start baseline remain unchanged. Report explicitly that the original historical 129-file manifest is unavailable.\n\nStage only:\n\nREADME.md\n\nsrc/travel_claim/approvals.py\n\nsrc/travel_claim/expenses.py\n\ntests/test_approvals.py\n\ntests/test_evidence_admission.py\n\ntests/test_exceptions.py\n\ntests/test_expenses.py\n\nVerify the staged diff contains exactly these seven files.\n\nCommit with message: fix: enforce source-bound expenses and reviewer clock admission\n\nPush normally to origin main without force-pushing, using the existing Entire.io hooks.\n\nVerify remote main matches the local commit and all Entire.io checkpoint references match remotely.\n\nDo not stage unrelated audit reports, previous run artifacts, or user-provided policy provenance files.\n\nReport the full commit SHA, final passing test count, exact committed files, preservation status, and Entire.io checkpoint verification.\n\nIf any verification fails, stop and explain the issue.","type":"input_text"}],"guardian_metadata":{"client_authored":false,"mcp_attribution":{"status":"none"},"user_input_order":255},"id":"msg_01a13f43-fe25-7723-99a9-060a14129ffa","internal_chat_message_metadata_passthrough":{"content_item_kinds":["user.text"],"create_time":1792062783.0138535,"turn_id":"01a13f43-f677-78c3-a142-cfd7413b6562"},"role":"user","type":"message"},{"content":[{"text":"I’ll verify the seven-file diff, rerun the full test suite, and check the 132-file baseline before staging. If all checks pass, I’ll commit and push through the existing Entire.io hooks, then verify remote main and every checkpoint reference.","type":"output_text"}],"guardian_metadata":{"client_authored":false,"user_input_order":256},"id":"msg_02f4b2bd528e1b90016ad0b5409df88190b328ff1cae6a7c0b","internal_chat_message_metadata_passthrough":{"content_item_kinds":["unknown"],"create_time":1792062784.6247468,"turn_id":"01a13f43-f677-78c3-a142-cfd7413b6562"},"phase":"commentary","role":"assistant","type":"message"},{"call_id":"call_4b60dd9959f8478eafde70d63ce4ada0","id":"ctc_02f4b2bd528e1b90016ad0b5418f808190a272e9b90811b9b4","input":"text(await tools.exec_command({cmd:\"git branch --show-current; git rev-parse HEAD; git status --short; git diff --cached --stat; git diff --stat; git diff -- README.md src/travel_claim/approvals.py src/travel_claim/expenses.py tests/test_approvals.py tests/test_exceptions.py tests/test_expenses.py; cat tests/test_evidence_admission.py\",\"max_output_tokens\":11000}));\ntext(await tools.exec_command({cmd:\"python3 - \u003c\u003c'PY'\\nfrom pathlib import Path\\nimport hashlib,json,subprocess\\nassert subprocess.check_output(['git','branch','--show-current'],text=True).strip()=='main'\\nassert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()=='791c8c787bbd617a7b7d3114f13c000249169151'\\nexpected=set('README.md src/travel_claim/approvals.py src/travel_claim/expenses.py tests/test_approvals.py tests/test_exceptions.py tests/test_expenses.py'.split())\\nassert set(subprocess.check_output(['git','diff','HEAD','--name-only'],text=True).splitlines())==expected\\nassert not subprocess.check_output(['git','diff','--cached','--name-only'],text=True).strip()\\nb=json.load(open('/tmp/step184-start-hashes.json'));assert len(b)==132\\nbad=[p for p,h in b.items() if not Path(p).is_file() or hashlib.sha256(Path(p).read_bytes()).hexdigest()!=h]\\nassert not bad,bad\\nassert not Path('/tmp/step179-hashes.json').exists()\\nsubprocess.run(['git','diff','--check'],check=True)\\nr=subprocess.run(['git','diff','--no-index','--check','/dev/null','tests/test_evidence_admission.py'],capture_output=True,text=True)\\nassert r.returncode in (0,1) and not r.stdout and not r.stderr\\nprint('132/132 baseline hashes match; original historical 129-file manifest unavailable; branch/HEAD/scope/staging/diff checks PASS')\\nPY\",\"max_output_tokens\":1000}));\ntext(await tools.exec_command({cmd:\"PYTHONDONTWRITEBYTECODE=1 .venv/bin/pytest -q -p no:cacheprovider\",\"yield_time_ms\":1000,\"max_output_tokens\":1000}));\n","internal_chat_message_metadata_passthrough":{"create_time":1792062785.564056,"turn_id":"01a13f43-f677-78c3-a142-cfd7413b6562"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_4b60dd9959f8478eafde70d63ce4ada0","guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000},"id":"ctco_01a13f44-3844-74e0-895f-5ffa7cfb993a","internal_chat_message_metadata_passthrough":{"create_time":1792062797.8927033,"turn_id":"01a13f43-f677-78c3-a142-cfd7413b6562"},"output":[{"text":"Script completed\nWall time 3.0 seconds\nOutput:\n","type":"input_text"},{"text":"{\"chunk_id\":\"2af0a6\",\"wall_time_seconds\":0.031211917,\"exit_code\":0,\"original_token_count\":6855,\"output\":\"main\\n791c8c787bbd617a7b7d3114f13c000249169151\\n M README.md\\n M src/travel_claim/approvals.py\\n M src/travel_claim/expenses.py\\n M tests/test_approvals.py\\n M tests/test_exceptions.py\\n M tests/test_expenses.py\\n?? artifacts/runs/\\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n?? artifacts/verification/project-d-step157-revalidation/\\n?? artifacts/verification/project-d-step167-audit-probes.json\\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\\n?? tests/test_evidence_admission.py\\n?? user-provided-sources/\\n README.md                     | 22 ++++++++++++++++\\n src/travel_claim/approvals.py |  4 +++\\n src/travel_claim/expenses.py  | 61 +++++++++++++++++++++++++++++++++++++++++--\\n tests/test_approvals.py       |  1 +\\n tests/test_exceptions.py      |  2 ++\\n tests/test_expenses.py        |  7 +++++\\n 6 files changed, 95 insertions(+), 2 deletions(-)\\ndiff --git a/README.md b/README.md\\nindex 9b01d4e..c308f14 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -370,3 +370,25 @@ or schema gaps stay pending, even though expense/exception/review calculations\\n can now consume the explicitly supplied policy evidence. This command does not\\n create missing normalized business definitions, requests, approvals or closure\\n authority. Drafts remain unsent and require human review.\\n+\\n+## Step 184: expense-source and reviewer-clock admission\\n+\\n+Expense eligibility now requires well-formed source IDs, SHA-256 hashes and record\\n+locators bound to complete `read` observations. Claim, trip/directory, receipt,\\n+merchant payment, applicable cap/FX and reused filing-date evidence are checked\\n+before they can support an amount. Native page/row references must agree with\\n+retained page/cell metadata. Missing, partial, mismatched or unobserved bindings\\n+hold the affected work, retaining the evidence and its original references.\\n+Independent valid claims continue, and admitted Finance cash is preserved.\\n+\\n+Permit and claim replies use the existing event cutoff checks. An authoritative\\n+calendar date is interpreted in its supplied timezone; later local dates and\\n+ambiguous same-day observations cannot establish current review authority. An\\n+explicit supplied instant permits decisions at or before that instant. Missing\\n+clock authority holds review admission. Raw replies and rejection reasons stay\\n+visible, including exact replays; a valid earlier reply remains available when a\\n+separately identified later reply is inadmissible. No cutoff time is inferred.\\n+\\n+These checks do not change Finance event admission, budget accounting, exception\\n+coverage, cancellation resolution or financial closure rules. Passing source\\n+admission is not a new human approval or evidence of final submission compliance.\\ndiff --git a/src/travel_claim/approvals.py b/src/travel_claim/approvals.py\\nindex 032b68a..66eca93 100644\\n--- a/src/travel_claim/approvals.py\\n+++ b/src/travel_claim/approvals.py\\n@@ -7,6 +7,7 @@ import json\\n import re\\n from zoneinfo import ZoneInfo\\n \\n+from .event_validation import observation_error\\n from .exceptions import source_bound\\n from .expenses import policy_valid, local_date\\n from .workflow import _revision, row_values\\n@@ -126,6 +127,9 @@ def evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employe\\n             budget_refs=set(str(pv.get('Budget record references') or '').splitlines())\\n             if not budget_refs or not budget_refs\u003c=budget_ids: raise ValueError('Missing referenced budget records; no budget decision inferred')\\n             stamp=utc_time(dv.get('Decision time (UTC)'))\\n+            cutoff_error=observation_error(stamp, parsed.get('event_clock') or parsed.get('case_clock'))\\n+            if cutoff_error:\\n+                raise ValueError(f'Review case-clock admission: {cutoff_error}')\\n             payload={k:v for k,v in dv.items() if k!='Arrival batch'}\\n             if identity in identities and identities[identity][0]!=payload:\\n                 conflicts.add(identity)\\ndiff --git a/src/travel_claim/expenses.py b/src/travel_claim/expenses.py\\nindex 45ce148..d9bf9e2 100644\\n--- a/src/travel_claim/expenses.py\\n+++ b/src/travel_claim/expenses.py\\n@@ -8,10 +8,45 @@ from calendar import monthrange\\n from datetime import date\\n from decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\\n import hashlib\\n+import re\\n from pathlib import Path\\n \\n from .exceptions import validate_exception, apply_coverage, finding\\n \\n+\\n+class SourceEvidenceError(ValueError):\\n+    \\\"\\\"\\\"Retained values cannot establish eligibility without verified provenance.\\\"\\\"\\\"\\n+\\n+\\n+def require_expense_source(row, observations, label):\\n+    identity, digest, locator = (row.get(k) for k in ('source_id', 'source_sha256', 'locator'))\\n+    if (not isinstance(identity, str) or not identity.strip() or identity != identity.strip()\\n+            or any(c in identity for c in '@#')\\n+            or not isinstance(digest, str) or re.fullmatch(r'[0-9a-f]{64}', digest) is None\\n+            or not isinstance(locator, str) or not locator.strip() or locator != locator.strip()):\\n+        raise SourceEvidenceError(f'{label} source reference is missing or malformed')\\n+    matches = [o for o in observations if isinstance(o, dict) and o.get('source_id') == identity and o.get('sha256') == digest]\\n+    if not matches or any(o.get('status') != 'read' or o.get('missing_scope') != [] for o in matches):\\n+        raise SourceEvidenceError(f'{label} source hash is unobserved, mismatched or not fully verified')\\n+    # Native parsers retain page/row locators. Validate their format and any\\n+    # supplied page/cell metadata; a file hash cannot legitimize a broken locator.\\n+    for observation in matches:\\n+        path = str(observation.get('path') or '')\\n+        if path.endswith('.pdf'):\\n+            page = re.fullmatch(r'PDF page ([1-9][0-9]*)(?:, receipt [1-9][0-9]*)?', locator)\\n+            if not page or ('page' in row and row['page'] != int(page[1])):\\n+                raise SourceEvidenceError(f'{label} source page reference is invalid')\\n+        if path.endswith('.xlsx'):\\n+            location = re.fullmatch(r\\\"tab '([^']+)', row ([1-9][0-9]*)\\\", locator)\\n+            if not location:\\n+                raise SourceEvidenceError(f'{label} source workbook reference is invalid')\\n+            for value in row.get('values', {}).values():\\n+                cell = value.get('cell')\\n+                if cell and (not re.fullmatch(r'[A-Z]+[1-9][0-9]*', str(cell))\\n+                             or int(re.search(r'[0-9]+$', str(cell))[0]) != int(location[2])):\\n+                    raise SourceEvidenceError(f'{label} source cell does not match its row reference')\\n+\\n+\\n POLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\\n \\n \\n@@ -89,6 +124,22 @@ def evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history\\n         ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\\n         line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\\n         try:\\n+            require_expense_source(record, observations, 'Claim')\\n+            trips = [r for r in table(parsed, 'trips', 'Trips')\\n+                     if fields(r).get('Trip reference') == trip_id and fields(r) == trip]\\n+            if len(trips) != 1:\\n+                raise SourceEvidenceError('Trip source record does not match the supplied expense context')\\n+            line['source_refs'].append(ref(trips[0]))\\n+            require_expense_source(trips[0], observations, 'Trip')\\n+            directory = [r for r in people if fields(r).get('Employee ID') == employee]\\n+            if len(directory) != 1:\\n+                raise SourceEvidenceError('Employee directory source record is missing or ambiguous')\\n+            line['source_refs'].append(ref(directory[0]))\\n+            require_expense_source(directory[0], observations, 'Employee directory')\\n+            for receipt in rs:\\n+                require_expense_source(receipt, observations, 'Receipt')\\n+            for payment in ms:\\n+                require_expense_source(payment, observations, 'Merchant payment')\\n             gross = number(line['original_amount'])\\n             if not employee or not trip_id or gross \u003c= 0 or len(rs) != 1:\\n                 raise ValueError('Missing receipt or nonpositive purchase')\\n@@ -143,12 +194,13 @@ def evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history\\n                 cs = [c for c in cs if local_date(fields(c).get('Effective from')) \u003c= paid \u003c= local_date(fields(c).get('Effective to'))]\\n                 if len(cs) != 1:\\n                     raise ValueError('Missing or ambiguous applicable cap')\\n+                line['source_refs'].append(ref(cs[0]))\\n+                require_expense_source(cs[0], observations, 'Applicable cap')\\n                 cap = number(fields(cs[0]).get('Amount per unit'))\\n                 with localcontext() as ctx:\\n                     ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\\n                     allowed = min(gross, cap * units)\\n                 cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\\n-                line['source_refs'].append(ref(cs[0]))\\n             line['base_allowed_original_amount'] = str(allowed)\\n             deadline = filing_deadline(trip.get('End date'))\\n             submitted = local_date(line['first_submitted_date'])\\n@@ -161,8 +213,9 @@ def evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history\\n                     if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\\n                             and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\\n                             and number(old['original_amount']) == gross):\\n-                        submitted = local_date(old['first_submitted_date'])\\n                         line['source_refs'] += old['source_refs']\\n+                        require_expense_source(pr, observations, 'Prior submission')\\n+                        submitted = local_date(old['first_submitted_date'])\\n                         first_supported = True\\n                         break\\n                 if first_supported:\\n@@ -191,6 +244,8 @@ def evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history\\n                       and local_date(fields(r).get('Rate date')) == paid]\\n                 if len(fx) != 1:\\n                     raise ValueError('Missing or ambiguous payment-date Finance FX rate')\\n+                line['source_refs'].append(ref(fx[0]))\\n+                require_expense_source(fx[0], observations, 'Finance FX rate')\\n                 rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\\n                 if rate \u003c= 0:\\n                     raise ValueError('FX rate must be positive')\\n@@ -216,6 +271,8 @@ def evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history\\n             line.update(eligibility_status='PASS', status='supported',\\n                         reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\\n                         else 'Supported paid expense calculation and timely filing')\\n+        except SourceEvidenceError as exc:\\n+            line.update(evidence_status='BLOCKED', calculation_status='BLOCKED', calculated_cents=None, reason=str(exc))\\n         except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\\n             line['reason'] = str(exc)\\n     complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\\ndiff --git a/tests/test_approvals.py b/tests/test_approvals.py\\nindex 2ebc984..13b6b44 100644\\n--- a/tests/test_approvals.py\\n+++ b/tests/test_approvals.py\\n@@ -172,6 +172,7 @@ def test_actual_retained_claim_and_permit_packets_roles_and_outcomes():\\n     from travel_claim.expenses import load_expense_policy\\n     p=json.loads((Path(__file__).parent/'fixtures/retained_approval_records.json').read_text())\\n     p['expense_policy']=load_expense_policy(Path(__file__).parent/'fixtures/POL-2026.2-browser-copy.txt')\\n+    p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}  # verified policy line 3; no instant\\n     for claim,amount,expected in [('C01',10000,'approved'),('C02',54000,'approved'),('C09',8000,'returned'),\\n                                  ('C14',4000,'rejected'),('C21',8000,'returned'),('C46',4500,'approved')]:\\n         record=next(r for r in p['records']['claim_revisions'] if fields(r)['Claim reference']==claim and fields(r)['Revision']=='1')\\ndiff --git a/tests/test_exceptions.py b/tests/test_exceptions.py\\nindex 45d0b1d..dd4dbc8 100644\\n--- a/tests/test_exceptions.py\\n+++ b/tests/test_exceptions.py\\n@@ -86,6 +86,7 @@ def test_exact_coverage_is_independent_and_keeps_original_findings():\\n     context=[finding('late_permit','Originally late permit',['source#permit']),\\n              finding('permit_unapproved','Original missing approval',['source#approval'])]\\n     lines=expense_lines(record); trip['End date']='2026-06-01'\\n+    setfield(table(parsed,'trips','Trips')[0], 'End date', trip['End date'])\\n     result=evaluate_expenses(lines=lines,parsed=parsed,employee='EMP-01',trip_id='T01',trip=trip,record=record,\\n         history=[],fields=fields,ref=ref,table=table,eligibility_findings=context)\\n     findings={f['issue']:f for f in lines[0]['eligibility_findings']}\\n@@ -130,6 +131,7 @@ def test_replacement_uses_original_currency_then_exact_fx_rounding():\\n     setfield(parsed['records']['receipts'][0],'Currency','USD');setfield(merchant(parsed),'Currency','USD')\\n     parsed['records']['fx_rates']=[dict(source_id='synthetic-fx',source_sha256='a'*64,locator='FX',\\n         values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\\n+    parsed['source_observations'].append(dict(source_id='synthetic-fx',sha256='a'*64,status='read',missing_scope=[]))\\n     exception(record,amount='50.00')\\n     result,lines=evaluate(parsed,record,trip)\\n     assert result['calculated_cents']==4500 and lines[0]['exception']['currency']=='USD'\\ndiff --git a/tests/test_expenses.py b/tests/test_expenses.py\\nindex 4a5e972..98ce416 100644\\n--- a/tests/test_expenses.py\\n+++ b/tests/test_expenses.py\\n@@ -36,6 +36,10 @@ def setfield(row, key, value):\\n \\n \\n def evaluate(parsed, record, trip, history=()):\\n+    # Mutated dates in these synthetic probes belong to the bound trip record.\\n+    for key,value in trip.items():\\n+        bound_trip = table(parsed, 'trips', 'Trips')[0]\\n+        if fields(bound_trip).get(key) != value: setfield(bound_trip, key, value)\\n     lines = expense_lines(record)\\n     result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\\n         trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\\n@@ -74,6 +78,7 @@ def test_categories_and_caps(category, units, amount):\\n     parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\\n         values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\\n         'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\\n+    parsed['source_observations'].append(dict(source_id='synthetic-cap', sha256='a'*64, status='read', missing_scope=[]))\\n     result, lines = evaluate(parsed, record, trip)\\n     assert result['calculated_cents'] == amount\\n     if category in {'lodging','meals'}:\\n@@ -120,6 +125,7 @@ def test_exact_payment_date_fx_half_up(rate, expected):\\n     setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\\n     parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\\n         values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\\n+    parsed['source_observations'].append(dict(source_id='synthetic-fx', sha256='b'*64, status='read', missing_scope=[]))\\n     result, lines = evaluate(parsed, record, trip)\\n     assert result['calculated_cents'] == expected\\n     assert lines[0]['conversion']['eur_rate'] == rate\\n@@ -213,6 +219,7 @@ def test_round_each_line_then_sum_and_independent_missing_evidence():\\n     record['text'] += '\\\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\\\n'\\n     parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\\n         values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\\n+    parsed['source_observations'].append(dict(source_id='synthetic-fx', sha256='b'*64, status='read', missing_scope=[]))\\n     result, lines = evaluate(parsed,record,trip)\\n     assert result['calculated_cents'] == 18002\\n     assert [l['calculated_cents'] for l in lines] == [9001,9001]\\n\\\"\\\"\\\"Step 184: synthetic mutations of retained schemas, never real authority.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport pytest\\n\\nfrom test_expenses import setup, evaluate, merchant, setfield\\nfrom test_approvals import subject, check\\nfrom test_ordinary import synthetic, batches, workflow, stages\\nfrom travel_claim.policy_evidence import CLOCK\\n\\n\\n@pytest.mark.parametrize('kind', ['receipt','merchant','claim'])\\n@pytest.mark.parametrize('field,value', [('source_sha256',None),('source_sha256','0'*64),\\n    ('source_sha256','bad'),('source_id','unobserved-source'),('locator',None),('locator',' ')])\\ndef test_expense_evidence_needs_verified_source_reference(kind,field,value):\\n    p,r,t=setup()\\n    row={'receipt':p['records']['receipts'][0],'merchant':merchant(p),'claim':r}[kind]\\n    row[field]=value\\n    before=deepcopy(row)\\n    result,lines=evaluate(p,r,t)\\n    assert result['status']=='BLOCKED' and lines[0]['calculated_cents'] is None\\n    assert lines[0]['evidence_status']=='BLOCKED'\\n    assert row==before\\n    assert 'source' in lines[0]['reason'].lower()\\n\\n\\ndef test_step183_unbound_evidence_cannot_close_connected_workflow():\\n    p=synthetic()\\n    p['records']['receipts'][0]['source_sha256']='0'*64\\n    merchant(p)['source_sha256']='0'*64\\n    before=deepcopy(p)\\n    result=batches(p)[-1];w=workflow(result)\\n    assert w['status']=='pending' and w['allowed_cents'] is None and w['request'] is None\\n    assert stages(w)['supporting_evidence']['status']=='BLOCKED'\\n    assert result['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\\n    assert p==before\\n    assert any('0'*64 in r for r in w['lines'][0]['source_refs'])\\n\\n\\n@pytest.mark.parametrize('kind',['claim','permit'])\\n@pytest.mark.parametrize('stamp,approved', [('2026-11-14T22:59:59Z',True),\\n    ('2026-11-14T23:00:00Z',False),('2026-11-15T12:00:00Z',False),\\n    ('2026-11-15T23:00:00Z',False),('2027-01-01T12:00:00Z',False)])\\ndef test_reviews_use_policy_calendar_date_in_amsterdam(kind,stamp,approved):\\n    p,r,t=subject(kind);p['event_clock']=dict(CLOCK)\\n    decision=p['records']['decisions'][0]\\n    setfield(decision,'Decision time (UTC)',stamp)\\n    before=deepcopy(decision)\\n    result=check(p,r,t,kind=kind)\\n    assert result['approved']==approved\\n    delivery=next(d for d in result['deliveries'] if d['decision_id']==decision['values']['Decision reference']['value'])\\n    assert delivery['raw_record']==before\\n    assert delivery['evidence_valid']==approved and delivery['active']==approved\\n    if not approved: assert delivery['rejection_reasons']\\n\\n\\n@pytest.mark.parametrize('stamp',['2026-11-15T12:00:00Z','2026-11-16T12:00:00Z'])\\ndef test_late_review_cannot_authorize_connected_reimbursement(stamp):\\n    p=synthetic();p['event_clock']=dict(CLOCK)\\n    setfield(p['records']['decisions'][0],'Decision time (UTC)',stamp)\\n    result=batches(p)[-1];w=workflow(result)\\n    assert not w['claim_approval']['approved']\\n    assert w['request'] is None and w['status']=='pending'\\n    assert stages(w)['required_approvals']['status']=='BLOCKED'\\n    assert result['domain']['decision_records']==p['records']['decisions']\\n\\n\\n@pytest.mark.parametrize('status,scope', [('partial',[]),('unavailable',[]),('read',['missing page']),('read',None)])\\ndef test_incomplete_source_observation_is_not_expense_authority(status,scope):\\n    p,r,t=setup();receipt=p['records']['receipts'][0]\\n    obs=next(o for o in p['source_observations'] if o['source_id']==receipt['source_id'])\\n    obs.update(status=status,missing_scope=scope)\\n    assert evaluate(p,r,t)[0]['status']=='BLOCKED'\\n\\n\\n@pytest.mark.parametrize('kind',['trip','directory'])\\ndef test_eligibility_context_requires_verified_sources(kind):\\n    p,r,t=setup()\\n    table_name='Trips' if kind=='trip' else 'People'\\n    target=next(s['records'][0] for s in p['workbook_sheets'] if s['name']==table_name) if kind=='directory' else p['records']['trips'][0]\\n    target['source_sha256']='0'*64\\n    result,lines=evaluate(p,r,t)\\n    assert result['status']=='BLOCKED' and lines[0]['calculated_cents'] is None\\n\\n\\n@pytest.mark.parametrize('kind',['cap','fx'])\\n@pytest.mark.parametrize('verified',[True,False])\\ndef test_only_observed_cap_and_fx_sources_can_supply_amounts(kind,verified):\\n    from travel_claim.ordinary import table\\n    p,r,t=setup()\\n    if kind=='cap':\\n        setfield(p['records']['receipts'][0],'Category','lodging')\\n        setfield(p['records']['receipts'][0],'Documented units','1')\\n        evidence=dict(source_id='synthetic-cap',source_sha256='a'*64,locator='SYNTHETIC cap',values={})\\n        p['source_observations'].append(dict(source_id='synthetic-cap',sha256='a'*64,status='read',missing_scope=[]))\\n        for key,value in {'Destination':t['Destination'],'Category':'lodging','Currency':'EUR',\\n            'Effective from':'2026-01-01','Effective to':'2026-12-31','Amount per unit':'40'}.items():setfield(evidence,key,value)\\n        p['records']['caps']=[evidence]\\n    else:\\n        r['text']=r['text'].replace('EUR','USD')\\n        setfield(p['records']['receipts'][0],'Currency','USD');setfield(merchant(p),'Currency','USD')\\n        evidence=deepcopy(table(p,'fx_rates','FX')[0])\\n        for key,value in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items():setfield(evidence,key,value)\\n        p['records']['fx_rates']=[evidence]\\n    if not verified:evidence['source_sha256']='0'*64\\n    before=deepcopy(evidence)\\n    result,lines=evaluate(p,r,t)\\n    assert (result['status']=='PASS')==verified\\n    assert evidence==before\\n    if not verified:\\n        assert result['calculated_cents'] is None\\n        assert any('0'*64 in ref for ref in lines[0]['source_refs'])\\n\\n\\ndef test_unverified_prior_submission_cannot_supply_timely_filing():\\n    p,r,t=setup();old=deepcopy(r);old['source_sha256']='0'*64\\n    r['text']=r['text'].replace('2026-09-01','2026-11-01');setfield(r,'Submitted date','2026-11-01')\\n    t['End date']='2026-08-31'\\n    result,lines=evaluate(p,r,t,[dict(revision=1,record=old)])\\n    assert result['status']=='BLOCKED' and 'Prior submission' in lines[0]['reason']\\n\\n\\n@pytest.mark.parametrize('kind',['receipt','merchant'])\\ndef test_native_evidence_locator_must_be_verifiable(kind):\\n    p,r,t=setup();target=p['records']['receipts'][0] if kind=='receipt' else merchant(p)\\n    target['locator']='unverifiable record reference'\\n    assert evaluate(p,r,t)[0]['status']=='BLOCKED'\\n\\n\\n@pytest.mark.parametrize('clock,stamp,approved', [\\n    ('2026-09-15T12:00:00Z','2026-09-15T12:00:00Z',True),\\n    ('2026-09-15T12:00:00Z','2026-09-15T12:00:01Z',False),\\n    (None,'2026-09-03T12:00:00Z',False)])\\ndef test_exact_supplied_clock_and_missing_clock(clock,stamp,approved):\\n    p,r,t=subject();p['event_clock']=clock;p['case_clock']=clock\\n    setfield(p['records']['decisions'][0],'Decision time (UTC)',stamp)\\n    assert check(p,r,t)['approved']==approved\\n\\n\\ndef test_inadmissible_later_review_stays_in_history_without_replacing_earlier_authority():\\n    p,r,t=subject();p['event_clock']=dict(CLOCK)\\n    later=deepcopy(p['records']['decisions'][0]);setfield(later,'Decision reference','SYN-FUTURE')\\n    setfield(later,'Decision time (UTC)','2026-11-16T00:00:00Z')\\n    from travel_claim.approvals import table\\n    packet=deepcopy(table(p,'review_packets','Review packets')[0]);setfield(packet,'Decision reference','SYN-FUTURE')\\n    p['records']['decisions'].append(later);table(p,'review_packets','Review packets').append(packet)\\n    first=check(p,r,t);replay=check(p,r,t)\\n    assert first==replay and first['approved']\\n    held=next(d for d in first['deliveries'] if d['decision_id']=='SYN-FUTURE')\\n    assert not held['active'] and not held['evidence_valid'] and held['raw_record']==later\\n\\n\\n@pytest.mark.parametrize('fault',['expense','review'])\\ndef test_independent_valid_claim_still_closes_when_other_claim_is_held(fault):\\n    import json\\n    from travel_claim.approvals import table\\n    p=synthetic()\\n    good=json.loads(json.dumps(p).replace('SYN-C01','SYN-C02').replace('COST-01','COST-02'))\\n    p['records']['finance_events']=[];p['records']['reimbursement_requests']=[]\\n    if fault=='expense':p['records']['receipts'][0]['source_sha256']='0'*64\\n    else:setfield(p['records']['decisions'][0],'Decision time (UTC)','2027-01-01T12:00:00Z')\\n    p['records']['merchant_payments']=deepcopy(table(p,'merchant_payments','Merchant payments')+table(good,'merchant_payments','Merchant payments'))\\n    p['records']['review_packets']=deepcopy(table(p,'review_packets','Review packets')+table(good,'review_packets','Review packets'))\\n    for key in ['claim_revisions','receipts','decisions','finance_events','reimbursement_requests','closure_authorities']:\\n        p['records'][key].extend(deepcopy(good['records'][key]))\\n    result=batches(p)[-1]\\n    assert workflow(result)['status']=='pending'\\n    assert workflow(result,'SYN-C02')['status']=='closed-reimbursed'\\n    assert workflow(result,'SYN-C02')['allowed_cents']==10000\\n\\n\\ndef test_clock_recheck_preserves_previously_retained_review_history():\\n    p,r,t=subject();p['event_clock']='2026-11-15T23:00:00Z'\\n    setfield(p['records']['decisions'][0],'Decision time (UTC)','2026-11-15T12:00:00Z')\\n    prior=check(p,r,t);saved=deepcopy(prior)\\n    assert prior['approved']\\n    p['event_clock']=dict(CLOCK)\\n    current=check(p,r,t,prior=prior)\\n    assert not current['approved'] and prior==saved\\n    assert current['deliveries'][0]['raw_record']==prior['deliveries'][0]['raw_record']\\n\\n\\ndef test_no_source_observations_cannot_establish_employee_paid_expense():\\n    p,r,t=setup();p['source_observations']=[]\\n    assert evaluate(p,r,t)[0]['status']=='BLOCKED'\\n\\n\\ndef test_matching_but_malformed_hash_is_not_verified_authority():\\n    p,r,t=setup();receipt=p['records']['receipts'][0]\\n    observation=next(o for o in p['source_observations'] if o['source_id']==receipt['source_id'])\\n    receipt['source_sha256']=observation['sha256']='not-a-sha256'\\n    assert evaluate(p,r,t)[0]['status']=='BLOCKED'\\n\\n\\n@pytest.mark.parametrize('kind',['page','cell'])\\ndef test_native_locator_must_agree_with_retained_record_metadata(kind):\\n    p,r,t=setup()\\n    if kind=='page':r['locator']='PDF page 999'\\n    else:merchant(p)['locator']=\\\"tab 'Merchant payments', row 999\\\"\\n    result,lines=evaluate(p,r,t)\\n    assert result['status']=='BLOCKED' and lines[0]['evidence_status']=='BLOCKED'\\n\"}","type":"input_text"},{"text":"{\"chunk_id\":\"279ae5\",\"wall_time_seconds\":0.644045783,\"exit_code\":0,\"original_token_count\":32,\"output\":\"132/132 baseline hashes match; original historical 129-file manifest unavailable; branch/HEAD/scope/staging/diff checks PASS\\n\"}","type":"input_text"},{"text":"{\"chunk_id\":\"d42c00\",\"wall_time_seconds\":1.001313624,\"session_id\":50332,\"original_token_count\":3,\"output\":\".........\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"call_id":"call_4279c4e5e90b437b9489d9a90f8c5385","id":"ctc_02f4b2bd528e1b90016ad0b54e22b881908dfbf940f8dd8996","input":"text(await tools.exec_command({cmd:\"git ls-remote origin refs/heads/main 'refs/entire/checkpoints/*'\",\"sandbox_permissions\":\"require_escalated\",\"justification\":\"Allow checking remote main and Entire.io references before the requested commit and push?\",\"prefix_rule\":[\"git\",\"ls-remote\"],\"max_output_tokens\":2400}));\ntext(await tools.write_stdin({session_id:50332,chars:\"\",\"yield_time_ms\":1000,\"max_output_tokens\":1500}));\n","internal_chat_message_metadata_passthrough":{"create_time":1792062798.1419375,"turn_id":"01a13f43-f677-78c3-a142-cfd7413b6562"},"name":"exec","status":"completed","type":"custom_tool_call"},{"call_id":"call_4279c4e5e90b437b9489d9a90f8c5385","guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000},"id":"ctco_01a13f44-bea6-7841-8453-519751c5ea44","internal_chat_message_metadata_passthrough":{"create_time":1792062832.294944,"turn_id":"01a1