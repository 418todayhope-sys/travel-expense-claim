\t    usable, suffix, reason = _validate_payload(source, body)\n   135\t    if not usable:\n   136\t        return \"unavailable\", None, reason, [source.title]\n   137\t    if source.kind == \"notion\":\n   138\t        return \"partial\", suffix, \"Policy-related HTML accessed, but complete native Notion page content is not established\", [\"Complete authoritative policy page body and all relevant blocks\"]\n   139\t    try:\n   140\t        if source.kind == \"pdf\":\n   141\t            from pypdf import PdfReader\n   142\t            reader = PdfReader(io.BytesIO(body), strict=True)\n   143\t            if reader.is_encrypted or not reader.pages:\n   144\t                raise ValueError(\"PDF has no accessible pages or is encrypted\")\n   145\t            # Traverse every page, not just the signature/trailer. Raw bytes are\n   146\t            # retained even where text extraction cannot read scanned content.\n   147\t            texts = [(page.extract_text(extraction_mode=\"layout\") or \"\") if \"/Contents\" in page else \"\" for page in reader.pages]\n   148\t            if any(not text.strip() for text in texts):\n   149\t                return \"partial\", suffix, \"One or more PDF pages have no extractable text; visual/OCR verification required\", [\"Readable text or verified visual transcription of every PDF page\"]\n   150\t        elif source.kind == \"xlsx\":\n   151\t            from openpyxl import load_workbook\n   152\t            workbook = load_workbook(io.BytesIO(body), data_only=False, read_only=False)\n   153\t            missing = sorted(WORKBOOK_TABS - set(workbook.sheetnames))\n   154\t            workbook.close()\n   155\t            if missing:\n   156\t                return \"partial\", suffix, \"Workbook export lacks required retained-source tabs\", missing\n   157\t    except Exception as exc:\n   158\t        return \"unavailable\", None, f\"Native document validation failed: {type(exc).__name__}: {exc}\", [source.title]\n   159\t    return \"read\", suffix, None, []\n   160\t\n   161\t\n   162\tdef capture_sources(\n   163\t    run_dir: Path, *, run_id: str, case_clock: str | None,\n   164\t    source_specs: tuple[NativeSource, ...] = SOURCES,\n   165\t    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\n   166\t    observed_at: Callable[[], str] = _utc_now, timeout: float = 30.0,\n   167\t) -> dict:\n   168\t    \"\"\"Attempt fresh requests; retain every returned body, including error evidence.\n   169\t\n   170\t    A new, empty run directory is required. There is no retained-input option.\n   171\t    Observation timestamps are retrieval facts, never the scenario case clock.\n   172\t    \"\"\"\n   173\t    if not run_id or Path(run_id).name != run_id or run_id in {\".\", \"..\"}:\n   174\t        raise ValueError(\"run_id must be a single safe path component\")\n   175\t    if run_dir.name != run_id:\n   176\t        raise ValueError(\"run_dir basename must equal run_id\")\n   177\t    if timeout <= 0:\n   178\t        raise ValueError(\"timeout must be positive\")\n   179\t    if case_clock is not None:\n   180\t        try:\n   181\t            clock = datetime.fromisoformat(case_clock.replace(\"Z\", \"+00:00\"))\n   182\t            if clock.utcoffset() is None:\n   183\t                raise ValueError(\"timezone required\")\n   184\t        except (ValueError, AttributeError, TypeError) as exc:\n   185\t            raise ValueError(\"case_clock must be an explicit date/time with timezone, never an observation default\") from exc\n   186\t    if set(source_specs) != set(SOURCES) or len(source_specs) != 5:\n   187\t        raise ValueError(\"Every live capture must attempt exactly all five original source identities and URLs\")\n   188\t    if run_dir.exists() and any(run_dir.iterdir()):\n   189\t        raise FileExistsError(f\"Refusing to reuse nonempty run directory: {run_dir}\")\n   190\t    run_dir.mkdir(parents=True, exist_ok=True)\n   191\t    manifest_path = run_dir / \"sources.json\"\n   192\t    (run_dir / \"sources\").mkdir()\n   193\t    (run_dir / \"responses\").mkdir()\n   194\t    entries = []\n   195\t    for source in source_specs:\n   196\t        started = observed_at()\n   197\t        attempted = source.export_url or source.url\n   198\t        body, headers, final_url, status_code, failure = None, {}, None, None, None\n   199\t        try:\n   200\t            body, headers, final_url = fetch(attempted, timeout)\n    15\tdef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\n    16\t    \"\"\"Always capture all five URLs into a new directory before reading inputs.\"\"\"\n    17\t    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\n    18\t    errors = verify_source_manifest(run_dir)\n    19\t    parsed = None\n    20\t    if not errors:\n    21\t        try:\n    22\t            parsed = parse_retained_run(run_dir)\n    23\t        except Exception as exc:\n    24\t            errors.append(f\"Native transcription failed: {type(exc).__name__}: {exc}\")\n    25\t    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\n    26\t               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\n    27\t               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\n    28\t    for row in manifest['files']:\n    29\t        checks.append({'check': f\"source:{row['source_id']}\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\n    30\t                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\n    31\t                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\n    32\t                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\n    33\t    for issue in (parsed or {}).get('transcription_issues', []):\n    34\t        checks.append({'check': f\"transcription:{issue['source_id']}\", 'status': 'BLOCKED',\n    35\t                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\n    36\t    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\n    37\t                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\n    38\t                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\n    39\t    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\n    40\t                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\n    41\t                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\n    42\t    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\n    43\t    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\n    44\t    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\n    45\t              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\n    46\t              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\n    47\t              'final_live_source_compliance': False, 'batches_consumed': [],\n    48\t              'source_manifest': {'path': 'sources.json', 'sha256': sha256_bytes((run_dir / 'sources.json').read_bytes())},\n    49\t              'parsed_records': {'path': 'parsed-records.json', 'sha256': sha256_bytes((run_dir / 'parsed-records.json').read_bytes())} if parsed else None,\n    50\t              'arrival_batches_observed': (parsed or {}).get('arrival_batches', []), 'checks': checks}\n    51\t    with (run_dir / 'live-run.json').open('x', encoding='utf-8') as stream:\n    52\t        stream.write(json.dumps(report, indent=2, ensure_ascii=False) + '\\n')\n    53\t    lines = ['# Project D fresh native-source attempt', '', f\"**{status}** — `{run_id}`; mode: `live-source-attempt`.\", '',\n    54\t             'All five original source locations were attempted in this invocation using native HTTP/export routes. '\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Uncapped categories']['value'] = []\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\n","stderr":"","aggregated_output":"     1\t\"\"\"Executed correction checks, with immutable evidence and monetary history.\"\"\"\n     2\tfrom copy import deepcopy\n     3\t\n     4\tfrom .ordinary import expense_lines, fields, ref\n     5\t\n     6\t\n     7\tdef correction_changes(before, after):\n     8\t    \"\"\"Compare actual claim facts, including evidence changes with unchanged totals.\"\"\"\n     9\t    old, new = fields(before), fields(after)\n    10\t    changes = {key: {'before': old.get(key), 'after': new.get(key)}\n    11\t               for key in sorted(set(old) | set(new))\n    12\t               if old.get(key) != new.get(key) and key not in {'Revision', 'Arrival batch'}}\n    13\t    previous = {line['cost_id']: line for line in expense_lines(before)}\n    14\t    current = {line['cost_id']: line for line in expense_lines(after)}\n    15\t    # Source references change with the revision even when the line facts do not.\n    16\t    def facts(line):\n    17\t        return {k: v for k, v in line.items() if k != 'source_refs'} if line else None\n    18\t    lines = [{'cost_id': key, 'before': facts(previous.get(key)), 'after': facts(current.get(key)),\n    19\t              'changed': facts(previous.get(key)) != facts(current.get(key))}\n    20\t             for key in sorted(set(previous) | set(current))]\n    21\t    return {'fields': changes, 'expense_lines': lines,\n    22\t            'unchanged_cost_ids': [line['cost_id'] for line in lines if not line['changed']],\n    23\t            'source_refs': [ref(before), ref(after)]}\n    24\t\n    25\t\n    26\tdef record_executed_rechecks(domain, previous_domain, *, batch_id):\n    27\t    \"\"\"Called after connect_claim and Finance reconciliation actually execute.\"\"\"\n    28\t    for correction in domain['material_corrections']:\n    29\t        claim_id = correction['claim_id']\n    30\t        workflow = domain['ordinary_workflows'][claim_id]\n    31\t        if workflow['revision'] != correction['to_revision']:\n    32\t            continue\n    33\t        if correction['arrival_batch'] == batch_id:\n    34\t            revisions = domain['revision_history']['claim'][claim_id]['revisions']\n    35\t            before = next(r['record'] for r in revisions if r['revision'] == correction['from_revision'])\n    36\t            after = next(r['record'] for r in reversed(revisions) if r['revision'] == correction['to_revision'])\n    37\t            correction['changed_dependencies'] = correction_changes(before, after)\n    38\t            old = previous_domain.get('ordinary_workflows', {}).get(claim_id)\n    39\t            correction['before_workflow'] = deepcopy(old)\n    40\t            correction['before_finance'] = deepcopy(previous_domain.get('finance_reconciliations', {}).get(claim_id))\n    41\t        correction.setdefault('executed_rechecks', []).append({\n    42\t            'batch_id': batch_id, 'revision': workflow['revision'],\n    43\t            'checks': deepcopy(workflow['stages']),\n    44\t            'lines': deepcopy(workflow['lines']),\n    45\t            'observed_reviews': deepcopy(workflow['observed_reviews']),\n    46\t            'request': deepcopy(workflow['request']),\n    47\t            'finance': deepcopy(domain['finance_reconciliations'][claim_id]),\n    48\t            'status': workflow['status'],\n    49\t            'basis': 'Current-revision ordinary evidence, approval, request and Finance checks executed; no human response created',\n    50\t        })\n    51\t\n    52\t\n    53\tdef verification_document(domain, cancellations, *, run_id):\n    54\t    data = {'run_id': run_id, 'mode': 'offline-replay', 'fresh_native_reads_performed': False,\n    55\t            'corrections': deepcopy(domain['material_corrections']),\n    56\t            'cancellations': deepcopy(cancellations),\n    57\t            'cancellation_evidence': deepcopy(domain.get('cancellation_evidence', {})),\n    58\t            'cancellation_issues': deepcopy(domain['cancellation_state']['issues'])}\n    59\t    lines = ['# Correction and cancellation verification — OFFLINE REPLAY', '',\n    60\t             'Retained evidence only. No fresh source execution, approvals, requests or payments generated.',\n    61\t             'PASS means the stated local evidence check passed; BLOCKED requires the named evidence or authority.', '',\n    62\t             '## Executed correction rechecks', '']\n    63\t    for correction in data['corrections']:\n    64\t        latest = correction['executed_rechecks'][-1]\n    65\t        lines += [f\"### {correction['claim_id']} r{correction['from_revision']} → r{correction['to_revision']}\", '',\n    66\t                  f\"Arrival: {correction['arrival_batch']}. Changed facts: `{correction['changed_dependencies']}`\", '',\n    67\t                  f\"Historical reviews excluded from current authority: {', '.join(correction['invalidated_decision_ids']) or 'none observed'}.\", '',\n    68\t                  '| Executed check | Result | Next action |', '|---|---|---|']\n    69\t        for check in latest['checks']:\n    70\t            lines.append(f\"| {check['stage']} | {check['status']} | {check['owner']}: {check['next_action']} |\")\n    71\t        lines += ['', 'Executed check evidence:', '']\n    72\t        for check in latest['checks']:\n    73\t            lines.append(f\"- {check['stage']}: {'; '.join(check['source_refs'])}\")\n    74\t        old = correction.get('before_finance') or {}\n    75\t        new = latest['finance']\n    76\t        lines += ['', f\"Known net cash cents: {old.get('net_confirmed_cents')} → {new['net_confirmed_cents']}; \"\n    77\t                  f\"recorded ledger difference cents: {old.get('recorded_ledger_balance_cents')} → {new['recorded_ledger_balance_cents']}. \"\n    78\t                  'Recorded ledger agreement does not prove current entitlement or closure.', '']\n   262\tdef _cancellation_rows(\n   263\t    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str, parsed: dict[str, Any],\n   264\t) -> list[dict[str, Any]]:\n   265\t    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"])\n   266\t    domain[\"cancellation_state\"] = reduced\n   267\t    raw_by_id = {}\n   268\t    for record in domain[\"cancellation_records\"]:\n   269\t        raw_by_id.setdefault(row_values(record).get(\"Cancellation activity reference\"), record)\n   270\t    domain[\"cancellation_evidence\"] = {}\n   271\t    for index, issue in enumerate(reduced[\"issues\"]):\n   272\t        event = raw_by_id.get(issue.get(\"event_id\"))\n   273\t        value = row_values(event) if event else {}\n   274\t        kind = value.get(\"Cancelled subject\")\n   275\t        subject = value.get(\"Trip reference\") if kind == \"trip\" else value.get(\"Permit reference\")\n   276\t        revision = _as_batch(value.get(\"Trip revision\") if kind == \"trip\" else value.get(\"Permit revision\"))\n   277\t        if kind in {\"trip\", \"permit\"} and subject and revision:\n   278\t            _open_issue_for_subject(domain[\"repair_queue\"], item_id=f\"cancellation-evidence:{issue.get('event_id')}:{index}\",\n   279\t                subject_type=kind, subject_id=subject, revision=revision, refs=[_ref_text(_ref(event))],\n   280\t                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n   281\t                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n   282\t                run_id=run_id, batch_id=batch_id)\n   283\t    claim_revisions = _subject_claim_revisions(history)\n   284\t    snapshot_rows = []\n   285\t    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n   286\t        target = process[\"target\"]\n   287\t        target_revision = target.get(\"revision\")\n   288\t        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n   289\t                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n   290\t            domain[\"projection_issues\"].append({\n   291\t                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n   292\t                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n   293\t                \"owner\": \"Travel Administration Lead\",\n   294\t                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n   295\t            })\n   296\t            continue\n   297\t        record_order = process[\"activity_ids\"]\n   298\t        if not record_order:\n   299\t            continue  # Orphan evidence remains in cancellation_state and owned issues.\n   300\t        request_id = record_order[0]\n   301\t        request = raw_by_id[request_id]\n   302\t        request_values = row_values(request)\n   303\t        confirmation = next((raw_by_id[event_id] for event_id in record_order\n   304\t                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n   305\t        confirmation_values = row_values(confirmation) if confirmation else {}\n   306\t        trip_id = request_values.get(\"Trip reference\")\n   307\t        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n   308\t        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n   309\t        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n   310\t        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n   311\t        affected = []\n   312\t        current_affected = []\n   313\t        for claim_id, claim in claim_revisions.items():\n   314\t            for claim_rev in claim[\"revisions\"]:\n   315\t                if target[\"subject_type\"] == \"trip\":\n   316\t                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n   317\t                else:\n   318\t                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n   319\t                    matches = any(\n   320\t                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n   321\t                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n   322\t                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n   323\t                        for trip_rev in trip_index.get(\"revisions\", [])\n   324\t                    )\n   325\t                if matches:\n   326\t                    affected.append(claim_id)\n   327\t                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n   328\t                        current_affected.append(claim_id)\n   329\t        affected = sorted(set(affected))\n   330\t        task_id = f\"cancellation-financial:{cancellation_id}\"\n   331\t        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n   332\t        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n   333\t        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n   334\t        queue = domain[\"repair_queue\"]\n   335\t        if task_id not in queue[\"items\"]:\n   336\t            _open_issue_for_subject(\n   337\t                queue, item_id=task_id,\n   338\t                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n   339\t                revision=target_revision, refs=refs, reason=reason,\n   340\t                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n   341\t            )\n   342\t        else:\n   343\t            item = queue[\"items\"][task_id]\n   344\t            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n   345\t            changes = {}\n   346\t            if additions != item[\"source_refs\"]:\n   347\t                changes[\"source_refs\"] = additions\n   348\t            if changes:\n   349\t                update_repair_item(\n   350\t                    queue, item_id=task_id,\n   351\t                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n   352\t                    run_id=run_id, batch_id=batch_id, **changes,\n   353\t                )\n   354\t        cancellation_issue = task_id\n   355\t        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n   356\t        if not trip_id or not trip_revision or not requested_at:\n   357\t            domain.setdefault(\"projection_issues\", []).append({\n   358\t                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n   359\t                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n   360\t                \"owner\": \"Travel Administration Lead\",\n   361\t                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n   362\t            })\n   363\t            continue\n   364\t        snapshot_rows.append({\n   365\t            \"cancellation_id\": cancellation_id,\n   366\t            \"target_type\": target[\"subject_type\"],\n   367\t            \"trip_id\": str(trip_id),\n   368\t            \"trip_revision\": trip_revision,\n   369\t            \"permit_id\": str(permit_id) if permit_id else None,\n   370\t            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n   371\t            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n   372\t            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n   373\t            \"requested_at\": requested_at,\n   374\t            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n   375\t            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n   376\t            \"affected_claim_ids\": affected,\n   377\t            \"source_refs\": refs,\n   378\t            \"original_request_ids\": sorted({row_values(r).get(\"Request reference\") for r in domain[\"finance_records\"]\n   379\t                if row_values(r).get(\"Claim reference\") in affected and row_values(r).get(\"Request reference\")}),\n   380\t            \"financial_status\": \"unresolved\",\n   381\t            \"next_owner\": \"Finance\",\n   382\t            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n   383\t            \"issue_record_ids\": [cancellation_issue],\n   384\t        })\n   385\t        # Finance dispositions are explicit claim/revision/cancellation-bound source\n   386\t        # statements. They do not establish the missing policy or closure authority.\n   387\t        dispositions = []\n   388\t        for claim_id in affected:\n   389\t            for revision in claim_revisions[claim_id][\"revisions\"]:\n   390\t                value = _page_values(revision[\"record\"])\n   391\t                if (value.get(\"Travel cancellation reference\") == cancellation_id\n   392\t                        and value.get(\"Applies to claim\") == claim_id\n   393\t                        and str(value.get(\"Applies to revision\")) == str(revision[\"revision\"])\n   394\t                        and value.get(\"Authorizing Finance officer\")\n   395\t                        and value.get(\"Allowed original amount\") is not None):\n   396\t                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n   397\t                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n   398\t                        \"expense_reference\": value.get(\"Expense reference\"),\n   399\t                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n   400\t                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n   401\t        if dispositions:\n   402\t            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n   403\t            changes = {\n   404\t                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n   405\t                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n   406\t                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n   407\t            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n   408\t            if changes:\n   409\t                update_repair_item(queue, item_id=task_id,\n   410\t                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n   411\t        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n   412\t                 if row_values(r).get(\"Trip reference\") == trip_id\n   413\t                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n   414\t        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n   415\t        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n   416\t        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n   417\t        actors_ok = bool(employee and supervisor\n   418\t            and request_values.get(\"Acting employee or supervisor\") == employee\n   419\t            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n   420\t        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n   421\t        if not actors_ok:\n   422\t            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n   423\t                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n   424\t                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n   425\t                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n   426\t                run_id=run_id, batch_id=batch_id)\n   427\t        actor_item = f\"cancellation-authority:{cancellation_id}\"\n   428\t        if actor_item in queue[\"items\"]:\n   429\t            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n   430\t                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n   431\t        domain[\"cancellation_evidence\"][cancellation_id] = {\n   432\t            \"current_claim_ids\": sorted(set(current_affected)),\n   433\t            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n   434\t            \"history\": deepcopy(process[\"history\"]),\n   435\t            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n   436\t            \"dispositions\": dispositions,\n   437\t            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n   438\t            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n   439\t        }\n   440\t    return snapshot_rows\n   441\t\n   442\t\n   130\t\n   131\t\n   132\tdef assess_payload(source: NativeSource, body: bytes) -> tuple[str, str | None, str | None, list[str]]:\n   133\t    \"\"\"Check accessible scope; a Notion HTML fragment never proves a full policy read.\"\"\"\n   134\t    usable, suffix, reason = _validate_payload(source, body)\n   135\t    if not usable:\n   136\t        return \"unavailable\", None, reason, [source.title]\n   137\t    if source.kind == \"notion\":\n   138\t        return \"partial\", suffix, \"Policy-related HTML accessed, but complete native Notion page content is not established\", [\"Complete authoritative policy page body and all relevant blocks\"]\n   139\t    try:\n   140\t        if source.kind == \"pdf\":\n   141\t            from pypdf import PdfReader\n   142\t            reader = PdfReader(io.BytesIO(body), strict=True)\n   143\t            if reader.is_encrypted or not reader.pages:\n   144\t                raise ValueError(\"PDF has no accessible pages or is encrypted\")\n   145\t            # Traverse every page, not just the signature/trailer. Raw bytes are\n   146\t            # retained even where text extraction cannot read scanned content.\n   147\t            texts = [(page.extract_text(extraction_mode=\"layout\") or \"\") if \"/Contents\" in page else \"\" for page in reader.pages]\n   148\t            if any(not text.strip() for text in texts):\n   149\t                return \"partial\", suffix, \"One or more PDF pages have no extractable text; visual/OCR verification required\", [\"Readable text or verified visual transcription of every PDF page\"]\n   150\t        elif source.kind == \"xlsx\":\n   151\t            from openpyxl import load_workbook\n   152\t            workbook = load_workbook(io.BytesIO(body), data_only=False, read_only=False)\n   153\t            missing = sorted(WORKBOOK_TABS - set(workbook.sheetnames))\n   154\t            workbook.close()\n   155\t            if missing:\n   156\t                return \"partial\", suffix, \"Workbook export lacks required retained-source tabs\", missing\n   157\t    except Exception as exc:\n   158\t        return \"unavailable\", None, f\"Native document validation failed: {type(exc).__name__}: {exc}\", [source.title]\n   159\t    return \"read\", suffix, None, []\n   160\t\n   161\t\n   162\tdef capture_sources(\n   163\t    run_dir: Path, *, run_id: str, case_clock: str | None,\n   164\t    source_specs: tuple[NativeSource, ...] = SOURCES,\n   165\t    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\n   166\t    observed_at: Callable[[], str] = _utc_now, timeout: float = 30.0,\n   167\t) -> dict:\n   168\t    \"\"\"Attempt fresh requests; retain every returned body, including error evidence.\n   169\t\n   170\t    A new, empty run directory is required. There is no retained-input option.\n   171\t    Observation timestamps are retrieval facts, never the scenario case clock.\n   172\t    \"\"\"\n   173\t    if not run_id or Path(run_id).name != run_id or run_id in {\".\", \"..\"}:\n   174\t        raise ValueError(\"run_id must be a single safe path component\")\n   175\t    if run_dir.name != run_id:\n   176\t        raise ValueError(\"run_dir basename must equal run_id\")\n   177\t    if timeout <= 0:\n   178\t        raise ValueError(\"timeout must be positive\")\n   179\t    if case_clock is not None:\n   180\t        try:\n   181\t            clock = datetime.fromisoformat(case_clock.replace(\"Z\", \"+00:00\"))\n   182\t            if clock.utcoffset() is None:\n   183\t                raise ValueError(\"timezone required\")\n   184\t        except (ValueError, AttributeError, TypeError) as exc:\n   185\t            raise ValueError(\"case_clock must be an explicit date/time with timezone, never an observation default\") from exc\n   186\t    if set(source_specs) != set(SOURCES) or len(source_specs) != 5:\n   187\t        raise ValueError(\"Every live capture must attempt exactly all five original source identities and URLs\")\n   188\t    if run_dir.exists() and any(run_dir.iterdir()):\n   189\t        raise FileExistsError(f\"Refusing to reuse nonempty run directory: {run_dir}\")\n   190\t    run_dir.mkdir(parents=True, exist_ok=True)\n   191\t    manifest_path = run_dir / \"sources.json\"\n   192\t    (run_dir / \"sources\").mkdir()\n   193\t    (run_dir / \"responses\").mkdir()\n   194\t    entries = []\n   195\t    for source in source_specs:\n   196\t        started = observed_at()\n   197\t        attempted = source.export_url or source.url\n   198\t        body, headers, final_url, status_code, failure = None, {}, None, None, None\n   199\t        try:\n   200\t            body, headers, final_url = fetch(attempted, timeout)\n    15\tdef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\n    16\t    \"\"\"Always capture all five URLs into a new directory before reading inputs.\"\"\"\n    17\t    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\n    18\t    errors = verify_source_manifest(run_dir)\n    19\t    parsed = None\n    20\t    if not errors:\n    21\t        try:\n    22\t            parsed = parse_retained_run(run_dir)\n    23\t        except Exception as exc:\n    24\t            errors.append(f\"Native transcription failed: {type(exc).__name__}: {exc}\")\n    25\t    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\n    26\t               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\n    27\t               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\n    28\t    for row in manifest['files']:\n    29\t        checks.append({'check': f\"source:{row['source_id']}\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\n    30\t                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\n    31\t                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\n    32\t                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\n    33\t    for issue in (parsed or {}).get('transcription_issues', []):\n    34\t        checks.append({'check': f\"transcription:{issue['source_id']}\", 'status': 'BLOCKED',\n    35\t                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\n    36\t    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\n    37\t                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\n    38\t                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\n    39\t    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\n    40\t                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\n    41\t                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\n    42\t    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\n    43\t    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\n    44\t    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\n    45\t              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\n    46\t              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\n    47\t              'final_live_source_compliance': False, 'batches_consumed': [],\n    48\t              'source_manifest': {'path': 'sources.json', 'sha256': sha256_bytes((run_dir / 'sources.json').read_bytes())},\n    49\t              'parsed_records': {'path': 'parsed-records.json', 'sha256': sha256_bytes((run_dir / 'parsed-records.json').read_bytes())} if parsed else None,\n    50\t              'arrival_batches_observed': (parsed or {}).get('arrival_batches', []), 'checks': checks}\n    51\t    with (run_dir / 'live-run.json').open('x', encoding='utf-8') as stream:\n    52\t        stream.write(json.dumps(report, indent=2, ensure_ascii=False) + '\\n')\n    53\t    lines = ['# Project D fresh native-source attempt', '', f\"**{status}** — `{run_id}`; mode: `live-source-attempt`.\", '',\n    54\t             'All five original source locations were attempted in this invocation using native HTTP/export routes. '\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Uncapped categories']['value'] = []\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\n","exit_code":0,"duration":{"secs":0,"nanos":43348360},"formatted_output":"     1\t\"\"\"Executed correction checks, with immutable evidence and monetary history.\"\"\"\n     2\tfrom copy import deepcopy\n     3\t\n     4\tfrom .ordinary import expense_lines, fields, ref\n     5\t\n     6\t\n     7\tdef correction_changes(before, after):\n     8\t    \"\"\"Compare actual claim facts, including evidence changes with unchanged totals.\"\"\"\n     9\t    old, new = fields(before), fields(after)\n    10\t    changes = {key: {'before': old.get(key), 'after': new.get(key)}\n    11\t               for key in sorted(set(old) | set(new))\n    12\t               if old.get(key) != new.get(key) and key not in {'Revision', 'Arrival batch'}}\n    13\t    previous = {line['cost_id']: line for line in expense_lines(before)}\n    14\t    current = {line['cost_id']: line for line in expense_lines(after)}\n    15\t    # Source references change with the revision even when the line facts do not.\n    16\t    def facts(line):\n    17\t        return {k: v for k, v in line.items() if k != 'source_refs'} if line else None\n    18\t    lines = [{'cost_id': key, 'before': facts(previous.get(key)), 'after': facts(current.get(key)),\n    19\t              'changed': facts(previous.get(key)) != facts(current.get(key))}\n    20\t             for key in sorted(set(previous) | set(current))]\n    21\t    return {'fields': changes, 'expense_lines': lines,\n    22\t            'unchanged_cost_ids': [line['cost_id'] for line in lines if not line['changed']],\n    23\t            'source_refs': [ref(before), ref(after)]}\n    24\t\n    25\t\n    26\tdef record_executed_rechecks(domain, previous_domain, *, batch_id):\n    27\t    \"\"\"Called after connect_claim and Finance reconciliation actually execute.\"\"\"\n    28\t    for correction in domain['material_corrections']:\n    29\t        claim_id = correction['claim_id']\n    30\t        workflow = domain['ordinary_workflows'][claim_id]\n    31\t        if workflow['revision'] != correction['to_revision']:\n    32\t            continue\n    33\t        if correction['arrival_batch'] == batch_id:\n    34\t            revisions = domain['revision_history']['claim'][claim_id]['revisions']\n    35\t            before = next(r['record'] for r in revisions if r['revision'] == correction['from_revision'])\n    36\t            after = next(r['record'] for r in reversed(revisions) if r['revision'] == correction['to_revision'])\n    37\t            correction['changed_dependencies'] = correction_changes(before, after)\n    38\t            old = previous_domain.get('ordinary_workflows', {}).get(claim_id)\n    39\t            correction['before_workflow'] = deepcopy(old)\n    40\t            correction['before_finance'] = deepcopy(previous_domain.get('finance_reconciliations', {}).get(claim_id))\n    41\t        correction.setdefault('executed_rechecks', []).append({\n    42\t            'batch_id': batch_id, 'revision': workflow['revision'],\n    43\t            'checks': deepcopy(workflow['stages']),\n    44\t            'lines': deepcopy(workflow['lines']),\n    45\t            'observed_reviews': deepcopy(workflow['observed_reviews']),\n    46\t            'request': deepcopy(workflow['request']),\n    47\t            'finance': deepcopy(domain['finance_reconciliations'][claim_id]),\n    48\t            'status': workflow['status'],\n    49\t            'basis': 'Current-revision ordinary evidence, approval, request and Finance checks executed; no human response created',\n    50\t        })\n    51\t\n    52\t\n    53\tdef verification_document(domain, cancellations, *, run_id):\n    54\t    data = {'run_id': run_id, 'mode': 'offline-replay', 'fresh_native_reads_performed': False,\n    55\t            'corrections': deepcopy(domain['material_corrections']),\n    56\t            'cancellations': deepcopy(cancellations),\n    57\t            'cancellation_evidence': deepcopy(domain.get('cancellation_evidence', {})),\n    58\t            'cancellation_issues': deepcopy(domain['cancellation_state']['issues'])}\n    59\t    lines = ['# Correction and cancellation verification — OFFLINE REPLAY', '',\n    60\t             'Retained evidence only. No fresh source execution, approvals, requests or payments generated.',\n    61\t             'PASS means the stated local evidence check passed; BLOCKED requires the named evidence or authority.', '',\n    62\t             '## Executed correction rechecks', '']\n    63\t    for correction in data['corrections']:\n    64\t        latest = correction['executed_rechecks'][-1]\n    65\t        lines += [f\"### {correction['claim_id']} r{correction['from_revision']} → r{correction['to_revision']}\", '',\n    66\t                  f\"Arrival: {correction['arrival_batch']}. Changed facts: `{correction['changed_dependencies']}`\", '',\n    67\t                  f\"Historical reviews excluded from current authority: {', '.join(correction['invalidated_decision_ids']) or 'none observed'}.\", '',\n    68\t                  '| Executed check | Result | Next action |', '|---|---|---|']\n    69\t        for check in latest['checks']:\n    70\t            lines.append(f\"| {check['stage']} | {check['status']} | {check['owner']}: {check['next_action']} |\")\n    71\t        lines += ['', 'Executed check evidence:', '']\n    72\t        for check in latest['checks']:\n    73\t            lines.append(f\"- {check['stage']}: {'; '.join(check['source_refs'])}\")\n    74\t        old = correction.get('before_finance') or {}\n    75\t        new = latest['finance']\n    76\t        lines += ['', f\"Known net cash cents: {old.get('net_confirmed_cents')} → {new['net_confirmed_cents']}; \"\n    77\t                  f\"recorded ledger difference cents: {old.get('recorded_ledger_balance_cents')} → {new['recorded_ledger_balance_cents']}. \"\n    78\t                  'Recorded ledger agreement does not prove current entitlement or closure.', '']\n   262\tdef _cancellation_rows(\n   263\t    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str, parsed: dict[str, Any],\n   264\t) -> list[dict[str, Any]]:\n   265\t    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"])\n   266\t    domain[\"cancellation_state\"] = reduced\n   267\t    raw_by_id = {}\n   268\t    for record in domain[\"cancellation_records\"]:\n   269\t        raw_by_id.setdefault(row_values(record).get(\"Cancellation activity reference\"), record)\n   270\t    domain[\"cancellation_evidence\"] = {}\n   271\t    for index, issue in enumerate(reduced[\"issues\"]):\n   272\t        event = raw_by_id.get(issue.get(\"event_id\"))\n   273\t        value = row_values(event) if event else {}\n   274\t        kind = value.get(\"Cancelled subject\")\n   275\t        subject = value.get(\"Trip reference\") if kind == \"trip\" else value.get(\"Permit reference\")\n   276\t        revision = _as_batch(value.get(\"Trip revision\") if kind == \"trip\" else value.get(\"Permit revision\"))\n   277\t        if kind in {\"trip\", \"permit\"} and subject and revision:\n   278\t            _open_issue_for_subject(domain[\"repair_queue\"], item_id=f\"cancellation-evidence:{issue.get('event_id')}:{index}\",\n   279\t                subject_type=kind, subject_id=subject, revision=revision, refs=[_ref_text(_ref(event))],\n   280\t                reason=issue[\"reason\"], owner=\"Travel Administration Lead\",\n   281\t                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n   282\t                run_id=run_id, batch_id=batch_id)\n   283\t    claim_revisions = _subject_claim_revisions(history)\n   284\t    snapshot_rows = []\n   285\t    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n   286\t        target = process[\"target\"]\n   287\t        target_revision = target.get(\"revision\")\n   288\t        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n   289\t                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n   290\t            domain[\"projection_issues\"].append({\n   291\t                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n   292\t                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n   293\t                \"owner\": \"Travel Administration Lead\",\n   294\t                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n   295\t            })\n   296\t            continue\n   297\t        record_order = process[\"activity_ids\"]\n   298\t        if not record_order:\n   299\t            continue  # Orphan evidence remains in cancellation_state and owned issues.\n   300\t        request_id = record_order[0]\n   301\t        request = raw_by_id[request_id]\n   302\t        request_values = row_values(request)\n   303\t        confirmation = next((raw_by_id[event_id] for event_id in record_order\n   304\t                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n   305\t        confirmation_values = row_values(confirmation) if confirmation else {}\n   306\t        trip_id = request_values.get(\"Trip reference\")\n   307\t        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n   308\t        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n   309\t        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n   310\t        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n   311\t        affected = []\n   312\t        current_affected = []\n   313\t        for claim_id, claim in claim_revisions.items():\n   314\t            for claim_rev in claim[\"revisions\"]:\n   315\t                if target[\"subject_type\"] == \"trip\":\n   316\t                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n   317\t                else:\n   318\t                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n   319\t                    matches = any(\n   320\t                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n   321\t                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n   322\t                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n   323\t                        for trip_rev in trip_index.get(\"revisions\", [])\n   324\t                    )\n   325\t                if matches:\n   326\t                    affected.append(claim_id)\n   327\t                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n   328\t                        current_affected.append(claim_id)\n   329\t        affected = sorted(set(affected))\n   330\t        task_id = f\"cancellation-financial:{cancellation_id}\"\n   331\t        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n   332\t        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n   333\t        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n   334\t        queue = domain[\"repair_queue\"]\n   335\t        if task_id not in queue[\"items\"]:\n   336\t            _open_issue_for_subject(\n   337\t                queue, item_id=task_id,\n   338\t                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n   339\t                revision=target_revision, refs=refs, reason=reason,\n   340\t                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n   341\t            )\n   342\t        else:\n   343\t            item = queue[\"items\"][task_id]\n   344\t            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n   345\t            changes = {}\n   346\t            if additions != item[\"source_refs\"]:\n   347\t                changes[\"source_refs\"] = additions\n   348\t            if changes:\n   349\t                update_repair_item(\n   350\t                    queue, item_id=task_id,\n   351\t                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n   352\t                    run_id=run_id, batch_id=batch_id, **changes,\n   353\t                )\n   354\t        cancellation_issue = task_id\n   355\t        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n   356\t        if not trip_id or not trip_revision or not requested_at:\n   357\t            domain.setdefault(\"projection_issues\", []).append({\n   358\t                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n   359\t                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n   360\t                \"owner\": \"Travel Administration Lead\",\n   361\t                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n   362\t            })\n   363\t            continue\n   364\t        snapshot_rows.append({\n   365\t            \"cancellation_id\": cancellation_id,\n   366\t            \"target_type\": target[\"subject_type\"],\n   367\t            \"trip_id\": str(trip_id),\n   368\t            \"trip_revision\": trip_revision,\n   369\t            \"permit_id\": str(permit_id) if permit_id else None,\n   370\t            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n   371\t            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n   372\t            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n   373\t            \"requested_at\": requested_at,\n   374\t            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n   375\t            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n   376\t            \"affected_claim_ids\": affected,\n   377\t            \"source_refs\": refs,\n   378\t            \"original_request_ids\": sorted({row_values(r).get(\"Request reference\") for r in domain[\"finance_records\"]\n   379\t                if row_values(r).get(\"Claim reference\") in affected and row_values(r).get(\"Request reference\")}),\n   380\t            \"financial_status\": \"unresolved\",\n   381\t            \"next_owner\": \"Finance\",\n   382\t            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n   383\t            \"issue_record_ids\": [cancellation_issue],\n   384\t        })\n   385\t        # Finance dispositions are explicit claim/revision/cancellation-bound source\n   386\t        # statements. They do not establish the missing policy or closure authority.\n   387\t        dispositions = []\n   388\t        for claim_id in affected:\n   389\t            for revision in claim_revisions[claim_id][\"revisions\"]:\n   390\t                value = _page_values(revision[\"record\"])\n   391\t                if (value.get(\"Travel cancellation reference\") == cancellation_id\n   392\t                        and value.get(\"Applies to claim\") == claim_id\n   393\t                        and str(value.get(\"Applies to revision\")) == str(revision[\"revision\"])\n   394\t                        and value.get(\"Authorizing Finance officer\")\n   395\t                        and value.get(\"Allowed original amount\") is not None):\n   396\t                    dispositions.append({\"claim_id\": claim_id, \"revision\": revision[\"revision\"],\n   397\t                        \"finance_officer\": value[\"Authorizing Finance officer\"],\n   398\t                        \"expense_reference\": value.get(\"Expense reference\"),\n   399\t                        \"allowed_original_amount\": value[\"Allowed original amount\"],\n   400\t                        \"reason\": value.get(\"Exception reason\"), \"source_ref\": _ref_text(revision[\"source_ref\"])})\n   401\t        if dispositions:\n   402\t            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n   403\t            changes = {\n   404\t                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n   405\t                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n   406\t                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n   407\t            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n   408\t            if changes:\n   409\t                update_repair_item(queue, item_id=task_id,\n   410\t                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n   411\t        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n   412\t                 if row_values(r).get(\"Trip reference\") == trip_id\n   413\t                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n   414\t        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n   415\t        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n   416\t        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n   417\t        actors_ok = bool(employee and supervisor\n   418\t            and request_values.get(\"Acting employee or supervisor\") == employee\n   419\t            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n   420\t        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n   421\t        if not actors_ok:\n   422\t            _open_issue_for_subject(queue, item_id=f\"cancellation-authority:{cancellation_id}\",\n   423\t                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]), revision=target_revision,\n   424\t                refs=refs + actor_refs, reason=\"Employee initiation and supervisor confirmation not fully verified\",\n   425\t                owner=\"Travel Administration Lead\", next_action=\"Verify the actors against the exact trip employee and People supervisor record\",\n   426\t                run_id=run_id, batch_id=batch_id)\n   427\t        actor_item = f\"cancellation-authority:{cancellation_id}\"\n   428\t        if actor_item in queue[\"items\"]:\n   429\t            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n   430\t                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n   431\t        domain[\"cancellation_evidence\"][cancellation_id] = {\n   432\t            \"current_claim_ids\": sorted(set(current_affected)),\n   433\t            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n   434\t            \"history\": deepcopy(process[\"history\"]),\n   435\t            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n   436\t            \"dispositions\": dispositions,\n   437\t            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n   438\t            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n   439\t        }\n   440\t    return snapshot_rows\n   441\t\n   442\t\n   130\t\n   131\t\n   132\tdef assess_payload(source: NativeSource, body: bytes) -> tuple[str, str | None, str | None, list[str]]:\n   133\t    \"\"\"Check accessible scope; a Notion HTML fragment never proves a full policy read.\"\"\"\n   134\t    usable, suffix, reason = _validate_payload(source, body)\n   135\t    if not usable:\n   136\t        return \"unavailable\", None, reason, [source.title]\n   137\t    if source.kind == \"notion\":\n   138\t        return \"partial\", suffix, \"Policy-related HTML accessed, but complete native Notion page content is not established\", [\"Complete authoritative policy page body and all relevant blocks\"]\n   139\t    try:\n   140\t        if source.kind == \"pdf\":\n   141\t            from pypdf import PdfReader\n   142\t            reader = PdfReader(io.BytesIO(body), strict=True)\n   143\t            if reader.is_encrypted or not reader.pages:\n   144\t                raise ValueError(\"PDF has no accessible pages or is encrypted\")\n   145\t            # Traverse every page, not just the signature/trailer. Raw bytes are\n   146\t            # retained even where text extraction cannot read scanned content.\n   147\t            texts = [(page.extract_text(extraction_mode=\"layout\") or \"\") if \"/Contents\" in page else \"\" for page in reader.pages]\n   148\t            if any(not text.strip() for text in texts):\n   149\t                return \"partial\", suffix, \"One or more PDF pages have no extractable text; visual/OCR verification required\", [\"Readable text or verified visual transcription of every PDF page\"]\n   150\t        elif source.kind == \"xlsx\":\n   151\t            from openpyxl import load_workbook\n   152\t            workbook = load_workbook(io.BytesIO(body), data_only=False, read_only=False)\n   153\t            missing = sorted(WORKBOOK_TABS - set(workbook.sheetnames))\n   154\t            workbook.close()\n   155\t            if missing:\n   156\t                return \"partial\", suffix, \"Workbook export lacks required retained-source tabs\", missing\n   157\t    except Exception as exc:\n   158\t        return \"unavailable\", None, f\"Native document validation failed: {type(exc).__name__}: {exc}\", [source.title]\n   159\t    return \"read\", suffix, None, []\n   160\t\n   161\t\n   162\tdef capture_sources(\n   163\t    run_dir: Path, *, run_id: str, case_clock: str | None,\n   164\t    source_specs: tuple[NativeSource, ...] = SOURCES,\n   165\t    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\n   166\t    observed_at: Callable[[], str] = _utc_now, timeout: float = 30.0,\n   167\t) -> dict:\n   168\t    \"\"\"Attempt fresh requests; retain every returned body, including error evidence.\n   169\t\n   170\t    A new, empty run directory is required. There is no retained-input option.\n   171\t    Observation timestamps are retrieval facts, never the scenario case clock.\n   172\t    \"\"\"\n   173\t    if not run_id or Path(run_id).name != run_id or run_id in {\".\", \"..\"}:\n   174\t        raise ValueError(\"run_id must be a single safe path component\")\n   175\t    if run_dir.name != run_id:\n   176\t        raise ValueError(\"run_dir basename must equal run_id\")\n   177\t    if timeout <= 0:\n   178\t        raise ValueError(\"timeout must be positive\")\n   179\t    if case_clock is not None:\n   180\t        try:\n   181\t            clock = datetime.fromisoformat(case_clock.replace(\"Z\", \"+00:00\"))\n   182\t            if clock.utcoffset() is None:\n   183\t                raise ValueError(\"timezone required\")\n   184\t        except (ValueError, AttributeError, TypeError) as exc:\n   185\t            raise ValueError(\"case_clock must be an explicit date/time with timezone, never an observation default\") from exc\n   186\t    if set(source_specs) != set(SOURCES) or len(source_specs) != 5:\n   187\t        raise ValueError(\"Every live capture must attempt exactly all five original source identities and URLs\")\n   188\t    if run_dir.exists() and any(run_dir.iterdir()):\n   189\t        raise FileExistsError(f\"Refusing to reuse nonempty run directory: {run_dir}\")\n   190\t    run_dir.mkdir(parents=True, exist_ok=True)\n   191\t    manifest_path = run_dir / \"sources.json\"\n   192\t    (run_dir / \"sources\").mkdir()\n   193\t    (run_dir / \"responses\").mkdir()\n   194\t    entries = []\n   195\t    for source in source_specs:\n   196\t        started = observed_at()\n   197\t        attempted = source.export_url or source.url\n   198\t        body, headers, final_url, status_code, failure = None, {}, None, None, None\n   199\t        try:\n   200\t            body, headers, final_url = fetch(attempted, timeout)\n    15\tdef run_live_sources(run_dir: Path, *, run_id: str, case_clock: str | None, **capture_options) -> dict:\n    16\t    \"\"\"Always capture all five URLs into a new directory before reading inputs.\"\"\"\n    17\t    manifest = capture_sources(run_dir, run_id=run_id, case_clock=case_clock, **capture_options)\n    18\t    errors = verify_source_manifest(run_dir)\n    19\t    parsed = None\n    20\t    if not errors:\n    21\t        try:\n    22\t            parsed = parse_retained_run(run_dir)\n    23\t        except Exception as exc:\n    24\t            errors.append(f\"Native transcription failed: {type(exc).__name__}: {exc}\")\n    25\t    checks = [{'check': 'manifest-integrity', 'status': 'FAIL' if errors else 'PASS',\n    26\t               'evidence': 'sources.json', 'detail': '; '.join(errors) or 'Fresh observations and retained bytes verified',\n    27\t               'next_action': 'Repair retrieval/transcription integrity in a new run' if errors else 'No integrity repair needed'}]\n    28\t    for row in manifest['files']:\n    29\t        checks.append({'check': f\"source:{row['source_id']}\", 'status': 'PASS' if row['status'] == 'read' else 'BLOCKED',\n    30\t                       'evidence': row['path'] or row['observation']['response_path'] or 'sources.json',\n    31\t                       'detail': row['error'] or 'Complete supported export read; retained bytes bound by SHA-256',\n    32\t                       'next_action': 'Obtain authorized native content and retry in a new run' if row['status'] != 'read' else 'Retain observed source version and wording'})\n    33\t    for issue in (parsed or {}).get('transcription_issues', []):\n    34\t        checks.append({'check': f\"transcription:{issue['source_id']}\", 'status': 'BLOCKED',\n    35\t                       'evidence': issue['path'], 'detail': issue['error'], 'next_action': issue['next_action']})\n    36\t    checks.append({'check': 'authoritative-case-clock', 'status': 'PASS' if case_clock else 'BLOCKED',\n    37\t                   'evidence': 'sources.json', 'detail': 'Caller-supplied scenario clock' if case_clock else 'No authoritative case clock supplied; retrieval timestamps are not scenario time',\n    38\t                   'next_action': 'Verify supplied authority before batch consumption' if case_clock else 'Obtain explicit date, time and timezone from the exercise facilitator'})\n    39\t    checks.append({'check': 'native-policy-processing', 'status': 'BLOCKED', 'evidence': 'sources.json',\n    40\t                   'detail': 'Complete native policy rule interpretation and final business compliance are not established by acquisition',\n    41\t                   'next_action': 'Obtain the full authoritative policy and validate rule coverage before policy-dependent processing'})\n    42\t    capture_complete = all(row['status'] == 'read' for row in manifest['files'])\n    43\t    status = 'FAIL' if errors else 'BLOCKED' if any(c['status'] == 'BLOCKED' for c in checks) else 'PASS'\n    44\t    report = {'schema_version': 'travel-claim-live-run/1', 'run_id': run_id, 'mode': 'live-source-attempt',\n    45\t              'status': status, 'fresh_reads_attempted': len(manifest['files']), 'cache_fallback_used': False,\n    46\t              'acquisition_status': 'PASS' if capture_complete and not errors else 'FAIL' if errors else 'BLOCKED',\n    47\t              'final_live_source_compliance': False, 'batches_consumed': [],\n    48\t              'source_manifest': {'path': 'sources.json', 'sha256': sha256_bytes((run_dir / 'sources.json').read_bytes())},\n    49\t              'parsed_records': {'path': 'parsed-records.json', 'sha256': sha256_bytes((run_dir / 'parsed-records.json').read_bytes())} if parsed else None,\n    50\t              'arrival_batches_observed': (parsed or {}).get('arrival_batches', []), 'checks': checks}\n    51\t    with (run_dir / 'live-run.json').open('x', encoding='utf-8') as stream:\n    52\t        stream.write(json.dumps(report, indent=2, ensure_ascii=False) + '\\n')\n    53\t    lines = ['# Project D fresh native-source attempt', '', f\"**{status}** — `{run_id}`; mode: `live-source-attempt`.\", '',\n    54\t             'All five original source locations were attempted in this invocation using native HTTP/export routes. '\n\"\"\"Synthetic fixtures for policy-independent financial reconciliation.\"\"\"\n\nfrom copy import deepcopy\n\nfrom travel_claim.finance import reconcile_finance_events\n\n\ndef _finance_row(row, event_id, event_type, *, batch=1, claim=\"C-SYN-01\", amount=None,\n                 obligation=None, original=None, currency=\"EUR\"):\n    values = {\n        \"Activity reference\": event_id,\n        \"Arrival batch\": batch,\n        \"Activity type\": event_type,\n        \"Claim reference\": claim,\n        \"Currency\": currency,\n        \"Reason\": f\"SYNTHETIC fixture {event_type}\",\n    }\n    if amount is not None:\n        values[\"Amount (EUR)\"] = amount\n    if obligation is not None:\n        values[\"Obligation (EUR)\"] = obligation\n    if original is not None:\n        values[\"Original activity reference\"] = original\n    return {\n        \"source_id\": \"synthetic-finance-ledger\",\n        \"source_sha256\": \"c\" * 64,\n        \"locator\": f\"synthetic tab 'Finance activity', row {row}\",\n        \"row\": row,\n        \"values\": {\n            key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n            for key, value in values.items()\n        },\n    }\n\n\ndef _obligation(amount=15_000, revision=1):\n    return {\"amount_cents\": amount, \"claim_revision\": revision, \"source_refs\": [\"synthetic:authorization#1\"]}\n\n\ndef test_payments_refunds_obligations_and_pending_transfers_are_separate():\n    events = [\n        _finance_row(1, \"F-SYN-ACCEPT\", \"accepted\", obligation=150.00),\n        _finance_row(2, \"F-SYN-PAY-1\", \"settled\", amount=100.01),\n        _finance_row(3, \"F-SYN-PAY-2\", \"settled\", amount=50.00),\n        _finance_row(4, \"F-SYN-REFUND\", \"refund\", amount=20.00, original=\"F-SYN-PAY-1\"),\n        _finance_row(5, \"F-SYN-PENDING\", \"transfer_pending\", amount=79.99),\n    ]\n    result = reconcile_finance_events(\n        events,\n        claim_id=\"C-SYN-01\",\n        current_revision=1,\n        authorized_obligation=_obligation(),\n        source_classifications={\"transfer_pending\": \"pending_transfer\"},\n    )\n    assert result[\"finance_obligation_events\"][0][\"obligation_cents\"] == 15_000\n    assert result[\"authorized_obligation\"][\"amount_cents\"] == 15_000\n    assert result[\"confirmed_payment_cents\"] == 15_001\n    assert result[\"confirmed_refund_cents\"] == 2_000\n    assert result[\"net_confirmed_cents\"] == 13_001\n    assert result[\"balance_cents\"] == 1_999\n    assert result[\"pending_transfer_event_ids\"] == [\"F-SYN-PENDING\"]\n    assert \"F-SYN-PENDING\" not in result[\"confirmed_payment_event_ids\"]\n    assert result[\"event_history\"][0][\"source_record\"][\"Activity type\"] == \"accepted\"\n    assert result[\"event_history\"][3][\"original_activity_id\"] == \"F-SYN-PAY-1\"\n\n\ndef test_replay_is_idempotent_and_keeps_each_occurrence_source_trace():\n    payment = _finance_row(5, \"F-SYN-PAY\", \"settled\", batch=1, amount=10.00)\n    replay = _finance_row(22, \"F-SYN-PAY\", \"settled\", batch=4, amount=10.00)\n    result = reconcile_finance_events(\n        [payment, replay], claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"event_ids\"] == [\"F-SYN-PAY\", \"F-SYN-PAY\"]\n    assert len(result[\"event_history\"]) == 2\n    assert len(result[\"confirmed_payment_event_ids\"]) == 1\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"duplicate_events\"][0][\"delivery_batches\"] == [1, 4]\n    assert [item[\"source_ref\"][\"locator\"] for item in result[\"event_history\"]] == [\n        \"synthetic tab 'Finance activity', row 5\",\n        \"synthetic tab 'Finance activity', row 22\",\n    ]\n\n\ndef test_conflicting_duplicate_ids_and_unknown_events_open_owner_grouped_issues():\n    events = [\n        _finance_row(1, \"F-SYN-CONFLICT\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-CONFLICT\", \"settled\", amount=11.00, batch=2),\n        _finance_row(3, \"F-SYN-UNKNOWN\", \"mystery_state\", amount=20.00),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(), owner=\"FIN-SYN-01\",\n    )\n    assert result[\"conflicting_events\"][0][\"event_id\"] == \"F-SYN-CONFLICT\"\n    assert len(result[\"conflicting_events\"][0][\"source_refs\"]) == 2\n    assert result[\"confirmed_payment_cents\"] == 0\n    assert result[\"balance_cents\"] is None\n    assert result[\"unresolved_event_ids\"] == [\"F-SYN-UNKNOWN\"]\n    assert list(result[\"repair_issues_by_owner\"]) == [\"FIN-SYN-01\"]\n    assert {issue[\"record_id\"] for issue in result[\"repair_issues_by_owner\"][\"FIN-SYN-01\"]} == {\n        \"finance-event-conflict:F-SYN-CONFLICT\", \"finance-unresolved:F-SYN-UNKNOWN\",\n    }\n    assert all(issue[\"source_refs\"] for issue in result[\"repair_issues\"])\n\n\ndef test_refund_must_link_to_known_payment_and_cannot_exceed_it():\n    events = [\n        _finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00),\n        _finance_row(2, \"F-SYN-REFUND\", \"refund\", amount=10.01, original=\"F-SYN-PAY\"),\n        _finance_row(3, \"F-SYN-REFUND-ORPHAN\", \"refund\", amount=1.00, original=\"F-NOT-FOUND\"),\n    ]\n    result = reconcile_finance_events(\n        events, claim_id=\"C-SYN-01\", current_revision=1,\n        authorized_obligation=_obligation(amount=1_000),\n    )\n    assert result[\"confirmed_payment_cents\"] == 1_000\n    assert result[\"confirmed_refund_cents\"] == 0\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert set(result[\"unresolved_event_ids\"]) == {\"F-SYN-REFUND\", \"F-SYN-REFUND-ORPHAN\"}\n\n\ndef test_revision_correction_preserves_history_invalidates_prior_and_rejects_stale_authorization():\n    prior = {\n        \"claim_revision\": 1,\n        \"net_confirmed_cents\": 10_000,\n        \"balance_cents\": 5_000,\n        \"event_history\": [{\"event_id\": \"F-SYN-PAY\", \"source_ref\": \"prior\"}],\n    }\n    prior_copy = deepcopy(prior)\n    revisions = [\n        {\"revision\": 1, \"source_ref\": \"synthetic:claim#1\"},\n        {\"revision\": 2, \"source_ref\": \"synthetic:claim#2\"},\n    ]\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=100.00)],\n        claim_id=\"C-SYN-01\",\n        current_revision=2,\n        authorized_obligation=_obligation(amount=15_000, revision=1),\n        revision_history=revisions,\n        previous_reconciliation=prior,\n    )\n    assert result[\"revision_history\"] == revisions\n    assert result[\"confirmed_payment_cents\"] == 10_000\n    assert result[\"authorized_obligation\"] is None\n    assert result[\"balance_cents\"] is None\n    assert result[\"invalidated_previous_reconciliation\"][\"claim_revision\"] == 1\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-invalid:C-SYN-01:2\"\n    assert prior == prior_copy\n\n\ndef test_unknown_or_missing_authorized_obligation_never_yields_a_balance():\n    result = reconcile_finance_events(\n        [_finance_row(1, \"F-SYN-PAY\", \"settled\", amount=10.00)],\n        claim_id=\"C-SYN-01\", current_revision=1,\n    )\n    assert result[\"net_confirmed_cents\"] == 1_000\n    assert result[\"balance_cents\"] is None\n    assert result[\"repair_issues_by_owner\"][\"Finance\"][0][\"record_id\"] == \"finance-obligation-missing:C-SYN-01:1\"\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Uncapped categories']['value'] = []\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'transport', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\n"},"started_at_ms":1792012243210,"completed_at_ms":1792012243253}}
