in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n    event_context: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\n            and any(previous_reconciliation.get(k) for k in ('confirmed_payment_event_ids', 'confirmed_refund_event_ids',\n                'confirmed_payment_cents', 'confirmed_refund_cents', 'net_confirmed_cents'))):\n        raise ValueError('Legacy admission state requires explicit verified migration; refusing to erase or invent admitted money')\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    # Accept full-history or delta calls without dropping earlier raw deliveries.\n    retained = [{**deepcopy(h['source_ref']), 'values': {k: {'value': v} for k, v in h['source_record'].items()}}\n                for h in (previous_reconciliation or {}).get('event_history', []) if isinstance(h.get('source_ref'), dict) and 'source_record' in h]\n    deliveries = []\n    for record in retained + events:\n        if not any(_source_ref(r) == _source_ref(record) and _values(r) == _values(record) for r in deliveries):\n            deliveries.append(record)\n    events = deliveries\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n\ndef source_values(row):\n    return {k: v.get('value') for k, v in row.get('values', {}).items()}\n\n\ndef finance_context(parsed, revisions, events, claim_id, arrival_batch=None):\n    \"\"\"Bind source-observed request IDs to historical claim employees/directory.\n\n    Acceptance is request identity evidence, never reimbursement entitlement.\n    A cash row cannot manufacture its own request binding.\n    \"\"\"\n    records = parsed.get('records', {})\n    people = records.get('people', next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == 'People'), []))\n    bindings = {}\n    seen = set()\n    for event in events:\n        value = source_values(event)\n        if value.get('Activity reference') in seen:\n            continue\n        seen.add(value.get('Activity reference'))\n        if value.get('Claim reference') != claim_id or value.get('Activity type') != 'accepted':\n            continue\n        occurrences = [source_values(r) for r in events if source_values(r).get('Activity reference') == value.get('Activity reference')]\n        try:\n            first_batch = min(int(v['Arrival batch']) for v in occurrences)\n            first = [v for v in occurrences if int(v['Arrival batch']) == first_batch]\n            immutable = lambda v: {k: x for k, x in v.items() if k != 'Arrival batch'}\n            if any(immutable(v) != immutable(first[0]) for v in first):\n                continue  # A conflicted first delivery cannot establish a request.\n            value = first[0]\n            if observation_error(utc_time(value.get('Activity time (UTC)')), parsed.get('event_clock') or parsed.get('case_clock')):\n                continue\n            batch = int(value['Arrival batch'])\n            available = [r for r in revisions if r.get('arrival_batch') is not None and int(r['arrival_batch']) <= batch]\n            revision = max(available, key=lambda r: r['revision'])\n        except (TypeError, ValueError, KeyError):\n            continue\n        employee = next((f['value'] for f in revision['record'].get('fields', []) if f['label'] == 'Employee'), None)\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\n        if len(directory) != 1:\n            continue\n        person = source_values(directory[0])\n        if value.get('Finance officer') != person.get('Finance officer') or value.get('Payee ID') != person.get('Payee ID'):\n            continue\n        if value.get('Currency') != 'EUR':\n            continue\n        request = value.get('Request reference')\n        if not all(text_id(x) for x in (request, person.get('Payee ID'), person.get('Finance officer'))):\n            continue\n        binding = dict(claim_id=claim_id, payee_id=person['Payee ID'], actor=person['Finance officer'], currency='EUR')\n        # Conflicting request ownership is unresolved rather than last-wins.\n        if request in bindings and bindings[request] != binding:\n            bindings[request] = None\n        else:\n            bindings.setdefault(request, binding)\n    for request_row in records.get('reimbursement_requests', []):\n        value = source_values(request_row)\n        batch = value.get('Arrival batch')\n        try:\n            if isinstance(batch, bool) or int(batch) != float(batch) or int(batch) < 1 or arrival_batch is not None and int(batch) > arrival_batch:\n                continue\n        except (TypeError, ValueError, OverflowError):\n            continue\n        matches = [r for r in revisions if r['revision'] == value.get('Revision')]\n        if value.get('Claim reference') != claim_id or len(matches) != 1 or value.get('Currency') != 'EUR':\n            continue\n        employee = next((f['value'] for f in matches[0]['record'].get('fields', []) if f['label'] == 'Employee'), None)\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\n        if len(directory) != 1:\n            continue\n        person = source_values(directory[0]); request = value.get('Request reference')\n        if not text_id(request) or value.get('Payee ID') != person.get('Payee ID'):\n            continue\n        binding = dict(claim_id=claim_id, payee_id=person.get('Payee ID'), actor=person.get('Finance officer'), currency='EUR')\n        if request in bindings and bindings[request] != binding:\n            bindings[request] = None\n        else:\n            bindings.setdefault(request, binding)\n    return {'requests': bindings, 'clock': parsed.get('event_clock') or parsed.get('case_clock')}\n\n\ndef finance_errors(value, classification, context, cents):\n    errors = []\n    if not all(text_id(value.get(k)) for k in ('Activity reference', 'Claim reference', 'Request reference', 'Payee ID', 'Finance officer')):\n        errors.append('missing or malformed event/request/claim/payee/actor identity')\n    binding = (context or {}).get('requests', {}).get(value.get('Request reference'))\n    if not binding:\n        errors.append('request has no unambiguous source-bound directory authority')\n    elif any(value.get(field) != binding.get(key) for field, key in (\n            ('Claim reference', 'claim_id'), ('Payee ID', 'payee_id'), ('Finance officer', 'actor'), ('Currency', 'currency'))):\n        errors.append('request/claim/payee/currency/Finance actor does not match authority')\n    if value.get('Currency') != 'EUR':\n        errors.append('unsupported Finance currency')\n    if classification in {'confirmed_payment', 'confirmed_refund', 'pending_transfer'} or value.get('Amount (EUR)') is not None:\n        amount = cents(value.get('Amount (EUR)'))\n        if amount is None or amount <= 0:\n            errors.append('cash amount must be positive integer cents')\n    if classification in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'} and cents(value.get('Obligation (EUR)')) is None:\n        errors.append('obligation amount lacks exact nonnegative cents')\n    try:\n        error = observation_error(utc_time(value.get('Activity time (UTC)')), (context or {}).get('clock'))\n        if error:\n            errors.append(error)\n    except (ValueError, TypeError):\n        errors.append('invalid UTC event time')\n    return errors\n                next_action=\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\",\n                run_id=run_id, batch_id=batch_id)\n    current_invalid = {i.get('event_id') for i in reduced['issues']}\n    for item_id, item in domain['repair_queue']['items'].items():\n        if item_id.startswith('cancellation-evidence:'):\n            for event_id, record in reduced['admitted_records'].items():\n                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\n                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\n                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        if not record_order:\n            continue  # Orphan evidence remains in cancellation_state and owned issues.\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        current_affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    if claim_rev[\"revision\"] == claim[\"current_revision\"]:\n                        current_affected.append(claim_id)\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n        if actor_item in queue[\"items\"]:\n            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\n                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\n        domain[\"cancellation_evidence\"][cancellation_id] = {\n            \"current_claim_ids\": sorted(set(current_affected)),\n            \"source_refs\": refs + actor_refs + [d[\"source_ref\"] for d in dispositions],\n            \"history\": deepcopy(process[\"history\"]),\n            \"actor_status\": \"PASS\" if actors_ok else \"BLOCKED: verify employee and supervisor against the trip register\",\n            \"dispositions\": dispositions,\n            \"disposition_status\": \"recorded; eligibility and financial completion require recheck\" if dispositions else \"BLOCKED: no cancellation-bound Finance disposition\",\n            \"request_effect\": \"hold payment readiness; retain obligation and cash history\",\n        }\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> None:\n    queue = domain[\"repair_queue\"]\n    blockers = []\n    for conflict in history.get(\"issues\", {}).get(\"repeated_subject_revisions\", []):\n            \"minLength\": 1\n          },\n          \"claim_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"amount_cents\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"payee\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"currency\": {\n            \"const\": \"EUR\"\n          },\n          \"status\": {\n            \"enum\": [\n              \"proposed\",\n              \"accepted\",\n              \"dispatched\",\n              \"cancel-pending\",\n              \"cancelled\",\n              \"settled\",\n              \"held\"\n            ]\n          },\n          \"decision_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          }\n        }\n      }\n    },\n    \"admitted_event_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"uniqueItems\": true,\n      \"description\": \"Admitted Finance activity IDs only. Travel cancellation activity IDs belong exclusively in travel_cancellations[].admitted_cancellation_event_ids; neither kind may invent the other kind of effect.\"\n    },\n    \"issues\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"record_id\",\n          \"reason\",\n          \"owner\",\n          \"resolution_needed\"\n        ],\n        \"properties\": {\n          \"record_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"owner\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"resolution_needed\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n    \"travel_cancellations\": {\n      \"type\": \"array\",\n      \"description\": \"One current row per valid observed cancellation_id, including processes without any claim. Confirmation and financial resolution are separate facts. Invalid orphan deliveries remain in issues and retained sources until a valid initiation establishes a process.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"cancellation_id\",\n          \"target_type\",\n          \"trip_id\",\n          \"trip_revision\",\n          \"permit_id\",\n          \"permit_revision\",\n          \"status\",\n          \"admitted_cancellation_event_ids\",\n          \"requested_at\",\n          \"confirmed_at\",\n          \"effective_at\",\n          \"affected_claim_ids\",\n          \"original_request_ids\",\n"},"started_at_ms":1792063108885,"completed_at_ms":1792063109064}}
{"timestamp":"2026-10-15T11:18:29.538Z","ordinal":4534,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13f48-f9a2-7910-be56-a4fd08422e49","call_id":"call_a9eb9aa93bbe4deb93fcaff61a9bb95d","output":[{"type":"input_text","text":"Script completed\nWall time 0.8 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"934bf6\",\"wall_time_seconds\":0.179313875,\"exit_code\":0,\"original_token_count\":5980,\"output\":\"def _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\\n    \\\"\\\"\\\"Read ledger observations, without deriving reimbursement authorization.\\n\\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\\n    claim revision; arrival context is retained separately from explicit links.\\n    Only the first delivery establishes context; redelivery cannot rebind it.\\n    \\\"\\\"\\\"\\n    groups: dict[str, list[dict]] = defaultdict(list)\\n    for event in history:\\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\\n            groups[event['event_id']].append(event)\\n    records = []\\n    problem = None\\n    for event_id, occurrences in groups.items():\\n        event = occurrences[0]\\n        values = event['source_record']\\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\\n        context_rows = [r for r in revisions if first_batch is not None\\n                        and _positive_integer(r.get('arrival_batch')) is not None\\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\\n        context = max((r['revision'] for r in context_rows), default=None)\\n        explicit = _positive_integer(values.get('Claim revision'))\\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\\n        record = {\\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\\n                                  if r['revision'] == (explicit if matches else context)],\\n        }\\n        records.append(record)\\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\\n                or not all(isinstance(values.get(key), str) and values[key].strip()\\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\\n                or (values.get('Claim revision') is not None and not matches)):\\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\\n    if not records:\\n        return [], None, None\\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\\n    # A single observation needs no ordering assumption. Multiple observations\\n    # require explicit UTC event times; arrival numbers do not define business time.\\n    if len(records) > 1:\\n        try:\\n            def stamp(record):\\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\\n                # The retained header explicitly names UTC even when the cell\\n                # serialization omits an offset.\\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\\n                    raise ValueError('not UTC')\\n                return dt.replace(tzinfo=None)\\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\\n            for left, right in zip(records, records[1:]):\\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\\n                    problem = 'Conflicting obligation amounts have the same event time'\\n        except (ValueError, TypeError, AttributeError):\\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\\n    return records, deepcopy(records[-1]) if not problem else None, problem\\n\\n\\ndef reconcile_finance_events(\\n    events: list[dict[str, Any]],\\n    *,\\n    claim_id: str,\\n    current_revision: int,\\n    authorized_obligation: dict[str, Any] | None = None,\\n    revision_history: list[dict[str, Any]] | None = None,\\n    previous_reconciliation: dict[str, Any] | None = None,\\n    owner: str = \\\"Finance\\\",\\n    source_classifications: dict[str, str] | None = None,\\n    event_context: dict[str, Any] | None = None,\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Reconcile source events for a claim without making policy decisions.\\n\\n    `authorized_obligation` is an independent, already-authorized input of\\n    `{amount_cents, claim_revision, source_refs}`. This function neither\\n    derives nor authorizes it. `source_classifications` may extend the native\\n    workbook vocabulary when a retained source defines another event type;\\n    unrecognized types otherwise remain unresolved.\\n    \\\"\\\"\\\"\\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\\n        raise ValueError(\\\"claim_id and a positive current_revision are required\\\")\\n    if not owner:\\n        raise ValueError(\\\"owner is required for reconciliation issues\\\")\\n    if (previous_reconciliation and 'admitted_events' not in previous_reconciliation\\n            and any(previous_reconciliation.get(k) for k in ('confirmed_payment_event_ids', 'confirmed_refund_event_ids',\\n                'confirmed_payment_cents', 'confirmed_refund_cents', 'net_confirmed_cents'))):\\n        raise ValueError('Legacy admission state requires explicit verified migration; refusing to erase or invent admitted money')\\n\\n    classes = dict(_NATIVE_EVENT_CLASSES)\\n    if source_classifications:\\n        allowed_classes = {\\n            \\\"confirmed_payment\\\", \\\"confirmed_refund\\\", \\\"pending_transfer\\\",\\n            \\\"obligation_accepted\\\", \\\"failed_transfer\\\", \\\"retry_authorization\\\",\\n            \\\"finance_cancellation_requested\\\", \\\"finance_cancelled\\\",\\n            \\\"finance_adjustment\\\", \\\"finance_resolution\\\",\\n        }\\n        for event_type, classification in source_classifications.items():\\n            if not isinstance(event_type, str) or classification not in allowed_classes:\\n                raise ValueError(f\\\"unsupported source event classification: {event_type!r} -> {classification!r}\\\")\\n            classes[event_type] = classification\\n\\n    # Accept full-history or delta calls without dropping earlier raw deliveries.\\n    retained = [{**deepcopy(h['source_ref']), 'values': {k: {'value': v} for k, v in h['source_record'].items()}}\\n                for h in (previous_reconciliation or {}).get('event_history', []) if isinstance(h.get('source_ref'), dict) and 'source_record' in h]\\n    deliveries = []\\n    for record in retained + events:\\n        if not any(_source_ref(r) == _source_ref(record) and _values(r) == _values(record) for r in deliveries):\\n            deliveries.append(record)\\n    events = deliveries\\n\\\"\\\"\\\"Shared evidence checks for Finance and business-cancellation admissions.\\n\\nA calendar-date clock never implies midnight or an end-of-day instant. Events\\non that same local date need an explicit cutoff before admission.\\n\\\"\\\"\\\"\\nfrom datetime import datetime, timezone, date\\nfrom zoneinfo import ZoneInfo\\n\\n\\ndef utc_time(value):\\n    if not isinstance(value, str) or 'T' not in value:\\n        raise ValueError('missing explicit UTC event date/time')\\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\\n        raise ValueError('event timestamp is not UTC')\\n    return stamp.replace(tzinfo=timezone.utc)\\n\\n\\ndef observation_error(stamp, clock):\\n    try:\\n        if isinstance(clock, str):\\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\\n            if cutoff.utcoffset() is None:\\n                return 'case cutoff lacks timezone'\\n            return 'future observation' if stamp > cutoff else None\\n        if isinstance(clock, dict):\\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\\n            case_date = date.fromisoformat(clock['date'])\\n            if local > case_date:\\n                return 'future observation'\\n            if local == case_date:\\n                return 'same-day cutoff is unknown; no time of day inferred'\\n            return None\\n    except (KeyError, TypeError, ValueError):\\n        return 'invalid authoritative event cutoff'\\n    return 'authoritative event cutoff is unavailable'\\n\\n\\ndef text_id(value):\\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\\n\\n\\ndef source_values(row):\\n    return {k: v.get('value') for k, v in row.get('values', {}).items()}\\n\\n\\ndef finance_context(parsed, revisions, events, claim_id, arrival_batch=None):\\n    \\\"\\\"\\\"Bind source-observed request IDs to historical claim employees/directory.\\n\\n    Acceptance is request identity evidence, never reimbursement entitlement.\\n    A cash row cannot manufacture its own request binding.\\n    \\\"\\\"\\\"\\n    records = parsed.get('records', {})\\n    people = records.get('people', next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == 'People'), []))\\n    bindings = {}\\n    seen = set()\\n    for event in events:\\n        value = source_values(event)\\n        if value.get('Activity reference') in seen:\\n            continue\\n        seen.add(value.get('Activity reference'))\\n        if value.get('Claim reference') != claim_id or value.get('Activity type') != 'accepted':\\n            continue\\n        occurrences = [source_values(r) for r in events if source_values(r).get('Activity reference') == value.get('Activity reference')]\\n        try:\\n            first_batch = min(int(v['Arrival batch']) for v in occurrences)\\n            first = [v for v in occurrences if int(v['Arrival batch']) == first_batch]\\n            immutable = lambda v: {k: x for k, x in v.items() if k != 'Arrival batch'}\\n            if any(immutable(v) != immutable(first[0]) for v in first):\\n                continue  # A conflicted first delivery cannot establish a request.\\n            value = first[0]\\n            if observation_error(utc_time(value.get('Activity time (UTC)')), parsed.get('event_clock') or parsed.get('case_clock')):\\n                continue\\n            batch = int(value['Arrival batch'])\\n            available = [r for r in revisions if r.get('arrival_batch') is not None and int(r['arrival_batch']) <= batch]\\n            revision = max(available, key=lambda r: r['revision'])\\n        except (TypeError, ValueError, KeyError):\\n            continue\\n        employee = next((f['value'] for f in revision['record'].get('fields', []) if f['label'] == 'Employee'), None)\\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\\n        if len(directory) != 1:\\n            continue\\n        person = source_values(directory[0])\\n        if value.get('Finance officer') != person.get('Finance officer') or value.get('Payee ID') != person.get('Payee ID'):\\n            continue\\n        if value.get('Currency') != 'EUR':\\n            continue\\n        request = value.get('Request reference')\\n        if not all(text_id(x) for x in (request, person.get('Payee ID'), person.get('Finance officer'))):\\n            continue\\n        binding = dict(claim_id=claim_id, payee_id=person['Payee ID'], actor=person['Finance officer'], currency='EUR')\\n        # Conflicting request ownership is unresolved rather than last-wins.\\n        if request in bindings and bindings[request] != binding:\\n            bindings[request] = None\\n        else:\\n            bindings.setdefault(request, binding)\\n    for request_row in records.get('reimbursement_requests', []):\\n        value = source_values(request_row)\\n        batch = value.get('Arrival batch')\\n        try:\\n            if isinstance(batch, bool) or int(batch) != float(batch) or int(batch) < 1 or arrival_batch is not None and int(batch) > arrival_batch:\\n                continue\\n        except (TypeError, ValueError, OverflowError):\\n            continue\\n        matches = [r for r in revisions if r['revision'] == value.get('Revision')]\\n        if value.get('Claim reference') != claim_id or len(matches) != 1 or value.get('Currency') != 'EUR':\\n            continue\\n        employee = next((f['value'] for f in matches[0]['record'].get('fields', []) if f['label'] == 'Employee'), None)\\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\\n        if len(directory) != 1:\\n            continue\\n        person = source_values(directory[0]); request = value.get('Request reference')\\n        if not text_id(request) or value.get('Payee ID') != person.get('Payee ID'):\\n            continue\\n        binding = dict(claim_id=claim_id, payee_id=person.get('Payee ID'), actor=person.get('Finance officer'), currency='EUR')\\n        if request in bindings and bindings[request] != binding:\\n            bindings[request] = None\\n        else:\\n            bindings.setdefault(request, binding)\\n    return {'requests': bindings, 'clock': parsed.get('event_clock') or parsed.get('case_clock')}\\n\\n\\ndef finance_errors(value, classification, context, cents):\\n    errors = []\\n    if not all(text_id(value.get(k)) for k in ('Activity reference', 'Claim reference', 'Request reference', 'Payee ID', 'Finance officer')):\\n        errors.append('missing or malformed event/request/claim/payee/actor identity')\\n    binding = (context or {}).get('requests', {}).get(value.get('Request reference'))\\n    if not binding:\\n        errors.append('request has no unambiguous source-bound directory authority')\\n    elif any(value.get(field) != binding.get(key) for field, key in (\\n            ('Claim reference', 'claim_id'), ('Payee ID', 'payee_id'), ('Finance officer', 'actor'), ('Currency', 'currency'))):\\n        errors.append('request/claim/payee/currency/Finance actor does not match authority')\\n    if value.get('Currency') != 'EUR':\\n        errors.append('unsupported Finance currency')\\n    if classification in {'confirmed_payment', 'confirmed_refund', 'pending_transfer'} or value.get('Amount (EUR)') is not None:\\n        amount = cents(value.get('Amount (EUR)'))\\n        if amount is None or amount <= 0:\\n            errors.append('cash amount must be positive integer cents')\\n    if classification in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'} and cents(value.get('Obligation (EUR)')) is None:\\n        errors.append('obligation amount lacks exact nonnegative cents')\\n    try:\\n        error = observation_error(utc_time(value.get('Activity time (UTC)')), (context or {}).get('clock'))\\n        if error:\\n            errors.append(error)\\n    except (ValueError, TypeError):\\n        errors.append('invalid UTC event time')\\n    return errors\\n                next_action=\\\"Obtain a consistent employee initiation and linked supervisor confirmation with explicit UTC times\\\",\\n                run_id=run_id, batch_id=batch_id)\\n    current_invalid = {i.get('event_id') for i in reduced['issues']}\\n    for item_id, item in domain['repair_queue']['items'].items():\\n        if item_id.startswith('cancellation-evidence:'):\\n            for event_id, record in reduced['admitted_records'].items():\\n                if item_id.startswith(f'cancellation-evidence:{event_id}:') and event_id not in current_invalid:\\n                    record_evidence_validation(domain['repair_queue'], item_id=item_id, supported=True,\\n                        source_refs=[_ref_text(_ref(record))], run_id=run_id, batch_id=batch_id)\\n    claim_revisions = _subject_claim_revisions(history)\\n    snapshot_rows = []\\n    for cancellation_id, process in sorted(reduced[\\\"processes\\\"].items()):\\n        target = process[\\\"target\\\"]\\n        target_revision = target.get(\\\"revision\\\")\\n        if (target.get(\\\"subject_type\\\") not in {\\\"trip\\\", \\\"permit\\\"} or not target.get(\\\"subject_id\\\")\\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\\n            domain[\\\"projection_issues\\\"].append({\\n                \\\"record_id\\\": f\\\"cancellation-projection:{cancellation_id}\\\",\\n                \\\"reason\\\": \\\"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\\\",\\n                \\\"owner\\\": \\\"Travel Administration Lead\\\",\\n                \\\"resolution_needed\\\": \\\"verify the cancellation target and revision in the native workbook\\\",\\n            })\\n            continue\\n        record_order = process[\\\"activity_ids\\\"]\\n        if not record_order:\\n            continue  # Orphan evidence remains in cancellation_state and owned issues.\\n        request_id = record_order[0]\\n        request = raw_by_id[request_id]\\n        request_values = row_values(request)\\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\\n                             if row_values(raw_by_id[event_id]).get(\\\"Action\\\") == \\\"confirmed\\\"), None)\\n        confirmation_values = row_values(confirmation) if confirmation else {}\\n        trip_id = request_values.get(\\\"Trip reference\\\")\\n        trip_revision = _as_batch(request_values.get(\\\"Trip revision\\\"))\\n        permit_id = request_values.get(\\\"Permit reference\\\") if target[\\\"subject_type\\\"] == \\\"permit\\\" else None\\n        permit_revision = request_values.get(\\\"Permit revision\\\") if target[\\\"subject_type\\\"] == \\\"permit\\\" else None\\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\\n        affected = []\\n        current_affected = []\\n        for claim_id, claim in claim_revisions.items():\\n            for claim_rev in claim[\\\"revisions\\\"]:\\n                if target[\\\"subject_type\\\"] == \\\"trip\\\":\\n                    matches = claim_rev.get(\\\"trip_id\\\") == target[\\\"subject_id\\\"] and claim_rev.get(\\\"trip_revision\\\") == target[\\\"revision\\\"]\\n                else:\\n                    trip_index = history.get(\\\"trip\\\", {}).get(str(claim_rev.get(\\\"trip_id\\\")), {})\\n                    matches = any(\\n                        trip_rev.get(\\\"revision\\\") == claim_rev.get(\\\"trip_revision\\\")\\n                        and trip_rev.get(\\\"permit_id\\\") == target[\\\"subject_id\\\"]\\n                        and trip_rev.get(\\\"permit_revision\\\") == target[\\\"revision\\\"]\\n                        for trip_rev in trip_index.get(\\\"revisions\\\", [])\\n                    )\\n                if matches:\\n                    affected.append(claim_id)\\n                    if claim_rev[\\\"revision\\\"] == claim[\\\"current_revision\\\"]:\\n                        current_affected.append(claim_id)\\n        affected = sorted(set(affected))\\n        task_id = f\\\"cancellation-financial:{cancellation_id}\\\"\\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\\n        reason = \\\"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\\\"\\n        next_action = \\\"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\\\"\\n        queue = domain[\\\"repair_queue\\\"]\\n        if task_id not in queue[\\\"items\\\"]:\\n            _open_issue_for_subject(\\n                queue, item_id=task_id,\\n                subject_type=target[\\\"subject_type\\\"], subject_id=str(target[\\\"subject_id\\\"]),\\n                revision=target_revision, refs=refs, reason=reason,\\n        if actor_item in queue[\\\"items\\\"]:\\n            record_evidence_validation(queue, item_id=actor_item, supported=actors_ok,\\n                source_refs=refs + actor_refs, run_id=run_id, batch_id=batch_id)\\n        domain[\\\"cancellation_evidence\\\"][cancellation_id] = {\\n            \\\"current_claim_ids\\\": sorted(set(current_affected)),\\n            \\\"source_refs\\\": refs + actor_refs + [d[\\\"source_ref\\\"] for d in dispositions],\\n            \\\"history\\\": deepcopy(process[\\\"history\\\"]),\\n            \\\"actor_status\\\": \\\"PASS\\\" if actors_ok else \\\"BLOCKED: verify employee and supervisor against the trip register\\\",\\n            \\\"dispositions\\\": dispositions,\\n            \\\"disposition_status\\\": \\\"recorded; eligibility and financial completion require recheck\\\" if dispositions else \\\"BLOCKED: no cancellation-bound Finance disposition\\\",\\n            \\\"request_effect\\\": \\\"hold payment readiness; retain obligation and cash history\\\",\\n        }\\n    return snapshot_rows\\n\\n\\ndef _sync_decision_and_revision_issues(\\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\\n) -> None:\\n    queue = domain[\\\"repair_queue\\\"]\\n    blockers = []\\n    for conflict in history.get(\\\"issues\\\", {}).get(\\\"repeated_subject_revisions\\\", []):\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"claim_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"revision\\\": {\\n            \\\"type\\\": \\\"integer\\\",\\n            \\\"minimum\\\": 1\\n          },\\n          \\\"amount_cents\\\": {\\n            \\\"type\\\": \\\"integer\\\",\\n            \\\"minimum\\\": 0\\n          },\\n          \\\"payee\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"currency\\\": {\\n            \\\"const\\\": \\\"EUR\\\"\\n          },\\n          \\\"status\\\": {\\n            \\\"enum\\\": [\\n              \\\"proposed\\\",\\n              \\\"accepted\\\",\\n              \\\"dispatched\\\",\\n              \\\"cancel-pending\\\",\\n              \\\"cancelled\\\",\\n              \\\"settled\\\",\\n              \\\"held\\\"\\n            ]\\n          },\\n          \\\"decision_ids\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"minLength\\\": 1\\n            },\\n            \\\"uniqueItems\\\": true\\n          }\\n        }\\n      }\\n    },\\n    \\\"admitted_event_ids\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"items\\\": {\\n        \\\"type\\\": \\\"string\\\",\\n        \\\"minLength\\\": 1\\n      },\\n      \\\"uniqueItems\\\": true,\\n      \\\"description\\\": \\\"Admitted Finance activity IDs only. Travel cancellation activity IDs belong exclusively in travel_cancellations[].admitted_cancellation_event_ids; neither kind may invent the other kind of effect.\\\"\\n    },\\n    \\\"issues\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"items\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"required\\\": [\\n          \\\"record_id\\\",\\n          \\\"reason\\\",\\n          \\\"owner\\\",\\n          \\\"resolution_needed\\\"\\n        ],\\n        \\\"properties\\\": {\\n          \\\"record_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"reason\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"owner\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"resolution_needed\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          }\\n        }\\n      }\\n    },\\n    \\\"travel_cancellations\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"description\\\": \\\"One current row per valid observed cancellation_id, including processes without any claim. Confirmation and financial resolution are separate facts. Invalid orphan deliveries remain in issues and retained sources until a valid initiation establishes a process.\\\",\\n      \\\"items\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"required\\\": [\\n          