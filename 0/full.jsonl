one, fetch=lambda *_: pytest.fail(\\\"must not fetch\\\"))\\n    assert (run_dir / \\\"sources.json\\\").read_bytes() == before\\n\\n\\ndef test_manifest_verification_detects_retained_source_corruption(tmp_path):\\n    run_dir, manifest, _ = _capture(tmp_path)\\n    read_record = next(row for row in manifest[\\\"files\\\"] if row[\\\"status\\\"] == \\\"read\\\")\\n    (run_dir / read_record[\\\"path\\\"]).write_bytes(b\\\"changed\\\")\\n    assert any(\\\"hash mismatch\\\" in error for error in verify_source_manifest(run_dir))\\n\\n\\ndef test_snapshot_seals_source_and_predecessor_hashes_and_is_immutable(tmp_path):\\n    run_dir, _, _ = _capture(tmp_path)\\n    first = seal_batch_snapshot(\\n        run_dir,\\n        run_id=\\\"run-1\\\",\\n        batch_id=\\\"arrival-001\\\",\\n        schema_path=SCHEMA,\\n        **_empty_state(),\\n    )\\n    first_bytes = first.read_bytes()\\n    first_obj = json.loads(first_bytes)\\n    assert first_obj[\\\"predecessor\\\"] is None\\n    assert first_obj[\\\"source_binding\\\"][\\\"path\\\"] == \\\"sources.json\\\"\\n    assert first_obj[\\\"source_binding\\\"][\\\"sha256\\\"] == hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\\n\\n    second = seal_batch_snapshot(\\n        run_dir,\\n        run_id=\\\"run-1\\\",\\n        batch_id=\\\"arrival-002\\\",\\n        schema_path=SCHEMA,\\n        predecessor_path=first,\\n        **_empty_state(),\\n    )\\n    second_obj = json.loads(second.read_bytes())\\n    assert second_obj[\\\"predecessor\\\"] == {\\n        \\\"path\\\": f\\\"batches/{first.name}\\\",\\n        \\\"sha256\\\": hashlib.sha256(first_bytes).hexdigest(),\\n    }\\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\\n    with pytest.raises(ValueError, match=\\\"complete retained snapshot chain\\\"):\\n        seal_batch_snapshot(\\n            run_dir,\\n            run_id=\\\"run-1\\\",\\n            batch_id=\\\"fork\\\",\\n            schema_path=SCHEMA,\\n            predecessor_path=first,\\n            **_empty_state(),\\n        )\\n    with pytest.raises(FileExistsError):\\n        seal_batch_snapshot(\\n            run_dir,\\n            run_id=\\\"run-1\\\",\\n            batch_id=\\\"arrival-001\\\",\\n            schema_path=SCHEMA,\\n            **_empty_state(),\\n        )\\n    assert first.read_bytes() == first_bytes\\n\\n\\ndef test_snapshot_verification_detects_corrupt_predecessor_and_source_manifest(tmp_path):\\n    run_dir, _, _ = _capture(tmp_path)\\n    first = seal_batch_snapshot(run_dir, run_id=\\\"run-1\\\", batch_id=\\\"a1\\\", schema_path=SCHEMA, **_empty_state())\\n    second = seal_batch_snapshot(\\n        run_dir, run_id=\\\"run-1\\\", batch_id=\\\"a2\\\", schema_path=SCHEMA, predecessor_path=first, **_empty_state()\\n    )\\n    first.write_text(\\\"corrupt\\\", encoding=\\\"utf-8\\\")\\n    assert any(\\\"predecessor SHA-256\\\" in e for e in verify_snapshot(second, run_dir, SCHEMA))\\n    first.write_bytes(json.dumps(json.loads(second.read_text(encoding=\\\"utf-8\\\"))).encode())\\n    with (run_dir / \\\"sources.json\\\").open(\\\"ab\\\") as stream:\\n        stream.write(b\\\" \\\")\\n    assert any(\\\"source_binding SHA-256\\\" in e for e in verify_snapshot(second, run_dir, SCHEMA))\\n\\n\\ndef test_snapshot_checks_issue_references_and_finance_cancellation_separation(tmp_path):\\n    run_dir, _, _ = _capture(tmp_path)\\n    bad = _empty_state()\\n    bad[\\\"travel_cancellations\\\"] = [{\\n        \\\"cancellation_id\\\": \\\"X1\\\",\\n        \\\"target_type\\\": \\\"trip\\\",\\n        \\\"trip_id\\\": \\\"T1\\\",\\n        \\\"trip_revision\\\": 1,\\n        \\\"permit_id\\\": None,\\n        \\\"permit_revision\\\": None,\\n\\\"\\\"\\\"Loss-aware parsing of retained Project D source files.\\n\\nParsing here transcribes source material and adds locators. It does not decide\\npolicy eligibility, entitlement, approval readiness, or payment completion.\\nOriginal retained files remain authoritative; extracted values always carry a\\nsource ID and a page or workbook-cell locator.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport json\\nimport re\\nfrom datetime import date, datetime, time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom openpyxl import load_workbook\\nfrom pypdf import PdfReader\\n\\nfrom .sources import verify_source_manifest\\n\\nOUTPUT_NAME = \\\"parsed-records.json\\\"\\nRECORD_SCHEMA = \\\"travel-claim-parsed-records/1\\\"\\n\\n\\ndef _scalar(value: Any) -> Any:\\n    if isinstance(value, (datetime, date, time)):\\n        return value.isoformat()\\n    if isinstance(value, (str, int, float, bool)) or value is None:\\n        return value\\n    return str(value)\\n\\n\\ndef _extract_labels(text: str) -> list[dict[str, str]]:\\n    \\\"\\\"\\\"Keep every colon-labelled line verbatim as a field/value occurrence.\\\"\\\"\\\"\\n    found = []\\n    for line_no, line in enumerate(text.splitlines(), 1):\\n        match = re.match(r\\\"^\\\\s*([^:\\\\n]+):\\\\s?(.*)$\\\", line)\\n        if match:\\n            found.append({\\\"line\\\": str(line_no), \\\"label\\\": match.group(1), \\\"value\\\": match.group(2)})\\n    return found\\n\\n\\ndef _pdf_pages(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\\n    reader = PdfReader(path, strict=True)\\n    pages: list[dict[str, Any]] = []\\n    for page_no, page in enumerate(reader.pages, 1):\\n        text = page.extract_text(extraction_mode=\\\"layout\\\") or \\\"\\\"\\n        claim = re.search(r\\\"^\\\\s*Claim reference:\\\\s*(.+)$\\\", text, re.M)\\n        receipt_refs = re.findall(r\\\"^\\\\s*Receipt reference:\\\\s*(.+)$\\\", text, re.M)\\n        pages.append({\\n            \\\"source_id\\\": source_id,\\n            \\\"source_sha256\\\": sha256,\\n            \\\"locator\\\": f\\\"PDF page {page_no}\\\",\\n            \\\"page\\\": page_no,\\n            \\\"record_types\\\": ([\\\"claim_revision\\\"] if claim else []) + ([\\\"receipt\\\"] if receipt_refs else []),\\n            \\\"claim_id\\\": claim.group(1).strip() if claim else None,\\n            \\\"receipt_ids\\\": [item.strip() for item in receipt_refs],\\n            \\\"fields\\\": _extract_labels(text),\\n            \\\"text\\\": text,\\n        })\\n    return pages\\n\\n\\ndef _workbook_sheets(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\\n    workbook = load_workbook(path, data_only=False, read_only=False)\\n    sheets: list[dict[str, Any]] = []\\n    for sheet in workbook.worksheets:\\n        rows = list(sheet.iter_rows())\\n        header_row = next((i for i, row in enumerate(rows) if any(cell.value is not None for cell in row)), None)\\n        if header_row is None:\\n            continue\\n        headers = [cell.value for cell in rows[header_row]]\\n        # Workbook tabs begin with a title, notes, and a blank row. The row\\n        # whose first cell names an ID/reference is the native table header.\\n        table_row = next((i for i, row in enumerate(rows)\\n                          if any(str(c.value).strip().lower() in {\\\"employee id\\\", \\\"trip reference\\\",\\n                             \\\"transaction reference\\\", \\\"rate reference\\\", \\\"cap reference\\\",\\n                             \\\"ledger reference\\\", \\\"decision reference\\\", \\\"activity reference\\\",\\n                             \\\"cancellation activity reference\\\"} for c in row if c.value is not None)), None)\\n        if table_row is None:\\n            table_row = header_row\\n        headers = [cell.value for cell in rows[table_row]]\\n        records: list[dict[str, Any]] = []\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13c28-c6bd-7171-9c10-8efd3c67b498","create_time":1792010711.9584548}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
