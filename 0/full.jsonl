ose fields.\\n52:**Concrete retained cases (observations, not new closure decisions):**\\n\\\"\\\"\\\"Fresh native-source retrieval and byte-bound source manifests.\\n\\nThis module deliberately has no cache/fallback path. Every capture invokes the\\nconfigured native URL or its documented export route again.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport io\\nfrom http.client import HTTPException, IncompleteRead\\nimport json\\nimport re\\nimport urllib.error\\nimport urllib.request\\nimport zipfile\\nfrom dataclasses import dataclass\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom typing import Callable, Mapping\\n\\n\\n@dataclass(frozen=True)\\nclass NativeSource:\\n    source_id: str\\n    title: str\\n    url: str\\n    locator: str\\n    export_url: str | None = None\\n    kind: str = \\\"binary\\\"\\n\\n\\nSOURCES: tuple[NativeSource, ...] = (\\n    NativeSource(\\n        \\\"policy-pol-2026-2\\\",\\n        \\\"Travel reimbursement policy POL-2026.2\\\",\\n        \\\"https://private-pecorino-70e.notion.site/REDACTED\\\",\\n        \\\"Notion policy page body\\\",\\n        kind=\\\"notion\\\",\\n    ),\\n    NativeSource(\\n        \\\"initial-claim-binder\\\",\\n        \\\"Initial claim binder\\\",\\n        \\\"https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view\\\",\\n        \\\"Complete PDF document\\\",\\n        \\\"https://drive.google.com/uc?export=download&REDACTED\\\",\\n        \\\"pdf\\\",\\n    ),\\n    NativeSource(\\n        \\\"claim-updates-binder\\\",\\n        \\\"Claim updates binder\\\",\\n        \\\"https://drive.google.com/file/d/REDACTED/view\\\",\\n        \\\"Complete PDF document\\\",\\n        \\\"https://drive.google.com/uc?export=download&REDACTED\\\",\\n        \\\"pdf\\\",\\n    ),\\n    NativeSource(\\n        \\\"receipt-binder\\\",\\n        \\\"Receipt binder\\\",\\n        \\\"https://drive.google.com/file/d/REDACTED/view\\\",\\n        \\\"Complete PDF document\\\",\\n        \\\"https://drive.google.com/uc?export=download&REDACTED\\\",\\n        \\\"pdf\\\",\\n    ),\\n    NativeSource(\\n        \\\"travel-registers-workbook\\\",\\n        \\\"Travel registers workbook\\\",\\n        \\\"https://docs.google.com/spreadsheets/d/REDACTED/edit\\\",\\n        \\\"All workbook tabs via native XLSX export\\\",\\n        \\\"https://docs.google.com/spreadsheets/d/REDACTED/export?format=xlsx\\\",\\n        \\\"xlsx\\\",\\n    ),\\n)\\n\\n\\ndef _utc_now() -> str:\\n    return datetime.now(timezone.utc).isoformat(timespec=\\\"seconds\\\").replace(\\\"+00:00\\\", \\\"Z\\\")\\n\\n\\ndef sha256_bytes(content: bytes) -> str:\\n    return hashlib.sha256(content).hexdigest()\\n\\n\\ndef _policy_page_is_relevant_html(content: bytes) -> bool:\\n    text = content.decode(\\\"utf-8\\\", \\\"replace\\\")\\n    # A successful response can still be only a generic Notion app/login shell.\\n    has_policy_id = bool(re.search(r\\\"POL[- ]2026(?:\\\\.2|[- ]2)\\\", text, re.I))\\n    has_policy_body = bool(re.search(r\\\"lodging|meal cap|permit approval|reimbursement\\\", text, re.I))\\n    return has_policy_id and has_policy_body\\n\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"bf5b79\",\"wall_time_seconds\":1.000699808,\"session_id\":49927,\"original_token_count\":8,\"output\":\"/tmp/project-d-step188-6qe91bar\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13f75-824c-7092-8bbb-53a9cee4880a","create_time":1792066087.3956156}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
