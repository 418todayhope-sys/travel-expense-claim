n            row[key] = \"\" if row[key] is None else row[key]\n        prepared.append(row)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"x\", encoding=\"utf-8\", newline=\"\") as stream:\n        writer = csv.DictWriter(stream, fieldnames=CLAIMS_COLUMNS, extrasaction=\"raise\")\n        writer.writeheader()\n        writer.writerows(prepared)\n\n\ndef new_repair_queue() -> dict:\n    return {\"queue_version\": \"owner-queue/1\", \"items\": {}, \"events\": []}\n\n\ndef add_repair_item(\n    queue: dict,\n    *,\n    item_id: str,\n    subject_type: str,\n    subject_id: str,\n    revision: int,\n    source_refs: list[str],\n    missing_or_return_reason: str,\n    owner: str,\n    next_action: str,\n    run_id: str,\n    batch_id: str,\nsrc/travel_claim/completion.py:10:def supported_clock(parsed):\nsrc/travel_claim/completion.py:20:def financial_dependencies(*, finance, revision, allowed, cancellations, review):\nsrc/travel_claim/completion.py:78:def no_claim_financial_effect_refs(parsed, domain, cancellation, observations, arrival_batch):\nsrc/travel_claim/outputs.py:41:def _money(value: Any, field: str, allow_negative: bool = False) -> int | None:\nsrc/travel_claim/outputs.py:51:def write_claims_csv(claims: list[dict], path: Path) -> None:\nsrc/travel_claim/outputs.py:84:def new_repair_queue() -> dict:\nsrc/travel_claim/outputs.py:88:def add_repair_item(\nsrc/travel_claim/outputs.py:140:def apply_partial_response(\nsrc/travel_claim/outputs.py:228:def update_repair_item(\nsrc/travel_claim/outputs.py:301:def owner_grouped_view(queue: dict) -> dict[str, list[dict]]:\nsrc/travel_claim/outputs.py:308:def load_repair_queue(path: Path) -> dict:\nsrc/travel_claim/outputs.py:335:def write_repair_queue(queue: dict, path: Path) -> None:\nsrc/travel_claim/outputs.py:382:def record_evidence_validation(queue: dict, *, item_id: str, supported: bool,\nsrc/travel_claim/live_run.py:15:def run_live_sources(run_dir: Path, *, run_id: str, case_clock: str |