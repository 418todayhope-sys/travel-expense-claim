      },\\n          \\\"financial_status\\\": {\\n            \\\"enum\\\": [\\n              \\\"no-financial-effect\\\",\\n              \\\"unresolved\\\",\\n              \\\"resolved\\\"\\n            ]\\n          },\\n          \\\"next_owner\\\": {\\n            \\\"type\\\": [\\n              \\\"string\\\",\\n              \\\"null\\\"\\n            ],\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"reason\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"issue_record_ids\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"minLength\\\": 1\\n            },\\n            \\\"uniqueItems\\\": true\\n          }\\n        },\\n        \\\"allOf\\\": [\\n          {\\n            \\\"if\\\": {\\n              \\\"properties\\\": {\\n                \\\"status\\\": {\\n                  \\\"const\\\": \\\"requested\\\"\\n                }\\n              }\\n            },\\n            \\\"then\\\": {\\n              \\\"properties\\\": {\\n                \\\"confirmed_at\\\": {\\n                  \\\"type\\\": \\\"null\\\"\\n                },\\n                \\\"effective_at\\\": {\\n                  \\\"type\\\": \\\"null\\\"\\n                },\\n                \\\"next_owner\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"minLength\\\": 1\\n                }\\n              }\\n            },\\n            \\\"else\\\": {\\n              \\\"properties\\\": {\\n                \\\"confirmed_at\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"format\\\": \\\"date-time\\\"\\n                },\\n                \\\"effective_at\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"format\\\": \\\"date-time\\\"\\n                }\\n\\\"\\\"\\\"Validated, append-preserving independent business cancellation admissions.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom collections import defaultdict\\n\\nfrom .event_validation import source_values, text_id, utc_time, observation_error\\n\\n\\ndef revision(value):\\n    try:\\n        return int(value) if not isinstance(value, bool) and int(value) \u003e 0 and float(value) == int(value) else None\\n    except (TypeError, ValueError, OverflowError):\\n        return None\\n\\n\\ndef payload(record):\\n    return {k: v for k, v in source_values(record).items() if k != 'Arrival batch'}\\n\\n\\ndef target(value):\\n    return (value.get('Cancelled subject'), value.get('Trip reference'), revision(value.get('Trip revision')),\\n            value.get('Permit reference') or None, revision(value.get('Permit revision')))\\n\\n\\ndef reduce_cancellations(records, *, trips=(), people=(), clock=None, arrival_batch=None, previous_state=None):\\n    \\\"\\\"\\\"Only admitted records change authority; invalid deliveries remain visible.\\\"\\\"\\\"\\n    deliveries = []\\n    for record in (previous_state or {}).get('delivery_history', []) + list(records):\\n        if record not in deliveries:\\n            deliveries.append(deepcopy(record))\\n    records = deliveries\\n    prior = deepcopy((previous_state or {}).get('admitted_records', {}))\\n    admitted = deepcopy(prior)\\n    issues, duplicates, conflicts = [], [], []\\n    groups = defaultdict(list)\\n    def issue(record, reason):\\n        value = source_values(record)\\n        issues.append({'event_id': value.get('Cancellation activity reference'),\\n                       'cancellation_id': value.get('Cancellation reference'), 'reason': reason,\\n                       'source_ref': {k: record.get(k) for k in ('source_id', 'source_sha256', 'locator')}})\\n    for record in records:\\n        value = source_values(record); identity = value.get('Cancellation activity reference')\\n        if not text_id(identity):\\n            issue(record, 'missing immutable cancellation event identity'); continue\\n        groups[identity].append(record)\\n    candidates = []\\n    for identity, occurrences in groups.items():\\n        variants = [payload(r) for r in occurrences] + ([payload(prior[identity])] if identity in prior else [])\\n        conflict = any(v != variants[0] f…322 tokens truncated…   assert item['history'][-1]['event'] == 'evidence-revalidated'\\n    path = tmp_path / 'queue.json'\\n    write_repair_queue(first['domain']['repair_queue'], path)\\n    write_repair_queue(final['domain']['repair_queue'], path)\\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\\n\\n\\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\\n    parsed = synthetic(); records = parsed['records']\\n    if missing == 'receipt': records['receipts'] = []\\n    elif missing == 'settled-proof':\\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\\n    elif missing == 'policy': records['workflow_policy_rules'] = []\\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\\n    elif missing == 'request': records['reimbursement_requests'] = []\\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\\n    elif missing == 'closure-authority': records['closure_authorities'] = []\\n    else: parsed['case_clock'] = None\\n    result = batches(parsed)[-1]\\n    assert workflow(result)['status'] == 'pending'\\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\\n    if recorded_problem:\\n        issues.append({\\n            \\\"record_id\\\": f\\\"finance-recorded-obligation:{claim_id}:{current_revision}\\\",\\n            \\\"subject_type\\\": \\\"claim\\\", \\\"subject_id\\\": claim_id, \\\"revision\\\": current_revision,\\n            \\\"source_refs\\\": [e[\\\"source_ref\\\"] for e in history if e[\\\"event_id\\\"] in {r[\\\"event_id\\\"] for r in obligation_history}],\\n            \\\"owner\\\": owner, \\\"missing_or_return_reason\\\": recorded_problem,\\n            \\\"next_action\\\": \\\"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\\\",\\n        })\\n    obligation = None\\n    obligation_issue = None\\n    if authorized_obligation is not None:\\n        amount = authorized_obligation.get(\\\"amount_cents\\\")\\n        obligation_revision = authorized_obligation.get(\\\"claim_revision\\\")\\n        refs = authorized_obligation.get(\\\"source_refs\\\")\\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount \u003e= 0\\n                and obligation_revision == current_revision and isinstance(refs, list)\\n    for row in parsed.get(\\\"unresolved_issues\\\", []):\\n        blocker = {\\n            \\\"record_id\\\": row[\\\"record_id\\\"],\\n            \\\"reason\\\": row.get(\\\"reason\\\", \\\"Unresolved source issue\\\"),\\n            \\\"owner\\\": row.get(\\\"owner\\\", \\\"Exercise facilitator\\\"),\\n            \\\"resolution_needed\\\": row.get(\\\"next_action\\\", \\\"Obtain the missing authoritative evidence\\\"),\\n            \\\"subject_type\\\": row.get(\\\"subject_type\\\"),\\n            \\\"subject_id\\\": row.get(\\\"subject_id\\\"),\\n            \\\"affected_scope\\\": row.get(\\\"affected_scope\\\"),\\n            \\\"evidence_needed\\\": row.get(\\\"evidence_needed\\\"),\\n        }\\n        blockers.append(blocker)\\n    domain[\\\"policy_clock_blockers\\\"] = blockers\\n\\n    _sync_ordinary_repairs(domain, run_id=run_id, batch_id=batch_id)\\n    schema_issues = list(blockers) + list(domain.get(\\\"structural_blockers\\\", []))\\n    schema_issues.extend(_issue_from_item(item) for item in domain[\\\"repair_queue\\\"][\\\"items\\\"].values() if item[\\\"status\\\"] == \\\"open\\\")\\n    # Every cancellation issue reference must resolve in issues[].record_id.\\n    known_issue_ids = {issue[\\\"record_id\\\"] for issue in schema_issues}\\n    for cancellation in cancellation_rows:\\n        cancellation[\\\"issue_record_ids\\\"] = [\\n            issue_id for issue_id in cancellation[\\\"issue_record_ids\\\"] if issue_id in known_issue_ids\\n\\\"\\\"\\\"Source-traceable Finance reconciliation primitives.\\n\\nOnly explicit, source-classified settled and refund events affect confirmed\\ncash. Finance obligations remain separate from caller-supplied authorized\\nobligations. No policy entitlement or approval decision is made here.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom collections import defaultdict\\nfrom copy import deepcopy\\nfrom decimal import Decimal, InvalidOperation\\nfrom datetime import datetime\\nfrom .event_validation import finance_errors, utc_time\\nfrom typing import Any\\n\\n\\n_NATIVE_EVENT_CLASSES = {\\n    \\\"accepted\\\": \\\"obligation_accepted\\\",\\n    \\\"settled\\\": \\\"confirmed_payment\\\",\\n    \\\"refund\\\": \\\"confirmed_refund\\\",\\n    \\\"failed\\\": \\\"failed_transfer\\\",\\n    \\\"retry_authorized\\\": \\\"retry_authorization\\\",\\n    \\\"cancellation_requested\\\": \\\"finance_cancellation_requested\\\",\\n    \\\"cancelled\\\": \\\"finance_cancelled\\\",\\n\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_02f4b2bd528e1b90016ad0b734ba94819084ff263d56e09b18","internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_02f4b2bd528e1b90016ad0b747190481908c3ab1ba46304df3","internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_02f4b2bd528e1b90016ad0b75714708190b89e51ee3f2d6698","internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_02f4b2bd528e1b90016ad0b7667f108190ae7ce42b71ff7f20","internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_02f4b2bd528e1b90016ad0b76ab4ac819080fe2b6b07e29101","internal_chat_message_metadata_passthrough":{"turn_id":"01a13f48-7c83-7c72-a773-e78f5db417e4"},"summary":[],"type":"reasoning"},{"call_id":"call_59b5341e10594c119df6c20eb8c03e16","id":"ctc_02f4b2bd528e1b90016ad0b76aef6c8190a9854a860d8d1d6d","input":"text(await tools.exec_command({cmd:\"cat \u003e tests/test_completion.py \u003c\u003c'PY'\\n\\\"\\\"\\\"POL-2026.2 completion regressions; all changed facts are SYNTHETIC.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport json\\nfrom pathlib import Path\\nimport pytest\\n\\nfrom test_ordinary import synthetic, batches, workflow, stages\\nfrom test_expenses import setfield\\nfrom test_revalidation import corrected\\nfrom travel_claim.approvals import table, fields\\n\\n\\ndef activity(p, identity, kind, batch=3, time='2026-09-13T12:00:00', amount=None, obligation=None, revision=1, **extra):\\n    event=deepcopy(p['records']['finance_events'][0])\\n    for key in ['Amount (EUR)','Obligation (EUR)','Original activity reference']:\\n        event['values'].pop(key,None)\\n    values={'Activity reference':identity,'Activity type':kind,'Arrival batch':batch,\\n            'Activity time (UTC)':time,'Claim revision':revision}\\n    if amount is not None:values['Amount (EUR)']=amount\\n    if obligation is not None:values['Obligation (EUR)']=obligation\\n    values.update(extra)\\n    for key,value in values.items():setfield(event,key,value)\\n    p['records']['finance_events'].append(event)\\n    return event\\n\\n\\ndef cancellation(p, *, confirmation='2026-09-05T12:00:00', amount='100.00', reviews='2026-09-06T12:00:00'):\\n    source=json.loads((Path(__file__).parent/'fixtures/retained_finance_records.json').read_text())\\n    rows=[deepcopy(r) for r in source['records']['cancellation_activities'] if fields(r).get('Cancellation reference')=='TC018'][:2]\\n    for r in rows:\\n        r.update(source_id='synthetic-travel-registers-workbook',source_sha256=p['records']['trips'][0]['source_sha256'])\\n        action=fields(r)['Action']\\n        values={'Cancellation activity reference':'SYN-CANCEL-'+action,'Cancellation reference':'TC-SYN',\\n            'Trip reference':'T01','Trip revision':1,'Permit reference':None,'Permit revision':None,\\n            'Cancelled subject':'trip','Arrival batch':1 if confirmation\u003c'2026-09-11' else 3,\\n            'Acting employee or supervisor':'EMP-01' if action=='requested' else 'SUP-01',\\n            'Activity time (UTC)':'2026-09-04T12:00:00' if action=='requested' else confirmation,\\n            'Initiation activity reference':None if action=='requested' else 'SYN-CANCEL-requested',\\n            'Effective time (UTC)':None if action=='requested' else confirmation}\\n        for key,value in values.items():setfield(r,key,value)\\n    p['records']['cancellation_activities']=rows\\n    claim=p['records']['claim_revisions'][0]\\n    for key,value in {'Authorizing Finance officer':'FIN-01','Applies to claim':'SYN-C01','Applies to revision':'1',\\n        'Expense reference':'COST-01','Allowed original amount':amount,'Exception reason':'SYNTHETIC cancellation disposition',\\n        'Covered issues':'travel_cancellation','Travel cancellation reference':'TC-SYN'}.items():setfield(claim,key,value)\\n    for d in p['records']['decisions']:setfield(d,'Decision time (UTC)',reviews)\\n    for packet in table(p,'review_packets','Review packets'):setfield(packet,'Travel cancellation references','TC-SYN')\\n    setfield(p['records']['reimbursement_requests'][0],'Amount (EUR)',amount)\\n    return rows\\n\\n\\ndef test_verified_policy_date_can_close_without_legacy_synthetic_authority_tables():\\n    p=synthetic();p['records'].pop('workflow_policy_rules');p['records'].pop('closure_authorities')\\n    p['case_clock']=None;p['event_clock']={'date':'2026-11-15','timezone':'Europe/Amsterdam'}\\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\\n\\n\\ndef test_supported_personal_zero_closes_without_inventing_finance_request():\\n    p=synthetic();setfield(p['records']['receipts'][0],'Category','personal')\\n    p['records']['finance_events']=[];p['records']['reimbursement_requests']=[]\\n    r=batches(p)[-1];w=workflow(r)\\n    assert w['allowed_cents']==0 and w['status']=='closed-no-payment'\\n    assert w['request'] is None and w['balance_cents']==0\\n    assert r['finance_reconciliations']['SYN-C01']['admitted_events']=={}\\n\\n\\ndef test_correction_after_payment_requires_explicit_finance_resolution_even_at_same_total():\\n    p=synthetic();corrected(p)\\n    old=deepcopy(p['records']['decisions'])\\n    for d in old:\\n        setfield(d,'Revision',2);setfield(d,'Arrival batch',3)\\n        setfield(d,'Decision reference',fields(d)['Decision reference']+'-r2');setfield(d,'Decision time (UTC)','2026-09-14T12:00:00')\\n    packets=deepcopy(table(p,'review_packets','Review packets'))\\n    for packet in packets:setfield(packet,'Decision reference',fields(packet)['Decision reference']+'-r2')\\n    table(p,'review_packets','Review packets').extend(packets);p['records']['decisions'].extend(old)\\n    request=deepcopy(p['records']['reimbursement_requests'][0]);setfield(request,'Revision',2);setfield(request,'Arrival batch',3)\\n    setfield(request,'Decision references','\\\\n'.join(fields(d)['Decision reference'] for d in old))\\n    p['records']['reimbursement_requests'].append(request)\\n    authority=deepcopy(p['records']['closure_authorities'][0]);setfield(authority,'Revision',2);setfield(authority,'Arrival batch',3)\\n    p['records']['closure_authorities'].append(authority)\\n    activity(p,'SYN-ADJUST','adjustment',obligation=100,revision=2)\\n    result=batches(p)[-1]\\n    assert result['finance_reconciliations']['SYN-C01']['net_confirmed_cents']==10000\\n    assert workflow(result)['status']=='pending'\\n    activity(p,'SYN-RESOLVE','resolution',batch=4,time='2026-09-14T13:00:00',obligation=100,revision=2,\\n        **{'Resolved activity references':'F-SYN-C01-accepted\\\\nSYN-ADJUST'})\\n    # Use the actual immutable accepted identity from the synthetic fixture.\\n    accepted=next(fields(e)['Activity reference'] for e in p['records']['finance_events'] if fields(e)['Activity type']=='accepted')\\n    setfield(p['records']['finance_events'][-1],'Resolved activity references',accepted+'\\\\nSYN-ADJUST')\\n    assert workflow(batches(p)[-1])['status']=='closed-reimbursed'\\n\\n\\ndef test_pre_acceptance_business_cancellation_can_complete_without_extra_resolution():\\n    p=synthetic();cancellation(p)\\n    result=batches(p)[-1]\\n    assert workflow(result)['status']=='closed-reimbursed'\\n    assert workflow(result)['permit_approval']['arrangement_authorized'] is False\\n    assert result['snapshot']['travel_cancellations'][0]['financial_status']=='resolved'\\n\\n\\ndef test_post_acceptance_cancellation_requires_current_bound_resolution():\\n    p=synthetic();cancellation(p,confirmation='2026-09-13T12:00:00',reviews='2026-09-14T12:00:00')\\n    assert workflow(batches(p)[-1])['status']=='pending'\\n    activity(p,'SYN-CANCEL-RESOLVE'