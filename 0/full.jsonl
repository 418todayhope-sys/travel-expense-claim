pending'\n    assert workflow(result,'SYN-C02')['status']=='closed-reimbursed'\n    assert workflow(result,'SYN-C02')['allowed_cents']==10000\nPY\nPYTHONDONTWRITEBYTECODE=1 .venv/bin/pytest -q -p no:cacheprovider tests/test_evidence_admission.py tests/test_expenses.py tests/test_exceptions.py tests/test_approvals.py"}],"source":"unified_exec_startup","status":"failed","stdout":".....................................F.F................................ [ 33%]\n........................................................................ [ 66%]\n........................................................................ [ 99%]\n.                                                                        [100%]\n=================================== FAILURES ===================================\n______ test_only_observed_cap_and_fx_sources_can_supply_amounts[True-cap] ______\n\nkind = 'cap', verified = True\n\n    @pytest.mark.parametrize('kind',['cap','fx'])\n    @pytest.mark.parametrize('verified',[True,False])\n    def test_only_observed_cap_and_fx_sources_can_supply_amounts(kind,verified):\n        from travel_claim.ordinary import table\n        p,r,t=setup()\n        if kind=='cap':\n            setfield(p['records']['receipts'][0],'Category','lodging')\n            setfield(p['records']['receipts'][0],'Documented units','1')\n>           evidence=deepcopy(table(p,'caps','Caps')[0])\n                              ^^^^^^^^^^^^^^^^^^^^^^^^^\nE           IndexError: list index out of range\n\ntests/test_evidence_admission.py:93: IndexError\n_____ test_only_observed_cap_and_fx_sources_can_supply_amounts[False-cap] ______\n\nkind = 'cap', verified = False\n\n    @pytest.mark.parametrize('kind',['cap','fx'])\n    @pytest.mark.parametrize('verified',[True,False])\n    def test_only_observed_cap_and_fx_sources_can_supply_amounts(kind,verified):\n        from travel_claim.ordinary import table\n        p,r,t=setup()\n        if kind=='cap':\n            setfield(p['records']['receipts'][0