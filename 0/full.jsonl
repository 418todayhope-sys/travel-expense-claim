lid=valid and v.get('Entry type') in {'allocation','obligation'} and all(_cents(v.get(k)) is not None for k in (\n    76\t                'Allocation or commitment (EUR)','Settled (EUR)','Refunded (EUR)'))\n    77\t            valid=valid and v.get('Currency','EUR')=='EUR' and (v.get('Revision') is None or _revision(v['Revision']) is not None)\n    78\t            valid=valid and _cents(v.get('Refunded (EUR)'))<=_cents(v.get('Settled (EUR)')) if valid else False\n    79\t            if v.get('Entry type')=='obligation':valid=valid and text_id(v.get('Obligation reference'))\n    80\t            if v.get('Entry type')=='allocation':valid=valid and _cents(v.get('Settled (EUR)'))==_cents(v.get('Refunded (EUR)'))==0\n    81\t        conflict=any(payload(r)!=payload(rows[0]) for r in rows[1:])\n    82\t        previous=admitted.get(identity)\n    83\t        # A changed authoritative source version can update an opening record;\n    84\t        # conflicting payloads under the same retained version cannot.\n    85\t        if previous and payload(previous)!=payload(rows[0]) and previous.get('source_sha256')==rows[0].get('source_sha256'):\n    86\t            conflict=True\n    87\t        if not valid or conflict:\n    88\t            for affected in {scope_of(fields(r)) for r in rows}:\n    89\t                issue(affected,'ledger-conflict:'+str(identity),'Invalid/unbound or conflicting budget ledger identity; admitted facts retained',refs)\n    90\t            continue\n    91\t        if not previous or payload(previous)!=payload(rows[0]) or previous.get('source_sha256')!=rows[0].get('source_sha256'):\n    92\t            admitted[identity]=deepcopy(rows[0])\n    93\t    for identity,row in admitted.items():\n    94\t        value=fields(row);scope=scope_of(value);entry=ledger(scope)\n    95\t        # Entries absent from a new input are not silently deleted.\n    96\t        if identity not in seen_identities:\n    97\t            issue(scope,'missing-ledger:'+str(i