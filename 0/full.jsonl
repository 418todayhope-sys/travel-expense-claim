val-002.json\"\n    first_obj = json.loads(first.read_text(encoding=\"utf-8\"))\n    second_obj = json.loads(second.read_text(encoding=\"utf-8\"))\n    assert verify_snapshot(first, run_dir, SCHEMA) == []\n    assert verify_snapshot(second, run_dir, SCHEMA) == []\n    assert first_obj[\"predecessor\"] is None\n    assert second_obj[\"predecessor\"] == {\n        \"path\": \"batches/arrival-001.json\",\n        \"sha256\": hashlib.sha256(first.read_bytes()).hexdigest(),\n    }\n    assert \"offline-replay-mode\" in {row[\"record_id\"] for row in first_obj[\"issues\"]}\n    replay_state = json.loads((run_dir / \"offline-replay-state.json\").read_text(encoding=\"utf-8\"))\n    assert [row[\"revision\"] for row in replay_state[\"revision_history\"][\"claim\"][\"C-SYN-RUN\"][\"revisions\"]] == [1, 2]\n    assert [row[\"decision_id\"] for row in replay_state[\"decision_history\"]] == [\"D-SYN-RUN-R1\"]\n    assert [row[\"values\"][\"Activity reference\"][\"value\"] for row in replay_state[\"source_record_history\"][\"finance_events\"]] == [\"F-SYN-RUN-SETTLED\"]\n\n    with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n        rows = list(csv.DictReader(stream))\n        assert tuple(rows[0].keys()) == CLAIMS_COLUMNS\n        assert len(rows) == 1\n\"\"\"Structural workflow tests use conspicuously synthetic records unless noted.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.outputs import (\n    add_repair_item,\n    apply_partial_response,\n    load_repair_queue,\n    new_repair_queue,\n    owner_grouped_view,\n    update_repair_item,\n    write_repair_queue,\n)\nfrom travel_claim.parsing import parse_retained_run\nfrom travel_claim.workflow import (\n    build_revision_history,\n    deduplicate_activity_records,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n)\n\n\nROOT = Path(__file__).resolve().parents[1]\nCAPTURE = ROOT / \"artifacts/runs/source-capture-20261014T100034Z\"\n\n\ndef _claim(claim_id, revision, trip_id=\"T-SYN-01\", trip_revision=\"1\", batch=\"1\"):\n    return {\n        \"source_id\": \"synthetic-claims\",\n        \"source_sha256\": \"a\" * 64,\n        \"locator\": f\"synthetic fixture claim {claim_id} revision {revision}\",\n        \"claim_id\": claim_id,\n        \"fields\": [\n            {\"label\": \"Claim reference\", \"value\": claim_id},\n            {\"label\": \"Revision\", \"value\": str(revision)},\n            {\"label\": \"Trip reference\", \"value\": trip_id},\n            {\"label\": \"Trip revision\", \"value\": trip_revision},\n            {\"label\": \"Arrival batch\", \"value\": batch},\n        ],\n        \"text\": f\"SYNTHETIC TEST FIXTURE ONLY: {claim_id} revision {revision}\",\n    }\n\n\ndef _workbook_record(row, **values):\n    return {\n        \"source_id\": \"synthetic-register\",\n        \"source_sha256\": \"b\" * 64,\n        \"locator\": f\"synthetic tab 'Fixture', row {row}\",\n        \"row\": row,\n        \"values\": {key: {\"value\": value, \"source_text\": str(value), \"cell\": f\"A{row}\"}\n                   for key, value in values.items()},\n    }\n\n\ndef _cancellation_row(row, *, event_id, cancellation_id, action, target_type=\"permit\",\n                      target_id=\"P-SYN-01\", target_revision=1, batch=1, initiation=None,\n                      effective=None):\n    return _workbook_record(\n        row,\n        **{\n            \"Cancellation activity reference\": event_id,\n            \"Cancellation reference\": cancellation_id,\n            \"Action\": action,\n            \"Cancelled subject\": target_type,\n            \"Trip reference\": \"T-SYN-01\",\n            \"Trip revision\": 1,\n            \"Permit reference\": target_id if target_type == \"permit\" else None,\n            \"Permit revision\": target_revision if target_type == \"permit\" else None,\n            \"Initiation activity reference\": initiation,\n            \"Arrival batch\": batch,\n            \"Effective time (UTC)\": effective,\n        },\n    )\n\n\ndef test_revision_history_and_decision_matching_are_structural_only():\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    return event, result['revision_history']['claim']['C01']['revisions']\n\n\ndef test_explicit_revision_link_is_distinct_from_arrival_context_and_does_not_approve():\n    event, revisions = _accepted_and_revision()\n    event['values']['Claim revision'] = {'value': 1}  # synthetic explicit field\n    result = reconcile_finance_events([event], claim_id='C01', current_revision=1, revision_history=revisions)\n    assert result['recorded_obligation']['claim_revision'] == 1\n    assert result['recorded_obligation']['revision_link_status'] == 'explicit_current'\n    assert result['authorized_obligation'] is None\n    assert result['balance_cents'] is None\n    assert result['recorded_ledger_balance_cents'] == 10000\n\n\ndef test_missing_amount_and_conflicting_obligation_events_do_not_produce_known_ledger_balance():\n    event, revisions = _accepted_and_revision()\n    missing = deepcopy(event)\n    missing['values'].pop('Obligation (EUR)')\n    result = reconcile_finance_events([missing], claim_id='C01', current_revision=1, revision_history=revisions)\n    assert result['recorded_obligation'] is None\n    assert result['recorded_ledger_balance_cents'] is None\n    conflict = deepcopy(event)\n    conflict['values']['Obligation (EUR)']['value'] = 999\n    result = reconcile_finance_events([event, conflict], claim_id='C01', current_revision=1, revision_history=revisions)\n    assert result['recorded_obligation'] is None\n    assert result['net_confirmed_cents'] == 0\n    assert result['conflicting_events'][0]['event_id'] == 'F-C01-accepted'\n\n\ndef test_unknown_reversal_semantics_are_unresolved_and_never_turned_into_cash():\n    event, revisions = _accepted_and_revision()\n    reversal = deepcopy(event)\n    reversal['values']['Activity reference']['value'] = 'SYNTHETIC-REVERSAL'\n    reversal['values']['Activity type']['value'] = 'reversal'\n    reversal['values']['Amount (EUR)'] = {'value': 100}\n    result = reconcile_finance_events([event, reversal], claim_id='C01', current_revision=1, revision_history=revisions)\n    assert result['net_confirmed_cents'] == 0\n    assert result['recorded_ledger_balance_cents'] is None\n    assert result['unresolved_event_ids'] == ['SYNTHETIC-REVERSAL']\n\n\ndef test_cash_request_mismatch_keeps_ledger_difference_unresolved_with_owned_repair():\n    parsed = _fixture()\n    for row in parsed['records']['finance_events']:\n        if row['values']['Activity reference']['value'] == 'F-C01-1':\n            row['values']['Request reference']['value'] = 'SYNTHETIC-WRONG-REQUEST'\n    final = _batches(parsed)[-1]['finance_reconciliations']['C01']\n    assert final['net_confirmed_cents'] == 10000  # still an observed claim payment\n    assert final['recorded_ledger_balance_cents'] is None\n    assert 'finance-recorded-cash-link:C01:1' in {i['record_id'] for i in final['repair_issues']}\n\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"claim_id,revision\", \"revision,claim_id\", 1))\n    elif target == \"csv-money\":\n        path = run / \"claims.csv\"\n        path.write_text(path.read_text().replace(\"1250\", \"9999\"))\n    elif target == \"report\":\n        path = run / \"report.md\"\n        path.write_text(path.read_text().replace(\"Exercise facilitator\", \"Invented owner\"))\n    elif target == \"draft\":\n        path = run / \"follow-up-drafts.md\"\n        path.write_text(path.read_text().replace(\"HUMAN REVIEW REQUIRED\", \"READY TO SEND\"))\n    elif target in {\"queue\", \"reference\", \"locator\"}:\n        path = run / \"repair-queue.json\"\n        queue = json.loads(path.read_text())\n        item = next(iter(queue[\"items\"].values()))\n        if target == \"queue\":\n            item[\"request_draft\"][\"sent\"] = True\n        elif target == \"locator\":\n            manifest = json.loads((run / \"sources.json\").read_text())\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + manifest[\"files\"][1][\"sha256\"] + \"#invented page 999\"]\n        else:\n            item[\"source_refs\"] = [\"initial-claim-binder@\" + \"0\" * 64 + \"#page 1\"]\n        path.write_text(json.dumps(queue))\n        if target in {\"reference\", \"locator\"}:\n            path = run / \"offline-replay-state.json\"\n            state = json.loads(path.read_text())\n            state[\"repair_queue\"] = {key: value for key, value in queue.items() if key != \"by_owner\"}\n            path.write_text(json.dumps(state))\n    elif target == \"fresh-marker\":\n        path = run / \"offline-replay-state.json\"\n        obj = json.loads(path.read_text()); obj[\"fresh_native_reads_performed\"] = True\n        path.write_text(json.dumps(obj))\n    else:\n        path = run / \"parsed-records.json\"\n","stderr":"","aggregated_output":"                \"owner\": \"Travel Administration Lead\", \"next_action\": \"provide native policy\",\n                \"evidence_needed\": \"complete policy content\",\n            },\n        ],\n        \"records\": {\n            \"claim_revisions\": [claim(1, 1), claim(2, 2)],\n            \"trips\": [{\n                \"source_id\": \"synthetic-trips\", \"source_sha256\": \"b\" * 64,\n                \"locator\": \"Trips tab row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Trip reference\": {\"value\": \"T-SYN-RUN\"},\n                    \"Trip revision\": {\"value\": 1},\n                    \"Permit reference\": {\"value\": \"P-SYN-RUN\"},\n                    \"Permit revision\": {\"value\": 1},\n                },\n            }],\n            \"decisions\": [{\n                \"source_id\": \"synthetic-review-ledger\", \"source_sha256\": \"c\" * 64,\n                \"locator\": \"Review ledger row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Decision reference\": {\"value\": \"D-SYN-RUN-R1\"},\n                    \"Arrival batch\": {\"value\": 1}, \"Subject type\": {\"value\": \"claim\"},\n                    \"Subject reference\": {\"value\": \"C-SYN-RUN\"}, \"Revision\": {\"value\": 1},\n                    \"Outcome\": {\"value\": \"approve\"},\n                },\n            }],\n            \"finance_events\": [{\n                \"source_id\": \"synthetic-finance-ledger\", \"source_sha256\": \"d\" * 64,\n                \"locator\": \"Finance activity row 2 synthetic\", \"row\": 2,\n                \"values\": {\n                    \"Activity reference\": {\"value\": \"F-SYN-RUN-SETTLED\"},\n                    \"Arrival batch\": {\"