eturn (bool(content), \"bin\" if content else None, None if content else \"Empty response body\")\n\n\ndef _request(url: str, timeout: float) -> tuple[bytes, Mapping[str, str], str]:\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"travel-claim-source-capture/2.0\", \"Cache-Control\": \"no-cache\", \"Pragma\": \"no-cache\"})\n    with urllib.request.urlopen(req, timeout=timeout) as response:\n        headers = dict(response.headers.items())\n        headers[\"X-Travel-Claim-HTTP-Status\"] = str(response.status)\n        try:\n            body = response.read()\n        except IncompleteRead as exc:\n            body = exc.partial\n            headers[\"X-Travel-Claim-Read-Error\"] = str(exc)\n        return body, headers, response.geturl()\n\n\nWORKBOOK_TABS = {\"People\", \"Trips\", \"Merchant payments\", \"FX\", \"Caps\", \"Budget\", \"Review ledger\",\n                 \"Review packets\", \"Finance activity\", \"Travel cancellations\"}\n\n\ndef assess_payload(source: NativeSource, body: bytes) -> tuple[str, str | None, str | None, list[str]]:\n    \"\"\"Check accessible scope; a Notion HTML fragment never proves a full policy read.\"\"\"\n    usable, suffix, reason = _validate_payload(source, body)\n    if not usable:\n        return \"unavailable\", None, reason, [source.title]\n    if source.kind == \"notion\":\n        return \"partial\", suffix, \"Policy-related HTML accessed, but complete native Notion page content is not established\", [\"Complete authoritative policy page body and all relevant blocks\"]\n    try:\n        if source.kind == \"pdf\":\n            from pypdf import PdfReader\n            reader = PdfReader(io.BytesIO(body), strict=True)\n            if reader.is_encrypted or not reader.pages:\n                raise ValueError(\"PDF has no accessible pages or is encrypted\")\n            # Traverse every page, not just the signature/trailer. Raw bytes are\n            # retained even where text extraction cannot read scanned content.\n            texts = [(page.extract_text(extraction_mode=\"layout\") or \"\") if \"/Contents\" in page else \"\" for page in reader.pages]\n            if any(not text.strip() for text in texts):\n                return \"partial\", suffix, \"One or more PDF pages have no extractable text; visual/OCR verification required\", [\"Readable text or verified visual transcription of every PDF page\"]\n        elif source.kind == \"xlsx\":\n            from openpyxl import load_workbook\n            workbook = load_workbook(io.BytesIO(body), data_only=False, read_only=False)\n            missing = sorted(WORKBOOK_TABS - set(workbook.sheetnames))\n            workbook.close()\n            if missing:\n\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    # Mutated dates in these synthetic probes belong to the bound trip record.\n    for key,value in trip.items():\n        bound_trip = table(parsed, 'trips', 'Trips')[0]\n        if fields(bound_trip).get(key) != value: setfield(bound_trip, key, value)\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n","stderr":"","aggregated_output":"                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal'