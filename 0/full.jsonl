\n      \\\"type\\\": \\\"object\\\",\\n      \\\"required\\\": [\\n        \\\"path\\\",\\n        \\\"sha256\\\"\\n      ],\\n      \\\"properties\\\": {\\n        \\\"path\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"sha256\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"pattern\\\": \\\"^[0-9a-f]{64}$\\\"\\n        }\\n      }\\n    },\\n    \\\"claims\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"items\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"required\\\": [\\n          \\\"claim_id\\\",\\n          \\\"revision\\\",\\n          \\\"trip_id\\\",\\n          \\\"trip_revision\\\",\\n          \\\"status\\\",\\n          \\\"lines\\\",\\n          \\\"allowed_cents\\\",\\n          \\\"paid_cents\\\",\\n          \\\"balance_cents\\\",\\n          \\\"decision_ids\\\",\\n          \\\"next_owner\\\",\\n          \\\"reason\\\"\\n        ],\\n        \\\"properties\\\": {\\n          \\\"claim_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"revision\\\": {\\n            \\\"type\\\": \\\"integer\\\",\\n            \\\"minimum\\\": 1\\n          },\\n          \\\"trip_id\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"status\\\": {\\n            \\\"enum\\\": [\\n              \\\"pending\\\",\\n              \\\"held\\\",\\n              \\\"ready\\\",\\n              \\\"closed-reimbursed\\\",\\n              \\\"closed-no-payment\\\",\\n              \\\"rejected\\\",\\n              \\\"withdrawn\\\"\\n            ]\\n          },\\n          \\\"lines\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n              \\\"type\\\": \\\"object\\\",\\n              \\\"required\\\": [\\n                \\\"cost_id\\\",\\n                \\\"source_ids\\\",\\n                \\\"status\\\",\\n                \\\"allowed_cents\\\",\\n                \\\"reason\\\"\\n              ],\\n              \\\"properties\\\": {\\n                \\\"cost_id\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"minLength\\\": 1\\n                },\\n                \\\"source_ids\\\": {\\n                  \\\"type\\\": \\\"array\\\",\\n                  \\\"items\\\": {\\n                    \\\"type\\\": \\\"string\\\",\\n                    \\\"minLength\\\": 1\\n                  },\\n                  \\\"uniqueItems\\\": true\\n                },\\n                \\\"status\\\": {\\n                  \\\"enum\\\": [\\n                    \\\"supported\\\",\\n                    \\\"excluded\\\",\\n                    \\\"unresolved\\\"\\n                  ]\\n                },\\n                \\\"allowed_cents\\\": {\\n                  \\\"type\\\": [\\n                    \\\"integer\\\",\\n                    \\\"null\\\"\\n                  ],\\n                  \\\"minimum\\\": 0\\n                },\\n                \\\"reason\\\": {\\n                  \\\"type\\\": \\\"string\\\",\\n                  \\\"minLength\\\": 1\\n                }\\n              }\\n            }\\n          },\\n          \\\"allowed_cents\\\": {\\n            \\\"type\\\": [\\n              \\\"integer\\\",\\n              \\\"null\\\"\\n            ],\\n            \\\"minimum\\\": 0\\n          },\\n          \\\"paid_cents\\\": {\\n            \\\"type\\\": \\\"integer\\\",\\n            \\\"minimum\\\": 0\\n          },\\n          \\\"balance_cents\\\": {\\n            \\\"type\\\": [\\n              \\\"integer\\\",\\n              \\\"null\\\"\\n            ]\\n          },\\n          \\\"decision_ids\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"minLength\\\": 1\\n            },\\n            \\\"uniqueItems\\\": true\\n\\\"\\\"\\\"Policy-neutral structural workflow primitives.\\n\\nThese helpers preserve submitted revisions and identify linked events. They do\\nnot evaluate policy, recommend/record approval, calculate entitlement, or\\ndeclare any claim ready or reimbursed.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom collections import defaultdict\\nfrom typing import Any\\n\\n\\ndef row_values(record: dict[str, Any]) -> dict[str, Any]:\\n    \\\"\\\"\\\"Flatten one parsed workbook row to its recorded cell values.\\\"\\\"\\\"\\n    return {key: cell.get(\\\"value\\\") for key, cell in record.get(\\\"values\\\", {}).items()}\\n\\n\\ndef _revision(value: Any) -> int | None:\\n    if isinstance(value, bool) or value is None:\\n        return None\\n    try:\\n        number = int(value)\\n    except (ValueError, TypeError, OverflowError):\\n        return None\\n    if number < 1 or float(value) != number:\\n        return None\\n    return number\\n\\n\\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\\n    return {key: record.get(key) for key in (\\\"source_id\\\", \\\"source_sha256\\\", \\\"locator\\\")}\\n\\n\\ndef build_revision_history(parsed: dict[str, Any]) -> dict[str, Any]:\\n    \\\"\\\"\\\"Build complete claim/trip/permit revision indexes with source refs.\\n\\n    `current_revision` is only the greatest source-observed revision number.\\n    It is not a judgement that the record is complete, valid, or policy-ready.\\n    \\\"\\\"\\\"\\n    groups: dict[str, dict[str, list[dict[str, Any]]]] = {\\n        \\\"claim\\\": defaultdict(list), \\\"trip\\\": defaultdict(list), \\\"permit\\\": defaultdict(list)\\n    }\\n    malformed = []\\n    for record in parsed[\\\"records\\\"].get(\\\"claim_revisions\\\", []):\\n        values = {field[\\\"label\\\"].strip(): field[\\\"value\\\"] for field in record.get(\\\"fields\\\", [])}\\n        subject_id = values.get(\\\"Claim reference\\\")\\n        revision = _revision(values.get(\\\"Revision\\\"))\\n        if not subject_id or revision is None:\\n            malformed.append({\\\"kind\\\": \\\"claim\\\", \\\"source_ref\\\": _source_ref(record), \\\"reason\\\": \\\"missing subject ID or positive revision\\\"})\\n            continue\\n        groups[\\\"claim\\\"][str(subject_id)].append({\\n            \\\"subject_id\\\": str(subject_id), \\\"revision\\\": revision,\\n            \\\"trip_id\\\": values.get(\\\"Trip reference\\\"),\\n            \\\"trip_revision\\\": _revision(values.get(\\\"Trip revision\\\")),\\n            \\\"arrival_batch\\\": values.get(\\\"Arrival batch\\\"),\\n            \\\"record\\\": record, \\\"source_ref\\\": _source_ref(record),\\n        })\\n    for record in parsed[\\\"records\\\"].get(\\\"trips\\\", []):\\n        values = row_values(record)\\n        subject_id = values.get(\\\"Trip reference\\\")\\n        revision = _revision(values.get(\\\"Trip revision\\\"))\\n        if not subject_id or revision is None:\\n            malformed.append({\\\"kind\\\": \\\"trip\\\", \\\"source_ref\\\": _source_ref(record), \\\"reason\\\": \\\"missing subject ID or positive revision\\\"})\\n            continue\\n        groups[\\\"trip\\\"][str(subject_id)].append({\\n            \\\"subject_id\\\": str(subject_id), \\\"revision\\\": revision,\\n            \\\"permit_id\\\": values.get(\\\"Permit reference\\\"),\\n            \\\"permit_revision\\\": _revision(values.get(\\\"Permit revision\\\")),\\n            \\\"record\\\": record, \\\"source_ref\\\": _source_ref(record),\\n        })\\n        permit_id = values.get(\\\"Permit reference\\\")\\n        if permit_id is not None and permit_id != \\\"\\\":\\n            permit_revision = _revision(values.get(\\\"Permit revision\\\"))\\n            if permit_revision is None:\\n                malformed.append({\\\"kind\\\": \\\"permit\\\", \\\"source_ref\\\": _source_ref(record), \\\"reason\\\": \\\"permit reference has no positive permit revision\\\"})\\n            else:\\n                groups[\\\"permit\\\"][str(permit_id)].append({\\n                    \\\"subject_id\\\": str(permit_id), \\\"revision\\\": permit_revision,\\n                    \\\"trip_id\\\": str(subject_id), \\\"trip_revision\\\": revision,\\n                    \\\"record\\\": record, \\\"source_ref\\\": _source_ref(record),\\n                })\\n\\n    result: dict[str, Any] = {\\\"revision_semantics\\\": \\\"source-observed maximum only; no business readiness conclusion\\\"}\\n    conflicts = []\\n    for kind, subjects in groups.items():\\n        indexed = {}\\n        for subject_id, revisions in subjects.items():\\n            revisions.sort(key=lambda item: (item[\\\"revision\\\"], item[\\\"source_ref\\\"].get(\\\"locator\\\") or \\\"\\\"))\\n            seen: dict[int, list[dict[str, Any]]] = defaultdict(list)\\n            for item in revisions:\\n                seen[item[\\\"revision\\\"]].append(item)\\n            for rev, same in seen.items():\\n                if len(same) > 1:\\n                    # Repeated records can be source retransmissions. Retain\\n                    # every occurrence and surface it for later comparison.\\n                    conflicts.append({\\\"kind\\\": kind, \\\"subject_id\\\": subject_id, \\\"revision\\\": rev,\\n                                      \\\"occurrences\\\": [item[\\\"source_ref\\\"] for item in same]})\\n            indexed[subject_id] = {\\n                \\\"current_revision\\\": max(item[\\\"revision\\\"] for item in revisions),\\n                \\\"revisions\\\": revisions,\\n            }\\n        result[kind] = indexed\\n    result[\\\"issues\\\"] = {\\\"malformed_revision_records\\\": malformed, \\\"repeated_subject_revisions\\\": conflicts}\\n    return result\\n\\n\\ndef match_decisions_to_subjects(decisions: list[dict[str, Any]], history: dict[str, Any]) -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"Match review ledger identities and revisions without applying outcomes.\\\"\\\"\\\"\\n    matches = []\\n    for record in decisions:\\n        values = row_values(record)\\n        decision_id = values.get(\\\"Decision reference\\\")\\n        kind = values.get(\\\"Subject type\\\")\\n        subject_id = values.get(\\\"Subject reference\\\")\\n        revision = _revision(values.get(\\\"Revision\\\"))\\n        target_kind = str(kind) if kind in {\\\"claim\\\", \\\"trip\\\", \\\"permit\\\"} else None\\n        target = history.get(target_kind, {}).get(str(subject_id)) if target_kind and subject_id else None\\n        if target is None:\\n            result = \\\"unsupported_subject_type\\\" if target_kind is None else \\\"subject_not_found\\\"\\n            source_refs = []\\n        elif revision is None:\\n            result = \\\"invalid_revision\\\"\\n            source_refs = []\\n        else:\\n            occurrences = [item for item in target[\\\"revisions\\\"] if item[\\\"revision\\\"] == revision]\\n            if not occurrences:\\n                result = \\\"revision_not_found\\\"\\n                source_refs = []\\n            else:\\n                result = \\\"revision_match_current\\\" if revision == target[\\\"current_revision\\\"] else \\\"revision_match_historical\\\"\\n                source_refs = [item[\\\"source_ref\\\"] for item in occurrences]\\n        matches.append({\\n            \\\"decision_id\\\": decision_id,\\n            \\\"subject_type\\\": kind,\\n            \\\"subject_id\\\": subject_id,\\n            \\\"revision\\\": revision,\\n            \\\"observed_outcome\\\": values.get(\\\"Outcome\\\"),\\n            \\\"structural_match\\\": result,\\n            \\\"matched_source_refs\\\": source_refs,\\n            \\\"decision_source_ref\\\": _source_ref(record),\\n            \\\"applied\\\": False,\\n        })\\n    return matches\\n\\n\\ndef _business_payload(record: dict[str, Any], id_field: str, ignore_fields: set[str]) -> dict[str, Any]:\\n    values = row_values(record)\\n    return {key: values[key] for key in sorted(values) if key != id_field and key not in ignore_fields}\\n\\n\\ndef deduplicate_activity_records(\\n    records: list[dict[str, Any]], *, id_field: str, ignore_fields: tuple[str, ...] = (\\\"Arrival batch\\\",)\\n) -> dict[str, Any]:\\n    \\\"\\\"\\\"Deduplicate immutable event IDs, ignoring only declared delivery fields.\\n\\n\\ndef _assert_snapshot_shape(result):\\n    validator = Draft202012Validator(SCHEMA, format_checker=FormatChecker())\\n    assert list(validator.iter_errors(result[\\\"snapshot\\\"])) == []\\n    issue_ids = {issue[\\\"record_id\\\"] for issue in result[\\\"snapshot\\\"][\\\"issues\\\"]}\\n    for cancellation in result[\\\"snapshot\\\"][\\\"travel_cancellations\\\"]:\\n        assert set(cancellation[\\\"issue_record_ids\\\"]) <= issue_ids\\n    cancellation_ids = {\\n        event_id for row in result[\\\"snapshot\\\"][\\\"travel_cancellations\\\"]\\n        for event_id in row[\\\"admitted_cancellation_event_ids\\\"]\\n    }\\n    assert cancellation_ids.isdisjoint(result[\\\"snapshot\\\"][\\\"admitted_event_ids\\\"])\\n\\n\\ndef test_integrates_batches_revisions_decisions_finance_and_independent_cancellations():\\n    parsed = _parsed_fixture()\\n    first = _integrate(parsed, 1)\\n    _assert_snapshot_shape(first)\\n    assert first[\\\"snapshot\\\"][\\\"batch_id\\\"] == \\\"arrival-001\\\"\\n    assert [row[\\\"status\\\"] for row in first[\\\"snapshot\\\"][\\\"travel_cancellations\\\"]] == [\\\"requested\\\", \\\"requested\\\"]\\n    assert {row[\\\"target_type\\\"] for row in first[\\\"snapshot\\\"][\\\"travel_cancellations\\\"]} == {\\\"trip\\\", \\\"permit\\\"}\\n    assert first[\\\"snapshot\\\"][\\\"admitted_event_ids\\\"] == []\\n    assert {row[\\\"record_id\\\"] for row in first[\\\"snapshot\\\"][\\\"issues\\\"]} >= {\\n        \\\"scenario-case-clock\\\", \\\"reimbursement-policy-pol-2026-2\\\",\\n    }\\n    decisions = first[\\\"decision_history\\\"]\\n    assert len(decisions) == 2\\n    assert all(row[\\\"applied\\\"] is False for row in decisions)\\n    assert {row[\\\"structural_match\\\"] for row in decisions} == {\\\"revision_match_current\\\"}\\n\\n    second = _integrate(parsed, 2, previous=first)\\n    _assert_snapshot_shape(s…1429 tokens truncated…lue is None:\\n                    continue\\n                header = str(headers[col_idx])\\n                values[header] = {\\n                    \\\"value\\\": _scalar(cell.value),\\n                    \\\"source_text\\\": str(cell.value),\\n                    \\\"number_format\\\": cell.number_format,\\n                    \\\"data_type\\\": cell.data_type,\\n                    \\\"cell\\\": cell.coordinate,\\n                }\\n            if values:\\n                first = next(iter(values.values()))\\n                # The complete row map, including exact sheet/row references,\\n                # is retained even when a workbook row carries multiple IDs.\\n                records.append({\\n                    \\\"source_id\\\": source_id,\\n                    \\\"source_sha256\\\": sha256,\\n                    \\\"locator\\\": f\\\"tab {sheet.title!r}, row {row_idx}\\\",\\n                    \\\"row\\\": row_idx,\\n                    \\\"values\\\": values,\\n                })\\n        sheets.append({\\n            \\\"source_id\\\": source_id,\\n            \\\"source_sha256\\\": sha256,\\n            \\\"name\\\": sheet.title,\\n            \\\"header_row\\\": table_row + 1,\\n            \\\"headers\\\": [str(h) if h is not None else None for h in headers],\\n            \\\"records\\\": records,\\n        (\\\"- Reimbursement policy POL-2026.2: **retained**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\"\\n         if policy_retained else\\n         \\\"- Reimbursement policy POL-2026.2: **unavailable**; eligibility, entitlement, caps, readiness, and final closure remain unresolved.\\\"),\\n        f\\\"- Parsed input: `{OUTPUT_NAME}` SHA-256 `{hashlib.sha256((snapshots[0].parents[1] / OUTPUT_NAME).read_bytes()).hexdigest()}`; parsed source content remains in that file.\\\",\\n        \\\"- Retained source observations: \\\" + \\\"; \\\".join(\\n            f\\\"`{row['source_id']}`={row['status']}\\\" for row in json.loads(\\n                (snapshots[0].parents[1] / \\\"sources.json\\\").read_text(encoding=\\\"utf-8\\\")\\n            )[\\\"files\\\"]\\n        ) + \\\".\\\",\\n        \\\"\\\",\\n        \\\"## Batch projections\\\",\\n        \\\"\\\",\\n    ]\\n    for path in snapshots:\\n        snapshot = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n        lines.append(\\n            f\\\"- `{path.relative_to(path.parents[1])}` — {len(snapshot['claims'])} current claim rows, \\\"\\n            f\\\"{len(snapshot['travel_cancellations'])} independent cancellation processes, \\\"\\n            f\\\"{len(snapshot['issues'])} issues; schema and source/predecessor hashes verified.\\\"\\n        )\\n    lines.extend([\\n        \\\"\\\",\\n        \\\"Each snapshot retains the observed claim revision and matching decision IDs. Decisions are not treated as proof of policy compliance. Finance event identities and supported confirmed cash are retained; no obligation or entitlement is inferred. Claim monetary entitlement and balance remain null when unsupported.\\\",\\n        \\\"\\\",\\n        \\\"Independent valid records continue through the replay while unresolved claims remain pending. External blockers prevent authoritative live-run conclusions, not retention of independent evidence or partial progress.\\\",\\n        \\\"\\\",\\n    ])\\n    queue = latest[\\\"domain\\\"][\\\"repair_queue\\\"]\\n    for title, subject_types in (\\n        (\\\"Claim-specific actionable repairs by owner\\\", {\\\"claim\\\"}),\\n        (\\\"Trip and permit actionable repairs by owner\\\", {\\\"trip\\\", \\\"permit\\\"}),\\n    ):\\n        open_queue = {\\\"items\\\": {\\n            key: item for key, item in queue[\\\"items\\\"].items()\\n            if item[\\\"status\\\"] == \\\"open\\\" and item[\\\"subject_type\\\"] in subject_types\\n        }}\\n        lines.extend([\\n            f\\\"## {title}\\\", \\\"\\\",\\n            f\\\"{len(open_queue['items'])} open items. Full item-level queue and history: `{output_paths['queue'].name}`. Local request drafts are unsent.\\\",\\n            \\\"\\\",\\n        ])\\n        if not open_queue[\\\"items\\\"]:\\n            lines.extend([\\\"No open repair items in this category; this does not establish policy readiness or closure.\\\", \\\"\\\"])\\n        for owner, items in owner_grouped_view(open_queue).items():\\n            lines.extend([f\\\"### {owner}\\\", \\\"\\\"])\\n            for item in items:\\n                lines.extend([\\n                    f\\\"- Repair `{item['item_id']}` — subject {item['subject_type']} `{item['subject_id']}`, revision {item['revision']} (**open**).\\\",\\n                    f\\\"  - Reason: {item['missing_or_return_reason']}.\\\",\\n                    f\\\"  - Next action: {item['next_action']}.\\\",\\n                    f\\\"  - Opened in run `{item['run_id']}`, batch `{item['batch_id']}`.\\\",\\n                    \\\"  - Retained source references: \\\" + \\\"; \\\".join(\\n                        f\\\"`{ref}`\\\" for ref in item['source_refs']\\n                    ) if item['source_refs'] else \\\"  - Retained source references: unavailable; obtain authoritative evidence.\\\",\\n                ])\\n            lines.append(\\\"\\\")\\n    lines.extend([\\n        \\\"## Run-level external blockers\\\", \\\"\\\",\\n        \\\"These retained policy and clock issues apply to the run as a whole and are separate from claim repairs. They remain unresolved in this offline replay; no case-clock date or policy rule is inferred.\\\",\\n        \\\"\\\",\\n    ])\\n    for blocker in parsed.get(\\\"unresolved_issues\\\", []):\\n        lines.append(\\n            f\\\"- `{blocker['record_id']}` ({blocker.get('subject_type')} `{blocker.get('subject_id')}`): \\\"\\n            f\\\"{blocker['reason']} Owner: {blocker['owner']}. Next: {blocker['next_action']} \\\"\\n            f\\\"Evidence needed: {blocker.get('evidence_needed', 'see source issue')}\\\"\\n        )\\n    lines.extend([\\n        \\\"\\\",\\n        \\\"## Outputs\\\",\\n        \\\"\\\",\\n---\\nname: travel-expense-claim\\ndescription: Prepare traceable Alderbridge travel claim reviews, independent trip and permit work, repair drafts, and financial reconciliation from freshly retrieved native sources and authorized batch decisions. Never approve, invent evidence, send requests, book travel, or move money.\\n---\\n\\n# Alderbridge Travel Expense Claim Skill\\n\\n## Inputs\\n\\n- A new run ID and the scenario's supplied case clock.\\n- The five native source locations listed below, retrieved afresh on every new run.\\n- The authorized arrival batch and its boundary/version, supplied by the exercise operator.\\n- Any prior retained snapshot only when performing an explicitly labeled offline replay; this never substitutes for fresh reads on a new run.\\n- Human reviewer, employee, and Finance responses only when present in supplied records.\\n\\nNever infer an approval, exception, source value, reply, or payment from a missing record.\\n\\n## Invocation\\n\\nInstall as described in the repository [README](../../README.md). Capture sources for a new run with:\\n\\n```bash\\ntravel-claim capture-sources <run-id> artifacts/runs/<run-id> --case-clock '<scenario ISO timestamp>'\\n```\\n\\nInspect the manifest status and verify retained bytes before processing a batch:\\n\\n```bash\\ntravel-claim verify-sources artifacts/runs/<run-id>\\ntravel-claim parse-retained artifacts/runs/<run-id>\\n```\\n\\nSource-only acquisition does not consume a batch. Batch processing must preserve supplied arrival boundaries and use the public [`snapshot.schema.json`](../../snapshot.schema.json). Current foundation helpers are documented in [`travel_claim.sources`](../../src/travel_claim/sources.py), [`travel_claim.parsing`](../../src/travel_claim/parsing.py), [`travel_claim.workflow`](../../src/travel_claim/workflow.py), [`travel_claim.snapshots`](../../src/travel_claim/snapshots.py), and [`travel_claim.outputs`](../../src/travel_claim/outputs.py).\\n\\n`parse-retained` hash-verifies the run before transcribing the PDFs and workbook into page- and row-referenced records. The extracted source text and workbook values are evidence only. If the case clock or policy source is unavailable, leave it unresolved and do not consume policy-dependent decisions.\\n\\nStructural workflow helpers preserve every claim, trip and permit revision; identify whether a supplied decision references a found historical or latest source revision without applying its outcome; deduplicate repeated event IDs and report payload conflicts; and track independent trip/permit cancellation states. They do not calculate policy results. Repair items can be updated with new owner, evidence, reason, action, and subject revision while preserving prior updates. Revision advances reopen the item.\\n\\n## Native sources\\n\\n1. [Travel reimbursement policy — POL-2026.2](https://private-pecorino-70e.notion.site/REDACTED)\\n2. [Initial claim binder](https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view)\\n3. [Claim updates binder](https://drive.google.com/file/d/REDACTED/view)\\n4. [Receipt binder](https://drive.google.com/file/d/REDACTED/view)\\n5. [Travel registers workbook](https://docs.google.com/spreadsheets/d/REDACTED/edit)\\n\\nRetain complete relevant bytes actually accessed. A response code or URL alone does not establish content access. Record partial and unavailable scopes separately. Never silently reuse a previous run's bytes in a new run.\\n\\n## Processing and authority boundaries\\n\\n1. Bind every fact and decision to its source, subject, and revision.\\n2. Hold only claims or dependent work affected by missing/conflicting facts. Continue independent valid work. Each unresolved item retains subject type and exact ID, revision, missing/conflicting fact, responsible owner, source reference, and next action.\\n3. Preserve every claim revision. After a material correction, use the corrected revision and revalidate affected evidence, calculations, trip/permit consistency, approvals, and Finance authorization. Preserve unrelated evidence only where it remains valid. Retain historical commitments, transfers, and refunds; do not use stale approvals as current.\\n4. Keep trip cancellation and permit cancellation as independent processes, including processes without claims. Cancellation does not itself erase entitlement or Finance obligations. Record Finance disposition and monetary resolution separately when required.\\n5. Use the owner-grouped local repair queue. Keep each item individually traceable. A partial response may resolve only the item(s) explicitly matched and supported by retained source evidence; unanswered, insufficient, or conflicting items stay open. Draft locally; never send requests.\\n6. Preserve immutable Finance event identifiers. Reconcile only confirmed transfers and refunds. Do not duplicate events or obligations on replay.\\n7. The provisional financial closure choice is to require current evidence and approvals, agreement between reviewed entitlement and authorized obligation, net confirmed payment equal to the authorized amount, required Finance resolutions, and no blocking issue. After the first actual processing result, pause for the operator to inspect reconciliation and unresolved cases and confirm final completion conditions and delivery scope.\\n\\nPeople retain business approval, exception, and payment authority. This Skill prepares work, validates supplied decisions, and records effects; it does not make discretionary approval recommendations, create replies, issue Finance exceptions, book travel, or move funds.\\n\\n## Outputs\\n\\n- `artifacts/runs/<run-id>/sources.json` and retained source bytes.\\n- One immutable schema-valid `batches/<batch-id>.json` per consumed batch, with relative source and predecessor paths plus SHA-256 hashes.\\n- `claims.csv` with exactly `claim_id,revision,trip_id,status,allowed_cents,paid_cents,balance_cents,next_owner,reason`.\\n- Owner-grouped local repair queue with individual items and run/batch update history.\\n- `report.md` describing completed work, obligations, unresolved items, owners, next actions, cancellations without claims, and source/run references.\\n\\nUnknown money is null in JSON and blank in CSV. Zero is a known amount. Never label incomplete work complete.\\n\\n## Errors, retries, and limitations\\n\\n- On source failure, retain the attempt URL, locator, UTC observation time, error, and missing scope. Hold only affected work and report its owner and resumption evidence.\\n- On partial source access, retain usable pieces and explicitly list missing scope. Do not claim the source was fully read.\\n- On invalid or conflicting batch data, preserve the input evidence, reject admission of unsupported effects, and create an owned issue; do not silently discard it.\\n- Retry a failed fresh retrieval only by making another live request and recording the new observation. Do not overwrite a prior run's manifest, retained bytes, or sealed snapshot.\\n- On replay, preserve obligation/event identity and money; detect conflicting content under an existing event ID.\\n- Foundation implementation currently covers source capture/verification, retained PDF/workbook transcription, snapshot sealing/verification, the claims CSV writer, and local repair queue primitives. Scenario-state processing, policy/evidence decisions, approvals, Finance reconciliation, replay orchestration, and the complete operations report remain to be implemented and verified.\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7b9de2\",\"wall_time_seconds\":0.37530581,\"