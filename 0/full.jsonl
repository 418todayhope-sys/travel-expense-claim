= trip_id and rv.get('Currency') == line['currency']\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\n                    and line['currency'].isalpha() and line['currency'].isupper()):\n                raise ValueError('Receipt identity, currency or gross mismatch')\n            unique = {}\n            for row in ms:\n                mv = fields(row); identity = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            line['base_allowed_original_amount'] = str(allowed)\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                original = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = original\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n            if exception['status'] == 'valid':\n                replacement = Decimal(exception['replacement_original_amount'])\n                if category == 'personal' and replacement != 0:\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n                allowed = replacement\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n            apply_coverage(line['eligibility_findings'], exception)\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            line['filing_status'] = 'BLOCKED' if any(\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n                                                    for f in line['eligibility_findings']):\n                line['filing']['exception'] = deepcopy(exception)\n            if exception['status'] == 'BLOCKED':\n                raise ValueError(exception['reason'])\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n            line.update(eligibility_status='PASS', status='supported',\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n                        else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n\"\"\"POL-2026.2 review authority and business transitions, without financial closure.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nimport hashlib\nimport json\nimport re\nfrom zoneinfo import ZoneInfo\n\nfrom .exceptions import source_bound\nfrom .expenses import policy_valid, local_date\nfrom .workflow import _revision, row_values\n\nROLES = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner',\n         'supervisor': 'Supervisor', 'director': 'Director'}\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef table(parsed, key, name):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == name), []))\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('Missing decision UTC time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native workbook column explicitly specifies UTC.\n    return stamp.replace(tzinfo=timezone.utc) if stamp.tzinfo is None else stamp.astimezone(timezone.utc)\n\n\ndef versions(row):\n    return set(re.findall(r'\\b(?:SRC-D-\\d+|POL-\\d{4}\\.\\d+)\\b', row.get('text', '')))\n\n\ndef evidence_digest(rows, amount):\n    \"\"\"Compare material facts, retaining source versions but ignoring arrival metadata.\"\"\"\n    content=[]\n    for row in rows:\n        value=fields(row)\n        content.append(dict(source_id=row.get('source_id'), sha256=row.get('source_sha256'),\n                            values={k:v for k,v in value.items() if k not in {'Arrival batch', 'Status', 'Claim reason'}}))\n    return hashlib.sha256(json.dumps(dict(rows=content, amount=amount), sort_keys=True, default=str).encode()).hexdigest()\n\n\ndef evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employee,\n                     subject_record, amount_cents, decisions, arrival_batch, observations,\n                     cost_ids=(), prior=None, dependency_rows=(), withdrawn=False, cancellation_ids=(), budget_context=None):\n    \"\"\"Evaluate supplied replies only. Invalid/stale imports stay in deliveries.\"\"\"\n    trip=fields(trip_record); policy=policy_valid(parsed.get('expense_policy'))\n    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==employee]\n    person=fields(people[0]) if len(people)==1 else {}\n    packets=table(parsed,'review_packets','Review packets')\n    required=['administration','budget_owner','supervisor']\n    amount_known=isinstance(amount_cents,int) and not isinstance(amount_cents,bool) and amount_cents>=0\n    if amount_known and amount_cents>100000: required.append('director')\n    basis_rows=[subject_record,trip_record]+people+list(dependency_rows)\n    digest=evidence_digest(basis_rows,dict(amount_cents=amount_cents,cost_ids=sorted(cost_ids) if kind=='claim' else [],cancellation_ids=sorted(cancellation_ids)))\n    material_same_revision=bool(prior and prior.get('revision')==revision and\n        (prior.get('evidence_digest')!=digest or prior.get('material_same_revision')))\n    invalidated_batch=(prior.get('invalidated_batch') if prior and prior.get('material_same_revision') and prior.get('revision')==revision else arrival_batch) if material_same_revision else None\n    deliveries=[]; identities={}; conflicts=set()\n    budget_ids={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget')}\n    for decision in decisions:\n        dv=fields(decision); identity=dv.get('Decision reference')\n        ps=[p for p in packets if fields(p).get('Decision reference')==identity]\n        relevant=(dv.get('Subject reference')==subject_id or any(fields(p).get('Trip reference')==trip.get('Trip reference')\n                  and fields(p).get('Employee ID')==employee for p in ps))\n        if not relevant: continue\n        item=dict(decision_id=identity, outcome=dv.get('Outcome'), roles=str(dv.get('Review roles') or '').splitlines(),\n                  reason=dv.get('Reason'), repair_requested=dv.get('Repair requested'), evidence_valid=False,\n                  active=False, import_status='rejected-import', source_refs=[ref(decision)]+[ref(p) for p in ps],\n                  raw_record=deepcopy(decision), rejection_reasons=[])\n        deliveries.append(item)\n        try:\n            batch=_revision(dv.get('Arrival batch'))\n            if batch is None or batch>arrival_batch: raise ValueError('Reply outside consumed arrival batches')\n            if not subject_id or _revision(revision) is None or not source_bound(subject_record,observations) or not source_bound(trip_record,observations):\n                raise ValueError('Missing verified subject/trip identity or revision')\n            if dv.get('Subject type')!=kind or dv.get('Subject reference')!=subject_id or _revision(dv.get('Revision'))!=revision:\n                raise ValueError('Wrong or stale subject type/ID/revision')\n            if not identity or not source_bound(decision,observations): raise ValueError('Missing decision identity/source binding')\n            if len(people)!=1 or not source_bound(people[0],observations): raise ValueError('Missing verified directory authority')\n            roles=item['roles']\n            if not roles or len(set(roles))!=len(roles) or not set(roles)<=set(ROLES): raise ValueError('Unknown or repeated role')\n            if len(roles)>1 and not (set(roles)=={'budget_owner','supervisor'} and person.get('Budget owner')==person.get('Supervisor')):\n                raise ValueError('Only directory-identical budget owner/supervisor may combine explicit roles')\n            if any(not person.get(ROLES[r]) or dv.get('Reviewer')!=person[ROLES[r]] or dv.get('Reviewer')==employee for r in roles):\n                raise ValueError('Wrong-role, self-review or unauthorized stable actor')\n            if not isinstance(dv.get('Reason'),str) or not dv['Reason'].strip(): raise ValueError('Missing review reason')\n            if item['outcome'] not in {'approve','return','reject'}: raise ValueError('Unknown decision outcome')\n            if item['outcome']=='return' and (not isinstance(dv.get('Repair requested'),str) or not dv['Repair requested'].strip()):\n                raise ValueError('Return requires a concrete repair request')\n            if len(ps)!=1 or not source_bound(ps[0],observations): raise ValueError('Missing, conflicting or unbound review packet')\n            pv=fields(ps[0]); supplied=str(dv.get('Source revisions') or '').splitlines()\n            policy_versions={v for v in supplied if v.startswith('POL-')}\n            if not supplied or pv.get('Policy revision')!='POL-2026.2' or policy_versions!={'POL-2026.2'}:\n                raise ValueError('Missing/stale policy source version')\n            exact=ref(subject_record) in supplied or subject_record.get('source_sha256') in supplied\n            printed=versions(subject_record)\n            declared={v for v in supplied if v.startswith('SRC-D-')}\n            if printed and declared-printed:\n                raise ValueError('Reply contains a stale printed source version')\n            if material_same_revision and batch<invalidated_batch:\n                raise ValueError('Reply predates material evidence revalidation')\n            if not exact and (material_same_revision or not printed.intersection(supplied)):\n                raise ValueError('Reply does not bind current subject source version')\n            if (pv.get('Employee ID')!=employee or pv.get('Trip reference')!=trip.get('Trip reference')\n                    or _revision(pv.get('Trip revision'))!=_revision(trip.get('Trip revision'))\n                    or any(pv.get(k)!=trip.get(k) for k in ('Business purpose','Client','Schedule coverage','Alternatives considered','Permit reference','Permit revision'))):\n                raise ValueError('Packet does not match current trip/permit evidence')\n            if kind=='claim' and set(str(pv.get('Expense references') or '').splitlines())!=set(cost_ids):\n                raise ValueError('Packet expense list does not match review subject')\n            if kind=='permit':\n                from .finance import _cents\n                if not amount_known or _cents(pv.get('Reviewed estimate (EUR)'))!=amount_cents:\n                    raise ValueError('Missing/mismatched reviewed permit estimate')\n            if not set(cancellation_ids)<=set(str(pv.get('Travel cancellation references') or '').splitlines()):\n                raise ValueError('Packet lacks current cancellation context')\n            budget_refs=set(str(pv.get('Budget record references') or '').splitlines())\n            if not budget_refs or not budget_refs<=budget_ids: raise ValueError('Missing referenced budget records; no budget decision inferred')\n            stamp=utc_time(dv.get('Decision time (UTC)'))\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in identities and identities[identity][0]!=payload:\n                conflicts.add(identity)\n            elif identity not in identities: identities[identity]=(payload,item)\n            else:\n                item.update(import_status='exact-replay',replayed_decision_id=identity)\n                continue\n            from .budget import budget_reply_error\n            budget_error=budget_reply_error(budget_context,decision,ps[0]) if 'budget_owner' in roles else None\n            item['budget_evidence_valid']=not budget_error\n            item['budget_revalidation_reason']=budget_error\n            item.update(evidence_valid=True,import_status='valid',order=stamp.isoformat(),decision_time=stamp.isoformat())\n        except (ValueError,TypeError,InvalidOperation) as exc:\n            item['rejection_reasons'].append(str(exc))\n    # Conflicting redelivery must hold an identity even when its later payload fails validation.\n    all_payloads={}\n    for item in deliveries:\n        dv=fields(item['raw_record']); identity=item['decision_id']\n        if (identity and dv.get('Subject reference')==subject_id and _revision(dv.get('Revision'))==revision\n                and _revision(dv.get('Arrival batch')) is not None and _revision(dv.get('Arrival batch'))<=arrival_batch):\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in all_payloads and all_payloads[identity]!=payload: conflicts.add(identity)\n            all_payloads[identity]=payload\n    for item in deliveries:\n        if item['decision_id'] in conflicts:\n            item.update(evidence_valid=False,import_status='conflicting-replay')\n            item['rejection_reasons'].append('Immutable decision identity has conflicting deliveries')\n    role_states={}; selected=[]\n    for role in required:\n        candidates=[d for d in deliveries if d['evidence_valid'] and role in d['roles'] and (role!='budget_owner' or d.get('budget_evidence_valid',True))]\n        if not candidates: role_states[role]='missing'; continue\n        latest=max(d['order'] for d in candidates)\n        matches=[d for d in candidates if d['order']==latest]\n        if len(matches)!=1:\n            role_states[role]='conflicting';continue\n        chosen=matches[0];chosen['active']=True;role_states[role]=chosen['outcome']\n        if chosen not in selected: selected.append(chosen)\n    withdrawal_valid=bool(withdrawn and source_bound(subject_record,observations) and source_bound(trip_record,observations)\n        and trip.get('Employee ID')==employee and len(people)==1 and source_bound(people[0],observations)\n        and isinstance(fields(subject_record).get('Claim reason'),str) and fields(subject_record)['Claim reason'].strip())\n    states=set(role_states.values())\n    state=('withdrawn' if withdrawal_valid else 'rejected' if 'reject' in states else 'returned' if 'return' in states\n           else 'approved' if states=={'approve'} and policy and amount_known else 'pending')\n    if not policy or conflicts and not withdrawal_valid: state='pending'\n    policy_binding=parsed.get('expense_policy') or {}\n    policy_refs=[f\"{policy_binding.get('path')}@{policy_binding.get('sha256')}#line {n}\" for n in (9,13,15,17)] if policy else []\n    return dict(policy_source_refs=policy_refs,subject_type=kind,subject_id=subject_id,revision=revision,state=state,required_roles=required,\n                amount_cents=amount_cents,amount_known=amount_known,evidence_digest=digest,withdrawal_requested=withdrawn,withdrawal_valid=withdrawal_valid,\n                material_same_revision=material_same_revision,invalidated_batch=invalidated_batch,policy_verified=policy,role_states=role_states,\n                deliveries=deliveries,active_decision_ids=[d['decision_id'] for d in selected],\n                source_refs=list(dict.fromkeys([ref(r) for r in basis_rows]+[r for d in deliveries for r in d['source_refs']])),\n                approved=state=='approved',repair_requests=[d['repair_requested'] for d in selected if d['outcome']=='return'])\n\n\ndef evaluate_permit(*, parsed, trip_record, decisions, arrival_batch, observations, prior=None, cost_ids=(), cancellations=(), budget_context=None):\n    trip=fields(trip_record)\n    if trip.get('International') is False:\n        affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n            and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))]\n        return dict(subject_type='permit',subject_id=None,revision=None,state='not-required',approved=True,\n                    arrangement_authorized=policy_valid(parsed.get('expense_policy')) and not affected,\n                    arrangements_at_commitment_supported=policy_valid(parsed.get('expense_policy')),\n                    cancellation_ids=[c['cancellation_id'] for c in affected], source_refs=[ref(trip_record)],deliveries=[])\n    from .finance import _cents\n    subject=deepcopy(trip_record)\n    # Newly parsed workbooks retain the printed source version in their preamble.\n    subject['text']='\\n'.join(str(c.get('value','')) for s in parsed.get('workbook_sheets',[])\n        if s.get('source_id')==trip_record.get('source_id') for c in s.get('preamble',[]))\n    result=evaluate_reviews(parsed=parsed,kind='permit',subject_id=trip.get('Permit reference'),revision=_revision(trip.get('Permit revision')),\n        trip_record=trip_record,employee=trip.get('Employee ID'),subject_record=subject,amount_cents=_cents(trip.get('Estimate (EUR)')),\n        decisions=decisions,arrival_batch=arrival_batch,observations=observations,cost_ids=cost_ids,prior=prior,budget_context=budget_context)\n    result['budget_context']=budget_context\n    result['arrangement_authorized']=False\n    if result['approved'] and trip.get('International') is True:\n        commitment=trip.get('First commitment date')\n        if commitment in (None,''):\n            result['arrangement_authorized']=True\n        else:\n            try:\n                day=local_date(commitment)\n                active=[d for d in result['deliveries'] if d['active']]\n                latest=max(utc_time(d['decision_time']) for d in active).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n                result['arrangement_authorized']=latest<day\n                result['timing_finding']=None if latest<day else 'late_permit' if latest>day else 'same-day-order-unconfirmed'\n            except (ValueError,TypeError): result['timing_finding']='missing-commitment-evidence'\n    result['arrangements_at_commitment_supported']=result['arrangement_authorized']\n    affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n        and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))\n        and (c.get('target_type')=='trip' or (c.get('permit_id')==trip.get('Permit reference')\n             and _revision(c.get('permit_revision'))==_revision(trip.get('Permit revision'))))]\n    result['cancellation_ids']=[c['cancellation_id'] for c in affected]\n    if affected: result['arrangement_authorized']=False\n    return result\n","exit_code":0,"duration":{"secs":0,"nanos":57515250},"formatted_output":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n791c8c787bbd617a7b7d3114f13c000249169151\n\"\"\"POL-2026.2 expense arithmetic and local-calendar filing checks.\n\nThe policy is explicitly bound by its original bytes; this does not convert the\nuser's browser copy into a successful native Notion capture or grant approval.\n\"\"\"\nfrom copy import deepcopy\nfrom calendar import monthrange\nfrom datetime import date\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\nimport hashlib\nfrom pathlib import Path\n\nfrom .exceptions import validate_exception, apply_coverage, finding\n\nPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\n\n\ndef load_expense_policy(path):\n    raw = Path(path).read_bytes()\n    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\n        raise ValueError('POL-2026.2 browser copy hash mismatch')\n    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\n                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\n\n\ndef policy_valid(binding):\n    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\n            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\n            and binding.get('sha256') == POLICY_SHA256)\n\n\ndef local_date(value):\n    \"\"\"Accept native local dates and Excel's naive midnight date serialization.\"\"\"\n    text = str(value)\n    if len(text) == 19 and text.endswith('T00:00:00'):\n        text = text[:10]\n    result = date.fromisoformat(text)\n    if result.isoformat() != text:\n        raise ValueError('Not a local calendar date')\n    return result\n\n\ndef filing_deadline(trip_end):\n    end = local_date(trip_end)\n    month = end.year * 12 + end.month - 1 + 2\n    year, zero_month = divmod(month, 12)\n    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\n\n\ndef number(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError('Missing or invalid number')\n    result = Decimal(str(value).replace(',', ''))\n    if not result.is_finite() or result < 0:\n        raise ValueError('Invalid amount')\n    return result\n\n\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\n    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    binding = parsed.get('expense_policy')\n    verified = policy_valid(binding)\n    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    receipts = parsed.get('records', {}).get('receipts', [])\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    rates = table(parsed, 'fx_rates', 'FX')\n    caps = table(parsed, 'caps', 'Caps')\n    observations = parsed.get('source_observations', []) if observations is None else observations\n    people = table(parsed, 'people', 'People')\n    for line in lines:\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\n        line['eligibility_status'] = 'BLOCKED'\n        exception = validate_exception(record=record, line=line, employee=employee, people=people,\n            observations=observations, fields=fields, ref=ref)\n        # An exception for another *present* cost has no effect on this line.\n        target = fields(record).get('Expense reference')\n        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\n            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\n                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\n                            for f in line['eligibility_findings'])):\n            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\n        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\n        line['exception'] = exception\n        line['source_refs'] += exception['source_refs']\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n        try:\n            gross = number(line['original_amount'])\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\n                raise ValueError('Missing receipt or nonpositive purchase')\n            rv = fields(rs[0])\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\n                    and line['currency'].isalpha() and line['currency'].isupper()):\n                raise ValueError('Receipt identity, currency or gross mismatch')\n            unique = {}\n            for row in ms:\n                mv = fields(row); identity = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            line['base_allowed_original_amount'] = str(allowed)\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                original = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = original\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n            if exception['status'] == 'valid':\n                replacement = Decimal(exception['replacement_original_amount'])\n                if category == 'personal' and replacement != 0:\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n                allowed = replacement\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n            apply_coverage(line['eligibility_findings'], exception)\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            line['filing_status'] = 'BLOCKED' if any(\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n                                                    for f in line['eligibility_findings']):\n                line['filing']['exception'] = deepcopy(exception)\n            if exception['status'] == 'BLOCKED':\n                raise ValueError(exception['reason'])\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n            line.update(eligibility_status='PASS', status='supported',\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n                        else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n\"\"\"POL-2026.2 review authority and business transitions, without financial closure.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nimport hashlib\nimport json\nimport re\nfrom zoneinfo import ZoneInfo\n\nfrom .exceptions import source_bound\nfrom .expenses import policy_valid, local_date\nfrom .workflow import _revision, row_values\n\nROLES = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner',\n         'supervisor': 'Supervisor', 'director': 'Director'}\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef table(parsed, key, name):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == name), []))\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('Missing decision UTC time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native workbook column explicitly specifies UTC.\n    return stamp.replace(tzinfo=timezone.utc) if stamp.tzinfo is None else stamp.astimezone(timezone.utc)\n\n\ndef versions(row):\n    return set(re.findall(r'\\b(?:SRC-D-\\d+|POL-\\d{4}\\.\\d+)\\b', row.get('text', '')))\n\n\ndef evidence_digest(rows, amount):\n    \"\"\"Compare material facts, retaining source versions but ignoring arrival metadata.\"\"\"\n    content=[]\n    for row in rows:\n        value=fields(row)\n        content.append(dict(source_id=row.get('source_id'), sha256=row.get('source_sha256'),\n                            values={k:v for k,v in value.items() if k not in {'Arrival batch', 'Status', 'Claim reason'}}))\n    return hashlib.sha256(json.dumps(dict(rows=content, amount=amount), sort_keys=True, default=str).encode()).hexdigest()\n\n\ndef evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employee,\n                     subject_record, amount_cents, decisions, arrival_batch, observations,\n                     cost_ids=(), prior=None, dependency_rows=(), withdrawn=False, cancellation_ids=(), budget_context=None):\n    \"\"\"Evaluate supplied replies only. Invalid/stale imports stay in deliveries.\"\"\"\n    trip=fields(trip_record); policy=policy_valid(parsed.get('expense_policy'))\n    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==employee]\n    person=fields(people[0]) if len(people)==1 else {}\n    packets=table(parsed,'review_packets','Review packets')\n    required=['administration','budget_owner','supervisor']\n    amount_known=isinstance(amount_cents,int) and not isinstance(amount_cents,bool) and amount_cents>=0\n    if amount_known and amount_cents>100000: required.append('director')\n    basis_rows=[subject_record,trip_record]+people+list(dependency_rows)\n    digest=evidence_digest(basis_rows,dict(amount_cents=amount_cents,cost_ids=sorted(cost_ids) if kind=='claim' else [],cancellation_ids=sorted(cancellation_ids)))\n    material_same_revision=bool(prior and prior.get('revision')==revision and\n        (prior.get('evidence_digest')!=digest or prior.get('material_same_revision')))\n    invalidated_batch=(prior.get('invalidated_batch') if prior and prior.get('material_same_revision') and prior.get('revision')==revision else arrival_batch) if material_same_revision else None\n    deliveries=[]; identities={}; conflicts=set()\n    budget_ids={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget')}\n    for decision in decisions:\n        dv=fields(decision); identity=dv.get('Decision reference')\n        ps=[p for p in packets if fields(p).get('Decision reference')==identity]\n        relevant=(dv.get('Subject reference')==subject_id or any(fields(p).get('Trip reference')==trip.get('Trip reference')\n                  and fields(p).get('Employee ID')==employee for p in ps))\n        if not relevant: continue\n        item=dict(decision_id=identity, outcome=dv.get('Outcome'), roles=str(dv.get('Review roles') or '').splitlines(),\n                  reason=dv.get('Reason'), repair_requested=dv.get('Repair requested'), evidence_valid=False,\n                  active=False, import_status='rejected-import', source_refs=[ref(decision)]+[ref(p) for p in ps],\n                  raw_record=deepcopy(decision), rejection_reasons=[])\n        deliveries.append(item)\n        try:\n            batch=_revision(dv.get('Arrival batch'))\n            if batch is None or batch>arrival_batch: raise ValueError('Reply outside consumed arrival batches')\n            if not subject_id or _revision(revision) is None or not source_bound(subject_record,observations) or not source_bound(trip_record,observations):\n                raise ValueError('Missing verified subject/trip identity or revision')\n            if dv.get('Subject type')!=kind or dv.get('Subject reference')!=subject_id or _revision(dv.get('Revision'))!=revision:\n                raise ValueError('Wrong or stale subject type/ID/revision')\n            if not identity or not source_bound(decision,observations): raise ValueError('Missing decision identity/source binding')\n            if len(people)!=1 or not source_bound(people[0],observations): raise ValueError('Missing verified directory authority')\n            roles=item['roles']\n            if not roles or len(set(roles))!=len(roles) or not set(roles)<=set(ROLES): raise ValueError('Unknown or repeated role')\n            if len(roles)>1 and not (set(roles)=={'budget_owner','supervisor'} and person.get('Budget owner')==person.get('Supervisor')):\n                raise ValueError('Only directory-identical budget owner/supervisor may combine explicit roles')\n            if any(not person.get(ROLES[r]) or dv.get('Reviewer')!=person[ROLES[r]] or dv.get('Reviewer')==employee for r in roles):\n                raise ValueError('Wrong-role, self-review or unauthorized stable actor')\n            if not isinstance(dv.get('Reason'),str) or not dv['Reason'].strip(): raise ValueError('Missing review reason')\n            if item['outcome'] not in {'approve','return','reject'}: raise ValueError('Unknown decision outcome')\n            if item['outcome']=='return' and (not isinstance(dv.get('Repair requested'),str) or not dv['Repair requested'].strip()):\n                raise ValueError('Return requires a concrete repair request')\n            if len(ps)!=1 or not source_bound(ps[0],observations): raise ValueError('Missing, conflicting or unbound review packet')\n            pv=fields(ps[0]); supplied=str(dv.get('Source revisions') or '').splitlines()\n            policy_versions={v for v in supplied if v.startswith('POL-')}\n            if not supplied or pv.get('Policy revision')!='POL-2026.2' or policy_versions!={'POL-2026.2'}:\n                raise ValueError('Missing/stale policy source version')\n            exact=ref(subject_record) in supplied or subject_record.get('source_sha256') in supplied\n            printed=versions(subject_record)\n            declared={v for v in supplied if v.startswith('SRC-D-')}\n            if printed and declared-printed:\n                raise ValueError('Reply contains a stale printed source version')\n            if material_same_revision and batch<invalidated_batch:\n                raise ValueError('Reply predates material evidence revalidation')\n            if not exact and (material_same_revision or not printed.intersection(supplied)):\n                raise ValueError('Reply does not bind current subject source version')\n            if (pv.get('Employee ID')!=employee or pv.get('Trip reference')!=trip.get('Trip reference')\n                    or _revision(pv.get('Trip revision'))!=_revision(trip.get('Trip revision'))\n                    or any(pv.get(k)!=trip.get(k) for k in ('Business purpose','Client','Schedule coverage','Alternatives considered','Permit reference','Permit revision'))):\n                raise ValueError('Packet does not match current trip/permit evidence')\n            if kind=='claim' and set(str(pv.get('Expense references') or '').splitlines())!=set(cost_ids):\n                raise ValueError('Packet expense list does not match review subject')\n            if kind=='permit':\n                from .finance import _cents\n                if not amount_known or _cents(pv.get('Reviewed estimate (EUR)'))!=amount_cents:\n                    raise ValueError('Missing/mismatched reviewed permit estimate')\n            if not set(cancellation_ids)<=set(str(pv.get('Travel cancellation references') or '').splitlines()):\n                raise ValueError('Packet lacks current cancellation context')\n            budget_refs=set(str(pv.get('Budget record references') or '').splitlines())\n            if not budget_refs or not budget_refs<=budget_ids: raise ValueError('Missing referenced budget records; no budget decision inferred')\n            stamp=utc_time(dv.get('Decision time (UTC)'))\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in identities and identities[identity][0]!=payload:\n                conflicts.add(identity)\n            elif identity not in identities: identities[identity]=(payload,item)\n            else:\n                item.update(import_status='exact-replay',replayed_decision_id=identity)\n                continue\n            from .budget import budget_reply_error\n            budget_error=budget_reply_error(budget_context,decision,ps[0]) if 'budget_owner' in roles else None\n            item['budget_evidence_valid']=not budget_error\n            item['budget_revalidation_reason']=budget_error\n            item.update(evidence_valid=True,import_status='valid',order=stamp.isoformat(),decision_time=stamp.isoformat())\n        except (ValueError,TypeError,InvalidOperation) as exc:\n            item['rejection_reasons'].append(str(exc))\n    # Conflicting redelivery must hold an identity even when its later payload fails validation.\n    all_payloads={}\n    for item in deliveries:\n        dv=fields(item['raw_record']); identity=item['decision_id']\n        if (identity and dv.get('Subject reference')==subject_id and _revision(dv.get('Revision'))==revision\n                and _revision(dv.get('Arrival batch')) is not None and _revision(dv.get('Arrival batch'))<=arrival_batch):\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in all_payloads and all_payloads[identity]!=payload: conflicts.add(identity)\n            all_payloads[identity]=payload\n    for item in deliveries:\n        if item['decision_id'] in conflicts:\n            item.update(evidence_valid=False,import_status='conflicting-replay')\n            item['rejection_reasons'].append('Immutable decision identity has conflicting deliveries')\n    role_states={}; selected=[]\n    for role in required:\n        candidates=[d for d in deliveries if d['evidence_valid'] and role in d['roles'] and (role!='budget_owner' or d.get('budget_evidence_valid',True))]\n        if not candidates: role_states[role]='missing'; continue\n        latest=max(d['order'] for d in candidates)\n        matches=[d for d in candidates if d['order']==latest]\n        if len(matches)!=1:\n            role_states[role]='conflicting';continue\n        chosen=matches[0];chosen['active']=True;role_states[role]=chosen['outcome']\n        if chosen not in selected: selected.append(chosen)\n    withdrawal_valid=bool(withdrawn and source_bound(subject_record,observations) and source_bound(trip_record,observations)\n        and trip.get('Employee ID')==employee and len(people)==1 and source_bound(people[0],observations)\n        and isinstance(fields(subject_record).get('Claim reason'),str) and fields(subject_record)['Claim reason'].strip())\n    states=set(role_states.values())\n    state=('withdrawn' if withdrawal_valid else 'rejected' if 'reject' in states else 'returned' if 'return' in states\n           else 'approved' if states=={'approve'} and policy and amount_known else 'pending')\n    if not policy or conflicts and not withdrawal_valid: state='pending'\n    policy_binding=parsed.get('expense_policy') or {}\n    policy_refs=[f\"{policy_binding.get('path')}@{policy_binding.get('sha256')}#line {n}\" for n in (9,13,15,17)] if policy else []\n    return dict(policy_source_refs=policy_refs,subject_type=kind,subject_id=subject_id,revision=revision,state=state,required_roles=required,\n                amount_cents=amount_cents,amount_known=amount_known,evidence_digest=digest,withdrawal_requested=withdrawn,withdrawal_valid=withdrawal_valid,\n                material_same_revision=material_same_revision,invalidated_batch=invalidated_batch,policy_verified=policy,role_states=role_states,\n                deliveries=deliveries,active_decision_ids=[d['decision_id'] for d in selected],\n                source_refs=list(dict.fromkeys([ref(r) for r in basis_rows]+[r for d in deliveries for r in d['source_refs']])),\n                approved=state=='approved',repair_requests=[d['repair_requested'] for d in selected if d['outcome']=='return'])\n\n\ndef evaluate_permit(*, parsed, trip_record, decisions, arrival_batch, observations, prior=None, cost_ids=(), cancellations=(), budget_context=None):\n    trip=fields(trip_record)\n    if trip.get('International') is False:\n        affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n            and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))]\n        return dict(subject_type='permit',subject_id=None,revision=None,state='not-required',approved=True,\n                    arrangement_authorized=policy_valid(parsed.get('expense_policy')) and not affected,\n                    arrangements_at_commitment_supported=policy_valid(parsed.get('expense_policy')),\n                    cancellation_ids=[c['cancellation_id'] for c in affected], source_refs=[ref(trip_record)],deliveries=[])\n    from .finance import _cents\n    subject=deepcopy(trip_record)\n    # Newly parsed workbooks retain the printed source version in their preamble.\n    subject['text']='\\n'.join(str(c.get('value','')) for s in parsed.get('workbook_sheets',[])\n        if s.get('source_id')==trip_record.get('source_id') for c in s.get('preamble',[]))\n    result=evaluate_reviews(parsed=parsed,kind='permit',subject_id=trip.get('Permit reference'),revision=_revision(trip.get('Permit revision')),\n        trip_record=trip_record,employee=trip.get('Employee ID'),subject_record=subject,amount_cents=_cents(trip.get('Estimate (EUR)')),\n        decisions=decisions,arrival_batch=arrival_batch,observations=observations,cost_ids=cost_ids,prior=prior,budget_context=budget_context)\n    result['budget_context']=budget_context\n    result['arrangement_authorized']=False\n    if result['approved'] and trip.get('International') is True:\n        commitment=trip.get('First commitment date')\n        if commitment in (None,''):\n            result['arrangement_authorized']=True\n        else:\n            try:\n                day=local_date(commitment)\n                active=[d for d in result['deliveries'] if d['active']]\n                latest=max(utc_time(d['decision_time']) for d in active).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n                result['arrangement_authorized']=latest<day\n                result['timing_finding']=None if latest<day else 'late_permit' if latest>day else 'same-day-order-unconfirmed'\n            except (ValueError,TypeError): result['timing_finding']='missing-commitment-evidence'\n    result['arrangements_at_commitment_supported']=result['arrangement_authorized']\n    affected=[c for c in cancellations if c.get('trip_id')==trip.get('Trip reference')\n        and _revision(c.get('trip_revision'))==_revision(trip.get('Trip revision'))\n        and (c.get('target_type')=='trip' or (c.get('permit_id')==trip.get('Permit reference')\n             and _revision(c.get('permit_revision'))==_revision(trip.get('Permit revision'))))]\n    result['cancellation_ids']=[c['cancellation_id'] for c in affected]\n    if affected: result['arrangement_authorized']=False\n    return result\n"},"started_at_ms":1792061539196,"completed_at_ms":1792061539254}}
{"timestamp":"2026-10-15T10:52:20.018Z","ordinal":4298,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13f30-dcaa-7053-8391-0211a28144b2","item":{"type":"CommandExecution","id":"exec-f55d333e-5a90-4758-a228-7ef47cf6a90b","process_id":"79807","command":["/bin/bash","-lc","cat tests/test_expenses.py; sed -n '1,85p' tests/test_ordinary.py; cat src/travel_claim/event_validation.py | head -42; ls /tmp/*hash* 2>/dev/null"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"cat tests/test_expenses.py; sed -n '1,85p' tests/test_ordinary.py; cat src/travel_claim/event_validation.py | head -42; ls /tmp/*hash* 2>/dev/null"}],"source":"unified_exec_startup","status":"failed","stdout":"\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\ndef test_categories_and_caps(category, units, amount):\n    parsed, record, trip = setup()\n    receipt = parsed['records']['receipts'][0]\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == amount\n    if category in {'lodging','meals'}:\n        assert lines[0]['conversion']['cap']['units'] == units\n\n\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\ndef test_fractional_or_invalid_units_unresolved(units):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\n    ('Transaction reference',None),('Receipt reference','OTHER')])\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99')])\ndef test_mismatched_receipt(field, value):\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\n\n\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\n    parsed, record, trip = setup()\n    duplicate = deepcopy(merchant(parsed)); parsed['records']['merchant_payments'] = [merchant(parsed), duplicate]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n    setfield(duplicate,'Gross amount','200.00')\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('rate,expected', [('0.90005',9001),('0.900049',9000),('0.90015',9002)])\ndef test_exact_payment_date_fx_half_up(rate, expected):\n    parsed, record, trip = setup()\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == expected\n    assert lines[0]['conversion']['eur_rate'] == rate\n    assert lines[0]['conversion']['rounding'] == 'ROUND_HALF_UP'\n\n\n@pytest.mark.parametrize('missing', ['policy','tampered-policy','receipt','merchant','rate','cap','category'])\ndef test_missing_inputs_stay_unresolved(missing):\n    parsed, record, trip = setup()\n    if missing == 'policy': parsed.pop('expense_policy')\n    if missing == 'tampered-policy': parsed['expense_policy']['text'] += '\\n'\n    if missing == 'receipt': parsed['records']['receipts'] = []\n    if missing == 'merchant': parsed['records']['merchant_payments'] = []\n    if missing == 'category': setfield(parsed['records']['receipts'][0],'Category','entertainment')\n    if missing == 'cap':\n        setfield(parsed['records']['receipts'][0],'Category','lodging'); parsed['records']['caps'] = []\n    if missing == 'rate':\n        record['text'] = record['text'].replace('EUR','USD')\n        setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n        parsed['records']['fx_rates'] = []\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('submitted,status', [('2026-10-31','PASS'),('2026-11-01','BLOCKED'),('2026-08-31','BLOCKED')])\ndef test_inclusive_deadline_and_paid_before_submission(submitted,status):\n    parsed, record, trip = setup(); trip['End date'] = '2026-08-31'\n    record['text'] = record['text'].replace('2026-09-01',submitted); setfield(record,'Submitted date',submitted)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == status\n    if submitted > '2026-10-31': assert 'Late filing' in lines[0]['reason']\n\n\ndef test_paid_pretravel_submission_is_allowed_and_import_date_is_ignored():\n    parsed, record, trip = setup(); trip.update({'Start date':'2026-10-01','End date':'2026-10-10'})\n    parsed['import_date'] = '2099-01-01'\n    assert evaluate(parsed,record,trip)[0]['status'] == 'PASS'\n\n\ndef test_unchanged_cost_keeps_submission_date_but_new_cost_does_not_inherit_it():\n    parsed, record, trip = setup(); old = deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-11-01'); setfield(record,'Submitted date','2026-11-01')\n    trip['End date'] = '2026-08-31'\n    history = [dict(record=old)]\n    result, lines = evaluate(parsed,record,trip,history)\n    assert result['status'] == 'PASS' and lines[0]['filing']['first_submission_date'] == '2026-09-01'\n    record['text'] = record['text'].replace('COST-01','COST-NEW')\n    for row in [parsed['records']['receipts'][0],merchant(parsed)]:\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    result, lines = evaluate(parsed,record,trip,history)\n    assert lines[0]['filing']['first_submission_date'] == '2026-11-01'\n    assert result['status'] == 'BLOCKED'\n\n\ndef test_late_exception_requires_exact_finance_actor_revision_cost_and_covered_issue():\n    parsed, record, trip = setup(); trip['End date'] = '2026-06-01'\n    person = fields(table(parsed,'people','People')[0])\n    exception = {'Authorizing Finance officer':person['Finance officer'],'Applies to claim':'C01',\n        'Applies to revision':'1','Expense reference':'COST-01','Allowed original amount':'100.00',\n        'Covered issues':'Late filing','Exception reason':'SYNTHETIC explicit exception'}\n    for key,value in exception.items(): setfield(record,key,value)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'PASS'\n    assert 'Late filing' in lines[0]['filing']['original_finding']\n    for key in ('Authorizing Finance officer','Applies to claim','Applies to revision','Expense reference','Covered issues'):\n        changed = deepcopy(record); setfield(changed,key,'WRONG')\n        assert evaluate(parsed,changed,trip)[0]['status'] == 'BLOCKED'\n\n\ndef test_malformed_extra_line_blocks_total_without_losing_valid_line():\n    parsed, record, trip = setup()\n    record['text'] += '\\n 2 COST-BAD malformed\\n'\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and len(lines) == 2\n    assert lines[0]['calculated_cents'] == 10000\n    assert lines[1]['calculated_cents'] is None\n\n\ndef test_round_each_line_then_sum_and_independent_missing_evidence():\n    parsed, record, trip = setup()\n    first_receipt = parsed['records']['receipts'][0]\n    first_merchant = merchant(parsed)\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(first_receipt,'Currency','USD'); setfield(first_merchant,'Currency','USD')\n    second_receipt=deepcopy(first_receipt); second_merchant=deepcopy(first_merchant)\n    for row in (second_receipt,second_merchant):\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    setfield(second_merchant,'Transaction reference','SYNTHETIC-SECOND')\n    parsed['records']['receipts'].append(second_receipt)\n    parsed['records']['merchant_payments'] = [first_merchant,second_merchant]\n    record['text'] += '\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\n'\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] == 18002\n    assert [l['calculated_cents'] for l in lines] == [9001,9001]\n    parsed['records']['receipts'].remove(second_receipt)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and lines[0]['calculated_cents'] == 9001\n\n\ndef test_correction_cannot_backdate_unchanged_cost():\n    parsed, record, trip = setup(); old=deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-08-01')\n    result, lines = evaluate(parsed,record,trip,[dict(revision=1,record=old)])\n    assert lines[0]['filing']['first_submission_date'] == '2026-09-01'\n\n\n@pytest.mark.parametrize('field,value', [('Destination','WRONG'),('Currency','USD'),\n    ('Effective from','2026-09-02'),('Effective to','2026-08-31')])\ndef test_cap_must_match_destination_currency_and_payment_date(field,value):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0],'Category','lodging')\n    cap=dict(source_id='synthetic-cap',source_sha256='a'*64,locator='synthetic cap',values={k:dict(value=v)\n        for k,v in {'Destination':trip['Destination'],'Category':'lodging','Currency':'EUR',\n        'Effective from':'2026-01-01','Effective to':'2026-12-31','Amount per unit':'40.00'}.items()})\n    setfield(cap,field,value); parsed['records']['caps']=[cap]\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\ndef test_eur_does_not_require_or_use_a_supplied_fx_row():\n    parsed, record, trip = setup()\n    parsed['records']['fx_rates'] = [dict(values={'Currency':dict(value='EUR'),'Rate date':dict(value='bad'),\n        'EUR per currency unit':dict(value='2')})]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n\n\ndef test_multiple_payment_dates_are_held_without_choosing_rate_or_cap():\n    parsed, record, trip = setup(); first=merchant(parsed); second=deepcopy(first)\n    setfield(first,'Gross amount','50.00'); setfield(second,'Gross amount','50.00')\n    setfield(second,'Transaction reference','SYNTHETIC-SECOND'); setfield(second,'Paid date','2026-08-31')\n    parsed['records']['merchant_payments']=[first,second]\n    result, lines=evaluate(parsed,record,trip)\n    assert result['status']=='BLOCKED' and lines[0]['evidence_status']=='PASS'\n    assert 'allocation' in lines[0]['reason']\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n","stderr":"","aggregated_output":"\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\ndef test_categories_and_caps(category, units, amount):\n    parsed, record, trip = setup()\n    receipt = parsed['records']['receipts'][0]\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == amount\n    if category in {'lodging','meals'}:\n        assert lines[0]['conversion']['cap']['units'] == units\n\n\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\ndef test_fractional_or_invalid_units_unresolved(units):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\n    ('Transaction reference',None),('Receipt reference','OTHER')])\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99')])\ndef test_mismatched_receipt(field, value):\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\n\n\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\n    parsed, record, trip = setup()\n    duplicate = deepcopy(merchant(parsed)); parsed['records']['merchant_payments'] = [merchant(parsed), duplicate]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n    setfield(duplicate,'Gross amount','200.00')\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('rate,expected', [('0.90005',9001),('0.900049',9000),('0.90015',9002)])\ndef test_exact_payment_date_fx_half_up(rate, expected):\n    parsed, record, trip = setup()\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == expected\n    assert lines[0]['conversion']['eur_rate'] == rate\n    assert lines[0]['conversion']['rounding'] == 'ROUND_HALF_UP'\n\n\n@pytest.mark.parametrize('missing', ['policy','tampered-policy','receipt','merchant','rate','cap','category'])\ndef test_missing_inputs_stay_unresolved(missing):\n    parsed, record, trip = setup()\n    if missing == 'policy': parsed.pop('expense_policy')\n    if missing == 'tampered-policy': parsed['expense_policy']['text'] += '\\n'\n    if missing == 'receipt': parsed['records']['receipts'] = []\n    if missing == 'merchant': parsed['records']['merchant_payments'] = []\n    if missing == 'category': setfield(parsed['records']['receipts'][0],'Category','entertainment')\n    if missing == 'cap':\n        setfield(parsed['records']['receipts'][0],'Category','lodging'); parsed['records']['caps'] = []\n    if missing == 'rate':\n        record['text'] = record['text'].replace('EUR','USD')\n        setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n        parsed['records']['fx_rates'] = []\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('submitted,status', [('2026-10-31','PASS'),('2026-11-01','BLOCKED'),('2026-08-31','BLOCKED')])\ndef test_inclusive_deadline_and_paid_before_submission(submitted,status):\n    parsed, record, trip = setup(); trip['End date'] = '2026-08-31'\n    record['text'] = record['text'].replace('2026-09-01',submitted); setfield(record,'Submitted date',submitted)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == status\n    if submitted > '2026-10-31': assert 'Late filing' in lines[0]['reason']\n\n\ndef test_paid_pretravel_submission_is_allowed_and_import_date_is_ignored():\n    parsed, record, trip = setup(); trip.update({'Start date':'2026-10-01','End date':'2026-10-10'})\n    parsed['import_date'] = '2099-01-01'\n    assert evaluate(parsed,record,trip)[0]['status'] == 'PASS'\n\n\ndef test_unchanged_cost_keeps_submission_date_but_new_cost_does_not_inherit_it():\n    parsed, record, trip = setup(); old = deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-11-01'); setfield(record,'Submitted date','2026-11-01')\n    trip['End date'] = '2026-08-31'\n    history = [dict(record=old)]\n    result, lines = evaluate(parsed,record,trip,history)\n    assert result['status'] == 'PASS' and lines[0]['filing']['first_submission_date'] == '2026-09-01'\n    record['text'] = record['text'].replace('COST-01','COST-NEW')\n    for row in [parsed['records']['receipts'][0],merchant(parsed)]:\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    result, lines = evaluate(parsed,record,trip,history)\n    assert lines[0]['filing']['first_submission_date'] == '2026-11-01'\n    assert result['status'] == 'BLOCKED'\n\n\ndef test_late_exception_requires_exact_finance_actor_revision_cost_and_covered_issue():\n    parsed, record, trip = setup(); trip['End date'] = '2026-06-01'\n    person = fields(table(parsed,'people','People')[0])\n    exception = {'Authorizing Finance officer':person['Finance officer'],'Applies to claim':'C01',\n        'Applies to revision':'1','Expense reference':'COST-01','Allowed original amount':'100.00',\n        'Covered issues':'Late filing','Exception reason':'SYNTHETIC explicit exception'}\n    for key,value in exception.items(): setfield(record,key,value)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'PASS'\n    assert 'Late filing' in lines[0]['filing']['original_finding']\n    for key in ('Authorizing Finance officer','Applies to claim','Applies to revision','Expense reference','Covered issues'):\n        changed = deepcopy(record); setfield(changed,key,'WRONG')\n        assert evaluate(parsed,changed,trip)[0]['status'] == 'BLOCKED'\n\n\ndef test_malformed_extra_line_blocks_total_without_losing_valid_line():\n    parsed, record, trip = setup()\n    record['text'] += '\\n 2 COST-BAD malformed\\n'\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and len(lines) == 2\n    assert lines[0]['calculated_cents'] == 10000\n    assert lines[1]['calculated_cents'] is None\n\n\ndef test_round_each_line_then_sum_and_independent_missing_evidence():\n    parsed, record, trip = setup()\n    first_receipt = parsed['records']['receipts'][0]\n    first_merchant = merchant(parsed)\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(first_receipt,'Currency','USD'); setfield(first_merchant,'Currency','USD')\n    second_receipt=deepcopy(first_receipt); second_merchant=deepcopy(first_merchant)\n    for row in (second_receipt,second_merchant):\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    setfield(second_merchant,'Transaction reference','SYNTHETIC-SECOND')\n    parsed['records']['receipts'].append(second_receipt)\n    parsed['records']['merchant_payments'] = [first_merchant,second_merchant]\n    record['text'] += '\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\n'\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] == 18002\n    assert [l['calculated_cents'] for l in lines] == [9001,9001]\n    parsed['records']['receipts'].remove(second_receipt)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and lines[0]['calculated_cents'] == 9001\n\n\ndef test_correction_cannot_backdate_unchanged_cost():\n    parsed, record, trip = setup(); old=deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-08-01')\n    result, lines = evaluate(parsed,record,trip,[dict(revision=1,record=old)])\n    assert lines[0]['filing']['first_submission_date'] == '2026-09-01'\n\n\n@pytest.mark.parametrize('field,value', [('Destination','WRONG'),('Currency','USD'),\n    ('Effective from','2026-09-02'),('Effective to','2026-08-31')])\ndef test_cap_must_match_destination_currency_and_payment_date(field,value):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0],'Category','lodging')\n    cap=dict(source_id='synthetic-cap',source_sha256='a'*64,locator='synthetic cap',values={k:dict(value=v)\n        for k,v in {'Destination':trip['Destination'],'Category':'lodging','Currency':'EUR',\n        'Effective from':'2026-01-01','Effective to':'2026-12-31','Amount per unit':'40.00'}.items()})\n    setfield(cap,field,value); parsed['records']['caps']=[cap]\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\ndef test_eur_does_not_require_or_use_a_supplied_fx_row():\n    parsed, record, trip = setup()\n    parsed['records']['fx_rates'] = [dict(values={'Currency':dict(value='EUR'),'Rate date':dict(value='bad'),\n        'EUR per currency unit':dict(value='2')})]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n\n\ndef test_multiple_payment_dates_are_held_without_choosing_rate_or_cap():\n    parsed, record, trip = setup(); first=merchant(parsed); second=deepcopy(first)\n    setfield(first,'Gross amount','50.00'); setfield(second,'Gross amount','50.00')\n    setfield(second,'Transaction reference','SYNTHETIC-SECOND'); setfield(second,'Paid date','2026-08-31')\n    parsed['records']['merchant_payments']=[first,second]\n    result, lines=evaluate(parsed,record,trip)\n    assert result['status']=='BLOCKED' and lines[0]['evidence_status']=='PASS'\n    assert 'allocation' in lines[0]['reason']\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n","exit_code":2,"duration":{"secs":0,"nanos":67357767},"formatted_output":"\"\"\"Native source-shaped evidence; all mutations below are synthetic probes.\n\nThe policy fixture preserves the user's complete browser copy byte for byte,\nSHA-256 f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2.\nIt is not a fresh native Notion retrieval.\n\"\"\"\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nfrom travel_claim.expenses import evaluate_expenses, filing_deadline, load_expense_policy\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\n\nFIXTURES = Path(__file__).parent / 'fixtures'\n\n\ndef setup():\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\n    record = parsed['records']['claim_revisions'][0]\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\n    return parsed, record, trip\n\n\ndef setfield(row, key, value):\n    if 'fields' in row:\n        for f in row['fields']:\n            if f['label'] == key:\n                f['value'] = value\n                return\n        row['fields'].append(dict(label=key, value=value))\n    else:\n        row['values'][key] = dict(value=value)\n\n\ndef evaluate(parsed, record, trip, history=()):\n    lines = expense_lines(record)\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\n    return result, lines\n\n\ndef merchant(parsed):\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\n\n\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\n    parsed, record, trip = setup()\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\n    line = lines[0]\n    assert line['conversion']['eur_rate'] == '1'\n    assert line['conversion']['original_amount'] == '100.00'\n    assert line['filing']['first_submission_date'] == '2026-09-01'\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\n    assert any(\"#tab 'Merchant payments', row 6\" in r for r in line['source_refs'])\n    assert all('line ' in r for r in result['policy_source_refs'])\n\n\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\ndef test_calendar_deadline(end, expected):\n    assert filing_deadline(end).isoformat() == expected\n\n\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\ndef test_categories_and_caps(category, units, amount):\n    parsed, record, trip = setup()\n    receipt = parsed['records']['receipts'][0]\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == amount\n    if category in {'lodging','meals'}:\n        assert lines[0]['conversion']['cap']['units'] == units\n\n\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\ndef test_fractional_or_invalid_units_unresolved(units):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\n    ('Transaction reference',None),('Receipt reference','OTHER')])\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\n    result, lines = evaluate(parsed, record, trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\n    ('Currency','USD'),('Gross amount','99.99')])\ndef test_mismatched_receipt(field, value):\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\n\n\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\n    parsed, record, trip = setup()\n    duplicate = deepcopy(merchant(parsed)); parsed['records']['merchant_payments'] = [merchant(parsed), duplicate]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n    setfield(duplicate,'Gross amount','200.00')\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('rate,expected', [('0.90005',9001),('0.900049',9000),('0.90015',9002)])\ndef test_exact_payment_date_fx_half_up(rate, expected):\n    parsed, record, trip = setup()\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\n    result, lines = evaluate(parsed, record, trip)\n    assert result['calculated_cents'] == expected\n    assert lines[0]['conversion']['eur_rate'] == rate\n    assert lines[0]['conversion']['rounding'] == 'ROUND_HALF_UP'\n\n\n@pytest.mark.parametrize('missing', ['policy','tampered-policy','receipt','merchant','rate','cap','category'])\ndef test_missing_inputs_stay_unresolved(missing):\n    parsed, record, trip = setup()\n    if missing == 'policy': parsed.pop('expense_policy')\n    if missing == 'tampered-policy': parsed['expense_policy']['text'] += '\\n'\n    if missing == 'receipt': parsed['records']['receipts'] = []\n    if missing == 'merchant': parsed['records']['merchant_payments'] = []\n    if missing == 'category': setfield(parsed['records']['receipts'][0],'Category','entertainment')\n    if missing == 'cap':\n        setfield(parsed['records']['receipts'][0],'Category','lodging'); parsed['records']['caps'] = []\n    if missing == 'rate':\n        record['text'] = record['text'].replace('EUR','USD')\n        setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\n        parsed['records']['fx_rates'] = []\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\n\n\n@pytest.mark.parametrize('submitted,status', [('2026-10-31','PASS'),('2026-11-01','BLOCKED'),('2026-08-31','BLOCKED')])\ndef test_inclusive_deadline_and_paid_before_submission(submitted,status):\n    parsed, record, trip = setup(); trip['End date'] = '2026-08-31'\n    record['text'] = record['text'].replace('2026-09-01',submitted); setfield(record,'Submitted date',submitted)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == status\n    if submitted > '2026-10-31': assert 'Late filing' in lines[0]['reason']\n\n\ndef test_paid_pretravel_submission_is_allowed_and_import_date_is_ignored():\n    parsed, record, trip = setup(); trip.update({'Start date':'2026-10-01','End date':'2026-10-10'})\n    parsed['import_date'] = '2099-01-01'\n    assert evaluate(parsed,record,trip)[0]['status'] == 'PASS'\n\n\ndef test_unchanged_cost_keeps_submission_date_but_new_cost_does_not_inherit_it():\n    parsed, record, trip = setup(); old = deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-11-01'); setfield(record,'Submitted date','2026-11-01')\n    trip['End date'] = '2026-08-31'\n    history = [dict(record=old)]\n    result, lines = evaluate(parsed,record,trip,history)\n    assert result['status'] == 'PASS' and lines[0]['filing']['first_submission_date'] == '2026-09-01'\n    record['text'] = record['text'].replace('COST-01','COST-NEW')\n    for row in [parsed['records']['receipts'][0],merchant(parsed)]:\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    result, lines = evaluate(parsed,record,trip,history)\n    assert lines[0]['filing']['first_submission_date'] == '2026-11-01'\n    assert result['status'] == 'BLOCKED'\n\n\ndef test_late_exception_requires_exact_finance_actor_revision_cost_and_covered_issue():\n    parsed, record, trip = setup(); trip['End date'] = '2026-06-01'\n    person = fields(table(parsed,'people','People')[0])\n    exception = {'Authorizing Finance officer':person['Finance officer'],'Applies to claim':'C01',\n        'Applies to revision':'1','Expense reference':'COST-01','Allowed original amount':'100.00',\n        'Covered issues':'Late filing','Exception reason':'SYNTHETIC explicit exception'}\n    for key,value in exception.items(): setfield(record,key,value)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['status'] == 'PASS'\n    assert 'Late filing' in lines[0]['filing']['original_finding']\n    for key in ('Authorizing Finance officer','Applies to claim','Applies to revision','Expense reference','Covered issues'):\n        changed = deepcopy(record); setfield(changed,key,'WRONG')\n        assert evaluate(parsed,changed,trip)[0]['status'] == 'BLOCKED'\n\n\ndef test_malformed_extra_line_blocks_total_without_losing_valid_line():\n    parsed, record, trip = setup()\n    record['text'] += '\\n 2 COST-BAD malformed\\n'\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and len(lines) == 2\n    assert lines[0]['calculated_cents'] == 10000\n    assert lines[1]['calculated_cents'] is None\n\n\ndef test_round_each_line_then_sum_and_independent_missing_evidence():\n    parsed, record, trip = setup()\n    first_receipt = parsed['records']['receipts'][0]\n    first_merchant = merchant(parsed)\n    record['text'] = record['text'].replace('EUR','USD')\n    setfield(first_receipt,'Currency','USD'); setfield(first_merchant,'Currency','USD')\n    second_receipt=deepcopy(first_receipt); second_merchant=deepcopy(first_merchant)\n    for row in (second_receipt,second_merchant):\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\n    setfield(second_merchant,'Transaction reference','SYNTHETIC-SECOND')\n    parsed['records']['receipts'].append(second_receipt)\n    parsed['records']['merchant_payments'] = [first_merchant,second_merchant]\n    record['text'] += '\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\n'\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] == 18002\n    assert [l['calculated_cents'] for l in lines] == [9001,9001]\n    parsed['records']['receipts'].remove(second_receipt)\n    result, lines = evaluate(parsed,record,trip)\n    assert result['calculated_cents'] is None and lines[0]['calculated_cents'] == 9001\n\n\ndef test_correction_cannot_backdate_unchanged_cost():\n    parsed, record, trip = setup(); old=deepcopy(record)\n    record['text'] = record['text'].replace('2026-09-01','2026-08-01')\n    result, lines = evaluate(parsed,record,trip,[dict(revision=1,record=old)])\n    assert lines[0]['filing']['first_submission_date'] == '2026-09-01'\n\n\n@pytest.mark.parametrize('field,value', [('Destination','WRONG'),('Currency','USD'),\n    ('Effective from','2026-09-02'),('Effective to','2026-08-31')])\ndef test_cap_must_match_destination_currency_and_payment_date(field,value):\n    parsed, record, trip = setup()\n    setfield(parsed['records']['receipts'][0],'Category','lodging')\n    cap=dict(source_id='synthetic-cap',source_sha256='a'*64,locator='synthetic cap',values={k:dict(value=v)\n        for k,v in {'Destination':trip['Destination'],'Category':'lodging','Currency':'EUR',\n        'Effective from':'2026-01-01','Effective to':'2026-12-31','Amount per unit':'40.00'}.items()})\n    setfield(cap,field,value); parsed['records']['caps']=[cap]\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\n\n\ndef test_eur_does_not_require_or_use_a_supplied_fx_row():\n    parsed, record, trip = setup()\n    parsed['records']['fx_rates'] = [dict(values={'Currency':dict(value='EUR'),'Rate date':dict(value='bad'),\n        'EUR per currency unit':dict(value='2')})]\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\n\n\ndef test_multiple_payment_dates_are_held_without_choosing_rate_or_cap():\n    parsed, record, trip = setup(); first=merchant(parsed); second=deepcopy(first)\n    setfield(first,'Gross amount','50.00'); setfield(second,'Gross amount','50.00')\n    setfield(second,'Transaction reference','SYNTHETIC-SECOND'); setfield(second,'Paid date','2026-08-31')\n    parsed['records']['merchant_payments']=[first,second]\n    result, lines=evaluate(parsed,record,trip)\n    assert result['status']=='BLOCKED' and lines[0]['evidence_status']=='PASS'\n    assert 'allocation' in lines[0]['reason']\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n"},"started_at_ms":1792061539950,"completed_at_ms":1792061540018}}
{"timestamp":"2026-10-15T10:52:20.489Z","ordinal":4299,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13f31-0888-7f91-ac74-2f863af77165","call_id":"call_f25168374260451eaf775449907f1fb9","output":[{"type":"input_text","text":"Script completed\nWall time 1.5 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 13040)\nTotal output lines: 2\n\n{\"chunk_id\":\"29fd59\",\"wall_time_seconds\":0.057618166,\"exit_code\":0,\"original_token_count\":7755,\"output\":\"?? artifacts/runs/\\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n?? artifacts/verification/project-d-step157-revalidation/\\n?? artifacts/verification/project-d-step167-audit-probes.json\\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\\n?? user-provided-sources/\\n791c8c787bbd617a7b7d3114f13c000249169151\\n\\\"\\\"\\\"POL-2026.2 expense arithmetic and local-calendar filing checks.\\n\\nThe policy is explicitly bound by its original bytes; this does not convert the\\nuser's browser copy into a successful native Notion capture or grant approval.\\n\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom calendar import monthrange\\nfrom datetime import date\\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\\nimport hashlib\\nfrom pathlib import Path\\n\\nfrom .exceptions import validate_exception, apply_coverage, finding\\n\\nPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\\n\\n\\ndef load_expense_policy(path):\\n    raw = Path(path).read_bytes()\\n    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\\n        raise ValueError('POL-2026.2 browser copy hash mismatch')\\n    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\\n                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\\n\\n\\ndef policy_valid(binding):\\n    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\\n            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\\n            and binding.get('sha256') == POLICY_SHA256)\\n\\n\\ndef local_date(value):\\n    \\\"\\\"\\\"Accept native local dates and Excel's naive midnight date serialization.\\\"\\\"\\\"\\n    text = str(value)\\n    if len(text) == 19 and text.endswith('T00:00:00'):\\n        text = text[:10]\\n    result = date.fromisoformat(text)\\n    if result.isoformat() != text:\\n        raise ValueError('Not a local calendar date')\\n    return result\\n\\n\\ndef filing_deadline(trip_end):\\n    end = local_date(trip_end)\\n    month = end.year * 12 + end.month - 1 + 2\\n    year, zero_month = divmod(month, 12)\\n    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\\n\\n\\ndef number(value):\\n    if isinstance(value, bool) or value is None:\\n        raise ValueError('Missing or invalid number')\\n    result = Decimal(str(value).replace(',', ''))\\n    if not result.is_finite() or result < 0:\\n        raise ValueError('Invalid amount')\\n    return result\\n\\n\\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\\n    \\\"\\\"\\\"Evaluate each line independently, retaining unresolved evidence and reasons.\\\"\\\"\\\"\\n    binding = parsed.get('expense_policy')\\n    verified = policy_valid(binding)\\n    policy_refs = [f\\\"{binding.get('path')}@{POLICY_SHA256}#line {n}\\\" for n in (5, 7, 11)] if verified else []\\n    receipts = parsed.get('records', {}).get('receipts', [])\\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\\n    rates = table(parsed, 'fx_rates', 'FX')\\n    caps = table(parsed, 'caps', 'Caps')\\n    observations = parsed.get('source_observations', []) if observations is None else observations\\n    people = table(parsed, 'people', 'People')\\n    for line in lines:\\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\\n        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\\n        line['eligibility_status'] = 'BLOCKED'\\n        exception = validate_exception(record=record, line=line, employee=employee, people=people,\\n            observations=observations, fields=fields, ref=ref)\\n        # An exception for another *present* cost has no effect on this line.\\n        target = fields(record).get('Expense reference')\\n        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\\n            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\\n        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\\n                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\\n                            for f in line['eligibility_findings'])):\\n            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\\n        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\\n        line['exception'] = exception\\n        line['source_refs'] += exception['source_refs']\\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\\n        try:\\n            gross = number(line['original_amount'])\\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\\n                raise ValueError('Missing receipt or nonpositive purchase')\\n            rv = fields(rs[0])\\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\\n                    and line['currency'].isalpha() and line['currency'].isupper()):\\n                raise ValueError('Receipt identity, currency or gross mismatch')\\n            unique = {}\\n            for row in ms:\\n                mv = fields(row); identity = mv.get('Transaction reference')\\n                # Identity is global: a redelivery under a different cost also conflicts.\\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\\n                if not identity or any(d != mv for d in deliveries):\\n                    raise ValueError('Conflicting merchant transaction identity')\\n                unique[identity] = row\\n            ms = list(unique.values())\\n            if not ms:\\n                raise ValueError('Missing settled merchant transaction')\\n            for row in ms:\\n                mv = fields(row)\\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\\n                    raise ValueError('Merchant payment is unsettled or mismatched')\\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\\n                raise ValueError('Merchant payments do not match gross amount')\\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\\n            if not verified:\\n                raise ValueError('Verified expense policy binding required')\\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\\n            if len(dates) != 1:\\n                raise ValueError('Multiple payment dates require source-supported allocation')\\n            paid = local_date(dates[0])\\n            if paid.year != 2026:\\n                raise ValueError('Payment outside supplied policy effective year')\\n            category = rv.get('Category')\\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\\n                raise ValueError('Unknown expense category')\\n            allowed = Decimal(0) if category == 'personal' else gross\\n            cap_evidence = None\\n            if category in {'lodging', 'meals'}:\\n                if not trip.get('Destination'):\\n                    raise ValueError('Missing destination for applicable cap')\\n                units = number(rv.get('Documented units'))\\n                if units <= 0 or units != units.to_integral_value():\\n                    raise ValueError('Capped units must be positive integers')\\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\\n                if len(cs) != 1:\\n                    raise ValueError('Missing or ambiguous applicable cap')\\n                cap = number(fields(cs[0]).get('Amount per unit'))\\n                with localcontext() as ctx:\\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\\n                    allowed = min(gross, cap * units)\\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\\n                line['source_refs'].append(ref(cs[0]))\\n            line['base_allowed_original_amount'] = str(allowed)\\n            deadline = filing_deadline(trip.get('End date'))\\n            submitted = local_date(line['first_submitted_date'])\\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\\n            from .ordinary import expense_lines\\n            first_supported = False\\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\\n                pr = prior.get('record', {})\\n                for old in expense_lines(pr):\\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\\n                            and number(old['original_amount']) == gross):\\n                        submitted = local_date(old['first_submitted_date'])\\n                        line['source_refs'] += old['source_refs']\\n                        first_supported = True\\n                        break\\n                if first_supported:\\n                    break\\n            if submitted > local_date(fields(record).get('Submitted date')):\\n                raise ValueError('Cost submission is later than claim submission')\\n            if submitted < paid:\\n                raise ValueError('Submission precedes established employee payment')\\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\\n            if submitted > deadline:\\n                original = 'Late filing held pending explicit version-bound Finance exception'\\n                line['filing']['original_finding'] = original\\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\\n            if exception['status'] == 'valid':\\n                replacement = Decimal(exception['replacement_original_amount'])\\n                if category == 'personal' and replacement != 0:\\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\\n                allowed = replacement\\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\\n            apply_coverage(line['eligibility_findings'], exception)\\n            if line['currency'] == 'EUR':\\n                rate = Decimal(1); rate_refs = policy_refs\\n            else:\\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\\n                      and local_date(fields(r).get('Rate date')) == paid]\\n                if len(fx) != 1:\\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\\n                if rate <= 0:\\n                    raise ValueError('FX rate must be positive')\\n            with localcontext() as ctx:\\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\\n                converted = allowed * rate\\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\\n            line['source_refs'] += rate_refs\\n            line.update(calculated_cents=cents, calculation_status='PASS',\\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\\n            line['filing_status'] = 'BLOCKED' if any(\\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\\n                                                    for f in line['eligibility_findings']):\\n                line['filing']['exception'] = deepcopy(exception)\\n            if exception['status'] == 'BLOCKED':\\n                raise ValueError(exception['reason'])\\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\\n            line.update(eligibility_status='PASS', status='supported',\\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\\n                        else 'Supported paid expense calculation and timely filing')\\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\\n            line['reason'] = str(exc)\\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\\n    return dict(status='PASS' if complete else 'BLOCKED',\\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\\n                policy_source_refs=policy_refs, policy_verified=verified)\\n\\\"\\\"\\\"POL-2026.2 review authority and business transitions, without financial closure.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom datetime import datetime, timezone\\nfrom decimal import Decimal, InvalidOperation\\nimport hashlib\\nimport json\\nimport re\\nfrom zoneinfo import ZoneInfo\\n\\nfrom .exceptions import source_bound\\nfrom .expenses import policy_valid, local_date\\nfrom .workflow import _revision, row_values\\n\\nROLES = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner',\\n         'supervisor': 'Supervisor', 'director': 'Director'}\\n\\n\\ndef fields(row):\\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\\n\\n\\ndef ref(row):\\n    return f\\\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\\\"\\n\\n\\ndef table(parsed, key, name):\\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == name), []))\\n\\n\\ndef utc_time(value):\\n    if not isinstance(value, str) or 'T' not in value:\\n        raise ValueError('Missing decision UTC time')\\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\\n    # Native workbook column explicitly specifies UTC.\\n    return stamp.replace(tzinfo=timezone.utc) if stamp.tzinfo is None else stamp.astimezone(timezone.utc)\\n\\n\\ndef versions(row):\\n    return set(re.findall(r'\\\\b(?:SRC-D-\\\\d+|POL-\\\\d{4}\\\\.\\\\d+)\\\\b', row.get('text', '')))\\n\\n\\ndef evidence_digest(rows, amount):\\n    \\\"\\\"\\\"Compare material facts, retaining source versions but ignoring arrival metadata.\\\"\\\"\\\"\\n    content=[]\\n    for row in rows:\\n        value=fields(row)\\n        content.append(dict(source_id=row.get('source_id'), sha256=row.get('source_sha256'),\\n                            values={k:v for k,v in value.items() if k not in {'Arrival batch', 'Status', 'Claim reason'}}))\\n    return hashlib.sha256(json.dumps(dict(rows=content, amount=amount), sort_keys=True, default=str).encode()).hexdigest()\\n\\n\\ndef evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employee,\\n                     subject_record, amount_cents, decisions, arrival_batch, observations,\\n                     cost_ids=(), prior=None, dependency_rows=(), withdrawn=False, cancellation_ids=(), budget_context=None):\\n    \\\"\\\"\\\"Evaluate supplied replies only. Invalid/stale imports stay in deliveries.\\\"\\\"\\\"\\n    trip=fields(trip_record); policy=policy_valid(parsed.get('expense_policy'))\\n    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==employee]\\n    person=fields(people[0]) if len(people)==1 else {}\\n    packets=table(parsed,'review_packets','Review packets')\\n    required=['administration','budget_owner','supervisor']\\n    amount_known=isinstance(amount_cents,int) and not isinstance(amount_cents,bool) and amount_cents>=0\\n    if amount_known and amount_cents>100000: required.append('director')\\n    basis_rows=[subject_record,trip_record]+people+list(dependency_rows)\\n    digest=evidence_digest(basis_rows,dict(amount_cents=amount_cents,cost_ids=sorted(cost_ids) if kind=='claim' else [],cancellation_ids=sorted(cancellation_ids)))\\n    material_same_revision=bool(prior and prior.get('revision')==revision and\\n        (prior.get('evidence_digest')!=digest or prior.get('material_same_revision')))\\n    invalidated_batch=(prior.get('invalidated_batch') if prior and prior.get('material_same_revision') and prior.get('revision')==revision else arrival_batch) if material_same_revision else None\\n    deliveries=[]; identities={}; conflicts=set()\\n    budget_ids={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget')}\\n    for decision in decisions:\\n        dv=fields(decision); identity=dv.get('Decision reference')\\n        ps=[p for p in packets if fields(p).get('Decision reference')==identity]\\n        relevant=(dv.get('Subject reference')==subject_id or any(fields(p).get('Trip reference')==trip.get('Trip reference')\\n                  and fields(p).get('Employee ID')==employee for p in ps))\\n        if not relevant: continue\\n        item=dict(decision_id=identity, outcome=dv.get('Outcome'), roles=str(dv.get('Review roles') or '').splitlines(),\\n                  reason=dv.get('Reason'), repair_requested=dv.get('Repair requested'), evidence_valid=False,\\n                  active=False, import_status='rejected-import', source_refs=[ref(decision)]+[ref(p) for p in ps],\\n                  raw_record=deepcopy(decision), rejection_reasons=[])\\n        deliveries.append(item)\\n        try:\\n            batch=_revision(dv.get('Arrival batch'))\\n            if batch is None or batch>arrival_batch: raise ValueError('Reply outside consumed arrival batches')…3040 tokens truncated…ses, filing_deadline, load_expense_policy\\nfrom travel_claim.ordinary import expense_lines, fields, ref, table\\n\\nFIXTURES = Path(__file__).parent / 'fixtures'\\n\\n\\ndef setup():\\n    parsed = json.loads((FIXTURES / 'ordinary_claim_c01.json').read_text())\\n    parsed['expense_policy'] = load_expense_policy(FIXTURES / 'POL-2026.2-browser-copy.txt')\\n    record = parsed['records']['claim_revisions'][0]\\n    trip = fields(table(parsed, 'trips', 'Trips')[0])\\n    return parsed, record, trip\\n\\n\\ndef setfield(row, key, value):\\n    if 'fields' in row:\\n        for f in row['fields']:\\n            if f['label'] == key:\\n                f['value'] = value\\n                return\\n        row['fields'].append(dict(label=key, value=value))\\n    else:\\n        row['values'][key] = dict(value=value)\\n\\n\\ndef evaluate(parsed, record, trip, history=()):\\n    lines = expense_lines(record)\\n    result = evaluate_expenses(lines=lines, parsed=parsed, employee='EMP-01', trip_id='T01',\\n        trip=trip, record=record, history=history, fields=fields, ref=ref, table=table)\\n    return result, lines\\n\\n\\ndef merchant(parsed):\\n    return next(r for r in table(parsed, 'merchant_payments', 'Merchant payments') if fields(r)['Expense reference'] == 'COST-01')\\n\\n\\ndef test_retained_c01_actual_paid_expense_preserves_source_and_conversion():\\n    parsed, record, trip = setup()\\n    result, lines = evaluate(parsed, record, trip)\\n    assert result['status'] == 'PASS' and result['calculated_cents'] == 10000\\n    line = lines[0]\\n    assert line['conversion']['eur_rate'] == '1'\\n    assert line['conversion']['original_amount'] == '100.00'\\n    assert line['filing']['first_submission_date'] == '2026-09-01'\\n    assert any('#PDF page 1, receipt 1' in r for r in line['source_refs'])\\n    assert any(\\\"#tab 'Merchant payments', row 6\\\" in r for r in line['source_refs'])\\n    assert all('line ' in r for r in result['policy_source_refs'])\\n\\n\\n@pytest.mark.parametrize('end,expected', [('2026-08-31','2026-10-31'), ('2023-12-31','2024-02-29'),\\n    ('2024-12-31','2025-02-28'), ('2026-07-31','2026-09-30'), ('2024-02-29','2024-04-29')])\\ndef test_calendar_deadline(end, expected):\\n    assert filing_deadline(end).isoformat() == expected\\n\\n\\n@pytest.mark.parametrize('category,units,amount', [('transport','0',10000),('conference','0',10000),\\n    ('personal','1',0),('lodging','2',8000),('meals','1',4000)])\\ndef test_categories_and_caps(category, units, amount):\\n    parsed, record, trip = setup()\\n    receipt = parsed['records']['receipts'][0]\\n    setfield(receipt, 'Category', category); setfield(receipt, 'Documented units', units)\\n    parsed['records']['caps'] = [dict(source_id='synthetic-cap', source_sha256='a'*64, locator='synthetic cap',\\n        values={k:dict(value=v) for k,v in {'Destination':trip['Destination'], 'Category':category,\\n        'Currency':'EUR','Effective from':'2026-09-01','Effective to':'2026-09-01','Amount per unit':'40.00'}.items()})]\\n    result, lines = evaluate(parsed, record, trip)\\n    assert result['calculated_cents'] == amount\\n    if category in {'lodging','meals'}:\\n        assert lines[0]['conversion']['cap']['units'] == units\\n\\n\\n@pytest.mark.parametrize('units', ['0','-1','1.5','NaN',True,None])\\ndef test_fractional_or_invalid_units_unresolved(units):\\n    parsed, record, trip = setup()\\n    setfield(parsed['records']['receipts'][0], 'Category', 'lodging')\\n    setfield(parsed['records']['receipts'][0], 'Documented units', units)\\n    result, lines = evaluate(parsed, record, trip)\\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\\n\\n\\n@pytest.mark.parametrize('field,value', [('Employee ID','OTHER'),('Trip reference','OTHER'),\\n    ('Currency','USD'),('Gross amount','99.99'),('Payment status','pending'),('Paid date',None),\\n    ('Transaction reference',None),('Receipt reference','OTHER')])\\ndef test_missing_or_mismatched_merchant_is_not_zero(field, value):\\n    parsed, record, trip = setup(); setfield(merchant(parsed),field,value)\\n    result, lines = evaluate(parsed, record, trip)\\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\\n\\n\\n@pytest.mark.parametrize('field,value', [('Employee','OTHER'),('Trip reference','OTHER'),('Expense reference','OTHER'),\\n    ('Currency','USD'),('Gross amount','99.99')])\\ndef test_mismatched_receipt(field, value):\\n    parsed, record, trip = setup(); setfield(parsed['records']['receipts'][0],field,value)\\n    assert evaluate(parsed,record,trip)[1][0]['evidence_status'] == 'BLOCKED'\\n\\n\\ndef test_duplicate_merchant_does_not_double_count_but_conflict_blocks():\\n    parsed, record, trip = setup()\\n    duplicate = deepcopy(merchant(parsed)); parsed['records']['merchant_payments'] = [merchant(parsed), duplicate]\\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\\n    setfield(duplicate,'Gross amount','200.00')\\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\\n\\n\\n@pytest.mark.parametrize('rate,expected', [('0.90005',9001),('0.900049',9000),('0.90015',9002)])\\ndef test_exact_payment_date_fx_half_up(rate, expected):\\n    parsed, record, trip = setup()\\n    record['text'] = record['text'].replace('EUR','USD')\\n    setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='exact FX',\\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':rate}.items()})]\\n    result, lines = evaluate(parsed, record, trip)\\n    assert result['calculated_cents'] == expected\\n    assert lines[0]['conversion']['eur_rate'] == rate\\n    assert lines[0]['conversion']['rounding'] == 'ROUND_HALF_UP'\\n\\n\\n@pytest.mark.parametrize('missing', ['policy','tampered-policy','receipt','merchant','rate','cap','category'])\\ndef test_missing_inputs_stay_unresolved(missing):\\n    parsed, record, trip = setup()\\n    if missing == 'policy': parsed.pop('expense_policy')\\n    if missing == 'tampered-policy': parsed['expense_policy']['text'] += '\\\\n'\\n    if missing == 'receipt': parsed['records']['receipts'] = []\\n    if missing == 'merchant': parsed['records']['merchant_payments'] = []\\n    if missing == 'category': setfield(parsed['records']['receipts'][0],'Category','entertainment')\\n    if missing == 'cap':\\n        setfield(parsed['records']['receipts'][0],'Category','lodging'); parsed['records']['caps'] = []\\n    if missing == 'rate':\\n        record['text'] = record['text'].replace('EUR','USD')\\n        setfield(parsed['records']['receipts'][0],'Currency','USD'); setfield(merchant(parsed),'Currency','USD')\\n        parsed['records']['fx_rates'] = []\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['status'] == 'BLOCKED' and lines[0]['calculated_cents'] is None\\n\\n\\n@pytest.mark.parametrize('submitted,status', [('2026-10-31','PASS'),('2026-11-01','BLOCKED'),('2026-08-31','BLOCKED')])\\ndef test_inclusive_deadline_and_paid_before_submission(submitted,status):\\n    parsed, record, trip = setup(); trip['End date'] = '2026-08-31'\\n    record['text'] = record['text'].replace('2026-09-01',submitted); setfield(record,'Submitted date',submitted)\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['status'] == status\\n    if submitted > '2026-10-31': assert 'Late filing' in lines[0]['reason']\\n\\n\\ndef test_paid_pretravel_submission_is_allowed_and_import_date_is_ignored():\\n    parsed, record, trip = setup(); trip.update({'Start date':'2026-10-01','End date':'2026-10-10'})\\n    parsed['import_date'] = '2099-01-01'\\n    assert evaluate(parsed,record,trip)[0]['status'] == 'PASS'\\n\\n\\ndef test_unchanged_cost_keeps_submission_date_but_new_cost_does_not_inherit_it():\\n    parsed, record, trip = setup(); old = deepcopy(record)\\n    record['text'] = record['text'].replace('2026-09-01','2026-11-01'); setfield(record,'Submitted date','2026-11-01')\\n    trip['End date'] = '2026-08-31'\\n    history = [dict(record=old)]\\n    result, lines = evaluate(parsed,record,trip,history)\\n    assert result['status'] == 'PASS' and lines[0]['filing']['first_submission_date'] == '2026-09-01'\\n    record['text'] = record['text'].replace('COST-01','COST-NEW')\\n    for row in [parsed['records']['receipts'][0],merchant(parsed)]:\\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\\n    result, lines = evaluate(parsed,record,trip,history)\\n    assert lines[0]['filing']['first_submission_date'] == '2026-11-01'\\n    assert result['status'] == 'BLOCKED'\\n\\n\\ndef test_late_exception_requires_exact_finance_actor_revision_cost_and_covered_issue():\\n    parsed, record, trip = setup(); trip['End date'] = '2026-06-01'\\n    person = fields(table(parsed,'people','People')[0])\\n    exception = {'Authorizing Finance officer':person['Finance officer'],'Applies to claim':'C01',\\n        'Applies to revision':'1','Expense reference':'COST-01','Allowed original amount':'100.00',\\n        'Covered issues':'Late filing','Exception reason':'SYNTHETIC explicit exception'}\\n    for key,value in exception.items(): setfield(record,key,value)\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['status'] == 'PASS'\\n    assert 'Late filing' in lines[0]['filing']['original_finding']\\n    for key in ('Authorizing Finance officer','Applies to claim','Applies to revision','Expense reference','Covered issues'):\\n        changed = deepcopy(record); setfield(changed,key,'WRONG')\\n        assert evaluate(parsed,changed,trip)[0]['status'] == 'BLOCKED'\\n\\n\\ndef test_malformed_extra_line_blocks_total_without_losing_valid_line():\\n    parsed, record, trip = setup()\\n    record['text'] += '\\\\n 2 COST-BAD malformed\\\\n'\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['calculated_cents'] is None and len(lines) == 2\\n    assert lines[0]['calculated_cents'] == 10000\\n    assert lines[1]['calculated_cents'] is None\\n\\n\\ndef test_round_each_line_then_sum_and_independent_missing_evidence():\\n    parsed, record, trip = setup()\\n    first_receipt = parsed['records']['receipts'][0]\\n    first_merchant = merchant(parsed)\\n    record['text'] = record['text'].replace('EUR','USD')\\n    setfield(first_receipt,'Currency','USD'); setfield(first_merchant,'Currency','USD')\\n    second_receipt=deepcopy(first_receipt); second_merchant=deepcopy(first_merchant)\\n    for row in (second_receipt,second_merchant):\\n        setfield(row,'Expense reference','COST-NEW'); setfield(row,'Receipt reference','R-COST-NEW')\\n    setfield(second_merchant,'Transaction reference','SYNTHETIC-SECOND')\\n    parsed['records']['receipts'].append(second_receipt)\\n    parsed['records']['merchant_payments'] = [first_merchant,second_merchant]\\n    record['text'] += '\\\\n2 COST-NEW R-COST-NEW 2026-09-01 100.00 USD\\\\n'\\n    parsed['records']['fx_rates'] = [dict(source_id='synthetic-fx',source_sha256='b'*64,locator='FX half cent',\\n        values={k:dict(value=v) for k,v in {'Currency':'USD','Rate date':'2026-09-01','EUR per currency unit':'0.90005'}.items()})]\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['calculated_cents'] == 18002\\n    assert [l['calculated_cents'] for l in lines] == [9001,9001]\\n    parsed['records']['receipts'].remove(second_receipt)\\n    result, lines = evaluate(parsed,record,trip)\\n    assert result['calculated_cents'] is None and lines[0]['calculated_cents'] == 9001\\n\\n\\ndef test_correction_cannot_backdate_unchanged_cost():\\n    parsed, record, trip = setup(); old=deepcopy(record)\\n    record['text'] = record['text'].replace('2026-09-01','2026-08-01')\\n    result, lines = evaluate(parsed,record,trip,[dict(revision=1,record=old)])\\n    assert lines[0]['filing']['first_submission_date'] == '2026-09-01'\\n\\n\\n@pytest.mark.parametrize('field,value', [('Destination','WRONG'),('Currency','USD'),\\n    ('Effective from','2026-09-02'),('Effective to','2026-08-31')])\\ndef test_cap_must_match_destination_currency_and_payment_date(field,value):\\n    parsed, record, trip = setup()\\n    setfield(parsed['records']['receipts'][0],'Category','lodging')\\n    cap=dict(source_id='synthetic-cap',source_sha256='a'*64,locator='synthetic cap',values={k:dict(value=v)\\n        for k,v in {'Destination':trip['Destination'],'Category':'lodging','Currency':'EUR',\\n        'Effective from':'2026-01-01','Effective to':'2026-12-31','Amount per unit':'40.00'}.items()})\\n    setfield(cap,field,value); parsed['records']['caps']=[cap]\\n    assert evaluate(parsed,record,trip)[1][0]['calculated_cents'] is None\\n\\n\\ndef test_eur_does_not_require_or_use_a_supplied_fx_row():\\n    parsed, record, trip = setup()\\n    parsed['records']['fx_rates'] = [dict(values={'Currency':dict(value='EUR'),'Rate date':dict(value='bad'),\\n        'EUR per currency unit':dict(value='2')})]\\n    assert evaluate(parsed,record,trip)[0]['calculated_cents'] == 10000\\n\\n\\ndef test_multiple_payment_dates_are_held_without_choosing_rate_or_cap():\\n    parsed, record, trip = setup(); first=merchant(parsed); second=deepcopy(first)\\n    setfield(first,'Gross amount','50.00'); setfield(second,'Gross amount','50.00')\\n    setfield(second,'Transaction reference','SYNTHETIC-SECOND'); setfield(second,'Paid date','2026-08-31')\\n    parsed['records']['merchant_payments']=[first,second]\\n    result, lines=evaluate(parsed,record,trip)\\n    assert result['status']=='BLOCKED' and lines[0]['evidence_status']=='PASS'\\n    assert 'allocation' in lines[0]['reason']\\n\\\"\\\"\\\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport hashlib\\nimport json\\nfrom pathlib import Path\\n\\nfrom jsonschema import Draft202012Validator, FormatChecker\\nimport pytest\\n\\nfrom travel_claim.integration import integrate_arrival_batch\\nfrom travel_claim.expenses import load_expense_policy\\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\\n\\nROOT = Path(__file__).resolve().parents[1]\\n\\n\\ndef native():\\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\\n    return parsed\\n\\n\\ndef row(source, locator, **values):\\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\\n\\n\\ndef synthetic():\\n    # Every changed record is explicitly a synthetic source with its own ID.\\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\\n    parsed['event_clock'] = parsed['case_clock']\\n    records = parsed['records']\\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\\n    for r in all_rows:\\n        r['source_id'] = 'synthetic-' + r['source_id']\\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\\n    for event in records['finance_events']:\\n        event['values']['Claim revision'] = {'value': 1}\\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\\n        packet['values']['Policy revision']['value'] = 'POL-2026.2'\\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-2026.2',\\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\\n    })]\\n    decisions = '\\\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\\n    })]\\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\\n        'Case clock': parsed['case_clock'],\\n    })]\\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\\n    return parsed\\n\\n\\ndef batches(parsed):\\n    prior = None; results = []\\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\\n    for number in parsed['arrival_batches']:\\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\\n            prior_result=prior, source_observations=parsed['source_observations'])\\n        assert list(validator.iter_errors(prior['snapshot'])) == []\\n        results.append(prior)\\n    return results\\n\\n\\ndef workflow(result, claim='SYN-C01'):\\n    return result['domain']['ordinary_workflows'][claim]\\n\\n\\ndef stages(value):\\n\\\"\\\"\\\"Shared evidence checks for Finance and business-cancellation admissions.\\n\\nA calendar-date clock never implies midnight or an end-of-day instant. Events\\non that same local date need an explicit cutoff before admission.\\n\\\"\\\"\\\"\\nfrom datetime import datetime, timezone, date\\nfrom zoneinfo import ZoneInfo\\n\\n\\ndef utc_time(value):\\n    if not isinstance(value, str) or 'T' not in value:\\n        raise ValueError('missing explicit UTC event date/time')\\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\\n        raise ValueError('event timestamp is not UTC')\\n    return stamp.replace(tzinfo=timezone.utc)\\n\\n\\ndef observation_error(stamp, clock):\\n    try:\\n        if isinstance(clock, str):\\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\\n            if cutoff.utcoffset() is None:\\n                return 'case cutoff lacks timezone'\\n            return 'future observation' if stamp > cutoff else None\\n        if isinstance(clock, dict):\\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\\n            case_date = date.fromisoformat(clock['date'])\\n            if local > case_date:\\n                return 'future observation'\\n            if local == case_date:\\n                return 'same-day cutoff is unknown; no time of day inferred'\\n            return None\\n    except (KeyError, TypeError, ValueError):\\n        return 'invalid authoritative event cutoff'\\n    return 'authoritative event cutoff is unavailable'\\n\\n\\ndef text_id(value):\\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13f30-dcaa-7053-8391-0211a28144b2","create_time":1792061540.4887667}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
