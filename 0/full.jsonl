ef_text(revision[\"source_ref\"])})\n   401\t        if dispositions:\n   402\t            disposition_refs = [d[\"source_ref\"] for d in dispositions]\n   403\t            changes = {\n   404\t                \"source_refs\": list(dict.fromkeys(queue[\"items\"][task_id][\"source_refs\"] + disposition_refs)),\n   405\t                \"missing_or_return_reason\": \"Cancellation-bound Finance disposition recorded; current eligibility, request authorization and financial completion remain unverified\",\n   406\t                \"next_action\": \"Revalidate the cancellation-bound Finance disposition against current approvals, request revision and confirmed net cash; obtain completion authority\"}\n   407\t            changes = {k: v for k, v in changes.items() if queue[\"items\"][task_id][k] != v}\n   408\t            if changes:\n   409\t                update_repair_item(queue, item_id=task_id,\n   410\t                    update_id=f\"cancellation-disposition:{cancellation_id}:{batch_id}\", run_id=run_id, batch_id=batch_id, **changes)\n   411\t        trips = [r for r in parsed.get(\"records\", {}).get(\"trips\", [])\n   412\t                 if row_values(r).get(\"Trip reference\") == trip_id\n   413\t                 and _as_batch(row_values(r).get(\"Trip revision\")) == trip_revision]\n   414\t        employee = row_values(trips[0]).get(\"Employee ID\") if len(trips) == 1 else None\n   415\t        people = [r for r in table(parsed, \"people\", \"People\") if fields(r).get(\"Employee ID\") == employee]\n   416\t        supervisor = fields(people[0]).get(\"Supervisor\") if len(people) == 1 else None\n   417\t        actors_ok = bool(employee and supervisor\n   418\t            and request_values.get(\"Acting employee or supervisor\") == employee\n   419\t            and confirmation_values.get(\"Acting employee or supervisor\") == supervisor)\n   420\t        actor_refs = [_ref_text(_ref(r)) for r in trips + people]\n   421\t        if not actors_ok:\n   422\t    