{"timestamp":"2026-10-15T10:52:19.254Z","ordinal":4297,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13f30-dcaa-7053-8391-0211a28144b2","item":{"type":"CommandExecution","id":"exec-500b031a-4f8a-459d-b819-d7348c1cd8f2","process_id":"32268","command":["/bin/bash","-lc","git status --short; git rev-parse HEAD; cat src/travel_claim/expenses.py; cat src/travel_claim/approvals.py"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"git status --short; git rev-parse HEAD; cat src/travel_claim/expenses.py; cat src/travel_claim/approvals.py"}],"source":"unified_exec_startup","status":"completed","stdout":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n791c8c787bbd617a7b7d3114f13c000249169151\n\"\"\"POL-2026.2 expense arithmetic and local-calendar filing checks.\n\nThe policy is explicitly bound by its original bytes; this does not convert the\nuser's browser copy into a successful native Notion capture or grant approval.\n\"\"\"\nfrom copy import deepcopy\nfrom calendar import monthrange\nfrom datetime import date\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP, localcontext\nimport hashlib\nfrom pathlib import Path\n\nfrom .exceptions import validate_exception, apply_coverage, finding\n\nPOLICY_SHA256 = 'f547ee77729be8ad431a5ddf2e2907f94f29ad50092231191abd2f72c04f54d2'\n\n\ndef load_expense_policy(path):\n    raw = Path(path).read_bytes()\n    if hashlib.sha256(raw).hexdigest() != POLICY_SHA256:\n        raise ValueError('POL-2026.2 browser copy hash mismatch')\n    return dict(text=raw.decode('utf-8'), sha256=POLICY_SHA256, path=str(path),\n                provenance='user-provided browser-visible copy; not native HTTP/API retrieval')\n\n\ndef policy_valid(binding):\n    return (isinstance(binding, dict) and isinstance(binding.get('text'), str)\n            and hashlib.sha256(binding['text'].encode('utf-8')).hexdigest() == POLICY_SHA256\n            and binding.get('sha256') == POLICY_SHA256)\n\n\ndef local_date(value):\n    \"\"\"Accept native local dates and Excel's naive midnight date serialization.\"\"\"\n    text = str(value)\n    if len(text) == 19 and text.endswith('T00:00:00'):\n        text = text[:10]\n    result = date.fromisoformat(text)\n    if result.isoformat() != text:\n        raise ValueError('Not a local calendar date')\n    return result\n\n\ndef filing_deadline(trip_end):\n    end = local_date(trip_end)\n    month = end.year * 12 + end.month - 1 + 2\n    year, zero_month = divmod(month, 12)\n    return date(year, zero_month + 1, min(end.day, monthrange(year, zero_month + 1)[1]))\n\n\ndef number(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError('Missing or invalid number')\n    result = Decimal(str(value).replace(',', ''))\n    if not result.is_finite() or result < 0:\n        raise ValueError('Invalid amount')\n    return result\n\n\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\n    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    binding = parsed.get('expense_policy')\n    verified = policy_valid(binding)\n    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    receipts = parsed.get('records', {}).get('receipts', [])\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    rates = table(parsed, 'fx_rates', 'FX')\n    caps = table(parsed, 'caps', 'Caps')\n    observations = parsed.get('source_observations', []) if observations is None else observations\n    people = table(parsed, 'people', 'People')\n    for line in lines:\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\n        line['eligibility_status'] = 'BLOCKED'\n        exception = validate_exception(record=record, line=line, employee=employee, people=people,\n            observations=observations, fields=fields, ref=ref)\n        # An exception for another *present* cost has no effect on this line.\n        target = fields(record).get('Expense reference')\n        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\n            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\n                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\n                            for f in line['eligibility_findings'])):\n            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\n        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\n        line['exception'] = exception\n        line['source_refs'] += exception['source_refs']\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n        try:\n            gross = number(line['original_amount'])\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\n                raise ValueError('Missing receipt or nonpositive purchase')\n            rv = fields(rs[0])\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\n                    and line['currency'].isalpha() and line['currency'].isupper()):\n                raise ValueError('Receipt identity, currency or gross mismatch')\n            unique = {}\n            for row in ms:\n                mv = fields(row); identity = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            line['base_allowed_original_amount'] = str(allowed)\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                original = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = original\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n            if exception['status'] == 'valid':\n                replacement = Decimal(exception['replacement_original_amount'])\n                if category == 'personal' and replacement != 0:\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n                allowed = replacement\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n            apply_coverage(line['eligibility_findings'], exception)\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            line['filing_status'] = 'BLOCKED' if any(\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n                                                    for f in line['eligibility_findings']):\n                line['filing']['exception'] = deepcopy(exception)\n            if exception['status'] == 'BLOCKED':\n                raise ValueError(exception['reason'])\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n            line.update(eligibility_status='PASS', status='supported',\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n                        else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n\"\"\"POL-2026.2 review authority and business transitions, without financial closure.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, InvalidOperation\nimport hashlib\nimport json\nimport re\nfrom zoneinfo import ZoneInfo\n\nfrom .exceptions import source_bound\nfrom .expenses import policy_valid, local_date\nfrom .workflow import _revision, row_values\n\nROLES = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner',\n         'supervisor': 'Supervisor', 'director': 'Director'}\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef table(parsed, key, name):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == name), []))\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('Missing decision UTC time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native workbook column explicitly specifies UTC.\n    return stamp.replace(tzinfo=timezone.utc) if stamp.tzinfo is None else stamp.astimezone(timezone.utc)\n\n\ndef versions(row):\n    return set(re.findall(r'\\b(?:SRC-D-\\d+|POL-\\d{4}\\.\\d+)\\b', row.get('text', '')))\n\n\ndef evidence_digest(rows, amount):\n    \"\"\"Compare material facts, retaining source versions but ignoring arrival metadata.\"\"\"\n    content=[]\n    for row in rows:\n        value=fields(row)\n        content.append(dict(source_id=row.get('source_id'), sha256=row.get('source_sha256'),\n                            values={k:v for k,v in value.items() if k not in {'Arrival batch', 'Status', 'Claim reason'}}))\n    return hashlib.sha256(json.dumps(dict(rows=content, amount=amount), sort_keys=True, default=str).encode()).hexdigest()\n\n\ndef evaluate_reviews(*, parsed, kind, subject_id, revision, trip_record, employee,\n                     subject_record, amount_cents, decisions, arrival_batch, observations,\n                     cost_ids=(), prior=None, dependency_rows=(), withdrawn=False, cancellation_ids=(), budget_context=None):\n    \"\"\"Evaluate supplied replies only. Invalid/stale imports stay in deliveries.\"\"\"\n    trip=fields(trip_record); policy=policy_valid(parsed.get('expense_policy'))\n    people=[r for r in table(parsed,'people','People') if fields(r).get('Employee ID')==employee]\n    person=fields(people[0]) if len(people)==1 else {}\n    packets=table(parsed,'review_packets','Review packets')\n    required=['administration','budget_owner','supervisor']\n    amount_known=isinstance(amount_cents,int) and not isinstance(amount_cents,bool) and amount_cents>=0\n    if amount_known and amount_cents>100000: required.append('director')\n    basis_rows=[subject_record,trip_record]+people+list(dependency_rows)\n    digest=evidence_digest(basis_rows,dict(amount_cents=amount_cents,cost_ids=sorted(cost_ids) if kind=='claim' else [],cancellation_ids=sorted(cancellation_ids)))\n    material_same_revision=bool(prior and prior.get('revision')==revision and\n        (prior.get('evidence_digest')!=digest or prior.get('material_same_revision')))\n    invalidated_batch=(prior.get('invalidated_batch') if prior and prior.get('material_same_revision') and prior.get('revision')==revision else arrival_batch) if material_same_revision else None\n    deliveries=[]; identities={}; conflicts=set()\n    budget_ids={fields(r).get('Ledger reference') for r in table(parsed,'budget','Budget')}\n    for decision in decisions:\n        dv=fields(decision); identity=dv.get('Decision reference')\n        ps=[p for p in packets if fields(p).get('Decision reference')==identity]\n        relevant=(dv.get('Subject reference')==subject_id or any(fields(p).get('Trip reference')==trip.get('Trip reference')\n                  and fields(p).get('Employee ID')==employee for p in ps))\n        if not relevant: continue\n        item=dict(decision_id=identity, outcome=dv.get('Outcome'), roles=str(dv.get('Review roles') or '').splitlines(),\n                  reason=dv.get('Reason'), repair_requested=dv.get('Repair requested'), evidence_valid=False,\n                  active=False, import_status='rejected-import', source_refs=[ref(decision)]+[ref(p) for p in ps],\n                  raw_record=deepcopy(decision), rejection_reasons=[])\n        deliveries.append(item)\n        try:\n            batch=_revision(dv.get('Arrival batch'))\n            if batch is None or batch>arrival_batch: raise ValueError('Reply outside consumed arrival batches')\n            if not subject_id or _revision(revision) is None or not source_bound(subject_record,observations) or not source_bound(trip_record,observations):\n                raise ValueError('Missing verified subject/trip identity or revision')\n            if dv.get('Subject type')!=kind or dv.get('Subject reference')!=subject_id or _revision(dv.get('Revision'))!=revision:\n                raise ValueError('Wrong or stale subject type/ID/revision')\n            if not identity or not source_bound(decision,observations): raise ValueError('Missing decision identity/source binding')\n            if len(people)!=1 or not source_bound(people[0],observations): raise ValueError('Missing verified directory authority')\n            roles=item['roles']\n            if not roles or len(set(roles))!=len(roles) or not set(roles)<=set(ROLES): raise ValueError('Unknown or repeated role')\n            if len(roles)>1 and not (set(roles)=={'budget_owner','supervisor'} and person.get('Budget owner')==person.get('Supervisor')):\n                raise ValueError('Only directory-identical budget owner/supervisor may combine explicit roles')\n            if any(not person.get(ROLES[r]) or dv.get('Reviewer')!=person[ROLES[r]] or dv.get('Reviewer')==employee for r in roles):\n                raise ValueError('Wrong-role, self-review or unauthorized stable actor')\n            if not isinstance(dv.get('Reason'),str) or not dv['Reason'].strip(): raise ValueError('Missing review reason')\n            if item['outcome'] not in {'approve','return','reject'}: raise ValueError('Unknown decision outcome')\n            if item['outcome']=='return' and (not isinstance(dv.get('Repair requested'),str) or not dv['Repair requested'].strip()):\n                raise ValueError('Return requires a concrete repair request')\n            if len(ps)!=1 or not source_bound(ps[0],observations): raise ValueError('Missing, conflicting or unbound review packet')\n            pv=fields(ps[0]); supplied=str(dv.get('Source revisions') or '').splitlines()\n            policy_versions={v for v in supplied if v.startswith('POL-')}\n            if not supplied or pv.get('Policy revision')!='POL-2026.2' or policy_versions!={'POL-2026.2'}:\n                raise ValueError('Missing/stale policy source version')\n            exact=ref(subject_record) in supplied or subject_record.get('source_sha256') in supplied\n            printed=versions(subject_record)\n            declared={v for v in supplied if v.startswith('SRC-D-')}\n            if printed and declared-printed:\n                raise ValueError('Reply contains a stale printed source version')\n            if material_same_revision and batch<invalidated_batch:\n                raise ValueError('Reply predates material evidence revalidation')\n            if not exact and (material_same_revision or not printed.intersection(supplied)):\n                raise ValueError('Reply does not bind current subject source version')\n            if (pv.get('Employee ID')!=employee or pv.get('Trip reference')!=trip.get('Trip reference')\n                    or _revision(pv.get('Trip revision'))!=_revision(trip.get('Trip revision'))\n                    or any(pv.get(k)!=trip.get(k) for k in ('Business purpose','Client','Schedule coverage','Alternatives considered','Permit reference','Permit revision'))):\n                raise ValueError('Packet does not match current trip/permit evidence')\n            if kind=='claim' and set(str(pv.get('Expense references') or '').splitlines())!=set(cost_ids):\n                raise ValueError('Packet expense list does not match review subject')\n            if kind=='permit':\n                from .finance import _cents\n                if not amount_known or _cents(pv.get('Reviewed estimate (EUR)'))!=amount_cents:\n                    raise ValueError('Missing/mismatched reviewed permit estimate')\n            if not set(cancellation_ids)<=set(str(pv.get('Travel cancellation references') or '').splitlines()):\n                raise ValueError('Packet lacks current cancellation context')\n            budget_refs=set(str(pv.get('Budget record references') or '').splitlines())\n            if not budget_refs or not budget_refs<=budget_ids: raise ValueError('Missing referenced budget records; no budget decision inferred')\n            stamp=utc_time(dv.get('Decision time (UTC)'))\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in identities and identities[identity][0]!=payload:\n                conflicts.add(identity)\n            elif identity not in identities: identities[identity]=(payload,item)\n            else:\n                item.update(import_status='exact-replay',replayed_decision_id=identity)\n                continue\n            from .budget import budget_reply_error\n            budget_error=budget_reply_error(budget_context,decision,ps[0]) if 'budget_owner' in roles else None\n            item['budget_evidence_valid']=not budget_error\n            item['budget_revalidation_reason']=budget_error\n            item.update(evidence_valid=True,import_status='valid',order=stamp.isoformat(),decision_time=stamp.isoformat())\n        except (ValueError,TypeError,InvalidOperation) as exc:\n            item['rejection_reasons'].append(str(exc))\n    # Conflicting redelivery must hold an identity even when its later payload fails validation.\n    all_payloads={}\n    for item in deliveries:\n        dv=fields(item['raw_record']); identity=item['decision_id']\n        if (identity and dv.get('Subject reference')==subject_id and _revision(dv.get('Revision'))==revision\n                and _revision(dv.get('Arrival batch')) is not None and _revision(dv.get('Arrival batch'))<=arrival_batch):\n            payload={k:v for k,v in dv.items() if k!='Arrival batch'}\n            if identity in all_payloads and all_payloads[identity]!=payload: conflicts.add(identity)\n            all_payloads[identity]=payload\n    for item in deliveries:\n        if item['decision_id'] in conflicts:\n            item.update(evidence_valid=False,import_status='conflicting-replay')\n            item['rejection_reasons'].append('Immutable decision identity has conflicting deliveries')\n    role_states={}; selected=[]\n    for role in required:\n        candidates=[d for d in deliveries if d['evidence_valid'] and role in d['roles'] and (role!='budget_owner' or d.get('budget_evidence_valid',True))]\n        if not candidates: role_states[role]='missing'; continue\n        latest=max(d['order'] for d in candidates)\n        matches=[d for d in candidates if d['order']==latest]\n        if len(matches)!=1:\n            role_states[role]='conflicting';continue\n        chosen=matches[0];chosen['active']=True;role_states[role]=chosen['outcome']\n        if chosen not in selected: selected.append(chosen)\n    withdrawal_valid=bool(withdrawn and source_bound(subject_record,observations) and source_bound(trip_record,observations)\n        and trip.get('Employee ID')==employee and len(people)==1 and source_bound(people[0],observations)\n        and isinstance(fields(subject_record).get('Claim reason'),str) and fields(subject_record)['Claim reason'].strip())\n    states=set(role_states.values())\n    state=('withdrawn' if withdrawal_valid else 'rejected' if 'reject' in states else 'returned' if 'return' in states\n 