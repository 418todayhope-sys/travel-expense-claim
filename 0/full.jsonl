rio-case-clock\"] == \"BLOCKED\"\n    assert checks[\"external-blocker:reimbursement-policy-pol-2026-2\"] == \"BLOCKED\"\n    assert checks[\"unresolved-repairs\"] == \"BLOCKED\"\n    assert checks[\"repair-evidence-availability\"] == \"BLOCKED\"\n    assert checks[\"repair-queue-traceability\"] == \"PASS\"\n\n\n@pytest.mark.parametrize(\"missing\", [\"report.md\", \"claims.csv\", \"sources.json\", \"offline-replay-state.json\", \"batches/arrival-002.json\"])\ndef test_incomplete_package_fails_with_evidence_and_next_action(tmp_path, missing):\n    run = _run(tmp_path)\n\"\"\"Synthetic CLI coverage for the explicitly labelled retained-input replay.\"\"\"\n\nimport hashlib\nimport io\nimport json\nimport zipfile\nimport csv\nfrom pathlib import Path\n\nfrom travel_claim.cli import main\nfrom travel_claim.outputs import CLAIMS_COLUMNS\nfrom travel_claim.snapshots import verify_snapshot\nfrom source_fixtures import pdf_bytes, xlsx_bytes\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\nROOT = Path(__file__).resolve().parents[1]\nSCHEMA = ROOT / \"snapshot.schema.json\"\n\n\ndef _xlsx_bytes():\n    return xlsx_bytes()\n\ndef _capture(tmp_path):\n    run_id = \"offline-synthetic\"\n    run_dir = tmp_path / run_id\n    bodies = {\n        \"policy-pol-2026-2\": b\"generic policy shell\",\n        \"initial-claim-binder\": pdf_bytes(),\n        \"claim-updates-binder\": pdf_bytes(),\n        \"receipt-binder\": pdf_bytes(),\n        \"travel-registers-workbook\": _xlsx_bytes(),\n    }\n    attempts = []\n\n    def fetch(url, timeout):\n        attempts.append(url)\n        source = next(row for row in SOURCES if (row.export_url or row.url) == url)\n        return bodies[source.source_id], {\"ETag\": \"synthetic-fixture\"}, url\n\n    manifest = capture_sources(\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\n        observed_at=iter([f\"2026-09-01T00:00:{i:02d}Z\" for i in range(10)]).__next__,\n    )\n    manifest_hash = hashlib.sha256((run_di