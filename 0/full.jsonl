{"timestamp":"2026-10-14T20:08:30.453Z","ordinal":846,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13c07-abde-7561-8a83-1bb986e74dae","item":{"type":"CommandExecution","id":"exec-3e271774-2db3-4a27-a6fb-66cee5fe379f","process_id":"46818","command":["/bin/bash","-lc","cat src/travel_claim/integration.py; cat src/travel_claim/finance.py; cat src/travel_claim/parsing.py; cat snapshot.schema.json"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"read","cmd":"cat src/travel_claim/integration.py","name":"integration.py","path":"src/travel_claim/integration.py"},{"type":"read","cmd":"cat src/travel_claim/finance.py","name":"finance.py","path":"src/travel_claim/finance.py"},{"type":"read","cmd":"cat src/travel_claim/parsing.py","name":"parsing.py","path":"src/travel_claim/parsing.py"},{"type":"read","cmd":"cat snapshot.schema.json","name":"snapshot.schema.json","path":"snapshot.schema.json"}],"source":"unified_exec_startup","status":"completed","stdout":"\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            if item_id in queue[\"items\"]:\n                item = queue[\"items\"][item_id]\n                changes = {key: value for key, value in {\n                    \"source_refs\": refs,\n                    \"missing_or_return_reason\": issue[\"missing_or_return_reason\"],\n                    \"next_action\": issue[\"next_action\"],\n                }.items() if item[key] != value}\n                if changes:\n                    update_repair_item(queue, item_id=item_id,\n                                       update_id=f\"finance-evidence:{item_id}:{batch_id}\",\n                                       run_id=run_id, batch_id=batch_id, **changes)\n                continue\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n    previous_revisions: dict[str, int],\n) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, claim in _subject_claim_revisions(history).items():\n        revision = claim[\"current_revision\"]\n        old_revision = previous_revisions.get(claim_id)\n        if old_revision is None or revision <= old_revision:\n            continue\n        current = next(row for row in reversed(claim[\"revisions\"]) if row[\"revision\"] == revision)\n        prior = [row for row in claim[\"revisions\"] if row[\"revision\"] == old_revision]\n        refs = [_ref_text(row[\"source_ref\"]) for row in prior + [current]]\n        old_decisions = [\n            decision for decision in domain[\"decision_history\"]\n            if decision.get(\"subject_type\") == \"claim\" and decision.get(\"subject_id\") == claim_id\n            and decision.get(\"revision\") == old_revision\n        ]\n        refs.extend(_ref_text(row[\"decision_source_ref\"]) for row in old_decisions)\n        affected_finance = [row for row in domain[\"finance_records\"] if row_values(row).get(\"Claim reference\") == claim_id]\n        refs.extend(_ref_text(_ref(row)) for row in affected_finance)\n        refs = list(dict.fromkeys(refs))\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"])\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {\n        row_values(record).get(\"Cancellation activity reference\"): record\n        for record in domain[\"cancellation_records\"]\n    }\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    break\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if process[\"state\"] == \"confirmed\" and item[\"next_action\"] != next_action:\n                changes[\"next_action\"] = next_action\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"original_request_ids\": [],\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> None:\n    queue = domain[\"repair_queue\"]\n    blockers = []\n    for conflict in history.get(\"issues\", {}).get(\"repeated_subject_revisions\", []):\n        kind = conflict[\"kind\"]\n        subject_id = conflict[\"subject_id\"]\n        revision = conflict[\"revision\"]\n        refs = [_ref_text(ref) for ref in conflict.get(\"occurrences\", [])]\n        item_id = f\"revision-conflict:{kind}:{subject_id}:r{revision}\"\n        _open_issue_for_subject(\n            queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n            revision=revision, refs=refs,\n            reason=f\"multiple retained source records use {kind} {subject_id} revision {revision}; their business content requires review\",\n            owner=\"Travel Administration Lead\", next_action=\"compare the source occurrences and establish the supported revision record\",\n            run_id=run_id, batch_id=batch_id,\n        )\n    for malformed in history.get(\"issues\", {}).get(\"malformed_revision_records\", []):\n        blockers.append({\n            \"record_id\": f\"malformed-revision:{_digest(malformed)[:16]}\",\n            \"reason\": malformed[\"reason\"],\n            \"owner\": \"Travel Administration Lead\",\n            \"resolution_needed\": \"identify the subject and revision from the native source record\",\n            \"source_ref\": malformed.get(\"source_ref\"),\n        })\n    for decision in domain[\"decision_history\"]:\n        if decision[\"structural_match\"] in {\"revision_match_current\", \"revision_match_historical\"}:\n            continue\n        kind, subject_id, revision = decision.get(\"subject_type\"), decision.get(\"subject_id\"), decision.get(\"revision\")\n        decision_id = decision.get(\"decision_id\") or _digest(decision)[:16]\n        if kind in {\"claim\", \"trip\", \"permit\"} and isinstance(subject_id, str) and isinstance(revision, int) and revision > 0:\n            item_id = f\"decision-match:{decision_id}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n                revision=revision, refs=[_ref_text(decision[\"decision_source_ref\"])],\n                reason=f\"recorded decision {decision_id} does not structurally match an available {kind} revision ({decision['structural_match']})\",\n                owner=\"Travel Administration Lead\", next_action=\"resolve the decision subject or revision against the native review ledger\",\n                run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            blockers.append({\n                \"record_id\": f\"decision-match:{decision_id}\",\n                \"reason\": f\"recorded decision has no traceable supported subject/revision ({decision['structural_match']})\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"identify its subject and revision in the native review ledger\",\n                \"source_ref\": decision[\"decision_source_ref\"],\n            })\n    domain[\"structural_blockers\"] = blockers\n\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n    expected_batch = processed[-1] + 1 if processed else 1\n    if arrival_batch != expected_batch:\n        raise ValueError(f\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\")\n    if prior_result is None and predecessor is not None:\n        raise ValueError(\"the first integrated batch must have a null predecessor\")\n    if prior_result is not None:\n        if prior_result.get(\"snapshot\", {}).get(\"run_id\") != run_id:\n            raise ValueError(\"prior integration state belongs to a different run\")\n        if predecessor is None:\n            raise ValueError(\"a later integrated batch must carry a predecessor binding\")\n\n    domain = previous_domain\n    if authorized_obligations:\n        domain[\"authorized_obligations\"].update(deepcopy(authorized_obligations))\n    if source_classifications:\n        domain[\"source_classifications\"].update(deepcopy(source_classifications))\n    previous_claim_revisions = {\n        subject_id: value[\"current_revision\"]\n        for subject_id, value in (domain.get(\"revision_history\") or {}).get(\"claim\", {}).items()\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n        )\n    domain[\"finance_reconciliations\"] = finance_results\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n    # deliberately remain outside any fabricated claim/decision outcome.\n    blockers = []\n    for row in parsed.get(\"unresolved_issues\", []):\n        blocker = {\n            \"record_id\": row[\"record_id\"],\n            \"reason\": row.get(\"reason\", \"Unresolved source issue\"),\n            \"owner\": row.get(\"owner\", \"Exercise facilitator\"),\n            \"resolution_needed\": row.get(\"next_action\", \"Obtain the missing authoritative evidence\"),\n            \"subject_type\": row.get(\"subject_type\"),\n            \"subject_id\": row.get(\"subject_id\"),\n            \"affected_scope\": row.get(\"affected_scope\"),\n            \"evidence_needed\": row.get(\"evidence_needed\"),\n        }\n        blockers.append(blocker)\n    domain[\"policy_clock_blockers\"] = blockers\n\n    cancellation_rows = _cancellation_rows(domain, history=history, run_id=run_id, batch_id=batch_id)\n    schema_issues = list(blockers) + list(domain.get(\"structural_blockers\", []))\n    schema_issues.extend(_issue_from_item(item) for item in domain[\"repair_queue\"][\"items\"].values() if item[\"status\"] == \"open\")\n    # Every cancellation issue reference must resolve in issues[].record_id.\n    known_issue_ids = {issue[\"record_id\"] for issue in schema_issues}\n    for cancellation in cancellation_rows:\n        cancellation[\"issue_record_ids\"] = [\n            issue_id for issue_id in cancellation[\"issue_record_ids\"] if issue_id in known_issue_ids\n        ]\n\n    snapshot_claims = []\n    projection_issues = []\n    for claim_id, revision_row in sorted(current_claims.items()):\n        revision = revision_row[\"revision\"]\n        record = revision_row[\"record\"]\n        values = _page_values(record)\n        trip_id = revision_row.get(\"trip_id\")\n        trip_revision = revision_row.get(\"trip_revision\")\n        if not trip_id or not trip_revision:\n            projection_issues.append({\n                \"record_id\": f\"snapshot-claim-link:{claim_id}:r{revision}\",\n                \"reason\": \"claim source lacks the trip identity or revision required by snapshot.schema.json; claim omitted from snapshot projection\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"obtain and verify the current claim-to-trip revision binding\",\n            })\n            continue\n        trip_record_set = history.get(\"trip\", {}).get(str(trip_id), {})\n        linked_trip = any(row[\"revision\"] == trip_revision for row in trip_record_set.get(\"revisions\", []))\n        if not linked_trip:\n            item_id = f\"trip-link:{claim_id}:r{revision}\"\n            _open_issue_for_subject(\n                domain[\"repair_queue\"], item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=[_ref_text(revision_row[\"source_ref\"])],\n                reason=f\"claim references trip {trip_id} revision {trip_revision}, which is not present in the retained trip register\",\n                owner=\"Travel Administration Lead\", next_action=\"verify the trip revision from an accessible native travel register\",\n                run_id=run_id, batch_id=batch_id,\n            )\n            schema_issues.append(_issue_from_item(domain[\"repair_queue\"][\"items\"][item_id]))\n        matches = [row for row in domain[\"decision_history\"]\n                   if row.get(\"subject_type\") == \"claim\" and row.get(\"subject_id\") == claim_id\n                   and row.get(\"revision\") == revision and row.get(\"structural_match\") == \"revision_match_current\"]\n        finance = finance_results[claim_id]\n        snapshot_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": revision,\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"status\": \"pending\",\n            \"lines\": [],\n            \"allowed_cents\": None,\n            \"finance_evidence\": {\n                \"recorded_obligation\": deepcopy(finance[\"recorded_obligation\"]),\n                \"recorded_ledger_balance_cents\": finance[\"recorded_ledger_balance_cents\"],\n                \"basis\": \"Recorded request ledger only; not reviewed entitlement or current-revision authorization\",\n                \"current_revision_authority_confirmed\": False,\n                \"closure_authority_confirmed\": False,\n            },\n            \"paid_cents\": finance[\"net_confirmed_cents\"],\n            \"balance_cents\": finance[\"balance_cents\"],\n            \"decision_ids\": list(dict.fromkeys(row[\"decision_id\"] for row in matches if row.get(\"decision_id\"))),\n            \"next_owner\": \"Travel Administration Lead\",\n            \"reason\": \"Structural integration only; reimbursement policy and current-revision compliance remain unresolved.\",\n        })\n\n    schema_issues.extend(projection_issues)\n    schema_issues.extend(domain.get(\"projection_issues\", []))\n    # Deduplicate by record_id while preserving issue order.\n    unique_issues = {}\n    for issue in schema_issues:\n        unique_issues.setdefault(issue[\"record_id\"], issue)\n    schema_issues = list(unique_issues.values())\n\n    finance_ids = []\n    unresolved_ids = set()\n    conflicting_ids = set()\n    for result in finance_results.values():\n        unresolved_ids.update(result[\"unresolved_event_ids\"])\n        conflicting_ids.update(issue[\"event_id\"] for issue in result[\"conflicting_events\"])\n        for event in result[\"event_history\"]:\n            event_id = event[\"event_id\"]\n            if (event_id and event_id not in unresolved_ids and event_id not in conflicting_ids\n                    and event[\"classification\"] not in {\"unresolved\", \"conflicting_event_id\", \"missing_event_id\"}):\n                finance_ids.append(event_id)\n    finance_ids = list(dict.fromkeys(event_id for event_id in finance_ids if event_id not in unresolved_ids | conflicting_ids))\n\n    snapshot = {\n        \"schema_version\": \"travel-claim-snapshot/2\",\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"predecessor\": deepcopy(predecessor),\n        \"source_binding\": deepcopy(source_binding),\n        \"claims\": snapshot_claims,\n        \"requests\": [],\n        \"travel_cancellations\": cancellation_rows,\n        \"admitted_event_ids\": finance_ids,\n        \"issues\": schema_issues,\n    }\n    domain[\"processed_batches\"] = list(domain[\"processed_batches\"])\n    return {\n        \"snapshot\": snapshot,\n        \"domain\": domain,\n        \"decision_history\": deepcopy(domain[\"decision_history\"]),\n        \"finance_reconciliations\": deepcopy(finance_results),\n        \"revision_history\": deepcopy(history),\n        \"repair_queue_by_owner\": _owner_view(domain[\"repair_queue\"]),\n        \"batch_delta_counts\": {key: len(value) for key, value in delta.items()},\n        \"input_sha256\": digest,\n    }\n\n\ndef _owner_view(queue: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:\n    grouped: dict[str, list[dict[str, Any]]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom datetime import datetime\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef _reference_text(ref: dict[str, Any]) -> str:\n    return f\"{ref.get('source_id')}@{ref.get('source_sha256')}#{ref.get('locator')}\"\n\n\ndef _positive_integer(value: Any) -> int | None:\n    try:\n        return int(value) if not isinstance(value, bool) and int(value) > 0 and float(value) == int(value) else None\n    except (ValueError, TypeError, OverflowError):\n        return None\n\n\ndef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    claim revision; arrival context is retained separately from explicit links.\n    Only the first delivery establishes context; redelivery cannot rebind it.\n    \"\"\"\n    groups: dict[str, list[dict]] = defaultdict(list)\n    for event in history:\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n            groups[event['event_id']].append(event)\n    records = []\n    problem = None\n    for event_id, occurrences in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\n    duplicate_events = []\n    conflicting_events = []\n    for event_id, occurrences in by_id.items():\n        relevant = [record for record in occurrences if _values(record).get(\"Claim reference\") == claim_id]\n        if not relevant:\n            continue\n        payloads = [_payload(_values(record)) for record in occurrences]\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\n        for record in relevant:\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\n        if conflict:\n            conflicting_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"payloads\": payloads,\n            })\n        elif len(occurrences) > 1:\n            duplicate_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"delivery_batches\": [_values(record).get(\"Arrival batch\") for record in occurrences],\n            })\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\n    relevant_occurrences.sort(key=lambda row: (\n        _positive_integer(row[2].get(\"Arrival batch\")) or 0,\n        int(row[1].get(\"row\") or 0),\n        row[0] or \"\",\n    ))\n\n    history = []\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\n    typed = []\n    unresolved = []\n    for event_id, record, values, conflict in relevant_occurrences:\n        event_type = values.get(\"Activity type\")\n        classification = classes.get(event_type, \"unresolved\")\n        item = {\n            \"event_id\": event_id,\n            \"source_ref\": _source_ref(record),\n            \"source_record\": deepcopy(values),\n            \"event_type\": event_type,\n            \"classification\": (\n                \"conflicting_event_id\" if conflict and event_id else\n                \"missing_event_id\" if conflict else classification\n            ),\n            \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n            \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n            \"currency\": values.get(\"Currency\"),\n            \"original_activity_id\": values.get(\"Original activity reference\"),\n        }\n        history.append(item)\n        if conflict:\n            if event_id:\n                event_issue_by_id[event_id] = {\n                    \"record_id\": f\"finance-event-conflict:{event_id}\",\n                    \"event_id\": event_id,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"same Finance event ID has conflicting source content; none of its occurrences were counted\",\n                    \"source_refs\": [_source_ref(row) for row in by_id[event_id]],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to resolve the source record conflict\",\n                }\n            else:\n                event_issue_by_id[f\"missing:{record.get('locator')}\"] = {\n                    \"record_id\": f\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\",\n                    \"event_id\": None,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"Finance event has no activity reference and cannot be safely deduplicated or counted\",\n                    \"source_refs\": [_source_ref(record)],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n                }\n            continue\n        if classification == \"unresolved\":\n            unresolved.append(item)\n            continue\n        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n                unresolved.append(item)\n                continue\n        typed.append(item)\n\n    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n    confirmed_refunds: list[dict[str, Any]] = []\n    refund_candidates = list({item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_refund\"}.values())\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for item in refund_candidates:\n        original_id = item[\"original_activity_id\"]\n        original = payments.get(original_id) if isinstance(original_id, str) else None\n        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n            unresolved.append(item)\n            continue\n        refund_groups[original_id].append(item)\n    for original_id, refunds in refund_groups.items():\n        original = payments[original_id]\n        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n        if refund_total > original[\"amount_cents\"]:\n            unresolved.extend(refunds)\n            continue\n        confirmed_refunds.extend(refunds)\n\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n    )\n    if recorded_problem:\n        issues.append({\n            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n        })\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"missing_or_return_reason\": (\"recorded Finance obligation exists, but current-revision reimbursement authorization and entitlement remain unconfirmed\"\n                                         if recorded_obligation else \"no supported authorized obligation was supplied for this claim revision\"),\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    ledger_balance = None\n    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n        # Cash for a different/missing request cannot be silently applied to this ledger.\n        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n    if recorded_obligation is not None and event_set_complete and ledger_balance is None:\n        issues.append({\n            \"record_id\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n            \"owner\": owner,\n            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n        })\n    issues_by_owner = {}\n    for issue in issues:\n        issues_by_owner.setdefault(issue['owner'], []).append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row['record_id']) for key, value in sorted(issues_by_owner.items())}\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n                \"prior_recorded_obligation\": deepcopy(previous_reconciliation.get(\"recorded_obligation\")),\n                \"next_action\": \"Revalidate exact revision authorization; historical ledger and cash remain retained\",\n            }\n    revalidation_history = deepcopy((previous_reconciliation or {}).get(\"financial_revalidation_history\", []))\n    if invalidated is not None:\n        revalidation_history.append(deepcopy(invalidated))\n    return {\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"recorded_obligation_history\": obligation_history,\n        \"recorded_obligation\": recorded_obligation,\n        \"recorded_ledger_balance_cents\": ledger_balance,\n        \"reimbursement_entitlement_confirmed\": False,\n        \"closure_authority_confirmed\": False,\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n        \"financial_revalidation_history\": revalidation_history,\n    }\n\"\"\"Loss-aware parsing of retained Project D source files.\n\nParsing here transcribes source material and adds locators. It does not decide\npolicy eligibility, entitlement, approval readiness, or payment completion.\nOriginal retained files remain authoritative; extracted values always carry a\nsource ID and a page or workbook-cell locator.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport re\nfrom datetime import date, datetime, time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom openpyxl import load_workbook\nfrom pypdf import PdfReader\n\nfrom .sources import verify_source_manifest\n\nOUTPUT_NAME = \"parsed-records.json\"\nRECORD_SCHEMA = \"travel-claim-parsed-records/1\"\n\n\ndef _scalar(value: Any) -> Any:\n    if isinstance(value, (datetime, date, time)):\n        return value.isoformat()\n    if isinstance(value, (str, int, float, bool)) or value is None:\n        return value\n    return str(value)\n\n\ndef _extract_labels(text: str) -> list[dict[str, str]]:\n    \"\"\"Keep every colon-labelled line verbatim as a field/value occurrence.\"\"\"\n    found = []\n    for line_no, line in enumerate(text.splitlines(), 1):\n        match = re.match(r\"^\\s*([^:\\n]+):\\s?(.*)$\", line)\n        if match:\n            found.append({\"line\": str(line_no), \"label\": match.group(1), \"value\": match.group(2)})\n    return found\n\n\ndef _pdf_pages(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    reader = PdfReader(path, strict=True)\n    pages: list[dict[str, Any]] = []\n    for page_no, page in enumerate(reader.pages, 1):\n        text = page.extract_text(extraction_mode=\"layout\") or \"\"\n        claim = re.search(r\"^\\s*Claim reference:\\s*(.+)$\", text, re.M)\n        receipt_refs = re.findall(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M)\n        pages.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"locator\": f\"PDF page {page_no}\",\n            \"page\": page_no,\n            \"record_types\": ([\"claim_revision\"] if claim else []) + ([\"receipt\"] if receipt_refs else []),\n            \"claim_id\": claim.group(1).strip() if claim else None,\n            \"receipt_ids\": [item.strip() for item in receipt_refs],\n            \"fields\": _extract_labels(text),\n            \"text\": text,\n        })\n    return pages\n\n\ndef _workbook_sheets(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    workbook = load_workbook(path, data_only=False, read_only=False)\n    sheets: list[dict[str, Any]] = []\n    for sheet in workbook.worksheets:\n        rows = list(sheet.iter_rows())\n        header_row = next((i for i, row in enumerate(rows) if any(cell.value is not None for cell in row)), None)\n        if header_row is None:\n            continue\n        headers = [cell.value for cell in rows[header_row]]\n        # Workbook tabs begin with a title, notes, and a blank row. The row\n        # whose first cell names an ID/reference is the native table header.\n        table_row = next((i for i, row in enumerate(rows)\n                          if any(str(c.value).strip().lower() in {\"employee id\", \"trip reference\",\n                             \"transaction reference\", \"rate reference\", \"cap reference\",\n                             \"ledger reference\", \"decision reference\", \"activity reference\",\n                             \"cancellation activity reference\"} for c in row if c.value is not None)), None)\n        if table_row is None:\n            table_row = header_row\n        headers = [cell.value for cell in rows[table_row]]\n        records: list[dict[str, Any]] = []\n        for row_idx, row in enumerate(rows[table_row + 1:], table_row + 2):\n            if not any(cell.value is not None for cell in row):\n                continue\n            values = {}\n            for col_idx, cell in enumerate(row):\n                if col_idx >= len(headers) or headers[col_idx] is None or cell.value is None:\n                    continue\n                header = str(headers[col_idx])\n                values[header] = {\n                    \"value\": _scalar(cell.value),\n                    \"source_text\": str(cell.value),\n                    \"number_format\": cell.number_format,\n                    \"data_type\": cell.data_type,\n                    \"cell\": cell.coordinate,\n                }\n            if values:\n                first = next(iter(values.values()))\n                # The complete row map, including exact sheet/row references,\n                # is retained even when a workbook row carries multiple IDs.\n                records.append({\n                    \"source_id\": source_id,\n                    \"source_sha256\": sha256,\n                    \"locator\": f\"tab {sheet.title!r}, row {row_idx}\",\n                    \"row\": row_idx,\n                    \"values\": values,\n                })\n        sheets.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"name\": sheet.title,\n            \"header_row\": table_row + 1,\n            \"headers\": [str(h) if h is not None else None for h in headers],\n            \"records\": records,\n        })\n    workbook.close()\n    return sheets\n\n\ndef _receipt_records(pages: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    records = []\n    for page in pages:\n        if \"receipt\" not in page[\"record_types\"]:\n            continue\n        text = page[\"text\"]\n        starts = list(re.finditer(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M))\n        for i, match in enumerate(starts):\n            end = starts[i + 1].start() if i + 1 < len(starts) else len(text)\n            block = text[match.start():end].strip()\n            records.append({\n                \"source_id\": page[\"source_id\"],\n                \"source_sha256\": page[\"source_sha256\"],\n                \"locator\": f\"{page['locator']}, receipt {i + 1}\",\n                \"receipt_id\": match.group(1).strip(),\n                \"fields\": _extract_labels(block),\n                \"text\": block,\n            })\n    return records\n\n\ndef _value(row: dict[str, Any], key: str) -> Any:\n    return row.get(\"values\", {}).get(key, {}).get(\"value\")\n\n\ndef parse_retained_run(run_dir: Path, *, output_path: Path | None = None) -> dict[str, Any]:\n    \"\"\"Parse all readable retained sources after verifying their manifest hashes.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Cannot parse unverified retained sources: \" + \"; \".join(errors))\n    manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n    read = {row[\"source_id\"]: row for row in manifest[\"files\"] if row[\"status\"] == \"read\"}\n    parsed_sources: list[dict[str, Any]] = []\n    pages: list[dict[str, Any]] = []\n    sheets: list[dict[str, Any]] = []\n    for source_id, meta in read.items():\n        source_path = run_dir / meta[\"path\"]\n        if hashlib.sha256(source_path.read_bytes()).hexdigest() != meta[\"sha256\"]:\n            raise ValueError(f\"Retained-source hash changed during parse: {source_id}\")\n        if source_path.suffix.lower() == \".pdf\":\n            extracted = _pdf_pages(source_path, source_id, meta[\"sha256\"])\n            pages.extend(extracted)\n            parsed_sources.append({\"source_id\": source_id, \"kind\": \"pdf\", \"page_count\": len(extracted)})\n        elif source_path.suffix.lower() == \".xlsx\":\n            extracted_sheets = _workbook_sheets(source_path, source_id, meta[\"sha256\"])\n            sheets.extend(extracted_sheets)\n            parsed_sources.append({\"source_id\": source_id, \"kind\": \"xlsx\", \"sheet_count\": len(extracted_sheets)})\n\n    # Preserve separate record categories. These are source transcriptions,\n    # not assessments; trip and permit revisions remain independent fields.\n    claim_revisions = [p for p in pages if p[\"claim_id\"]]\n    receipt_records = _receipt_records(pages)\n    tab_by_name = {sheet[\"name\"]: sheet for sheet in sheets}\n    trips = tab_by_name.get(\"Trips\", {}).get(\"records\", [])\n    decisions = tab_by_name.get(\"Review ledger\", {}).get(\"records\", [])\n    finance = tab_by_name.get(\"Finance activity\", {}).get(\"records\", [])\n    cancellations = tab_by_name.get(\"Travel cancellations\", {}).get(\"records\", [])\n    permits = []\n    for row in trips:\n        permit_id = _value(row, \"Permit reference\")\n        if permit_id:\n            permits.append({\n                \"permit_id\": permit_id,\n                \"trip_id\": _value(row, \"Trip reference\"),\n                \"trip_revision\": _value(row, \"Trip revision\"),\n                \"permit_revision\": _value(row, \"Permit revision\"),\n                \"source_id\": row[\"source_id\"], \"source_sha256\": row[\"source_sha256\"],\n                \"locator\": row[\"locator\"], \"source_record\": row[\"values\"],\n            })\n\n    batch_ids: set[int] = set()\n    for page in pages:\n        for field in page[\"fields\"]:\n            if field[\"label\"].strip().lower() == \"arrival batch\":\n                try: batch_ids.add(int(field[\"value\"]))\n                except ValueError: pass\n    for record in decisions + finance + cancellations:\n        batch = _value(record, \"Arrival batch\")\n        if batch is not None:\n            batch_ids.add(int(batch))\n\n    batch_contents: dict[str, dict[str, int]] = {str(batch): {} for batch in sorted(batch_ids)}\n    def count_batch(category: str, records: list[dict[str, Any]], getter) -> None:\n        for record in records:\n            value = getter(record)\n            if value is None or value == \"\":\n                continue\n            key = str(int(value))\n            bucket = batch_contents.setdefault(key, {})\n            bucket[category] = bucket.get(category, 0) + 1\n    count_batch(\"claim_revisions\", claim_revisions,\n                lambda row: next((f[\"value\"] for f in row[\"fields\"] if f[\"label\"].strip().lower() == \"arrival batch\"), None))\n    count_batch(\"decisions\", decisions, lambda row: _value(row, \"Arrival batch\"))\n    count_batch(\"finance_events\", finance, lambda row: _value(row, \"Arrival batch\"))\n    count_batch(\"cancellation_activities\", cancellations, lambda row: _value(row, \"Arrival batch\"))\n\n    result = {\n        \"schema_version\": RECORD_SCHEMA,\n        \"run_id\": manifest[\"run_id\"],\n        \"source_manifest\": {\"path\": \"sources.json\", \"sha256\": hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()},\n        \"case_clock\": manifest[\"case_clock\"],\n        \"case_clock_state\": \"supplied\" if manifest[\"case_clock\"] else \"not_in_accessible_retained_sources\",\n        \"case_clock_issue\": None if manifest[\"case_clock\"] else {\n            \"reason\": \"No supplied scenario case-clock value was present in the retained native PDFs, workbook, or interview record used for this run.\",\n            \"owner\": \"Exercise facilitator\",\n            \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n        },\n        \"arrival_batches\": sorted(batch_ids),\n        \"arrival_batch_contents\": batch_contents,\n        \"missing_sources\": [\n            {\"source_id\": row[\"source_id\"], \"url\": row[\"url\"], \"locator\": row[\"locator\"],\n             \"error\": row[\"error\"], \"missing_scope\": row.get(\"missing_scope\", [])}\n            for row in manifest[\"files\"] if row[\"status\"] != \"read\"\n        ],\n        \"source_inventory\": parsed_sources,\n        \"pdf_pages\": pages,\n        \"workbook_sheets\": sheets,\n        \"records\": {\n            \"claim_revisions\": claim_revisions,\n            \"trips\": trips,\n            \"permits\": permits,\n            \"receipts\": receipt_records,\n            \"decisions\": decisions,\n            \"finance_events\": finance,\n            \"cancellation_activities\": cancellations,\n        },\n        \"processing_boundary\": {\n            \"policy_dependent_conclusions\": \"unresolved\",\n            \"reason\": \"Native reimbursement policy content is unavailable; parsed source values are not eligibility, entitlement, approval-readiness, or closure decisions.\",\n            \"owner\": \"Travel Administration Lead / facilitator for source access\",\n            \"next_action\": \"Provide an authorized native export or enable read access to the original Notion policy, then perform a fresh native read.\",\n        },\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\",\n                \"subject_type\": \"scenario\",\n                \"subject_id\": \"arrival-batch-clock\",\n                \"revision\": None,\n                \"affected_scope\": \"all batch cutoff decisions and arrival-state consumption\",\n                \"reason\": \"The task calls for a supplied case clock, but no explicit scenario date, time, or timezone was confirmed in the original task text or complete stakeholder interview export.\",\n                \"owner\": \"Exercise facilitator\",\n                \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n                \"evidence_needed\": \"Explicit scenario date, time, and timezone from the facilitator or original task material.\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\",\n                \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\",\n                \"revision\": None,\n                \"affected_scope\": \"eligibility, entitlement, approval readiness, reimbursement caps and final closure\",\n                \"reason\": \"The fresh native Notion attempt returned a generic HTML shell; earlier API access returned HTTP 401. No policy content was retained.\",\n                \"owner\": \"Travel Administration Lead / exercise facilitator\",\n                \"next_action\": \"Provide an authorized native export or enable read access to the original Notion page, then perform a fresh native read.\",\n                \"evidence_needed\": \"Complete policy content from the original Notion page or authorized native export, with observed URL/version and retained-content hash.\",\n            },\n        ],\n    }\n    destination = output_path or (run_dir / OUTPUT_NAME)\n    if destination.exists():\n        raise FileExistsError(f\"Refusing to overwrite parsed output: {destination}\")\n    destination.parent.mkdir(parents=True, exist_ok=True)\n    destination.write_text(json.dumps(result, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    return result\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Travel claim batch state\",\n  \"type\": \"object\",\n  \"required\": [\n    \"schema_version\",\n    \"run_id\",\n    \"batch_id\",\n    \"predecessor\",\n    \"source_binding\",\n    \"claims\",\n    \"requests\",\n    \"travel_cancellations\",\n    \"admitted_event_ids\",\n    \"issues\"\n  ],\n  \"properties\": {\n    \"schema_version\": {\n      \"const\": \"travel-claim-snapshot/2\"\n    },\n    \"run_id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"batch_id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"predecessor\": {\n      \"anyOf\": [\n        {\n          \"type\": \"null\"\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"path\",\n            \"sha256\"\n          ],\n          \"properties\": {\n            \"path\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"sha256\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[0-9a-f]{64}$\"\n            }\n          }\n        }\n      ]\n    },\n    \"source_binding\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"path\",\n        \"sha256\"\n      ],\n      \"properties\": {\n        \"path\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"sha256\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[0-9a-f]{64}$\"\n        }\n      }\n    },\n    \"claims\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"claim_id\",\n          \"revision\",\n          \"trip_id\",\n          \"trip_revision\",\n          \"status\",\n          \"lines\",\n          \"allowed_cents\",\n          \"paid_cents\",\n          \"balance_cents\",\n          \"decision_ids\",\n          \"next_owner\",\n          \"reason\"\n        ],\n        \"properties\": {\n          \"claim_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"trip_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"status\": {\n            \"enum\": [\n              \"pending\",\n              \"held\",\n              \"ready\",\n              \"closed-reimbursed\",\n              \"closed-no-payment\",\n              \"rejected\",\n              \"withdrawn\"\n            ]\n          },\n          \"lines\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"required\": [\n                \"cost_id\",\n                \"source_ids\",\n                \"status\",\n                \"allowed_cents\",\n                \"reason\"\n              ],\n              \"properties\": {\n                \"cost_id\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"source_ids\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"string\",\n                    \"minLength\": 1\n                  },\n                  \"uniqueItems\": true\n                },\n                \"status\": {\n                  \"enum\": [\n                    \"supported\",\n                    \"excluded\",\n                    \"unresolved\"\n                  ]\n                },\n                \"allowed_cents\": {\n                  \"type\": [\n                    \"integer\",\n                    \"null\"\n                  ],\n                  \"minimum\": 0\n                },\n                \"reason\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          },\n          \"allowed_cents\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"minimum\": 0\n          },\n          \"paid_cents\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"balance_cents\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ]\n          },\n          \"decision_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"next_owner\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"trip_revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"description\": \"Exact trip revision from the supplied trip source, independent of claim revision.\"\n          },\n          \"finance_evidence\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"recorded_obligation\",\n              \"recorded_ledger_balance_cents\",\n              \"basis\",\n              \"current_revision_authority_confirmed\",\n              \"closure_authority_confirmed\"\n            ],\n            \"properties\": {\n              \"recorded_obligation\": {\n                \"type\": [\n                  \"object\",\n                  \"null\"\n                ]\n              },\n              \"recorded_ledger_balance_cents\": {\n                \"type\": [\n                  \"integer\",\n                  \"null\"\n                ]\n              },\n              \"basis\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"current_revision_authority_confirmed\": {\n                \"const\": false\n              },\n              \"closure_authority_confirmed\": {\n                \"const\": false\n              }\n            }\n          }\n        }\n      }\n    },\n    \"requests\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"request_id\",\n          \"claim_id\",\n          \"revision\",\n          \"amount_cents\",\n          \"payee\",\n          \"currency\",\n          \"status\",\n          \"decision_ids\"\n        ],\n        \"properties\": {\n          \"request_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"claim_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"amount_cents\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"payee\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"currency\": {\n            \"const\": \"EUR\"\n          },\n          \"status\": {\n            \"enum\": [\n              \"proposed\",\n              \"accepted\",\n              \"dispatched\",\n              \"cancel-pending\",\n              \"cancelled\",\n              \"settled\",\n              \"held\"\n            ]\n          },\n          \"decision_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          }\n        }\n      }\n    },\n    \"admitted_event_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"uniqueItems\": true,\n      \"description\": \"Admitted Finance activity IDs only. Travel cancellation activity IDs belong exclusively in travel_cancellations[].admitted_cancellation_event_ids; neither kind may invent the other kind of effect.\"\n    },\n    \"issues\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"record_id\",\n          \"reason\",\n          \"owner\",\n          \"resolution_needed\"\n        ],\n        \"properties\": {\n          \"record_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"owner\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"resolution_needed\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n    \"travel_cancellations\": {\n      \"type\": \"array\",\n      \"description\": \"One current row per valid observed cancellation_id, including processes without any claim. Confirmation and financial resolution are separate facts. Invalid orphan deliveries remain in issues and retained sources until a valid initiation establishes a process.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"cancellation_id\",\n          \"target_type\",\n          \"trip_id\",\n          \"trip_revision\",\n          \"permit_id\",\n          \"permit_revision\",\n          \"status\",\n          \"admitted_cancellation_event_ids\",\n          \"requested_at\",\n          \"confirmed_at\",\n          \"effective_at\",\n          \"affected_claim_ids\",\n          \"original_request_ids\",\n          \"financial_status\",\n          \"next_owner\",\n          \"reason\",\n          \"issue_record_ids\"\n        ],\n        \"properties\": {\n          \"cancellation_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"target_type\": {\n            \"enum\": [\n              \"trip\",\n              \"permit\"\n            ]\n          },\n          \"trip_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"trip_revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"permit_id\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"minLength\": 1\n          },\n          \"permit_revision\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"minimum\": 1\n          },\n          \"status\": {\n            \"enum\": [\n              \"requested\",\n              \"confirmed\"\n            ]\n          },\n          \"admitted_cancellation_event_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"description\": \"Only lawfully admitted Travel cancellations activity IDs, retaining initiation/confirmation identity and authority through the bound source records.\"\n          },\n          \"requested_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"confirmed_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"effective_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"affected_claim_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"original_request_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"financial_status\": {\n            \"enum\": [\n              \"no-financial-effect\",\n              \"unresolved\",\n              \"resolved\"\n            ]\n          },\n          \"next_owner\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"minLength\": 1\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"issue_record_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          }\n        },\n        \"allOf\": [\n          {\n            \"if\": {\n              \"properties\": {\n                \"status\": {\n                  \"const\": \"requested\"\n                }\n              }\n            },\n            \"then\": {\n              \"properties\": {\n                \"confirmed_at\": {\n                  \"type\": \"null\"\n                },\n                \"effective_at\": {\n                  \"type\": \"null\"\n                },\n                \"next_owner\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            },\n            \"else\": {\n              \"properties\": {\n                \"confirmed_at\": {\n                  \"type\": \"string\",\n                  \"format\": \"date-time\"\n                },\n                \"effective_at\": {\n                  \"type\": \"string\",\n                  \"format\": \"date-time\"\n                }\n              }\n            }\n          },\n          {\n            \"if\": {\n              \"properties\": {\n                \"permit_id\": {\n                  \"type\": \"null\"\n                }\n              }\n            },\n            \"then\": {\n              \"properties\": {\n                \"permit_revision\": {\n                  \"type\": \"null\"\n                },\n                \"target_type\": {\n                  \"const\": \"trip\"\n                }\n              }\n            },\n            \"else\": {\n              \"properties\": {\n                \"permit_revision\": {\n                  \"type\": \"integer\",\n                  \"minimum\": 1\n                }\n              }\n            }\n          }\n        ]\n      }\n    }\n  }\n}\n","stderr":"","aggregated_output":"\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            if item_id in queue[\"items\"]:\n                item = queue[\"items\"][item_id]\n                changes = {key: value for key, value in {\n                    \"source_refs\": refs,\n                    \"missing_or_return_reason\": issue[\"missing_or_return_reason\"],\n                    \"next_action\": issue[\"next_action\"],\n                }.items() if item[key] != value}\n                if changes:\n                    update_repair_item(queue, item_id=item_id,\n                                       update_id=f\"finance-evidence:{item_id}:{batch_id}\",\n                                       run_id=run_id, batch_id=batch_id, **changes)\n                continue\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n    previous_revisions: dict[str, int],\n) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, claim in _subject_claim_revisions(history).items():\n        revision = claim[\"current_revision\"]\n        old_revision = previous_revisions.get(claim_id)\n        if old_revision is None or revision <= old_revision:\n            continue\n        current = next(row for row in reversed(claim[\"revisions\"]) if row[\"revision\"] == revision)\n        prior = [row for row in claim[\"revisions\"] if row[\"revision\"] == old_revision]\n        refs = [_ref_text(row[\"source_ref\"]) for row in prior + [current]]\n        old_decisions = [\n            decision for decision in domain[\"decision_history\"]\n            if decision.get(\"subject_type\") == \"claim\" and decision.get(\"subject_id\") == claim_id\n            and decision.get(\"revision\") == old_revision\n        ]\n        refs.extend(_ref_text(row[\"decision_source_ref\"]) for row in old_decisions)\n        affected_finance = [row for row in domain[\"finance_records\"] if row_values(row).get(\"Claim reference\") == claim_id]\n        refs.extend(_ref_text(_ref(row)) for row in affected_finance)\n        refs = list(dict.fromkeys(refs))\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"])\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {\n        row_values(record).get(\"Cancellation activity reference\"): record\n        for record in domain[\"cancellation_records\"]\n    }\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    break\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if process[\"state\"] == \"confirmed\" and item[\"next_action\"] != next_action:\n                changes[\"next_action\"] = next_action\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"original_request_ids\": [],\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> None:\n    queue = domain[\"repair_queue\"]\n    blockers = []\n    for conflict in history.get(\"issues\", {}).get(\"repeated_subject_revisions\", []):\n        kind = conflict[\"kind\"]\n        subject_id = conflict[\"subject_id\"]\n        revision = conflict[\"revision\"]\n        refs = [_ref_text(ref) for ref in conflict.get(\"occurrences\", [])]\n        item_id = f\"revision-conflict:{kind}:{subject_id}:r{revision}\"\n        _open_issue_for_subject(\n            queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n            revision=revision, refs=refs,\n            reason=f\"multiple retained source records use {kind} {subject_id} revision {revision}; their business content requires review\",\n            owner=\"Travel Administration Lead\", next_action=\"compare the source occurrences and establish the supported revision record\",\n            run_id=run_id, batch_id=batch_id,\n        )\n    for malformed in history.get(\"issues\", {}).get(\"malformed_revision_records\", []):\n        blockers.append({\n            \"record_id\": f\"malformed-revision:{_digest(malformed)[:16]}\",\n            \"reason\": malformed[\"reason\"],\n            \"owner\": \"Travel Administration Lead\",\n            \"resolution_needed\": \"identify the subject and revision from the native source record\",\n            \"source_ref\": malformed.get(\"source_ref\"),\n        })\n    for decision in domain[\"decision_history\"]:\n        if decision[\"structural_match\"] in {\"revision_match_current\", \"revision_match_historical\"}:\n            continue\n        kind, subject_id, revision = decision.get(\"subject_type\"), decision.get(\"subject_id\"), decision.get(\"revision\")\n        decision_id = decision.get(\"decision_id\") or _digest(decision)[:16]\n        if kind in {\"claim\", \"trip\", \"permit\"} and isinstance(subject_id, str) and isinstance(revision, int) and revision > 0:\n            item_id = f\"decision-match:{decision_id}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n                revision=revision, refs=[_ref_text(decision[\"decision_source_ref\"])],\n                reason=f\"recorded decision {decision_id} does not structurally match an available {kind} revision ({decision['structural_match']})\",\n                owner=\"Travel Administration Lead\", next_action=\"resolve the decision subject or revision against the native review ledger\",\n                run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            blockers.append({\n                \"record_id\": f\"decision-match:{decision_id}\",\n                \"reason\": f\"recorded decision has no traceable supported subject/revision ({decision['structural_match']})\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"identify its subject and revision in the native review ledger\",\n                \"source_ref\": decision[\"decision_source_ref\"],\n            })\n    domain[\"structural_blockers\"] = blockers\n\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Integrate exactly the next arrival batch into a schema-shaped projection.\n\n    The function retains raw subject/activity rows in a sidecar `domain`,\n    carries earlier state forward, and supports exact same-batch replay. It\n    does not consume or seal a scenario snapshot; callers must separately\n    verify access, case clock, policy, and authorities before doing that.\n    \"\"\"\n    if isinstance(arrival_batch, bool) or not isinstance(arrival_batch, int) or arrival_batch < 1:\n        raise ValueError(\"arrival_batch must be a positive integer\")\n    if not run_id or not batch_id or not isinstance(source_binding, dict):\n        raise ValueError(\"run_id, batch_id, and source_binding are required\")\n    delta = _delta(parsed, arrival_batch)\n    digest = _digest({\n        \"delta\": delta,\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"source_binding\": source_binding,\n        \"predecessor\": predecessor,\n        \"authorized_obligations\": authorized_obligations or {},\n        \"source_classifications\": source_classifications or {},\n        \"trip_reference_records\": parsed.get(\"records\", {}).get(\"trips\", []),\n        \"unresolved_issues\": parsed.get(\"unresolved_issues\", []),\n    })\n    previous_domain = deepcopy(prior_result[\"domain\"]) if prior_result else _domain_seed()\n    processed = previous_domain[\"processed_batches\"]\n    if processed and arrival_batch == processed[-1]:\n        if previous_domain[\"batch_input_hashes\"].get(str(arrival_batch)) == digest:\n            return deepcopy(prior_result)\n        raise ValueError(f\"conflicting replay for arrival batch {arrival_batch}\")\n    expected_batch = processed[-1] + 1 if processed else 1\n    if arrival_batch != expected_batch:\n        raise ValueError(f\"arrival batches must be integrated in explicit order; expected {expected_batch}, got {arrival_batch}\")\n    if prior_result is None and predecessor is not None:\n        raise ValueError(\"the first integrated batch must have a null predecessor\")\n    if prior_result is not None:\n        if prior_result.get(\"snapshot\", {}).get(\"run_id\") != run_id:\n            raise ValueError(\"prior integration state belongs to a different run\")\n        if predecessor is None:\n            raise ValueError(\"a later integrated batch must carry a predecessor binding\")\n\n    domain = previous_domain\n    if authorized_obligations:\n        domain[\"authorized_obligations\"].update(deepcopy(authorized_obligations))\n    if source_classifications:\n        domain[\"source_classifications\"].update(deepcopy(source_classifications))\n    previous_claim_revisions = {\n        subject_id: value[\"current_revision\"]\n        for subject_id, value in (domain.get(\"revision_history\") or {}).get(\"claim\", {}).items()\n    }\n    for name in (\"claim_revisions\", \"decisions\", \"finance_events\", \"cancellation_activities\"):\n        target_name = {\n            \"claim_revisions\": \"claim_records\", \"decisions\": \"decision_records\",\n            \"finance_events\": \"finance_records\", \"cancellation_activities\": \"cancellation_records\",\n        }[name]\n        domain[target_name].extend(deepcopy(delta[name]))\n    domain[\"processed_batches\"].append(arrival_batch)\n    domain[\"batch_input_hashes\"][str(arrival_batch)] = digest\n\n    history = build_revision_history({\n        \"records\": {\"claim_revisions\": domain[\"claim_records\"], \"trips\": parsed.get(\"records\", {}).get(\"trips\", [])}\n    })\n    domain[\"revision_history\"] = history\n    domain[\"decision_history\"] = match_decisions_to_subjects(domain[\"decision_records\"], history)\n    for decision, raw in zip(domain[\"decision_history\"], domain[\"decision_records\"]):\n        decision[\"arrival_batch\"] = row_values(raw).get(\"Arrival batch\")\n        decision[\"applied\"] = False\n    _sync_decision_and_revision_issues(domain, history=history, run_id=run_id, batch_id=batch_id)\n    _material_correction_tasks(\n        domain, history=history, run_id=run_id, batch_id=batch_id,\n        previous_revisions=previous_claim_revisions,\n    )\n\n    current_claims = {}\n    for claim_id, record_set in history.get(\"claim\", {}).items():\n        current_revision = record_set[\"current_revision\"]\n        claim_revision = next(row for row in reversed(record_set[\"revisions\"]) if row[\"revision\"] == current_revision)\n        current_claims[claim_id] = claim_revision\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n        )\n    domain[\"finance_reconciliations\"] = finance_results\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n    # Policy and case-clock blockers are copied from parser/source evidence and\n    # deliberately remain outside any fabricated claim/decision outcome.\n    blockers = []\n    for row in parsed.get(\"unresolved_issues\", []):\n        blocker = {\n            \"record_id\": row[\"record_id\"],\n            \"reason\": row.get(\"reason\", \"Unresolved source issue\"),\n            \"owner\": row.get(\"owner\", \"Exercise facilitator\"),\n            \"resolution_needed\": row.get(\"next_action\", \"Obtain the missing authoritative evidence\"),\n            \"subject_type\": row.get(\"subject_type\"),\n            \"subject_id\": row.get(\"subject_id\"),\n            \"affected_scope\": row.get(\"affected_scope\"),\n            \"evidence_needed\": row.get(\"evidence_needed\"),\n        }\n        blockers.append(blocker)\n    domain[\"policy_clock_blockers\"] = blockers\n\n    cancellation_rows = _cancellation_rows(domain, history=history, run_id=run_id, batch_id=batch_id)\n    schema_issues = list(blockers) + list(domain.get(\"structural_blockers\", []))\n    schema_issues.extend(_issue_from_item(item) for item in domain[\"repair_queue\"][\"items\"].values() if item[\"status\"] == \"open\")\n    # Every cancellation issue reference must resolve in issues[].record_id.\n    known_issue_ids = {issue[\"record_id\"] for issue in schema_issues}\n    for cancellation in cancellation_rows:\n        cancellation[\"issue_record_ids\"] = [\n            issue_id for issue_id in cancellation[\"issue_record_ids\"] if issue_id in known_issue_ids\n        ]\n\n    snapshot_claims = []\n    projection_issues = []\n    for claim_id, revision_row in sorted(current_claims.items()):\n        revision = revision_row[\"revision\"]\n        record = revision_row[\"record\"]\n        values = _page_values(record)\n        trip_id = revision_row.get(\"trip_id\")\n        trip_revision = revision_row.get(\"trip_revision\")\n        if not trip_id or not trip_revision:\n            projection_issues.append({\n                \"record_id\": f\"snapshot-claim-link:{claim_id}:r{revision}\",\n                \"reason\": \"claim source lacks the trip identity or revision required by snapshot.schema.json; claim omitted from snapshot projection\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"obtain and verify the current claim-to-trip revision binding\",\n            })\n            continue\n        trip_record_set = history.get(\"trip\", {}).get(str(trip_id), {})\n        linked_trip = any(row[\"revision\"] == trip_revision for row in trip_record_set.get(\"revisions\", []))\n        if not linked_trip:\n            item_id = f\"trip-link:{claim_id}:r{revision}\"\n            _open_issue_for_subject(\n                domain[\"repair_queue\"], item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=[_ref_text(revision_row[\"source_ref\"])],\n                reason=f\"claim references trip {trip_id} revision {trip_revision}, which is not present in the retained trip register\",\n                owner=\"Travel Administration Lead\", next_action=\"verify the trip revision from an accessible native travel register\",\n                run_id=run_id, batch_id=batch_id,\n            )\n            schema_issues.append(_issue_from_item(domain[\"repair_queue\"][\"items\"][item_id]))\n        matches = [row for row in domain[\"decision_history\"]\n                   if row.get(\"subject_type\") == \"claim\" and row.get(\"subject_id\") == claim_id\n                   and row.get(\"revision\") == revision and row.get(\"structural_match\") == \"revision_match_current\"]\n        finance = finance_results[claim_id]\n        snapshot_claims.append({\n            \"claim_id\": claim_id,\n            \"revision\": revision,\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"status\": \"pending\",\n            \"lines\": [],\n            \"allowed_cents\": None,\n            \"finance_evidence\": {\n                \"recorded_obligation\": deepcopy(finance[\"recorded_obligation\"]),\n                \"recorded_ledger_balance_cents\": finance[\"recorded_ledger_balance_cents\"],\n                \"basis\": \"Recorded request ledger only; not reviewed entitlement or current-revision authorization\",\n                \"current_revision_authority_confirmed\": False,\n                \"closure_authority_confirmed\": False,\n            },\n            \"paid_cents\": finance[\"net_confirmed_cents\"],\n            \"balance_cents\": finance[\"balance_cents\"],\n            \"decision_ids\": list(dict.fromkeys(row[\"decision_id\"] for row in matches if row.get(\"decision_id\"))),\n            \"next_owner\": \"Travel Administration Lead\",\n            \"reason\": \"Structural integration only; reimbursement policy and current-revision compliance remain unresolved.\",\n        })\n\n    schema_issues.extend(projection_issues)\n    schema_issues.extend(domain.get(\"projection_issues\", []))\n    # Deduplicate by record_id while preserving issue order.\n    unique_issues = {}\n    for issue in schema_issues:\n        unique_issues.setdefault(issue[\"record_id\"], issue)\n    schema_issues = list(unique_issues.values())\n\n    finance_ids = []\n    unresolved_ids = set()\n    conflicting_ids = set()\n    for result in finance_results.values():\n        unresolved_ids.update(result[\"unresolved_event_ids\"])\n        conflicting_ids.update(issue[\"event_id\"] for issue in result[\"conflicting_events\"])\n        for event in result[\"event_history\"]:\n            event_id = event[\"event_id\"]\n            if (event_id and event_id not in unresolved_ids and event_id not in conflicting_ids\n                    and event[\"classification\"] not in {\"unresolved\", \"conflicting_event_id\", \"missing_event_id\"}):\n                finance_ids.append(event_id)\n    finance_ids = list(dict.fromkeys(event_id for event_id in finance_ids if event_id not in unresolved_ids | conflicting_ids))\n\n    snapshot = {\n        \"schema_version\": \"travel-claim-snapshot/2\",\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"predecessor\": deepcopy(predecessor),\n        \"source_binding\": deepcopy(source_binding),\n        \"claims\": snapshot_claims,\n        \"requests\": [],\n        \"travel_cancellations\": cancellation_rows,\n        \"admitted_event_ids\": finance_ids,\n        \"issues\": schema_issues,\n    }\n    domain[\"processed_batches\"] = list(domain[\"processed_batches\"])\n    return {\n        \"snapshot\": snapshot,\n        \"domain\": domain,\n        \"decision_history\": deepcopy(domain[\"decision_history\"]),\n        \"finance_reconciliations\": deepcopy(finance_results),\n        \"revision_history\": deepcopy(history),\n        \"repair_queue_by_owner\": _owner_view(domain[\"repair_queue\"]),\n        \"batch_delta_counts\": {key: len(value) for key, value in delta.items()},\n        \"input_sha256\": digest,\n    }\n\n\ndef _owner_view(queue: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:\n    grouped: dict[str, list[dict[str, Any]]] = {}\n    for item in queue[\"items\"].values():\n        grouped.setdefault(item[\"owner\"], []).append(item)\n    return {owner: sorted(items, key=lambda row: row[\"item_id\"]) for owner, items in sorted(grouped.items())}\n\"\"\"Source-traceable Finance reconciliation primitives.\n\nOnly explicit, source-classified settled and refund events affect confirmed\ncash. Finance obligations remain separate from caller-supplied authorized\nobligations. No policy entitlement or approval decision is made here.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom copy import deepcopy\nfrom decimal import Decimal, InvalidOperation\nfrom datetime import datetime\nfrom typing import Any\n\n\n_NATIVE_EVENT_CLASSES = {\n    \"accepted\": \"obligation_accepted\",\n    \"settled\": \"confirmed_payment\",\n    \"refund\": \"confirmed_refund\",\n    \"failed\": \"failed_transfer\",\n    \"retry_authorized\": \"retry_authorization\",\n    \"cancellation_requested\": \"finance_cancellation_requested\",\n    \"cancelled\": \"finance_cancelled\",\n    # These are retained as non-cash Finance records; their amount describes\n    # an obligation, not a payment.\n    \"adjustment\": \"finance_adjustment\",\n    \"resolution\": \"finance_resolution\",\n}\n\n\ndef _values(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: cell.get(\"value\") for key, cell in record.get(\"values\", {}).items()}\n\n\ndef _source_ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _cents(value: Any) -> int | None:\n    \"\"\"Convert exact EUR decimal input to integer cents; reject rounding.\"\"\"\n    if value is None or isinstance(value, bool):\n        return None\n    try:\n        amount = Decimal(str(value))\n    except (InvalidOperation, ValueError):\n        return None\n    if not amount.is_finite():\n        return None\n    scaled = amount * 100\n    if scaled != scaled.to_integral_value() or scaled < 0:\n        return None\n    return int(scaled)\n\n\ndef _payload(values: dict[str, Any]) -> dict[str, Any]:\n    return {key: values[key] for key in sorted(values) if key != \"Arrival batch\"}\n\n\ndef _reference_text(ref: dict[str, Any]) -> str:\n    return f\"{ref.get('source_id')}@{ref.get('source_sha256')}#{ref.get('locator')}\"\n\n\ndef _positive_integer(value: Any) -> int | None:\n    try:\n        return int(value) if not isinstance(value, bool) and int(value) > 0 and float(value) == int(value) else None\n    except (ValueError, TypeError, OverflowError):\n        return None\n\n\ndef _recorded_obligations(history: list[dict], *, claim_id: str, current_revision: int,\n                          revisions: list[dict]) -> tuple[list[dict], dict | None, str | None]:\n    \"\"\"Read ledger observations, without deriving reimbursement authorization.\n\n    Obligation (EUR) is a recorded amount, not a cash delta. Native rows omit\n    claim revision; arrival context is retained separately from explicit links.\n    Only the first delivery establishes context; redelivery cannot rebind it.\n    \"\"\"\n    groups: dict[str, list[dict]] = defaultdict(list)\n    for event in history:\n        if event['classification'] in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'}:\n            groups[event['event_id']].append(event)\n    records = []\n    problem = None\n    for event_id, occurrences in groups.items():\n        event = occurrences[0]\n        values = event['source_record']\n        batches = [e['source_record'].get('Arrival batch') for e in occurrences]\n        first_batch = min((_positive_integer(b) for b in batches if _positive_integer(b)), default=None)\n        context_rows = [r for r in revisions if first_batch is not None\n                        and _positive_integer(r.get('arrival_batch')) is not None\n                        and _positive_integer(r['arrival_batch']) <= first_batch]\n        context = max((r['revision'] for r in context_rows), default=None)\n        explicit = _positive_integer(values.get('Claim revision'))\n        matches = [r for r in revisions if r['revision'] == explicit] if explicit else []\n        link = ('explicit_current' if explicit == current_revision else 'explicit_historical') if matches else 'arrival_context_only' if context else 'unmatched'\n        refs = [_reference_text(e['source_ref']) for e in occurrences]\n        record = {\n            'event_id': event_id, 'event_type': event['event_type'], 'claim_id': claim_id,\n            'request_id': values.get('Request reference'), 'finance_officer': values.get('Finance officer'),\n            'payee_id': values.get('Payee ID'), 'currency': event['currency'],\n            'amount_cents': event['obligation_cents'], 'activity_time_utc': values.get('Activity time (UTC)'),\n            'claim_revision': explicit if matches else None, 'arrival_revision_context': context,\n            'revision_link_status': link, 'first_arrival_batch': first_batch,\n            'delivery_batches': batches, 'source_refs': list(dict.fromkeys(refs)),\n            'claim_source_refs': [deepcopy(r['source_ref']) for r in (matches or context_rows)\n                                  if r['revision'] == (explicit if matches else context)],\n        }\n        records.append(record)\n        if (event['currency'] != 'EUR' or event['obligation_cents'] is None or not first_batch\n                or not all(isinstance(values.get(key), str) and values[key].strip()\n                           for key in ('Request reference', 'Finance officer', 'Payee ID'))\n                or not all(all(e['source_ref'].get(key) for key in ('source_id', 'source_sha256', 'locator')) for e in occurrences)\n                or (values.get('Claim revision') is not None and not matches)):\n            problem = 'Obligation record lacks supported amount, request/payee/officer, source identity, arrival, or explicit revision match'\n    if not records:\n        return [], None, None\n    if len({(r['request_id'], r['payee_id'], r['currency']) for r in records}) != 1:\n        problem = 'Multiple request/payee/currency ledgers cannot be combined as one obligation'\n    # A single observation needs no ordering assumption. Multiple observations\n    # require explicit UTC event times; arrival numbers do not define business time.\n    if len(records) > 1:\n        try:\n            def stamp(record):\n                dt = datetime.fromisoformat(record['activity_time_utc'].replace('Z', '+00:00'))\n                # The retained header explicitly names UTC even when the cell\n                # serialization omits an offset.\n                if dt.utcoffset() is not None and dt.utcoffset().total_seconds() != 0:\n                    raise ValueError('not UTC')\n                return dt.replace(tzinfo=None)\n            records.sort(key=lambda r: (stamp(r), r['event_id']))\n            for left, right in zip(records, records[1:]):\n                if stamp(left) == stamp(right) and left['amount_cents'] != right['amount_cents']:\n                    problem = 'Conflicting obligation amounts have the same event time'\n        except (ValueError, TypeError, AttributeError):\n            problem = 'Multiple obligation observations lack unambiguous UTC ordering'\n    return records, deepcopy(records[-1]) if not problem else None, problem\n\n\ndef reconcile_finance_events(\n    events: list[dict[str, Any]],\n    *,\n    claim_id: str,\n    current_revision: int,\n    authorized_obligation: dict[str, Any] | None = None,\n    revision_history: list[dict[str, Any]] | None = None,\n    previous_reconciliation: dict[str, Any] | None = None,\n    owner: str = \"Finance\",\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, Any]:\n    \"\"\"Reconcile source events for a claim without making policy decisions.\n\n    `authorized_obligation` is an independent, already-authorized input of\n    `{amount_cents, claim_revision, source_refs}`. This function neither\n    derives nor authorizes it. `source_classifications` may extend the native\n    workbook vocabulary when a retained source defines another event type;\n    unrecognized types otherwise remain unresolved.\n    \"\"\"\n    if not claim_id or isinstance(current_revision, bool) or not isinstance(current_revision, int) or current_revision < 1:\n        raise ValueError(\"claim_id and a positive current_revision are required\")\n    if not owner:\n        raise ValueError(\"owner is required for reconciliation issues\")\n\n    classes = dict(_NATIVE_EVENT_CLASSES)\n    if source_classifications:\n        allowed_classes = {\n            \"confirmed_payment\", \"confirmed_refund\", \"pending_transfer\",\n            \"obligation_accepted\", \"failed_transfer\", \"retry_authorization\",\n            \"finance_cancellation_requested\", \"finance_cancelled\",\n            \"finance_adjustment\", \"finance_resolution\",\n        }\n        for event_type, classification in source_classifications.items():\n            if not isinstance(event_type, str) or classification not in allowed_classes:\n                raise ValueError(f\"unsupported source event classification: {event_type!r} -> {classification!r}\")\n            classes[event_type] = classification\n\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id_records: list[dict[str, Any]] = []\n    for record in events:\n        event_id = _values(record).get(\"Activity reference\")\n        if not isinstance(event_id, str) or not event_id:\n            if _values(record).get(\"Claim reference\") == claim_id:\n                missing_id_records.append(record)\n        else:\n            by_id[event_id].append(record)\n\n    relevant_occurrences: list[tuple[str | None, dict[str, Any], dict[str, Any], bool]] = []\n    duplicate_events = []\n    conflicting_events = []\n    for event_id, occurrences in by_id.items():\n        relevant = [record for record in occurrences if _values(record).get(\"Claim reference\") == claim_id]\n        if not relevant:\n            continue\n        payloads = [_payload(_values(record)) for record in occurrences]\n        conflict = any(payload != payloads[0] for payload in payloads[1:])\n        for record in relevant:\n            relevant_occurrences.append((event_id, record, _values(record), conflict))\n        if conflict:\n            conflicting_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"payloads\": payloads,\n            })\n        elif len(occurrences) > 1:\n            duplicate_events.append({\n                \"event_id\": event_id,\n                \"source_refs\": [_source_ref(record) for record in occurrences],\n                \"delivery_batches\": [_values(record).get(\"Arrival batch\") for record in occurrences],\n            })\n    relevant_occurrences.extend((None, record, _values(record), True) for record in missing_id_records)\n    relevant_occurrences.sort(key=lambda row: (\n        _positive_integer(row[2].get(\"Arrival batch\")) or 0,\n        int(row[1].get(\"row\") or 0),\n        row[0] or \"\",\n    ))\n\n    history = []\n    event_issue_by_id: dict[str, dict[str, Any]] = {}\n    typed = []\n    unresolved = []\n    for event_id, record, values, conflict in relevant_occurrences:\n        event_type = values.get(\"Activity type\")\n        classification = classes.get(event_type, \"unresolved\")\n        item = {\n            \"event_id\": event_id,\n            \"source_ref\": _source_ref(record),\n            \"source_record\": deepcopy(values),\n            \"event_type\": event_type,\n            \"classification\": (\n                \"conflicting_event_id\" if conflict and event_id else\n                \"missing_event_id\" if conflict else classification\n            ),\n            \"amount_cents\": _cents(values.get(\"Amount (EUR)\")),\n            \"obligation_cents\": _cents(values.get(\"Obligation (EUR)\")),\n            \"currency\": values.get(\"Currency\"),\n            \"original_activity_id\": values.get(\"Original activity reference\"),\n        }\n        history.append(item)\n        if conflict:\n            if event_id:\n                event_issue_by_id[event_id] = {\n                    \"record_id\": f\"finance-event-conflict:{event_id}\",\n                    \"event_id\": event_id,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"same Finance event ID has conflicting source content; none of its occurrences were counted\",\n                    \"source_refs\": [_source_ref(row) for row in by_id[event_id]],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to resolve the source record conflict\",\n                }\n            else:\n                event_issue_by_id[f\"missing:{record.get('locator')}\"] = {\n                    \"record_id\": f\"finance-event-missing-id:{record.get('row') or len(event_issue_by_id) + 1}\",\n                    \"event_id\": None,\n                    \"subject_type\": \"claim\",\n                    \"subject_id\": claim_id,\n                    \"revision\": current_revision,\n                    \"missing_or_return_reason\": \"Finance event has no activity reference and cannot be safely deduplicated or counted\",\n                    \"source_refs\": [_source_ref(record)],\n                    \"owner\": owner,\n                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n                }\n            continue\n        if classification == \"unresolved\":\n            unresolved.append(item)\n            continue\n        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n                unresolved.append(item)\n                continue\n        typed.append(item)\n\n    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n    confirmed_refunds: list[dict[str, Any]] = []\n    refund_candidates = list({item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_refund\"}.values())\n    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    for item in refund_candidates:\n        original_id = item[\"original_activity_id\"]\n        original = payments.get(original_id) if isinstance(original_id, str) else None\n        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n            unresolved.append(item)\n            continue\n        refund_groups[original_id].append(item)\n    for original_id, refunds in refund_groups.items():\n        original = payments[original_id]\n        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n        if refund_total > original[\"amount_cents\"]:\n            unresolved.extend(refunds)\n            continue\n        confirmed_refunds.extend(refunds)\n\n    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n    unresolved.extend(invalid_payments)\n    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n\n    issues = list(event_issue_by_id.values())\n    for number, item in enumerate(unresolved, 1):\n        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n        issue = {\n            \"record_id\": issue_id,\n            \"event_id\": item[\"event_id\"],\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [item[\"source_ref\"]],\n            \"missing_or_return_reason\": (\n                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n            ),\n            \"owner\": owner,\n            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n        }\n        issues.append(issue)\n    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n    )\n    if recorded_problem:\n        issues.append({\n            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n        })\n    obligation = None\n    obligation_issue = None\n    if authorized_obligation is not None:\n        amount = authorized_obligation.get(\"amount_cents\")\n        obligation_revision = authorized_obligation.get(\"claim_revision\")\n        refs = authorized_obligation.get(\"source_refs\")\n        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n                and obligation_revision == current_revision and isinstance(refs, list)\n                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n        else:\n            obligation_issue = {\n                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n                \"event_id\": None,\n                \"subject_type\": \"claim\",\n                \"subject_id\": claim_id,\n                \"revision\": current_revision,\n                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n                \"owner\": owner,\n                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n            }\n    else:\n        obligation_issue = {\n            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n            \"event_id\": None,\n            \"subject_type\": \"claim\",\n            \"subject_id\": claim_id,\n            \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n            \"missing_or_return_reason\": (\"recorded Finance obligation exists, but current-revision reimbursement authorization and entitlement remain unconfirmed\"\n                                         if recorded_obligation else \"no supported authorized obligation was supplied for this claim revision\"),\n            \"owner\": owner,\n            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n        }\n    if obligation_issue is not None:\n        issues.append(obligation_issue)\n\n    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n    balance = None\n    if obligation is not None and event_set_complete:\n        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n\n    ledger_balance = None\n    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n        # Cash for a different/missing request cannot be silently applied to this ledger.\n        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n    if recorded_obligation is not None and event_set_complete and ledger_balance is None:\n        issues.append({\n            \"record_id\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n            \"owner\": owner,\n            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n        })\n    issues_by_owner = {}\n    for issue in issues:\n        issues_by_owner.setdefault(issue['owner'], []).append(issue)\n    issues_by_owner = {key: sorted(value, key=lambda row: row['record_id']) for key, value in sorted(issues_by_owner.items())}\n    invalidated = None\n    if previous_reconciliation is not None:\n        previous_revision = previous_reconciliation.get(\"claim_revision\")\n        if previous_revision != current_revision:\n            invalidated = {\n                \"claim_revision\": previous_revision,\n                \"reason\": \"material revision change invalidates the prior reconciliation basis\",\n                \"prior_net_confirmed_cents\": previous_reconciliation.get(\"net_confirmed_cents\"),\n                \"prior_balance_cents\": previous_reconciliation.get(\"balance_cents\"),\n                \"prior_recorded_obligation\": deepcopy(previous_reconciliation.get(\"recorded_obligation\")),\n                \"next_action\": \"Revalidate exact revision authorization; historical ledger and cash remain retained\",\n            }\n    revalidation_history = deepcopy((previous_reconciliation or {}).get(\"financial_revalidation_history\", []))\n    if invalidated is not None:\n        revalidation_history.append(deepcopy(invalidated))\n    return {\n        \"claim_id\": claim_id,\n        \"claim_revision\": current_revision,\n        \"revision_history\": deepcopy(revision_history or []),\n        \"event_history\": history,\n        \"event_ids\": [item[\"event_id\"] for item in history if item[\"event_id\"] is not None],\n        \"duplicate_events\": duplicate_events,\n        \"conflicting_events\": conflicting_events,\n        \"confirmed_payment_event_ids\": [item[\"event_id\"] for item in payments.values() if item[\"amount_cents\"] is not None],\n        \"confirmed_refund_event_ids\": [item[\"event_id\"] for item in confirmed_refunds],\n        \"pending_transfer_event_ids\": [item[\"event_id\"] for item in typed if item[\"classification\"] == \"pending_transfer\"],\n        \"unresolved_event_ids\": list(dict.fromkeys(item[\"event_id\"] for item in unresolved if item[\"event_id\"] is not None)),\n        \"finance_obligation_events\": [item for item in history if item[\"classification\"] == \"obligation_accepted\"],\n        \"recorded_obligation_history\": obligation_history,\n        \"recorded_obligation\": recorded_obligation,\n        \"recorded_ledger_balance_cents\": ledger_balance,\n        \"reimbursement_entitlement_confirmed\": False,\n        \"closure_authority_confirmed\": False,\n        \"authorized_obligation\": obligation,\n        \"confirmed_payment_cents\": confirmed_payment_cents,\n        \"confirmed_refund_cents\": confirmed_refund_cents,\n        \"net_confirmed_cents\": net_confirmed_cents,\n        \"balance_cents\": balance,\n        \"inputs_complete\": balance is not None,\n        \"repair_issues\": issues,\n        \"repair_issues_by_owner\": issues_by_owner,\n        \"invalidated_previous_reconciliation\": invalidated,\n        \"financial_revalidation_history\": revalidation_history,\n    }\n\"\"\"Loss-aware parsing of retained Project D source files.\n\nParsing here transcribes source material and adds locators. It does not decide\npolicy eligibility, entitlement, approval readiness, or payment completion.\nOriginal retained files remain authoritative; extracted values always carry a\nsource ID and a page or workbook-cell locator.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport re\nfrom datetime import date, datetime, time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom openpyxl import load_workbook\nfrom pypdf import PdfReader\n\nfrom .sources import verify_source_manifest\n\nOUTPUT_NAME = \"parsed-records.json\"\nRECORD_SCHEMA = \"travel-claim-parsed-records/1\"\n\n\ndef _scalar(value: Any) -> Any:\n    if isinstance(value, (datetime, date, time)):\n        return value.isoformat()\n    if isinstance(value, (str, int, float, bool)) or value is None:\n        return value\n    return str(value)\n\n\ndef _extract_labels(text: str) -> list[dict[str, str]]:\n    \"\"\"Keep every colon-labelled line verbatim as a field/value occurrence.\"\"\"\n    found = []\n    for line_no, line in enumerate(text.splitlines(), 1):\n        match = re.match(r\"^\\s*([^:\\n]+):\\s?(.*)$\", line)\n        if match:\n            found.append({\"line\": str(line_no), \"label\": match.group(1), \"value\": match.group(2)})\n    return found\n\n\ndef _pdf_pages(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    reader = PdfReader(path, strict=True)\n    pages: list[dict[str, Any]] = []\n    for page_no, page in enumerate(reader.pages, 1):\n        text = page.extract_text(extraction_mode=\"layout\") or \"\"\n        claim = re.search(r\"^\\s*Claim reference:\\s*(.+)$\", text, re.M)\n        receipt_refs = re.findall(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M)\n        pages.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"locator\": f\"PDF page {page_no}\",\n            \"page\": page_no,\n            \"record_types\": ([\"claim_revision\"] if claim else []) + ([\"receipt\"] if receipt_refs else []),\n            \"claim_id\": claim.group(1).strip() if claim else None,\n            \"receipt_ids\": [item.strip() for item in receipt_refs],\n            \"fields\": _extract_labels(text),\n            \"text\": text,\n        })\n    return pages\n\n\ndef _workbook_sheets(path: Path, source_id: str, sha256: str) -> list[dict[str, Any]]:\n    workbook = load_workbook(path, data_only=False, read_only=False)\n    sheets: list[dict[str, Any]] = []\n    for sheet in workbook.worksheets:\n        rows = list(sheet.iter_rows())\n        header_row = next((i for i, row in enumerate(rows) if any(cell.value is not None for cell in row)), None)\n        if header_row is None:\n            continue\n        headers = [cell.value for cell in rows[header_row]]\n        # Workbook tabs begin with a title, notes, and a blank row. The row\n        # whose first cell names an ID/reference is the native table header.\n        table_row = next((i for i, row in enumerate(rows)\n                          if any(str(c.value).strip().lower() in {\"employee id\", \"trip reference\",\n                             \"transaction reference\", \"rate reference\", \"cap reference\",\n                             \"ledger reference\", \"decision reference\", \"activity reference\",\n                             \"cancellation activity reference\"} for c in row if c.value is not None)), None)\n        if table_row is None:\n            table_row = header_row\n        headers = [cell.value for cell in rows[table_row]]\n        records: list[dict[str, Any]] = []\n        for row_idx, row in enumerate(rows[table_row + 1:], table_row + 2):\n            if not any(cell.value is not None for cell in row):\n                continue\n            values = {}\n            for col_idx, cell in enumerate(row):\n                if col_idx >= len(headers) or headers[col_idx] is None or cell.value is None:\n                    continue\n                header = str(headers[col_idx])\n                values[header] = {\n                    \"value\": _scalar(cell.value),\n                    \"source_text\": str(cell.value),\n                    \"number_format\": cell.number_format,\n                    \"data_type\": cell.data_type,\n                    \"cell\": cell.coordinate,\n                }\n            if values:\n                first = next(iter(values.values()))\n                # The complete row map, including exact sheet/row references,\n                # is retained even when a workbook row carries multiple IDs.\n                records.append({\n                    \"source_id\": source_id,\n                    \"source_sha256\": sha256,\n                    \"locator\": f\"tab {sheet.title!r}, row {row_idx}\",\n                    \"row\": row_idx,\n                    \"values\": values,\n                })\n        sheets.append({\n            \"source_id\": source_id,\n            \"source_sha256\": sha256,\n            \"name\": sheet.title,\n            \"header_row\": table_row + 1,\n            \"headers\": [str(h) if h is not None else None for h in headers],\n            \"records\": records,\n        })\n    workbook.close()\n    return sheets\n\n\ndef _receipt_records(pages: list[dict[str, Any]]) -> list[dict[str, Any]]:\n    records = []\n    for page in pages:\n        if \"receipt\" not in page[\"record_types\"]:\n            continue\n        text = page[\"text\"]\n        starts = list(re.finditer(r\"^\\s*Receipt reference:\\s*(.+)$\", text, re.M))\n        for i, match in enumerate(starts):\n            end = starts[i + 1].start() if i + 1 < len(starts) else len(text)\n            block = text[match.start():end].strip()\n            records.append({\n                \"source_id\": page[\"source_id\"],\n                \"source_sha256\": page[\"source_sha256\"],\n                \"locator\": f\"{page['locator']}, receipt {i + 1}\",\n                \"receipt_id\": match.group(1).strip(),\n                \"fields\": _extract_labels(block),\n                \"text\": block,\n            })\n    return records\n\n\ndef _value(row: dict[str, Any], key: str) -> Any:\n    return row.get(\"values\", {}).get(key, {}).get(\"value\")\n\n\ndef parse_retained_run(run_dir: Path, *, output_path: Path | None = None) -> dict[str, Any]:\n    \"\"\"Parse all readable retained sources after verifying their manifest hashes.\"\"\"\n    errors = verify_source_manifest(run_dir)\n    if errors:\n        raise ValueError(\"Cannot parse unverified retained sources: \" + \"; \".join(errors))\n    manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n    read = {row[\"source_id\"]: row for row in manifest[\"files\"] if row[\"status\"] == \"read\"}\n    parsed_sources: list[dict[str, Any]] = []\n    pages: list[dict[str, Any]] = []\n    sheets: list[dict[str, Any]] = []\n    for source_id, meta in read.items():\n        source_path = run_dir / meta[\"path\"]\n        if hashlib.sha256(source_path.read_bytes()).hexdigest() != meta[\"sha256\"]:\n            raise ValueError(f\"Retained-source hash changed during parse: {source_id}\")\n        if source_path.suffix.lower() == \".pdf\":\n            extracted = _pdf_pages(source_path, source_id, meta[\"sha256\"])\n            pages.extend(extracted)\n            parsed_sources.append({\"source_id\": source_id, \"kind\": \"pdf\", \"page_count\": len(extracted)})\n        elif source_path.suffix.lower() == \".xlsx\":\n            extracted_sheets = _workbook_sheets(source_path, source_id, meta[\"sha256\"])\n            sheets.extend(extracted_sheets)\n            parsed_sources.append({\"source_id\": source_id, \"kind\": \"xlsx\", \"sheet_count\": len(extracted_sheets)})\n\n    # Preserve separate record categories. These are source transcriptions,\n    # not assessments; trip and permit revisions remain independent fields.\n    claim_revisions = [p for p in pages if p[\"claim_id\"]]\n    receipt_records = _receipt_records(pages)\n    tab_by_name = {sheet[\"name\"]: sheet for sheet in sheets}\n    trips = tab_by_name.get(\"Trips\", {}).get(\"records\", [])\n    decisions = tab_by_name.get(\"Review ledger\", {}).get(\"records\", [])\n    finance = tab_by_name.get(\"Finance activity\", {}).get(\"records\", [])\n    cancellations = tab_by_name.get(\"Travel cancellations\", {}).get(\"records\", [])\n    permits = []\n    for row in trips:\n        permit_id = _value(row, \"Permit reference\")\n        if permit_id:\n            permits.append({\n                \"permit_id\": permit_id,\n                \"trip_id\": _value(row, \"Trip reference\"),\n                \"trip_revision\": _value(row, \"Trip revision\"),\n                \"permit_revision\": _value(row, \"Permit revision\"),\n                \"source_id\": row[\"source_id\"], \"source_sha256\": row[\"source_sha256\"],\n                \"locator\": row[\"locator\"], \"source_record\": row[\"values\"],\n            })\n\n    batch_ids: set[int] = set()\n    for page in pages:\n        for field in page[\"fields\"]:\n            if field[\"label\"].strip().lower() == \"arrival batch\":\n                try: batch_ids.add(int(field[\"value\"]))\n                except ValueError: pass\n    for record in decisions + finance + cancellations:\n        batch = _value(record, \"Arrival batch\")\n        if batch is not None:\n            batch_ids.add(int(batch))\n\n    batch_contents: dict[str, dict[str, int]] = {str(batch): {} for batch in sorted(batch_ids)}\n    def count_batch(category: str, records: list[dict[str, Any]], getter) -> None:\n        for record in records:\n            value = getter(record)\n            if value is None or value == \"\":\n                continue\n            key = str(int(value))\n            bucket = batch_contents.setdefault(key, {})\n            bucket[category] = bucket.get(category, 0) + 1\n    count_batch(\"claim_revisions\", claim_revisions,\n                lambda row: next((f[\"value\"] for f in row[\"fields\"] if f[\"label\"].strip().lower() == \"arrival batch\"), None))\n    count_batch(\"decisions\", decisions, lambda row: _value(row, \"Arrival batch\"))\n    count_batch(\"finance_events\", finance, lambda row: _value(row, \"Arrival batch\"))\n    count_batch(\"cancellation_activities\", cancellations, lambda row: _value(row, \"Arrival batch\"))\n\n    result = {\n        \"schema_version\": RECORD_SCHEMA,\n        \"run_id\": manifest[\"run_id\"],\n        \"source_manifest\": {\"path\": \"sources.json\", \"sha256\": hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()},\n        \"case_clock\": manifest[\"case_clock\"],\n        \"case_clock_state\": \"supplied\" if manifest[\"case_clock\"] else \"not_in_accessible_retained_sources\",\n        \"case_clock_issue\": None if manifest[\"case_clock\"] else {\n            \"reason\": \"No supplied scenario case-clock value was present in the retained native PDFs, workbook, or interview record used for this run.\",\n            \"owner\": \"Exercise facilitator\",\n            \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n        },\n        \"arrival_batches\": sorted(batch_ids),\n        \"arrival_batch_contents\": batch_contents,\n        \"missing_sources\": [\n            {\"source_id\": row[\"source_id\"], \"url\": row[\"url\"], \"locator\": row[\"locator\"],\n             \"error\": row[\"error\"], \"missing_scope\": row.get(\"missing_scope\", [])}\n            for row in manifest[\"files\"] if row[\"status\"] != \"read\"\n        ],\n        \"source_inventory\": parsed_sources,\n        \"pdf_pages\": pages,\n        \"workbook_sheets\": sheets,\n        \"records\": {\n            \"claim_revisions\": claim_revisions,\n            \"trips\": trips,\n            \"permits\": permits,\n            \"receipts\": receipt_records,\n            \"decisions\": decisions,\n            \"finance_events\": finance,\n            \"cancellation_activities\": cancellations,\n        },\n        \"processing_boundary\": {\n            \"policy_dependent_conclusions\": \"unresolved\",\n            \"reason\": \"Native reimbursement policy content is unavailable; parsed source values are not eligibility, entitlement, approval-readiness, or closure decisions.\",\n            \"owner\": \"Travel Administration Lead / facilitator for source access\",\n            \"next_action\": \"Provide an authorized native export or enable read access to the original Notion policy, then perform a fresh native read.\",\n        },\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\",\n                \"subject_type\": \"scenario\",\n                \"subject_id\": \"arrival-batch-clock\",\n                \"revision\": None,\n                \"affected_scope\": \"all batch cutoff decisions and arrival-state consumption\",\n                \"reason\": \"The task calls for a supplied case clock, but no explicit scenario date, time, or timezone was confirmed in the original task text or complete stakeholder interview export.\",\n                \"owner\": \"Exercise facilitator\",\n                \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n                \"evidence_needed\": \"Explicit scenario date, time, and timezone from the facilitator or original task material.\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\",\n                \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\",\n                \"revision\": None,\n                \"affected_scope\": \"eligibility, entitlement, approval readiness, reimbursement caps and final closure\",\n                \"reason\": \"The fresh native Notion attempt returned a generic HTML shell; earlier API access returned HTTP 401. No policy content was retained.\",\n                \"owner\": \"Travel Administration Lead / exercise facilitator\",\n                \"next_action\": \"Provide an authorized native export or enable read access to the original Notion page, then perform a fresh native read.\",\n                \"evidence_needed\": \"Complete policy content from the original Notion page or authorized native export, with observed URL/version and retained-content hash.\",\n            },\n        ],\n    }\n    destination = output_path or (run_dir / OUTPUT_NAME)\n    if destination.exists():\n        raise FileExistsError(f\"Refusing to overwrite parsed output: {destination}\")\n    destination.parent.mkdir(parents=True, exist_ok=True)\n    destination.write_text(json.dumps(result, indent=2, ensure_ascii=False) + \"\\n\", encoding=\"utf-8\")\n    return result\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Travel claim batch state\",\n  \"type\": \"object\",\n  \"required\": [\n    \"schema_version\",\n    \"run_id\",\n    \"batch_id\",\n    \"predecessor\",\n    \"source_binding\",\n    \"claims\",\n    \"requests\",\n    \"travel_cancellations\",\n    \"admitted_event_ids\",\n    \"issues\"\n  ],\n  \"properties\": {\n    \"schema_version\": {\n      \"const\": \"travel-claim-snapshot/2\"\n    },\n    \"run_id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"batch_id\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"predecessor\": {\n      \"anyOf\": [\n        {\n          \"type\": \"null\"\n        },\n        {\n          \"type\": \"object\",\n          \"required\": [\n            \"path\",\n            \"sha256\"\n          ],\n          \"properties\": {\n            \"path\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"sha256\": {\n              \"type\": \"string\",\n              \"pattern\": \"^[0-9a-f]{64}$\"\n            }\n          }\n        }\n      ]\n    },\n    \"source_binding\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"path\",\n        \"sha256\"\n      ],\n      \"properties\": {\n        \"path\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"sha256\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[0-9a-f]{64}$\"\n        }\n      }\n    },\n    \"claims\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"claim_id\",\n          \"revision\",\n          \"trip_id\",\n          \"trip_revision\",\n          \"status\",\n          \"lines\",\n          \"allowed_cents\",\n          \"paid_cents\",\n          \"balance_cents\",\n          \"decision_ids\",\n          \"next_owner\",\n          \"reason\"\n        ],\n        \"properties\": {\n          \"claim_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"trip_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"status\": {\n            \"enum\": [\n              \"pending\",\n              \"held\",\n              \"ready\",\n              \"closed-reimbursed\",\n              \"closed-no-payment\",\n              \"rejected\",\n              \"withdrawn\"\n            ]\n          },\n          \"lines\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"required\": [\n                \"cost_id\",\n                \"source_ids\",\n                \"status\",\n                \"allowed_cents\",\n                \"reason\"\n              ],\n              \"properties\": {\n                \"cost_id\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"source_ids\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"string\",\n                    \"minLength\": 1\n                  },\n                  \"uniqueItems\": true\n                },\n                \"status\": {\n                  \"enum\": [\n                    \"supported\",\n                    \"excluded\",\n                    \"unresolved\"\n                  ]\n                },\n                \"allowed_cents\": {\n                  \"type\": [\n                    \"integer\",\n                    \"null\"\n                  ],\n                  \"minimum\": 0\n                },\n                \"reason\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          },\n          \"allowed_cents\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"minimum\": 0\n          },\n          \"paid_cents\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"balance_cents\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ]\n          },\n          \"decision_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"next_owner\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"trip_revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"description\": \"Exact trip revision from the supplied trip source, independent of claim revision.\"\n          },\n          \"finance_evidence\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"recorded_obligation\",\n              \"recorded_ledger_balance_cents\",\n              \"basis\",\n              \"current_revision_authority_confirmed\",\n              \"closure_authority_confirmed\"\n            ],\n            \"properties\": {\n              \"recorded_obligation\": {\n                \"type\": [\n                  \"object\",\n                  \"null\"\n                ]\n              },\n              \"recorded_ledger_balance_cents\": {\n                \"type\": [\n                  \"integer\",\n                  \"null\"\n                ]\n              },\n              \"basis\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"current_revision_authority_confirmed\": {\n                \"const\": false\n              },\n              \"closure_authority_confirmed\": {\n                \"const\": false\n              }\n            }\n          }\n        }\n      }\n    },\n    \"requests\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"request_id\",\n          \"claim_id\",\n          \"revision\",\n          \"amount_cents\",\n          \"payee\",\n          \"currency\",\n          \"status\",\n          \"decision_ids\"\n        ],\n        \"properties\": {\n          \"request_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"claim_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"amount_cents\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          },\n          \"payee\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"currency\": {\n            \"const\": \"EUR\"\n          },\n          \"status\": {\n            \"enum\": [\n              \"proposed\",\n              \"accepted\",\n              \"dispatched\",\n              \"cancel-pending\",\n              \"cancelled\",\n              \"settled\",\n              \"held\"\n            ]\n          },\n          \"decision_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          }\n        }\n      }\n    },\n    \"admitted_event_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"uniqueItems\": true,\n      \"description\": \"Admitted Finance activity IDs only. Travel cancellation activity IDs belong exclusively in travel_cancellations[].admitted_cancellation_event_ids; neither kind may invent the other kind of effect.\"\n    },\n    \"issues\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"record_id\",\n          \"reason\",\n          \"owner\",\n          \"resolution_needed\"\n        ],\n        \"properties\": {\n          \"record_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"owner\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"resolution_needed\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n    \"travel_cancellations\": {\n      \"type\": \"array\",\n      \"description\": \"One current row per valid observed cancellation_id, including processes without any claim. Confirmation and financial resolution are separate facts. Invalid orphan deliveries remain in issues and retained sources until a valid initiation establishes a process.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"cancellation_id\",\n          \"target_type\",\n          \"trip_id\",\n          \"trip_revision\",\n          \"permit_id\",\n          \"permit_revision\",\n          \"status\",\n          \"admitted_cancellation_event_ids\",\n          \"requested_at\",\n          \"confirmed_at\",\n          \"effective_at\",\n          \"affected_claim_ids\",\n          \"original_request_ids\",\n          \"financial_status\",\n          \"next_owner\",\n          \"reason\",\n          \"issue_record_ids\"\n        ],\n        \"properties\": {\n          \"cancellation_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"target_type\": {\n            \"enum\": [\n              \"trip\",\n              \"permit\"\n            ]\n          },\n          \"trip_id\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"trip_revision\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"permit_id\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"minLength\": 1\n          },\n          \"permit_revision\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ],\n            \"minimum\": 1\n          },\n          \"status\": {\n            \"enum\": [\n              \"requested\",\n              \"confirmed\"\n            ]\n          },\n          \"admitted_cancellation_event_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"description\": \"Only lawfully admitted Travel cancellations activity IDs, retaining initiation/confirmation identity and authority through the bound source records.\"\n          },\n          \"requested_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"confirmed_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"effective_at\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"format\": \"date-time\"\n          },\n          \"affected_claim_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"original_request_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          },\n          \"financial_status\": {\n            \"enum\": [\n              \"no-financial-effect\",\n              \"unresolved\",\n              \"resolved\"\n            ]\n          },\n          \"next_owner\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"minLength\": 1\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"issue_record_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\",\n              \"minLength\": 1\n            },\n            \"uniqueItems\": true\n          }\n        },\n        \"allOf\": [\n          {\n            \"if\": {\n              \"properties\": {\n                \"status\": {\n                  \"const\": \"requested\"\n                }\n              }\n            },\n            \"then\": {\n              \"properties\": {\n                \"confirmed_at\": {\n                  \"type\": \"null\"\n                },\n                \"effective_at\": {\n                  \"type\": \"null\"\n                },\n                \"next_owner\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            },\n            \"else\": {\n              \"properties\": {\n                \"confirmed_at\": {\n                  \"type\": \"string\",\n                  \"format\": \"date-time\"\n                },\n                \"effective_at\": {\n                  \"type\": \"string\",\n                  \"format\": \"date-time\"\n                }\n              }\n            }\n          },\n          {\n            \"if\": {\n              \"properties\": {\n                \"permit_id\": {\n                  \"type\": \"null\"\n                }\n              }\n            },\n            \"then\": {\n              \"properties\": {\n                \"permit_revision\": {\n                  \"type\": \"null\"\n                },\n                \"target_type\": {\n                  \"const\": \"trip\"\n                }\n              }\n            },\n            \"else\": {\n              \"properties\": {\n                \"permit_revision\": {\n                  \"type\": \"integer\",\n                  \"minimum\": 1\n                }\n              }\n            }\n          }\n        ]\n      }\n    }\n  }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":59381630},"formatted_output":"Warning: truncated output (original token count: 20724)\nTotal output lines: 1870\n\n\"\"\"Arrival-ordered, policy-neutral integration of Project D records.\n\nThis module prepares schema-shaped batch state but never seals snapshots,\ninfers eligibility, applies review decisions, or authorizes obligations.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nfrom copy import deepcopy\nfrom typing import Any\n\nfrom .finance import reconcile_finance_events\nfrom .outputs import add_repair_item, new_repair_queue, update_repair_item\nfrom .workflow import (\n    build_revision_history,\n    match_decisions_to_subjects,\n    reduce_cancellation_activities,\n    row_values,\n)\n\n\n_REVALIDATION_AREAS = (\n    (\"expense-evidence\", \"recheck expense evidence against the corrected claim revision\", \"employee\"),\n    (\"calculations\", \"recalculate and verify amounts for the corrected claim revision\", \"Travel Administration Lead\"),\n    (\"trip-permit\", \"recheck trip and permit identity and revision consistency\", \"Travel Administration Lead\"),\n    (\"approvals\", \"obtain current-revision decisions; prior decisions remain historical only\", \"Travel Administration Lead\"),\n    (\"finance-authorization\", \"revalidate Finance authorization for the corrected claim revision\", \"Finance\"),\n)\n\n\ndef _page_values(record: dict[str, Any]) -> dict[str, Any]:\n    return {field.get(\"label\", \"\").strip(): field.get(\"value\") for field in record.get(\"fields\", [])}\n\n\ndef _page_batch(record: dict[str, Any]) -> int | None:\n    value = _page_values(record).get(\"Arrival batch\")\n    return _as_batch(value)\n\n\ndef _as_batch(value: Any) -> int | None:\n    if isinstance(value, bool) or value is None:\n        return None\n    try:\n        number = int(value)\n    except (ValueError, TypeError, OverflowError):\n        return None\n    return number if number > 0 and float(value) == number else None\n\n\ndef _ref(record: dict[str, Any]) -> dict[str, Any]:\n    return {key: record.get(key) for key in (\"source_id\", \"source_sha256\", \"locator\")}\n\n\ndef _ref_text(reference: dict[str, Any]) -> str:\n    return f\"{reference.get('source_id')}@{reference.get('source_sha256')}#{reference.get('locator')}\"\n\n\ndef _stamp(value: Any) -> str | None:\n    \"\"\"Project an explicitly UTC source field into the schema's date-time form.\"\"\"\n    if not isinstance(value, str) or not value:\n        return None\n    if value.endswith(\"Z\") or \"+\" in value[10:] or \"-\" in value[10:]:\n        return value\n    return f\"{value}Z\"\n\n\ndef _delta(parsed: dict[str, Any], arrival_batch: int) -> dict[str, list[dict[str, Any]]]:\n    records = parsed.get(\"records\", {})\n    selected = {\n        \"claim_revisions\": [row for row in records.get(\"claim_revisions\", []) if _page_batch(row) == arrival_batch],\n        \"decisions\": [row for row in records.get(\"decisions\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"finance_events\": [row for row in records.get(\"finance_events\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n        \"cancellation_activities\": [row for row in records.get(\"cancellation_activities\", []) if _as_batch(row_values(row).get(\"Arrival batch\")) == arrival_batch],\n    }\n    selected[\"claim_revisions\"].sort(key=lambda row: (row.get(\"page\", 0), _ref(row).get(\"locator\") or \"\"))\n    for kind in (\"decisions\", \"finance_events\", \"cancellation_activities\"):\n        selected[kind].sort(key=lambda row: (row.get(\"row\", 0), _ref(row).get(\"locator\") or \"\"))\n    return selected\n\n\ndef _digest(value: Any) -> str:\n    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), default=str).encode(\"utf-8\")\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef _domain_seed() -> dict[str, Any]:\n    return {\n        \"processed_batches\": [],\n        \"batch_input_hashes\": {},\n        \"claim_records\": [],\n        \"decision_records\": [],\n        \"finance_records\": [],\n        \"cancellation_records\": [],\n        \"revision_history\": None,\n        \"decision_history\": [],\n        \"finance_reconciliations\": {},\n        \"authorized_obligations\": {},\n        \"source_classifications\": {},\n        \"cancellation_state\": {},\n        \"material_corrections\": [],\n        \"repair_queue\": new_repair_queue(),\n        \"policy_clock_blockers\": [],\n        \"structural_blockers\": [],\n        \"projection_issues\": [],\n    }\n\n\ndef _issue_from_item(item: dict[str, Any]) -> dict[str, Any]:\n    return {\n        \"record_id\": item[\"item_id\"],\n        \"reason\": item[\"missing_or_return_reason\"],\n        \"owner\": item[\"owner\"],\n        \"resolution_needed\": item[\"next_action\"],\n        \"subject_type\": item[\"subject_type\"],\n        \"subject_id\": item[\"subject_id\"],\n        \"revision\": item[\"revision\"],\n        \"source_refs\": item[\"source_refs\"],\n        \"run_id\": item[\"run_id\"],\n        \"batch_id\": item[\"batch_id\"],\n    }\n\n\ndef _open_issue_for_subject(\n    queue: dict[str, Any], *, item_id: str, subject_type: str, subject_id: str,\n    revision: int, refs: list[str], reason: str, owner: str, next_action: str,\n    run_id: str, batch_id: str,\n) -> None:\n    if item_id not in queue[\"items\"]:\n        add_repair_item(\n            queue, item_id=item_id, subject_type=subject_type, subject_id=subject_id,\n            revision=revision, source_refs=refs, missing_or_return_reason=reason,\n            owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n        )\n\n\ndef _sync_finance_repairs(domain: dict[str, Any], reconciliations: dict[str, Any], *, run_id: str, batch_id: str) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, result in reconciliations.items():\n        for issue in result[\"repair_issues\"]:\n            item_id = f\"finance:{issue['record_id']}\"\n            refs = [_ref_text(ref) for ref in issue.get(\"source_refs\", []) if isinstance(ref, dict)]\n            if item_id in queue[\"items\"]:\n                item = queue[\"items\"][item_id]\n                changes = {key: value for key, value in {\n                    \"source_refs\": refs,\n                    \"missing_or_return_reason\": issue[\"missing_or_return_reason\"],\n                    \"next_action\": issue[\"next_action\"],\n                }.items() if item[key] != value}\n                if changes:\n                    update_repair_item(queue, item_id=item_id,\n                                       update_id=f\"finance-evidence:{item_id}:{batch_id}\",\n                                       run_id=run_id, batch_id=batch_id, **changes)\n                continue\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=result[\"claim_revision\"], refs=refs,\n                reason=issue.get(\"missing_or_return_reason\", issue.get(\"reason\", \"Finance evidence unresolved\")),\n                owner=issue[\"owner\"],\n                next_action=issue.get(\"next_action\", \"Finance to resolve the identified item\"),\n                run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _subject_claim_revisions(history: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return history.get(\"claim\", {})\n\n\ndef _material_correction_tasks(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n    previous_revisions: dict[str, int],\n) -> None:\n    queue = domain[\"repair_queue\"]\n    for claim_id, claim in _subject_claim_revisions(history).items():\n        revision = claim[\"current_revision\"]\n        old_revision = previous_revisions.get(claim_id)\n        if old_revision is None or revision <= old_revision:\n            continue\n        current = next(row for row in reversed(claim[\"revisions\"]) if row[\"revision\"] == revision)\n        prior = [row for row in claim[\"revisions\"] if row[\"revision\"] == old_revision]\n        refs = [_ref_text(row[\"source_ref\"]) for row in prior + [current]]\n        old_decisions = [\n            decision for decision in domain[\"decision_history\"]\n            if decision.get(\"subject_type\") == \"claim\" and decision.get(\"subject_id\") == claim_id\n            and decision.get(\"revision\") == old_revision\n        ]\n        refs.extend(_ref_text(row[\"decision_source_ref\"]) for row in old_decisions)\n        affected_finance = [row for row in domain[\"finance_records\"] if row_values(row).get(\"Claim reference\") == claim_id]\n        refs.extend(_ref_text(_ref(row)) for row in affected_finance)\n        refs = list(dict.fromkeys(refs))\n        invalidated = {\n            \"claim_id\": claim_id,\n            \"from_revision\": old_revision,\n            \"to_revision\": revision,\n            \"invalidated_decision_ids\": [row.get(\"decision_id\") for row in old_decisions if row.get(\"decision_id\")],\n            \"preserved_finance_event_ids\": [row_values(row).get(\"Activity reference\") for row in affected_finance if row_values(row).get(\"Activity reference\")],\n            \"revalidate\": [area for area, _, _ in _REVALIDATION_AREAS],\n            \"source_refs\": [deepcopy(row[\"source_ref\"]) for row in prior + [current]],\n            \"arrival_batch\": batch_id,\n        }\n        domain[\"material_corrections\"].append(invalidated)\n        for area, next_action, owner_role in _REVALIDATION_AREAS:\n            if owner_role == \"employee\":\n                owner = str(current[\"record\"].get(\"employee\") or _page_values(current[\"record\"]).get(\"Employee\") or \"Employee\")\n            elif owner_role == \"Finance\":\n                finance_owners = [row_values(row).get(\"Finance officer\") for row in affected_finance]\n                owner = str(next((value for value in reversed(finance_owners) if value), \"Finance\"))\n            else:\n                owner = owner_role\n            item_id = f\"correction:{claim_id}:r{revision}:{area}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=\"claim\", subject_id=claim_id,\n                revision=revision, refs=refs,\n                reason=f\"Material correction from revision {old_revision} to {revision} requires dependency revalidation: {area}\",\n                owner=owner, next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n\n\ndef _cancellation_rows(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> list[dict[str, Any]]:\n    reduced = reduce_cancellation_activities(domain[\"cancellation_records\"])\n    domain[\"cancellation_state\"] = reduced\n    raw_by_id = {\n        row_values(record).get(\"Cancellation activity reference\"): record\n        for record in domain[\"cancellation_records\"]\n    }\n    claim_revisions = _subject_claim_revisions(history)\n    snapshot_rows = []\n    for cancellation_id, process in sorted(reduced[\"processes\"].items()):\n        target = process[\"target\"]\n        target_revision = target.get(\"revision\")\n        if (target.get(\"subject_type\") not in {\"trip\", \"permit\"} or not target.get(\"subject_id\")\n                or isinstance(target_revision, bool) or not isinstance(target_revision, int) or target_revision < 1):\n            domain[\"projection_issues\"].append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation process lacks a supported target identity and revision; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation target and revision in the native workbook\",\n            })\n            continue\n        record_order = process[\"activity_ids\"]\n        request_id = record_order[0]\n        request = raw_by_id[request_id]\n        request_values = row_values(request)\n        confirmation = next((raw_by_id[event_id] for event_id in record_order\n                             if row_values(raw_by_id[event_id]).get(\"Action\") == \"confirmed\"), None)\n        confirmation_values = row_values(confirmation) if confirmation else {}\n        trip_id = request_values.get(\"Trip reference\")\n        trip_revision = _as_batch(request_values.get(\"Trip revision\"))\n        permit_id = request_values.get(\"Permit reference\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = request_values.get(\"Permit revision\") if target[\"subject_type\"] == \"permit\" else None\n        permit_revision = _as_batch(permit_revision) if permit_revision is not None else None\n        affected = []\n        for claim_id, claim in claim_revisions.items():\n            for claim_rev in claim[\"revisions\"]:\n                if target[\"subject_type\"] == \"trip\":\n                    matches = claim_rev.get(\"trip_id\") == target[\"subject_id\"] and claim_rev.get(\"trip_revision\") == target[\"revision\"]\n                else:\n                    trip_index = history.get(\"trip\", {}).get(str(claim_rev.get(\"trip_id\")), {})\n                    matches = any(\n                        trip_rev.get(\"revision\") == claim_rev.get(\"trip_revision\")\n                        and trip_rev.get(\"permit_id\") == target[\"subject_id\"]\n                        and trip_rev.get(\"permit_revision\") == target[\"revision\"]\n                        for trip_rev in trip_index.get(\"revisions\", [])\n                    )\n                if matches:\n                    affected.append(claim_id)\n                    break\n        affected = sorted(set(affected))\n        task_id = f\"cancellation-financial:{cancellation_id}\"\n        refs = [_ref_text(_ref(raw_by_id[event_id])) for event_id in record_order]\n        reason = \"Finance effect of the independent travel cancellation has not been resolved from an authorized Finance record\"\n        next_action = \"Finance to record whether this cancellation affects an accepted obligation, transfer, payment, or refund\"\n        queue = domain[\"repair_queue\"]\n        if task_id not in queue[\"items\"]:\n            _open_issue_for_subject(\n                queue, item_id=task_id,\n                subject_type=target[\"subject_type\"], subject_id=str(target[\"subject_id\"]),\n                revision=target_revision, refs=refs, reason=reason,\n                owner=\"Finance\", next_action=next_action, run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            item = queue[\"items\"][task_id]\n            additions = list(dict.fromkeys(item[\"source_refs\"] + refs))\n            changes = {}\n            if additions != item[\"source_refs\"]:\n                changes[\"source_refs\"] = additions\n            if process[\"state\"] == \"confirmed\" and item[\"next_action\"] != next_action:\n                changes[\"next_action\"] = next_action\n            if changes:\n                update_repair_item(\n                    queue, item_id=task_id,\n                    update_id=f\"cancellation-update:{cancellation_id}:batch-{batch_id}\",\n                    run_id=run_id, batch_id=batch_id, **changes,\n                )\n        cancellation_issue = task_id\n        requested_at = _stamp(request_values.get(\"Activity time (UTC)\"))\n        if not trip_id or not trip_revision or not requested_at:\n            domain.setdefault(\"projection_issues\", []).append({\n                \"record_id\": f\"cancellation-projection:{cancellation_id}\",\n                \"reason\": \"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"verify the cancellation subject and original UTC request time from the retained workbook\",\n            })\n            continue\n        snapshot_rows.append({\n            \"cancellation_id\": cancellation_id,\n            \"target_type\": target[\"subject_type\"],\n            \"trip_id\": str(trip_id),\n            \"trip_revision\": trip_revision,\n            \"permit_id\": str(permit_id) if permit_id else None,\n            \"permit_revision\": int(permit_revision) if permit_revision is not None else None,\n            \"status\": \"confirmed\" if process[\"state\"] == \"confirmed\" else \"requested\",\n            \"admitted_cancellation_event_ids\": list(dict.fromkeys(record_order)),\n            \"requested_at\": requested_at,\n            \"confirmed_at\": _stamp(confirmation_values.get(\"Activity time (UTC)\")) if confirmation else None,\n            \"effective_at\": _stamp(confirmation_values.get(\"Effective time (UTC)\")) if confirmation else None,\n            \"affected_claim_ids\": affected,\n            \"original_request_ids\": [],\n            \"financial_status\": \"unresolved\",\n            \"next_owner\": \"Finance\",\n            \"reason\": str(request_values.get(\"Business reason\") or \"Travel cancellation recorded; financial effect remains unresolved\"),\n            \"issue_record_ids\": [cancellation_issue],\n        })\n    return snapshot_rows\n\n\ndef _sync_decision_and_revision_issues(\n    domain: dict[str, Any], *, history: dict[str, Any], run_id: str, batch_id: str,\n) -> None:\n    queue = domain[\"repair_queue\"]\n    blockers = []\n    for conflict in history.get(\"issues\", {}).get(\"repeated_subject_revisions\", []):\n        kind = conflict[\"kind\"]\n        subject_id = conflict[\"subject_id\"]\n        revision = conflict[\"revision\"]\n        refs = [_ref_text(ref) for ref in conflict.get(\"occurrences\", [])]\n        item_id = f\"revision-conflict:{kind}:{subject_id}:r{revision}\"\n        _open_issue_for_subject(\n            queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n            revision=revision, refs=refs,\n            reason=f\"multiple retained source records use {kind} {subject_id} revision {revision}; their business content requires review\",\n            owner=\"Travel Administration Lead\", next_action=\"compare the source occurrences and establish the supported revision record\",\n            run_id=run_id, batch_id=batch_id,\n        )\n    for malformed in history.get(\"issues\", {}).get(\"malformed_revision_records\", []):\n        blockers.append({\n            \"record_id\": f\"malformed-revision:{_digest(malformed)[:16]}\",\n            \"reason\": malformed[\"reason\"],\n            \"owner\": \"Travel Administration Lead\",\n            \"resolution_needed\": \"identify the subject and revision from the native source record\",\n            \"source_ref\": malformed.get(\"source_ref\"),\n        })\n    for decision in domain[\"decision_history\"]:\n        if decision[\"structural_match\"] in {\"revision_match_current\", \"revision_match_historical\"}:\n            continue\n        kind, subject_id, revision = decision.get(\"subject_type\"), decision.get(\"subject_id\"), decision.get(\"revision\")\n        decision_id = decision.get(\"decision_id\") or _digest(decision)[:16]\n        if kind in {\"claim\", \"trip\", \"permit\"} and isinstance(subject_id, str) and isinstance(revision, int) and revision > 0:\n            item_id = f\"decision-match:{decision_id}\"\n            _open_issue_for_subject(\n                queue, item_id=item_id, subject_type=kind, subject_id=subject_id,\n                revision=revision, refs=[_ref_text(decision[\"decision_source_ref\"])],\n                reason=f\"recorded decision {decision_id} does not structurally match an available {kind} revision ({decision['structural_match']})\",\n                owner=\"Travel Administration Lead\", next_action=\"resolve the decision subject or revision against the native review ledger\",\n                run_id=run_id, batch_id=batch_id,\n            )\n        else:\n            blockers.append({\n                \"record_id\": f\"decision-match:{decision_id}\",\n                \"reason\": f\"recorded decision has no traceable supported subject/revision ({decision['structural_match']})\",\n                \"owner\": \"Travel Administration Lead\",\n                \"resolution_needed\": \"identify its subject and revision in the native review ledger\",\n                \"source_ref\": decision[\"decision_source_ref\"],\n            })\n    domain[\"structural_blockers\"] = blockers\n\n\ndef integrate_arrival_batch(\n    parsed: dict[str, Any],\n    *,\n    arrival_batch: int,\n    run_id: str,\n    batch_id: str,\n    source_binding: dict[str, str],\n    predecessor: dict[str, str] | None = None,\n    prior_result: dict[str, Any] | None = None,\n    authorized_obligations: dict[str, dict[str, Any]] | None = None,\n    source_classifications: dict[str, str] | None = None,\n) -> dict[str, A…10724 tokens truncated…k_sheets(source_path, source_id, meta[\"sha256\"])\n            sheets.extend(extracted_sheets)\n            parsed_sources.append({\"source_id\": source_id, \"kind\": \"xlsx\", \"sheet_count\": len(extracted_sheets)})\n\n    # Preserve separate record categories