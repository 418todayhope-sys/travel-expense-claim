ry:\n        with schema_path.open(encoding=\"utf-8\") as schema_file:\n            schema = json.load(schema_file)\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Could not read schema {schema_path}: {exc}\"]\n\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    errors = sorted(validator.iter_errors(snapshot), key=lambda error: list(map(str, error.absolute_path)))\n    return [\n        f\"{'.'.join(map(str, error.absolute_path)) or '<root>'}: {error.message}\"\n        for error in errors\n    ]\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"travel-claim\")\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    validate = commands.add_parser(\n        \"validate-snapshot\", help=\"validate a JSON snapshot against snapshot.schema.json\"\n    )\n    validate.add_argument(\"snapshot\", type=Path, help=\"path to the snapshot JSON file\")\n    validate.add_argument(\n        \"--schema\", type=Path, default=_default_schema_path(), help=\"schema JSON path\"\n    )\n\n    capture = commands.add_parser(\"capture-sources\", help=\"freshly retrieve and retain all five native sources\")\n    capture.add_argument(\"run_id\", help=\"new, stable run identifier\")\n    capture.add_argument(\"run_dir\", type=Path, help=\"new artifacts/runs/<run-id> directory\")\n    capture.add_argument(\"--case-clock\", help=\"supplied scenario clock; omit only for source-only capture\")\n\n    verify_sources = commands.add_parser(\"verify-sources\", help=\"verify source manifest and retained-byte hashes\")\n    verify_sources.add_argument(\"run_dir\", type=Path)\n\n    parse_sources = commands.add_parser(\"parse-retained\", help=\"transcribe hash-verified PDFs and workbook into traceable records\")\n    parse_sources.add_argument(\"run_dir\", type=Path)\n    parse_sources.add_argument(\"--output\", type=Path, help=\"optional new output path; defaults to parsed-records.json in the run\")\n\n    seal = commands.add_parser(\"seal-batch\", help=\"schema-check and immutably seal one batch state JSON\")\n    seal.add_argument(\"run_dir\", type=Path)\n    seal.add_argument(\"batch_id\")\n    seal.add_argument(\"state\", type=Path, help=\"JSON object containing claims, requests, cancellations, events, issues\")\n    seal.add_argument(\"--run-id\", required=True)\n    seal.add_argument(\"--predecessor\", type=Path)\n    seal.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    verify_batch = commands.add_parser(\"verify-batch\", help=\"verify schema and source/predecessor bindings\")\n    verify_batch.add_argument(\"run_dir\", type=Path)\n    verify_batch.add_argument(\"snapshot\", type=Path)\n    verify_batch.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    csv_cmd = commands.add_parser(\"write-claims-csv\", help=\"write the exact current-claim CSV contract\")\n    csv_cmd.add_argument(\"claims_json\", type=Path, help=\"JSON array of current claim summary objects\")\n    csv_cmd.add_argument(\"output\", type=Path)\n\n    replay = commands.add_parser(\n        \"offline-replay\",\n        help=\"replay verified retained records in arrival order without fresh native-source reads\",\n    )\n    replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n    replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    if args.command == \"validate-snapshot\":\n        errors = validate_snapshot(args.snapshot, args.schema)\n        if errors:\n            print(\"Snapshot validation failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Snapshot is valid: {args.snapshot}\")\n        return 0\n    if args.command == \"capture-sources\":\n        try:\n            manifest = capture_sources(args.run_dir, run_id=args.run_id, case_clock=args.case_clock)\n        except Exception as exc:\n            print(f\"Source capture failed: {exc}\", file=sys.stderr)\n            return 1\n        counts = {state: sum(row[\"status\"] == state for row in manifest[\"files\"]) for state in (\"read\", \"unavailable\")}\n        print(f\"Source capture complete: {args.run_id} ({counts['read']} read, {counts['unavailable']} unavailable)\")\n        return 0 if not counts[\"unavailable\"] else 2\n    if args.command == \"verify-sources\":\n        errors = verify_source_manifest(args.run_dir)\n        if errors:\n            print(\"Source verification failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Source manifest and retained bytes are valid: {args.run_dir}\")\n        return 0\n    if args.command == \"parse-retained\":\n        try:\n            parsed = parse_retained_run(args.run_dir, output_path=args.output)\n        except (OSError, ValueError, FileExistsError) as exc:\n            print(f\"Could not parse retained sources: {exc}\", file=sys.stderr)\n            return 1\n        print(\n            f\"Parsed {len(parsed['records']['claim_revisions'])} claim revisions, \"\n            f\"{len(parsed['records']['trips'])} trips, {len(parsed['records']['permits'])} permits, \"\n            f\"{len(parsed['records']['receipts'])} receipt records, \"\n            f\"{len(parsed['records']['decisions'])} decisions, \"\n            f\"{len(parsed['records']['finance_events'])} Finance events, and \"\n            f\"{len(parsed['records']['cancellation_activities'])} cancellation activities; \"\n            f\"arrival batches {parsed['arrival_batches']}; case clock {parsed['case_clock_state']}\"\n        )\n        return 0 if not parsed[\"missing_sources\"] and parsed[\"case_clock\"] else 2\n    if args.command == \"seal-batch\":\n        try:\n            state = json.loads(args.state.read_text(encoding=\"utf-8\"))\n            snapshot_path = seal_batch_snapshot(\n                args.run_dir,\n                run_id=args.run_id,\n                batch_id=args.batch_id,\n                claims=state[\"claims\"],\n                requests=state[\"requests\"],\n                travel_cancellations=state[\"travel_cancellations\"],\n                admitted_event_ids=state[\"admitted_event_ids\"],\n                issues=state[\"issues\"],\n                schema_path=args.schema,\n                predecessor_path=args.predecessor,\n            )\n        except (OSError, KeyError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not seal batch: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Sealed batch snapshot: {snapshot_path}\")\n        return 0\n    if args.command == \"verify-batch\":\n        errors = verify_snapshot(args.snapshot, args.run_dir, args.schema)\n        if errors:\n            print(\"Batch verification failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Batch snapshot and bindings are valid: {args.snapshot}\")\n        return 0\n    if args.command == \"write-claims-csv\":\n        try:\n            claims = json.loads(args.claims_json.read_text(encoding=\"utf-8\"))\n            if not isinstance(claims, list):\n                raise ValueError(\"claims JSON must be an array\")\n            write_claims_csv(claims, args.output)\n        except (OSError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not write claims CSV: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Wrote claims CSV: {args.output}\")\n        return 0\n    if args.command == \"offline-replay\":\n        try:\n            result = run_offline_replay(args.run_dir, schema_path=args.schema)\n        except (OSError, KeyError, json.JSONDecodeError, ValueError, FileExistsError) as exc:\n            print(f\"Offline replay failed: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"OFFLINE REPLAY complete: {result['run_id']} (no fresh native-source reads)\")\n        for snapshot in result[\"snapshots\"]:\n            print(f\"Snapshot: {snapshot}\")\n        for label, output in result[\"outputs\"].items():\n            print(f\"{label}: {output}\")\n        return 0\n    return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"\"\"Fresh native-source retrieval and byte-bound source manifests.\n\nThis module deliberately has no cache/fallback path. Every capture invokes the\nconfigured native URL or its documented export route again.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport re\nimport urllib.error\nimport urllib.request\nimport zipfile\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Callable, Mapping\n\n\n@dataclass(frozen=True)\nclass NativeSource:\n    source_id: str\n    title: str\n    url: str\n    locator: str\n    export_url: str | None = None\n    kind: str = \"binary\"\n\n\nSOURCES: tuple[NativeSource, ...] = (\n    NativeSource(\n        \"policy-pol-2026-2\",\n        \"Travel reimbursement policy POL-2026.2\",\n        \"https://private-pecorino-70e.notion.site/REDACTED\",\n        \"Notion policy page body\",\n        kind=\"notion\",\n    ),\n    NativeSource(\n        \"initial-claim-binder\",\n        \"Initial claim binder\",\n        \"https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"claim-updates-binder\",\n        \"Claim updates binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"receipt-binder\",\n        \"Receipt binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"travel-registers-workbook\",\n        \"Travel registers workbook\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/edit\",\n        \"All workbook tabs via native XLSX export\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/export?format=xlsx\",\n        \"xlsx\",\n    ),\n)\n\n\ndef _utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef sha256_bytes(content: bytes) -> str:\n    return hashlib.sha256(content).hexdigest()\n\n\ndef _policy_page_is_relevant_html(content: bytes) -> bool:\n    text = content.decode(\"utf-8\", \"replace\")\n    # A successful response can still be only a generic Notion app/login shell.\n    has_policy_id = bool(re.search(r\"POL[- ]2026(?:\\.2|[- ]2)\", text, re.I))\n    has_policy_body = bool(re.search(r\"lodging|meal cap|permit approval|reimbursement\", text, re.I))\n    return has_policy_id and has_policy_body\n\n\ndef _validate_payload(source: NativeSource, content: bytes) -> tuple[bool, str | None, str | None]:\n    \"\"\"Return (usable, filename suffix, failure reason), without parsing case answers.\"\"\"\n    if source.kind == \"notion\":\n        if not content or not _policy_page_is_relevant_html(content):\n            return False, None, \"HTTP response contained a generic Notion shell; policy page content was not accessible\"\n        return True, \"html\", None\n    if source.kind == \"pdf\":\n        if not content.startswith(b\"%PDF-\") or b\"%%EOF\" not in content[-2048:]:\n            return False, None, \"Export did not contain a complete PDF signature and trailer\"\n        return True, \"pdf\", None\n    if source.kind == \"xlsx\":\n        try:\n            import io\n\n            with zipfile.ZipFile(io.BytesIO(content)) as archive:\n                if archive.testzip() is not None or \"xl/workbook.xml\" not in archive.namelist():\n                    return False, None, \"XLSX archive is corrupt or has no workbook index\"\n        except (OSError, zipfile.BadZipFile):\n            return False, None, \"Export was not a readable XLSX workbook\"\n        return True, \"xlsx\", None\n    return (bool(content), \"bin\" if content else None, None if content else \"Empty response body\")\n\n\ndef _request(url: str, timeout: float) -> tuple[bytes, Mapping[str, str], str]:\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"travel-claim-source-capture/1.0\"})\n    with urllib.request.urlopen(req, timeout=timeout) as response:\n        return response.read(), dict(response.headers.items()), response.geturl()\n\n\ndef capture_sources(\n    run_dir: Path,\n    *,\n    run_id: str,\n    case_clock: str | None,\n    source_specs: tuple[NativeSource, ...] = SOURCES,\n    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\n    observed_at: Callable[[], str] = _utc_now,\n    timeout: float = 30.0,\n) -> dict:\n    \"\"\"Freshly attempt every source and write exact returned bytes plus sources.json.\n\n    `case_clock` is caller supplied scenario time. It may be null for a\n    source-acquisition-only run where no supplied batch clock has been read.\n    \"\"\"\n    if not run_id or Path(run_id).name != run_id or run_id in {\".\", \"..\"}:\n        raise ValueError(\"run_id must be a single safe path component\")\n    if run_dir.name != run_id:\n        raise ValueError(\"run_dir basename must equal run_id\")\n    run_dir.mkdir(parents=True, exist_ok=True)\n    manifest_path = run_dir / \"sources.json\"\n    if manifest_path.exists():\n        raise FileExistsError(f\"Refusing to overwrite source manifest: {manifest_path}\")\n    source_dir = run_dir / \"sources\"\n    source_dir.mkdir(exist_ok=True)\n    if any(source_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to reuse nonempty retained-source directory: {source_dir}\")\n    entries: list[dict] = []\n    for source in source_specs:\n        timestamp = observed_at()\n        url_attempted = source.export_url or source.url\n        try:\n            body, headers, _final_url = fetch(url_attempted, timeout)\n            usable, suffix, validation_error = _validate_payload(source, body)\n            timestamp = observed_at()\n            version = headers.get(\"ETag\") or headers.get(\"Last-Modified\")\n            if usable:\n                rel_path = Path(\"sources\") / f\"{source.source_id}.{suffix}\"\n                content_path = run_dir / rel_path\n                with content_path.open(\"xb\") as retained:\n                    retained.write(body)\n                entries.append({\n                    \"source_id\": source.source_id,\n                    \"path\": rel_path.as_posix(),\n                    \"sha256\": sha256_bytes(body),\n                    \"status\": \"read\",\n                    \"error\": None,\n                    \"url\": source.url,\n                    \"locator\": source.locator,\n                    \"observed_at\": timestamp,\n                    \"version\": version,\n                    \"scope\": source.title,\n                    \"missing_scope\": [],\n                })\n            else:\n                entries.append({\n                    \"source_id\": source.source_id,\n                    \"path\": None,\n                    \"sha256\": None,\n                    \"status\": \"unavailable\",\n                    \"error\": validation_error,\n                    \"url\": source.url,\n                    \"locator\": source.locator,\n                    \"observed_at\": timestamp,\n                    \"version\": None,\n                    \"scope\": source.title,\n                    \"missing_scope\": [source.title],\n                })\n        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:\n            timestamp = observed_at()\n            entries.append({\n                \"source_id\": source.source_id,\n                \"path\": None,\n                \"sha256\": None,\n                \"status\": \"unavailable\",\n                \"error\": f\"{type(exc).__name__}: {exc}\",\n                \"url\": source.url,\n                \"locator\": source.locator,\n                \"observed_at\": timestamp,\n                \"version\": None,\n                \"scope\": source.title,\n                \"missing_scope\": [source.title],\n            })\n    manifest = {\n        \"run_id\": run_id,\n        \"source_version\": \"native-source-manifest/1\",\n        \"case_clock\": case_clock,\n        \"files\": entries,\n    }\n    with manifest_path.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        stream.write(json.dumps(manifest, indent=2, ensure_ascii=False) + \"\\n\")\n    return manifest\n\n\ndef verify_source_manifest(run_dir: Path) -> list[str]:\n    \"\"\"Check source manifest shape, five source attempts, and retained-byte hashes.\"\"\"\n    errors: list[str] = []\n    path = run_dir / \"sources.json\"\n    try:\n        manifest = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read sources.json: {exc}\"]\n    if not isinstance(manifest, dict):\n        return [\"sources.json must contain an object\"]\n    if set(manifest) != {\"run_id\", \"source_version\", \"case_clock\", \"files\"}:\n        errors.append(\"sources.json must contain exactly run_id, source_version, case_clock, and files\")\n    if manifest.get(\"run_id\") != run_dir.name:\n        errors.append(\"sources.json run_id must match its run directory\")\n    if not isinstance(manifest.get(\"files\"), list):\n        return errors + [\"sources.json files must be an array\"]\n    seen: set[str] = set()\n    for record in manifest[\"files\"]:\n        if not isinstance(record, dict):\n            errors.append(\"every files[] entry must be an object\")\n            continue\n        sid = record.get(\"source_id\")\n        if not isinstance(sid, str) or not sid or sid in seen:\n            errors.append(f\"source_id is empty or duplicated: {sid!r}\")\n        else:\n            seen.add(sid)\n        required = {\n            \"source_id\", \"path\", \"sha256\", \"status\", \"error\", \"url\", \"locator\",\n            \"observed_at\", \"version\", \"scope\", \"missing_scope\",\n        }\n        if not required.issubset(record):\n            errors.append(f\"{sid}: missing required metadata fields {sorted(required - set(record))}\")\n            continue\n        if not isinstance(record.get(\"url\"), str) or not record[\"url\"] or not isinstance(record.get(\"locator\"), str) or not record[\"locator\"]:\n            errors.append(f\"{sid}: url and locator must be nonempty strings\")\n        if not isinstance(record.get(\"scope\"), str) or not record[\"scope\"]:\n            errors.append(f\"{sid}: scope must identify the observed source portion\")\n        if not isinstance(record.get(\"missing_scope\"), list) or not all(isinstance(x, str) and x for x in record[\"missing_scope\"]):\n            errors.append(f\"{sid}: missing_scope must be an array of nonempty strings\")\n        try:\n            observed = datetime.fromisoformat(str(record[\"observed_at\"]).replace(\"Z\", \"+00:00\"))\n            if observed.utcoffset() is None or observed.utcoffset().total_seconds() != 0:\n                errors.append(f\"{sid}: observed_at must be UTC\")\n        except (TypeError, ValueError):\n            errors.append(f\"{sid}: observed_at must be an ISO UTC timestamp\")\n        if record[\"error\"] is not None and not isinstance(record[\"error\"], str):\n            errors.append(f\"{sid}: error must be a string or null\")\n        if record[\"status\"] == \"read\":\n            if not isinstance(record[\"path\"], str) or not record[\"path\"] or not isinstance(record[\"sha256\"], str) or not record[\"sha256\"]:\n                errors.append(f\"{sid}: read record has no retained path or hash\")\n                continue\n            content_path = run_dir / record[\"path\"]\n            if not content_path.resolve().is_relative_to(run_dir.resolve()):\n                errors.append(f\"{sid}: retained path escapes the run directory\")\n                continue\n            try:\n                actual = sha256_bytes(content_path.read_bytes())\n            except OSError as exc:\n                errors.append(f\"{sid}: cannot read retained content: {exc}\")\n            else:\n                if actual != record[\"sha256\"]:\n                    errors.append(f\"{sid}: retained content hash mismatch\")\n        elif record[\"status\"] == \"unavailable\":\n            if any(record[k] is not None for k in (\"path\", \"sha256\", \"version\")):\n                errors.append(f\"{sid}: unavailable scope must have null path, sha256, and version\")\n            if not record[\"error\"]:\n                errors.append(f\"{sid}: unavailable scope has no error\")\n        else:\n            errors.append(f\"{sid}: invalid status {record['status']!r}\")\n    expected_urls = {source.url for source in SOURCES}\n    observed_urls = {\n        record.get(\"url\")\n        for record in manifest[\"files\"]\n        if isinstance(record, dict) and isinstance(record.get(\"url\"), str)\n    }\n    if observed_urls != expected_urls:\n        errors.append(\"manifest must cover exactly all five configured native source URLs\")\n    return errors\n\"\"\"Schema-checked, content-addressed batch snapshots.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\n\nfrom .sources import sha256_bytes, verify_source_manifest\n\n\ndef _schema_errors(snapshot: dict, schema_path: Path) -> list[str]:\n    schema = json.loads(schema_path.read_text(encoding=\"utf-8\"))\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    return [\n        f\"{'.'.join(map(str, err.absolute_path)) or '<root>'}: {err.message}\"\n        for err in sorted(validator.iter_errors(snapshot), key=lambda e: list(map(str, e.absolute_path)))\n    ]\n\n\ndef _check_semantics(snapshot: dict) -> list[str]:\n    errors: list[str] = []\n    issue_ids = [issue[\"record_id\"] for issue in snapshot[\"issues\"]]\n    if len(issue_ids) != len(set(issue_ids)):\n        errors.append(\"issues[].record_id values must be unique\")\n    issue_set = set(issue_ids)\n    for cancellation in snapshot[\"travel_cancellations\"]:\n        missing = set(cancellation[\"issue_record_ids\"]) - issue_set\n        if missing:\n            errors.append(f\"cancellation {cancellation['cancellation_id']} refers to missing issue records: {sorted(missing)}\")\n    claim_ids = {claim[\"claim_id\"] for claim in snapshot[\"claims\"]}\n    for request in snapshot[\"requests\"]:\n        if request[\"claim_id\"] not in claim_ids:\n            errors.append(f\"request {request['request_id']} refers to missing claim {request['claim_id']}\")\n    cancellation_event_ids = {\n        event_id\n        for cancellation in snapshot[\"travel_cancellations\"]\n        for event_id in cancellation[\"admitted_cancellation_event_ids\"]\n    }\n    overlap = cancellation_event_ids & set(snapshot[\"admitted_event_ids\"])\n    if overlap:\n        errors.append(f\"Finance admitted_event_ids must not contain cancellation activity IDs: {sorted(overlap)}\")\n    return errors\n\n\ndef verify_snapshot(snapshot_path: Path, run_dir: Path, schema_path: Path) -> list[str]:\n    \"\"\"Verify this snapshot and every sealed snapshot in its predecessor chain.\"\"\"\n    return _verify_snapshot(snapshot_path, run_dir, schema_path, set())\n\n\ndef _verify_snapshot(\n    snapshot_path: Path,\n    run_dir: Path,\n    schema_path: Path,\n    seen_paths: set[Path],\n) -> list[str]:\n    \"\"\"Validate schema plus source/predecessor hashes and required references.\"\"\"\n    resolved_snapshot = snapshot_path.resolve()\n    if resolved_snapshot in seen_paths:\n        return [f\"predecessor cycle detected at {snapshot_path}\"]\n    seen_paths.add(resolved_snapshot)\n    try:\n        snapshot = json.loads(snapshot_path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read snapshot: {exc}\"]\n    errors = _schema_errors(snapshot, schema_path)\n    if errors:\n        return errors\n    errors.extend(_check_semantics(snapshot))\n    errors.extend(verify_source_manifest(run_dir))\n    try:\n        manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n        if not isinstance(manifest, dict):\n            raise ValueError(\"sources.json must be an object\")\n        if manifest.get(\"run_id\") != snapshot[\"run_id\"]:\n            errors.append(\"snapshot run_id does not match sources.json run_id\")\n        files = manifest.get(\"files\", [])\n        retained_ids = {\n            record.get(\"source_id\")\n            for record in files if isinstance(record, dict)\n            if record.get(\"status\") == \"read\"\n        }\n        for claim in snapshot[\"claims\"]:\n            for line in claim[\"lines\"]:\n                missing_sources = set(line[\"source_ids\"]) - retained_ids\n                if missing_sources:\n                    errors.append(\n                        f\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\"\n                    )\n    except (OSError, json.JSONDecodeError, ValueError):\n        manifest = {}\n    source_binding = snapshot[\"source_binding\"]\n    source_path = run_dir / source_binding[\"path\"]\n    if not source_path.resolve().is_relative_to(run_dir.resolve()):\n        errors.append(\"source_binding path escapes the run directory\")\n        return errors\n    if source_path.resolve() != (run_dir / \"sources.json\").resolve():\n        errors.append(\"source_binding must identify this run's sources.json\")\n        return errors\n    try:\n        actual = sha256_bytes(source_path.read_bytes())\n    except OSError as exc:\n        errors.append(f\"Cannot read bound sources file {source_binding['path']}: {exc}\")\n    else:\n        if actual != source_binding[\"sha256\"]:\n            errors.append(\"source_binding SHA-256 does not match retained sources.json\")\n    predecessor = snapshot[\"predecessor\"]\n    if predecessor is not None:\n        previous_path = run_dir / predecessor[\"path\"]\n        if not previous_path.resolve().is_relative_to((run_dir / \"batches\").resolve()):\n            errors.append(\"predecessor path escapes the run's batches directory\")\n            return errors\n        try:\n            actual = sha256_bytes(previous_path.read_bytes())\n        except OSError as exc:\n            errors.append(f\"Cannot read predecessor {predecessor['path']}: {exc}\")\n        else:\n            if actual != predecessor[\"sha256\"]:\n                errors.append(\"predecessor SHA-256 does not match retained snapshot\")\n            else:\n                errors.extend(\n                    f\"predecessor chain: {error}\"\n                    for error in _verify_snapshot(previous_path, run_dir, schema_path, seen_paths)\n                )\n    return errors\n\n\ndef seal_batch_snapshot(\n    run_dir: Path,\n    *,\n    run_id: str,\n    batch_id: str,\n    claims: list[dict],\n    requests: list[dict],\n    travel_cancellations: list[dict],\n    admitted_event_ids: list[str],\n    issues: list[dict],\n    schema_path: Path,\n    predecessor_path: Path | None = None,\n    allow_unconfirmed_case_clock: bool = False,\n) -> Path:\n    \"\"\"Seal one batch. Binding paths are relative to the run directory.\n\n    Existing snapshots are never overwritten. The first snapshot uses a null\n    predecessor; later snapshots hash the exact prior serialized bytes.\n    \"\"\"\n    batches_dir = run_dir / \"batches\"\n    batches_dir.mkdir(parents=True, exist_ok=True)\n    if not batch_id or Path(batch_id).name != batch_id or batch_id in {\".\", \"..\"}:\n        raise ValueError(\"batch_id must be a single safe path component\")\n    target = batches_dir / f\"{batch_id}.json\"\n    if target.exists():\n        raise FileExistsError(f\"Refusing to overwrite sealed snapshot: {target}\")\n    source_path = run_dir / \"sources.json\"\n    if not source_path.is_file():\n        raise FileNotFoundError(f\"Required source manifest missing: {source_path}\")\n    source_errors = verify_source_manifest(run_dir)\n    if source_errors:\n        raise ValueError(\"Source manifest is not integrity-valid: \" + \"; \".join(source_errors))\n    manifest = json.loads(source_path.read_text(encoding=\"utf-8\"))\n    if manifest.get(\"run_id\") != run_id:\n        raise ValueError(\"Snapshot run_id must match sources.json run_id\")\n    if not manifest.get(\"case_clock\") and not allow_unconfirmed_case_clock:\n        raise ValueError(\"Cannot consume a batch without the supplied scenario case_clock\")\n    existing_snapshots = list(batches_dir.glob(\"*.json\"))\n    if existing_snapshots and predecessor_path is None:\n        raise ValueError(\"A later batch must bind its predecessor snapshot\")\n    source_rel = Path(\"sources.json\")\n    predecessor = None\n    if predecessor_path is not None:\n        predecessor_path = predecessor_path.resolve()\n        if not predecessor_path.is_file():\n            raise FileNotFoundError(f\"Predecessor snapshot missing: {predecessor_path}\")\n        if predecessor_path.parent.resolve() != batches_dir.resolve():\n            raise ValueError(\"Predecessor must be a retained snapshot in this run's batches directory\")\n        # Verify its source binding and full schema before chaining from it.\n        predecessor_errors = verify_snapshot(predecessor_path, run_dir, schema_path)\n        if predecessor_errors:\n            raise ValueError(\"Predecessor snapshot is invalid: \" + \"; \".join(predecessor_errors))\n        prior_state = json.loads(predecessor_path.read_text(encoding=\"utf-8\"))\n        if prior_state[\"run_id\"] != run_id:\n            raise ValueError(\"Predecessor snapshot belongs to a different run\")\n        chain_paths: set[Path] = set()\n        cursor = predecessor_path.resolve()\n        while cursor not in chain_paths:\n            chain_paths.add(cursor)\n            cursor_state = json.loads(cursor.read_text(encoding=\"utf-8\"))\n            previous = cursor_state[\"predecessor\"]\n            if previous is None:\n                break\n            cursor = (run_dir / previous[\"path\"]).resolve()\n        existing_paths = {path.resolve() for path in existing_snapshots}\n        if chain_paths != existing_paths:\n            raise ValueError(\"Predecessor must be the end of the complete retained snapshot chain; orphaned or missing prior state found\")\n        predecessor = {\n            \"path\": (Path(\"batches\") / predecessor_path.name).as_posix(),\n            \"sha256\": sha256_bytes(predecessor_path.read_bytes()),\n        }\n    snapshot = {\n        \"schema_version\": \"travel-claim-snapshot/2\",\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"predecessor\": predecessor,\n        \"source_binding\": {\n            \"path\": source_rel.as_posix(),\n            \"sha256\": sha256_bytes(source_path.read_bytes()),\n        },\n        \"claims\": copy.deepcopy(claims),\n        \"requests\": copy.deepcopy(requests),\n        \"travel_cancellations\": copy.deepcopy(travel_cancellations),\n        \"admitted_event_ids\": list(admitted_event_ids),\n        \"issues\": copy.deepcopy(issues),\n    }\n    errors = _schema_errors(snapshot, schema_path) + _check_semantics(snapshot)\n    if errors:\n        raise ValueError(\"Refusing to seal invalid snapshot: \" + \"; \".join(errors))\n    serialized = json.dumps(snapshot, indent=2, ensure_ascii=False) + \"\\n\"\n    # Exclusive create prevents a concurrent run from replacing prior bytes.\n    with target.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        stream.write(serialized)\n    errors = verify_snapshot(target, run_dir, schema_path)\n    if errors:\n        # Do not remove or rewrite a possibly observed sealed file. Surface the\n        # integrity failure for operator investigation.\n        raise ValueError(\"New snapshot failed post-seal integrity checks: \" + \"; \".join(errors))\n    return target\n","exit_code":0,"duration":{"secs":0,"nanos":31152770},"formatted_output":"artifacts/verification/project-d-incremental-verification-20261014.md\n.codex/hooks.json\ninterviews/project-d-travel-expense-claim-20261013-2210.md\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/report.md\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/offline-replay-state.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/batches/arrival-003.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/batches/arrival-001.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/batches/arrival-002.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/batches/arrival-004.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/claims.csv\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/parsed-records.json\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/repair-queue.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/report.md\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/sources/claim-updates-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/sources/initial-claim-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/sources/travel-registers-workbook.xlsx\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/sources/receipt-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z-report-milestone/sources.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/parsed-records.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/repair-queue.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/offline-replay-state.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/follow-up-drafts.md\nartifacts/runs/source-capture-20261014T100034Z/report.md\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/batches/arrival-003.json\nskills/travel-expense-claim/SKILL.md\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/batches/arrival-001.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/batches/arrival-002.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/batches/arrival-004.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/claims.csv\nartifacts/runs/source-capture-20261014T100034Z/offline-replay-state.json\nartifacts/runs/source-capture-20261014T100034Z/parsed-records.json\nartifacts/runs/source-capture-20261014T100034Z/claims.csv\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/sources.json\nartifacts/runs/source-capture-20261014T100034Z/sources.json\nartifacts/runs/source-capture-20261014T100034Z/repair-queue.json\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/sources/travel-registers-workbook.xlsx\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/sources/receipt-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/sources/initial-claim-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z-follow-up-milestone/sources/claim-updates-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z/sources/claim-updates-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z/sources/travel-registers-workbook.xlsx\nartifacts/runs/source-capture-20261014T100034Z/batches/arrival-003.json\nartifacts/runs/source-capture-20261014T100034Z/batches/arrival-001.json\nartifacts/runs/source-capture-20261014T100034Z/batches/arrival-002.json\nartifacts/runs/source-capture-20261014T100034Z/batches/arrival-004.json\nartifacts/runs/source-capture-20261014T100034Z/sources/initial-claim-binder.pdf\nartifacts/runs/source-capture-20261014T100034Z/sources/receipt-binder.pdf\n\"\"\"Command-line interface for travel claim tooling.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\n\nfrom .outputs import write_claims_csv\nfrom .offline_replay import run_offline_replay\nfrom .parsing import parse_retained_run\nfrom .snapshots import seal_batch_snapshot, verify_snapshot\nfrom .sources import capture_sources, verify_source_manifest\n\n\ndef _default_schema_path() -> Path:\n    \"\"\"Return the repository's authoritative snapshot schema path.\"\"\"\n    return Path(__file__).resolve().parents[2] / \"snapshot.schema.json\"\n\n\ndef validate_snapshot(snapshot_path: Path, schema_path: Path) -> list[str]:\n    \"\"\"Return validation errors for a snapshot and schema, or an empty list.\"\"\"\n    try:\n        with snapshot_path.open(encoding=\"utf-8\") as snapshot_file:\n            snapshot = json.load(snapshot_file)\n    except FileNotFoundError:\n        return [f\"Snapshot file not found: {snapshot_path}\"]\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Could not read snapshot {snapshot_path}: {exc}\"]\n\n    try:\n        with schema_path.open(encoding=\"utf-8\") as schema_file:\n            schema = json.load(schema_file)\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Could not read schema {schema_path}: {exc}\"]\n\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    errors = sorted(validator.iter_errors(snapshot), key=lambda error: list(map(str, error.absolute_path)))\n    return [\n        f\"{'.'.join(map(str, error.absolute_path)) or '<root>'}: {error.message}\"\n        for error in errors\n    ]\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"travel-claim\")\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    validate = commands.add_parser(\n        \"validate-snapshot\", help=\"validate a JSON snapshot against snapshot.schema.json\"\n    )\n    validate.add_argument(\"snapshot\", type=Path, help=\"path to the snapshot JSON file\")\n    validate.add_argument(\n        \"--schema\", type=Path, default=_default_schema_path(), help=\"schema JSON path\"\n    )\n\n    capture = commands.add_parser(\"capture-sources\", help=\"freshly retrieve and retain all five native sources\")\n    capture.add_argument(\"run_id\", help=\"new, stable run identifier\")\n    capture.add_argument(\"run_dir\", type=Path, help=\"new artifacts/runs/<run-id> directory\")\n    capture.add_argument(\"--case-clock\", help=\"supplied scenario clock; omit only for source-only capture\")\n\n    verify_sources = commands.add_parser(\"verify-sources\", help=\"verify source manifest and retained-byte hashes\")\n    verify_sources.add_argument(\"run_dir\", type=Path)\n\n    parse_sources = commands.add_parser(\"parse-retained\", help=\"transcribe hash-verified PDFs and workbook into traceable records\")\n    parse_sources.add_argument(\"run_dir\", type=Path)\n    parse_sources.add_argument(\"--output\", type=Path, help=\"optional new output path; defaults to parsed-records.json in the run\")\n\n    seal = commands.add_parser(\"seal-batch\", help=\"schema-check and immutably seal one batch state JSON\")\n    seal.add_argument(\"run_dir\", type=Path)\n    seal.add_argument(\"batch_id\")\n    seal.add_argument(\"state\", type=Path, help=\"JSON object containing claims, requests, cancellations, events, issues\")\n    seal.add_argument(\"--run-id\", required=True)\n    seal.add_argument(\"--predecessor\", type=Path)\n    seal.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    verify_batch = commands.add_parser(\"verify-batch\", help=\"verify schema and source/predecessor bindings\")\n    verify_batch.add_argument(\"run_dir\", type=Path)\n    verify_batch.add_argument(\"snapshot\", type=Path)\n    verify_batch.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n\n    csv_cmd = commands.add_parser(\"write-claims-csv\", help=\"write the exact current-claim CSV contract\")\n    csv_cmd.add_argument(\"claims_json\", type=Path, help=\"JSON array of current claim summary objects\")\n    csv_cmd.add_argument(\"output\", type=Path)\n\n    replay = commands.add_parser(\n        \"offline-replay\",\n        help=\"replay verified retained records in arrival order without fresh native-source reads\",\n    )\n    replay.add_argument(\"run_dir\", type=Path, help=\"existing retained-source run directory\")\n    replay.add_argument(\"--schema\", type=Path, default=_default_schema_path(), help=\"snapshot schema path\")\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    args = build_parser().parse_args(argv)\n    if args.command == \"validate-snapshot\":\n        errors = validate_snapshot(args.snapshot, args.schema)\n        if errors:\n            print(\"Snapshot validation failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Snapshot is valid: {args.snapshot}\")\n        return 0\n    if args.command == \"capture-sources\":\n        try:\n            manifest = capture_sources(args.run_dir, run_id=args.run_id, case_clock=args.case_clock)\n        except Exception as exc:\n            print(f\"Source capture failed: {exc}\", file=sys.stderr)\n            return 1\n        counts = {state: sum(row[\"status\"] == state for row in manifest[\"files\"]) for state in (\"read\", \"unavailable\")}\n        print(f\"Source capture complete: {args.run_id} ({counts['read']} read, {counts['unavailable']} unavailable)\")\n        return 0 if not counts[\"unavailable\"] else 2\n    if args.command == \"verify-sources\":\n        errors = verify_source_manifest(args.run_dir)\n        if errors:\n            print(\"Source verification failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Source manifest and retained bytes are valid: {args.run_dir}\")\n        return 0\n    if args.command == \"parse-retained\":\n        try:\n            parsed = parse_retained_run(args.run_dir, output_path=args.output)\n        except (OSError, ValueError, FileExistsError) as exc:\n            print(f\"Could not parse retained sources: {exc}\", file=sys.stderr)\n            return 1\n        print(\n            f\"Parsed {len(parsed['records']['claim_revisions'])} claim revisions, \"\n            f\"{len(parsed['records']['trips'])} trips, {len(parsed['records']['permits'])} permits, \"\n            f\"{len(parsed['records']['receipts'])} receipt records, \"\n            f\"{len(parsed['records']['decisions'])} decisions, \"\n            f\"{len(parsed['records']['finance_events'])} Finance events, and \"\n            f\"{len(parsed['records']['cancellation_activities'])} cancellation activities; \"\n            f\"arrival batches {parsed['arrival_batches']}; case clock {parsed['case_clock_state']}\"\n        )\n        return 0 if not parsed[\"missing_sources\"] and parsed[\"case_clock\"] else 2\n    if args.command == \"seal-batch\":\n        try:\n            state = json.loads(args.state.read_text(encoding=\"utf-8\"))\n            snapshot_path = seal_batch_snapshot(\n                args.run_dir,\n                run_id=args.run_id,\n                batch_id=args.batch_id,\n                claims=state[\"claims\"],\n                requests=state[\"requests\"],\n                travel_cancellations=state[\"travel_cancellations\"],\n                admitted_event_ids=state[\"admitted_event_ids\"],\n                issues=state[\"issues\"],\n                schema_path=args.schema,\n                predecessor_path=args.predecessor,\n            )\n        except (OSError, KeyError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not seal batch: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Sealed batch snapshot: {snapshot_path}\")\n        return 0\n    if args.command == \"verify-batch\":\n        errors = verify_snapshot(args.snapshot, args.run_dir, args.schema)\n        if errors:\n            print(\"Batch verification failed:\", file=sys.stderr)\n            for error in errors:\n                print(f\"- {error}\", file=sys.stderr)\n            return 1\n        print(f\"Batch snapshot and bindings are valid: {args.snapshot}\")\n        return 0\n    if args.command == \"write-claims-csv\":\n        try:\n            claims = json.loads(args.claims_json.read_text(encoding=\"utf-8\"))\n            if not isinstance(claims, list):\n                raise ValueError(\"claims JSON must be an array\")\n            write_claims_csv(claims, args.output)\n        except (OSError, json.JSONDecodeError, ValueError) as exc:\n            print(f\"Could not write claims CSV: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"Wrote claims CSV: {args.output}\")\n        return 0\n    if args.command == \"offline-replay\":\n        try:\n            result = run_offline_replay(args.run_dir, schema_path=args.schema)\n        except (OSError, KeyError, json.JSONDecodeError, ValueError, FileExistsError) as exc:\n            print(f\"Offline replay failed: {exc}\", file=sys.stderr)\n            return 1\n        print(f\"OFFLINE REPLAY complete: {result['run_id']} (no fresh native-source reads)\")\n        for snapshot in result[\"snapshots\"]:\n            print(f\"Snapshot: {snapshot}\")\n        for label, output in result[\"outputs\"].items():\n            print(f\"{label}: {output}\")\n        return 0\n    return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\"\"\"Fresh native-source retrieval and byte-bound source manifests.\n\nThis module deliberately has no cache/fallback path. Every capture invokes the\nconfigured native URL or its documented export route again.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport re\nimport urllib.error\nimport urllib.request\nimport zipfile\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Callable, Mapping\n\n\n@dataclass(frozen=True)\nclass NativeSource:\n    source_id: str\n    title: str\n    url: str\n    locator: str\n    export_url: str | None = None\n    kind: str = \"binary\"\n\n\nSOURCES: tuple[NativeSource, ...] = (\n    NativeSource(\n        \"policy-pol-2026-2\",\n        \"Travel reimbursement policy POL-2026.2\",\n        \"https://private-pecorino-70e.notion.site/REDACTED\",\n        \"Notion policy page body\",\n        kind=\"notion\",\n    ),\n    NativeSource(\n        \"initial-claim-binder\",\n        \"Initial claim binder\",\n        \"https://drive.google.com/file/d/13sRj6s_kMeP1hsYGstWWmfkb6SCN1YOS/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"claim-updates-binder\",\n        \"Claim updates binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"receipt-binder\",\n        \"Receipt binder\",\n        \"https://drive.google.com/file/d/REDACTED/view\",\n        \"Complete PDF document\",\n        \"https://drive.google.com/uc?export=download&REDACTED\",\n        \"pdf\",\n    ),\n    NativeSource(\n        \"travel-registers-workbook\",\n        \"Travel registers workbook\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/edit\",\n        \"All workbook tabs via native XLSX export\",\n        \"https://docs.google.com/spreadsheets/d/REDACTED/export?format=xlsx\",\n        \"xlsx\",\n    ),\n)\n\n\ndef _utc_now() -> str:\n    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\").replace(\"+00:00\", \"Z\")\n\n\ndef sha256_bytes(content: bytes) -> str:\n    return hashlib.sha256(content).hexdigest()\n\n\ndef _policy_page_is_relevant_html(content: bytes) -> bool:\n    text = content.decode(\"utf-8\", \"replace\")\n    # A successful response can still be only a generic Notion app/login shell.\n    has_policy_id = bool(re.search(r\"POL[- ]2026(?:\\.2|[- ]2)\", text, re.I))\n    has_policy_body = bool(re.search(r\"lodging|meal cap|permit approval|reimbursement\", text, re.I))\n    return has_policy_id and has_policy_body\n\n\ndef _validate_payload(source: NativeSource, content: bytes) -> tuple[bool, str | None, str | None]:\n    \"\"\"Return (usable, filename suffix, failure reason), without parsing case answers.\"\"\"\n    if source.kind == \"notion\":\n        if not content or not _policy_page_is_relevant_html(content):\n            return False, None, \"HTTP response contained a generic Notion shell; policy page content was not accessible\"\n        return True, \"html\", None\n    if source.kind == \"pdf\":\n        if not content.startswith(b\"%PDF-\") or b\"%%EOF\" not in content[-2048:]:\n            return False, None, \"Export did not contain a complete PDF signature and trailer\"\n        return True, \"pdf\", None\n    if source.kind == \"xlsx\":\n        try:\n            import io\n\n            with zipfile.ZipFile(io.BytesIO(content)) as archive:\n                if archive.testzip() is not None or \"xl/workbook.xml\" not in archive.namelist():\n                    return False, None, \"XLSX archive is corrupt or has no workbook index\"\n        except (OSError, zipfile.BadZipFile):\n            return False, None, \"Export was not a readable XLSX workbook\"\n        return True, \"xlsx\", None\n    return (bool(content), \"bin\" if content else None, None if content else \"Empty response body\")\n\n\ndef _request(url: str, timeout: float) -> tuple[bytes, Mapping[str, str], str]:\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"travel-claim-source-capture/1.0\"})\n    with urllib.request.urlopen(req, timeout=timeout) as response:\n        return response.read(), dict(response.headers.items()), response.geturl()\n\n\ndef capture_sources(\n    run_dir: Path,\n    *,\n    run_id: str,\n    case_clock: str | None,\n    source_specs: tuple[NativeSource, ...] = SOURCES,\n    fetch: Callable[[str, float], tuple[bytes, Mapping[str, str], str]] = _request,\n    observed_at: Callable[[], str] = _utc_now,\n    timeout: float = 30.0,\n) -> dict:\n    \"\"\"Freshly attempt every source and write exact returned bytes plus sources.json.\n\n    `case_clock` is caller supplied scenario time. It may be null for a\n    source-acquisition-only run where no supplied batch clock has been read.\n    \"\"\"\n    if not run_id or Path(run_id).name != run_id or run_id in {\".\", \"..\"}:\n        raise ValueError(\"run_id must be a single safe path component\")\n    if run_dir.name != run_id:\n        raise ValueError(\"run_dir basename must equal run_id\")\n    run_dir.mkdir(parents=True, exist_ok=True)\n    manifest_path = run_dir / \"sources.json\"\n    if manifest_path.exists():\n        raise FileExistsError(f\"Refusing to overwrite source manifest: {manifest_path}\")\n    source_dir = run_dir / \"sources\"\n    source_dir.mkdir(exist_ok=True)\n    if any(source_dir.iterdir()):\n        raise FileExistsError(f\"Refusing to reuse nonempty retained-source directory: {source_dir}\")\n    entries: list[dict] = []\n    for source in source_specs:\n        timestamp = observed_at()\n        url_attempted = source.export_url or source.url\n        try:\n            body, headers, _final_url = fetch(url_attempted, timeout)\n            usable, suffix, validation_error = _validate_payload(source, body)\n            timestamp = observed_at()\n            version = headers.get(\"ETag\") or headers.get(\"Last-Modified\")\n            if usable:\n                rel_path = Path(\"sources\") / f\"{source.source_id}.{suffix}\"\n                content_path = run_dir / rel_path\n                with content_path.open(\"xb\") as retained:\n                    retained.write(body)\n                entries.append({\n                    \"source_id\": source.source_id,\n                    \"path\": rel_path.as_posix(),\n                    \"sha256\": sha256_bytes(body),\n                    \"status\": \"read\",\n                    \"error\": None,\n                    \"url\": source.url,\n                    \"locator\": source.locator,\n                    \"observed_at\": timestamp,\n                    \"version\": version,\n                    \"scope\": source.title,\n                    \"missing_scope\": [],\n                })\n            else:\n                entries.append({\n                    \"source_id\": source.source_id,\n                    \"path\": None,\n                    \"sha256\": None,\n                    \"status\": \"unavailable\",\n                    \"error\": validation_error,\n                    \"url\": source.url,\n                    \"locator\": source.locator,\n                    \"observed_at\": timestamp,\n                    \"version\": None,\n                    \"scope\": source.title,\n                    \"missing_scope\": [source.title],\n                })\n        except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:\n            timestamp = observed_at()\n            entries.append({\n                \"source_id\": source.source_id,\n                \"path\": None,\n                \"sha256\": None,\n                \"status\": \"unavailable\",\n                \"error\": f\"{type(exc).__name__}: {exc}\",\n                \"url\": source.url,\n                \"locator\": source.locator,\n                \"observed_at\": timestamp,\n                \"version\": None,\n                \"scope\": source.title,\n                \"missing_scope\": [source.title],\n            })\n    manifest = {\n        \"run_id\": run_id,\n        \"source_version\": \"native-source-manifest/1\",\n        \"case_clock\": case_clock,\n        \"files\": entries,\n    }\n    with manifest_path.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        stream.write(json.dumps(manifest, indent=2, ensure_ascii=False) + \"\\n\")\n    return manifest\n\n\ndef verify_source_manifest(run_dir: Path) -> list[str]:\n    \"\"\"Check source manifest shape, five source attempts, and retained-byte hashes.\"\"\"\n    errors: list[str] = []\n    path = run_dir / \"sources.json\"\n    try:\n        manifest = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read sources.json: {exc}\"]\n    if not isinstance(manifest, dict):\n        return [\"sources.json must contain an object\"]\n    if set(manifest) != {\"run_id\", \"source_version\", \"case_clock\", \"files\"}:\n        errors.append(\"sources.json must contain exactly run_id, source_version, case_clock, and files\")\n    if manifest.get(\"run_id\") != run_dir.name:\n        errors.append(\"sources.json run_id must match its run directory\")\n    if not isinstance(manifest.get(\"files\"), list):\n        return errors + [\"sources.json files must be an array\"]\n    seen: set[str] = set()\n    for record in manifest[\"files\"]:\n        if not isinstance(record, dict):\n            errors.append(\"every files[] entry must be an object\")\n            continue\n        sid = record.get(\"source_id\")\n        if not isinstance(sid, str) or not sid or sid in seen:\n            errors.append(f\"source_id is empty or duplicated: {sid!r}\")\n        else:\n            seen.add(sid)\n        required = {\n            \"source_id\", \"path\", \"sha256\", \"status\", \"error\", \"url\", \"locator\",\n            \"observed_at\", \"version\", \"scope\", \"missing_scope\",\n        }\n        if not required.issubset(record):\n            errors.append(f\"{sid}: missing required metadata fields {sorted(required - set(record))}\")\n            continue\n        if not isinstance(record.get(\"url\"), str) or not record[\"url\"] or not isinstance(record.get(\"locator\"), str) or not record[\"locator\"]:\n            errors.append(f\"{sid}: url and locator must be nonempty strings\")\n        if not isinstance(record.get(\"scope\"), str) or not record[\"scope\"]:\n            errors.append(f\"{sid}: scope must identify the observed source portion\")\n        if not isinstance(record.get(\"missing_scope\"), list) or not all(isinstance(x, str) and x for x in record[\"missing_scope\"]):\n            errors.append(f\"{sid}: missing_scope must be an array of nonempty strings\")\n        try:\n            observed = datetime.fromisoformat(str(record[\"observed_at\"]).replace(\"Z\", \"+00:00\"))\n            if observed.utcoffset() is None or observed.utcoffset().total_seconds() != 0:\n                errors.append(f\"{sid}: observed_at must be UTC\")\n        except (TypeError, ValueError):\n            errors.append(f\"{sid}: observed_at must be an ISO UTC timestamp\")\n        if record[\"error\"] is not None and not isinstance(record[\"error\"], str):\n            errors.append(f\"{sid}: error must be a string or null\")\n        if record[\"status\"] == \"read\":\n            if not isinstance(record[\"path\"], str) or not record[\"path\"] or not isinstance(record[\"sha256\"], str) or not record[\"sha256\"]:\n                errors.append(f\"{sid}: read record has no retained path or hash\")\n                continue\n            content_path = run_dir / record[\"path\"]\n            if not content_path.resolve().is_relative_to(run_dir.resolve()):\n                errors.append(f\"{sid}: retained path escapes the run directory\")\n                continue\n            try:\n                actual = sha256_bytes(content_path.read_bytes())\n            except OSError as exc:\n                errors.append(f\"{sid}: cannot read retained content: {exc}\")\n            else:\n                if actual != record[\"sha256\"]:\n                    errors.append(f\"{sid}: retained content hash mismatch\")\n        elif record[\"status\"] == \"unavailable\":\n            if any(record[k] is not None for k in (\"path\", \"sha256\", \"version\")):\n                errors.append(f\"{sid}: unavailable scope must have null path, sha256, and version\")\n            if not record[\"error\"]:\n                errors.append(f\"{sid}: unavailable scope has no error\")\n        else:\n            errors.append(f\"{sid}: invalid status {record['status']!r}\")\n    expected_urls = {source.url for source in SOURCES}\n    observed_urls = {\n        record.get(\"url\")\n        for record in manifest[\"files\"]\n        if isinstance(record, dict) and isinstance(record.get(\"url\"), str)\n    }\n    if observed_urls != expected_urls:\n        errors.append(\"manifest must cover exactly all five configured native source URLs\")\n    return errors\n\"\"\"Schema-checked, content-addressed batch snapshots.\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\n\nfrom .sources import sha256_bytes, verify_source_manifest\n\n\ndef _schema_errors(snapshot: dict, schema_path: Path) -> list[str]:\n    schema = json.loads(schema_path.read_text(encoding=\"utf-8\"))\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    return [\n        f\"{'.'.join(map(str, err.absolute_path)) or '<root>'}: {err.message}\"\n        for err in sorted(validator.iter_errors(snapshot), key=lambda e: list(map(str, e.absolute_path)))\n    ]\n\n\ndef _check_semantics(snapshot: dict) -> list[str]:\n    errors: list[str] = []\n    issue_ids = [issue[\"record_id\"] for issue in snapshot[\"issues\"]]\n    if len(issue_ids) != len(set(issue_ids)):\n        errors.append(\"issues[].record_id values must be unique\")\n    issue_set = set(issue_ids)\n    for cancellation in snapshot[\"travel_cancellations\"]:\n        missing = set(cancellation[\"issue_record_ids\"]) - issue_set\n        if missing:\n            errors.append(f\"cancellation {cancellation['cancellation_id']} refers to missing issue records: {sorted(missing)}\")\n    claim_ids = {claim[\"claim_id\"] for claim in snapshot[\"claims\"]}\n    for request in snapshot[\"requests\"]:\n        if request[\"claim_id\"] not in claim_ids:\n            errors.append(f\"request {request['request_id']} refers to missing claim {request['claim_id']}\")\n    cancellation_event_ids = {\n        event_id\n        for cancellation in snapshot[\"travel_cancellations\"]\n        for event_id in cancellation[\"admitted_cancellation_event_ids\"]\n    }\n    overlap = cancellation_event_ids & set(snapshot[\"admitted_event_ids\"])\n    if overlap:\n        errors.append(f\"Finance admitted_event_ids must not contain cancellation activity IDs: {sorted(overlap)}\")\n    return errors\n\n\ndef verify_snapshot(snapshot_path: Path, run_dir: Path, schema_path: Path) -> list[str]:\n    \"\"\"Verify this snapshot and every sealed snapshot in its predecessor chain.\"\"\"\n    return _verify_snapshot(snapshot_path, run_dir, schema_path, set())\n\n\ndef _verify_snapshot(\n    snapshot_path: Path,\n    run_dir: Path,\n    schema_path: Path,\n    seen_paths: set[Path],\n) -> list[str]:\n    \"\"\"Validate schema plus source/predecessor hashes and required references.\"\"\"\n    resolved_snapshot = snapshot_path.resolve()\n    if resolved_snapshot in seen_paths:\n        return [f\"predecessor cycle detected at {snapshot_path}\"]\n    seen_paths.add(resolved_snapshot)\n    try:\n        snapshot = json.loads(snapshot_path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read snapshot: {exc}\"]\n    errors = _schema_errors(snapshot, schema_path)\n    if errors:\n        return errors\n    errors.extend(_check_semantics(snapshot))\n    errors.extend(verify_source_manifest(run_dir))\n    try:\n        manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n        if not isinstance(manifest, dict):\n            raise ValueError(\"sources.json must be an object\")\n        if manifest.get(\"run_id\") != snapshot[\"run_id\"]:\n            errors.append(\"snapshot run_id does not match sources.json run_id\")\n        files = manifest.get(\"files\", [])\n        retained_ids = {\n            record.get(\"source_id\")\n            for record in files if isinstance(record, dict)\n            if record.get(\"status\") == \"read\"\n        }\n        for claim in snapshot[\"claims\"]:\n            for line in claim[\"lines\"]:\n                missing_sources = set(line[\"source_ids\"]) - retained_ids\n                if missing_sources:\n                    errors.append(\n                        f\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\"\n                    )\n    except (OSError, json.JSONDecodeError, ValueError):\n        manifest = {}\n    source_binding = snapshot[\"source_binding\"]\n    source_path = run_dir / source_binding[\"path\"]\n    if not source_path.resolve().is_relative_to(run_dir.resolve()):\n        errors.append(\"source_binding path escapes the run directory\")\n        return errors\n    if source_path.resolve() != (run_dir / \"sources.json\").resolve():\n        errors.append(\"source_binding must identify this run's sources.json\")\n        return errors\n    try:\n        actual = sha256_bytes(source_path.read_bytes())\n    except OSError as exc:\n        errors.append(f\"Cannot read bound sources file {source_binding['path']}: {exc}\")\n    else:\n        if actual != source_binding[\"sha256\"]:\n            errors.append(\"source_binding SHA-256 does not match retained sources.json\")\n    predecessor = snapshot[\"predecessor\"]\n    if predecessor is not None:\n        previous_path = run_dir / predecessor[\"path\"]\n        if not previous_path.resolve().is_relative_to((run_dir / \"batches\").resolve()):\n            errors.append(\"predecessor path escapes the run's batches directory\")\n            return errors\n        try:\n            actual = sha256_bytes(previous_path.read_bytes())\n        except OSError as exc:\n            errors.append(f\"Cannot read predecessor {predecessor['path']}: {exc}\")\n        else:\n            if actual != predecessor[\"sha256\"]:\n                errors.append(\"predecessor SHA-256 does not match retained snapshot\")\n            else:\n                errors.extend(\n                    f\"predecessor chain: {error}\"\n                    for error in _verify_snapshot(previous_path, run_dir, schema_path, seen_paths)\n                )\n    return errors\n\n\ndef seal_batch_snapshot(\n    run_dir: Path,\n    *,\n    run_id: str,\n    batch_id: str,\n    claims: list[dict],\n    requests: list[dict],\n    travel_cancellations: list[dict],\n    admitted_event_ids: list[str],\n    issues: list[dict],\n    schema_path: Path,\n    predecessor_path: Path | None = None,\n    allow_unconfirmed_case_clock: bool = False,\n) -> Path:\n    \"\"\"Seal one batch. Binding paths are relative to the run directory.\n\n    Existing snapshots are never overwritten. The first snapshot uses a null\n    predecessor; later snapshots hash the exact prior serialized bytes.\n    \"\"\"\n    batches_dir = run_dir / \"batches\"\n    batches_dir.mkdir(parents=True, exist_ok=True)\n    if not batch_id or Path(batch_id).name != batch_id or batch_id in {\".\", \"..\"}:\n        raise ValueError(\"batch_id must be a single safe path component\")\n    target = batches_dir / f\"{batch_id}.json\"\n    if target.exists():\n        raise FileExistsError(f\"Refusing to overwrite sealed snapshot: {target}\")\n    source_path = run_dir / \"sources.json\"\n    if not source_path.is_file():\n        raise FileNotFoundError(f\"Required source manifest missing: {source_path}\")\n    source_errors = verify_source_manifest(run_dir)\n    if source_errors:\n        raise ValueError(\"Source manifest is not integrity-valid: \" + \"; \".join(source_errors))\n    manifest = json.loads(source_path.read_text(encoding=\"utf-8\"))\n    if manifest.get(\"run_id\") != run_id:\n        raise ValueError(\"Snapshot run_id must match sources.json run_id\")\n    if not manifest.get(\"case_clock\") and not allow_unconfirmed_case_clock:\n        raise ValueError(\"Cannot consume a batch without the supplied scenario case_clock\")\n    existing_snapshots = list(batches_dir.glob(\"*.json\"))\n    if existing_snapshots and predecessor_path is None:\n        raise ValueError(\"A later batch must bind its predecessor snapshot\")\n    source_rel = Path(\"sources.json\")\n    predecessor = None\n    if predecessor_path is not None:\n        predecessor_path = predecessor_path.resolve()\n        if not predecessor_path.is_file():\n            raise FileNotFoundError(f\"Predecessor snapshot missing: {predecessor_path}\")\n        if predecessor_path.parent.resolve() != batches_dir.resolve():\n            raise ValueError(\"Predecessor must be a retained snapshot in this run's batches directory\")\n        # Verify its source binding and full schema before chaining from it.\n        predecessor_errors = verify_snapshot(predecessor_path, run_dir, schema_path)\n        if predecessor_errors:\n            raise ValueError(\"Predecessor snapshot is invalid: \" + \"; \".join(predecessor_errors))\n        prior_state = json.loads(predecessor_path.read_text(encoding=\"utf-8\"))\n        if prior_state[\"run_id\"] != run_id:\n            raise ValueError(\"Predecessor snapshot belongs to a different run\")\n        chain_paths: set[Path] = set()\n        cursor = predecessor_path.resolve()\n        while cursor not in chain_paths:\n            chain_paths.add(cursor)\n            cursor_state = json.loads(cursor.read_text(encoding=\"utf-8\"))\n            previous = cursor_state[\"predecessor\"]\n            if previous is None:\n                break\n            cursor = (run_dir / previous[\"path\"]).resolve()\n        existing_paths = {path.resolve() for path in existing_snapshots}\n        if chain_paths != existing_paths:\n            raise ValueError(\"Predecessor must be the end of the complete retained snapshot chain; orphaned or missing prior state found\")\n        predecessor = {\n            \"path\": (Path(\"batches\") / predecessor_path.name).as_posix(),\n            \"sha256\": sha256_bytes(predecessor_path.read_bytes()),\n        }\n    snapshot = {\n        \"schema_version\": \"travel-claim-snapshot/2\",\n        \"run_id\": run_id,\n        \"batch_id\": batch_id,\n        \"predecessor\": predecessor,\n        \"source_binding\": {\n            \"path\": source_rel.as_posix(),\n            \"sha256\": sha256_bytes(source_path.read_bytes()),\n        },\n        \"claims\": copy.deepcopy(claims),\n        \"requests\": copy.deepcopy(requests),\n        \"travel_cancellations\": copy.deepcopy(travel_cancellations),\n        \"admitted_event_ids\": list(admitted_event_ids),\n        \"issues\": copy.deepcopy(issues),\n    }\n    errors = _schema_errors(snapshot, schema_path) + _check_semantics(snapshot)\n    if errors:\n        raise ValueError(\"Refusing to seal invalid snapshot: \" + \"; \".join(errors))\n    serialized = json.dumps(snapshot, indent=2, ensure_ascii=False) + \"\\n\"\n    # Exclusive create prevents a concurrent run from replacing prior bytes.\n    with target.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        stream.write(serialized)\n    errors = verify_snapshot(target, run_dir, schema_path)\n    if errors:\n        # Do not remove or rewrite a possibly observed sealed file. Surface the\n        # integrity failure for operator investigation.\n        raise ValueError(\"New snapshot failed post-seal integrity checks: \" + \"; \".join(errors))\n    return target\n"},"started_at_ms":1792006203639,"completed_at_ms":1792006203671}}
