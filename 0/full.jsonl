id], {\\\"ETag\\\": \\\"synthetic-fixture\\\"}, url\\n\\n    manifest = capture_sources(\\n        run_dir, run_id=run_id, case_clock=None, fetch=fetch,\\n        observed_at=iter([f\\\"2026-09-01T00:00:{i:02d}Z\\\" for i in range(10)]).__next__,\\n    )\\n    manifest_hash = hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n\\n    def claim(revision, batch):\\n        return {\\n            \\\"source_id\\\": \\\"synthetic-claim-binder\\\",\\n            \\\"source_sha256\\\": \\\"a\\\" * 64,\\n            \\\"locator\\\": f\\\"PDF page {revision} synthetic\\\",\\n            \\\"page\\\": revision,\\n            \\\"fields\\\": [\\n                {\\\"label\\\": \\\"Claim reference\\\", \\\"value\\\": \\\"C-SYN-RUN\\\"},\\n                {\\\"label\\\": \\\"Revision\\\", \\\"value\\\": str(revision)},\\n                {\\\"label\\\": \\\"Arrival batch\\\", \\\"value\\\": str(batch)},\\n                {\\\"label\\\": \\\"Trip reference\\\", \\\"value\\\": \\\"T-SYN-RUN\\\"},\\n                {\\\"label\\\": \\\"Trip revision\\\", \\\"value\\\": \\\"1\\\"},\\n            ],\\n            \\\"text\\\": \\\"SYNTHETIC TEST DATA ONLY\\\",\\n        }\\n\\n    parsed = {\\n        \\\"schema_version\\\": \\\"travel-claim-parsed-records/1\\\",\\n        \\\"run_id\\\": run_id,\\n        \\\"source_manifest\\\": {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": manifest_hash},\\n        \\\"case_clock\\\": None,\\n        \\\"case_clock_issue\\\": {\\\"owner\\\": \\\"Exercise facilitator\\\", \\\"next_action\\\": \\\"provide clock\\\"},\\n        \\\"arrival_batches\\\": [1, 2],\\n        \\\"unresolved_issues\\\": [\\n            {\\n                \\\"record_id\\\": \\\"scenario-case-clock\\\", \\\"subject_type\\\": \\\"scenario\\\",\\n                \\\"subject_id\\\": \\\"clock\\\", \\\"reason\\\": \\\"synthetic clock withheld\\\",\\n                \\\"owner\\\": \\\"Exercise facilitator\\\", \\\"next_action\\\": \\\"provide clock\\\",\\n                \\\"evidence_needed\\\": \\\"scenario clock\\\",\\n            },\\n            {\\n\\\"\\\"\\\"Schema-checked, content-addressed batch snapshots.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport copy\\nimport json\\nfrom pathlib import Path\\n\\nfrom jsonschema import Draft202012Validator, FormatChecker\\n\\nfrom .sources import sha256_bytes, verify_source_manifest\\n\\n\\ndef _schema_errors(snapshot: dict, schema_path: Path) -> list[str]:\\n    schema = json.loads(schema_path.read_text(encoding=\\\"utf-8\\\"))\\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\\n    return [\\n        f\\\"{'.'.join(map(str, err.absolute_path)) or '<root>'}: {err.message}\\\"\\n        for err in sorted(validator.iter_errors(snapshot), key=lambda e: list(map(str, e.absolute_path)))\\n    ]\\n\\n\\ndef _check_semantics(snapshot: dict) -> list[str]:\\n    errors: list[str] = []\\n    issue_ids = [issue[\\\"record_id\\\"] for issue in snapshot[\\\"issues\\\"]]\\n    if len(issue_ids) != len(set(issue_ids)):\\n        errors.append(\\\"issues[].record_id values must be unique\\\")\\n    issue_set = set(issue_ids)\\n    for cancellation in snapshot[\\\"travel_cancellations\\\"]:\\n        missing = set(cancellation[\\\"issue_record_ids\\\"]) - issue_set\\n        if missing:\\n            errors.append(f\\\"cancellation {cancellation['cancellation_id']} refers to missing issue records: {sorted(missing)}\\\")\\n    claim_ids = {claim[\\\"claim_id\\\"] for claim in snapshot[\\\"claims\\\"]}\\n    for request in snapshot[\\\"requests\\\"]:\\n        if request[\\\"claim_id\\\"] not in claim_ids:\\n            errors.append(f\\\"request {request['request_id']} refers to missing claim {request['claim_id']}\\\")\\n    cancellation_event_ids = {\\n        event_id\\n        for cancellation in snapshot[\\\"travel_cancellations\\\"]\\n        for event_id in cancellation[\\\"admitted_cancellation_event_ids\\\"]\\n    }\\n    overlap = cancellation_event_ids & set(snapshot[\\\"admitted_event_ids\\\"])\\n    if overlap:\\n        errors.append(f\\\"Finance admitted_event_ids must not contain cancellation activity IDs: {sorted(overlap)}\\\")\\n    return errors\\n\\n\\ndef verify_snapshot(snapshot_path: Path, run_dir: Path, schema_path: Path) -> list[str]:\\n    \\\"\\\"\\\"Verify this snapshot and every sealed snapshot in its predecessor chain.\\\"\\\"\\\"\\n    return _verify_snapshot(snapshot_path, run_dir, schema_path, set())\\n\\n\\ndef _verify_snapshot(\\n    snapshot_path: Path,\\n    run_dir: Path,\\n    schema_path: Path,\\n    seen_paths: set[Path],\\n) -> list[str]:\\n    \\\"\\\"\\\"Validate schema plus source/predecessor hashes and required references.\\\"\\\"\\\"\\n    resolved_snapshot = snapshot_path.resolve()\\n    if resolved_snapshot in seen_paths:\\n        return [f\\\"predecessor cycle detected at {snapshot_path}\\\"]\\n    seen_paths.add(resolved_snapshot)\\n    try:\\n        snapshot = json.loads(snapshot_path.read_text(encoding=\\\"utf-8\\\"))\\n    except (OSError, json.JSONDecodeError) as exc:\\n        return [f\\\"Cannot read snapshot: {exc}\\\"]\\n    errors = _schema_errors(snapshot, schema_path)\\n    if errors:\\n        return errors\\n    errors.extend(_check_semantics(snapshot))\\n    errors.extend(verify_source_manifest(run_dir))\\n    try:\\n        manifest = json.loads((run_dir / \\\"sources.json\\\").read_text(encoding=\\\"utf-8\\\"))\\n        if not isinstance(manifest, dict):\\n            raise ValueError(\\\"sources.json must be an object\\\")\\n        if manifest.get(\\\"run_id\\\") != snapshot[\\\"run_id\\\"]:\\n            errors.append(\\\"snapshot run_id does not match sources.json run_id\\\")\\n        files = manifest.get(\\\"files\\\", [])\\n        retained_ids = {\\n            record.get(\\\"source_id\\\")\\n            for record in files if isinstance(record, dict)\\n            if record.get(\\\"status\\\") == \\\"read\\\"\\n        }\\n        for claim in snapshot[\\\"claims\\\"]:\\n            for line in claim[\\\"lines\\\"]:\\n                missing_sources = set(line[\\\"source_ids\\\"]) - retained_ids\\n                if missing_sources:\\n                    errors.append(\\n                        f\\\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\\\"\\n\"}"},{"type":"input_text","text":"[{\"name\":\"list_mcp_resource_templates\",\"description\":\"Lists resource templates provided by MCP servers. Parameterized resource templates allow servers to \"},{\"name\":\"list_mcp_resources\",\"description\":\"Lists resources provided by MCP servers. Resources allow servers to share data that provides context\"},{\"name\":\"mcp__codex_apps__codex_document_control_get_document_tool_schemas\",\"description\":\"Use Codex Document Control to find connected document sessions, inspect the tools supported by a sel\"},{\"name\":\"mcp__codex_apps__hotline_get_local_hotline\",\"description\":\"Look up local suicide or self harm helpline information for the user based on country inferred from \"},{\"name\":\"mcp__codex_apps__plugin_management_get_app_permissions\",\"description\":\"Manage plugins, settings, permissions, and connections. Prefer available built-in tools or connected\"},{\"name\":\"mcp__codex_apps__plugin_management_get_plugin_dependencies\",\"description\":\"Manage plugins, settings, permissions, and connections. Prefer available built-in tools or connected\"},{\"name\":\"mcp__codex_apps__plugin_management_search_plugins\",\"description\":\"Manage plugins, settings, permissions, and connections. Prefer available built-in tools or connected\"},{\"name\":\"mcp__codex_apps__plugin_management_suggest_plugins\",\"description\":\"Manage plugins, settings, permissions, and connections. Prefer available built-in tools or connected\"},{\"name\":\"mcp__codex_apps__plugin_management_uninstall_app\",\"description\":\"Manage plugins, settin