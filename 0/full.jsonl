e():\n   179\t        queue.update(load_repair_queue(run_dir / \"repair-queue.json\"))\n   180\t        require(queue == state[\"repair_queue\"], \"Queue differs from replay state\")\n   181\t        retained = {r[\"source_id\"]: r for r in manifest[\"files\"] if r[\"status\"] == \"read\"}\n   182\t        for item in queue[\"items\"].values():\n   183\t            require(item[\"subject_type\"] in {\"claim\", \"trip\", \"permit\"} and isinstance(item[\"revision\"], int) and not isinstance(item[\"revision\"], bool) and item[\"revision\"] > 0, \"Invalid repair subject/revision\")\n   184\t            require(all(isinstance(item[f], str) and item[f].strip() for f in (\"subject_id\", \"owner\", \"missing_or_return_reason\", \"next_action\")), \"Missing repair trace fields\")\n   185\t            require(item[\"run_id\"] == state[\"run_id\"] and f\"batches/{item['batch_id']}.json\" in state[\"sealed_batches\"], \"Repair run/batch reference mismatch\")\n   186\t            require(item[\"request_draft\"] == {\"status\": \"draft\", \"sent\": False}, \"Repair request is not an unsent draft\")\n   187\t            require(isinstance(item[\"source_refs\"], list), \"Repair source_refs must be an array\")\n   188\t            for ref in item[\"source_refs\"]:\n   189\t                sid_hash, locator = ref.split(\"#\", 1)\n   190\t                sid, digest = sid_hash.split(\"@\", 1)\n   191\t                require(sid in retained and retained[sid][\"sha256\"] == digest and bool(locator), \"Repair source reference does not bind retained evidence\")\n   192\t                require(ref in parsed_refs, \"Repair locator is not present in retained parsed evidence\")\n   193\t    check(\"repair-queue-traceability\", [run_dir / \"repair-queue.json\", run_dir / \"offline-replay-state.json\"], queue_trace)\n   194\t\n   195\t    missing_refs = [item[\"item_id\"] for item in queue.get(\"items\", {}).values()\n   196\t                    if item.get(\"status\") == \"open\" and not item.get(\"source_refs\")]\n   197\t    add(\"repair-evidence-availability\", \"BLOCKED\" if missing_refs else \"PASS\",\n   198\t        f\"{len(missing_refs)} open repairs have no retained supporting evidence references; no evidence is invented\",\n   199\t        [run_dir / \"repair-queue.json\"], \"Obtain the evidence requested in each referenced queue item's next_action; preserve unanswered items.\" if missing_refs else \"No missing repair evidence references.\")\n   200\t    checks[-1][\"affected_item_ids\"] = missing_refs\n   201\t    open_items = [item[\"item_id\"] for item in queue.get(\"items\", {}).values() if item.get(\"status\") == \"open\"]\n   202\t    add(\"unresolved-repairs\", \"BLOCKED\" if open_items else \"PASS\", f\"{len(open_items)} repair items remain open\",\n   203\t        [run_dir / \"repair-queue.json\", run_dir / \"follow-up-drafts.md\"],\n   204\t        \"Human owners must review the unsent drafts and supply item-specific supported responses; continue independent valid work.\" if open_items else \"No open repairs.\")\n   205\t    checks[-1][\"affected_item_ids\"] = open_items\n   206\t\n   207\t    def csv_contract():\n   208\t        require(snapshots, \"No verified snapshot chain\")\n   209\t        with (run_dir / \"claims.csv\").open(encoding=\"utf-8\", newline=\"\") as stream:\n   210\t            reader = csv.DictReader(stream)\n   211\t            require(tuple(reader.fieldnames or []) == CLAIMS_COLUMNS, \"claims.csv header must match the exact required columns\")\n   212\t            rows = list(reader)\n   213\t        claims = json.loads(snapshots[-1].read_text())[\"claims\"]\n   214\t        require(len(rows) == len(claims) and len({r['claim_id'] for r in rows}) == len(rows), \"Missing or duplicated claim rows\")\n   215\t        by_id = {c[\"claim_id\"]: c for c in claims}\n   216\t        for row in rows:\n   217\t            require(None not in row and all(v is not None for v in row.values()), \"Malformed CSV row\")\n   21