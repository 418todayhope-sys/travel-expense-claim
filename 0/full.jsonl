t_revision)\n        current_claims[claim_id] = claim_revision\n    cancellation_rows = _cancellation_rows(domain, history=history, run_id=run_id, batch_id=batch_id, parsed=parsed)\n    finance_results = {}\n    for claim_id, claim_revision in current_claims.items():\n        record_set = history[\"claim\"][claim_id]\n        prior_finance = domain[\"finance_reconciliations\"].get(claim_id)\n        finance_results[claim_id] = reconcile_finance_events(\n            domain[\"finance_records\"], claim_id=claim_id,\n            current_revision=claim_revision[\"revision\"],\n            authorized_obligation=domain[\"authorized_obligations\"].get(claim_id),\n            revision_history=record_set[\"revisions\"],\n            previous_reconciliation=prior_finance,\n            source_classifications=domain[\"source_classifications\"],\n            event_context=finance_context(parsed, record_set[\"revisions\"], domain[\"finance_records\"], claim_id, arrival_batch),\n        )\n        workflow = connect_claim(parsed=parsed, claim=claim_revision, decisions=domain[\"decision_records\"],\n            finance_events=domain[\"finance_records\"], finance=finance_results[claim_id],\n            cancellations=cancellation_rows, arrival_batch=arrival_batch,\n            source_observations=source_observations or [], prior_finance=prior_finance,\n            source_classifications=domain[\"source_classifications\"])\n        finance_results[claim_id] = workflow.pop(\"finance\")\n        domain[\"ordinary_workflows\"][claim_id] = workflow\n        domain[\"ordinary_workflow_history\"].append({\"batch_id\": batch_id, \"workflow\": deepcopy(workflow)})\n    domain[\"finance_reconciliations\"] = finance_results\n    record_executed_rechecks(domain, before_batch, batch_id=batch_id)\n    _sync_finance_repairs(domain, finance_results, run_id=run_id, batch_id=batch_id)\n\n\"\"\"Regression examples transcribed verbatim from the retained native workbook.\"\"\"\n\nfrom copy import deepcopy\nimport json\nfrom pathlib import Path\n\nfrom travel_claim.finance import reconcile_finance_events as _reconcile\n\n\ndef reconcile_finance_events(*args, **kwargs):\n    kwargs.setdefault('event_context', {'requests': {'REQ-C01': {'claim_id': 'C01',\n        'payee_id': 'EMP-01', 'actor': 'FIN-01', 'currency': 'EUR'}},\n        'clock': {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}})\n    return _reconcile(*args, **kwargs)\nfrom travel_claim.integration import integrate_arrival_batch\n\nFIXTURE = Path(__file__).parent / \"fixtures/retained_finance_records.json\"\n\n\ndef _fixture():\n    parsed = json.loads(FIXTURE.read_text())\n    # Exact retained directory records extend the selected-record test fixture.\n    ordinary = json.loads((FIXTURE.parent / 'ordinary_claim_c01.json').read_text())\n    parsed['records']['people'] = next(s['records'] for s in ordinary['workbook_sheets'] if s['name'] == 'People')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # verified POL-2026.2 line 3\n    return parsed\n\n\ndef _batches(parsed):\n    prior = None\n    results = []\n    for batch in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(\n            parsed, arrival_batch=batch, run_id='retained-regression', batch_id=f'arrival-{batch:03d}',\n            source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{batch-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior,\n        )\n        results.append(prior)\n    return results\n\n\ndef test_native_obligation_fields_and_ledger_balances_do_not_become_entitlement():\n    parsed = _fixture()\n    assert 'Claim revision' not in parsed['provenance']['finance_headers']\n    results = _batches(parsed)\n    final = results[-1]\n    c1 = final['finance_reconciliations']['C01']\n    obligation = c1['recorded_obligation']\n    assert obligation['event_id'] == 'F-C01-accepted'\n    a