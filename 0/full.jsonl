\", newline=\\\"\\\\n\\\") as stream:\\n+        stream.write(drafts)\\n     report = _report(\\n         run_id=manifest[\\\"run_id\\\"], parsed=parsed, snapshots=sealed, latest=latest,\\n         output_paths=output_paths,\\n     )\\n     output_paths[\\\"report\\\"].write_text(report, encoding=\\\"utf-8\\\", newline=\\\"\\\\n\\\")\\n-    return {\\\"run_id\\\": manifest[\\\"run_id\\\"], \\\"snapshots\\\": sealed, \\\"outputs\\\": output_paths, \\\"state\\\": latest}\\n+    return {\\\"run_id\\\": manifest[\\\"run_id\\\"], \\\"snapshots\\\": sealed, \\\"outputs\\\": output_paths, \\\"state\\\": latest, \\\"draft_count\\\": draft_count}\\ndiff --git a/tests/test_offline_replay.py b/tests/test_offline_replay.py\\nindex 7f37407..a3ca84f 100644\\n--- a/tests/test_offline_replay.py\\n+++ b/tests/test_offline_replay.py\\n@@ -235,3 +235,33 @@ def test_report_separates_owner_grouped_open_repairs_and_external_blockers(tmp_p\\n     assert \\\"permit-repair\\\" not in claim_section\\n     assert \\\"subject permit `P-SYN`, revision 1\\\" in permit_section\\n     assert \\\"Next action: obtain permit evidence\\\" in permit_section\\n+\\n+\\n+def test_replay_writes_human_review_drafts_linked_from_report(tmp_path):\\n+    from travel_claim.offline_replay import run_offline_replay\\n+\\n+    run_dir, attempts = _capture(tmp_path)\\n+    before = list(attempts)\\n+    result = run_offline_replay(run_dir, schema_path=SCHEMA)\\n+    assert attempts == before\\n+    draft_path = result[\\\"outputs\\\"][\\\"drafts\\\"]\\n+    assert draft_path.name == \\\"follow-up-drafts.md\\\"\\n+    drafts = draft_path.read_text()\\n+    assert result[\\\"draft_count\\\"] == drafts.count(\\\"## Draft for \\\")\\n+    assert \\\"HUMAN REVIEW REQUIRED — NOT SENT\\\" in drafts\\n+    assert \\\"scenario-case-clock\\\" in drafts\\n+    assert \\\"reimbursement-policy-pol-2026-2\\\" in drafts\\n+    assert \\\"follow-up-drafts.md\\\" in result[\\\"outputs\\\"][\\\"report\\\"].read_text()\\n+    for item in result[\\\"state\\\"][\\\"domain\\\"][\\\"repair_queue\\\"][\\\"items\\\"].values():\\n+        assert item[\\\"request_draft\\\"] == {\\\"status\\\": \\\"draft\\\", \\\"sent\\\": False}\\n+        if item[\\\"status\\\"] == \\\"open\\\":\\n+            assert f\\\"Item `{item['item_id']}`\\\" in drafts\\n+\\n+\\n+def test_replay_refuses_existing_drafts_before_sealing_any_batches(tmp_path):\\n+    run_dir, _ = _capture(tmp_path)\\n+    draft_path = run_dir / \\\"follow-up-drafts.md\\\"\\n+    draft_path.write_text(\\\"existing reviewed draft\\\")\\n+    assert main([\\\"offline-replay\\\", str(run_dir), \\\"--schema\\\", str(SCHEMA)]) == 1\\n+    assert draft_path.read_text() == \\\"existing reviewed draft\\\"\\n+    assert not (run_dir / \\\"batches\\\").exists()\\n\\\"\\\"\\\"Render unsent owner follow-ups using only retained unresolved evidence.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom typing import Any\\n\\n\\ndef render_follow_up_drafts(\\n    *, run_id: str, queue: dict[str, Any], blockers: list[dict[str, Any]],\\n) -> tuple[str, int]:\\n    \\\"\\\"\\\"Return one human-review draft per owner, without mutating queue history.\\\"\\\"\\\"\\n    grouped: dict[str, dict[str, list[dict[str, Any]]]] = {}\\n    for item in queue[\\\"items\\\"].values():\\n        if item[\\\"status\\\"] != \\\"open\\\":\\n            continue\\n        category = \\\"Claim-specific repairs\\\" if item[\\\"subject_type\\\"] == \\\"claim\\\" else \\\"Trip/permit repairs\\\"\\n        grouped.setdefault(item[\\\"owner\\\"], {}).setdefault(category, []).append(item)\\n    for blocker in blockers:\\n        # Parser unresolved_issues has no status field; explicitly resolved\\n        # entries, if supplied, must never produce a follow-up.\\n        if blocker.get(\\\"status\\\", \\\"open\\\") != \\\"open\\\":\\n            continue\\n        grouped.setdefault(blocker[\\\"owner\\\"], {}).setdefault(\\\"External run-level blockers\\\", []).append(blocker)\\n\\n    lines = [\\n        \\\"# Project D follow-up drafts — OFFLINE REPLAY\\\", \\\"\\\",\\n        \\\"**DRAFTS — HUMAN REVIEW REQUIRED — NOT SENT.**\\\", \\\"\\\",\\n        \\\"Offline replay of retained evidence; no fresh live-source reads were performed. \\\"\\n        \\\"These drafts do not establish policy eligibility, entitlement, approvals, payment confirmations, or a case-clock date.\\\",\\n        \\\"\\\",\\n        f\\\"Run: `{run_id}`. Draft messages: **{len(grouped)}** (one per responsible owner).\\\", \\\"\\\",\\n        \\\"Independent valid records continue processing while unresolved items await evidence. \\\"\\n        \\\"Review each draft against current source evidence before any human sends it.\\\", \\\"\\\",\\n    ]\\n    categories = (\\\"Claim-specific repairs\\\", \\\"Trip/permit repairs\\\", \\\"External run-level blockers\\\")\\n    for owner, sections in sorted(grouped.items()):\\n        lines.extend([\\n            f\\\"## Draft for {owner}\\\", \\\"\\\",\\n            \\\"**DRAFT — HUMAN REVIEW REQUIRED — NOT SENT.**\\\", \\\"\\\",\\n            f\\\"Responsible owner: {owner}\\\", \\\"\\\",\\n            \\\"Please address the following unresolved items and provide evidence tied to the listed references. \\\"\\n            \\\"If an item cannot be answered, identify what remains unresolved in your response.\\\", \\\"\\\",\\n        ])\\n        for category in categories:\\n            if category not in sections:\\n                continue\\n            lines.extend([f\\\"### {category}\\\", \\\"\\\"])\\n            is_blocker = category == \\\"External run-level blockers\\\"\\n            for row in sorted(sections[category], key=lambda row: row[\\\"record_id\\\"] if is_blocker else row[\\\"item_id\\\"]):\\n                identity = row[\\\"record_id\\\"] if is_blocker else row[\\\"item_id\\\"]\\n                subject = f\\\"{row['subject_type']} `{row['subject_id']}`\\\"\\n                if not is_blocker:\\n                    subject += f\\\", revision {row['revision']}\\\"\\n                lines.extend([\\n                    f\\\"- Item `{identity}` — {subject}.\\\",\\n                    f\\\"  - Unresolved question / retained reason: {row['reason'] if is_blocker else row['missing_or_return_reason']}\\\",\\n                    f\\\"  - Requested next action: {row['next_action']}\\\",\\n                ])\\n                if is_blocker:\\n                    lines.extend([\\n                        f\\\"  - Evidence needed: {row.get('evidence_needed') or 'not specified in retained issue; human review required'}\\\",\\n                        f\\\"  - Retained issue reference: `parsed-records.json#unresolved_issues/{identity}` in run `{run_id}`.\\\",\\n                    ])\\n                else:\\n                    lines.append(f\\\"  - Queue reference: `repair-queue.json#items/{identity}`; opened in run `{row['run_id']}`, batch `{row['batch_id']}`.\\\")\\n                    refs = \\\"; \\\".join(f\\\"`{ref}`\\\" for ref in row[\\\"source_refs\\\"])\\n                    lines.append(f\\\"  - Retained evidence references: {refs or 'none retained; human review required'}\\\")\\n            lines.append(\\\"\\\")\\n    if not grouped:\\n        lines.extend([\\\"No unresolved items; no draft messages generated.\\\", \\\"\\\"])\\n    return \\\"\\\\n\\\".join(lines), len(grouped)\\n\\\"\\\"\\\"Follow-up drafts preserve evidence without sending or changing state.\\\"\\\"\\\"\\n\\nfrom copy import deepcopy\\n\\nfrom travel_claim.follow_up import render_follow_up_drafts\\nfrom travel_claim.outputs import add_repair_item, new_repair_queue\\n\\n\\ndef test_owner_drafts_group_categories_preserve_trace_and_exclude_resolved_items():\\n    queue = new_repair_queue()\\n    for identity, kind, subject, revision, owner in (\\n        (\\\"claim-1\\\", \\\"claim\\\", \\\"C1\\\", 3, \\\"Owner A\\\"),\\n        (\\\"claim-2\\\", \\\"claim\\\", \\\"C2\\\", 1, \\\"Owner B\\\"),\\n        (\\\"trip-1\\\", \\\"trip\\\", \\\"T1\\\", 2, \\\"Owner A\\\"),\\n        (\\\"permit-1\\\", \\\"permit\\\", \\\"P1\\\", 1, \\\"Owner A\\\"),\\n        (\\\"resolved-claim\\\", \\\"claim\\\", \\\"C-RESOLVED\\\", 1, \\\"Resolved Owner\\\"),\\n        (\\\"resolved-trip\\\", \\\"trip\\\", \\\"T-RESOLVED\\\", 1, \\\"Owner A\\\"),\\n    ):\\n        add_repair_item(\\n            queue, item_id=identity, subject_type=kind, subject_id=subject,\\n            revision=revision, owner=owner, source_refs=[f\\\"binder@{'a' * 64}#page {revision}\\\"],\\n            missing_or_return_reason=f\\\"retained question for {identity}\\\",\\n            next_action=f\\\"retained action for {identity}\\\", run_id=\\\"retained-run\\\", batch_id=\\\"arrival-002\\\",\\n        )\\n        if identity.startswith(\\\"resolved\\\"):\\n            queue[\\\"items\\\"][identity][\\\"status\\\"] = \\\"resolved\\\"\\n    blockers = [\\n        dict(record_id=\\\"policy\\\", subject_type=\\\"policy\\\", subject_id=\\\"POL-2026.2\\\",\\n             owner=\\\"Owner A\\\", reason=\\\"native policy unavailable\\\", next_action=\\\"obtain native policy\\\",\\n             evidence_needed=\\\"authorized policy content\\\"),\\n        dict(record_id=\\\"clock\\\", subject_type=\\\"scenario\\\", subject_id=\\\"clock\\\",\\n             owner=\\\"Facilitator\\\", reason=\\\"authoritative clock unconfirmed\\\", next_action=\\\"confirm case clock\\\",\\n             evidence_needed=\\\"authoritative date, time, timezone\\\"),\\n        dict(record_id=\\\"resolved-blocker\\\", subject_type=\\\"policy\\\", subject_id=\\\"OLD\\\",\\n             owner=\\\"Resolved Owner\\\", status=\\\"resolved\\\", reason=\\\"old issue\\\", next_action=\\\"old action\\\"),\\n    ]\\n    before = deepcopy((queue, blockers))\\n    text, count = render_follow_up_drafts(run_id=\\\"replay-run\\\", queue=queue, blockers=blockers)\\n    assert (queue, blockers) == before\\n    assert count == 3\\n    assert text.count(\\\"## Draft for \\\") == count\\n    assert text.count(\\\"**DRAFT — HUMAN REVIEW REQUIRED — NOT SENT.**\\\") == count\\n    assert \\\"Offline replay of retained evidence; no fresh live-source reads\\\" in text\\n    assert \\\"Resolved Owner\\\" not in text\\n    for identity in (\\\"resolved-claim\\\", \\\"resolved-trip\\\", \\\"C-RESOLVED\\\", \\\"T-RESOLVED\\\", \\\"resolved-blocker\\\"):\\n        assert identity not in text\\n    owner_a = text.split(\\\"## Draft for Owner A\\\\n\\\", 1)[1].split(\\\"## Draft for Owner B\\\", 1)[0]\\n    claim_section = owner_a.split(\\\"### Claim-specific repairs\\\", 1)[1].split(\\\"### Trip/permit repairs\\\", 1)[0]\\n    trip_section = owner_a.split(\\\"### Trip/permit repairs\\\", 1)[1].split(\\\"### External run-level blockers\\\", 1)[0]\\n    assert \\\"claim-1\\\" in claim_section and \\\"trip-1\\\" not in claim_section and \\\"policy\\\" not in claim_section\\n    assert \\\"trip-1\\\" in trip_section and \\\"permit-1\\\" in trip_section and \\\"claim-1\\\" not in trip_section\\n    assert \\\"### External run-level blockers\\\" in owner_a\\n    assert \\\"parsed-records.json#unresolved_issues/policy\\\" in owner_a\\n    assert \\\"authorized policy content\\\" in owner_a\\n    for item in queue[\\\"items\\\"].values():\\n        if item[\\\"status\\\"] == \\\"resolved\\\":\\n            continue\\n        owner_text = text.split(f\\\"## Draft for {item['owner']}\\\\n\\\", 1)[1].split(\\\"\\\\n## Draft for \\\", 1)[0]\\n        assert f\\\"{item['subject_type']} `{item['subject_id']}`, revision {item['revision']}\\\" in owner_text\\n        assert item[\\\"missing_or_return_reason\\\"] in owner_text\\n        assert item[\\\"next_action\\\"] in owner_text\\n        assert f\\\"repair-queue.json#items/{item['item_id']}\\\" in owner_text\\n        assert \\\"run `retained-run`, batch `arrival-002`\\\" in owner_text\\n        assert all(ref in owner_text for ref in item[\\\"source_refs\\\"])\\n    reordered = deepcopy(queue)\\n    reordered[\\\"items\\\"] = dict(reversed(list(reordered[\\\"items\\\"].items())))\\n    assert render_follow_up_drafts(run_id=\\\"replay-run\\\", queue=reordered, blockers=list(reversed(blockers))) == (text, count)\\n\\n\\ndef test_no_unresolved_items_means_no_messages_and_missing_evidence_is_explicit():\\n    queue = new_repair_queue()\\n    text, count = render_follow_up_drafts(run_id=\\\"empty\\\", queue=queue, blockers=[])\\n    assert count == 0\\n    assert \\\"No unresolved items; no draft messages generated.\\\" in text\\n    assert \\\"## Draft for \\\" not in text\\n    add_repair_item(\\n        queue, item_id=\\\"missing\\\", subject_type=\\\"claim\\\", subject_id=\\\"C1\\\", revision=1,\\n        owner=\\\"Owner\\\", source_refs=[], missing_or_return_reason=\\\"evidence missing\\\",\\n        next_action=\\\"obtain evidence\\\", run_id=\\\"run\\\", batch_id=\\\"arrival-001\\\",\\n    )\\n    text, count = render_follow_up_drafts(run_id=\\\"run\\\", queue=queue, blockers=[])\\n    assert count == 1\\n    assert \\\"Retained evidence references: none retained; human review required\\\" in text\\nmain\\n0f0acf3 feat: separate Project D repairs and run blockers\\n#!/bin/sh\\n# Entire CLI hooks\\nif command -v entire >/dev/null 2>&1; then entire hooks git prepare-commit-msg \\\"$1\\\" \\\"$2\\\" 2>/dev/null || true; else :; fi\\n#!/bin/sh\\n# Entire CLI hooks\\n# Post-commit hook: condense session data if commit has Entire-Checkpoint trailer\\nif command -v entire >/dev/null 2>&1; then entire hooks git post-commit 2>/dev/null || true; else :; fi\\n#!/bin/sh\\n# Entire CLI hooks\\n# Pre-push hook: push session logs alongside user's push\\n# $1 is the remote name (e.g., \\\"origin\\\")\\nif command -v entire >/dev/null 2>&1; then entire hooks git pre-push \\\"$1\\\"; else :; fi\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13be0-1976-7601-8575-d05090b6f8b0","create_time":1792005912.0050163}},"metadata":{"client_authored":false,"fallback_token_li