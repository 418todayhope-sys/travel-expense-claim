y = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            line['base_allowed_original_amount'] = str(allowed)\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                original = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = original\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n            if exception['status'] == 'valid':\n                replacement = Decimal(exception['replacement_original_amount'])\n                if category == 'personal' and replacement != 0:\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n                allowed = replacement\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n            apply_coverage(line['eligibility_findings'], exception)\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            line['filing_status'] = 'BLOCKED' if any(\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n                                                    for f in line['eligibility_findings']):\n                line['filing']['exception'] = deepcopy(exception)\n            if exception['status'] == 'BLOCKED':\n                raise ValueError(exception['reason'])\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n            line.update(eligibility_status='PASS', status='supported',\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n                        else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n            except (ValueError, TypeError, AttributeError):\n                permission = False\n    stage('travel_permission', permission, permission_refs,\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n\n    lines = expense_lines(record)\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n        eligibility_findings=eligibility, observations=source_observations)\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n        line['evidence_status'] == 'PASS' for line in lines)\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n    stage('supporting_evidence', evidence_ok, evidence_refs,\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n    stage('filing_deadline', filing_ok, evidence_refs,\n          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\n    for line in lines:\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n        if not policy_ok:\n            line['status'] = 'unresolved'\n    allowed = calculation['calculated_cents'] if policy_ok else None\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\n\n    for line in lines:\n        exception = line['exception']\n        if exception['status'] != 'absent':\n            stage(f\"finance_exception:{line['cost_id']}\", exception['status'] == 'valid', line['source_refs'],\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\n        for item in line['eligibility_findings']:\n            name = f\"eligibility:{line['cost_id']}:{item['issue']}\" + (f\":{item['travel_cancellation_id']}\" if item.get('travel_cancellation_id') else '')\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\n\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\n    def changed_exception_amount(line):\n        old = prior_lines.get(line['cost_id'], {})\n        return bool(old and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\n            and old.get('conversion', {}).get('allowed_original_amount') != line.get('conversion', {}).get('allowed_original_amount'))\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n        any(changed_exception_amount(line) for line in lines)\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n    replacement_review = same_revision_change or any(\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n    unique_decisions = {}; decision_conflict = False\n    for decision in current:\n        identity = fields(decision).get('Decision reference')\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n            decision_conflict = True\n        unique_decisions[identity] = (decision, payload)\n    current = [pair[0] for pair in unique_decisions.values()]\n    packets = table(parsed, 'review_packets', 'Review packets')\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n    for decision in current:\n        dv = fields(decision)\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n        pv = fields(ps[0]) if len(ps) == 1 else {}\n        roles = str(dv.get('Review roles') or '').splitlines()\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n                 and pv.get('Trip revision') == claim.get('trip_revision')\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n","exit_code":0,"duration":{"secs":0,"nanos":203532277},"formatted_output":" M README.md\n M src/travel_claim/expenses.py\n M src/travel_claim/integration.py\n M src/travel_claim/ordinary.py\n M tests/test_ordinary.py\n?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? src/travel_claim/exceptions.py\n?? tests/fixtures/retained_exception_records.json\n?? tests/test_exceptions.py\n?? user-provided-sources/\n README.md                       |  40 +++++++++++++++\n src/travel_claim/expenses.py    | 108 ++++++++++++++++++++++++----------------\n src/travel_claim/integration.py |   3 +-\n src/travel_claim/ordinary.py    |  53 +++++++++++++++++---\n tests/test_ordinary.py          |   6 ++-\n 5 files changed, 157 insertions(+), 53 deletions(-)\n\"\"\"Source-bound POL-2026.2 reimbursement exceptions, never travel authority.\n\nNative PDF display labels are mapped explicitly, not by substring or fuzzy\nmatching. Currency comes from the exception's exact claim/revision/cost line:\nPOL-2026.2 line 7 defines the replacement as an original-currency amount.\n\"\"\"\nfrom datetime import datetime\nfrom decimal import Decimal, InvalidOperation\nimport re\nfrom zoneinfo import ZoneInfo\n\nISSUES = {'late_filing', 'late_permit', 'permit_unapproved', 'travel_cancellation'}\nNATIVE_ISSUES = {'Late filing': 'late_filing', 'Late permit': 'late_permit',\n                 'Permit unapproved': 'permit_unapproved', 'Travel cancellation': 'travel_cancellation'}\nEXCEPTION_FIELDS = ('Authorizing Finance officer', 'Applies to claim', 'Applies to revision',\n                    'Expense reference', 'Allowed original amount', 'Exception reason', 'Covered issues')\n\n\ndef source_bound(row, observations):\n    return bool(row.get('source_id') and row.get('source_sha256') and row.get('locator')) and any(\n        o.get('source_id') == row['source_id'] and o.get('sha256') == row['source_sha256']\n        and o.get('status') == 'read' and not o.get('missing_scope') for o in observations)\n\n\ndef covered_issues(raw):\n    if raw == 'None':  # Exact native PDF wording for an amount-only exception.\n        return []\n    if isinstance(raw, str) and raw:\n        raw = raw.splitlines()\n    if not isinstance(raw, list) or any(not isinstance(v, str) for v in raw):\n        raise ValueError('Missing or malformed covered_issues list')\n    result = [NATIVE_ISSUES.get(v, v) for v in raw]\n    if any(v not in ISSUES for v in result) or len(set(result)) != len(result):\n        raise ValueError('Unknown or duplicate covered_issues; exact matching required')\n    return sorted(result)\n\n\ndef validate_exception(*, record, line, employee, people, observations, fields, ref):\n    value = fields(record)\n    supplied = any(key in value for key in EXCEPTION_FIELDS)\n    result = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n    if not supplied:\n        return result\n    result.update(status='BLOCKED', source_refs=[ref(record)],\n                  raw_fields={k: value.get(k) for k in EXCEPTION_FIELDS + ('Travel cancellation reference',)})\n    try:\n        labels = [f.get('label', '').strip() for f in record.get('fields', [])]\n        if any(labels.count(key) > 1 for key in EXCEPTION_FIELDS + ('Claim reference', 'Revision', 'Travel cancellation reference')):\n            raise ValueError('Repeated Finance exception authority field requires source resolution')\n        if any(key not in value for key in EXCEPTION_FIELDS):\n            raise ValueError('Missing required Finance exception field')\n        directory = [r for r in people if fields(r).get('Employee ID') == employee]\n        if not source_bound(record, observations) or len(directory) != 1 or not source_bound(directory[0], observations):\n            raise ValueError('Exception or Finance directory source binding is unverified')\n        actor = fields(directory[0]).get('Finance officer')\n        if not actor or value['Authorizing Finance officer'] != actor or actor == employee:\n            raise ValueError('Exception actor is not the directory Finance officer')\n        from .workflow import _revision\n        revision = _revision(value.get('Revision'))\n        if (not value.get('Claim reference') or value['Applies to claim'] != value['Claim reference']\n                or revision is None or _revision(value['Applies to revision']) != revision\n                or value['Expense reference'] != line['cost_id']):\n            raise ValueError('Exception claim/revision/cost authority does not match current expense')\n        if not isinstance(value['Exception reason'], str) or not value['Exception reason'].strip():\n            raise ValueError('Exception requires a documented reason')\n        amount = value['Allowed original amount']\n        if isinstance(amount, bool) or amount is None:\n            raise ValueError('Invalid replacement original amount')\n        replacement = Decimal(str(amount).replace(',', ''))\n        if not replacement.is_finite() or replacement < 0:\n            raise ValueError('Invalid replacement original amount')\n        coverage = covered_issues(value['Covered issues'])\n        cancellation = value.get('Travel cancellation reference')\n        if 'travel_cancellation' in coverage and (not isinstance(cancellation, str) or not cancellation):\n            raise ValueError('Travel cancellation exception requires exact travel_cancellation_id')\n        result.update(status='valid', actor=actor, claim_id=value['Applies to claim'], revision=revision,\n                      cost_id=line['cost_id'], currency=line['currency'], replacement_original_amount=str(replacement),\n                      reason=value['Exception reason'], covered_issues=coverage, travel_cancellation_id=cancellation,\n                      source_refs=[ref(record), ref(directory[0])])\n    except (ValueError, TypeError, InvalidOperation) as exc:\n        result['reason'] = str(exc)\n    return result\n\n\ndef finding(issue, reason, refs, cancellation_id=None):\n    return dict(issue=issue, original_finding=reason, source_refs=refs, status='unresolved',\n                travel_cancellation_id=cancellation_id, exception_source_refs=[])\n\n\ndef apply_coverage(findings, exception):\n    for item in findings:\n        if (exception['status'] == 'valid' and item['issue'] in exception['covered_issues']\n                and (item['issue'] != 'travel_cancellation'\n                     or item['travel_cancellation_id'] == exception.get('travel_cancellation_id'))):\n            item.update(status='covered_for_reimbursement', exception_source_refs=exception['source_refs'])\n    return findings\n\n\ndef travel_findings(*, trip, employee, decisions, people, cancellations, fields, ref, observations, trip_source_refs=()):\n    \"\"\"Find eligibility defects without granting or retiring arrangement authority.\"\"\"\n    result = []\n    directory = [fields(r) for r in people if fields(r).get('Employee ID') == employee]\n    if trip.get('International') is True:\n        permit = trip.get('Permit reference'); revision = trip.get('Permit revision')\n        from .workflow import _revision\n        rows = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n                and fields(r).get('Subject reference') == permit and _revision(fields(r).get('Revision')) == _revision(revision)]\n        # Exact redelivery is inert; conflicting immutable decision IDs cannot establish permission.\n        unique = {}; conflict = False\n        for r in rows:\n            v = fields(r); identity = v.get('Decision reference')\n            payload = {k: val for k, val in v.items() if k != 'Arrival batch'}\n            if not identity or identity in unique and unique[identity][1] != payload:\n                conflict = True\n            unique[identity] = (r, payload)\n        rows = [v[0] for v in unique.values()]\n        refs = list(trip_source_refs) + [ref(r) for r in rows] + [ref(r) for r in people if fields(r).get('Employee ID') == employee]\n        roles = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner', 'supervisor': 'Supervisor'}\n        try:\n            estimate = Decimal(str(trip.get('Estimate (EUR)')))\n            if not estimate.is_finite() or estimate < 0:\n                raise ValueError('Invalid reviewed estimate')\n            if estimate > 1000:\n                roles['director'] = 'Director'\n            approved = bool(permit and _revision(revision) and len(directory) == 1 and not conflict\n                            and all(source_bound(r, observations) for r in people if fields(r).get('Employee ID') == employee))\n            times = []\n            for role, label in roles.items():\n                matching = [r for r in rows if role in str(fields(r).get('Review roles', '')).splitlines()]\n                if len(matching) != 1:\n                    approved = False; continue\n                r = matching[0]; v = fields(r)\n                valid = (v.get('Outcome') == 'approve' and v.get('Reviewer') == directory[0].get(label)\n                         and v.get('Reviewer') != employee and source_bound(r, observations)) if len(directory) == 1 else False\n                approved = approved and valid\n                if valid:\n                    # XLSX column explicitly says UTC, though Excel serialization lacks an offset.\n                    time = v.get('Decision time (UTC)')\n                    if not isinstance(time, str):\n                        raise ValueError('Missing permit decision UTC time')\n                    stamp = datetime.fromisoformat(time.replace('Z', '+00:00'))\n                    if stamp.tzinfo is None:\n                        stamp = stamp.replace(tzinfo=ZoneInfo('UTC'))\n                    times.append(stamp)\n            if not approved:\n                result.append(finding('permit_unapproved', 'Matching approved permit roles are missing or invalid; cancellation does not revoke historical approvals', refs))\n            else:\n                from .expenses import local_date\n                commitment = local_date(trip.get('First commitment date'))\n                approval_day = max(times).astimezone(ZoneInfo('Europe/Amsterdam')).date()\n                if approval_day >= commitment:\n                    result.append(finding('late_permit', 'Permit approved after first commitment' if approval_day > commitment\n                                          else 'Same-day permit/commitment ordering is unconfirmed', refs))\n        except (ValueError, TypeError, InvalidOperation, KeyError) as exc:\n            result.append(finding('late_permit', f'Permit timing/amount evidence unresolved: {exc}', refs))\n    elif trip.get('International') is not False:\n        result.append(finding('permit_unapproved', 'International/permit requirement is missing', []))\n    for cancellation in cancellations:\n        from .workflow import _revision\n        current_target = (bool(trip.get('Trip reference') and _revision(trip.get('Trip revision')))\n                          and cancellation.get('trip_id') == trip.get('Trip reference')\n                          and _revision(cancellation.get('trip_revision')) == _revision(trip.get('Trip revision')))\n        if cancellation.get('target_type') == 'permit':\n            current_target = (current_target and cancellation.get('permit_id') == trip.get('Permit reference')\n                              and _revision(cancellation.get('permit_revision')) == _revision(trip.get('Permit revision')))\n        if current_target:\n            result.append(finding('travel_cancellation', 'Current travel basis has a requested or confirmed business cancellation',\n                                  list(trip_source_refs) + cancellation.get('source_refs', []), cancellation['cancellation_id']))\n    return result\n\n\ndef review_binds_exception(decision, record, *, same_revision_change, fields, ref):\n    \"\"\"Require current version evidence when a replacement changes the review basis.\n\n    Native Source revisions may name the binder's printed SRC-D-* version. A\n    same-revision source replacement needs the exact retained page/hash instead;\n    the unchanged binder label cannot establish review of changed content.\n    \"\"\"\n    versions = str(fields(decision).get('Source revisions') or '').splitlines()\n    exact = ref(record) in versions or record.get('source_sha256') in versions\n    printed = re.findall(r'\\bSRC-D-\\d+\\b', record.get('text', ''))\n    return exact or (not same_revision_change and any(v in versions for v in printed))\ndef number(value):\n    if isinstance(value, bool) or value is None:\n        raise ValueError('Missing or invalid number')\n    result = Decimal(str(value).replace(',', ''))\n    if not result.is_finite() or result < 0:\n        raise ValueError('Invalid amount')\n    return result\n\n\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\n    \"\"\"Evaluate each line independently, retaining unresolved evidence and reasons.\"\"\"\n    binding = parsed.get('expense_policy')\n    verified = policy_valid(binding)\n    policy_refs = [f\"{binding.get('path')}@{POLICY_SHA256}#line {n}\" for n in (5, 7, 11)] if verified else []\n    receipts = parsed.get('records', {}).get('receipts', [])\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\n    rates = table(parsed, 'fx_rates', 'FX')\n    caps = table(parsed, 'caps', 'Caps')\n    observations = parsed.get('source_observations', []) if observations is None else observations\n    people = table(parsed, 'people', 'People')\n    for line in lines:\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\n        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\n        line['eligibility_status'] = 'BLOCKED'\n        exception = validate_exception(record=record, line=line, employee=employee, people=people,\n            observations=observations, fields=fields, ref=ref)\n        # An exception for another *present* cost has no effect on this line.\n        target = fields(record).get('Expense reference')\n        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\n            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\n        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\n                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\n                            for f in line['eligibility_findings'])):\n            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\n        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\n        line['exception'] = exception\n        line['source_refs'] += exception['source_refs']\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\n        try:\n            gross = number(line['original_amount'])\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\n                raise ValueError('Missing receipt or nonpositive purchase')\n            rv = fields(rs[0])\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\n                    and line['currency'].isalpha() and line['currency'].isupper()):\n                raise ValueError('Receipt identity, currency or gross mismatch')\n            unique = {}\n            for row in ms:\n                mv = fields(row); identity = mv.get('Transaction reference')\n                # Identity is global: a redelivery under a different cost also conflicts.\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\n                if not identity or any(d != mv for d in deliveries):\n                    raise ValueError('Conflicting merchant transaction identity')\n                unique[identity] = row\n            ms = list(unique.values())\n            if not ms:\n                raise ValueError('Missing settled merchant transaction')\n            for row in ms:\n                mv = fields(row)\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\n                    raise ValueError('Merchant payment is unsettled or mismatched')\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\n                raise ValueError('Merchant payments do not match gross amount')\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\n            if not verified:\n                raise ValueError('Verified expense policy binding required')\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\n            if len(dates) != 1:\n                raise ValueError('Multiple payment dates require source-supported allocation')\n            paid = local_date(dates[0])\n            if paid.year != 2026:\n                raise ValueError('Payment outside supplied policy effective year')\n            category = rv.get('Category')\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\n                raise ValueError('Unknown expense category')\n            allowed = Decimal(0) if category == 'personal' else gross\n            cap_evidence = None\n            if category in {'lodging', 'meals'}:\n                if not trip.get('Destination'):\n                    raise ValueError('Missing destination for applicable cap')\n                units = number(rv.get('Documented units'))\n                if units <= 0 or units != units.to_integral_value():\n                    raise ValueError('Capped units must be positive integers')\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\n                if len(cs) != 1:\n                    raise ValueError('Missing or ambiguous applicable cap')\n                cap = number(fields(cs[0]).get('Amount per unit'))\n                with localcontext() as ctx:\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\n                    allowed = min(gross, cap * units)\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\n                line['source_refs'].append(ref(cs[0]))\n            line['base_allowed_original_amount'] = str(allowed)\n            deadline = filing_deadline(trip.get('End date'))\n            submitted = local_date(line['first_submitted_date'])\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\n            from .ordinary import expense_lines\n            first_supported = False\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\n                pr = prior.get('record', {})\n                for old in expense_lines(pr):\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\n                            and number(old['original_amount']) == gross):\n                        submitted = local_date(old['first_submitted_date'])\n                        line['source_refs'] += old['source_refs']\n                        first_supported = True\n                        break\n                if first_supported:\n                    break\n            if submitted > local_date(fields(record).get('Submitted date')):\n                raise ValueError('Cost submission is later than claim submission')\n            if submitted < paid:\n                raise ValueError('Submission precedes established employee payment')\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\n            if submitted > deadline:\n                original = 'Late filing held pending explicit version-bound Finance exception'\n                line['filing']['original_finding'] = original\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\n            if exception['status'] == 'valid':\n                replacement = Decimal(exception['replacement_original_amount'])\n                if category == 'personal' and replacement != 0:\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\n                allowed = replacement\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\n            apply_coverage(line['eligibility_findings'], exception)\n            if line['currency'] == 'EUR':\n                rate = Decimal(1); rate_refs = policy_refs\n            else:\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\n                      and local_date(fields(r).get('Rate date')) == paid]\n                if len(fx) != 1:\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\n                if rate <= 0:\n                    raise ValueError('FX rate must be positive')\n            with localcontext() as ctx:\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\n                converted = allowed * rate\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\n            line['source_refs'] += rate_refs\n            line.update(calculated_cents=cents, calculation_status='PASS',\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\n            line['filing_status'] = 'BLOCKED' if any(\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\n                                                    for f in line['eligibility_findings']):\n                line['filing']['exception'] = deepcopy(exception)\n            if exception['status'] == 'BLOCKED':\n                raise ValueError(exception['reason'])\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\n            line.update(eligibility_status='PASS', status='supported',\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\n                        else 'Supported paid expense calculation and timely filing')\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\n            line['reason'] = str(exc)\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\n    return dict(status='PASS' if complete else 'BLOCKED',\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\n                policy_source_refs=policy_refs, policy_verified=verified)\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n            except (ValueError, TypeError, AttributeError):\n                permission = False\n    stage('travel_permission', permission, permission_refs,\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n\n    lines = expense_lines(record)\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n        eligibility_findings=eligibility, observations=source_observations)\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n        line['evidence_status'] == 'PASS' for line in lines)\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n    stage('supporting_evidence', evidence_ok, evidence_refs,\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n    stage('filing_deadline', filing_ok, evidence_refs,\n          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\n    for line in lines:\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n        if not policy_ok:\n            line['status'] = 'unresolved'\n    allowed = calculation['calculated_cents'] if policy_ok else None\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\n\n    for line in lines:\n        exception = line['exception']\n        if exception['status'] != 'absent':\n            stage(f\"finance_exception:{line['cost_id']}\", exception['status'] == 'valid', line['source_refs'],\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\n        for item in line['eligibility_findings']:\n            name = f\"eligibility:{line['cost_id']}:{item['issue']}\" + (f\":{item['travel_cancellation_id']}\" if item.get('travel_cancellation_id') else '')\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\n\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\n    def changed_exception_amount(line):\n        old = prior_lines.get(line['cost_id'], {})\n        return bool(old and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\n            and old.get('conversion', {}).get('allowed_original_amount') != line.get('conversion', {}).get('allowed_original_amount'))\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n        any(changed_exception_amount(line) for line in lines)\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n    replacement_review = same_revision_change or any(\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n    unique_decisions = {}; decision_conflict = False\n    for decision in current:\n        identity = fields(decision).get('Decision reference')\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n            decision_conflict = True\n        unique_decisions[identity] = (decision, payload)\n    current = [pair[0] for pair in unique_decisions.values()]\n    packets = table(parsed, 'review_packets', 'Review packets')\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n    for decision in current:\n        dv = fields(decision)\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n        pv = fields(ps[0]) if len(ps) == 1 else {}\n        roles = str(dv.get('Review roles') or '').splitlines()\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n                 and pv.get('Trip revision') == claim.get('trip_revision')\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n"},"started_at_ms":1792023919837,"completed_at_ms":1792023920042}}
{"timestamp":"2026-10-15T00:25:20.874Z","ordinal":2684,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13cf3-00ea-71e3-8ee6-0b291bd133ae","call_id":"call_90a448546ef74b898250ca24f8603089","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"eb4634\",\"wall_time_seconds\":0.203440107,\"exit_code\":0,\"original_token_count\":7986,\"output\":\" M README.md\\n M src/travel_claim/expenses.py\\n M src/travel_claim/integration.py\\n M src/travel_claim/ordinary.py\\n M tests/test_ordinary.py\\n?? artifacts/runs/\\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\\n?? artifacts/verification/project-d-readiness-efc7e91/\\n?? artifacts/verification/project-d-step157-revalidation/\\n?? artifacts/verification/project-d-step167-audit-probes.json\\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\\n?? src/travel_claim/exceptions.py\\n?? tests/fixtures/retained_exception_records.json\\n?? tests/test_exceptions.py\\n?? user-provided-sources/\\n README.md                       |  40 +++++++++++++++\\n src/travel_claim/expenses.py    | 108 ++++++++++++++++++++++++----------------\\n src/travel_claim/integration.py |   3 +-\\n src/travel_claim/ordinary.py    |  53 +++++++++++++++++---\\n tests/test_ordinary.py          |   6 ++-\\n 5 files changed, 157 insertions(+), 53 deletions(-)\\n\\\"\\\"\\\"Source-bound POL-2026.2 reimbursement exceptions, never travel authority.\\n\\nNative PDF display labels are mapped explicitly, not by substring or fuzzy\\nmatching. Currency comes from the exception's exact claim/revision/cost line:\\nPOL-2026.2 line 7 defines the replacement as an original-currency amount.\\n\\\"\\\"\\\"\\nfrom datetime import datetime\\nfrom decimal import Decimal, InvalidOperation\\nimport re\\nfrom zoneinfo import ZoneInfo\\n\\nISSUES = {'late_filing', 'late_permit', 'permit_unapproved', 'travel_cancellation'}\\nNATIVE_ISSUES = {'Late filing': 'late_filing', 'Late permit': 'late_permit',\\n                 'Permit unapproved': 'permit_unapproved', 'Travel cancellation': 'travel_cancellation'}\\nEXCEPTION_FIELDS = ('Authorizing Finance officer', 'Applies to claim', 'Applies to revision',\\n                    'Expense reference', 'Allowed original amount', 'Exception reason', 'Covered issues')\\n\\n\\ndef source_bound(row, observations):\\n    return bool(row.get('source_id') and row.get('source_sha256') and row.get('locator')) and any(\\n        o.get('source_id') == row['source_id'] and o.get('sha256') == row['source_sha256']\\n        and o.get('status') == 'read' and not o.get('missing_scope') for o in observations)\\n\\n\\ndef covered_issues(raw):\\n    if raw == 'None':  # Exact native PDF wording for an amount-only exception.\\n        return []\\n    if isinstance(raw, str) and raw:\\n        raw = raw.splitlines()\\n    if not isinstance(raw, list) or any(not isinstance(v, str) for v in raw):\\n        raise ValueError('Missing or malformed covered_issues list')\\n    result = [NATIVE_ISSUES.get(v, v) for v in raw]\\n    if any(v not in ISSUES for v in result) or len(set(result)) != len(result):\\n        raise ValueError('Unknown or duplicate covered_issues; exact matching required')\\n    return sorted(result)\\n\\n\\ndef validate_exception(*, record, line, employee, people, observations, fields, ref):\\n    value = fields(record)\\n    supplied = any(key in value for key in EXCEPTION_FIELDS)\\n    result = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\\n    if not supplied:\\n        return result\\n    result.update(status='BLOCKED', source_refs=[ref(record)],\\n                  raw_fields={k: value.get(k) for k in EXCEPTION_FIELDS + ('Travel cancellation reference',)})\\n    try:\\n        labels = [f.get('label', '').strip() for f in record.get('fields', [])]\\n        if any(labels.count(key) > 1 for key in EXCEPTION_FIELDS + ('Claim reference', 'Revision', 'Travel cancellation reference')):\\n            raise ValueError('Repeated Finance exception authority field requires source resolution')\\n        if any(key not in value for key in EXCEPTION_FIELDS):\\n            raise ValueError('Missing required Finance exception field')\\n        directory = [r for r in people if fields(r).get('Employee ID') == employee]\\n        if not source_bound(record, observations) or len(directory) != 1 or not source_bound(directory[0], observations):\\n            raise ValueError('Exception or Finance directory source binding is unverified')\\n        actor = fields(directory[0]).get('Finance officer')\\n        if not actor or value['Authorizing Finance officer'] != actor or actor == employee:\\n            raise ValueError('Exception actor is not the directory Finance officer')\\n        from .workflow import _revision\\n        revision = _revision(value.get('Revision'))\\n        if (not value.get('Claim reference') or value['Applies to claim'] != value['Claim reference']\\n                or revision is None or _revision(value['Applies to revision']) != revision\\n                or value['Expense reference'] != line['cost_id']):\\n            raise ValueError('Exception claim/revision/cost authority does not match current expense')\\n        if not isinstance(value['Exception reason'], str) or not value['Exception reason'].strip():\\n            raise ValueError('Exception requires a documented reason')\\n        amount = value['Allowed original amount']\\n        if isinstance(amount, bool) or amount is None:\\n            raise ValueError('Invalid replacement original amount')\\n        replacement = Decimal(str(amount).replace(',', ''))\\n        if not replacement.is_finite() or replacement < 0:\\n            raise ValueError('Invalid replacement original amount')\\n        coverage = covered_issues(value['Covered issues'])\\n        cancellation = value.get('Travel cancellation reference')\\n        if 'travel_cancellation' in coverage and (not isinstance(cancellation, str) or not cancellation):\\n            raise ValueError('Travel cancellation exception requires exact travel_cancellation_id')\\n        result.update(status='valid', actor=actor, claim_id=value['Applies to claim'], revision=revision,\\n                      cost_id=line['cost_id'], currency=line['currency'], replacement_original_amount=str(replacement),\\n                      reason=value['Exception reason'], covered_issues=coverage, travel_cancellation_id=cancellation,\\n                      source_refs=[ref(record), ref(directory[0])])\\n    except (ValueError, TypeError, InvalidOperation) as exc:\\n        result['reason'] = str(exc)\\n    return result\\n\\n\\ndef finding(issue, reason, refs, cancellation_id=None):\\n    return dict(issue=issue, original_finding=reason, source_refs=refs, status='unresolved',\\n                travel_cancellation_id=cancellation_id, exception_source_refs=[])\\n\\n\\ndef apply_coverage(findings, exception):\\n    for item in findings:\\n        if (exception['status'] == 'valid' and item['issue'] in exception['covered_issues']\\n                and (item['issue'] != 'travel_cancellation'\\n                     or item['travel_cancellation_id'] == exception.get('travel_cancellation_id'))):\\n            item.update(status='covered_for_reimbursement', exception_source_refs=exception['source_refs'])\\n    return findings\\n\\n\\ndef travel_findings(*, trip, employee, decisions, people, cancellations, fields, ref, observations, trip_source_refs=()):\\n    \\\"\\\"\\\"Find eligibility defects without granting or retiring arrangement authority.\\\"\\\"\\\"\\n    result = []\\n    directory = [fields(r) for r in people if fields(r).get('Employee ID') == employee]\\n    if trip.get('International') is True:\\n        permit = trip.get('Permit reference'); revision = trip.get('Permit revision')\\n        from .workflow import _revision\\n        rows = [r for r in decisions if fields(r).get('Subject type') == 'permit'\\n                and fields(r).get('Subject reference') == permit and _revision(fields(r).get('Revision')) == _revision(revision)]\\n        # Exact redelivery is inert; conflicting immutable decision IDs cannot establish permission.\\n        unique = {}; conflict = False\\n        for r in rows:\\n            v = fields(r); identity = v.get('Decision reference')\\n            payload = {k: val for k, val in v.items() if k != 'Arrival batch'}\\n            if not identity or identity in unique and unique[identity][1] != payload:\\n                conflict = True\\n            unique[identity] = (r, payload)\\n        rows = [v[0] for v in unique.values()]\\n        refs = list(trip_source_refs) + [ref(r) for r in rows] + [ref(r) for r in people if fields(r).get('Employee ID') == employee]\\n        roles = {'administration': 'Administration reviewer', 'budget_owner': 'Budget owner', 'supervisor': 'Supervisor'}\\n        try:\\n            estimate = Decimal(str(trip.get('Estimate (EUR)')))\\n            if not estimate.is_finite() or estimate < 0:\\n                raise ValueError('Invalid reviewed estimate')\\n            if estimate > 1000:\\n                roles['director'] = 'Director'\\n            approved = bool(permit and _revision(revision) and len(directory) == 1 and not conflict\\n                            and all(source_bound(r, observations) for r in people if fields(r).get('Employee ID') == employee))\\n            times = []\\n            for role, label in roles.items():\\n                matching = [r for r in rows if role in str(fields(r).get('Review roles', '')).splitlines()]\\n                if len(matching) != 1:\\n                    approved = False; continue\\n                r = matching[0]; v = fields(r)\\n                valid = (v.get('Outcome') == 'approve' and v.get('Reviewer') == directory[0].get(label)\\n                         and v.get('Reviewer') != employee and source_bound(r, observations)) if len(directory) == 1 else False\\n                approved = approved and valid\\n                if valid:\\n                    # XLSX column explicitly says UTC, though Excel serialization lacks an offset.\\n                    time = v.get('Decision time (UTC)')\\n                    if not isinstance(time, str):\\n                        raise ValueError('Missing permit decision UTC time')\\n                    stamp = datetime.fromisoformat(time.replace('Z', '+00:00'))\\n                    if stamp.tzinfo is None:\\n                        stamp = stamp.replace(tzinfo=ZoneInfo('UTC'))\\n                    times.append(stamp)\\n            if not approved:\\n                result.append(finding('permit_unapproved', 'Matching approved permit roles are missing or invalid; cancellation does not revoke historical approvals', refs))\\n            else:\\n                from .expenses import local_date\\n                commitment = local_date(trip.get('First commitment date'))\\n                approval_day = max(times).astimezone(ZoneInfo('Europe/Amsterdam')).date()\\n                if approval_day >= commitment:\\n                    result.append(finding('late_permit', 'Permit approved after first commitment' if approval_day > commitment\\n                                          else 'Same-day permit/commitment ordering is unconfirmed', refs))\\n        except (ValueError, TypeError, InvalidOperation, KeyError) as exc:\\n            result.append(finding('late_permit', f'Permit timing/amount evidence unresolved: {exc}', refs))\\n    elif trip.get('International') is not False:\\n        result.append(finding('permit_unapproved', 'International/permit requirement is missing', []))\\n    for cancellation in cancellations:\\n        from .workflow import _revision\\n        current_target = (bool(trip.get('Trip reference') and _revision(trip.get('Trip revision')))\\n                          and cancellation.get('trip_id') == trip.get('Trip reference')\\n                          and _revision(cancellation.get('trip_revision')) == _revision(trip.get('Trip revision')))\\n        if cancellation.get('target_type') == 'permit':\\n            current_target = (current_target and cancellation.get('permit_id') == trip.get('Permit reference')\\n                              and _revision(cancellation.get('permit_revision')) == _revision(trip.get('Permit revision')))\\n        if current_target:\\n            result.append(finding('travel_cancellation', 'Current travel basis has a requested or confirmed business cancellation',\\n                                  list(trip_source_refs) + cancellation.get('source_refs', []), cancellation['cancellation_id']))\\n    return result\\n\\n\\ndef review_binds_exception(decision, record, *, same_revision_change, fields, ref):\\n    \\\"\\\"\\\"Require current version evidence when a replacement changes the review basis.\\n\\n    Native Source revisions may name the binder's printed SRC-D-* version. A\\n    same-revision source replacement needs the exact retained page/hash instead;\\n    the unchanged binder label cannot establish review of changed content.\\n    \\\"\\\"\\\"\\n    versions = str(fields(decision).get('Source revisions') or '').splitlines()\\n    exact = ref(record) in versions or record.get('source_sha256') in versions\\n    printed = re.findall(r'\\\\bSRC-D-\\\\d+\\\\b', record.get('text', ''))\\n    return exact or (not same_revision_change and any(v in versions for v in printed))\\ndef number(value):\\n    if isinstance(value, bool) or value is None:\\n        raise ValueError('Missing or invalid number')\\n    result = Decimal(str(value).replace(',', ''))\\n    if not result.is_finite() or result < 0:\\n        raise ValueError('Invalid amount')\\n    return result\\n\\n\\ndef evaluate_expenses(*, lines, parsed, employee, trip_id, trip, record, history, fields, ref, table, eligibility_findings=None, observations=None):\\n    \\\"\\\"\\\"Evaluate each line independently, retaining unresolved evidence and reasons.\\\"\\\"\\\"\\n    binding = parsed.get('expense_policy')\\n    verified = policy_valid(binding)\\n    policy_refs = [f\\\"{binding.get('path')}@{POLICY_SHA256}#line {n}\\\" for n in (5, 7, 11)] if verified else []\\n    receipts = parsed.get('records', {}).get('receipts', [])\\n    merchants = table(parsed, 'merchant_payments', 'Merchant payments')\\n    rates = table(parsed, 'fx_rates', 'FX')\\n    caps = table(parsed, 'caps', 'Caps')\\n    observations = parsed.get('source_observations', []) if observations is None else observations\\n    people = table(parsed, 'people', 'People')\\n    for line in lines:\\n        line.update(allowed_cents=None, calculated_cents=None, status='unresolved', evidence_status='BLOCKED',\\n                    filing_status='BLOCKED', calculation_status='BLOCKED', reason='Missing or conflicting evidence')\\n        line['eligibility_findings'] = deepcopy(eligibility_findings or [])\\n        line['eligibility_status'] = 'BLOCKED'\\n        exception = validate_exception(record=record, line=line, employee=employee, people=people,\\n            observations=observations, fields=fields, ref=ref)\\n        # An exception for another *present* cost has no effect on this line.\\n        target = fields(record).get('Expense reference')\\n        if target != line['cost_id'] and target in {l['cost_id'] for l in lines}:\\n            exception = dict(status='absent', source_refs=[], covered_issues=[], raw_fields={})\\n        if (exception['status'] == 'valid' and 'travel_cancellation' in exception['covered_issues']\\n                and not any(f['issue'] == 'travel_cancellation' and f.get('travel_cancellation_id') == exception.get('travel_cancellation_id')\\n                            for f in line['eligibility_findings'])):\\n            exception.update(status='BLOCKED', reason='Exception cancellation reference does not match an affected current expense')\\n        line['source_refs'] += [r for f in line['eligibility_findings'] for r in f['source_refs']]\\n        line['exception'] = exception\\n        line['source_refs'] += exception['source_refs']\\n        rs = [r for r in receipts if fields(r).get('Receipt reference') == line['receipt_id']]\\n        ms = [r for r in merchants if fields(r).get('Expense reference') == line['cost_id']]\\n        line['source_refs'] += [ref(r) for r in rs + ms] + policy_refs\\n        try:\\n            gross = number(line['original_amount'])\\n            if not employee or not trip_id or gross <= 0 or len(rs) != 1:\\n                raise ValueError('Missing receipt or nonpositive purchase')\\n            rv = fields(rs[0])\\n            if not (rv.get('Expense reference') == line['cost_id'] and rv.get('Employee') == employee\\n                    and rv.get('Trip reference') == trip_id and rv.get('Currency') == line['currency']\\n                    and number(rv.get('Gross amount')) == gross and len(line['currency']) == 3\\n                    and line['currency'].isalpha() and line['currency'].isupper()):\\n                raise ValueError('Receipt identity, currency or gross mismatch')\\n            unique = {}\\n            for row in ms:\\n                mv = fields(row); identity = mv.get('Transaction reference')\\n                # Identity is global: a redelivery under a different cost also conflicts.\\n                deliveries = [fields(r) for r in merchants if fields(r).get('Transaction reference') == identity]\\n                if not identity or any(d != mv for d in deliveries):\\n                    raise ValueError('Conflicting merchant transaction identity')\\n                unique[identity] = row\\n            ms = list(unique.values())\\n            if not ms:\\n                raise ValueError('Missing settled merchant transaction')\\n            for row in ms:\\n                mv = fields(row)\\n                if not (mv.get('Employee ID') == employee and mv.get('Trip reference') == trip_id\\n                        and mv.get('Receipt reference') == line['receipt_id'] and mv.get('Currency') == line['currency']\\n                        and mv.get('Payment status') == 'settled' and number(mv.get('Gross amount')) > 0):\\n                    raise ValueError('Merchant payment is unsettled or mismatched')\\n            if sum(number(fields(m).get('Gross amount')) for m in ms) != gross:\\n                raise ValueError('Merchant payments do not match gross amount')\\n            dates = sorted({local_date(fields(m).get('Paid date')).isoformat() for m in ms})\\n            line.update(evidence_status='PASS', category=rv.get('Category'), documented_units=rv.get('Documented units'), paid_dates=dates)\\n            if not verified:\\n                raise ValueError('Verified expense policy binding required')\\n            # Different payment dates require an explicit allocation; do not choose a rate/cap.\\n            if len(dates) != 1:\\n                raise ValueError('Multiple payment dates require source-supported allocation')\\n            paid = local_date(dates[0])\\n            if paid.year != 2026:\\n                raise ValueError('Payment outside supplied policy effective year')\\n            category = rv.get('Category')\\n            if category not in {'personal', 'transport', 'conference', 'lodging', 'meals'}:\\n                raise ValueError('Unknown expense category')\\n            allowed = Decimal(0) if category == 'personal' else gross\\n            cap_evidence = None\\n            if category in {'lodging', 'meals'}:\\n                if not trip.get('Destination'):\\n                    raise ValueError('Missing destination for applicable cap')\\n                units = number(rv.get('Documented units'))\\n                if units <= 0 or units != units.to_integral_value():\\n                    raise ValueError('Capped units must be positive integers')\\n                cs = [c for c in caps if fields(c).get('Destination') == trip.get('Destination')\\n                      and fields(c).get('Category') == category and fields(c).get('Currency') == line['currency']]\\n                cs = [c for c in cs if local_date(fields(c).get('Effective from')) <= paid <= local_date(fields(c).get('Effective to'))]\\n                if len(cs) != 1:\\n                    raise ValueError('Missing or ambiguous applicable cap')\\n                cap = number(fields(cs[0]).get('Amount per unit'))\\n                with localcontext() as ctx:\\n                    ctx.prec = max(50, len(str(cap)) + len(str(units)) + 20)\\n                    allowed = min(gross, cap * units)\\n                cap_evidence = dict(amount_per_unit=str(cap), units=str(units), source_ref=ref(cs[0]))\\n                line['source_refs'].append(ref(cs[0]))\\n            line['base_allowed_original_amount'] = str(allowed)\\n            deadline = filing_deadline(trip.get('End date'))\\n            submitted = local_date(line['first_submitted_date'])\\n            # Earlier, unchanged cost submissions remain authoritative after a correction.\\n            from .ordinary import expense_lines\\n            first_supported = False\\n            for prior in sorted(history, key=lambda r: int(r.get('revision', 0))):\\n                pr = prior.get('record', {})\\n                for old in expense_lines(pr):\\n                    if (fields(pr).get('Employee') == employee and fields(pr).get('Trip reference') == trip_id\\n                            and all(old.get(k) == line.get(k) for k in ('cost_id', 'receipt_id', 'currency'))\\n                            and number(old['original_amount']) == gross):\\n                        submitted = local_date(old['first_submitted_date'])\\n                        line['source_refs'] += old['source_refs']\\n                        first_supported = True\\n                        break\\n                if first_supported:\\n                    break\\n            if submitted > local_date(fields(record).get('Submitted date')):\\n                raise ValueError('Cost submission is later than claim submission')\\n            if submitted < paid:\\n                raise ValueError('Submission precedes established employee payment')\\n            line['filing'] = dict(first_submission_date=submitted.isoformat(), deadline=deadline.isoformat(),\\n                                  inclusive=True, source_refs=[ref(record)] + policy_refs)\\n            if submitted > deadline:\\n                original = 'Late filing held pending explicit version-bound Finance exception'\\n                line['filing']['original_finding'] = original\\n                line['eligibility_findings'].append(finding('late_filing', original, [ref(record)] + policy_refs))\\n            if exception['status'] == 'valid':\\n                replacement = Decimal(exception['replacement_original_amount'])\\n                if category == 'personal' and replacement != 0:\\n                    raise ValueError('Exception cannot turn a personal purchase into reimbursable business cost')\\n                allowed = replacement\\n                line['replacement_amount_changed'] = allowed != Decimal(line['base_allowed_original_amount'])\\n            apply_coverage(line['eligibility_findings'], exception)\\n            if line['currency'] == 'EUR':\\n                rate = Decimal(1); rate_refs = policy_refs\\n            else:\\n                fx = [r for r in rates if fields(r).get('Currency') == line['currency']\\n                      and local_date(fields(r).get('Rate date')) == paid]\\n                if len(fx) != 1:\\n                    raise ValueError('Missing or ambiguous payment-date Finance FX rate')\\n                rate = number(fields(fx[0]).get('EUR per currency unit')); rate_refs = [ref(fx[0])]\\n                if rate <= 0:\\n                    raise ValueError('FX rate must be positive')\\n            with localcontext() as ctx:\\n                ctx.prec = max(50, len(str(gross)) + len(str(rate)) + 20)\\n                converted = allowed * rate\\n                cents = int((converted * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP))\\n            line['source_refs'] += rate_refs\\n            line.update(calculated_cents=cents, calculation_status='PASS',\\n                        conversion=dict(original_amount=str(gross), allowed_original_amount=str(allowed),\\n                                        currency=line['currency'], payment_date=paid.isoformat(), eur_rate=str(rate),\\n                                        unrounded_eur=str(converted), rounded_cents=cents, rounding='ROUND_HALF_UP',\\n                                        rate_source_refs=rate_refs, cap=cap_evidence))\\n            line['filing_status'] = 'BLOCKED' if any(\\n                f['issue'] == 'late_filing' and f['status'] == 'unresolved' for f in line['eligibility_findings']) else 'PASS'\\n            if exception['status'] == 'valid' and any(f['issue'] == 'late_filing' and f['status'] == 'covered_for_reimbursement'\\n                                                    for f in line['eligibility_findings']):\\n                line['filing']['exception'] = deepcopy(exception)\\n            if exception['status'] == 'BLOCKED':\\n                raise ValueError(exception['reason'])\\n            if any(f['status'] == 'unresolved' for f in line['eligibility_findings']):\\n                raise ValueError('; '.join(f['original_finding'] for f in line['eligibility_findings'] if f['status'] == 'unresolved'))\\n            line.update(eligibility_status='PASS', status='supported',\\n                        reason='Supported paid expense; exact Finance coverage retained' if exception['status'] == 'valid'\\n                        else 'Supported paid expense calculation and timely filing')\\n        except (ValueError, TypeError, InvalidOperation, OverflowError) as exc:\\n            line['reason'] = str(exc)\\n    complete = bool(lines) and len({l['cost_id'] for l in lines}) == len(lines) and all(\\n        l['calculation_status'] == l['filing_status'] == l['eligibility_status'] == 'PASS' for l in lines)\\n    return dict(status='PASS' if complete else 'BLOCKED',\\n                calculated_cents=sum(l['calculated_cents'] for l in lines) if complete else None,\\n                policy_source_refs=policy_refs, policy_verified=verified)\\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\\n            except (ValueError, TypeError, AttributeError):\\n                permission = False\\n    stage('travel_permission', permission, permission_refs,\\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\\n\\n    lines = expense_lines(record)\\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\\n        eligibility_findings=eligibility, observations=source_observations)\\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\\n        line['evidence_status'] == 'PASS' for line in lines)\\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\\n    stage('supporting_evidence', evidence_ok, evidence_refs,\\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\\n    stage('filing_deadline', filing_ok, evidence_refs,\\n          '; '.join(f\\\"{line['cost_id']}: {line['reason']}\\\" for line in lines) or 'Missing expense submissions',\\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\\n    for line in lines:\\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\\n        if not policy_ok:\\n            line['status'] = 'unresolved'\\n    allowed = calculation['calculated_cents'] if policy_ok else None\\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\\n\\n    for line in lines:\\n        exception = line['exception']\\n        if exception['status'] != 'absent':\\n            stage(f\\\"finance_exception:{line['cost_id']}\\\", exception['status'] == 'valid', line['source_refs'],\\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\\n        for item in line['eligibility_findings']:\\n            name = f\\\"eligibility:{line['cost_id']}:{item['issue']}\\\" + (f\\\":{item['travel_cancellation_id']}\\\" if item.get('travel_cancellation_id') else '')\\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\\n\\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\\n    def changed_exception_amount(line):\\n        old = prior_lines.get(line['cost_id'], {})\\n        return bool(old and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\\n            and old.get('conversion', {}).get('allowed_original_amount') != line.get('conversion', {}).get('allowed_original_amount'))\\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\\n        any(changed_exception_amount(line) for line in lines)\\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\\n    replacement_review = same_revision_change or any(\\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\\n    unique_decisions = {}; decision_conflict = False\\n    for decision in current:\\n        identity = fields(decision).get('Decision reference')\\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\\n            decision_conflict = True\\n        unique_decisions[identity] = (decision, payload)\\n    current = [pair[0] for pair in unique_decisions.values()]\\n    packets = table(parsed, 'review_packets', 'Review packets')\\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\\n    for decision in current:\\n        dv = fields(decision)\\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\\n        pv = fields(ps[0]) if len(ps) == 1 else {}\\n        roles = str(dv.get('Review roles') or '').splitlines()\\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\\n                 and pv.get('Trip revision') == claim.get('trip_revision')\\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"a64aeb\",\"wall_time_seconds\":0.000017337,\"exit_code\":0,\"original_token_count\":31,\"output\":\"................ [ 92%]\\n......                                                                   [100%]\\n78 passed in 1.38s\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13cf2-cebe-70e1-8dae-3f683e534b00","create_time":1792023920.8747563}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
