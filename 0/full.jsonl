(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") in {\"native-source-manifest/1\", \"native-source-manifest/2\"}, \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    clock = manifest.get(\"case_clock\")\n    clock_confirmed = False\n    if clock:\n        try:\n            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n        except (ValueError, TypeError, AttributeError):\n            pass\n    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n\n    mode = state.get(\"mode\", \"unverified\")\n    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n    add(\"execution-scope\", \"BLOCKED\", \"Retained-input offline replay; no fresh native-source execution\" if offline else\n        \"Fresh native-source execution is not established by the supported replay artifacts\",\n        [run_dir / \"offline-replay-state.json\"], \"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\")\n\n    def bindings():\n        manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n        parsed_hash = hashlib.sha256((run_dir / \"parsed-records.json\").read_bytes()).hexdigest()\n        require(parsed[\"source_manifest\"] == {\"path\": \"sources.json\", \"sha256\": manifest_hash}, \"Parsed manifest binding mismatch\")\n        require(state[\"source_manifest_sha256\"] == manifest_hash and state[\"parsed_records_sha256\"] == parsed_hash,\n                \"Replay state input hash mismatch\")\n        require(state[\"parsed_records_path\"] == \"parsed-records.json\", \"Unexpected parsed input path\")\n        require(manifest[\"run_id\"] == parsed[\"run_id\"] == state[\"run_id\"] == run_dir.name, \"Run identities disagree\")\n        require(offline, \"Replay mode/fresh-read markers disagree or are unsupported\")\n    check(\"input-bindings\", [run_dir / name for name in (\"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\")], bindings)\n\n    snapshots: list[Path] = []\n    def chain():\n        batches = parsed[\"arrival_batches\"]\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \"Arrival sequence is incomplete\")\n        expected = [f\"batches/arrival-{n:03d}.json\" for n in batches]\n        require(state[\"sealed_batches\"] == expected, \"Sealed batch list does not match arrival sequence\")\n        require({p.name for p in (run_dir / \"batches\").glob(\"*.json\")} == {Path(p).name for p in expected}, \"Missing or orphaned snapshots\")\n        previous = None\n        for relative in expected:\n            path = run_dir / relative\n            errors = verify_snapshot(path, run_dir, schema_path)\n            require(not errors, f\"{relative}: {'; '.join(errors)}\")\n            obj = json.loads(path.read_text())\n            require(obj[\"batch_id\"] == path.stem, \"Snapshot batch identity mismatch\")\n            require(obj[\"predecessor\"] == previous, \"Snapshot chain order mismatch\")\n            require(any(i[\"record_id\"] == \"offline-replay-mode\" for i in obj[\"issues\"]), \"Snapshot offline marker missing\")\n            previous = {\"path\": relative, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()}\n            snapshots.append(path)\n    check(\"snapshot-chain\", [run_dir / \"batches\", schema_path], chain)\n\n    revalidation_expected = {}\n    def snapshot_evidence():\n        require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n        prior_result = None\n        for number, path in enumerate(snapshots, start=1):\n            observed = json.loads(path.read_text())\n            current = integrate_arrival_batch(\n                parsed, arrival_batch=number, run_id=state[\"run_id\"], batch_id=path.stem,\n                source_binding=observed[\"source_binding\"], predecessor=observed[\"predecessor\"],\n                prior_result=prior_result, source_observations=manifest['files'],\n            )\n            current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n            require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n            prior_result = current\n        require(state.get('budget_reconciliation') == current['domain']['budget'], 'Budget state differs from evidence replay')\n        require(state.get('budget_history') == current['domain']['budget_history'], 'Budget history differs from evidence replay')\n        data, summary = verification_document(current['domain'], current['snapshot']['travel_cancellations'], run_id=state['run_id'])\n        revalidation_expected.update(data=data, summary=summary)\n    check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n\n    def correction_trace():\n        require(revalidation_expected, \"Deterministic retained evidence replay required\")\n        require(objects['correction-cancellation-verification.json'] == revalidation_expected['data'],\n                \"Correction/cancellation checks differ from executed retained evidence replay\")\n        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\n                \"Correction/cancellation summary differs from executed checks\")\n    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\n          run_dir / 'correction-cancellation-verification.md'], correction_trace)\n\n    # Collect only references actually present in retained parsed evidence.\n        snapshot = json.loads(snapshot_path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read snapshot: {exc}\"]\n    errors = _schema_errors(snapshot, schema_path)\n    if errors:\n        return errors\n    errors.extend(_check_semantics(snapshot))\n    errors.extend(verify_source_manifest(run_dir))\n    try:\n        manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n        if not isinstance(manifest, dict):\n            raise ValueError(\"sources.json must be an object\")\n        if manifest.get(\"run_id\") != snapshot[\"run_id\"]:\n            errors.append(\"snapshot run_id does not match sources.json run_id\")\n        files = manifest.get(\"files\", [])\n        retained_ids = {\n            record.get(\"source_id\")\n            for record in files if isinstance(record, dict)\n            if record.get(\"status\") == \"read\"\n        }\n        for claim in snapshot[\"claims\"]:\n            for line in claim[\"lines\"]:\n                missing_sources = set(line[\"source_ids\"]) - retained_ids\n                if missing_sources:\n                    errors.append(\n                        f\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\"\n                    )\n    except (OSError, json.JSONDecodeError, ValueError):\n        manifest = {}\n    source_binding = snapshot[\"source_binding\"]\n    source_path = run_dir / source_binding[\"path\"]\n    if not source_path.resolve().is_relative_to(run_dir.resolve()):\n        errors.append(\"source_binding path escapes the run directory\")\n        return errors\n    if source_path.resolve() != (run_dir / \"sources.json\").resolve():\n        errors.append(\"source_binding must identify this run's sources.json\")\n        return errors\n    try:\n        actual = sha256_bytes(source_path.read_bytes())\n    except OSError as exc:\n        errors.append(f\"Cannot read bound sources file {source_binding['path']}: {exc}\")\n    else:\n        if actual != source_binding[\"sha256\"]:\n            errors.append(\"source_binding SHA-256 does not match retained sources.json\")\n    predecessor = snapshot[\"predecessor\"]\n    if predecessor is not None:\n        previous_path = run_dir / predecessor[\"path\"]\n        if not previous_path.resolve().is_relative_to((run_dir / \"batches\").resolve()):\n            errors.append(\"predecessor path escapes the run's batches directory\")\n            return errors\n        try:\n            actual = sha256_bytes(previous_path.read_bytes())\n        except OSError as exc:\n            errors.append(f\"Cannot read predecessor {predecessor['path']}: {exc}\")\n        else:\n            if actual != predecessor[\"sha256\"]:\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\n    policy_record = rules[0] if len(rules) == 1 else None\n    policy = fields(policy_record) if policy_record else {}\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\n                        and isinstance(policy.get('Eligible categories'), list)\n                        and isinstance(policy.get('Uncapped categories'), list)\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n                        and isinstance(policy.get('Domestic permit required'), bool))\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n        \"records\": {\n            \"claim_revisions\": claim_revisions,\n            \"trips\": trips,\n            \"permits\": permits,\n            \"receipts\": receipt_records,\n            \"decisions\": decisions,\n            \"finance_events\": finance,\n            \"cancellation_activities\": cancellations,\n        },\n        \"processing_boundary\": {\n            \"policy_dependent_conclusions\": \"unresolved\",\n            \"reason\": \"Native reimbursement policy content is unavailable; parsed source values are not eligibility, entitlement, approval-readiness, or closure decisions.\",\n            \"owner\": \"Travel Administration Lead / facilitator for source access\",\n            \"next_action\": \"Provide an authorized native export or enable read access to the original Notion policy, then perform a fresh native read.\",\n        },\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\",\n                \"subject_type\": \"scenario\",\n                \"subject_id\": \"arrival-batch-clock\",\n                \"revision\": None,\n                \"affected_scope\": \"all batch cutoff decisions and arrival-state consumption\",\n                \"reason\": \"No authoritative scenario date, time and timezone was supplied for this run; obtain the explicit case clock before batch consumption.\",\n                \"owner\": \"Exercise facilitator\",\n                \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n                \"evidence_needed\": \"Explicit scenario date, time, and timezone from the facilitator or original task material.\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\",\n                \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\",\n                \"revision\": None,\n                \"affected_scope\": \"eligibility, entitlement, approval readiness, reimbursement caps and final closure\",\n                \"reason\": \"Native policy content is incomplete or unverified; consult this run's source observation.\",\n                \"owner\": \"Travel Administration Lead / exercise facilitator\",\n                \"next_action\": \"Provide an authorized native export or enable read access to the original Notion page, then perform a fresh native read.\",\n                \"evidence_needed\": \"Complete policy content from the original Notion page or authorized native export, with observed URL/version and retained-content hash.\",\n            },\n        ],\n    }\n    policy_meta = next(row for row in manifest[\"files\"] if row[\"source_id\"] == \"policy-pol-2026-2\")\n\"\"\"Fresh source requests never borrow retained inputs or assert missing content.\"\"\"\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom source_fixtures import pdf_bytes, xlsx_bytes\nfrom travel_claim.cli import main\nfrom travel_claim.live_run import run_live_sources\nfrom travel_claim.parsing import parse_retained_run\nfrom travel_claim.sources import SOURCES, capture_sources, verify_source_manifest\n\n\ndef fetcher(*, fault=None, calls=None):\n    def fetch(url, timeout):\n        if calls is not None: calls.append(url)\n        source = next(s for s in SOURCES if (s.export_url or s.url) == url)\n        if fault == 'all-fail': raise URLError('SYNTHETIC network unavailable')\n        if source.kind == 'notion':\n            if fault == 'http-error':\n                raise HTTPError(url, 403, 'SYNTHETIC denied', {'ETag': 'denied-v1'}, io.BytesIO(b'SYNTHETIC access denied'))\n            return b'<article>POL-2026.2 reimbursement SYNTHETIC fragment</article>', {}, url\n        body = xlsx_bytes() if source.kind == 'xlsx' else pdf_bytes()\n        headers = {'etag': 'synthetic-version', 'content-length': str(len(body))}\n        if source.source_id == 'initial-claim-binder':\n            if fault == 'range': headers.update({'X-Travel-Claim-HTTP-Status': '206', 'Content-Range': 'bytes 0-9/100'})\n            elif fault == 'truncated': headers['content-length'] = str(len(body) + 100)\n            elif fault == 'corrupt': body = b'%PDF-1.4 broken %%EOF'\n        return body, headers, url + '#SYNTHETIC-final-url'\n    return fetch\n\n\ndef test_successful_native_document_retrieval_preserves_bytes_versions_and_all_five_requests(tmp_path):\n    calls = []\n    run = tmp_path / 'fresh-a'\n    m = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(calls=calls))\n    assert calls == [s.export_url or s.url for s in SOURCES]\n    assert [r['status'] for r in m['files']] == ['partial', 'read', 'read', 'read', 'read']\n    for row in m['files']:\n        observation = row['observation']\n        assert observation['cache_fallback_used'] is False\n        body = (run / observation['response_path']).read_bytes()\n        assert hashlib.sha256(body).hexdigest() == observation['response_sha256'] == row['sha256']\n        assert body == (run / row['path']).read_bytes()\n    assert m['files'][1]['version'] == 'synthetic-version'\n    assert m['case_clock'] is None and verify_source_manifest(run) == []\n\n\n@pytest.mark.parametrize('fault', ['range', 'truncated', 'corrupt', 'all-fail', 'http-error'])\ndef test_partial_or_failed_live_run_never_reports_complete_success(tmp_path, fault):\n    run = tmp_path / fault\n    report = run_live_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(fault=fault))\n    assert report['status'] == report['acquisition_status'] == 'BLOCKED'\n    assert report['final_live_source_compliance'] is False and report['batches_consumed'] == []\n    assert report['fresh_reads_attempted'] == 5\n    assert not (run / 'batches').exists()\n    assert verify_source_manifest(run) == []\n    assert 'BLOCKED' in (run / 'live-run.md').read_text()\n    if fault == 'http-error':\n        row = json.loads((run / 'sources.json').read_text())['files'][0]\n        assert row['observation']['http_status'] == 403\n        assert (run / row['observation']['response_path']).read_bytes() == b'SYNTHETIC access denied'\n    if fault in {'range', 'truncated'}:\n        m = json.loads((run / 'sources.json').read_text())\n        assert m['files'][1]['status'] == 'partial'\n        assert 'initial-claim-binder' in {s['source_id'] for s in json.loads((run / 'parsed-records.json').read_text())['source_inventory']}\n\n","exit_code":0,"duration":{"secs":0,"nanos":38760920},"formatted_output":"\"\"\"Read-only structural readiness checks; never certify live business compliance.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport hashlib\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import integrate_arrival_batch\nfrom .offline_replay import OFFLINE_MARKER, _report\nfrom .revalidation import verification_document\nfrom .ordinary import ordinary_demo\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\nfrom .snapshots import verify_snapshot\nfrom .sources import SOURCES, verify_source_manifest\n\nREQUIRED_FILES = (\n    \"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\",\n    \"claims.csv\", \"report.md\", \"repair-queue.json\", \"follow-up-drafts.md\",\n    \"ordinary-workflow.json\", \"ordinary-workflow-demo.md\",\n    \"correction-cancellation-verification.json\", \"correction-cancellation-verification.md\",\n)\n\n\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\n    \"\"\"Inspect existing artifacts and local Git evidence without changing either.\"\"\"\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\n    checks: list[dict[str, Any]] = []\n    objects: dict[str, dict] = {}\n\n    def add(name, status, detail, evidence, action):\n        checks.append(dict(check=name, status=status, detail=detail,\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\n\n    def check(name, paths, operation):\n        try:\n            operation()\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\n            add(name, \"FAIL\", str(exc) or \"Evidence is inconsistent\", paths,\n                \"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\")\n        else:\n            add(name, \"PASS\", \"Local structural evidence verified\", paths, \"No structural repair required.\")\n\n    def require(condition, message):\n        if not condition:\n            raise ValueError(message)\n\n    for name in REQUIRED_FILES:\n        path = run_dir / name\n        def read(path=path, name=name):\n            require(path.is_file(), f\"Required output missing: {name}\")\n            if name.endswith(\".json\"):\n                obj = json.loads(path.read_text(encoding=\"utf-8\"))\n                require(isinstance(obj, dict), f\"{name} must contain an object\")\n                objects[name] = obj\n        check(f\"required:{name}\", [path], read)\n\n    manifest = objects.get(\"sources.json\", {})\n    parsed = objects.get(\"parsed-records.json\", {})\n    state = objects.get(\"offline-replay-state.json\", {})\n    def manifest_integrity():\n        errors = verify_source_manifest(run_dir)\n        require(not errors, \"; \".join(errors))\n        require(manifest.get(\"source_version\") in {\"native-source-manifest/1\", \"native-source-manifest/2\"}, \"Unsupported manifest version\")\n        rows = manifest[\"files\"]\n        require(len(rows) == len(SOURCES), \"Expected exactly five source entries\")\n        require({r[\"source_id\"]: r[\"url\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\n                \"Source IDs do not match configured native URLs\")\n    check(\"manifest-integrity\", [run_dir / \"sources.json\"], manifest_integrity)\n    source_rows = manifest.get(\"files\", [])\n    if not isinstance(source_rows, list):\n        source_rows = []\n    for source in SOURCES:\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\"source_id\") == source.source_id), {})\n        complete = row.get(\"status\") == \"read\" and row.get(\"missing_scope\") == []\n        add(f\"source-completeness:{source.source_id}\", \"PASS\" if complete else \"BLOCKED\",\n            \"Complete retained scope recorded\" if complete else row.get(\"error\") or \"Source scope missing or partial\",\n            [run_dir / \"sources.json\"], \"No source-access repair required.\" if complete else\n            f\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\")\n\n    clock = manifest.get(\"case_clock\")\n    clock_confirmed = False\n    if clock:\n        try:\n            clock_confirmed = datetime.fromisoformat(clock.replace(\"Z\", \"+00:00\")).utcoffset() is not None\n        except (ValueError, TypeError, AttributeError):\n            pass\n    clock_confirmed = clock_confirmed and parsed.get(\"case_clock\") == clock and state.get(\"case_clock\") == clock and not parsed.get(\"case_clock_issue\")\n    add(\"authoritative-case-clock\", \"PASS\" if clock_confirmed else \"BLOCKED\",\n        \"Consistent supplied timestamp recorded; authority is caller supplied\" if clock_confirmed else \"Authoritative scenario clock is unconfirmed or inconsistent\",\n        [run_dir / \"sources.json\", run_dir / \"parsed-records.json\"],\n        \"Retain the supplied authority evidence.\" if clock_confirmed else \"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\")\n\n    mode = state.get(\"mode\", \"unverified\")\n    offline = mode == \"offline-replay\" and state.get(\"fresh_native_reads_performed\") is False\n    add(\"execution-scope\", \"BLOCKED\", \"Retained-input offline replay; no fresh native-source execution\" if offline else\n        \"Fresh native-source execution is not established by the supported replay artifacts\",\n        [run_dir / \"offline-replay-state.json\"], \"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\")\n\n    def bindings():\n        manifest_hash = hashlib.sha256((run_dir / \"sources.json\").read_bytes()).hexdigest()\n        parsed_hash = hashlib.sha256((run_dir / \"parsed-records.json\").read_bytes()).hexdigest()\n        require(parsed[\"source_manifest\"] == {\"path\": \"sources.json\", \"sha256\": manifest_hash}, \"Parsed manifest binding mismatch\")\n        require(state[\"source_manifest_sha256\"] == manifest_hash and state[\"parsed_records_sha256\"] == parsed_hash,\n                \"Replay state input hash mismatch\")\n        require(state[\"parsed_records_path\"] == \"parsed-records.json\", \"Unexpected parsed input path\")\n        require(manifest[\"run_id\"] == parsed[\"run_id\"] == state[\"run_id\"] == run_dir.name, \"Run identities disagree\")\n        require(offline, \"Replay mode/fresh-read markers disagree or are unsupported\")\n    check(\"input-bindings\", [run_dir / name for name in (\"sources.json\", \"parsed-records.json\", \"offline-replay-state.json\")], bindings)\n\n    snapshots: list[Path] = []\n    def chain():\n        batches = parsed[\"arrival_batches\"]\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \"Arrival sequence is incomplete\")\n        expected = [f\"batches/arrival-{n:03d}.json\" for n in batches]\n        require(state[\"sealed_batches\"] == expected, \"Sealed batch list does not match arrival sequence\")\n        require({p.name for p in (run_dir / \"batches\").glob(\"*.json\")} == {Path(p).name for p in expected}, \"Missing or orphaned snapshots\")\n        previous = None\n        for relative in expected:\n            path = run_dir / relative\n            errors = verify_snapshot(path, run_dir, schema_path)\n            require(not errors, f\"{relative}: {'; '.join(errors)}\")\n            obj = json.loads(path.read_text())\n            require(obj[\"batch_id\"] == path.stem, \"Snapshot batch identity mismatch\")\n            require(obj[\"predecessor\"] == previous, \"Snapshot chain order mismatch\")\n            require(any(i[\"record_id\"] == \"offline-replay-mode\" for i in obj[\"issues\"]), \"Snapshot offline marker missing\")\n            previous = {\"path\": relative, \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest()}\n            snapshots.append(path)\n    check(\"snapshot-chain\", [run_dir / \"batches\", schema_path], chain)\n\n    revalidation_expected = {}\n    def snapshot_evidence():\n        require(snapshots and checks[-1][\"status\"] == \"PASS\", \"Verified complete snapshot chain required\")\n        prior_result = None\n        for number, path in enumerate(snapshots, start=1):\n            observed = json.loads(path.read_text())\n            current = integrate_arrival_batch(\n                parsed, arrival_batch=number, run_id=state[\"run_id\"], batch_id=path.stem,\n                source_binding=observed[\"source_binding\"], predecessor=observed[\"predecessor\"],\n                prior_result=prior_result, source_observations=manifest['files'],\n            )\n            current[\"snapshot\"][\"issues\"].append(dict(OFFLINE_MARKER))\n            require(current[\"snapshot\"] == observed, f\"{path.name} content differs from retained evidence replay\")\n            prior_result = current\n        require(state.get('budget_reconciliation') == current['domain']['budget'], 'Budget state differs from evidence replay')\n        require(state.get('budget_history') == current['domain']['budget_history'], 'Budget history differs from evidence replay')\n        data, summary = verification_document(current['domain'], current['snapshot']['travel_cancellations'], run_id=state['run_id'])\n        revalidation_expected.update(data=data, summary=summary)\n    check(\"snapshot-content-evidence\", [run_dir / \"batches\", run_dir / \"parsed-records.json\"], snapshot_evidence)\n\n    def correction_trace():\n        require(revalidation_expected, \"Deterministic retained evidence replay required\")\n        require(objects['correction-cancellation-verification.json'] == revalidation_expected['data'],\n                \"Correction/cancellation checks differ from executed retained evidence replay\")\n        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\n                \"Correction/cancellation summary differs from executed checks\")\n    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\n          run_dir / 'correction-cancellation-verification.md'], correction_trace)\n\n    # Collect only references actually present in retained parsed evidence.\n        snapshot = json.loads(snapshot_path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError) as exc:\n        return [f\"Cannot read snapshot: {exc}\"]\n    errors = _schema_errors(snapshot, schema_path)\n    if errors:\n        return errors\n    errors.extend(_check_semantics(snapshot))\n    errors.extend(verify_source_manifest(run_dir))\n    try:\n        manifest = json.loads((run_dir / \"sources.json\").read_text(encoding=\"utf-8\"))\n        if not isinstance(manifest, dict):\n            raise ValueError(\"sources.json must be an object\")\n        if manifest.get(\"run_id\") != snapshot[\"run_id\"]:\n            errors.append(\"snapshot run_id does not match sources.json run_id\")\n        files = manifest.get(\"files\", [])\n        retained_ids = {\n            record.get(\"source_id\")\n            for record in files if isinstance(record, dict)\n            if record.get(\"status\") == \"read\"\n        }\n        for claim in snapshot[\"claims\"]:\n            for line in claim[\"lines\"]:\n                missing_sources = set(line[\"source_ids\"]) - retained_ids\n                if missing_sources:\n                    errors.append(\n                        f\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\"\n                    )\n    except (OSError, json.JSONDecodeError, ValueError):\n        manifest = {}\n    source_binding = snapshot[\"source_binding\"]\n    source_path = run_dir / source_binding[\"path\"]\n    if not source_path.resolve().is_relative_to(run_dir.resolve()):\n        errors.append(\"source_binding path escapes the run directory\")\n        return errors\n    if source_path.resolve() != (run_dir / \"sources.json\").resolve():\n        errors.append(\"source_binding must identify this run's sources.json\")\n        return errors\n    try:\n        actual = sha256_bytes(source_path.read_bytes())\n    except OSError as exc:\n        errors.append(f\"Cannot read bound sources file {source_binding['path']}: {exc}\")\n    else:\n        if actual != source_binding[\"sha256\"]:\n            errors.append(\"source_binding SHA-256 does not match retained sources.json\")\n    predecessor = snapshot[\"predecessor\"]\n    if predecessor is not None:\n        previous_path = run_dir / predecessor[\"path\"]\n        if not previous_path.resolve().is_relative_to((run_dir / \"batches\").resolve()):\n            errors.append(\"predecessor path escapes the run's batches directory\")\n            return errors\n        try:\n            actual = sha256_bytes(previous_path.read_bytes())\n        except OSError as exc:\n            errors.append(f\"Cannot read predecessor {predecessor['path']}: {exc}\")\n        else:\n            if actual != predecessor[\"sha256\"]:\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\n    policy_record = rules[0] if len(rules) == 1 else None\n    policy = fields(policy_record) if policy_record else {}\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\n                        and isinstance(policy.get('Eligible categories'), list)\n                        and isinstance(policy.get('Uncapped categories'), list)\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n                        and isinstance(policy.get('Domestic permit required'), bool))\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n        \"records\": {\n            \"claim_revisions\": claim_revisions,\n            \"trips\": trips,\n            \"permits\": permits,\n            \"receipts\": receipt_records,\n            \"decisions\": decisions,\n            \"finance_events\": finance,\n            \"cancellation_activities\": cancellations,\n        },\n        \"processing_boundary\": {\n            \"policy_dependent_conclusions\": \"unresolved\",\n            \"reason\": \"Native reimbursement policy content is unavailable; parsed source values are not eligibility, entitlement, approval-readiness, or closure decisions.\",\n            \"owner\": \"Travel Administration Lead / facilitator for source access\",\n            \"next_action\": \"Provide an authorized native export or enable read access to the original Notion policy, then perform a fresh native read.\",\n        },\n        \"unresolved_issues\": [\n            {\n                \"record_id\": \"scenario-case-clock\",\n                \"subject_type\": \"scenario\",\n                \"subject_id\": \"arrival-batch-clock\",\n                \"revision\": None,\n                \"affected_scope\": \"all batch cutoff decisions and arrival-state consumption\",\n                \"reason\": \"No authoritative scenario date, time and timezone was supplied for this run; obtain the explicit case clock before batch consumption.\",\n                \"owner\": \"Exercise facilitator\",\n                \"next_action\": \"Provide the authoritative scenario case clock before consuming any arrival batch.\",\n                \"evidence_needed\": \"Explicit scenario date, time, and timezone from the facilitator or original task material.\",\n            },\n            {\n                \"record_id\": \"reimbursement-policy-pol-2026-2\",\n                \"subject_type\": \"policy\",\n                \"subject_id\": \"POL-2026.2\",\n                \"revision\": None,\n                \"affected_scope\": \"eligibility, entitlement, approval readiness, reimbursement caps and final closure\",\n                \"reason\": \"Native policy content is incomplete or unverified; consult this run's source observation.\",\n                \"owner\": \"Travel Administration Lead / exercise facilitator\",\n                \"next_action\": \"Provide an authorized native export or enable read access to the original Notion page, then perform a fresh native read.\",\n                \"evidence_needed\": \"Complete policy content from the original Notion page or authorized native export, with observed URL/version and retained-content hash.\",\n            },\n        ],\n    }\n    policy_meta = next(row for row in manifest[\"files\"] if row[\"source_id\"] == \"policy-pol-2026-2\")\n\"\"\"Fresh source requests never borrow retained inputs or assert missing content.\"\"\"\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom source_fixtures import pdf_bytes, xlsx_bytes\nfrom travel_claim.cli import main\nfrom travel_claim.live_run import run_live_sources\nfrom travel_claim.parsing import parse_retained_run\nfrom travel_claim.sources import SOURCES, capture_sources, verify_source_manifest\n\n\ndef fetcher(*, fault=None, calls=None):\n    def fetch(url, timeout):\n        if calls is not None: calls.append(url)\n        source = next(s for s in SOURCES if (s.export_url or s.url) == url)\n        if fault == 'all-fail': raise URLError('SYNTHETIC network unavailable')\n        if source.kind == 'notion':\n            if fault == 'http-error':\n                raise HTTPError(url, 403, 'SYNTHETIC denied', {'ETag': 'denied-v1'}, io.BytesIO(b'SYNTHETIC access denied'))\n            return b'<article>POL-2026.2 reimbursement SYNTHETIC fragment</article>', {}, url\n        body = xlsx_bytes() if source.kind == 'xlsx' else pdf_bytes()\n        headers = {'etag': 'synthetic-version', 'content-length': str(len(body))}\n        if source.source_id == 'initial-claim-binder':\n            if fault == 'range': headers.update({'X-Travel-Claim-HTTP-Status': '206', 'Content-Range': 'bytes 0-9/100'})\n            elif fault == 'truncated': headers['content-length'] = str(len(body) + 100)\n            elif fault == 'corrupt': body = b'%PDF-1.4 broken %%EOF'\n        return body, headers, url + '#SYNTHETIC-final-url'\n    return fetch\n\n\ndef test_successful_native_document_retrieval_preserves_bytes_versions_and_all_five_requests(tmp_path):\n    calls = []\n    run = tmp_path / 'fresh-a'\n    m = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(calls=calls))\n    assert calls == [s.export_url or s.url for s in SOURCES]\n    assert [r['status'] for r in m['files']] == ['partial', 'read', 'read', 'read', 'read']\n    for row in m['files']:\n        observation = row['observation']\n        assert observation['cache_fallback_used'] is False\n        body = (run / observation['response_path']).read_bytes()\n        assert hashlib.sha256(body).hexdigest() == observation['response_sha256'] == row['sha256']\n        assert body == (run / row['path']).read_bytes()\n    assert m['files'][1]['version'] == 'synthetic-version'\n    assert m['case_clock'] is None and verify_source_manifest(run) == []\n\n\n@pytest.mark.parametrize('fault', ['range', 'truncated', 'corrupt', 'all-fail', 'http-error'])\ndef test_partial_or_failed_live_run_never_reports_complete_success(tmp_path, fault):\n    run = tmp_path / fault\n    report = run_live_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(fault=fault))\n    assert report['status'] == report['acquisition_status'] == 'BLOCKED'\n    assert report['final_live_source_compliance'] is False and report['batches_consumed'] == []\n    assert report['fresh_reads_attempted'] == 5\n    assert not (run / 'batches').exists()\n    assert verify_source_manifest(run) == []\n    assert 'BLOCKED' in (run / 'live-run.md').read_text()\n    if fault == 'http-error':\n        row = json.loads((run / 'sources.json').read_text())['files'][0]\n        assert row['observation']['http_status'] == 403\n        assert (run / row['observation']['response_path']).read_bytes() == b'SYNTHETIC access denied'\n    if fault in {'range', 'truncated'}:\n        m = json.loads((run / 'sources.json').read_text())\n        assert m['files'][1]['status'] == 'partial'\n        assert 'initial-claim-binder' in {s['source_id'] for s in json.loads((run / 'parsed-records.json').read_text())['source_inventory']}\n\n"},"started_at_ms":1792027886635,"completed_at_ms":1792027886674}}
{"timestamp":"2026-10-15T01:31:27.128Z","ordinal":3684,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a13d2f-8618-7800-86f6-6ca5cd19c0f3","call_id":"call_25db781b05b14e39ab72699deb27a210","output":[{"type":"input_text","text":"Script completed\nWall time 0.7 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"cfd67d\",\"wall_time_seconds\":0.03935525,\"exit_code\":0,\"original_token_count\":5555,\"output\":\"\\\"\\\"\\\"Read-only structural readiness checks; never certify live business compliance.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport csv\\nimport hashlib\\nimport json\\nimport subprocess\\nfrom datetime import datetime\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom .follow_up import render_follow_up_drafts\\nfrom .integration import integrate_arrival_batch\\nfrom .offline_replay import OFFLINE_MARKER, _report\\nfrom .revalidation import verification_document\\nfrom .ordinary import ordinary_demo\\nfrom .outputs import CLAIMS_COLUMNS, load_repair_queue\\nfrom .snapshots import verify_snapshot\\nfrom .sources import SOURCES, verify_source_manifest\\n\\nREQUIRED_FILES = (\\n    \\\"sources.json\\\", \\\"parsed-records.json\\\", \\\"offline-replay-state.json\\\",\\n    \\\"claims.csv\\\", \\\"report.md\\\", \\\"repair-queue.json\\\", \\\"follow-up-drafts.md\\\",\\n    \\\"ordinary-workflow.json\\\", \\\"ordinary-workflow-demo.md\\\",\\n    \\\"correction-cancellation-verification.json\\\", \\\"correction-cancellation-verification.md\\\",\\n)\\n\\n\\ndef validate_readiness(run_dir: Path, *, schema_path: Path, repo_dir: Path) -> dict[str, Any]:\\n    \\\"\\\"\\\"Inspect existing artifacts and local Git evidence without changing either.\\\"\\\"\\\"\\n    run_dir, repo_dir = run_dir.resolve(), repo_dir.resolve()\\n    checks: list[dict[str, Any]] = []\\n    objects: dict[str, dict] = {}\\n\\n    def add(name, status, detail, evidence, action):\\n        checks.append(dict(check=name, status=status, detail=detail,\\n                           evidence_paths=[str(path) for path in evidence], next_action=action))\\n\\n    def check(name, paths, operation):\\n        try:\\n            operation()\\n        except (OSError, ValueError, KeyError, TypeError, AttributeError, IndexError, AssertionError) as exc:\\n            add(name, \\\"FAIL\\\", str(exc) or \\\"Evidence is inconsistent\\\", paths,\\n                \\\"Investigate the listed evidence; preserve this run and regenerate corrected outputs in a new run.\\\")\\n        else:\\n            add(name, \\\"PASS\\\", \\\"Local structural evidence verified\\\", paths, \\\"No structural repair required.\\\")\\n\\n    def require(condition, message):\\n        if not condition:\\n            raise ValueError(message)\\n\\n    for name in REQUIRED_FILES:\\n        path = run_dir / name\\n        def read(path=path, name=name):\\n            require(path.is_file(), f\\\"Required output missing: {name}\\\")\\n            if name.endswith(\\\".json\\\"):\\n                obj = json.loads(path.read_text(encoding=\\\"utf-8\\\"))\\n                require(isinstance(obj, dict), f\\\"{name} must contain an object\\\")\\n                objects[name] = obj\\n        check(f\\\"required:{name}\\\", [path], read)\\n\\n    manifest = objects.get(\\\"sources.json\\\", {})\\n    parsed = objects.get(\\\"parsed-records.json\\\", {})\\n    state = objects.get(\\\"offline-replay-state.json\\\", {})\\n    def manifest_integrity():\\n        errors = verify_source_manifest(run_dir)\\n        require(not errors, \\\"; \\\".join(errors))\\n        require(manifest.get(\\\"source_version\\\") in {\\\"native-source-manifest/1\\\", \\\"native-source-manifest/2\\\"}, \\\"Unsupported manifest version\\\")\\n        rows = manifest[\\\"files\\\"]\\n        require(len(rows) == len(SOURCES), \\\"Expected exactly five source entries\\\")\\n        require({r[\\\"source_id\\\"]: r[\\\"url\\\"] for r in rows} == {s.source_id: s.url for s in SOURCES},\\n                \\\"Source IDs do not match configured native URLs\\\")\\n    check(\\\"manifest-integrity\\\", [run_dir / \\\"sources.json\\\"], manifest_integrity)\\n    source_rows = manifest.get(\\\"files\\\", [])\\n    if not isinstance(source_rows, list):\\n        source_rows = []\\n    for source in SOURCES:\\n        row = next((r for r in source_rows if isinstance(r, dict) and r.get(\\\"source_id\\\") == source.source_id), {})\\n        complete = row.get(\\\"status\\\") == \\\"read\\\" and row.get(\\\"missing_scope\\\") == []\\n        add(f\\\"source-completeness:{source.source_id}\\\", \\\"PASS\\\" if complete else \\\"BLOCKED\\\",\\n            \\\"Complete retained scope recorded\\\" if complete else row.get(\\\"error\\\") or \\\"Source scope missing or partial\\\",\\n            [run_dir / \\\"sources.json\\\"], \\\"No source-access repair required.\\\" if complete else\\n            f\\\"Obtain authorized access to {source.url}, perform a fresh native read, and retain complete scope in a new run.\\\")\\n\\n    clock = manifest.get(\\\"case_clock\\\")\\n    clock_confirmed = False\\n    if clock:\\n        try:\\n            clock_confirmed = datetime.fromisoformat(clock.replace(\\\"Z\\\", \\\"+00:00\\\")).utcoffset() is not None\\n        except (ValueError, TypeError, AttributeError):\\n            pass\\n    clock_confirmed = clock_confirmed and parsed.get(\\\"case_clock\\\") == clock and state.get(\\\"case_clock\\\") == clock and not parsed.get(\\\"case_clock_issue\\\")\\n    add(\\\"authoritative-case-clock\\\", \\\"PASS\\\" if clock_confirmed else \\\"BLOCKED\\\",\\n        \\\"Consistent supplied timestamp recorded; authority is caller supplied\\\" if clock_confirmed else \\\"Authoritative scenario clock is unconfirmed or inconsistent\\\",\\n        [run_dir / \\\"sources.json\\\", run_dir / \\\"parsed-records.json\\\"],\\n        \\\"Retain the supplied authority evidence.\\\" if clock_confirmed else \\\"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\\\")\\n\\n    mode = state.get(\\\"mode\\\", \\\"unverified\\\")\\n    offline = mode == \\\"offline-replay\\\" and state.get(\\\"fresh_native_reads_performed\\\") is False\\n    add(\\\"execution-scope\\\", \\\"BLOCKED\\\", \\\"Retained-input offline replay; no fresh native-source execution\\\" if offline else\\n        \\\"Fresh native-source execution is not established by the supported replay artifacts\\\",\\n        [run_dir / \\\"offline-replay-state.json\\\"], \\\"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\\\")\\n\\n    def bindings():\\n        manifest_hash = hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n        parsed_hash = hashlib.sha256((run_dir / \\\"parsed-records.json\\\").read_bytes()).hexdigest()\\n        require(parsed[\\\"source_manifest\\\"] == {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": manifest_hash}, \\\"Parsed manifest binding mismatch\\\")\\n        require(state[\\\"source_manifest_sha256\\\"] == manifest_hash and state[\\\"parsed_records_sha256\\\"] == parsed_hash,\\n                \\\"Replay state input hash mismatch\\\")\\n        require(state[\\\"parsed_records_path\\\"] == \\\"parsed-records.json\\\", \\\"Unexpected parsed input path\\\")\\n        require(manifest[\\\"run_id\\\"] == parsed[\\\"run_id\\\"] == state[\\\"run_id\\\"] == run_dir.name, \\\"Run identities disagree\\\")\\n        require(offline, \\\"Replay mode/fresh-read markers disagree or are unsupported\\\")\\n    check(\\\"input-bindings\\\", [run_dir / name for name in (\\\"sources.json\\\", \\\"parsed-records.json\\\", \\\"offline-replay-state.json\\\")], bindings)\\n\\n    snapshots: list[Path] = []\\n    def chain():\\n        batches = parsed[\\\"arrival_batches\\\"]\\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \\\"Arrival sequence is incomplete\\\")\\n        expected = [f\\\"batches/arrival-{n:03d}.json\\\" for n in batches]\\n        require(state[\\\"sealed_batches\\\"] == expected, \\\"Sealed batch list does not match arrival sequence\\\")\\n        require({p.name for p in (run_dir / \\\"batches\\\").glob(\\\"*.json\\\")} == {Path(p).name for p in expected}, \\\"Missing or orphaned snapshots\\\")\\n        previous = None\\n        for relative in expected:\\n            path = run_dir / relative\\n            errors = verify_snapshot(path, run_dir, schema_path)\\n            require(not errors, f\\\"{relative}: {'; '.join(errors)}\\\")\\n            obj = json.loads(path.read_text())\\n            require(obj[\\\"batch_id\\\"] == path.stem, \\\"Snapshot batch identity mismatch\\\")\\n            require(obj[\\\"predecessor\\\"] == previous, \\\"Snapshot chain order mismatch\\\")\\n            require(any(i[\\\"record_id\\\"] == \\\"offline-replay-mode\\\" for i in obj[\\\"issues\\\"]), \\\"Snapshot offline marker missing\\\")\\n            previous = {\\\"path\\\": relative, \\\"sha256\\\": hashlib.sha256(path.read_bytes()).hexdigest()}\\n            snapshots.append(path)\\n    check(\\\"snapshot-chain\\\", [run_dir / \\\"batches\\\", schema_path], chain)\\n\\n    revalidation_expected = {}\\n    def snapshot_evidence():\\n        require(snapshots and checks[-1][\\\"status\\\"] == \\\"PASS\\\", \\\"Verified complete snapshot chain required\\\")\\n        prior_result = None\\n        for number, path in enumerate(snapshots, start=1):\\n            observed = json.loads(path.read_text())\\n            current = integrate_arrival_batch(\\n                parsed, arrival_batch=number, run_id=state[\\\"run_id\\\"], batch_id=path.stem,\\n                source_binding=observed[\\\"source_binding\\\"], predecessor=observed[\\\"predecessor\\\"],\\n                prior_result=prior_result, source_observations=manifest['files'],\\n            )\\n            current[\\\"snapshot\\\"][\\\"issues\\\"].append(dict(OFFLINE_MARKER))\\n            require(current[\\\"snapshot\\\"] == observed, f\\\"{path.name} content differs from retained evidence replay\\\")\\n            prior_result = current\\n        require(state.get('budget_reconciliation') == current['domain']['budget'], 'Budget state differs from evidence replay')\\n        require(state.get('budget_history') == current['domain']['budget_history'], 'Budget history differs from evidence replay')\\n        data, summary = verification_document(current['domain'], current['snapshot']['travel_cancellations'], run_id=state['run_id'])\\n        revalidation_expected.update(data=data, summary=summary)\\n    check(\\\"snapshot-content-evidence\\\", [run_dir / \\\"batches\\\", run_dir / \\\"parsed-records.json\\\"], snapshot_evidence)\\n\\n    def correction_trace():\\n        require(revalidation_expected, \\\"Deterministic retained evidence replay required\\\")\\n        require(objects['correction-cancellation-verification.json'] == revalidation_expected['data'],\\n                \\\"Correction/cancellation checks differ from executed retained evidence replay\\\")\\n        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\\n                \\\"Correction/cancellation summary differs from executed checks\\\")\\n    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\\n          run_dir / 'correction-cancellation-verification.md'], correction_trace)\\n\\n    # Collect only references actually present in retained parsed evidence.\\n        snapshot = json.loads(snapshot_path.read_text(encoding=\\\"utf-8\\\"))\\n    except (OSError, json.JSONDecodeError) as exc:\\n        return [f\\\"Cannot read snapshot: {exc}\\\"]\\n    errors = _schema_errors(snapshot, schema_path)\\n    if errors:\\n        return errors\\n    errors.extend(_check_semantics(snapshot))\\n    errors.extend(verify_source_manifest(run_dir))\\n    try:\\n        manifest = json.loads((run_dir / \\\"sources.json\\\").read_text(encoding=\\\"utf-8\\\"))\\n        if not isinstance(manifest, dict):\\n            raise ValueError(\\\"sources.json must be an object\\\")\\n        if manifest.get(\\\"run_id\\\") != snapshot[\\\"run_id\\\"]:\\n            errors.append(\\\"snapshot run_id does not match sources.json run_id\\\")\\n        files = manifest.get(\\\"files\\\", [])\\n        retained_ids = {\\n            record.get(\\\"source_id\\\")\\n            for record in files if isinstance(record, dict)\\n            if record.get(\\\"status\\\") == \\\"read\\\"\\n        }\\n        for claim in snapshot[\\\"claims\\\"]:\\n            for line in claim[\\\"lines\\\"]:\\n                missing_sources = set(line[\\\"source_ids\\\"]) - retained_ids\\n                if missing_sources:\\n                    errors.append(\\n                        f\\\"claim {claim['claim_id']} cost {line['cost_id']} refers to unavailable source IDs: {sorted(missing_sources)}\\\"\\n                    )\\n    except (OSError, json.JSONDecodeError, ValueError):\\n        manifest = {}\\n    source_binding = snapshot[\\\"source_binding\\\"]\\n    source_path = run_dir / source_binding[\\\"path\\\"]\\n    if not source_path.resolve().is_relative_to(run_dir.resolve()):\\n        errors.append(\\\"source_binding path escapes the run directory\\\")\\n        return errors\\n    if source_path.resolve() != (run_dir / \\\"sources.json\\\").resolve():\\n        errors.append(\\\"source_binding must identify this run's sources.json\\\")\\n        return errors\\n    try:\\n        actual = sha256_bytes(source_path.read_bytes())\\n    except OSError as exc:\\n        errors.append(f\\\"Cannot read bound sources file {source_binding['path']}: {exc}\\\")\\n    else:\\n        if actual != source_binding[\\\"sha256\\\"]:\\n            errors.append(\\\"source_binding SHA-256 does not match retained sources.json\\\")\\n    predecessor = snapshot[\\\"predecessor\\\"]\\n    if predecessor is not None:\\n        previous_path = run_dir / predecessor[\\\"path\\\"]\\n        if not previous_path.resolve().is_relative_to((run_dir / \\\"batches\\\").resolve()):\\n            errors.append(\\\"predecessor path escapes the run's batches directory\\\")\\n            return errors\\n        try:\\n            actual = sha256_bytes(previous_path.read_bytes())\\n        except OSError as exc:\\n            errors.append(f\\\"Cannot read predecessor {predecessor['path']}: {exc}\\\")\\n        else:\\n            if actual != predecessor[\\\"sha256\\\"]:\\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\\n    policy_record = rules[0] if len(rules) == 1 else None\\n    policy = fields(policy_record) if policy_record else {}\\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\\n                        and isinstance(policy.get('Eligible categories'), list)\\n                        and isinstance(policy.get('Uncapped categories'), list)\\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\\n                        and isinstance(policy.get('Domestic permit required'), bool))\\n\\\"\\\"\\\"Shared evidence checks for Finance and business-cancellation admissions.\\n\\nA calendar-date clock never implies midnight or an end-of-day instant. Events\\non that same local date need an explicit cutoff before admission.\\n\\\"\\\"\\\"\\nfrom datetime import datetime, timezone, date\\nfrom zoneinfo import ZoneInfo\\n\\n\\ndef utc_time(value):\\n    if not isinstance(value, str) or 'T' not in value:\\n        raise ValueError('missing explicit UTC event date/time')\\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\\n        raise ValueError('event timestamp is not UTC')\\n    return stamp.replace(tzinfo=timezone.utc)\\n\\n\\ndef observation_error(stamp, clock):\\n    try:\\n        if isinstance(clock, str):\\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\\n            if cutoff.utcoffset() is None:\\n                return 'case cutoff lacks timezone'\\n            return 'future observation' if stamp > cutoff else None\\n        if isinstance(clock, dict):\\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\\n            case_date = date.fromisoformat(clock['date'])\\n            if local > case_date:\\n                return 'future observation'\\n            if local == case_date:\\n                return 'same-day cutoff is unknown; no time of day inferred'\\n            return None\\n    except (KeyError, TypeError, ValueError):\\n        return 'invalid authoritative event cutoff'\\n    return 'authoritative event cutoff is unavailable'\\n\\n\\ndef text_id(value):\\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\\n\\n        \\\"records\\\": {\\n            \\\"claim_revisions\\\": claim_revisions,\\n            \\\"trips\\\": trips,\\n            \\\"permits\\\": permits,\\n            \\\"receipts\\\": receipt_records,\\n            \\\"decisions\\\": decisions,\\n            \\\"finance_events\\\": finance,\\n            \\\"cancellation_activities\\\": cancellations,\\n        },\\n        \\\"processing_boundary\\\": {\\n            \\\"policy_dependent_conclusions\\\": \\\"unresolved\\\",\\n            \\\"reason\\\": \\\"Native reimbursement policy content is unavailable; parsed source values are not eligibility, entitlement, approval-readiness, or closure decisions.\\\",\\n            \\\"owner\\\": \\\"Travel Administration Lead / facilitator for source access\\\",\\n            \\\"next_action\\\": \\\"Provide an authorized native export or enable read access to the original Notion policy, then perform a fresh native read.\\\",\\n        },\\n        \\\"unresolved_issues\\\": [\\n            {\\n                \\\"record_id\\\": \\\"scenario-case-clock\\\",\\n                \\\"subject_type\\\": \\\"scenario\\\",\\n                \\\"subject_id\\\": \\\"arrival-batch-clock\\\",\\n                \\\"revision\\\": None,\\n                \\\"affected_scope\\\": \\\"all batch cutoff decisions and arrival-state consumption\\\",\\n                \\\"reason\\\": \\\"No authoritative scenario date, time and timezone was supplied for this run; obtain the explicit case clock before batch consumption.\\\",\\n                \\\"owner\\\": \\\"Exercise facilitator\\\",\\n                \\\"next_action\\\": \\\"Provide the authoritative scenario case clock before consuming any arrival batch.\\\",\\n                \\\"evidence_needed\\\": \\\"Explicit scenario date, time, and timezone from the facilitator or original task material.\\\",\\n            },\\n            {\\n                \\\"record_id\\\": \\\"reimbursement-policy-pol-2026-2\\\",\\n                \\\"subject_type\\\": \\\"policy\\\",\\n                \\\"subject_id\\\": \\\"POL-2026.2\\\",\\n                \\\"revision\\\": None,\\n                \\\"affected_scope\\\": \\\"eligibility, entitlement, approval readiness, reimbursement caps and final closure\\\",\\n                \\\"reason\\\": \\\"Native policy content is incomplete or unverified; consult this run's source observation.\\\",\\n                \\\"owner\\\": \\\"Travel Administration Lead / exercise facilitator\\\",\\n                \\\"next_action\\\": \\\"Provide an authorized native export or enable read access to the original Notion page, then perform a fresh native read.\\\",\\n                \\\"evidence_needed\\\": \\\"Complete policy content from the original Notion page or authorized native export, with observed URL/version and retained-content hash.\\\",\\n            },\\n        ],\\n    }\\n    policy_meta = next(row for row in manifest[\\\"files\\\"] if row[\\\"source_id\\\"] == \\\"policy-pol-2026-2\\\")\\n\\\"\\\"\\\"Fresh source requests never borrow retained inputs or assert missing content.\\\"\\\"\\\"\\nimport hashlib\\nimport io\\nimport json\\nfrom pathlib import Path\\nfrom urllib.error import HTTPError, URLError\\n\\nimport pytest\\n\\nfrom source_fixtures import pdf_bytes, xlsx_bytes\\nfrom travel_claim.cli import main\\nfrom travel_claim.live_run import run_live_sources\\nfrom travel_claim.parsing import parse_retained_run\\nfrom travel_claim.sources import SOURCES, capture_sources, verify_source_manifest\\n\\n\\ndef fetcher(*, fault=None, calls=None):\\n    def fetch(url, timeout):\\n        if calls is not None: calls.append(url)\\n        source = next(s for s in SOURCES if (s.export_url or s.url) == url)\\n        if fault == 'all-fail': raise URLError('SYNTHETIC network unavailable')\\n        if source.kind == 'notion':\\n            if fault == 'http-error':\\n                raise HTTPError(url, 403, 'SYNTHETIC denied', {'ETag': 'denied-v1'}, io.BytesIO(b'SYNTHETIC access denied'))\\n            return b'<article>POL-2026.2 reimbursement SYNTHETIC fragment</article>', {}, url\\n        body = xlsx_bytes() if source.kind == 'xlsx' else pdf_bytes()\\n        headers = {'etag': 'synthetic-version', 'content-length': str(len(body))}\\n        if source.source_id == 'initial-claim-binder':\\n            if fault == 'range': headers.update({'X-Travel-Claim-HTTP-Status': '206', 'Content-Range': 'bytes 0-9/100'})\\n            elif fault == 'truncated': headers['content-length'] = str(len(body) + 100)\\n            elif fault == 'corrupt': body = b'%PDF-1.4 broken %%EOF'\\n        return body, headers, url + '#SYNTHETIC-final-url'\\n    return fetch\\n\\n\\ndef test_successful_native_document_retrieval_preserves_bytes_versions_and_all_five_requests(tmp_path):\\n    calls = []\\n    run = tmp_path / 'fresh-a'\\n    m = capture_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(calls=calls))\\n    assert calls == [s.export_url or s.url for s in SOURCES]\\n    assert [r['status'] for r in m['files']] == ['partial', 'read', 'read', 'read', 'read']\\n    for row in m['files']:\\n        observation = row['observation']\\n        assert observation['cache_fallback_used'] is False\\n        body = (run / observation['response_path']).read_bytes()\\n        assert hashlib.sha256(body).hexdigest() == observation['response_sha256'] == row['sha256']\\n        assert body == (run / row['path']).read_bytes()\\n    assert m['files'][1]['version'] == 'synthetic-version'\\n    assert m['case_clock'] is None and verify_source_manifest(run) == []\\n\\n\\n@pytest.mark.parametrize('fault', ['range', 'truncated', 'corrupt', 'all-fail', 'http-error'])\\ndef test_partial_or_failed_live_run_never_reports_complete_success(tmp_path, fault):\\n    run = tmp_path / fault\\n    report = run_live_sources(run, run_id=run.name, case_clock=None, fetch=fetcher(fault=fault))\\n    assert report['status'] == report['acquisition_status'] == 'BLOCKED'\\n    assert report['final_live_source_compliance'] is False and report['batches_consumed'] == []\\n    assert report['fresh_reads_attempted'] == 5\\n    assert not (run / 'batches').exists()\\n    assert verify_source_manifest(run) == []\\n    assert 'BLOCKED' in (run / 'live-run.md').read_text()\\n    if fault == 'http-error':\\n        row = json.loads((run / 'sources.json').read_text())['files'][0]\\n        assert row['observation']['http_status'] == 403\\n        assert (run / row['observation']['response_path']).read_bytes() == b'SYNTHETIC access denied'\\n    if fault in {'range', 'truncated'}:\\n        m = json.loads((run / 'sources.json').read_text())\\n        assert m['files'][1]['status'] == 'partial'\\n        assert 'initial-claim-binder' in {s['source_id'] for s in json.loads((run / 'parsed-records.json').read_text())['source_inventory']}\\n\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13d2f-33b9-79d2-86e5-590034036e86","create_time":1792027887.1286716}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
