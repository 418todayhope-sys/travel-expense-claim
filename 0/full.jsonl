snapshot-content-evidence\\\"), (\\\"header\\\", \\\"claims-csv-contract\\\"),\\n            clock_confirmed = datetime.fromisoformat(clock.replace(\\\"Z\\\", \\\"+00:00\\\")).utcoffset() is not None\\n        except (ValueError, TypeError, AttributeError):\\n            pass\\n    clock_confirmed = clock_confirmed and parsed.get(\\\"case_clock\\\") == clock and state.get(\\\"case_clock\\\") == clock and not parsed.get(\\\"case_clock_issue\\\")\\n    add(\\\"authoritative-case-clock\\\", \\\"PASS\\\" if clock_confirmed else \\\"BLOCKED\\\",\\n        \\\"Consistent supplied timestamp recorded; authority is caller supplied\\\" if clock_confirmed else \\\"Authoritative scenario clock is unconfirmed or inconsistent\\\",\\n        [run_dir / \\\"sources.json\\\", run_dir / \\\"parsed-records.json\\\"],\\n        \\\"Retain the supplied authority evidence.\\\" if clock_confirmed else \\\"Obtain the facilitator's authoritative scenario date, time and timezone; do not infer a clock from observation timestamps.\\\")\\n\\n    mode = state.get(\\\"mode\\\", \\\"unverified\\\")\\n    offline = mode == \\\"offline-replay\\\" and state.get(\\\"fresh_native_reads_performed\\\") is False\\n    add(\\\"execution-scope\\\", \\\"BLOCKED\\\", \\\"Retained-input offline replay; no fresh native-source execution\\\" if offline else\\n        \\\"Fresh native-source execution is not established by the supported replay artifacts\\\",\\n        [run_dir / \\\"offline-replay-state.json\\\"], \\\"Perform a separately authorized fresh native-source execution; this validator certifies only structural evidence, never final policy or financial compliance.\\\")\\n\\n    def bindings():\\n        manifest_hash = hashlib.sha256((run_dir / \\\"sources.json\\\").read_bytes()).hexdigest()\\n        parsed_hash = hashlib.sha256((run_dir / \\\"parsed-records.json\\\").read_bytes()).hexdigest()\\n        require(parsed[\\\"source_manifest\\\"] == {\\\"path\\\": \\\"sources.json\\\", \\\"sha256\\\": manifest_hash}, \\\"Parsed manifest binding mismatch\\\")\\n        require(state[\\\"source_manifest_sha256\\\"] == manifest_hash and state[\\\"parsed_records_sha256\\\"] == parsed_hash,\\n                \\\"Replay state input hash mismatch\\\")\\n        require(state[\\\"parsed_records_path\\\"] == \\\"parsed-records.json\\\", \\\"Unexpected parsed input path\\\")\\n        require(manifest[\\\"run_id\\\"] == parsed[\\\"run_id\\\"] == state[\\\"run_id\\\"] == run_dir.name, \\\"Run identities disagree\\\")\\n        require(offline, \\\"Replay mode/fresh-read markers disagree or are unsupported\\\")\\n    check(\\\"input-bindings\\\", [run_dir / name for name in (\\\"sources.json\\\", \\\"parsed-records.json\\\", \\\"offline-replay-state.json\\\")], bindings)\\n\\n    snapshots: list[Path] = []\\n    def chain():\\n        batches = parsed[\\\"arrival_batches\\\"]\\n        require(isinstance(batches, list) and batches and batches == list(range(1, len(batches) + 1)), \\\"Arrival sequence is incomplete\\\")\\n        expected = [f\\\"batches/arrival-{n:03d}.json\\\" for n in batches]\\n        require(state[\\\"sealed_batches\\\"] == expected, \\\"Sealed batch list does not match arrival sequence\\\")\\n        require({p.name for p in (run_dir / \\\"batches\\\").glob(\\\"*.json\\\")} == {Path(p).name for p in expected}, \\\"Missing or orphaned snapshots\\\")\\n        previous = None\\n        for relative in expected:\\n            path = run_dir / relative\\n            errors = verify_snapshot(path, run_dir, schema_path)\\n            require(not errors, f\\\"{relative}: {'; '.join(errors)}\\\")\\n            obj = json.loads(path.read_text())\\n            require(obj[\\\"batch_id\\\"] == path.stem, \\\"Snapshot batch identity mismatch\\\")\\n            require(obj[\\\"predecessor\\\"] == previous, \\\"Snapshot chain order mismatch\\\")\\n            require(any(i[\\\"record_id\\\"] == \\\"offline-replay-mode\\\" for i in obj[\\\"issues\\\"]), \\\"Snapshot offline marker missing\\\")\\n            previous = {\\\"path\\\": relative, \\\"sha256\\\": hashlib.sha256(path.read_bytes()).hexdigest()}\\n            snapshots.append(path)\\n    check(\\\"snapshot-chain\\\", [run_dir / \\\"batches\\\", schema_path], chain)\\n\\n    revalidation_expected = {}\\n    def snapshot_evidence():\\n        require(snapshots and checks[-1][\\\"status\\\"] == \\\"PASS\\\", \\\"Verified complete snapshot chain required\\\")\\n        prior_result = None\\n        for number, path in enumerate(snapshots, start=1):\\n            observed = json.loads(path.read_text())\\n            current = integrate_arrival_batch(\\n                parsed, arrival_batch=number, run_id=state[\\\"run_id\\\"], batch_id=path.stem,\\n                source_binding=observed[\\\"source_binding\\\"], predecessor=observed[\\\"predecessor\\\"],\\n                prior_result=prior_result, source_observations=manifest['files'],\\n            )\\n            current[\\\"snapshot\\\"][\\\"issues\\\"].append(dict(OFFLINE_MARKER))\\n            require(current[\\\"snapshot\\\"] == observed, f\\\"{path.name} content differs from retained evidence replay\\\")\\n            prior_result = current\\n        data, summary = verification_document(current['domain'], current['snapshot']['travel_cancellations'], run_id=state['run_id'])\\n        revalidation_expected.update(data=data, summary=summary)\\n    check(\\\"snapshot-content-evidence\\\", [run_dir / \\\"batches\\\", run_dir / \\\"parsed-records.json\\\"], snapshot_evidence)\\n\\n    def correction_trace():\\n        require(revalidation_expected, \\\"Deterministic retained evidence replay required\\\")\\n        require(objects['correction-cancellation-verification.json'] == revalidation_expected['data'],\\n                \\\"Correction/cancellation checks differ from executed retained evidence replay\\\")\\n        require((run_dir / 'correction-cancellation-verification.md').read_text() == revalidation_expected['summary'],\\n                \\\"Correction/cancellation summary differs from executed checks\\\")\\n    check('correction-cancellation-traceability', [run_dir / 'correction-cancellation-verification.json',\\n          run_dir / 'correction-cancellation-verification.md'], correction_trace)\\n\\n    # Collect only references actually present in retained parsed evidence.\\n    parsed_refs: set[str] = set()\\n    def collect_refs(value):\\n        if isinstance(value, dict):\\n\\\"\\\"\\\"Native-shaped review records and explicitly synthetic authority probes.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport json\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom test_ordinary import synthetic, batches, workflow, stages\\nfrom test_expenses import setfield\\nfrom test_revalidation import corrected\\nfrom travel_claim.approvals import evaluate_reviews, evaluate_permit, fields, ref, table\\nfrom travel_claim.integration import integrate_arrival_batch\\n\\n\\ndef subject(kind='claim',amount=10000):\\n    p=synthetic();record=p['records']['claim_revisions'][0];trip=p['records']['trips'][0]\\n    if kind=='permit':\\n        setfield(trip,'International',True);setfield(trip,'Permit reference','P-SYN');setfield(trip,'Permit revision',1)\\n        setfield(trip,'Estimate (EUR)',str(amount/100))\\n        record=deepcopy(trip);record['text']='Synthetic source version SRC-D-3'\\n        for d in p['records']['decisions']:\\n            setfield(d,'Subject type','permit');setfield(d,'Subject reference','P-SYN')\\n    for packet in table(p,'review_packets','Review packets'):\\n        for key in ('Permit reference','Permit revision'): setfield(packet,key,fields(trip).get(key))\\n        if kind=='permit':setfield(packet,'Reviewed estimate (EUR)',str(amount/100))\\n    return p,record,trip\\n\\n\\ndef check(p,record,trip,kind='claim',amount=10000,prior=None,batch=4):\\n    return evaluate_reviews(parsed=p,kind=kind,subject_id='P-SYN' if kind=='permit' else 'SYN-C01',revision=1,\\n        trip_record=trip,employee='EMP-01',subject_record=record,amount_cents=amount,\\n        decisions=p['records']['decisions'],arrival_batch=batch,observations=p['source_observations'],\\n        cost_ids=['COST-01'],prior=prior)\\n\\n\\ndef director(p):\\n    d=deepcopy(p['records']['decisions'][0]);setfield(d,'Decision reference','SYN-DIRECTOR');setfield(d,'Review roles','director');setfield(d,'Reviewer','DIR-01')\\n    packet=deepcopy(table(p,'review_packets','Review packets')[0]);setfield(packet,'Decision reference','SYN-DIRECTOR')\\n    p['records']['decisions'].append(d)\\n    table(p,'review_packets','Review packets').append(packet)\\n\\n\\n@pytest.mark.parametrize('kind',['claim','permit'])\\n@pytest.mark.parametrize('amount,needs_director',[(99999,False),(100000,False),(100001,True)])\\ndef test_exact_policy_thresholds_for_distinct_subjects(kind,amount,needs_director):\\n    p,record,trip=subject(kind,amount)\\n    value=check(p,record,trip,kind,amount)\\n    assert ('director' in value['required_roles'])==needs_director\\n    assert value['approved']==(not needs_director)\\n    director(p)\\n    assert check(p,record,trip,kind,amount)['approved']\\n\\n\\n@pytest.mark.parametrize('kind',['claim','permit'])\\n@pytest.mark.parametrize('field,value',[('Subject type','other'),('Subject reference','OTHER'),('Revision',2),\\n    ('Reviewer','OTHER'),('Reviewer','EMP-01'),('Review roles','director'),('Review roles','unknown'),\\n    ('Reason',''),('Source revisions','SRC-D-OLD\\\\nPOL-2026.2'),('Source revisions','SRC-D-3\\\\nPOL-2026.1')])\\ndef test_wrong_role_actor_subject_version_and_reason_never_authorize(kind,field,value):\\n    p,record,trip=subject(kind);setfield(p['records']['decisions'][0],field,value)\\n    result=check(p,record,trip,kind)\\n    assert not result['approved']\\n    assert any(d['rejection_reasons'] for d in result['deliveries'])\\n    assert result['deliveries'][0]['raw_record']==p['records']['decisions'][0]\\n\\n\\n@pytest.mark.parametrize('kind',['claim','permit'])\\ndef test_explicit_combined_roles_only_for_same_directory_person(kind):\\n    p,record,trip=subject(kind)\\n    person=table(p,'people','People')[0];setfield(person,'Supervisor',fields(person)['Budget owner'])\\n    combined=p['records']['decisions'][1];setfield(combined,'Review roles','budget_owner\\\\nsupervisor')\\n    p['records']['decisions']=p['records']['decisions'][:2]\\n    assert check(p,record,trip,kind)['approved']\\n    setfield(combined,'Review roles','budget_owner')\\n    assert not check(p,record,trip,kind)['approved']\\n    setfield(combined,'Review roles','budget_owner\\\\nsupervisor');setfield(person,'Supervisor','OTHER')\\n    assert not check(p,record,trip,kind)['approved']\\n\\n\\ndef test_permit_approvals_do_not_approve_claims():\\n    p,record,trip=subject('permit')\\n    assert check(p,record,trip,'permit')['approved']\\n    assert not check(p,p['records']['claim_revisions'][0],trip,'claim')['approved']\\n\\n\\n@pytest.mark.parametrize('outcome,state',[('return','returned'),('reject','rejected')])\\ndef test_human_outcomes_and_new_reply_transitions_preserve_history(outcome,state):\\n    p,record,trip=subject();d=p['records']['decisions'][1];setfield(d,'Outcome',outcome)\\n    if outcome=='return':setfield(d,'Repair requested','SYNTHETIC supply corrected receipt')\\n    first=check(p,record,trip);assert first['state']==state\\n    later=deepcopy(d);setfield(later,'Decision reference','SYN-AFTER-REPAIR');setfield(later,'Outcome','approve');setfield(later,'Arrival batch',3);setfield(later,'Decision time (UTC)','2026-09-05T12:00:00')\\n    packet=deepcopy(table(p,'review_packets','Review packets')[1]);setfield(packet,'Decision reference','SYN-AFTER-REPAIR')\\n    p['records']['decisions'].append(later);table(p,'review_packets','Review packets').append(packet)\\n    result=check(p,record,trip)\\n    assert result['approved'] and len(result['deliveries'])==4\\n    assert first['state']==state\\n    assert not next(x for x in result['deliveries'] if x['decision_id']==fields(d)['Decision reference'])['active']\\n\\n\\ndef test_return_without_repair_is_invalid():\\n    p,record,trip=subject();setfield(p['records']['decisions'][0],'Outcome','return')\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a13cfb-36ce-7122-9610-f91773084724","create_time":1792024866.8634343}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
