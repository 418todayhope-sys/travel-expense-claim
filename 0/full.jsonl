       requested_at = _stamp(request_values.get(\\\"Activity time (UTC)\\\"))\\n   356\\t        if not trip_id or not trip_revision or not requested_at:\\n   357\\t            domain.setdefault(\\\"projection_issues\\\", []).append({\\n   358\\t                \\\"record_id\\\": f\\\"cancellation-projection:{cancellation_id}\\\",\\n   359\\t                \\\"reason\\\": \\\"cancellation source lacks the trip binding or requested time required by snapshot.schema.json; process remains in the integration sidecar\\\",\\n   360\\t                \\\"owner\\\": \\\"Travel Administration Lead\\\",\\n   361\\t                \\\"resolution_needed\\\": \\\"verify the cancellation subject and original UTC request time from the retained workbook\\\",\\n   362\\t            })\\n   363\\t            continue\\n   364\\t        snapshot_rows.append({\\n   365\\t            \\\"cancellation_id\\\": cancellation_id,\\n   366\\t            \\\"target_type\\\": target[\\\"subject_type\\\"],\\n   367\\t            \\\"trip_id\\\": str(trip_id),\\n   368\\t            \\\"trip_revision\\\": trip_revision,\\n   369\\t            \\\"permit_id\\\": str(permit_id) if permit_id else None,\\n   370\\t            \\\"permit_revision\\\": int(permit_revision) if permit_revision is not None else None,\\n   371\\t            \\\"status\\\": \\\"confirmed\\\" if process[\\\"state\\\"] == \\\"confirmed\\\" else \\\"requested\\\",\\n   372\\t            \\\"admitted_cancellation_event_ids\\\": list(dict.fromkeys(record_order)),\\n   373\\t            \\\"requested_at\\\": requested_at,\\n   374\\t            \\\"confirmed_at\\\": _stamp(confirmation_values.get(\\\"Activity time (UTC)\\\")) if confirmation else None,\\n   375\\t            \\\"effective_at\\\": _stamp(confirmation_values.get(\\\"Effective time (UTC)\\\")) if confirmation else None,\\n   376\\t            \\\"affected_claim_ids\\\": affected,\\n   377\\t            \\\"source_refs\\\": refs,\\n   378\\t            \\\"original_r