\n    for record in records:\n        value = source_values(record); identity = value.get('Cancellation activity reference')\n        if not text_id(identity):\n            issue(record, 'missing immutable cancellation event identity'); continue\n        groups[identity].append(record)\n    candidates = []\n    for identity, occurrences in groups.items():\n        variants = [payload(r) for r in occurrences] + ([payload(prior[identity])] if identity in prior else [])\n        conflict = any(v != variants[0] for v in variants[1:])\n        if conflict:\n            conflicts.append({'event_id': identity, 'payloads': variants,\n                              'occurrences': [{k: r.get(k) for k in ('source_id', 'source_sha256', 'locator')} for r in occurrences]})\n            for r in occurrences: issue(r, 'conflicting immutable cancellation replay; admitted history preserved')\n        elif len(occurrences) > 1:\n            duplicates.append({'event_id': identity, 'delivery_batches': [source_values(r).get('Arrival batch') for r in occurrences]})\n        if identity in admitted:\n            continue\n        batches = [revision(source_values(r).get('Arrival batch')) for r in occurrences]\n        first = min((b for b in batches if b is not None), default=None)\n        earliest = [r for r in occurrences if first is not None and revision(source_values(r).get('Arrival batch')) == first]\n        if not earliest or any(payload(r) != payload(earliest[0]) for r in earliest):\n            continue\n        candidates.append(earliest[0])\n    processes = {}\n    def apply(record):\n        value = source_values(record); identity = value['Cancellation activity reference']\n        process_id = value['Cancellation reference']; kind = value['Cancelled subject']\n        process = processes.setdefault(process_id, {'cancellation_id': process_id,\n            'target': {'subject_type': kind, 'subject_id': value['Trip reference'] if kind == 'trip' else value['Permit reference'],\n                       'revision': revision(value['Trip revision'] if kind == 'trip' else value['Permit revision'])},\n            'state': 'unseen', 'activity_ids': [], 'history': [], 'next_action': None})\n        process['state'] = 'requested' if value['Action'] == 'requested' else 'confirmed'\n        process['activity_ids'].append(identity)\n        process['history'].append({'event_id': identity, 'action': value['Action'], 'arrival_batch': value['Arrival batch'],\n            'effective_time': value.get('Effective time (UTC)'), 'activity_time_utc': value['Activity time (UTC)'],\n            'actor': value['Acting employee or supervisor'],\n            'source_ref': {k: record.get(k) for k in ('source_id', 'source_sha256', 'locator')}})\n        process['next_action'] = 'await a linked confirmation activity' if process['state'] == 'requested' else None\n    for record in sorted(prior.values(), key=lambda r: (source_values(r)['Action'] != 'requested', utc_time(source_values(r)['Activity time (UTC)']))):\n        apply(record)\n    repeated = defaultdict(list)\n    for record in candidates:\n        value = source_values(record)\n        repeated[(value.get('Cancellation reference'), value.get('Action'), revision(value.get('Arrival batch')))].append(record)\n    # Resolve dependencies, not spreadsheet row order. Initiations are admitted\n    # before confirmations, including a request delivered in a later batch.\n    candidates.sort(key=lambda r: (source_values(r).get('Action') != 'requested', revision(source_values(r).get('Arrival batch')) or 0,\n                                   source_values(r).get('Cancellation activity reference', '')))\n    for record in candidates:\n        value = source_values(record); identity = value['Cancellation activity reference']\n        process_id, action, kind = value.get('Cancellation reference'), value.get('Action'), value.get('Cancelled subject')\n        batch = revision(value.get('Arrival batch'))\n        if not text_id(process_id) or kind not in {'trip', 'permit'} or action not in {'requested', 'confirmed'} or batch is None:\n            issue(record, 'invalid cancellation identity, action, target type or arrival batch'); continue\n        if arrival_batch is not None and batch > arrival_batch:\n            issue(record, 'delivery belongs to a future arrival batch'); continue\n        if len(repeated[(process_id, action, batch)]) > 1:\n            issue(record, 'different repeated actions for one process in the same batch; no authority order supplied'); continue\n        process = processes.get(process_id)\n        if process and any(h['action'] == action for h in process['history']):\n            issue(record, 'different repeated action for an admitted process; history retained'); continue\n        trip_id, trip_rev = value.get('Trip reference'), revision(value.get('Trip revision'))\n        known_trips = [r for r in trips if source_values(r).get('Trip reference') == trip_id\n                       and (source_values(r).get('Arrival batch') is None or revision(source_values(r)['Arrival batch']) is not None\n                            and (arrival_batch is None or revision(source_values(r)['Arrival batch']) <= arrival_batch))]\n        matching = [r for r in known_trips if revision(source_values(r).get('Trip revision')) == trip_rev]\n        latest = max((revision(source_values(r).get('Trip revision')) or 0 for r in known_trips), default=0)\n        if not text_id(trip_id) or trip_rev is None or len(matching) != 1 or trip_rev != latest:\n            issue(record, 'unmatched, conflicting or stale trip target revision'); continue\n        trip = source_values(matching[0])\n        def permit_tuple(v):\n            return v.get('Permit reference') or None, revision(v.get('Permit revision'))\n        if permit_tuple(value) != permit_tuple(trip) or (kind == 'permit' and not all(permit_tuple(value))):\n            issue(record, 'associated permit target does not match exact trip/permit revisions'); continue\n        if (bool(value.get('Permit reference')) != bool(revision(value.get('Permit revision')))\n                or value.get('Permit revision') not in (None, '') and revision(value.get('Permit revision')) is None):\n            issue(record, 'incomplete permit identity/revision'); continue\n        employee = trip.get('Employee ID')\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\n        expected_actor = employee if action == 'requested' else source_values(directory[0]).get('Supervisor') if len(directory) == 1 else None\n        if len(directory) != 1 or not text_id(expected_actor) or value.get('Acting employee or supervisor') != expected_actor:\n            issue(record, 'cancellation actor is not the trip employee or authorized directory supervisor'); continue\n        try:\n            stamp = utc_time(value.get('Activity time (UTC)'))\n            error = observation_error(stamp, clock)\n            if error: raise ValueError(error)\n            if action == 'requested':\n                if value.get('Initiation activity reference') or value.get('Effective time (UTC)'):\n                    raise ValueError('initiation cannot name an initiation or effective time')\n            else:\n                initiation = admitted.get(value.get('Initiation activity reference'))\n                if not initiation:\n                    raise ValueError('confirmation has an unresolved initiation reference; recheck on arrival')\n                start = source_values(initiation)\n                if start.get('Action') != 'requested' or start.get('Cancellation reference') != process_id or target(start) != target(value):\n                    raise ValueError('confirmation does not match the exact initiation/process/target')\n                if stamp <= utc_time(start.get('Activity time (UTC)')):\n                    raise ValueError('confirmation must occur strictly after initiation')\n                if utc_time(value.get('Effective time (UTC)')) != stamp:\n                    raise ValueError('scheduled or backdated effective time is not cancellation authority')\n        except (ValueError, TypeError) as exc:\n            issue(record, str(exc)); continue\n        admitted[identity] = deepcopy(record); apply(record)\n    for record in records:\n        value = source_values(record); process_id = value.get('Cancellation reference'); kind = value.get('Cancelled subject')\n        if text_id(process_id) and kind in {'trip', 'permit'} and process_id not in processes:\n            processes[process_id] = {'cancellation_id': process_id,\n                'target': {'subject_type': kind, 'subject_id': value.get('Trip reference') if kind == 'trip' else value.get('Permit reference'),\n                           'revision': revision(value.get('Trip revision') if kind == 'trip' else value.get('Permit revision'))},\n                'state': 'unseen', 'activity_ids': [], 'history': [], 'next_action': 'resolve invalid or incomplete initiation evidence'}\n    return {'processes': processes, 'issues': issues, 'duplicate_events': duplicates, 'conflicting_events': conflicts,\n            'admitted_records': admitted, 'delivery_history': deepcopy(records), 'finance_effects': [], 'claim_effects': []}\n\"\"\"Shared evidence checks for Finance and business-cancellation admissions.\n\nA calendar-date clock never implies midnight or an end-of-day instant. Events\non that same local date need an explicit cutoff before admission.\n\"\"\"\nfrom datetime import datetime, timezone, date\nfrom zoneinfo import ZoneInfo\n\n\ndef utc_time(value):\n    if not isinstance(value, str) or 'T' not in value:\n        raise ValueError('missing explicit UTC event date/time')\n    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))\n    # Native columns explicitly name UTC; offsetless serialization is UTC.\n    if stamp.utcoffset() is not None and stamp.utcoffset().total_seconds() != 0:\n        raise ValueError('event timestamp is not UTC')\n    return stamp.replace(tzinfo=timezone.utc)\n\n\ndef observation_error(stamp, clock):\n    try:\n        if isinstance(clock, str):\n            cutoff = datetime.fromisoformat(clock.replace('Z', '+00:00'))\n            if cutoff.utcoffset() is None:\n                return 'case cutoff lacks timezone'\n            return 'future observation' if stamp > cutoff else None\n        if isinstance(clock, dict):\n            local = stamp.astimezone(ZoneInfo(clock['timezone'])).date()\n            case_date = date.fromisoformat(clock['date'])\n            if local > case_date:\n                return 'future observation'\n            if local == case_date:\n                return 'same-day cutoff is unknown; no time of day inferred'\n            return None\n    except (KeyError, TypeError, ValueError):\n        return 'invalid authoritative event cutoff'\n    return 'authoritative event cutoff is unavailable'\n\n\ndef text_id(value):\n    return isinstance(value, str) and bool(value.strip()) and value == value.strip()\n\n\ndef source_values(row):\n    return {k: v.get('value') for k, v in row.get('values', {}).items()}\n\n\ndef finance_context(parsed, revisions, events, claim_id, arrival_batch=None):\n    \"\"\"Bind source-observed request IDs to historical claim employees/directory.\n\n    Acceptance is request identity evidence, never reimbursement entitlement.\n    A cash row cannot manufacture its own request binding.\n    \"\"\"\n    records = parsed.get('records', {})\n    people = records.get('people', next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == 'People'), []))\n    bindings = {}\n    seen = set()\n    for event in events:\n        value = source_values(event)\n        if value.get('Activity reference') in seen:\n            continue\n        seen.add(value.get('Activity reference'))\n        if value.get('Claim reference') != claim_id or value.get('Activity type') != 'accepted':\n            continue\n        occurrences = [source_values(r) for r in events if source_values(r).get('Activity reference') == value.get('Activity reference')]\n        try:\n            first_batch = min(int(v['Arrival batch']) for v in occurrences)\n            first = [v for v in occurrences if int(v['Arrival batch']) == first_batch]\n            immutable = lambda v: {k: x for k, x in v.items() if k != 'Arrival batch'}\n            if any(immutable(v) != immutable(first[0]) for v in first):\n                continue  # A conflicted first delivery cannot establish a request.\n            value = first[0]\n            if observation_error(utc_time(value.get('Activity time (UTC)')), parsed.get('event_clock') or parsed.get('case_clock')):\n                continue\n            batch = int(value['Arrival batch'])\n            available = [r for r in revisions if r.get('arrival_batch') is not None and int(r['arrival_batch']) <= batch]\n            revision = max(available, key=lambda r: r['revision'])\n        except (TypeError, ValueError, KeyError):\n            continue\n        employee = next((f['value'] for f in revision['record'].get('fields', []) if f['label'] == 'Employee'), None)\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\n        if len(directory) != 1:\n            continue\n        person = source_values(directory[0])\n        if value.get('Finance officer') != person.get('Finance officer') or value.get('Payee ID') != person.get('Payee ID'):\n            continue\n        if value.get('Currency') != 'EUR':\n            continue\n        request = value.get('Request reference')\n        if not all(text_id(x) for x in (request, person.get('Payee ID'), person.get('Finance officer'))):\n            continue\n        binding = dict(claim_id=claim_id, payee_id=person['Payee ID'], actor=person['Finance officer'], currency='EUR')\n        # Conflicting request ownership is unresolved rather than last-wins.\n        if request in bindings and bindings[request] != binding:\n            bindings[request] = None\n        else:\n            bindings.setdefault(request, binding)\n    for request_row in records.get('reimbursement_requests', []):\n        value = source_values(request_row)\n        batch = value.get('Arrival batch')\n        try:\n            if isinstance(batch, bool) or int(batch) != float(batch) or int(batch) < 1 or arrival_batch is not None and int(batch) > arrival_batch:\n                continue\n        except (TypeError, ValueError, OverflowError):\n            continue\n        matches = [r for r in revisions if r['revision'] == value.get('Revision')]\n        if value.get('Claim reference') != claim_id or len(matches) != 1 or value.get('Currency') != 'EUR':\n            continue\n        employee = next((f['value'] for f in matches[0]['record'].get('fields', []) if f['label'] == 'Employee'), None)\n        directory = [r for r in people if source_values(r).get('Employee ID') == employee]\n        if len(directory) != 1:\n            continue\n        person = source_values(directory[0]); request = value.get('Request reference')\n        if not text_id(request) or value.get('Payee ID') != person.get('Payee ID'):\n            continue\n        binding = dict(claim_id=claim_id, payee_id=person.get('Payee ID'), actor=person.get('Finance officer'), currency='EUR')\n        if request in bindings and bindings[request] != binding:\n            bindings[request] = None\n        else:\n            bindings.setdefault(request, binding)\n    return {'requests': bindings, 'clock': parsed.get('event_clock') or parsed.get('case_clock')}\n\n\ndef finance_errors(value, classification, context, cents):\n    errors = []\n    if not all(text_id(value.get(k)) for k in ('Activity reference', 'Claim reference', 'Request reference', 'Payee ID', 'Finance officer')):\n        errors.append('missing or malformed event/request/claim/payee/actor identity')\n    binding = (context or {}).get('requests', {}).get(value.get('Request reference'))\n    if not binding:\n        errors.append('request has no unambiguous source-bound directory authority')\n    elif any(value.get(field) != binding.get(key) for field, key in (\n            ('Claim reference', 'claim_id'), ('Payee ID', 'payee_id'), ('Finance officer', 'actor'), ('Currency', 'currency'))):\n        errors.append('request/claim/payee/currency/Finance actor does not match authority')\n    if value.get('Currency') != 'EUR':\n        errors.append('unsupported Finance currency')\n    if classification in {'confirmed_payment', 'confirmed_refund', 'pending_transfer'} or value.get('Amount (EUR)') is not None:\n        amount = cents(value.get('Amount (EUR)'))\n        if amount is None or amount <= 0:\n            errors.append('cash amount must be positive integer cents')\n    if classification in {'obligation_accepted', 'finance_adjustment', 'finance_resolution'} and cents(value.get('Obligation (EUR)')) is None:\n        errors.append('obligation amount lacks exact nonnegative cents')\n    try:\n        error = observation_error(utc_time(value.get('Activity time (UTC)')), (context or {}).get('clock'))\n        if error:\n            errors.append(error)\n    except (ValueError, TypeError):\n        errors.append('invalid UTC event time')\n    return errors\n\"\"\"POL-2026.2 lines 21, 27 and 29; no real financial projections changed.\"\"\"\nfrom copy import deepcopy\nimport json\n\nimport pytest\n\nfrom test_finance import _finance_row\nfrom test_integration import _parsed_fixture, _integrate\nfrom travel_claim.finance import reconcile_finance_events\nfrom travel_claim.workflow import reduce_cancellation_activities\n\nCLOCK = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}\nCONTEXT = {'clock': CLOCK, 'requests': {'REQ-SYN': {\n    'claim_id': 'C-SYN-01', 'payee_id': 'EMP-SYN', 'actor': 'FIN-SYN-01', 'currency': 'EUR'}}}\n\n\ndef finance(events, previous=None, context=CONTEXT):\n    return reconcile_finance_events(events, claim_id='C-SYN-01', current_revision=1,\n        event_context=context, previous_reconciliation=previous,\n        authorized_obligation={'amount_cents': 1000, 'claim_revision': 1, 'source_refs': ['synthetic:authority']})\n\n\ndef payment():\n    return _finance_row(1, 'SYN-PAY', 'settled', amount=10)\n\n\ndef test_admitted_payment_survives_conflict_exact_replay_and_delta_only_calls():\n    first = payment(); initial = finance([first]); saved = deepcopy(initial)\n    replay = deepcopy(first); replay['values']['Arrival batch']['value'] = 2; replay['locator'] = 'SYNTHETIC redelivery'\n    duplicate = finance([replay], initial)\n    assert duplicate['net_confirmed_cents'] == 1000\n    assert len(duplicate['event_history']) == 2\n    bad = deepcopy(replay); bad['values']['Amount (EUR)']['value'] = 99; bad['locator'] = 'SYNTHETIC conflict'\n    held = finance([bad], duplicate)\n    assert held['net_confirmed_cents'] == 1000 and held['balance_cents'] is None\n    assert held['confirmed_payment_event_ids'] == ['SYN-PAY']\n    assert held['admitted_events']['SYN-PAY']['source_record']['Amount (EUR)'] == 10\n    assert held['conflicting_events'] and any('conflict' in i['record_id'] for i in held['repair_issues'])\n    # Another exact replay does not silently resolve the earlier conflict.\n    final = finance([replay], json.loads(json.dumps(held)))\n    assert final['net_confirmed_cents'] == 1000 and final['balance_cents'] is None\n    assert len(final['event_history']) == 3\n    assert final['admitted_events'] == initial['admitted_events']\n    assert initial == saved\n\n\n@pytest.mark.parametrize('field,value', [\n    ('Activity reference', ''), ('Request reference', 'REQ-UNKNOWN'), ('Payee ID', 'WRONG'),\n    ('Currency', 'USD'), ('Finance officer', 'EMP-SYN'), ('Amount (EUR)', 0),\n    ('Amount (EUR)', -1), ('Amount (EUR)', '0.001'), ('Amount (EUR)', True),\n    ('Activity time (UTC)', 'not-a-time'), ('Activity time (UTC)', '2026-11-16T00:00:00Z'),\n    ('Activity time (UTC)', '2026-11-15T00:00:00Z'), ('Activity time (UTC)', '2026-09-01T12:00:00+01:00')])\ndef test_invalid_finance_delivery_stays_visible_without_admission(field, value):\n    event = payment(); event['values'][field]['value'] = value\n    result = finance([event])\n    assert result['net_confirmed_cents'] == 0 and result['admitted_events'] == {}\n    assert result['balance_cents'] is None\n    assert result['event_history'][0]['source_record'][field] == value\n    assert result['repair_issues']\n\n\ndef test_missing_finance_fields_and_context_do_not_gain_authority_from_event_itself():\n    for field in ('Request reference', 'Payee ID', 'Finance officer', 'Activity time (UTC)'):\n        event = payment(); event['values'].pop(field)\n        assert finance([event])['admitted_events'] == {}\n    assert finance([payment()], context=None)['admitted_events'] == {}\n\n\ndef test_same_batch_conflicts_are_held_without_choosing_sheet_row_authority():\n    event = payment(); conflict = deepcopy(event); conflict['values']['Amount (EUR)']['value'] = 11\n    assert finance([event, conflict])['admitted_events'] == {}\n    assert finance([conflict, event])['net_confirmed_cents'] == 0\n\n\ndef test_refunds_keep_admitted_money_and_validate_original_payee_request_and_remainder():\n    transfer = payment()\n    refund = _finance_row(2, 'SYN-REFUND', 'refund', amount=4, original='SYN-PAY', batch=2)\n    initial = finance([transfer, refund]); assert initial['net_confirmed_cents'] == 600\n    excess = _finance_row(3, 'SYN-EXCESS', 'refund', amount=7, original='SYN-PAY', batch=3)\n    result = finance([excess], initial)\n    assert result['net_confirmed_cents'] == 600\n    assert result['confirmed_refund_event_ids'] == ['SYN-REFUND']\n    assert 'SYN-EXCESS' in result['unresolved_event_ids']\n    bad = deepcopy(refund); bad['values']['Amount (EUR)']['value'] = 5; bad['locator'] = 'SYNTHETIC refund conflict'\n    result = finance([bad], initial)\n    assert result['net_confirmed_cents'] == 600 and result['conflicting_events']\n\n\ndef business():\n    parsed = _parsed_fixture()\n    events = [r for r in parsed['records']['cancellation_activities']\n              if r['values']['Cancellation reference']['value'] == 'TC-SYN-TRIP']\n    return events, {'trips': parsed['records']['trips'], 'people': parsed['records']['people'],\n                    'clock': CLOCK, 'arrival_batch': 4}\n\n\ndef reduce(events, ctx, previous=None):\n    return reduce_cancellation_activities(events, previous_state=previous, **ctx)\n\n\n@pytest.mark.parametrize('fault', ['actor', 'equal', 'scheduled', 'backdated', 'future', 'same-day',\n                                  'target', 'permit', 'initiation', 'stale-trip', 'stale-permit'])\ndef test_invalid_confirmation_cannot_establish_authority(fault):\n    events, ctx = business(); value = events[1]['values']\n    if fault == 'actor': value['Acting employee or supervisor']['value'] = 'FIN-SYN-01'\n    elif fault == 'equal':\n        value['Activity time (UTC)']['value'] = events[0]['values']['Activity time (UTC)']['value']\n        value['Effective time (UTC)']['value'] = value['Activity time (UTC)']['value']\n    elif fault in {'scheduled', 'backdated'}: value['Effective time (UTC)']['value'] = '2026-09-03T09:00:00' if fault == 'scheduled' else '2026-09-01T09:00:00'\n    elif fault in {'future', 'same-day'}:\n        value['Activity time (UTC)']['value'] = '2026-11-16T09:00:00Z' if fault == 'future' else '2026-11-15T09:00:00Z'\n        value['Effective time (UTC)']['value'] = value['Activity time (UTC)']['value']\n    elif fault == 'target': value['Trip reference']['value'] = 'T-SYN-02'\n    elif fault == 'permit': value['Permit reference']['value'] = 'P-OTHER'\n    elif fault == 'initiation': value['Initiation activity reference']['value'] = 'UNMATCHED'\n    elif fault == 'stale-trip':\n        new = deepcopy(ctx['trips'][0]); new['values']['Trip revision']['value'] = 2; ctx['trips'].append(new)\n    else: value['Permit revision']['value'] = 9\n    result = reduce(events, ctx)\n    assert result['processes']['TC-SYN-TRIP']['state'] != 'confirmed'\n    assert events[1] in result['delivery_history'] and result['issues']\n    assert events[1]['values']['Cancellation activity reference']['value'] not in result['admitted_records']\n    assert result['finance_effects'] == []\n\n\ndef test_invalid_and_conflicting_deliveries_preserve_admitted_cancellation_history():\n    events, ctx = business(); initial = reduce(events, ctx); saved = deepcopy(initial)\n    process = initial['processes']['TC-SYN-TRIP']\n    assert process['state'] == 'confirmed'\n    wrong = deepcopy(events[1]); wrong['values']['Acting employee or supervisor']['value'] = 'FIN-SYN-01'\n    wrong['values']['Arrival batch']['value'] = 3; wrong['locator'] = 'SYNTHETIC invalid redelivery'\n    result = reduce([wrong], ctx, json.loads(json.dumps(initial)))\n    assert result['processes']['TC-SYN-TRIP'] == process\n    assert result['admitted_records'] == initial['admitted_records']\n    assert result['conflicting_events'] and len(result['delivery_history']) == 3\n    replay = deepcopy(events[1]); replay['values']['Arrival batch']['value'] = 4\n    final = reduce([replay], ctx, result)\n    assert final['processes']['TC-SYN-TRIP'] == process\n    assert final['issues'] and initial == saved\n\n\ndef test_confirmation_rechecks_when_initiation_arrives_and_never_depends_on_row_order():\n    events, ctx = business(); request, confirm = events\n    confirm['values']['Arrival batch']['value'] = 1; request['values']['Arrival batch']['value'] = 2\n    first = reduce([confirm], {**ctx, 'arrival_batch': 1})\n    assert first['processes']['TC-SYN-TRIP']['state'] == 'unseen'\n    final = reduce([request], {**ctx, 'arrival_batch': 2}, first)\n    assert final['processes']['TC-SYN-TRIP']['state'] == 'confirmed'\n    request['values']['Arrival batch']['value'] = 1\n    confirm['row'] = 1; request['row'] = 999\n    assert reduce([confirm, request], ctx)['processes']['TC-SYN-TRIP']['state'] == 'confirmed'\n\n\ndef test_requested_record_fields_and_arrival_cutoff_are_validated():\n    events, ctx = business()\n    for field in ('Initiation activity reference', 'Effective time (UTC)'):\n        changed = deepcopy(events[0]); changed['values'][field] = {'value': 'invalid-on-initiation'}\n        assert reduce([changed], ctx)['admitted_records'] == {}\n    result = reduce([events[1]], {**ctx, 'arrival_batch': 1})\n    assert result['admitted_records'] == {}\n\n\ndef test_repeated_action_keeps_one_valid_process_and_creates_hold():\n    events, ctx = business(); initial = reduce(events, ctx)\n    repeated = deepcopy(events[1]); repeated['values']['Cancellation activity reference']['value'] = 'SYN-SECOND-CONFIRM'\n    repeated['values']['Arrival batch']['value'] = 3\n    result = reduce([repeated], ctx, initial)\n    assert result['processes'] == initial['processes']\n    assert any('repeated action' in i['reason'] for i in result['issues'])\n\n\ndef test_integration_never_projects_wrong_supervisor_as_confirmed_or_erases_cash_on_conflict():\n    parsed = _parsed_fixture()\n    for event in parsed['records']['cancellation_activities']:\n        if event['values']['Action']['value'] == 'confirmed': event['values']['Acting employee or supervisor']['value'] = 'FIN-SYN-01'\n    first = _integrate(parsed, 1); second = _integrate(parsed, 2, previous=first)\n    assert all(c['status'] == 'requested' for c in second['snapshot']['travel_cancellations'])\n    bad = deepcopy(parsed['records']['finance_events'][0]); bad['values']['Arrival batch']['value'] = 3\n    bad['values']['Amount (EUR)']['value'] = 999\n    parsed['records']['finance_events'].append(bad)\n    final = _integrate(parsed, 3, previous=second)\n    finance_result = final['finance_reconciliations']['C-SYN-01']\n    assert finance_result['net_confirmed_cents'] == 1000\n    assert 'F-SYN-01-SETTLED' in final['snapshot']['admitted_event_ids']\n    assert finance_result['conflicting_events'] and finance_result['balance_cents'] is None\n\n\ndef test_legacy_cash_state_cannot_be_silently_reinterpreted_as_unadmitted_zero():\n    with pytest.raises(ValueError, match='verified migration'):\n        finance([payment()], previous={'net_confirmed_cents': 1000, 'claim_revision': 1})\n\n\ndef test_local_calendar_clock_uses_zone_without_inventing_a_time_of_day():\n    event = payment(); event['values']['Activity time (UTC)']['value'] = '2026-11-14T23:00:00Z'\n    assert finance([event])['admitted_events'] == {}  # Nov 15 in Amsterdam; cutoff unknown\n    event['values']['Activity time (UTC)']['value'] = '2026-11-14T22:59:59Z'\n    assert finance([event])['net_confirmed_cents'] == 1000\n\n\ndef test_unknown_claim_finance_delivery_is_visible_and_never_admitted():\n    parsed = _parsed_fixture()\n    event = deepcopy(parsed['records']['finance_events'][0])\n    event['values']['Claim reference']['value'] = 'SYN-NO-CLAIM'\n    event['values']['Activity reference']['value'] = 'SYN-UNMATCHED'\n    parsed['records']['finance_events'].append(event)\n    first = _integrate(parsed, 1); final = _integrate(parsed, 2, previous=first)\n    assert event in final['domain']['unmatched_finance_records']\n    assert 'SYN-UNMATCHED' not in final['snapshot']['admitted_event_ids']\n    assert any(i['record_id'].startswith('finance-unmatched:') for i in final['snapshot']['issues'])\n\n\ndef test_no_claim_cancellation_validates_authority_without_creating_finance_effect():\n    from test_retained_finance import _fixture\n    parsed = _fixture()\n    events = [r for r in parsed['records']['cancellation_activities'] if r['values']['Cancellation reference']['value'] == 'TC122']\n    result = reduce_cancellation_activities(events, trips=parsed['records']['trips'], people=parsed['records']['people'], clock=CLOCK)\n    assert result['processes']['TC122']['state'] == 'confirmed'\n    assert len(result['admitted_records']) == 2\n    assert result['finance_effects'] == [] and result['claim_effects'] == []\n\n\ndef test_deferred_confirmation_resolves_only_its_owned_reference_repair():\n    parsed = _parsed_fixture()\n    parsed['records']['cancellation_activities'] = [r for r in parsed['records']['cancellation_activities']\n        if r['values']['Cancellation reference']['value'] == 'TC-SYN-TRIP']\n    for record in parsed['records']['cancellation_activities']:\n        record['values']['Arrival batch']['value'] = 2 if record['values']['Action']['value'] == 'requested' else 1\n    first = _integrate(parsed, 1)\n    issue_ids = [key for key in first['domain']['repair_queue']['items'] if key.startswith('cancellation-evidence:')]\n    assert issue_ids\n    second = _integrate(parsed, 2, previous=first)\n    assert second['snapshot']['travel_cancellations'][0]['status'] == 'confirmed'\n    assert all(second['domain']['repair_queue']['items'][key]['status'] == 'resolved' for key in issue_ids)\n    assert all(first['domain']['repair_queue']['items'][key]['status'] == 'open' for key in issue_ids)\n\n\ndef test_conflicting_first_acceptance_cannot_supply_request_authority_for_cash():\n    parsed = _parsed_fixture()\n    # Remove independently supplied request identity; a same-batch conflict\n    # cannot replace it with an arbitrary first worksheet row.\n    parsed['records']['reimbursement_requests'] = []\n    accepted = deepcopy(parsed['records']['finance_events'][0])\n    accepted['values']['Activity reference']['value'] = 'SYN-ACCEPT-CONFLICT'\n    accepted['values']['Activity type']['value'] = 'accepted'\n    accepted['values']['Arrival batch']['value'] = 1\n    accepted['values']['Obligation (EUR)'] = {'value': 10}\n    accepted['values'].pop('Amount (EUR)')\n    conflict = deepcopy(accepted); conflict['values']['Payee ID']['value'] = 'SYN-WRONG-PAYEE'\n    parsed['records']['finance_events'] += [accepted, conflict]\n    first = _integrate(parsed, 1); second = _integrate(parsed, 2, previous=first)\n    assert second['fi