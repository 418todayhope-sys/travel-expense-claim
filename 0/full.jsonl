  261\t                    \"owner\": owner,\n   262\t                    \"next_action\": \"Finance to identify this ledger event and provide its native activity reference\",\n   263\t                }\n   264\t            continue\n   265\t        if classification == \"unresolved\":\n   266\t            unresolved.append(item)\n   267\t            continue\n   268\t        if classification in {\"confirmed_payment\", \"confirmed_refund\"}:\n   269\t            if values.get(\"Currency\") != \"EUR\" or item[\"amount_cents\"] is None:\n   270\t                unresolved.append(item)\n   271\t                continue\n   272\t        typed.append(item)\n   273\t\n   274\t    payments = {item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_payment\"}\n   275\t    confirmed_refunds: list[dict[str, Any]] = []\n   276\t    refund_candidates = list({item[\"event_id\"]: item for item in typed if item[\"classification\"] == \"confirmed_refund\"}.values())\n   277\t    refund_groups: dict[str, list[dict[str, Any]]] = defaultdict(list)\n   278\t    for item in refund_candidates:\n   279\t        original_id = item[\"original_activity_id\"]\n   280\t        original = payments.get(original_id) if isinstance(original_id, str) else None\n   281\t        if original is None or original.get(\"currency\") != item.get(\"currency\"):\n   282\t            unresolved.append(item)\n   283\t            continue\n   284\t        refund_groups[original_id].append(item)\n   285\t    for original_id, refunds in refund_groups.items():\n   286\t        original = payments[original_id]\n   287\t        refund_total = sum(item[\"amount_cents\"] for item in refunds)\n   288\t        if refund_total > original[\"amount_cents\"]:\n   289\t            unresolved.extend(refunds)\n   290\t            continue\n   291\t        confirmed_refunds.extend(refunds)\n   292\t\n   293\t    invalid_payments = [item for item in payments.values() if item[\"amount_cents\"] is None]\n   294\t    unresolved.extend(invalid_payments)\n   295\t    confirmed_payment_cents = sum(item[\"amount_cents\"] for item in payments.values() if item[\"amount_cents\"] is not None)\n   296\t    confirmed_refund_cents = sum(item[\"amount_cents\"] for item in confirmed_refunds)\n   297\t    net_confirmed_cents = confirmed_payment_cents - confirmed_refund_cents\n   298\t\n   299\t    issues = list(event_issue_by_id.values())\n   300\t    for number, item in enumerate(unresolved, 1):\n   301\t        issue_id = f\"finance-unresolved:{item['event_id'] or number}\"\n   302\t        issue = {\n   303\t            \"record_id\": issue_id,\n   304\t            \"event_id\": item[\"event_id\"],\n   305\t            \"subject_type\": \"claim\",\n   306\t            \"subject_id\": claim_id,\n   307\t            \"revision\": current_revision,\n   308\t            \"source_refs\": [item[\"source_ref\"]],\n   309\t            \"missing_or_return_reason\": (\n   310\t                f\"Finance event {item['event_id']!r} is not sufficiently classified or linked for cash reconciliation\"\n   311\t            ),\n   312\t            \"owner\": owner,\n   313\t            \"next_action\": \"Finance to confirm event meaning, amount, currency, or refund link from the native ledger\",\n   314\t        }\n   315\t        issues.append(issue)\n   316\t    obligation_history, recorded_obligation, recorded_problem = _recorded_obligations(\n   317\t        history, claim_id=claim_id, current_revision=current_revision, revisions=revision_history or [],\n   318\t    )\n   319\t    if recorded_problem:\n   320\t        issues.append({\n   321\t            \"record_id\": f\"finance-recorded-obligation:{claim_id}:{current_revision}\",\n   322\t            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n   323\t            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n   324\t            \"owner\": owner, \"missing_or_return_reason\": recorded_problem,\n   325\t            \"next_action\": \"Finance to confirm the obligation's request, amount, chronology and exact claim revision from retained source evidence\",\n   326\t        })\n   327\t    obligation = None\n   328\t    obligation_issue = None\n   329\t    if authorized_obligation is not None:\n   330\t        amount = authorized_obligation.get(\"amount_cents\")\n   331\t        obligation_revision = authorized_obligation.get(\"claim_revision\")\n   332\t        refs = authorized_obligation.get(\"source_refs\")\n   333\t        if (isinstance(amount, int) and not isinstance(amount, bool) and amount >= 0\n   334\t                and obligation_revision == current_revision and isinstance(refs, list)\n   335\t                and refs and all(isinstance(ref, str) and ref for ref in refs)):\n   336\t            obligation = {\"amount_cents\": amount, \"claim_revision\": obligation_revision, \"source_refs\": list(dict.fromkeys(refs))}\n   337\t        else:\n   338\t            obligation_issue = {\n   339\t                \"record_id\": f\"finance-obligation-invalid:{claim_id}:{current_revision}\",\n   340\t                \"event_id\": None,\n   341\t                \"subject_type\": \"claim\",\n   342\t                \"subject_id\": claim_id,\n   343\t                \"revision\": current_revision,\n   344\t                \"source_refs\": list(refs) if isinstance(refs, list) else [],\n   345\t                \"missing_or_return_reason\": \"authorized obligation is missing exact cents, current-revision match, or supporting source reference\",\n   346\t                \"owner\": owner,\n   347\t                \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n   348\t            }\n   349\t    else:\n   350\t        obligation_issue = {\n   351\t            \"record_id\": f\"finance-obligation-missing:{claim_id}:{current_revision}\",\n   352\t            \"event_id\": None,\n   353\t            \"subject_type\": \"claim\",\n   354\t            \"subject_id\": claim_id,\n   355\t            \"revision\": current_revision,\n   356\t            \"source_refs\": [e[\"source_ref\"] for e in history if e[\"event_id\"] in {r[\"event_id\"] for r in obligation_history}],\n   357\t            \"missing_or_return_reason\": (\"recorded Finance obligation exists, but current-revision reimbursement authorization and entitlement remain unconfirmed\"\n   358\t                                         if recorded_obligation else \"no supported authorized obligation was supplied for this claim revision\"),\n   359\t            \"owner\": owner,\n   360\t            \"next_action\": \"Finance to provide or confirm the authorized obligation for this claim revision\",\n   361\t        }\n   362\t    if obligation_issue is not None:\n   363\t        issues.append(obligation_issue)\n   364\t\n   365\t    has_unclassified_cash_event = any(item[\"classification\"] == \"unresolved\" for item in history)\n   366\t    event_set_complete = not unresolved and not conflicting_events and not missing_id_records and not has_unclassified_cash_event\n   367\t    balance = None\n   368\t    if obligation is not None and event_set_complete:\n   369\t        balance = obligation[\"amount_cents\"] - net_confirmed_cents\n   370\t\n   371\t    ledger_balance = None\n   372\t    if recorded_obligation is not None and event_set_complete and not recorded_problem:\n   373\t        # Cash for a different/missing request cannot be silently applied to this ledger.\n   374\t        cash_rows = [e for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund'}]\n   375\t        if all(e['source_record'].get('Request reference') == recorded_obligation['request_id']\n   376\t               and e['source_record'].get('Payee ID') == recorded_obligation['payee_id'] for e in cash_rows):\n   377\t            ledger_balance = recorded_obligation['amount_cents'] - net_confirmed_cents\n   378\t    if recorded_obligation is…31 tokens truncated…\": f\"finance-recorded-cash-link:{claim_id}:{current_revision}\",\n   381\t            \"subject_type\": \"claim\", \"subject_id\": claim_id, \"revision\": current_revision,\n   382\t            \"source_refs\": [e[\"source_ref\"] for e in history if e['classification'] in {'confirmed_payment', 'confirmed_refund', 'obligation_accepted'}],\n   383\t            \"owner\": owner,\n   384\t            \"missing_or_return_reason\": \"Confirmed claim cash cannot be matched to the recorded obligation's request and payee\",\n   385\t            \"next_action\": \"Finance to verify each cash event's request and payee link before calculating a ledger difference\",\n   130\t                source_refs = []\n   131\t            else:\n   132\t                result = \"revision_match_current\" if revision == target[\"current_revision\"] else \"revision_match_historical\"\n   133\t                source_refs = [item[\"source_ref\"] for item in occurrences]\n   134\t        matches.append({\n   135\t            \"decision_id\": decision_id,\n   136\t            \"subject_type\": kind,\n   137\t            \"subject_id\": subject_id,\n   138\t            \"revision\": revision,\n   139\t            \"observed_outcome\": values.get(\"Outcome\"),\n   140\t            \"structural_match\": result,\n   141\t            \"matched_source_refs\": source_refs,\n   142\t            \"decision_source_ref\": _source_ref(record),\n   143\t            \"applied\": False,\n   144\t        })\n   145\t    return matches\n   146\t\n   147\t\n   148\tdef _business_payload(record: dict[str, Any], id_field: str, ignore_fields: set[str]) -> dict[str, Any]:\n   149\t    values = row_values(record)\n   150\t    return {key: values[key] for key in sorted(values) if key != id_field and key not in ignore_fields}\n   151\t\n   152\t\n   153\tdef deduplicate_activity_records(\n   154\t    records: list[dict[str, Any]], *, id_field: str, ignore_fields: tuple[str, ...] = (\"Arrival batch\",)\n   155\t) -> dict[str, Any]:\n   156\t    \"\"\"Deduplicate immutable event IDs, ignoring only declared delivery fields.\n   157\t\n   158\t    All source occurrences remain cited. A differing business payload for an\n   159\t    existing ID is reported as a conflict and never replaces the first event.\n   160\t    \"\"\"\n   161\t    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n   162\t    missing_id = []\n   163\t    for record in records:\n   164\t        event_id = row_values(record).get(id_field)\n   165\t        if not isinstance(event_id, str) or not event_id:\n   166\t            missing_id.append({\"source_ref\": _source_ref(record), \"reason\": f\"missing {id_field}\"})\n   167\t        else:\n   168\t            by_id[event_id].append(record)\n   169\t    admitted, duplicates, conflicts = [], [], []\n   170\t    for event_id, occurrences in by_id.items():\n   171\t        first = occurrences[0]\n   172\t        first_payload = _business_payload(first, id_field, set(ignore_fields))\n   173\t        disagree = [row for row in occurrences[1:]\n   174\t                    if _business_payload(row, id_field, set(ignore_fields)) != first_payload]\n   175\t        refs = [_source_ref(row) for row in occurrences]\n   176\t        if disagree:\n   177\t            conflicts.append({\"event_id\": event_id, \"id_field\": id_field,\n   178\t                              \"occurrences\": refs,\n   179\t                              \"payloads\": [first_payload] + [_business_payload(row, id_field, set(ignore_fields)) for row in disagree]})\n   180\t            continue\n   181\t        admitted.append(first)\n   182\t        if len(occurrences) > 1:\n   183\t            duplicates.append({\"event_id\": event_id, \"id_field\": id_field,\n   184\t                               \"source_occurrences\": refs,\n   185\t                               \"delivery_batches\": [row_values(row).get(\"Arrival batch\") for row in occurrences]})\n   186\t    return {\"unique_events\": admitted, \"duplicates\": duplicates, \"conflicts\": conflicts, \"missing_ids\": missing_id}\n   187\t\n   188\t\n   189\tdef reduce_cancellation_activities(records: list[dict[str, Any]]) -> dict[str, Any]:\n   190\t    \"\"\"Track independent trip/permit cancellation requests and confirmations.\n   191\t\n   192\t    Ordering uses supplied arrival batch then workbook row, never activity\n   193\t    timestamps. A confirmed action is structural only; it does not settle any\n   194\t    claim or Finance obligation.\n   195\t    \"\"\"\n   196\t    dedup = deduplicate_activity_records(records, id_field=\"Cancellation activity reference\")\n   197\t    conflicting_ids = {issue[\"event_id\"] for issue in dedup[\"conflicts\"]}\n   198\t    events = [record for record in dedup[\"unique_events\"]\n   199\t              if row_values(record).get(\"Cancellation activity reference\") not in conflicting_ids]\n   200\t    events.sort(key=lambda row: (\n   201\t        _revision(row_values(row).get(\"Arrival batch\")) or 0,\n   202\t        row.get(\"row\", 0),\n   203\t    ))\n   204\t    processes: dict[str, dict[str, Any]] = {}\n   205\t    issues = list(dedup[\"conflicts\"])\n   206\t    id_lookup: dict[str, tuple[str, dict[str, Any]]] = {}\n   207\t    for record in events:\n   208\t        values = row_values(record)\n   209\t        event_id = values.get(\"Cancellation activity reference\")\n   210\t        cancellation_id = values.get(\"Cancellation reference\")\n   211\t        action = values.get(\"Action\")\n   212\t        subject_type = values.get(\"Cancelled subject\")\n   213\t        if not cancellation_id or subject_type not in {\"trip\", \"permit\"}:\n   214\t            issues.append({\"event_id\": event_id, \"source_ref\": _source_ref(record), \"reason\": \"missing cancellation ID or unsupported target type\"})\n   215\t            continue\n   216\t        target_id = values.get(\"Trip reference\") if subject_type == \"trip\" else values.get(\"Permit reference\")\n   217\t        target_revision = _revision(values.get(\"Trip revision\") if subject_type == \"trip\" else values.get(\"Permit revision\"))\n   218\t        target = {\"subject_type\": subject_type, \"subject_id\": target_id, \"revision\": target_revision}\n   219\t        process = processes.setdefault(str(cancellation_id), {\n   220\t            \"cancellation_id\": cancellation_id, \"target\": target, \"state\": \"unseen\",\n   221\t            \"activity_ids\": [], \"history\": [], \"next_action\": \"await request activity\",\n   222\t        })\n   223\t        if process[\"target\"] != target:\n   224\t            issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n   225\t                           \"source_ref\": _source_ref(record), \"reason\": \"cancellation target identity/revision conflicts with prior activity\"})\n   226\t            continue\n   227\t        if action == \"requested\":\n   228\t            if process[\"state\"] != \"unseen\":\n   229\t                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n   230\t                               \"source_ref\": _source_ref(record), \"reason\": f\"request is not valid after state {process['state']}\"})\n   231\t                continue\n   232\t            process[\"state\"] = \"requested\"\n   233\t            process[\"next_action\"] = \"await a linked confirmation activity\"\n   234\t        elif action == \"confirmed\":\n   235\t            initiation = values.get(\"Initiation activity reference\")\n   236\t            linked = id_lookup.get(str(initiation)) if initiation else None\n   237\t            if process[\"state\"] != \"requested\" or not linked or linked[0] != cancellation_id or row_values(linked[1]).get(\"Action\") != \"requested\":\n   238\t                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n   239\t                               \"source_ref\": _source_ref(record), \"reason\": \"confirmation does not link to a prior request activity\"})\n   240\t                continue\n   241\t            if not values.get(\"Effective time (UTC)\"):\n   242\t                process[\"state\"] = \"requested\"\n   243\t                process[\"next_action\"] = \"obtain the missing effective time or confirmation record\"\n   244\t                issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n   245\t                               \"source_ref\": _source_ref(record), \"reason\": \"confirmation has no effective time\"})\n   246\t                continue\n   247\t            # Explicitly UTC columns give timezone context, but never a case clock.\n   248\t            stamps = [row_values(linked[1]).get(\"Activity time (UTC)\"),\n   249\t                      values.get(\"Activity time (UTC)\"), values.get(\"Effective time (UTC)\")]\n   250\t            try:\n   251\t                times = [datetime.fromisoformat(t.replace(\"Z\", \"+00:00\")) for t in stamps]\n   252\t                if times[1] < times[0] or times[2] < times[0]:\n   253\t                    raise ValueError(\"confirmation precedes initiation\")\n   254\t            except (TypeError, ValueError, AttributeError):\n   255\t                # Older structural-only inputs may omit all activity timestamps;\n   256\t                # they remain structural observations, not verified authority.\n   257\t                if any(stamps[:2]):\n   258\t                    issues.append({\"cancellation_id\": cancellation_id, \"event_id\": event_id,\n   259\t                                   \"source_ref\": _source_ref(record), \"reason\": \"missing, invalid or inconsistent UTC cancellation chronology\"})\n   260\t                    continue\n   261\t            process[\"state\"] = \"confirmed\"\n   262\t            process[\"next_action\"] = None\n   263\t     