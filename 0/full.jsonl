{"timestamp":"2026-10-15T00:34:24.897Z","ordinal":2841,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a13cfb-36ce-7122-9610-f91773084724","item":{"type":"CommandExecution","id":"exec-8920ddbe-7abf-4691-b85d-48033b54b4d7","process_id":"67086","command":["/bin/bash","-lc","git status --short; cat src/travel_claim/ordinary.py; sed -n '105,170p' src/travel_claim/workflow.py; sed -n '9,17p' tests/fixtures/POL-2026.2-browser-copy.txt; cat tests/test_ordinary.py"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"git status --short; cat src/travel_claim/ordinary.py; sed -n '105,170p' src/travel_claim/workflow.py; sed -n '9,17p' tests/fixtures/POL-2026.2-browser-copy.txt; cat tests/test_ordinary.py"}],"source":"unified_exec_startup","status":"completed","stdout":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n\"\"\"Connected claim evaluation from retained facts and explicitly sourced rules.\n\nNo native policy definitions are inferred from interview descriptions, caps,\nreview outcomes, or Finance acceptance. Missing authority remains blocked.\n\"\"\"\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal\nimport re\n\nfrom .finance import _cents, reconcile_finance_events\nfrom .workflow import row_values\nfrom .expenses import evaluate_expenses, policy_valid\nfrom .exceptions import travel_findings, review_binds_exception, source_bound\n\nROLE_FIELDS = {\"administration\": \"Administration reviewer\", \"budget_owner\": \"Budget owner\",\n               \"supervisor\": \"Supervisor\", \"director\": \"Director\"}\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef table(parsed, key, tab):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == tab), []))\n\n\ndef expense_lines(record):\n    \"\"\"Read complete rows from the retained PDF layout; never guess a row.\"\"\"\n    lines = []\n    for raw in record.get('text', '').splitlines():\n        if not re.match(r'^\\s*\\d+\\s+', raw):\n            continue\n        tokens = raw.split()\n        if len(tokens) == 6:\n            number, cost, receipt, submitted, amount, currency = tokens\n        else:\n            number = tokens[0]; cost = tokens[1] if len(tokens) > 1 else 'unknown'\n            receipt = submitted = amount = currency = None\n        lines.append(dict(line=int(number), cost_id=cost, receipt_id=receipt,\n            first_submitted_date=submitted, original_amount=amount.replace(',', '') if amount else None,\n            original_cents=_cents(amount.replace(',', '')) if amount else None,\n            currency=currency, source_refs=[ref(record)]))\n    return lines\n\n\ndef connect_claim(*, parsed, claim, decisions, finance_events, finance, cancellations,\n                  arrival_batch, source_observations, prior_finance=None, source_classifications=None, prior_workflow=None):\n    \"\"\"Evaluate an ordinary path; each result keeps its evidence and owner.\"\"\"\n    record = claim['record']; values = fields(record)\n    claim_id, revision = claim['subject_id'], claim['revision']\n    employee, trip_id = values.get('Employee'), claim.get('trip_id')\n    stages = []\n    def stage(name, condition, refs, detail, owner, action, fail=False):\n        row = dict(stage=name, status='PASS' if condition else 'FAIL' if fail else 'BLOCKED',\n                   source_refs=list(dict.fromkeys([ref(record)] + refs)), detail=detail, owner=owner, next_action=action)\n        stages.append(row)\n        return bool(condition)\n    def trusted(row):\n        return bool(row.get('locator')) and any(o.get('source_id') == row.get('source_id') and\n            o.get('sha256') == row.get('source_sha256') and o.get('status') == 'read' and not o.get('missing_scope')\n            for o in source_observations)\n    def visible(row):\n        try:\n            batch = fields(row).get('Arrival batch')\n            return not isinstance(batch, bool) and int(batch) == float(batch) and 0 < int(batch) <= arrival_batch\n        except (ValueError, TypeError, OverflowError):\n            return False\n\n    trips = [r for r in table(parsed, 'trips', 'Trips') if fields(r).get('Trip reference') == trip_id\n             and str(fields(r).get('Trip revision')) in {str(claim.get('trip_revision')), f\"{claim.get('trip_revision')}.0\"}]\n    trip = fields(trips[0]) if len(trips) == 1 else {}\n    linked = stage('claim_trip_link', len(trips) == 1 and trip.get('Employee ID') == employee\n                   and len([r for r in finance['revision_history'] if r['revision'] == revision]) == 1,\n                   [ref(record)] + [ref(r) for r in trips], 'Exact claim, trip revision and employee linkage',\n                   'Travel Administration Lead', 'Verify the exact employee, trip ID and trip revision binding')\n    people = [r for r in table(parsed, 'people', 'People') if fields(r).get('Employee ID') == employee]\n    person = fields(people[0]) if len(people) == 1 else {}\n    lead = person.get('Administration reviewer') or 'Travel Administration Lead'\n    finance_owner = person.get('Finance officer') or 'Finance'\n\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\n    policy_record = rules[0] if len(rules) == 1 else None\n    policy = fields(policy_record) if policy_record else {}\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\n                        and isinstance(policy.get('Eligible categories'), list)\n                        and isinstance(policy.get('Uncapped categories'), list)\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n                        and isinstance(policy.get('Domestic permit required'), bool))\n    policy_refs = [ref(policy_record)] if policy_record else []\n    affected = [c for c in cancellations if claim_id in c['affected_claim_ids']]\n    permission = False\n    permission_refs = [ref(r) for r in trips] + policy_refs\n    if linked and policy_supported:\n        if trip.get('International') is False and policy.get('Domestic permit required') is False:\n            permission = True\n        else:\n            # UTC timing must be expressly supplied; local calendar dates do\n            # not establish an exact commitment instant.\n            permit_roles = policy.get('Required permit roles')\n            commitment = trip.get('First commitment time (UTC)')\n            relevant = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n                        and fields(r).get('Subject reference') == trip.get('Permit reference')\n                        and fields(r).get('Revision') == trip.get('Permit revision')]\n            permission_refs += [ref(r) for r in relevant]\n            try:\n                stamp = lambda text: datetime.fromisoformat(text.replace('Z', '+00:00'))\n                commit = stamp(commitment)\n                permission = bool(trip.get('Permit reference') and permit_roles and set(permit_roles) <= set(ROLE_FIELDS)\n                                  and commit.utcoffset() is not None)\n                for role in permit_roles or []:\n                    matching = [fields(r) for r in relevant if fields(r).get('Review roles') == role]\n                    permission = permission and len(matching) == 1 and matching[0].get('Outcome') == 'approve'\n                    if permission:\n                        permission = (matching[0].get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                      and matching[0].get('Reviewer') != employee\n                                      and stamp(matching[0].get('Decision time (UTC)')).utcoffset() is not None\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n            except (ValueError, TypeError, AttributeError):\n                permission = False\n    stage('travel_permission', permission, permission_refs,\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n\n    lines = expense_lines(record)\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n        eligibility_findings=eligibility, observations=source_observations)\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n        line['evidence_status'] == 'PASS' for line in lines)\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n    stage('supporting_evidence', evidence_ok, evidence_refs,\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n    stage('filing_deadline', filing_ok, evidence_refs,\n          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\n    for line in lines:\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n        if not policy_ok:\n            line['status'] = 'unresolved'\n    allowed = calculation['calculated_cents'] if policy_ok else None\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\n\n    for line in lines:\n        exception = line['exception']\n        if exception['status'] != 'absent':\n            stage(f\"finance_exception:{line['cost_id']}\", exception['status'] == 'valid', line['source_refs'],\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\n        for item in line['eligibility_findings']:\n            name = f\"eligibility:{line['cost_id']}:{item['issue']}\" + (f\":{item['travel_cancellation_id']}\" if item.get('travel_cancellation_id') else '')\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\n\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\n    def changed_exception_amount(line):\n        old = prior_lines.get(line['cost_id'], {})\n        before = old.get('conversion', {}).get('allowed_original_amount')\n        after = line.get('conversion', {}).get('allowed_original_amount')\n        # Unknown-to-known evidence and decimal display precision are not proof\n        # of a material replacement-amount change.\n        return bool(before is not None and after is not None\n            and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\n            and Decimal(before) != Decimal(after))\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n        any(changed_exception_amount(line) for line in lines)\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n    replacement_review = same_revision_change or any(\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n    unique_decisions = {}; decision_conflict = False\n    for decision in current:\n        identity = fields(decision).get('Decision reference')\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n            decision_conflict = True\n        unique_decisions[identity] = (decision, payload)\n    current = [pair[0] for pair in unique_decisions.values()]\n    packets = table(parsed, 'review_packets', 'Review packets')\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n    for decision in current:\n        dv = fields(decision)\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n        pv = fields(ps[0]) if len(ps) == 1 else {}\n        roles = str(dv.get('Review roles') or '').splitlines()\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n                 and pv.get('Trip revision') == claim.get('trip_revision')\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n                 and bool(pv.get('Policy revision')) and bool(str(pv.get('Budget record references') or '').splitlines())\n                 and set(str(pv.get('Budget record references') or '').splitlines()) <= budget_ids\n                 and roles and all(role in ROLE_FIELDS and dv.get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                   and dv.get('Reviewer') != employee for role in roles))\n        if policy_record:\n            valid = valid and pv.get('Policy revision') == policy.get('Policy revision')\n        exception_binding = (not replacement_review or (source_bound(decision, source_observations)\n            and all(source_bound(p, source_observations) for p in ps)\n            and review_binds_exception(decision, record, same_revision_change=same_revision_change, fields=fields, ref=ref)))\n        valid = valid and exception_binding\n        observed.append(dict(exception_binding_valid=exception_binding, decision_id=dv.get('Decision reference'), outcome=dv.get('Outcome'), roles=roles,\n                             evidence_valid=bool(valid), source_refs=[ref(decision)] + [ref(p) for p in ps]))\n        reviews_ok = reviews_ok and valid\n    review_refs = [r for d in observed for r in d['source_refs']] + [ref(p) for p in people]\n    stage('review_evidence', reviews_ok, review_refs, 'Observed current-revision human decisions matched to reviewers and preserved review packets; completeness is checked separately',\n          lead, 'Provide exact-revision decisions and packets matching the employee, trip, expense list, policy and budget references')\n    required = policy.get('Required claim roles', []) if policy_supported else []\n    if policy_supported and policy.get('Director threshold cents') is not None:\n        threshold = policy['Director threshold cents']\n        if isinstance(threshold, int) and not isinstance(threshold, bool) and threshold >= 0 and allowed is not None:\n            required = list(required) + (['director'] if allowed > threshold else [])\n        else:\n            reviews_ok = False\n    approvals = reviews_ok and policy_supported and all(\n        len([d for d in observed if role in d['roles'] and d['outcome'] == 'approve']) == 1\n        and all(d['outcome'] == 'approve' for d in observed if role in d['roles']) for role in required)\n    stage('required_approvals', approvals, review_refs + policy_refs,\n          'All policy-required roles must have matching current-revision approvals; no decisions are created',\n          lead, 'Confirm policy-required review roles and obtain their current-revision human approvals')\n\n    exception_revalidated = not replacement_review or approvals\n    stage('exception_revalidation', exception_revalidated, evidence_refs + review_refs,\n          'Replacement amounts require current claim reviews bound to the replacement source version; earlier reviews remain historical',\n          lead, 'Obtain current revision/source-bound reviews of the Finance replacement amount and a matching reimbursement authorization')\n\n    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\n                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n    request = fields(requests[0]) if len(requests) == 1 else {}\n    obligation = finance.get('recorded_obligation')\n    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid']}\n    request_ok = bool(linked and reimbursement_permission and policy_ok and approvals and obligation and len(requests) == 1\n                      and request.get('Request reference') == obligation['request_id']\n                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\n                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['amount_cents']\n                      and obligation['claim_revision'] == revision and obligation['finance_officer'] == finance_owner\n                      and set(str(request.get('Decision references') or '').splitlines()) == approved_ids\n                      and bool(approved_ids))\n    request_refs = [ref(r) for r in requests] + (obligation['source_refs'] if obligation else [])\n    stage('request_obligation', request_ok, request_refs,\n          'Recorded request/obligation linkage requires explicit claim revision, payee, amount and approval references; ledger arrival context is not authorization',\n          finance_owner, 'Provide the exact-revision reimbursement request and Finance acceptance linked to its approvals and authorized amount')\n    if request_ok:\n        authorization = dict(amount_cents=allowed, claim_revision=revision, source_refs=request_refs + review_refs + policy_refs)\n        finance = reconcile_finance_events(finance_events, claim_id=claim_id, current_revision=revision,\n            revision_history=finance['revision_history'], previous_reconciliation=prior_finance,\n            authorized_obligation=authorization, source_classifications=source_classifications, event_context=finance.get(\"event_context\"))\n    reconciled = finance.get('recorded_ledger_balance_cents') is not None and not finance['unresolved_event_ids'] and not finance['conflicting_events']\n    stage('financial_reconciliation', reconciled,\n          [ref(e) for e in finance_events if fields(e).get('Claim reference') == claim_id],\n          f\"Confirmed net cash {finance['net_confirmed_cents']} cents; recorded ledger difference {finance.get('recorded_ledger_balance_cents')}; authorized balance {finance['balance_cents']}\",\n          finance_owner, 'Resolve missing obligations, conflicting or unclassified events, request/payee links and outstanding balances')\n\n    authorities = [r for r in table(parsed, 'closure_authorities', 'Closure authorities') if trusted(r) and visible(r)\n                   and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n    clock_ok = False\n    try:\n        clock_ok = datetime.fromisoformat(parsed['case_clock'].replace('Z', '+00:00')).utcoffset() is not None\n    except (KeyError, ValueError, TypeError, AttributeError):\n        pass\n    closure_authority = (len(authorities) == 1 and fields(authorities[0]).get('Confirmation') == 'financial-completion-conditions'\n                         and bool(fields(authorities[0]).get('Authority')) and fields(authorities[0]).get('Case clock') == parsed.get('case_clock'))\n    external = [i for i in parsed.get('unresolved_issues', []) if i.get('status', 'open') == 'open'\n                and (i.get('subject_type') in {'policy', 'scenario'} or i.get('subject_id') in {claim_id, trip_id, trip.get('Permit reference')})]\n    control_events = [e for e in finance['event_history'] if e['classification'] in {\n        'failed_transfer', 'retry_authorization', 'finance_cancellation_requested', 'finance_cancelled'}]\n    resolved_controls = set()\n    def event_stamp(event):\n        stamp = datetime.fromisoformat(event['source_record']['Activity time (UTC)'].replace('Z', '+00:00'))\n        return stamp.replace(tzinfo=timezone.utc) if stamp.utcoffset() is None else stamp\n    for event in finance['event_history']:\n        value = event['source_record']\n        if (event['classification'] == 'finance_resolution' and value.get('Claim revision') == revision\n                and obligation and value.get('Request reference') == obligation['request_id']\n                and value.get('Finance officer') == finance_owner):\n            named = set(str(value.get('Resolved activity references') or '').splitlines())\n            for control in control_events:\n                try:\n                    if (control['event_id'] in named\n                            and control['source_record'].get('Request reference') == value['Request reference']\n                            and event_stamp(event) >= event_stamp(control)):\n                        resolved_controls.add(control['event_id'])\n                except (KeyError, ValueError, TypeError, AttributeError):\n                    pass\n    controls_clear = not finance['pending_transfer_event_ids'] and all(e['event_id'] in resolved_controls for e in control_events)\n    cancellation_refs = [source for c in affected for source in c.get(\"source_refs\", [])]\n    stage('cancellation_readiness', not affected, cancellation_refs,\n          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\n          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\n    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\n              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\n    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\n          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\n          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\n    pending = next((s for s in stages if s['status'] != 'PASS'), None)\n    return dict(claim_id=claim_id, revision=revision, trip_id=trip_id, trip_revision=claim.get('trip_revision'),\n                mode=parsed.get('evidence_mode', 'offline-replay'), status=('closed-reimbursed' if allowed else 'closed-no-payment') if closed else 'pending',\n                expense_calculation=calculation, exception_revalidation=dict(required=replacement_review, same_revision_change=same_revision_change, status='PASS' if exception_revalidated else 'BLOCKED'), allowed_cents=allowed, balance_cents=finance['balance_cents'], lines=lines, stages=stages,\n                observed_reviews=observed, request=deepcopy(requests[0]) if request_ok else None,\n                source_refs=list(dict.fromkeys([ref(record)] + [r for s in stages for r in s['source_refs']])),\n                next_owner=None if closed else pending['owner'], reason='Supported financial closure' if closed else pending['detail'],\n                finance=finance)\n\n\ndef ordinary_demo(workflows):\n    \"\"\"Render one observed claim with every stage, owner and retained reference.\"\"\"\n    claim_id = \"C01\" if \"C01\" in workflows else next(iter(sorted(workflows)), None)\n    lines = [\"# Connected ordinary claim workflow — OFFLINE REPLAY\", \"\",\n             \"Retained-input evaluation; no fresh reads, requests, approvals or payments were generated.\", \"\"]\n    if not claim_id:\n        return \"\\n\".join(lines + [\"No retained claim available for demonstration.\", \"\"])\n    workflow = workflows[claim_id]\n    lines += [f\"Claim `{claim_id}` revision {workflow['revision']}; trip `{workflow['trip_id']}` revision {workflow['trip_revision']}; status **{workflow['status']}**.\", \"\"]\n    for stage in workflow['stages']:\n        lines += [f\"## {stage['stage']} — {stage['status']}\", \"\", stage['detail'], \"\",\n                  f\"Owner: {stage['owner']}. Next action: {stage['next_action']}\", \"\"]\n        lines.extend(f\"- `{reference}`\" for reference in stage['source_refs'])\n        lines.append(\"\")\n    return \"\\n\".join(lines) + \"\\n\"\n    result[\"issues\"] = {\"malformed_revision_records\": malformed, \"repeated_subject_revisions\": conflicts}\n    return result\n\n\ndef match_decisions_to_subjects(decisions: list[dict[str, Any]], history: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Match review ledger identities and revisions without applying outcomes.\"\"\"\n    matches = []\n    for record in decisions:\n        values = row_values(record)\n        decision_id = values.get(\"Decision reference\")\n        kind = values.get(\"Subject type\")\n        subject_id = values.get(\"Subject reference\")\n        revision = _revision(values.get(\"Revision\"))\n        target_kind = str(kind) if kind in {\"claim\", \"trip\", \"permit\"} else None\n        target = history.get(target_kind, {}).get(str(subject_id)) if target_kind and subject_id else None\n        if target is None:\n            result = \"unsupported_subject_type\" if target_kind is None else \"subject_not_found\"\n            source_refs = []\n        elif revision is None:\n            result = \"invalid_revision\"\n            source_refs = []\n        else:\n            occurrences = [item for item in target[\"revisions\"] if item[\"revision\"] == revision]\n            if not occurrences:\n                result = \"revision_not_found\"\n                source_refs = []\n            else:\n                result = \"revision_match_current\" if revision == target[\"current_revision\"] else \"revision_match_historical\"\n                source_refs = [item[\"source_ref\"] for item in occurrences]\n        matches.append({\n            \"decision_id\": decision_id,\n            \"subject_type\": kind,\n            \"subject_id\": subject_id,\n            \"revision\": revision,\n            \"observed_outcome\": values.get(\"Outcome\"),\n            \"structural_match\": result,\n            \"matched_source_refs\": source_refs,\n            \"decision_source_ref\": _source_ref(record),\n            \"applied\": False,\n        })\n    return matches\n\n\ndef _business_payload(record: dict[str, Any], id_field: str, ignore_fields: set[str]) -> dict[str, Any]:\n    values = row_values(record)\n    return {key: values[key] for key in sorted(values) if key != id_field and key not in ignore_fields}\n\n\ndef deduplicate_activity_records(\n    records: list[dict[str, Any]], *, id_field: str, ignore_fields: tuple[str, ...] = (\"Arrival batch\",)\n) -> dict[str, Any]:\n    \"\"\"Deduplicate immutable event IDs, ignoring only declared delivery fields.\n\n    All source occurrences remain cited. A differing business payload for an\n    existing ID is reported as a conflict and never replaces the first event.\n    \"\"\"\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id = []\n    for record in records:\n        event_id = row_values(record).get(id_field)\n        if not isinstance(event_id, str) or not event_id:\n            missing_id.append({\"source_ref\": _source_ref(record), \"reason\": f\"missing {id_field}\"})\n        else:\n            by_id[event_id].append(record)\n    admitted, duplicates, conflicts = [], [], []\n    for event_id, occurrences in by_id.items():\nDomestic trips do not need a permit. An international trip needs its own approved permit before the first arrangement/payment commitment. Permit administration, budget owner and supervisor review the trip estimate. Claim administration, budget owner and supervisor separately review actual reimbursement. A director additionally reviews amounts strictly above EUR 1,000.00 (reviewed estimate for permit, reviewed entitlement for claim). Exactly EUR 1,000.00 does not require a director. When budget owner and supervisor are the same stable person, one response with both roles satisfies those two positions for that subject/version. Administration and director never collapse into another role. A permit response never approves a claim. A late permit does not retroactively authorize travel arrangements; Finance may explicitly resolve reimbursement eligibility while the permit exception remains recorded.\n\nCosts may be claimed as soon as the employee has paid, including before travel. The latest ordinary filing date is two calendar months after trip end, inclusive, with a nonexistent day clamped to month end. For a trip ending 31 August, the deadline is 31 October. Earlier filing is allowed after payment. A later filing requires a Finance exception or remains held. The claim's submission date, not import time, is used. Corrections retain the initial submission date for unchanged costs; newly added costs use their own first submission date.\n\nAdministration checks identity, receipt/paid proof, trip/permit, category, deadline, rates/caps, prior cost obligations and calculated amount. Budget review receives the whole department/project/period ledger: allocation less net settled expenditure less remaining commitments. A commitment includes its settled portion; do not subtract the full commitment and its settled portion again. Include prior obligations outside the current batch and all accepted new requests. Adequate funds alone are not a budget approval. Supervisor considers business purpose, client commitment, schedule coverage and permit consistency. Director considers high spend, the documented exception, alternatives and budget-owner position. Reviewers may approve, return with a concrete repair request, or reject with a reason; their discretionary judgment is supplied by the scenario, not performed by the learner.\n\nRequests and replies identify subject type, subject ID/revision, role(s), stable actor, relevant source versions and reason. Consume only the trainer-supplied decision batches and the directory's applicable actor/roles. Missing responses for otherwise complete requests wait; missing policy/input definitions are package defects. Reject wrong-role, stale-version or wrong-subject replies for current authorization. Keep rejected imports visible. A return reopens the appropriate review; explicit rejection or clean withdrawal can close with a non-payment reason.\n\nA material change to employee, trip, dates, money, policy/evidence or authority invalidates dependent review, approvals and payment readiness even if the total is unchanged. Full recheck and justified dependency recheck are both valid. Preserve old versions and decisions as history. Before dispatch, rebuild readiness from current facts. After dispatch, hold replacement requests until Finance confirms cancellation/status. Pending cancellation is not confirmed cancellation. Withdrawal never erases an actual payment.\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-SYNTHETIC-ONLY'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-SYNTHETIC-ONLY',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('travel_permission', 'policy_eligibility', 'required_approvals', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'PASS'\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n","stderr":"","aggregated_output":"?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n\"\"\"Connected claim evaluation from retained facts and explicitly sourced rules.\n\nNo native policy definitions are inferred from interview descriptions, caps,\nreview outcomes, or Finance acceptance. Missing authority remains blocked.\n\"\"\"\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal\nimport re\n\nfrom .finance import _cents, reconcile_finance_events\nfrom .workflow import row_values\nfrom .expenses import evaluate_expenses, policy_valid\nfrom .exceptions import travel_findings, review_binds_exception, source_bound\n\nROLE_FIELDS = {\"administration\": \"Administration reviewer\", \"budget_owner\": \"Budget owner\",\n               \"supervisor\": \"Supervisor\", \"director\": \"Director\"}\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef table(parsed, key, tab):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == tab), []))\n\n\ndef expense_lines(record):\n    \"\"\"Read complete rows from the retained PDF layout; never guess a row.\"\"\"\n    lines = []\n    for raw in record.get('text', '').splitlines():\n        if not re.match(r'^\\s*\\d+\\s+', raw):\n            continue\n        tokens = raw.split()\n        if len(tokens) == 6:\n            number, cost, receipt, submitted, amount, currency = tokens\n        else:\n            number = tokens[0]; cost = tokens[1] if len(tokens) > 1 else 'unknown'\n            receipt = submitted = amount = currency = None\n        lines.append(dict(line=int(number), cost_id=cost, receipt_id=receipt,\n            first_submitted_date=submitted, original_amount=amount.replace(',', '') if amount else None,\n            original_cents=_cents(amount.replace(',', '')) if amount else None,\n            currency=currency, source_refs=[ref(record)]))\n    return lines\n\n\ndef connect_claim(*, parsed, claim, decisions, finance_events, finance, cancellations,\n                  arrival_batch, source_observations, prior_finance=None, source_classifications=None, prior_workflow=None):\n    \"\"\"Evaluate an ordinary path; each result keeps its evidence and owner.\"\"\"\n    record = claim['record']; values = fields(record)\n    claim_id, revision = claim['subject_id'], claim['revision']\n    employee, trip_id = values.get('Employee'), claim.get('trip_id')\n    stages = []\n    def stage(name, condition, refs, detail, owner, action, fail=False):\n        row = dict(stage=name, status='PASS' if condition else 'FAIL' if fail else 'BLOCKED',\n                   source_refs=list(dict.fromkeys([ref(record)] + refs)), detail=detail, owner=owner, next_action=action)\n        stages.append(row)\n        return bool(condition)\n    def trusted(row):\n        return bool(row.get('locator')) and any(o.get('source_id') == row.get('source_id') and\n            o.get('sha256') == row.get('source_sha256') and o.get('status') == 'read' and not o.get('missing_scope')\n            for o in source_observations)\n    def visible(row):\n        try:\n            batch = fields(row).get('Arrival batch')\n            return not isinstance(batch, bool) and int(batch) == float(batch) and 0 < int(batch) <= arrival_batch\n        except (ValueError, TypeError, OverflowError):\n            return False\n\n    trips = [r for r in table(parsed, 'trips', 'Trips') if fields(r).get('Trip reference') == trip_id\n             and str(fields(r).get('Trip revision')) in {str(claim.get('trip_revision')), f\"{claim.get('trip_revision')}.0\"}]\n    trip = fields(trips[0]) if len(trips) == 1 else {}\n    linked = stage('claim_trip_link', len(trips) == 1 and trip.get('Employee ID') == employee\n                   and len([r for r in finance['revision_history'] if r['revision'] == revision]) == 1,\n                   [ref(record)] + [ref(r) for r in trips], 'Exact claim, trip revision and employee linkage',\n                   'Travel Administration Lead', 'Verify the exact employee, trip ID and trip revision binding')\n    people = [r for r in table(parsed, 'people', 'People') if fields(r).get('Employee ID') == employee]\n    person = fields(people[0]) if len(people) == 1 else {}\n    lead = person.get('Administration reviewer') or 'Travel Administration Lead'\n    finance_owner = person.get('Finance officer') or 'Finance'\n\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\n    policy_record = rules[0] if len(rules) == 1 else None\n    policy = fields(policy_record) if policy_record else {}\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\n                        and isinstance(policy.get('Eligible categories'), list)\n                        and isinstance(policy.get('Uncapped categories'), list)\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n                        and isinstance(policy.get('Domestic permit required'), bool))\n    policy_refs = [ref(policy_record)] if policy_record else []\n    affected = [c for c in cancellations if claim_id in c['affected_claim_ids']]\n    permission = False\n    permission_refs = [ref(r) for r in trips] + policy_refs\n    if linked and policy_supported:\n        if trip.get('International') is False and policy.get('Domestic permit required') is False:\n            permission = True\n        else:\n            # UTC timing must be expressly supplied; local calendar dates do\n            # not establish an exact commitment instant.\n            permit_roles = policy.get('Required permit roles')\n            commitment = trip.get('First commitment time (UTC)')\n            relevant = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n                        and fields(r).get('Subject reference') == trip.get('Permit reference')\n                        and fields(r).get('Revision') == trip.get('Permit revision')]\n            permission_refs += [ref(r) for r in relevant]\n            try:\n                stamp = lambda text: datetime.fromisoformat(text.replace('Z', '+00:00'))\n                commit = stamp(commitment)\n                permission = bool(trip.get('Permit reference') and permit_roles and set(permit_roles) <= set(ROLE_FIELDS)\n                                  and commit.utcoffset() is not None)\n                for role in permit_roles or []:\n                    matching = [fields(r) for r in relevant if fields(r).get('Review roles') == role]\n                    permission = permission and len(matching) == 1 and matching[0].get('Outcome') == 'approve'\n                    if permission:\n                        permission = (matching[0].get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                      and matching[0].get('Reviewer') != employee\n                                      and stamp(matching[0].get('Decision time (UTC)')).utcoffset() is not None\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n            except (ValueError, TypeError, AttributeError):\n                permission = False\n    stage('travel_permission', permission, permission_refs,\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n\n    lines = expense_lines(record)\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n        eligibility_findings=eligibility, observations=source_observations)\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n        line['evidence_status'] == 'PASS' for line in lines)\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n    stage('supporting_evidence', evidence_ok, evidence_refs,\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n    stage('filing_deadline', filing_ok, evidence_refs,\n          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\n    for line in lines:\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n        if not policy_ok:\n            line['status'] = 'unresolved'\n    allowed = calculation['calculated_cents'] if policy_ok else None\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\n\n    for line in lines:\n        exception = line['exception']\n        if exception['status'] != 'absent':\n            stage(f\"finance_exception:{line['cost_id']}\", exception['status'] == 'valid', line['source_refs'],\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\n        for item in line['eligibility_findings']:\n            name = f\"eligibility:{line['cost_id']}:{item['issue']}\" + (f\":{item['travel_cancellation_id']}\" if item.get('travel_cancellation_id') else '')\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\n\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\n    def changed_exception_amount(line):\n        old = prior_lines.get(line['cost_id'], {})\n        before = old.get('conversion', {}).get('allowed_original_amount')\n        after = line.get('conversion', {}).get('allowed_original_amount')\n        # Unknown-to-known evidence and decimal display precision are not proof\n        # of a material replacement-amount change.\n        return bool(before is not None and after is not None\n            and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\n            and Decimal(before) != Decimal(after))\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n        any(changed_exception_amount(line) for line in lines)\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n    replacement_review = same_revision_change or any(\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n    unique_decisions = {}; decision_conflict = False\n    for decision in current:\n        identity = fields(decision).get('Decision reference')\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n            decision_conflict = True\n        unique_decisions[identity] = (decision, payload)\n    current = [pair[0] for pair in unique_decisions.values()]\n    packets = table(parsed, 'review_packets', 'Review packets')\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n    for decision in current:\n        dv = fields(decision)\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n        pv = fields(ps[0]) if len(ps) == 1 else {}\n        roles = str(dv.get('Review roles') or '').splitlines()\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n                 and pv.get('Trip revision') == claim.get('trip_revision')\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n                 and bool(pv.get('Policy revision')) and bool(str(pv.get('Budget record references') or '').splitlines())\n                 and set(str(pv.get('Budget record references') or '').splitlines()) <= budget_ids\n                 and roles and all(role in ROLE_FIELDS and dv.get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                   and dv.get('Reviewer') != employee for role in roles))\n        if policy_record:\n            valid = valid and pv.get('Policy revision') == policy.get('Policy revision')\n        exception_binding = (not replacement_review or (source_bound(decision, source_observations)\n            and all(source_bound(p, source_observations) for p in ps)\n            and review_binds_exception(decision, record, same_revision_change=same_revision_change, fields=fields, ref=ref)))\n        valid = valid and exception_binding\n        observed.append(dict(exception_binding_valid=exception_binding, decision_id=dv.get('Decision reference'), outcome=dv.get('Outcome'), roles=roles,\n                             evidence_valid=bool(valid), source_refs=[ref(decision)] + [ref(p) for p in ps]))\n        reviews_ok = reviews_ok and valid\n    review_refs = [r for d in observed for r in d['source_refs']] + [ref(p) for p in people]\n    stage('review_evidence', reviews_ok, review_refs, 'Observed current-revision human decisions matched to reviewers and preserved review packets; completeness is checked separately',\n          lead, 'Provide exact-revision decisions and packets matching the employee, trip, expense list, policy and budget references')\n    required = policy.get('Required claim roles', []) if policy_supported else []\n    if policy_supported and policy.get('Director threshold cents') is not None:\n        threshold = policy['Director threshold cents']\n        if isinstance(threshold, int) and not isinstance(threshold, bool) and threshold >= 0 and allowed is not None:\n            required = list(required) + (['director'] if allowed > threshold else [])\n        else:\n            reviews_ok = False\n    approvals = reviews_ok and policy_supported and all(\n        len([d for d in observed if role in d['roles'] and d['outcome'] == 'approve']) == 1\n        and all(d['outcome'] == 'approve' for d in observed if role in d['roles']) for role in required)\n    stage('required_approvals', approvals, review_refs + policy_refs,\n          'All policy-required roles must have matching current-revision approvals; no decisions are created',\n          lead, 'Confirm policy-required review roles and obtain their current-revision human approvals')\n\n    exception_revalidated = not replacement_review or approvals\n    stage('exception_revalidation', exception_revalidated, evidence_refs + review_refs,\n          'Replacement amounts require current claim reviews bound to the replacement source version; earlier reviews remain historical',\n          lead, 'Obtain current revision/source-bound reviews of the Finance replacement amount and a matching reimbursement authorization')\n\n    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\n                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n    request = fields(requests[0]) if len(requests) == 1 else {}\n    obligation = finance.get('recorded_obligation')\n    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid']}\n    request_ok = bool(linked and reimbursement_permission and policy_ok and approvals and obligation and len(requests) == 1\n                      and request.get('Request reference') == obligation['request_id']\n                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\n                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['amount_cents']\n                      and obligation['claim_revision'] == revision and obligation['finance_officer'] == finance_owner\n                      and set(str(request.get('Decision references') or '').splitlines()) == approved_ids\n                      and bool(approved_ids))\n    request_refs = [ref(r) for r in requests] + (obligation['source_refs'] if obligation else [])\n    stage('request_obligation', request_ok, request_refs,\n          'Recorded request/obligation linkage requires explicit claim revision, payee, amount and approval references; ledger arrival context is not authorization',\n          finance_owner, 'Provide the exact-revision reimbursement request and Finance acceptance linked to its approvals and authorized amount')\n    if request_ok:\n        authorization = dict(amount_cents=allowed, claim_revision=revision, source_refs=request_refs + review_refs + policy_refs)\n        finance = reconcile_finance_events(finance_events, claim_id=claim_id, current_revision=revision,\n            revision_history=finance['revision_history'], previous_reconciliation=prior_finance,\n            authorized_obligation=authorization, source_classifications=source_classifications, event_context=finance.get(\"event_context\"))\n    reconciled = finance.get('recorded_ledger_balance_cents') is not None and not finance['unresolved_event_ids'] and not finance['conflicting_events']\n    stage('financial_reconciliation', reconciled,\n          [ref(e) for e in finance_events if fields(e).get('Claim reference') == claim_id],\n          f\"Confirmed net cash {finance['net_confirmed_cents']} cents; recorded ledger difference {finance.get('recorded_ledger_balance_cents')}; authorized balance {finance['balance_cents']}\",\n          finance_owner, 'Resolve missing obligations, conflicting or unclassified events, request/payee links and outstanding balances')\n\n    authorities = [r for r in table(parsed, 'closure_authorities', 'Closure authorities') if trusted(r) and visible(r)\n                   and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n    clock_ok = False\n    try:\n        clock_ok = datetime.fromisoformat(parsed['case_clock'].replace('Z', '+00:00')).utcoffset() is not None\n    except (KeyError, ValueError, TypeError, AttributeError):\n        pass\n    closure_authority = (len(authorities) == 1 and fields(authorities[0]).get('Confirmation') == 'financial-completion-conditions'\n                         and bool(fields(authorities[0]).get('Authority')) and fields(authorities[0]).get('Case clock') == parsed.get('case_clock'))\n    external = [i for i in parsed.get('unresolved_issues', []) if i.get('status', 'open') == 'open'\n                and (i.get('subject_type') in {'policy', 'scenario'} or i.get('subject_id') in {claim_id, trip_id, trip.get('Permit reference')})]\n    control_events = [e for e in finance['event_history'] if e['classification'] in {\n        'failed_transfer', 'retry_authorization', 'finance_cancellation_requested', 'finance_cancelled'}]\n    resolved_controls = set()\n    def event_stamp(event):\n        stamp = datetime.fromisoformat(event['source_record']['Activity time (UTC)'].replace('Z', '+00:00'))\n        return stamp.replace(tzinfo=timezone.utc) if stamp.utcoffset() is None else stamp\n    for event in finance['event_history']:\n        value = event['source_record']\n        if (event['classification'] == 'finance_resolution' and value.get('Claim revision') == revision\n                and obligation and value.get('Request reference') == obligation['request_id']\n                and value.get('Finance officer') == finance_owner):\n            named = set(str(value.get('Resolved activity references') or '').splitlines())\n            for control in control_events:\n                try:\n                    if (control['event_id'] in named\n                            and control['source_record'].get('Request reference') == value['Request reference']\n                            and event_stamp(event) >= event_stamp(control)):\n                        resolved_controls.add(control['event_id'])\n                except (KeyError, ValueError, TypeError, AttributeError):\n                    pass\n    controls_clear = not finance['pending_transfer_event_ids'] and all(e['event_id'] in resolved_controls for e in control_events)\n    cancellation_refs = [source for c in affected for source in c.get(\"source_refs\", [])]\n    stage('cancellation_readiness', not affected, cancellation_refs,\n          'Linked current or historical trip/permit cancellation requires specific Finance disposition and resolution; prior permission and money history are preserved' if affected else 'No linked cancellation dependency',\n          finance_owner, 'Verify cancellation-bound disposition, current request authority and monetary resolution before releasing payment readiness')\n    closed = (all(s['status'] == 'PASS' for s in stages) and controls_clear and request_ok and finance['balance_cents'] == 0\n              and not finance['repair_issues'] and not affected and clock_ok and closure_authority and not external)\n    stage('financial_closure', closed, [ref(r) for r in authorities] + request_refs + policy_refs,\n          'Closure requires supported completion conditions, authoritative clock, current evidence/approvals, entitlement/obligation/net cash agreement and no affected unresolved issue',\n          finance_owner, 'Confirm completion conditions and the authoritative clock; resolve every affected approval, Finance or cancellation dependency')\n    pending = next((s for s in stages if s['status'] != 'PASS'), None)\n    return dict(claim_id=claim_id, revision=revision, trip_id=trip_id, trip_revision=claim.get('trip_revision'),\n                mode=parsed.get('evidence_mode', 'offline-replay'), status=('closed-reimbursed' if allowed else 'closed-no-payment') if closed else 'pending',\n                expense_calculation=calculation, exception_revalidation=dict(required=replacement_review, same_revision_change=same_revision_change, status='PASS' if exception_revalidated else 'BLOCKED'), allowed_cents=allowed, balance_cents=finance['balance_cents'], lines=lines, stages=stages,\n                observed_reviews=observed, request=deepcopy(requests[0]) if request_ok else None,\n                source_refs=list(dict.fromkeys([ref(record)] + [r for s in stages for r in s['source_refs']])),\n                next_owner=None if closed else pending['owner'], reason='Supported financial closure' if closed else pending['detail'],\n                finance=finance)\n\n\ndef ordinary_demo(workflows):\n    \"\"\"Render one observed claim with every stage, owner and retained reference.\"\"\"\n    claim_id = \"C01\" if \"C01\" in workflows else next(iter(sorted(workflows)), None)\n    lines = [\"# Connected ordinary claim workflow — OFFLINE REPLAY\", \"\",\n             \"Retained-input evaluation; no fresh reads, requests, approvals or payments were generated.\", \"\"]\n    if not claim_id:\n        return \"\\n\".join(lines + [\"No retained claim available for demonstration.\", \"\"])\n    workflow = workflows[claim_id]\n    lines += [f\"Claim `{claim_id}` revision {workflow['revision']}; trip `{workflow['trip_id']}` revision {workflow['trip_revision']}; status **{workflow['status']}**.\", \"\"]\n    for stage in workflow['stages']:\n        lines += [f\"## {stage['stage']} — {stage['status']}\", \"\", stage['detail'], \"\",\n                  f\"Owner: {stage['owner']}. Next action: {stage['next_action']}\", \"\"]\n        lines.extend(f\"- `{reference}`\" for reference in stage['source_refs'])\n        lines.append(\"\")\n    return \"\\n\".join(lines) + \"\\n\"\n    result[\"issues\"] = {\"malformed_revision_records\": malformed, \"repeated_subject_revisions\": conflicts}\n    return result\n\n\ndef match_decisions_to_subjects(decisions: list[dict[str, Any]], history: dict[str, Any]) -> list[dict[str, Any]]:\n    \"\"\"Match review ledger identities and revisions without applying outcomes.\"\"\"\n    matches = []\n    for record in decisions:\n        values = row_values(record)\n        decision_id = values.get(\"Decision reference\")\n        kind = values.get(\"Subject type\")\n        subject_id = values.get(\"Subject reference\")\n        revision = _revision(values.get(\"Revision\"))\n        target_kind = str(kind) if kind in {\"claim\", \"trip\", \"permit\"} else None\n        target = history.get(target_kind, {}).get(str(subject_id)) if target_kind and subject_id else None\n        if target is None:\n            result = \"unsupported_subject_type\" if target_kind is None else \"subject_not_found\"\n            source_refs = []\n        elif revision is None:\n            result = \"invalid_revision\"\n            source_refs = []\n        else:\n            occurrences = [item for item in target[\"revisions\"] if item[\"revision\"] == revision]\n            if not occurrences:\n                result = \"revision_not_found\"\n                source_refs = []\n            else:\n                result = \"revision_match_current\" if revision == target[\"current_revision\"] else \"revision_match_historical\"\n                source_refs = [item[\"source_ref\"] for item in occurrences]\n        matches.append({\n            \"decision_id\": decision_id,\n            \"subject_type\": kind,\n            \"subject_id\": subject_id,\n            \"revision\": revision,\n            \"observed_outcome\": values.get(\"Outcome\"),\n            \"structural_match\": result,\n            \"matched_source_refs\": source_refs,\n            \"decision_source_ref\": _source_ref(record),\n            \"applied\": False,\n        })\n    return matches\n\n\ndef _business_payload(record: dict[str, Any], id_field: str, ignore_fields: set[str]) -> dict[str, Any]:\n    values = row_values(record)\n    return {key: values[key] for key in sorted(values) if key != id_field and key not in ignore_fields}\n\n\ndef deduplicate_activity_records(\n    records: list[dict[str, Any]], *, id_field: str, ignore_fields: tuple[str, ...] = (\"Arrival batch\",)\n) -> dict[str, Any]:\n    \"\"\"Deduplicate immutable event IDs, ignoring only declared delivery fields.\n\n    All source occurrences remain cited. A differing business payload for an\n    existing ID is reported as a conflict and never replaces the first event.\n    \"\"\"\n    by_id: dict[str, list[dict[str, Any]]] = defaultdict(list)\n    missing_id = []\n    for record in records:\n        event_id = row_values(record).get(id_field)\n        if not isinstance(event_id, str) or not event_id:\n            missing_id.append({\"source_ref\": _source_ref(record), \"reason\": f\"missing {id_field}\"})\n        else:\n            by_id[event_id].append(record)\n    admitted, duplicates, conflicts = [], [], []\n    for event_id, occurrences in by_id.items():\nDomestic trips do not need a permit. An international trip needs its own approved permit before the first arrangement/payment commitment. Permit administration, budget owner and supervisor review the trip estimate. Claim administration, budget owner and supervisor separately review actual reimbursement. A director additionally reviews amounts strictly above EUR 1,000.00 (reviewed estimate for permit, reviewed entitlement for claim). Exactly EUR 1,000.00 does not require a director. When budget owner and supervisor are the same stable person, one response with both roles satisfies those two positions for that subject/version. Administration and director never collapse into another role. A permit response never approves a claim. A late permit does not retroactively authorize travel arrangements; Finance may explicitly resolve reimbursement eligibility while the permit exception remains recorded.\n\nCosts may be claimed as soon as the employee has paid, including before travel. The latest ordinary filing date is two calendar months after trip end, inclusive, with a nonexistent day clamped to month end. For a trip ending 31 August, the deadline is 31 October. Earlier filing is allowed after payment. A later filing requires a Finance exception or remains held. The claim's submission date, not import time, is used. Corrections retain the initial submission date for unchanged costs; newly added costs use their own first submission date.\n\nAdministration checks identity, receipt/paid proof, trip/permit, category, deadline, rates/caps, prior cost obligations and calculated amount. Budget review receives the whole department/project/period ledger: allocation less net settled expenditure less remaining commitments. A commitment includes its settled portion; do not subtract the full commitment and its settled portion again. Include prior obligations outside the current batch and all accepted new requests. Adequate funds alone are not a budget approval. Supervisor considers business purpose, client commitment, schedule coverage and permit consistency. Director considers high spend, the documented exception, alternatives and budget-owner position. Reviewers may approve, return with a concrete repair request, or reject with a reason; their discretionary judgment is supplied by the scenario, not performed by the learner.\n\nRequests and replies identify subject type, subject ID/revision, role(s), stable actor, relevant source versions and reason. Consume only the trainer-supplied decision batches and the directory's applicable actor/roles. Missing responses for otherwise complete requests wait; missing policy/input definitions are package defects. Reject wrong-role, stale-version or wrong-subject replies for current authorization. Keep rejected imports visible. A return reopens the appropriate review; explicit rejection or clean withdrawal can close with a non-payment reason.\n\nA material change to employee, trip, dates, money, policy/evidence or authority invalidates dependent review, approvals and payment readiness even if the total is unchanged. Full recheck and justified dependency recheck are both valid. Preserve old versions and decisions as history. Before dispatch, rebuild readiness from current facts. After dispatch, hold replacement requests until Finance confirms cancellation/status. Pending cancellation is not confirmed cancellation. Withdrawal never erases an actual payment.\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-SYNTHETIC-ONLY'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-SYNTHETIC-ONLY',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('travel_permission', 'policy_eligibility', 'required_approvals', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'PASS'\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n","exit_code":0,"duration":{"secs":0,"nanos":145749780},"formatted_output":"Warning: truncated output (original token count: 12850)\nTotal output lines: 741\n\n?? artifacts/runs/\n?? artifacts/verification/project-d-evidence-audit-f98e044.md\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.json\n?? artifacts/verification/project-d-live-source-audit-87dbd1c.md\n?? artifacts/verification/project-d-readiness-efc7e91-validated/\n?? artifacts/verification/project-d-readiness-efc7e91/\n?? artifacts/verification/project-d-step157-revalidation/\n?? artifacts/verification/project-d-step167-audit-probes.json\n?? artifacts/verification/project-d-step167-policy-gap-audit.md\n?? user-provided-sources/\n\"\"\"Connected claim evaluation from retained facts and explicitly sourced rules.\n\nNo native policy definitions are inferred from interview descriptions, caps,\nreview outcomes, or Finance acceptance. Missing authority remains blocked.\n\"\"\"\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nfrom datetime import datetime, timezone\nfrom decimal import Decimal\nimport re\n\nfrom .finance import _cents, reconcile_finance_events\nfrom .workflow import row_values\nfrom .expenses import evaluate_expenses, policy_valid\nfrom .exceptions import travel_findings, review_binds_exception, source_bound\n\nROLE_FIELDS = {\"administration\": \"Administration reviewer\", \"budget_owner\": \"Budget owner\",\n               \"supervisor\": \"Supervisor\", \"director\": \"Director\"}\n\n\ndef ref(row):\n    return f\"{row.get('source_id')}@{row.get('source_sha256')}#{row.get('locator')}\"\n\n\ndef fields(row):\n    return {f['label'].strip(): f['value'] for f in row.get('fields', [])} if 'fields' in row else row_values(row)\n\n\ndef table(parsed, key, tab):\n    return parsed.get('records', {}).get(key, next((s['records'] for s in parsed.get('workbook_sheets', []) if s['name'] == tab), []))\n\n\ndef expense_lines(record):\n    \"\"\"Read complete rows from the retained PDF layout; never guess a row.\"\"\"\n    lines = []\n    for raw in record.get('text', '').splitlines():\n        if not re.match(r'^\\s*\\d+\\s+', raw):\n            continue\n        tokens = raw.split()\n        if len(tokens) == 6:\n            number, cost, receipt, submitted, amount, currency = tokens\n        else:\n            number = tokens[0]; cost = tokens[1] if len(tokens) > 1 else 'unknown'\n            receipt = submitted = amount = currency = None\n        lines.append(dict(line=int(number), cost_id=cost, receipt_id=receipt,\n            first_submitted_date=submitted, original_amount=amount.replace(',', '') if amount else None,\n            original_cents=_cents(amount.replace(',', '')) if amount else None,\n            currency=currency, source_refs=[ref(record)]))\n    return lines\n\n\ndef connect_claim(*, parsed, claim, decisions, finance_events, finance, cancellations,\n                  arrival_batch, source_observations, prior_finance=None, source_classifications=None, prior_workflow=None):\n    \"\"\"Evaluate an ordinary path; each result keeps its evidence and owner.\"\"\"\n    record = claim['record']; values = fields(record)\n    claim_id, revision = claim['subject_id'], claim['revision']\n    employee, trip_id = values.get('Employee'), claim.get('trip_id')\n    stages = []\n    def stage(name, condition, refs, detail, owner, action, fail=False):\n        row = dict(stage=name, status='PASS' if condition else 'FAIL' if fail else 'BLOCKED',\n                   source_refs=list(dict.fromkeys([ref(record)] + refs)), detail=detail, owner=owner, next_action=action)\n        stages.append(row)\n        return bool(condition)\n    def trusted(row):\n        return bool(row.get('locator')) and any(o.get('source_id') == row.get('source_id') and\n            o.get('sha256') == row.get('source_sha256') and o.get('status') == 'read' and not o.get('missing_scope')\n            for o in source_observations)\n    def visible(row):\n        try:\n            batch = fields(row).get('Arrival batch')\n            return not isinstance(batch, bool) and int(batch) == float(batch) and 0 < int(batch) <= arrival_batch\n        except (ValueError, TypeError, OverflowError):\n            return False\n\n    trips = [r for r in table(parsed, 'trips', 'Trips') if fields(r).get('Trip reference') == trip_id\n             and str(fields(r).get('Trip revision')) in {str(claim.get('trip_revision')), f\"{claim.get('trip_revision')}.0\"}]\n    trip = fields(trips[0]) if len(trips) == 1 else {}\n    linked = stage('claim_trip_link', len(trips) == 1 and trip.get('Employee ID') == employee\n                   and len([r for r in finance['revision_history'] if r['revision'] == revision]) == 1,\n                   [ref(record)] + [ref(r) for r in trips], 'Exact claim, trip revision and employee linkage',\n                   'Travel Administration Lead', 'Verify the exact employee, trip ID and trip revision binding')\n    people = [r for r in table(parsed, 'people', 'People') if fields(r).get('Employee ID') == employee]\n    person = fields(people[0]) if len(people) == 1 else {}\n    lead = person.get('Administration reviewer') or 'Travel Administration Lead'\n    finance_owner = person.get('Finance officer') or 'Finance'\n\n    policy_source_ids = {'synthetic-policy'} if parsed.get('evidence_mode') == 'synthetic-test' else {'policy-pol-2026-2'}\n    rules = [r for r in table(parsed, 'workflow_policy_rules', 'Workflow policy rules')\n             if r.get('source_id') in policy_source_ids and trusted(r) and visible(r)]\n    policy_record = rules[0] if len(rules) == 1 else None\n    policy = fields(policy_record) if policy_record else {}\n    policy_supported = (policy.get('Rule set') == 'exact-paid-costs-v1'\n                        and isinstance(policy.get('Policy revision'), str) and bool(policy.get('Policy revision'))\n                        and isinstance(policy.get('Eligible categories'), list)\n                        and isinstance(policy.get('Uncapped categories'), list)\n                        and isinstance(policy.get('Required claim roles'), list) and bool(policy.get('Required claim roles'))\n                        and set(policy.get('Required claim roles')) <= set(ROLE_FIELDS)\n                        and policy.get('Receipt required') is True and policy.get('Settled merchant proof required') is True\n                        and policy.get('No self review') is True and policy.get('FX date basis') == 'paid-date'\n                        and policy.get('Closure rule') == 'entitlement-authorization-net-cash-no-blockers'\n                        and isinstance(policy.get('Domestic permit required'), bool))\n    policy_refs = [ref(policy_record)] if policy_record else []\n    affected = [c for c in cancellations if claim_id in c['affected_claim_ids']]\n    permission = False\n    permission_refs = [ref(r) for r in trips] + policy_refs\n    if linked and policy_supported:\n        if trip.get('International') is False and policy.get('Domestic permit required') is False:\n            permission = True\n        else:\n            # UTC timing must be expressly supplied; local calendar dates do\n            # not establish an exact commitment instant.\n            permit_roles = policy.get('Required permit roles')\n            commitment = trip.get('First commitment time (UTC)')\n            relevant = [r for r in decisions if fields(r).get('Subject type') == 'permit'\n                        and fields(r).get('Subject reference') == trip.get('Permit reference')\n                        and fields(r).get('Revision') == trip.get('Permit revision')]\n            permission_refs += [ref(r) for r in relevant]\n            try:\n                stamp = lambda text: datetime.fromisoformat(text.replace('Z', '+00:00'))\n                commit = stamp(commitment)\n                permission = bool(trip.get('Permit reference') and permit_roles and set(permit_roles) <= set(ROLE_FIELDS)\n                                  and commit.utcoffset() is not None)\n                for role in permit_roles or []:\n                    matching = [fields(r) for r in relevant if fields(r).get('Review roles') == role]\n                    permission = permission and len(matching) == 1 and matching[0].get('Outcome') == 'approve'\n                    if permission:\n                        permission = (matching[0].get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                      and matching[0].get('Reviewer') != employee\n                                      and stamp(matching[0].get('Decision time (UTC)')).utcoffset() is not None\n                                      and stamp(matching[0]['Decision time (UTC)']) < commit)\n            except (ValueError, TypeError, AttributeError):\n                permission = False\n    stage('travel_permission', permission, permission_refs,\n          'Travel permission requires sourced policy and exact permit authority/timing where required; affected cancellations block the ordinary path',\n          lead, 'Obtain the policy-defined permission requirement and matching permit approvals/timing; resolve affected cancellations')\n\n    lines = expense_lines(record)\n    eligibility = travel_findings(trip=trip, employee=employee, decisions=decisions, people=table(parsed, 'people', 'People'),\n        cancellations=cancellations, fields=fields, ref=ref, observations=source_observations,\n        trip_source_refs=[ref(r) for r in trips]) if policy_valid(parsed.get('expense_policy')) else []\n    calculation = evaluate_expenses(lines=lines, parsed=parsed, employee=employee, trip_id=trip_id,\n        trip=trip, record=record, history=finance['revision_history'], fields=fields, ref=ref, table=table,\n        eligibility_findings=eligibility, observations=source_observations)\n    evidence_ok = bool(lines) and len({line['cost_id'] for line in lines}) == len(lines) and all(\n        line['evidence_status'] == 'PASS' for line in lines)\n    evidence_refs = [ref(record)] + [r for line in lines for r in line['source_refs']]\n    stage('supporting_evidence', evidence_ok, evidence_refs,\n          'Current revision receipts and settled merchant proof must match employee, trip, cost, currency and gross',\n          employee or 'Employee', 'Supply matching receipts and settled merchant proof for every expense')\n    filing_ok = bool(lines) and all(line['filing_status'] == 'PASS' for line in lines)\n    stage('filing_deadline', filing_ok, evidence_refs,\n          '; '.join(f\"{line['cost_id']}: {line['reason']}\" for line in lines) or 'Missing expense submissions',\n          finance_owner, 'Verify cost-specific original submission dates, trip end and employee payment; obtain explicit Finance exception for late filing')\n    waived_permission = bool(eligibility and any(f['issue'] in {'late_permit', 'permit_unapproved'} for f in eligibility)\n        and lines and all(l['eligibility_status'] == 'PASS' for l in lines))\n    reimbursement_permission = permission or (linked and policy_supported and waived_permission)\n    policy_ok = policy_supported and evidence_ok and linked and reimbursement_permission and calculation['status'] == 'PASS'\n    for line in lines:\n        line['allowed_cents'] = line['calculated_cents'] if policy_ok else None\n        if not policy_ok:\n            line['status'] = 'unresolved'\n    allowed = calculation['calculated_cents'] if policy_ok else None\n    stage('policy_eligibility', policy_ok, policy_refs + evidence_refs,\n          'Expense calculation and filing are separate from travel permission, reviewed policy definitions and approvals',\n          lead, 'Resolve line findings and remaining policy/permission evidence before treating calculated amounts as entitlement')\n\n    for line in lines:\n        exception = line['exception']\n        if exception['status'] != 'absent':\n            stage(f\"finance_exception:{line['cost_id']}\", exception['status'] == 'valid', line['source_refs'],\n                  exception.get('reason', 'Source-bound Finance exception'), finance_owner,\n                  'Supply exact Finance actor, current claim/revision/cost, replacement amount, reason and covered issues')\n        for item in line['eligibility_findings']:\n            name = f\"eligibility:{line['cost_id']}:{item['issue']}\" + (f\":{item['travel_cancellation_id']}\" if item.get('travel_cancellation_id') else '')\n            stage(name, item['status'] == 'covered_for_reimbursement', item['source_refs'] + item['exception_source_refs'],\n                  item['original_finding'] + '; ' + item['status'], finance_owner,\n                  'Obtain explicit Finance coverage for this exact eligibility finding and affected expense; retain original arrangement history')\n\n    prior_lines = {l['cost_id']: l for l in (prior_workflow or {}).get('lines', [])}\n    def changed_exception_amount(line):\n        old = prior_lines.get(line['cost_id'], {})\n        before = old.get('conversion', {}).get('allowed_original_amount')\n        after = line.get('conversion', {}).get('allowed_original_amount')\n        # Unknown-to-known evidence and decimal display precision are not proof\n        # of a material replacement-amount change.\n        return bool(before is not None and after is not None\n            and (line.get('exception', {}).get('status') == 'valid' or old.get('exception', {}).get('status') == 'valid')\n            and Decimal(before) != Decimal(after))\n    same_revision_change = bool(prior_workflow and prior_workflow.get('revision') == revision and (\n        any(changed_exception_amount(line) for line in lines)\n        or prior_workflow.get('exception_revalidation', {}).get('same_revision_change')))\n    replacement_review = same_revision_change or any(\n        line.get('replacement_amount_changed') or changed_exception_amount(line) for line in lines)\n    current = [r for r in decisions if fields(r).get('Subject type') == 'claim'\n               and fields(r).get('Subject reference') == claim_id and fields(r).get('Revision') == revision]\n    unique_decisions = {}; decision_conflict = False\n    for decision in current:\n        identity = fields(decision).get('Decision reference')\n        payload = {k: v for k, v in fields(decision).items() if k != 'Arrival batch'}\n        if not identity or identity in unique_decisions and unique_decisions[identity][1] != payload:\n            decision_conflict = True\n        unique_decisions[identity] = (decision, payload)\n    current = [pair[0] for pair in unique_decisions.values()]\n    packets = table(parsed, 'review_packets', 'Review packets')\n    budget_ids = {fields(r).get('Ledger reference') for r in table(parsed, 'budget', 'Budget')}\n    observed = []; reviews_ok = bool(current) and len(people) == 1 and not decision_conflict\n    for decision in current:\n        dv = fields(decision)\n        ps = [p for p in packets if fields(p).get('Decision reference') == dv.get('Decision reference')]\n        pv = fields(ps[0]) if len(ps) == 1 else {}\n        roles = str(dv.get('Review roles') or '').splitlines()\n        valid = (len(ps) == 1 and pv.get('Employee ID') == employee and pv.get('Trip reference') == trip_id\n                 and pv.get('Trip revision') == claim.get('trip_revision')\n                 and all(pv.get(key) == trip.get(key) for key in ('Business purpose', 'Client', 'Schedule coverage', 'Alternatives considered', 'Permit reference', 'Permit revision'))\n                 and set(str(pv.get('Expense references') or '').splitlines()) == {l['cost_id'] for l in lines}\n                 and bool(pv.get('Policy revision')) and bool(str(pv.get('Budget record references') or '').splitlines())\n                 and set(str(pv.get('Budget record references') or '').splitlines()) <= budget_ids\n                 and roles and all(role in ROLE_FIELDS and dv.get('Reviewer') == person.get(ROLE_FIELDS[role])\n                                   and dv.get('Reviewer') != employee for role in roles))\n        if policy_record:\n            valid = valid and pv.get('Policy revision') == policy.get('Policy revision')\n        exception_binding = (not replacement_review or (source_bound(decision, source_observations)\n            and all(source_bound(p, source_observations) for p in ps)\n            and review_binds_exception(decision, record, same_revision_change=same_revision_change, fields=fields, ref=ref)))\n        valid = valid and exception_binding\n        observed.append(dict(exception_binding_valid=exception_binding, decision_id=dv.get('Decision reference'), outcome=dv.get('Outcome'), roles=roles,\n                             evidence_valid=bool(valid), source_refs=[ref(decision)] + [ref(p) for p in ps]))\n        reviews_ok = reviews_ok and valid\n    review_refs = [r for d in observed for r in d['source_refs']] + [ref(p) for p in people]\n    stage('review_evidence', reviews_ok, review_refs, 'Observed current-revision human decisions matched to reviewers and preserved review packets; completeness is checked separately',\n          lead, 'Provide exact-revision decisions and packets matching the employee, trip, expense list, policy and budget references')\n    required = policy.get('Required claim roles', []) if policy_supported else []\n    if policy_supported and policy.get('Director threshold cents') is not None:\n        threshold = policy['Director threshold cents']\n        if isinstance(threshold, int) and not isinstance(threshold, bool) and threshold >= 0 and allowed is not None:\n            required = list(required) + (['director'] if allowed > threshold else [])\n        else:\n            reviews_ok = False\n    approvals = reviews_ok and policy_supported and all(\n        len([d for d in observed if role in d['roles'] and d['outcome'] == 'approve']) == 1\n        and all(d['outcome'] == 'approve' for d in observed if role in d['roles']) for role in required)\n    stage('required_approvals', approvals, review_refs + policy_refs,\n          'All policy-required roles must have matching current-revision approvals; no decisions are created',\n          lead, 'Confirm policy-required review roles and obtain their current-revision human approvals')\n\n    exception_revalidated = not replacement_review or approvals\n    stage('exception_revalidation', exception_revalidated, evidence_refs + review_refs,\n          'Replacement amounts require current claim reviews bound to the replacement source version; earlier reviews remain historical',\n          lead, 'Obtain current revision/source-bound reviews of the Finance replacement amount and a matching reimbursement authorization')\n\n    requests = [r for r in table(parsed, 'reimbursement_requests', 'Reimbursement requests')\n                if trusted(r) and visible(r) and fields(r).get('Claim reference') == claim_id and fields(r).get('Revision') == revision]\n    request = fields(requests[0]) if len(requests) == 1 else {}\n    obligation = finance.get('recorded_obligation')\n    approved_ids = {d['decision_id'] for d in observed if d['outcome'] == 'approve' and d['evidence_valid']}\n    request_ok = bool(linked and reimbursement_permission and policy_ok and approvals and obligation and len(requests) == 1\n                      and request.get('Request reference') == obligation['request_id']\n                      and request.get('Payee ID') == person.get('Payee ID') == obligation['payee_id']\n                      and request.get('Currency') == 'EUR' and _cents(request.get('Amount (EUR)')) == allowed == obligation['amount_cents']\n                      and obligation['claim_revision'] == revision and obligation['finance_officer'] == finance_owner\n                      and set(str(request.get('Decision references') or '').splitlines()) == approved_ids\n                      and bool(approved_ids))\n    request_refs = [ref(r) for r in requests] + (obligation['source_refs'] if obligation else [])\n    stage('request_obligation', request_ok, request_refs,\n          'Recorded request/obligation linkage requires explicit claim revision, payee, amount and approval references; ledger arrival context is not authorization',\n          finance_owner, 'Provide the exact-revision reimbursement request and Finance acceptance linked to its approvals and authorized amount')\n    if request_ok:\n        authorization = dict(amount_cents=allowed, claim_revision=revision, source_refs=reque…2850 tokens truncated…Budget review receives the whole department/project/period ledger: allocation less net settled expenditure less remaining commitments. A commitment includes its settled portion; do not subtract the full commitment and its settled portion again. Include prior obligations outside the current batch and all accepted new requests. Adequate funds alone are not a budget approval. Supervisor considers business purpose, client commitment, schedule coverage and permit consistency. Director considers high spend, the documented exception, alternatives and budget-owner position. Reviewers may approve, return with a concrete repair request, or reject with a reason; their discretionary judgment is supplied by the scenario, not performed by the learner.\n\nRequests and replies identify subject type, subject ID/revision, role(s), stable actor, relevant source versions and reason. Consume only the trainer-supplied decision batches and the directory's applicable actor/roles. Missing responses for otherwise complete requests wait; missing policy/input definitions are package defects. Reject wrong-role, stale-version or wrong-subject replies for current authorization. Keep rejected imports visible. A return reopens the appropriate review; explicit rejection or clean withdrawal can close with a non-payment reason.\n\nA material change to employee, trip, dates, money, policy/evidence or authority invalidates dependent review, approvals and payment readiness even if the total is unchanged. Full recheck and justified dependency recheck are both valid. Preserve old versions and decisions as history. Before dispatch, rebuild readiness from current facts. After dispatch, hold replacement requests until Finance confirms cancellation/status. Pending cancellation is not confirmed cancellation. Withdrawal never erases an actual payment.\n\"\"\"Actual C01 evidence plus explicitly SYNTHETIC successful closure tests.\"\"\"\nfrom copy import deepcopy\nimport hashlib\nimport json\nfrom pathlib import Path\n\nfrom jsonschema import Draft202012Validator, FormatChecker\nimport pytest\n\nfrom travel_claim.integration import integrate_arrival_batch\nfrom travel_claim.expenses import load_expense_policy\nfrom travel_claim.outputs import load_repair_queue, write_repair_queue\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef native():\n    parsed = json.loads((Path(__file__).parent / 'fixtures/ordinary_claim_c01.json').read_text())\n    parsed['expense_policy'] = load_expense_policy(ROOT / 'tests/fixtures/POL-2026.2-browser-copy.txt')\n    parsed['event_clock'] = {'date': '2026-11-15', 'timezone': 'Europe/Amsterdam'}  # policy line 3; no instant invented\n    return parsed\n\n\ndef row(source, locator, **values):\n    return dict(source_id=source, source_sha256=hashlib.sha256(source.encode()).hexdigest(), locator=locator,\n                values={key.replace('_', ' '): {'value': value} for key, value in values.items()})\n\n\ndef synthetic():\n    # Every changed record is explicitly a synthetic source with its own ID.\n    parsed = json.loads(json.dumps(native()).replace('C01', 'SYN-C01'))\n    parsed.update(evidence_mode='synthetic-test', case_clock='2026-09-15T12:00:00Z', unresolved_issues=[])\n    parsed['event_clock'] = parsed['case_clock']\n    records = parsed['records']\n    all_rows = [r for rows in records.values() for r in rows] + [r for s in parsed['workbook_sheets'] for r in s['records']]\n    for r in all_rows:\n        r['source_id'] = 'synthetic-' + r['source_id']\n        r['source_sha256'] = hashlib.sha256(r['source_id'].encode()).hexdigest()\n    for event in records['finance_events']:\n        event['values']['Claim revision'] = {'value': 1}\n    for packet in next(s['records'] for s in parsed['workbook_sheets'] if s['name'] == 'Review packets'):\n        packet['values']['Policy revision']['value'] = 'POL-SYNTHETIC-ONLY'\n    records['workflow_policy_rules'] = [row('synthetic-policy', 'SYNTHETIC policy definition', **{\n        'Arrival batch': 1, 'Rule set': 'exact-paid-costs-v1', 'Policy revision': 'POL-SYNTHETIC-ONLY',\n        'Eligible categories': ['transport'], 'Uncapped categories': ['transport'],\n        'Required claim roles': ['administration', 'budget_owner', 'supervisor'],\n        'Receipt required': True, 'Settled merchant proof required': True, 'No self review': True,\n        'FX date basis': 'paid-date', 'Domestic permit required': False,\n        'Closure rule': 'entitlement-authorization-net-cash-no-blockers',\n    })]\n    decisions = '\\n'.join(r['values']['Decision reference']['value'] for r in records['decisions'])\n    records['reimbursement_requests'] = [row('synthetic-request', 'SYNTHETIC recorded request', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1, 'Request reference': 'REQ-SYN-C01',\n        'Currency': 'EUR', 'Amount (EUR)': 100, 'Payee ID': 'EMP-01', 'Decision references': decisions,\n    })]\n    records['closure_authorities'] = [row('synthetic-facilitator', 'SYNTHETIC completion conditions', **{\n        'Arrival batch': 1, 'Claim reference': 'SYN-C01', 'Revision': 1,\n        'Confirmation': 'financial-completion-conditions', 'Authority': 'SYNTHETIC facilitator',\n        'Case clock': parsed['case_clock'],\n    })]\n    all_rows += records['workflow_policy_rules'] + records['reimbursement_requests'] + records['closure_authorities']\n    parsed['source_observations'] = [dict(source_id=sid, sha256=hashlib.sha256(sid.encode()).hexdigest(),\n        status='read', missing_scope=[]) for sid in sorted({r['source_id'] for r in all_rows})]\n    return parsed\n\n\ndef batches(parsed):\n    prior = None; results = []\n    schema = json.loads((ROOT / 'snapshot.schema.json').read_text())\n    validator = Draft202012Validator(schema, format_checker=FormatChecker())\n    for number in parsed['arrival_batches']:\n        prior = integrate_arrival_batch(parsed, arrival_batch=number, run_id='ordinary-test',\n            batch_id=f'arrival-{number:03d}', source_binding={'path': 'sources.json', 'sha256': 'a' * 64},\n            predecessor={'path': f'batches/arrival-{number-1:03d}.json', 'sha256': 'b' * 64} if prior else None,\n            prior_result=prior, source_observations=parsed['source_observations'])\n        assert list(validator.iter_errors(prior['snapshot'])) == []\n        results.append(prior)\n    return results\n\n\ndef workflow(result, claim='SYN-C01'):\n    return result['domain']['ordinary_workflows'][claim]\n\n\ndef stages(value):\n    return {stage['stage']: stage for stage in value['stages']}\n\n\ndef test_actual_c01_connects_evidence_reviews_and_ledger_but_never_fabricates_closure():\n    results = batches(native())\n    current = workflow(results[-1], 'C01'); checks = stages(current)\n    assert current['claim_id'] == 'C01' and current['revision'] == 1\n    assert current['trip_id'] == 'T01' and current['trip_revision'] == 1\n    for name in ('claim_trip_link', 'supporting_evidence', 'review_evidence', 'financial_reconciliation'):\n        assert checks[name]['status'] == 'PASS'\n    for name in ('travel_permission', 'policy_eligibility', 'required_approvals', 'request_obligation', 'financial_closure'):\n        assert checks[name]['status'] == 'BLOCKED'\n        assert checks[name]['owner'] and checks[name]['next_action']\n    assert current['status'] == 'pending' and current['allowed_cents'] is None\n    line = current['lines'][0]\n    assert line['cost_id'] == 'COST-01' and line['original_cents'] == 10000\n    assert line['evidence_status'] == 'PASS' and line['allowed_cents'] is None\n    assert any(\"#tab 'Merchant payments', row 6\" in ref for ref in line['source_refs'])\n    assert any('#PDF page 1, receipt 1' in ref for ref in line['source_refs'])\n    assert len(current['observed_reviews']) == 3\n    finance = results[-1]['finance_reconciliations']['C01']\n    assert finance['recorded_obligation']['request_id'] == 'REQ-C01'\n    assert finance['net_confirmed_cents'] == 10000 and finance['recorded_ledger_balance_cents'] == 0\n    assert finance['authorized_obligation'] is None and finance['balance_cents'] is None\n    assert results[-1]['snapshot']['requests'] == []\n\n\ndef test_synthetic_connected_path_moves_from_pending_to_supported_closure_and_keeps_history(tmp_path):\n    first, second, third, final = batches(synthetic())\n    assert workflow(first)['status'] == 'pending'\n    assert workflow(first)['allowed_cents'] == 10000 and workflow(first)['balance_cents'] == 10000\n    assert stages(workflow(first))['request_obligation']['status'] == 'PASS'\n    for result in (second, third, final):\n        value = workflow(result)\n        assert value['mode'] == 'synthetic-test'\n        assert value['status'] == 'closed-reimbursed'\n        assert all(stage['status'] == 'PASS' for stage in value['stages'])\n        assert value['allowed_cents'] == 10000 and value['balance_cents'] == 0\n        assert value['next_owner'] is None\n        assert all(stage['source_refs'] for stage in value['stages'])\n    assert final['snapshot']['requests'][0]['request_id'] == 'REQ-SYN-C01'\n    assert final['snapshot']['requests'][0]['revision'] == 1\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000  # duplicate delivery counts once\n    assert len(final['domain']['ordinary_workflow_history']) == 4\n    item = final['domain']['repair_queue']['items']['ordinary:SYN-C01:r1:financial_closure']\n    assert item['status'] == 'resolved' and item['response_id'] is None\n    assert item['request_draft']['sent'] is False\n    assert item['history'][-1]['event'] == 'evidence-revalidated'\n    path = tmp_path / 'queue.json'\n    write_repair_queue(first['domain']['repair_queue'], path)\n    write_repair_queue(final['domain']['repair_queue'], path)\n    assert load_repair_queue(path)['items'][item['item_id']]['status'] == 'resolved'\n\n\n@pytest.mark.parametrize('missing', ['receipt', 'settled-proof', 'policy', 'policy-source', 'review',\n                                  'request', 'request-amount', 'revision', 'closure-authority', 'clock'])\ndef test_synthetic_path_cannot_close_when_a_required_condition_is_missing(missing):\n    parsed = synthetic(); records = parsed['records']\n    if missing == 'receipt': records['receipts'] = []\n    elif missing == 'settled-proof':\n        next(s for s in parsed['workbook_sheets'] if s['name'] == 'Merchant payments')['records'][0]['values']['Payment status']['value'] = 'pending'\n    elif missing == 'policy': records['workflow_policy_rules'] = []\n    elif missing == 'policy-source': records['workflow_policy_rules'][0]['source_sha256'] = '0' * 64\n    elif missing == 'review': records['decisions'][0]['values']['Outcome']['value'] = 'return'\n    elif missing == 'request': records['reimbursement_requests'] = []\n    elif missing == 'request-amount': records['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 80\n    elif missing == 'revision': records['finance_events'][0]['values']['Claim revision']['value'] = 2\n    elif missing == 'closure-authority': records['closure_authorities'] = []\n    else: parsed['case_clock'] = None\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert any(stage['status'] != 'PASS' for stage in workflow(result)['stages'])\n    assert any(item['status'] == 'open' for item in result['domain']['repair_queue']['items'].values())\n\n\ndef test_correction_reopens_path_and_preserves_earlier_closure_cash_and_decisions():\n    parsed = synthetic()\n    corrected = deepcopy(parsed['records']['claim_revisions'][0])\n    for field in corrected['fields']:\n        if field['label'] == 'Revision': field['value'] = '2'\n        if field['label'] == 'Arrival batch': field['value'] = '3'\n    corrected['locator'] = 'SYNTHETIC correction page'\n    corrected['text'] = corrected['text'].replace('Revision: 1', 'Revision: 2')\n    parsed['records']['claim_revisions'].append(corrected)\n    first, second, third, final = batches(parsed)\n    assert workflow(second)['status'] == 'closed-reimbursed'\n    assert workflow(third)['revision'] == 2 and workflow(third)['status'] == 'pending'\n    assert stages(workflow(third))['supporting_evidence']['status'] == 'PASS'\n    assert stages(workflow(third))['required_approvals']['status'] == 'BLOCKED'\n    assert stages(workflow(third))['request_obligation']['status'] == 'BLOCKED'\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert final['snapshot']['claims'][0]['balance_cents'] is None\n    assert len(final['decision_history']) == 3\n    assert all(d['structural_match'] == 'revision_match_historical' for d in final['decision_history'])\n    queue = final['domain']['repair_queue']['items']\n    assert queue['correction:SYN-C01:r2:expense-evidence']['status'] == 'resolved'\n    assert queue['correction:SYN-C01:r2:approvals']['status'] == 'open'\n    assert workflow(second)['revision'] == 1  # previous result never mutated\n\n\ndef test_unrelated_cancellation_does_not_block_independent_claim_closure():\n    parsed = synthetic()\n    native_cancellations = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    parsed['records']['cancellation_activities'] = [r for r in native_cancellations if r['values']['Cancellation reference']['value'] == 'TC122']\n    from test_retained_finance import _fixture\n    parsed['records']['trips'] += [r for r in _fixture()['records']['trips'] if r['values']['Trip reference']['value'] == 'T122']\n    final = batches(parsed)[-1]\n    assert workflow(final)['status'] == 'closed-reimbursed'\n    cancellation = final['snapshot']['travel_cancellations'][0]\n    assert cancellation['cancellation_id'] == 'TC122' and cancellation['affected_claim_ids'] == []\n    assert cancellation['financial_status'] == 'unresolved'\n\n\ndef test_current_review_packet_must_match_current_trip_facts():\n    parsed = synthetic()\n    packet = next(s for s in parsed['workbook_sheets'] if s['name'] == 'Review packets')['records'][0]\n    packet['values']['Business purpose']['value'] = 'SYNTHETIC stale business purpose'\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['review_evidence']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_pending_transfer_is_not_ignored_just_because_net_cash_already_balances():\n    parsed = synthetic()\n    pending = deepcopy(parsed['records']['finance_events'][1])\n    pending['values']['Activity reference']['value'] = 'SYNTHETIC-PENDING-TRANSFER'\n    pending['values']['Activity type']['value'] = 'mystery-pending'\n    pending['values']['Arrival batch']['value'] = 3\n    parsed['records']['finance_events'].append(pending)\n    result = batches(parsed)[-1]\n    assert workflow(result)['status'] == 'pending'\n    assert 'SYNTHETIC-PENDING-TRANSFER' in result['finance_reconciliations']['SYN-C01']['unresolved_event_ids']\n\n\ndef test_conflicting_duplicate_review_id_cannot_supply_an_approval():\n    parsed = synthetic()\n    conflict = deepcopy(parsed['records']['decisions'][0])\n    conflict['values']['Outcome']['value'] = 'return'\n    parsed['records']['decisions'].append(conflict)\n    assert stages(workflow(batches(parsed)[-1]))['required_approvals']['status'] == 'BLOCKED'\n\n\ndef test_synthetic_source_defined_cap_changes_entitlement_without_changing_merchant_cost():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]['values']\n    policy['Eligible categories']['value'] = ['lodging']\n    policy['Uncapped categories']['value'] = []\n    parsed['records']['receipts'][0]['fields'] = [dict(f, value='lodging') if f['label'] == 'Category' else f for f in parsed['records']['receipts'][0]['fields']]\n    cap = row('synthetic-travel-registers-workbook', 'SYNTHETIC cap row', **{\n        'Cap reference': 'SYN-CAP', 'Destination': 'NL', 'Category': 'lodging', 'Currency': 'EUR',\n        'Effective from': '2026-01-01', 'Effective to': '2026-12-31', 'Amount per unit': 40,\n    })\n    parsed['workbook_sheets'].append({'name': 'Caps', 'records': [cap]})\n    parsed['records']['reimbursement_requests'][0]['values']['Amount (EUR)']['value'] = 40\n    for event in parsed['records']['finance_events']:\n        for field in ('Amount (EUR)', 'Obligation (EUR)'):\n            if field in event['values']: event['values'][field]['value'] = 40\n    value = workflow(batches(parsed)[-1])\n    assert value['lines'][0]['original_cents'] == 10000\n    assert value['allowed_cents'] == 4000 and value['balance_cents'] == 0\n    assert value['status'] == 'closed-reimbursed'\n    assert any('SYNTHETIC cap row' in ref for ref in value['lines'][0]['source_refs'])\n\n\ndef test_source_defined_director_threshold_does_not_invent_missing_director_approval():\n    parsed = synthetic()\n    parsed['records']['workflow_policy_rules'][0]['values']['Director threshold cents'] = {'value': 5000}\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['required_approvals']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n    assert all('director' not in d['roles'] for d in value['observed_reviews'])\n\n\ndef test_failed_transfer_requires_a_supported_resolution_even_when_other_cash_balances():\n    parsed = synthetic()\n    failed = deepcopy(parsed['records']['finance_events'][1])\n    failed['values']['Activity reference']['value'] = 'SYNTHETIC-FAILED'\n    failed['values']['Activity type']['value'] = 'failed'\n    failed['values']['Arrival batch']['value'] = 3\n    failed['values'].pop('Amount (EUR)', None)\n    parsed['records']['finance_events'].append(failed)\n    result = batches(parsed)[-1]\n    assert result['finance_reconciliations']['SYN-C01']['balance_cents'] == 0\n    assert workflow(result)['status'] == 'pending'\n    assert stages(workflow(result))['financial_closure']['status'] == 'BLOCKED'\n\n\ndef test_conflicting_current_claim_revision_blocks_even_if_last_record_looks_complete():\n    parsed = synthetic()\n    duplicate = deepcopy(parsed['records']['claim_revisions'][0])\n    duplicate['locator'] = 'SYNTHETIC conflicting duplicate revision'\n    duplicate['text'] += '\\nSYNTHETIC conflicting evidence'\n    parsed['records']['claim_revisions'].append(duplicate)\n    value = workflow(batches(parsed)[-1])\n    assert stages(value)['claim_trip_link']['status'] == 'BLOCKED'\n    assert value['status'] == 'pending'\n\n\ndef test_finance_or_workbook_source_cannot_be_misrepresented_as_a_policy_definition():\n    parsed = synthetic()\n    policy = parsed['records']['workflow_policy_rules'][0]\n    policy['source_id'] = 'synthetic-travel-registers-workbook'\n    policy['source_sha256'] = hashlib.sha256(policy['source_id'].encode()).hexdigest()\n    assert stages(workflow(batches(parsed)[-1]))['policy_eligibility']['status'] == 'BLOCKED'\n\n\ndef test_affected_cancellation_holds_eligibility_without_erasing_calculation_or_cash():\n    parsed = synthetic()\n    native_rows = json.loads((Path(__file__).parent / 'fixtures/retained_finance_records.json').read_text())['records']['cancellation_activities']\n    for source in native_rows:\n        if source['values']['Cancellation reference']['value'] != 'TC018': continue\n        record = deepcopy(source)\n        record['source_id'] = 'synthetic-travel-registers-workbook'\n        record['source_sha256'] = hashlib.sha256(record['source_id'].encode()).hexdigest()\n        record['locator'] = 'SYNTHETIC affected cancellation ' + record['locator']\n        record['values']['Trip reference']['value'] = 'T01'\n        parsed['records']['cancellation_activities'].append(record)\n    final = batches(parsed)[-1]\n    value = workflow(final)\n    assert stages(value)['travel_permission']['status'] == 'PASS'\n    assert value['allowed_cents'] is None\n    assert value['lines'][0]['calculated_cents'] == 10000\n    assert any(f['issue'] == 'travel_cancellation' and f['status'] == 'unresolved' for f in value['lines'][0]['eligibility_findings'])\n    assert final['snapshot']['claims'][0]['paid_cents'] == 10000\n    assert value['status'] == 'pending'\n    assert stages(value)['financial_closure']['status'] == 'BLOCKED'\n    assert final['snapshot']['travel_cancellations'][0]['financial_status'] == 'unresolved'\n"},"started_at_ms":1792024464750,"completed_at_ms":1792024464896}}
