{"timestamp":"2026-10-20T07:21:31.445Z","ordinal":10681,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_02f4b2bd528e1b90016ad7166f7360819098bb689b0701d398","status":"completed","call_id":"call_61c0e6514ece41f282af6104de3beda7","name":"exec","input":"text(await tools.exec_command({cmd:\"PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -m pytest -q -p no:cacheprovider\",\"yield_time_ms\":1000,\"max_output_tokens\":1000}));\ntext(await tools.exec_command({cmd:\".venv/bin/python - <<'PY'\\nimport hashlib,json,subprocess\\nfrom pathlib import Path\\nfiles=['README.md','skills/travel-expense-claim/SKILL.md','src/travel_claim/cli.py','src/travel_claim/outputs.py','src/travel_claim/receipt_continuation.py','src/travel_claim/repair_continuation.py','tests/test_repair_continuation.py']\\nassert set(subprocess.check_output(['git','diff','--name-only'],text=True).splitlines())==set(files[:5])\\nassert not subprocess.check_output(['git','diff','--cached','--name-only'])\\nbase=json.loads(Path('/tmp/project-d-attempt3-baseline.json').read_text())\\nfor p,h in base.items():\\n if p in files:continue\\n with Path(p).open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==h,p\\nm=json.loads(Path('artifacts/submission/stage7-evidence-manifest.json').read_text())\\nfor r in m['files']:\\n for p,h in [(r['stored_path'],r['stored_sha256']),(r['path'],r['sha256'])]:\\n  with Path(p).open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==h,p\\nprint('53/53 publication entries and 123 unrelated tracked baseline files preserved')\\nold=set(Path('/tmp/project-d-attempt3-untracked-before.txt').read_bytes().split(b'\\\\0'))\\nnow=set(subprocess.check_output(['git','ls-files','--others','--exclude-standard','-z']).split(b'\\\\0'))\\nassert old<=now and now-old=={p.encode() for p in files[-2:]}\\nprint('Untracked historical path inventory preserved; exactly two authorized new files')\\nPath('/tmp/project-d-attempt3-reviewed.json').write_text(json.dumps({p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in files}))\\nrefs=subprocess.check_output(['git','for-each-ref','--format=%(objectname) %(refname)','refs/entire/'],text=True)\\nPath('/tmp/project-d-attempt3-entire-before.txt').write_text(refs)\\nassert len(refs.splitlines())==30\\nassert subprocess.run(['git','merge-base','--is-ancestor','ccea724fbcc1e1581b8625e66f2c9f263c1f8670','refs/entire/checkpoints/ZY/01M5AP7SG3VYTB9WS5VE0K9QZY']).returncode==0\\nprint('30 Entire refs recorded; queued historical tail is a safe fast-forward')\\nPY\",\"yield_time_ms\":1000,\"max_output_tokens\":1800}));\ntext(await tools.exec_command({cmd:\"git diff -- README.md skills/travel-expense-claim/SKILL.md src/travel_claim/cli.py src/travel_claim/outputs.py src/travel_claim/receipt_continuation.py; cat src/travel_claim/repair_continuation.py; cat tests/test_repair_continuation.py\",\"max_output_tokens\":17000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1582e-4aca-75b2-a254-a91278317c96","create_time":1792480879.4541352}}}
{"timestamp":"2026-10-20T07:21:31.544Z","ordinal":10682,"type":"token_usage_record","payload":{"thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a1582e-4aca-75b2-a254-a91278317c96","session_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","root_turn_id":"01a1582e-4aca-75b2-a254-a91278317c96","response_id":"resp_02f4b2bd528e1b90016ad71667cc248190bc6af68ba7227aac","usage":{"input_tokens":267819,"cached_input_tokens":265984,"cache_write_input_tokens":0,"output_tokens":948,"reasoning_output_tokens":195,"total_tokens":268767},"turn_token_usage":{"input_tokens":799003,"cached_input_tokens":794240,"cache_write_input_tokens":0,"output_tokens":1191,"reasoning_output_tokens":195,"total_tokens":800194},"thread_token_usage":{"input_tokens":255430774,"cached_input_tokens":250253952,"cache_write_input_tokens":0,"output_tokens":927510,"reasoning_output_tokens":371174,"total_tokens":256358284}}}
{"timestamp":"2026-10-20T07:21:34.107Z","ordinal":10683,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a13bd1-7420-72c0-963e-58742d1be7bf","turn_id":"01a1582e-4aca-75b2-a254-a91278317c96","item":{"type":"CommandExecution","id":"exec-c0185d01-5a9c-4178-9d8e-54af0d84c98c","process_id":"47025","command":["/bin/bash","-lc","git diff -- README.md skills/travel-expense-claim/SKILL.md src/travel_claim/cli.py src/travel_claim/outputs.py src/travel_claim/receipt_continuation.py; cat src/travel_claim/repair_continuation.py; cat tests/test_repair_continuation.py"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":"git diff -- README.md skills/travel-expense-claim/SKILL.md src/travel_claim/cli.py src/travel_claim/outputs.py src/travel_claim/receipt_continuation.py; cat src/travel_claim/repair_continuation.py; cat tests/test_repair_continuation.py"}],"source":"unified_exec_startup","status":"completed","stdout":"diff --git a/README.md b/README.md\nindex 8b93657..a32599f 100644\n--- a/README.md\n+++ b/README.md\n@@ -73,6 +73,78 @@ The owner-grouped repair queue API is in `travel_claim.outputs`. Queue items ret\n \n ## Verification\n \n+### Resumable evidence and returned-work repairs (Omega Attempt 3)\n+\n+From a restored offline replay, use a fresh result directory:\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+# A later authentic response can resume that result, retaining the full chain:\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Supply authentic employee responses, not generated answers. The envelope uses\n+`response_version: repair-response/1`, a stable `response_id`, employee `actor_id`\n+and exact `item_outcomes`. Each item retains its own outcome, note and refs.\n+Supported item IDs are current claim `ordinary:<id>:r<revision>:supporting_evidence`,\n+`correction:<id>:r<revision>:expense-evidence`, and\n+`ordinary:<id>:r<revision>:review_return:<decision-id>`. Non-claim items reject\n+this bounded command; unsupported claim approval, Finance, exception, policy\n+and budget repairs remain held.\n+\n+A supported outcome has `source_refs`, `assessment_ref`, and a nonempty `repairs`\n+array. Each operation has `kind` (`receipt` or `merchant-payment`), exact\n+`record_ref`, and `supersedes_refs` (empty for missing evidence; otherwise every\n+current row it explicitly replaces). A supplied JSON sufficiency assessment\n+binds the same item, subject, integer revision, response ID, employee `actor_id`,\n+reason, provenance, `evidence_refs` and **identical repairs array**. A reviewer\n+return also requires its exact `return_decision_ref` and original `repair_requested`\n+text. Matching actor identifiers do not independently authenticate the speaker.\n+\n+Use the receipt continuation manifest/reference format below. Receipt evidence\n+is a searchable PDF in the existing receipt-card schema. Merchant evidence is\n+an XLSX containing one nonempty `Merchant payments` tab with the existing native\n+headers. PDF and XLSX bytes are re-parsed; caller-provided parsed rows cannot\n+establish authority. Proof must match the current employee/trip/cost/receipt,\n+currency and full gross amount. Merchant proof additionally needs transaction\n+identity, settled status and an admissible payment date. Split-payment repairs\n+and shared-cost replacements require a broader adapter and remain held. New\n+deliveries need distinct supplemental source IDs; native IDs cannot be replaced.\n+\n+Valid independent items progress while unverifiable, insufficient or conflicting\n+items stay open. Bad declared hashes/observations and mismatched rows are retained\n+with admission reasons. Unknown items, stale revisions or wrong employees reject\n+the command without creating a result. The command rechecks affected claims,\n+updates queue/CSV/report/unsent drafts and retains old evidence/replacement history.\n+An evidence response does not approve a returned claim: current human re-review\n+and all other prerequisites still apply. No decisions, Finance events, cash or\n+reimbursement authorizations are imported or created.\n+\n+Results retain `continuation-input.json`, state, exact response, supplemental\n+evidence, output hashes and a recursively verified predecessor link. The four\n+original snapshots are unchanged; response ordinals are local evaluation order,\n+not additional native arrival batches or invented scenario times. Keep ancestors\n+available at their recorded relative paths. Exact command replay is inert;\n+exact response redelivery to its advanced state returns that existing result\n+without creating another directory. Conflicting response IDs and corrupted\n+history/results reject replay. Success (exit 0) can include held work: inspect\n+`response_holds`, the report and queue. Exit 1 means rejection/integrity failure.\n+Full-run `validate-readiness` does not accept this derived layout; built-in\n+verification checks its chain and output consistency, not submission compliance.\n+The receipt-only command remains compatible but its older derived format is\n+not a resumable parent for `continue-repairs`.\n+\n+Connected synthetic examples are in `tests/test_repair_continuation.py`.\n+No actual stakeholder response or new financial closure is demonstrated by them.\n+Native Notion access remains separately blocked.\n+\n ### Missing-receipt continuation (Omega Attempt 2)\n \n `continue-receipt` accepts one supplied employee receipt response against an\ndiff --git a/skills/travel-expense-claim/SKILL.md b/skills/travel-expense-claim/SKILL.md\nindex 3df6657..257d8e6 100644\n--- a/skills/travel-expense-claim/SKILL.md\n+++ b/skills/travel-expense-claim/SKILL.md\n@@ -175,8 +175,8 @@ then run the documented readiness command on the new run.\n Source-driven rechecks may resolve matching repairs with an\n `evidence-revalidated` event. This is not a stakeholder response. A separate\n general repair-response journal uses internal APIs in\n-[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The narrowly scoped\n-`continue-receipt` command below is an exception; `policy-replay` does not import\n+[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The bounded\n+`continue-receipt` and `continue-repairs` commands below expose supported slices; `policy-replay` does not import\n responses automatically:\n \n - `apply_partial_response(queue, response_id=..., item_outcomes=..., run_id=...,\n@@ -202,7 +202,7 @@ responses automatically:\n   conflicting replay is rejected. Unknown item IDs or malformed outcomes reject\n   the call. Changed subject revisions require current evidence: the internal\n   `update_repair_item` API reopens advanced revisions while retaining history.\n-- A developer must retain authentic evidence/assessments, load the queue, apply\n+- For types outside those commands, a developer must retain authentic evidence/assessments, load the queue, apply\n   the API, validate with `validate_partial_response_journal`, and persist a new\n   reviewable result without rewriting historical outputs. Queue resolution alone\n   does not rerun claim/Finance dependencies or regenerate snapshots, reports and\n@@ -241,6 +241,40 @@ native-source run or sealed arrival batch, a general importer, or support for\n chaining derived continuations. Parent evidence must stay available. Verification\n is built into this command; full-run readiness expects the original replay layout.\n \n+### Resumable evidence and returned-work repairs\n+\n+Use `continue-repairs` for current claim supporting-evidence repairs, correction\n+expense-evidence repairs and the evidence requested by a retained reviewer return.\n+It accepts receipts plus settled merchant proof, multiple matched items and\n+successive responses. See the [exact contract and invocation](../../README.md#resumable-evidence-and-returned-work-repairs-omega-attempt-3).\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Retain supplied item-specific assessments and explicit replacement references.\n+Only the verified selected rows enter the active evidence view; superseded rows,\n+invalid bytes and original snapshots remain retained. Valid independent items\n+progress; held items retain reasons. Inspect report, state, queue and unsent drafts\n+even after exit 0. Stale/wrong-employee subjects and integrity failures reject.\n+Exact replay is inert, including redelivery to an advanced result; conflicting\n+response IDs cannot change history. Preserve all ancestor directories.\n+\n+Returned evidence triggers rechecks, never reviewer approval. Finance, policy,\n+budget, exception, decision and independent cancellation imports are unsupported;\n+split/shared expense changes need developer integration. No cash or authorization\n+is changed. This is offline continuation with built-in chain/output checks,\n+not fresh acquisition, an extra native arrival batch or full-run readiness.\n+The older receipt-only result cannot be used as a continuation parent.\n+\n ## Errors, retries, and limitations\n \n - On source failure, retain the attempt URL, locator, UTC observation time, error, and missing scope. Hold only affected work and report its owner and resumption evidence.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 3b1d8bc..63b93b8 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -113,6 +113,13 @@ def build_parser() -> argparse.ArgumentParser:\n     receipt.add_argument('--evidence-dir', type=Path, required=True)\n     receipt.add_argument('--run-id', required=True)\n     receipt.add_argument('--schema', type=Path, default=_default_schema_path())\n+    repairs = commands.add_parser('continue-repairs', help='resume source-bound receipt/merchant and returned evidence repairs in a new derived result')\n+    repairs.add_argument('parent_run', type=Path)\n+    repairs.add_argument('response', type=Path)\n+    repairs.add_argument('output', type=Path)\n+    repairs.add_argument('--evidence-dir', type=Path, required=True)\n+    repairs.add_argument('--run-id', required=True)\n+    repairs.add_argument('--schema', type=Path, default=_default_schema_path())\n     readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n     readiness.add_argument(\"run_dir\", type=Path)\n     readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n@@ -123,6 +130,16 @@ def build_parser() -> argparse.ArgumentParser:\n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == 'continue-repairs':\n+        from .repair_continuation import continue_repairs\n+        try:\n+            result = continue_repairs(args.parent_run, args.response, args.evidence_dir, args.output,\n+                run_id=args.run_id, schema_path=args.schema)\n+        except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:\n+            print(f'Repair continuation rejected: {exc}', file=sys.stderr)\n+            return 1\n+        print(f\"OFFLINE REPAIR CONTINUATION {result['run_id']}: {'unchanged replay' if result['replayed'] else 'derived result verified'}; {result['output']}; human review and financial authority remain required\")\n+        return 0\n     if args.command == 'continue-receipt':\n         from .receipt_continuation import continue_receipt\n         try:\ndiff --git a/src/travel_claim/outputs.py b/src/travel_claim/outputs.py\nindex 6f1f267..c5140ab 100644\n--- a/src/travel_claim/outputs.py\n+++ b/src/travel_claim/outputs.py\n@@ -289,6 +289,7 @@ def apply_partial_response(\n     run_id: str,\n     batch_id: str,\n     evidence_directory: Path | None = None,\n+    admission_errors: dict[str, str] | None = None,\n ) -> None:\n     \"\"\"Record a supplied response against explicitly matched repair item IDs.\n \n@@ -301,6 +302,10 @@ def apply_partial_response(\n         raise ValueError(\"response_id is required\")\n     if not isinstance(item_outcomes, dict):\n         raise ValueError(\"item_outcomes must map repair item IDs to outcomes\")\n+    admission_errors = admission_errors or {}\n+    if (not set(admission_errors) <= set(item_outcomes)\n+            or any(not isinstance(v, str) or not v.strip() for v in admission_errors.values())):\n+        raise ValueError(\"context admission errors must identify response items and reasons\")\n     planned = []\n     for item_id, outcome in item_outcomes.items():\n         if item_id not in queue[\"items\"]:\n@@ -343,6 +348,7 @@ def apply_partial_response(\n                 verify_response_evidence(item, outcome, response_id, evidence_directory)\n             except (ValueError, KeyError, IndexError, TypeError, OSError) as exc:\n                 admission_error = f\"Response evidence held: {exc}\"\n+            admission_error = admission_error or admission_errors.get(item_id)\n         planned.append((item_id, item, kind, normalized_refs, None, admission_error))\n \n     # Mutate only after every item in this partial response passed validation.\ndiff --git a/src/travel_claim/receipt_continuation.py b/src/travel_claim/receipt_continuation.py\nindex 5fa73ee..a026d77 100644\n--- a/src/travel_claim/receipt_continuation.py\n+++ b/src/travel_claim/receipt_continuation.py\n@@ -143,9 +143,17 @@ def _report(state):\n              f\"Response: `{state['response']['response_id']}`. Native policy access: separately retained in parent sources.json.\",\n              'The local revalidation ordinal follows the parent arrivals; it is not an additional supplied arrival batch or a business timestamp.', '',\n              '## Response and revalidation', '']\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        lines[0] = '# Project D repair continuation — OFFLINE DERIVED RESULT'\n+        lines[6] = f\"Response: `{state['response']['response_id']}`. Native acquisition observations: [original sources.json]({state['native_source_manifest_path']}); supplemental replies do not change them.\"\n+        lines += ['Receipt and merchant evidence may resume checks; reviewer returns require current human re-review.', '']\n+        for delivery in state.get('repair_deliveries', []):\n+            lines.append(f\"- Response history `{delivery['response_id']}`: run `{delivery['run_id']}`, batch `{delivery['batch_id']}`; admitted items: {[x['item_id'] for x in delivery['admitted']]}; held items: {delivery['holds']}; source holds: {delivery['source_errors']}\")\n     for item, outcome in state['response']['item_outcomes'].items():\n         entry = state['repair_queue']['items'][item]\n         lines.append(f\"- `{item}`: {outcome['outcome']}; {entry['status']}; note: {outcome.get('note') or ''}; evidence: {outcome.get('source_refs', [])}\")\n+        if item in state.get('response_holds', {}):\n+            lines.append('  - Held: ' + state['response_holds'][item])\n     for cid in state['revalidated_claims']:\n         workflow = state['ordinary_workflows'][cid]\n         lines += [f\"- `{cid}` r{workflow['revision']}: {workflow['status']}; \" + '; '.join(\n@@ -168,9 +176,13 @@ def _report(state):\n     return '\\n'.join(lines)\n \n \n-def verify_continuation(output):\n+def verify_continuation(output, _seen=None):\n     \"\"\"Read-only integrity/consistency check; not submission or business approval.\"\"\"\n     output = Path(output).resolve()\n+    seen = set() if _seen is None else _seen\n+    if output in seen:\n+        raise ValueError('Continuation predecessor cycle')\n+    seen.add(output)\n     binding = read(output / 'continuation.json')\n     for path, sha in binding['output_hashes'].items():\n         if digest(confined(output, path)) != sha:\n@@ -179,13 +191,22 @@ def verify_continuation(output):\n     for path, sha in binding['parent_hashes'].items():\n         if digest(confined(parent, path)) != sha:\n             raise ValueError('Historical parent evidence changed: ' + path)\n+    if (parent / 'continuation.json').exists():\n+        verify_continuation(parent, seen)\n     state = read(output / 'continuation-state.json')\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        current = read(output / 'continuation-input.json').get('repair_continuation', {})\n+        if (current.get('mode') != state['mode'] or current.get('run_id') != state['run_id']\n+                or current.get('evidence_binding') != {'path': 'response-evidence/sources.json',\n+                    'sha256': digest(output / 'response-evidence/sources.json')}):\n+            raise ValueError('Continuation input and supplemental evidence binding disagree')\n     queue = load_repair_queue(output / 'repair-queue.json')\n     if queue != state['repair_queue'] or read(output / 'ordinary-workflow.json')['claims'] != state['ordinary_workflows']:\n         raise ValueError('Continuation queue/workflow/state disagree')\n     if read(output / 'response.json') != state['response']:\n         raise ValueError('Continuation response and state disagree')\n-    historical = read(parent / 'offline-replay-state.json')\n+    historical = read(parent / ('offline-replay-state.json' if (parent / 'offline-replay-state.json').exists()\n+                                else 'continuation-state.json'))\n     for key in ('finance_reconciliations', 'decision_history', 'revision_history', 'cancellation_state',\n                 'source_record_history', 'material_corrections'):\n         if state[key] != historical[key]:\n\"\"\"Bounded, resumable expense-evidence repairs; no decision or cash importer.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime\nfrom decimal import InvalidOperation\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport tempfile\nfrom zipfile import BadZipFile\nfrom xml.etree.ElementTree import ParseError\n\nfrom pypdf.errors import PdfReadError\nfrom openpyxl.utils.exceptions import InvalidFileException\n\nfrom .event_validation import observation_error, utc_time\nfrom .expenses import number, validate_employee_date\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import _sync_ordinary_repairs\nfrom .ordinary import connect_claim, expense_lines, fields, ref, table\nfrom .outputs import (apply_partial_response, validate_partial_response_journal,\n                      verify_response_evidence, project_claim_outputs, write_claims_csv, write_repair_queue)\nfrom .parsing import _pdf_pages, _receipt_records, _workbook_sheets\nfrom .receipt_continuation import (confined, digest, read, write, parent_evidence,\n                                   verify_continuation, _project, _report)\n\nMODE = 'offline-general-repair-continuation'\n\n\ndef load_parent(parent, schema):\n    if (parent / 'offline-replay-state.json').exists():\n        manifest, parsed, state, snapshot, queue, hashes = parent_evidence(parent, schema)\n        state['claims'] = snapshot['claims']\n        state['external_blockers'] = parsed.get('unresolved_issues', [])\n        state['parent_sealed_batches'] = state.pop('sealed_batches')\n        state['parent_parsed_records_path'] = state.pop('parsed_records_path')\n        state['parent_snapshot_hashes'] = {p: h for p, h in hashes.items() if p.startswith('batches/')}\n        return parent, manifest, parsed, state, queue, snapshot['travel_cancellations'], hashes\n    binding = verify_continuation(parent)\n    state = read(parent / 'continuation-state.json')\n    if state['mode'] != MODE:\n        raise ValueError('Resume requires an original replay or continue-repairs result')\n    root = (parent / binding['root_path']).resolve()\n    manifest = read(root / 'sources.json')\n    parsed = read(parent / 'continuation-input.json')\n    hashes = {p: digest(confined(parent, p)) for p in list(binding['output_hashes']) + ['continuation.json']}\n    return root, manifest, parsed, state, state['repair_queue'], state['travel_cancellations'], hashes\n\n\ndef retain_delivery(incoming, staging, prior, clock, response_id):\n    \"\"\"Retain even bad bytes; only freshly parsed, verified pieces are admissible.\"\"\"\n    if prior and (prior / 'response-evidence').exists():\n        shutil.copytree(prior / 'response-evidence', staging)\n        combined = read(staging / 'sources.json')\n        parsed = (read(staging / 'parsed-records.json') if (staging / 'parsed-records.json').exists()\n                  else {'pdf_pages': [], 'workbook_sheets': [], 'records': {'receipts': []}})\n    else:\n        staging.mkdir()\n        combined = {'files': []}\n        parsed = {'pdf_pages': [], 'workbook_sheets': [], 'records': {'receipts': []}}\n    supplied = read(incoming / 'sources.json')\n    rows = supplied.get('files')\n    if (not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows)\n            or any(not isinstance(r.get('source_id'), str) or not r['source_id'] for r in rows)\n            or len({r['source_id'] for r in rows}) != len(rows)):\n        raise ValueError('Delivery requires unique source entries')\n    old_ids = {r['source_id'] for r in combined['files']}\n    if old_ids & {r['source_id'] for r in rows}:\n        raise ValueError('New delivery must use distinct evidence source IDs')\n    prefix = 'delivery-' + hashlib.sha256(response_id.encode()).hexdigest()\n    copied = staging / prefix\n    copied.mkdir()\n    shutil.copyfile(incoming / 'sources.json', copied / 'original-manifest.json')\n    errors, records = {}, {}\n    hashes = {'sources.json': digest(incoming / 'sources.json')}\n    for row in rows:\n        source = confined(incoming, row['path'])\n        target = confined(copied, row['path'])\n        if row['path'] in {'original-manifest.json', 'sources.json', 'parsed-records.json'} or target.exists():\n            raise ValueError('Conflicting evidence path')\n        target.parent.mkdir(parents=True, exist_ok=True)\n        retained = dict(row, path=target.relative_to(staging).as_posix())\n        combined['files'].append(retained)\n        if not source.is_file():\n            hashes[row['path']] = None\n            errors[row['source_id']] = 'Missing retained evidence bytes'\n            continue\n        shutil.copyfile(source, target)\n        hashes[row['path']] = digest(target)\n        try:\n            if (row.get('status') != 'read' or row.get('missing_scope') != [] or row.get('error') is not None\n                    or not isinstance(row.get('version'), str) or not row['version'].strip()\n                    or hashes[row['path']] != row.get('sha256')):\n                raise ValueError('Incomplete, unobserved or hash-mismatched evidence')\n            observed = datetime.fromisoformat(str(row.get('observed_at')).replace('Z', '+00:00'))\n            if observed.utcoffset() is None:\n                raise ValueError('Evidence observation requires timezone')\n            error = observation_error(utc_time(row['observed_at']), clock)\n            if error:\n                raise ValueError(error)\n            if source.suffix == '.pdf':\n                pages = _pdf_pages(target, row['source_id'], row['sha256'])\n                rs = _receipt_records(pages)\n                if not rs or any(not p['text'].strip() for p in pages):\n                    raise ValueError('Receipt PDF is empty or incomplete')\n                parsed['pdf_pages'].extend(pages)\n                parsed['records']['receipts'].extend(rs)\n                records.update({ref(r): ('receipt', r) for r in rs})\n            elif source.suffix == '.xlsx':\n                sheets = _workbook_sheets(target, row['source_id'], row['sha256'])\n                if len(sheets) != 1 or sheets[0]['name'] != 'Merchant payments' or not sheets[0]['records']:\n                    raise ValueError('Only a nonempty Merchant payments tab is supported')\n                parsed['workbook_sheets'].extend(sheets)\n                records.update({ref(r): ('merchant-payment', r) for r in sheets[0]['records']})\n            elif source.suffix == '.json':\n                read(target)  # Retained assessment, never a trusted parsed-row substitute.\n            else:\n                raise ValueError('Only receipt PDF, merchant XLSX and assessment JSON are supported')\n        except (ValueError, TypeError, KeyError, OSError, BadZipFile, ParseError, PdfReadError, InvalidFileException) as exc:\n            errors[row['source_id']] = str(exc)\n    (staging / 'sources.json').write_text(json.dumps(combined, indent=2) + '\\n')\n    parsed['source_manifest'] = {'path': 'sources.json', 'sha256': digest(staging / 'sources.json')}\n    (staging / 'parsed-records.json').write_text(json.dumps(parsed, indent=2) + '\\n')\n    return combined, records, errors, hashes\n\n\ndef match_item(key, item, state, actor):\n    if not item or item['subject_type'] != 'claim':\n        raise ValueError('Unknown or non-claim repair item')\n    cid, revision = item['subject_id'], item['revision']\n    workflow = state['ordinary_workflows'].get(cid, {})\n    if item['status'] != 'open' or workflow.get('revision') != revision:\n        raise ValueError('Stale or non-open repair item/revision')\n    claim = next(r for r in state['revision_history']['claim'][cid]['revisions'] if r['revision'] == revision)\n    if actor != fields(claim['record']).get('Employee'):\n        raise ValueError('Response actor must match the claim employee')\n    return cid, claim\n\n\ndef return_context(state, key, cid, revision):\n    decision_id = key.split(':review_return:', 1)[1]\n    workflows = [state['ordinary_workflows'][cid]] + [x['workflow'] for x in state['ordinary_workflow_history']\n                    if x['workflow']['claim_id'] == cid and x['workflow']['revision'] == revision]\n    replies = {ref(d['raw_record']): d for wf in workflows for d in wf['observed_reviews']\n               if d['decision_id'] == decision_id and d['outcome'] == 'return' and d['evidence_valid']}\n    if len(replies) != 1:\n        raise ValueError('Return has no unique admitted historical reviewer authority')\n    return next(iter(replies.values()))\n\n\ndef admit_records(parsed, state, claim, outcome, records, assessment):\n    \"\"\"Use existing native schemas and exact, assessment-bound replacement intent.\"\"\"\n    repairs = outcome.get('repairs')\n    if not isinstance(repairs, list) or not repairs or assessment.get('repairs') != repairs:\n        raise ValueError('Assessment must bind the exact repair operations')\n    if outcome.get('source_refs') != list(dict.fromkeys(r.get('record_ref') for r in repairs)):\n        raise ValueError('Response references must exactly identify supplied repair rows')\n    cid = fields(claim['record'])['Claim reference']\n    employee = fields(claim['record'])['Employee']\n    trip = fields(claim['record'])['Trip reference']\n    changed = []\n    for repair in repairs:\n        kind, record = records.get(repair.get('record_ref'), (None, None))\n        if kind != repair.get('kind') or kind not in {'receipt', 'merchant-payment'}:\n            raise ValueError('Unsupported or unverified repair record')\n        values = fields(record)\n        cost = values.get('Expense reference')\n        lines = [l for l in expense_lines(claim['record']) if l['cost_id'] == cost]\n        if len(lines) != 1:\n            raise ValueError('Evidence must match an exact current expense')\n        line = lines[0]\n        for other, wf in state['ordinary_workflows'].items():\n            if other != cid and any(l['cost_id'] == cost or l.get('receipt_id') == line['receipt_id'] for l in wf['lines']):\n                raise ValueError('Shared expense/receipt requires broader dependency reconciliation')\n        if (values.get('Employee' if kind == 'receipt' else 'Employee ID') != employee\n                or values.get('Trip reference') != trip or values.get('Receipt reference') != line['receipt_id']\n                or values.get('Currency') != line['currency']\n                or number(values.get('Gross amount')) <= 0\n                or number(values.get('Gross amount')) != number(line['original_amount'])):\n            raise ValueError('Evidence employee/trip/cost/receipt/currency/gross mismatch')\n        if kind == 'receipt':\n            bucket = parsed['records']['receipts']\n            identity, identity_value = 'Receipt reference', line['receipt_id']\n        else:\n            if values.get('Payment status') != 'settled' or not values.get('Transaction reference'):\n                raise ValueError('Merchant proof requires an identified settled transaction')\n            validate_employee_date(values.get('Paid date'), 'Employee payment date', parsed,\n                                   {'employee_date_checks': [], 'source_refs': []}, [ref(record)])\n            # Materialized active view, with every superseded row retained below.\n            if 'merchant_payments' not in parsed['records']:\n                parsed['records']['merchant_payments'] = deepcopy(table(parsed, 'merchant_payments', 'Merchant payments'))\n            bucket = parsed['records']['merchant_payments']\n            identity, identity_value = 'Expense reference', cost\n            for old in bucket:\n                if fields(old).get('Transaction reference') == values['Transaction reference'] and fields(old).get('Expense reference') != cost:\n                    raise ValueError('Merchant transaction identity already belongs to a different expense')\n        existing = [r for r in bucket if fields(r).get(identity) == identity_value]\n        supersedes = repair.get('supersedes_refs', [])\n        if (not isinstance(supersedes, list) or len(set(supersedes)) != len(supersedes)\n                or set(supersedes) != {ref(r) for r in existing}):\n            raise ValueError('Replacement must explicitly name every superseded current row')\n        if any(ref(r) == ref(record) for r in existing):\n            raise ValueError('Evidence is already current; no repair performed')\n        bucket[:] = [r for r in bucket if r not in existing] + [deepcopy(record)]\n        changed.append(dict(kind=kind, current=deepcopy(record), superseded=deepcopy(existing)))\n    return changed\n\n\ndef continue_repairs(parent_run, response_file, evidence_dir, output, *, run_id, schema_path):\n    parent, response_file, incoming, output = [Path(p).resolve() for p in (parent_run, response_file, evidence_dir, output)]\n    if (not run_id or output.name != run_id or any(output == p or output.is_relative_to(p) for p in (parent, incoming))\n            or response_file.is_relative_to(output)):\n        raise ValueError('Use a distinct, new output directory named for the run ID')\n    root, manifest, parsed, state, queue, cancellations, hashes = load_parent(parent, schema_path)\n    if run_id in {state['run_id'], manifest['run_id']}:\n        raise ValueError('Continuation requires a new run ID')\n    response = read(response_file)\n    if (response.get('response_version') != 'repair-response/1' or not isinstance(response.get('response_id'), str)\n            or not response['response_id'].strip() or not isinstance(response.get('item_outcomes'), dict)\n            or not response['item_outcomes']):\n        raise ValueError('Invalid repair response envelope')\n    outcomes = response['item_outcomes']\n    response_id = response['response_id']\n    delivery = {'response': digest(response_file), 'manifest': digest(incoming / 'sources.json'),\n                'files': {r['path']: (digest(confined(incoming, r['path'])) if confined(incoming, r['path']).is_file() else None)\n                          for r in read(incoming / 'sources.json')['files']}}\n    fingerprint = hashlib.sha256(json.dumps(dict(parent=hashes, delivery=delivery, run_id=run_id), sort_keys=True).encode()).hexdigest()\n    if output.exists():\n        existing = verify_continuation(output)\n        if existing['input_sha256'] != fingerprint:\n            raise ValueError('Conflicting replay; result is immutable')\n        return dict(run_id=run_id, output=output, replayed=True)\n    for prior in state.get('repair_deliveries', []):\n        if prior['response_id'] == response_id:\n            if prior['delivery'] != delivery:\n                raise ValueError('Conflicting response ID replay')\n            return dict(run_id=state['run_id'], output=parent, replayed=True)\n    if run_id in {d['run_id'] for d in state.get('repair_deliveries', [])}:\n        raise ValueError('Run ID already belongs to an earlier continuation')\n    matches = {key: match_item(key, queue['items'].get(key), state, response.get('actor_id')) for key in outcomes}\n    batch = 'repair-response:' + response_id\n    ordinal = state.get('evaluation_boundary', {}).get('local_ordinal', max(parsed['arrival_batches'])) + 1\n    with tempfile.TemporaryDirectory(prefix='project-d-repairs-') as temp:\n        evidence = Path(temp) / 'response-evidence'\n        prior_evidence = parent if (parent / 'response-evidence').exists() else None\n        combined, records, source_errors, _ = retain_delivery(incoming, evidence, prior_evidence,\n            parsed.get('event_clock') or parsed.get('case_clock'), response_id)\n        if {r['source_id'] for r in combined['files']} & {r['source_id'] for r in manifest['files']}:\n            raise ValueError('Supplemental source IDs cannot replace native evidence')\n        observations = manifest['files'] + combined['files']\n        holds, admitted, affected = {}, [], set()\n        for key, outcome in outcomes.items():\n            if not isinstance(outcome, dict):\n                raise ValueError('Outcome must be an object')\n            if outcome.get('outcome') != 'supported':\n                continue\n            cid, claim = matches[key]\n            item = queue['items'][key]\n            try:\n                allowed = {f'ordinary:{cid}:r{claim[\"revision\"]}:supporting_evidence',\n                           f'correction:{cid}:r{claim[\"revision\"]}:expense-evidence'}\n                returned = key.startswith(f'ordinary:{cid}:r{claim[\"revision\"]}:review_return:')\n                if key not in allowed and not returned:\n                    raise ValueError('Repair type needs an unsupported authority/import adapter')\n                wf = state['ordinary_workflows'][cid]\n                if wf['status'] != 'pending' or wf['request'] or state['finance_reconciliations'][cid]['authorized_obligation']:\n                    raise ValueError('Only pending, currently unauthorized claims are supported')\n                assessment = verify_response_evidence(item, outcome, response_id, evidence)\n                refs = outcome['source_refs'] + [outcome['assessment_ref']]\n                for source_ref in refs:\n                    sid = source_ref.split('@', 1)[0]\n                    if sid in source_errors:\n                        raise ValueError(source_errors[sid])\n                if assessment.get('actor_id') != response.get('actor_id'):\n                    raise ValueError('Assessment must bind the response actor')\n                if returned:\n                    returned_reply = return_context(state, key, cid, claim['revision'])\n                    if (assessment.get('return_decision_ref') != ref(returned_reply['raw_record'])\n                            or assessment.get('repair_requested') != returned_reply['repair_requested']):\n                        raise ValueError('Returned work must bind its exact retained decision and repair request')\n                candidate = deepcopy(parsed)\n                changes = admit_records(candidate, state, claim, outcome, records, assessment)\n                parsed = candidate\n                admitted.append(dict(item_id=key, changes=changes))\n                affected.add(cid)\n            except (ValueError, TypeError, KeyError, IndexError, OSError, InvalidOperation) as exc:\n                holds[key] = 'Response evidence held: ' + str(exc)\n        for cid in sorted(affected):\n            claim = matches[next(k for k, v in matches.items() if v[0] == cid)][1]\n            before = state['finance_reconciliations'][cid]\n            wf = connect_claim(parsed=parsed, claim=claim, decisions=state['source_record_history']['decisions'],\n                finance_events=state['source_record_history']['finance_events'], finance=deepcopy(before),\n                cancellations=cancellations, arrival_batch=ordinal, source_observations=observations,\n                prior_finance=before, prior_workflow=state['ordinary_workflows'][cid],\n                budget_data=state['budget_reconciliation'], prepaid_data=state['budget_reconciliation']['cost_attribution'],\n                prior_budget_view=state['budget_reconciliation']['claim_views'][cid])\n            if wf.pop('finance') != before or wf['request'] is not None or wf['status'] != 'pending':\n                raise ValueError('Evidence continuation must not authorize reimbursement or change financial history')\n            # Evidence does not supply the current reviewer response. Retain\n            # returned work after its old packet becomes historical authority.\n            for key, item in queue['items'].items():\n                if item['status'] != 'open' or not key.startswith(f'ordinary:{cid}:r{claim[\"revision\"]}:review_return:'):\n                    continue\n                reply = return_context(state, key, cid, claim['revision'])\n                name = key.split(f'ordinary:{cid}:r{claim[\"revision\"]}:', 1)[1]\n                review_stage = next((s for s in wf['stages'] if s['stage'] == name), None)\n                if review_stage is None:\n                    review_stage = {'stage': name}\n                    wf['stages'].append(review_stage)\n                review_stage.update(status='BLOCKED', source_refs=reply['source_refs'],\n                    detail='Returned evidence rechecked; a current human reviewer response is still required: ' + reply['repair_requested'],\n                    owner=fields(reply['raw_record'])['Reviewer'], next_action='Obtain current source-bound reviewer response to the repaired evidence; no approval is inferred')\n            state['ordinary_workflows'][cid] = wf\n            state['ordinary_workflow_history'].append(dict(batch_id=batch, workflow=deepcopy(wf)))\n            state['budget_reconciliation']['claim_views'][cid] = deepcopy(wf['budget_view'])\n            _project(next(c for c in state['claims'] if c['claim_id'] == cid), wf, before)\n        apply_partial_response(queue, response_id=response_id, item_outcomes=outcomes, run_id=run_id,\n            batch_id=batch, evidence_directory=evidence, admission_errors=holds)\n        _sync_ordinary_repairs(dict(repair_queue=queue,\n            ordinary_workflows={cid: state['ordinary_workflows'][cid] for cid in affected},\n            finance_reconciliations={cid: state['finance_reconciliations'][cid] for cid in affected}), run_id=run_id, batch_id=batch)\n        validate_partial_response_journal(queue, evidence)\n        state.setdefault('repair_deliveries', []).append(dict(response_id=response_id, delivery=delivery,\n            run_id=run_id, batch_id=batch, admitted=admitted, holds=holds, source_errors=source_errors))\n        state.update(mode=MODE, run_id=run_id, parent_run_id=read(parent / ('sources.json' if parent == root else 'continuation-state.json'))['run_id'],\n            response=response, response_holds=holds, repair_queue=queue, revalidated_claims=sorted(affected),\n            parent_run_path=os.path.relpath(parent, output),\n            native_source_manifest_path=os.path.relpath(root / 'sources.json', output),\n            travel_cancellations=cancellations, evaluation_boundary=dict(kind='repair-response', response_id=response_id,\n                local_ordinal=ordinal, native_arrival_batch=None))\n        parsed['repair_continuation'] = dict(mode=MODE, run_id=run_id,\n            native_parent_path=os.path.relpath(root, output),\n            evidence_binding={'path': 'response-evidence/sources.json', 'sha256': digest(evidence / 'sources.json')})\n        output.parent.mkdir(parents=True, exist_ok=True)\n        output.mkdir(exist_ok=False)\n        shutil.copytree(evidence, output / 'response-evidence')\n        shutil.copyfile(response_file, output / 'response.json')\n        write(output / 'continuation-state.json', state)\n        write(output / 'continuation-input.json', parsed)\n        write_repair_queue(queue, output / 'repair-queue.json')\n        write_claims_csv(project_claim_outputs(state['claims'], queue), output / 'claims.csv')\n        write(output / 'ordinary-workflow.json', dict(mode=MODE, run_id=run_id, claims=state['ordinary_workflows']))\n        drafts, _ = render_follow_up_drafts(run_id=run_id, queue=queue, blockers=state['external_blockers'])\n        (output / 'follow-up-drafts.md').write_text(drafts, encoding='utf-8')\n        (output / 'report.md').write_text(_report(state), encoding='utf-8')\n        outputs = {p.relative_to(output).as_posix(): digest(p) for p in output.rglob('*') if p.is_file()}\n        write(output / 'continuation.json', dict(version='repair-continuation/1', run_id=run_id,\n            input_sha256=fingerprint, parent_path=os.path.relpath(parent, output), root_path=os.path.relpath(root, output),\n            parent_hashes=hashes, output_hashes=outputs, fresh_native_reads_performed=False))\n        verify_continuation(output)\n    return dict(run_id=run_id, output=output, replayed=False)\n\"\"\"End-to-end synthetic employee evidence; no real responses or authority.\"\"\"\nfrom copy import deepcopy\nimport csv\nimport io\nimport json\nfrom pathlib import Path\n\nfrom openpyxl import Workbook, load_workbook\nimport pytest\n\nfrom test_receipt_continuation import base_run, pdf, receipt, sha, hashes, SCHEMA, POLICY\nfrom travel_claim.cli import main\nfrom travel_claim.ordinary import fields, ref\nfrom travel_claim.parsing import parse_retained_run, _workbook_sheets, _pdf_pages, _receipt_records\nfrom travel_claim.policy_evidence import create_policy_replay\nfrom travel_claim.receipt_continuation import verify_continuation\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\ndef get(path):\n    return json.loads(path.read_text())\n\n\ndef save(path, data):\n    path.write_text(json.dumps(data, indent=2))\n\n\ndef parent(tmp_path, *, missing_merchants=('A',), returned=False, corrected=False):\n    seed = tmp_path / 'seed'; seed.mkdir()\n    first = base_run(seed)\n    workbook = load_workbook(first / 'sources/travel-registers-workbook.xlsx')\n    tab = workbook['Merchant payments']\n    for row in reversed(range(3, tab.max_row + 1)):\n        if tab.cell(row, 2).value in {'COST-' + c for c in missing_merchants}:\n            tab.delete_rows(row)\n    if returned:\n        original = get(first / 'parsed-records.json')\n        sample = get(Path(__file__).parent / 'fixtures/ordinary_claim_c01.json')\n        packet = {k: v['value'] for k, v in next(s for s in sample['workbook_sheets'] if s['name']=='Review packets')['records'][0]['values'].items()}\n        packet.update({'Decision reference':'SYN-RETURN-A', 'Trip reference':'T-A', 'Expense references':'COST-A'})\n        decision = {k:v['value'] for k,v in sample['records']['decisions'][0]['values'].items()}\n        decision.update({'Decision reference':'SYN-RETURN-A','Subject reference':'SYN-A', 'Outcome':'return',\n                         'Repair requested':'Supply receipt and settled merchant proof for COST-A',\n                         'Source revisions':'POL-2026.2\\n'+sha(first/'sources/initial-claim-binder.pdf')})\n        for name, row in [('Review packets',packet),('Review ledger',decision)]:\n            sheet=workbook[name];sheet.delete_rows(1,sheet.max_row)\n            sheet.append(list(row));sheet.append(list(row.values()))\n    buffer=io.BytesIO();workbook.save(buffer)\n    bodies={s.source_id: (first/next(r['path'] for r in get(first/'sources.json')['files']\n                                   if r['source_id']==s.source_id)).read_bytes()\n            for s in SOURCES if s.source_id!='policy-pol-2026-2'}\n    bodies.update({'policy-pol-2026-2':b'SYNTHETIC generic Notion shell', 'travel-registers-workbook':buffer.getvalue()})\n    if corrected:\n        from travel_claim.parsing import _pdf_pages\n        original_page=_pdf_pages(first/'sources/initial-claim-binder.pdf','synthetic','synthetic')[0]['text']\n        bodies['claim-updates-binder']=pdf([original_page.replace('Revision: 1','Revision: 2').replace('Arrival batch: 1','Arrival batch: 3')])\n    def fetch(url, timeout):\n        s=next(s for s in SOURCES if (s.export_url or s.url)==url)\n        return bodies[s.source_id],{},url\n    source=tmp_path/'source'\n    capture_sources(source,run_id='source',case_clock=None,fetch=fetch,observed_at=lambda:'2026-10-01T12:00:00Z')\n    parse_retained_run(source)\n    result=tmp_path/'parent'\n    create_policy_replay(source,result,run_id='parent',browser_policy=POLICY,schema_path=SCHEMA)\n    return result\n\n\ndef bundle(tmp_path, parent_path, *, name='one', specs=None, insufficient=()):\n    \"\"\"spec = (claim suffix, item, kind, superseded refs).\"\"\"\n    incoming=tmp_path/('incoming-'+name);incoming.mkdir()\n    rows=[];outcomes={};assessments={}\n    specs=specs or [('A','ordinary:SYN-A:r1:supporting_evidence','receipt',[])]\n    for index,(cid,item,kind,supersedes) in enumerate(specs):\n        sid=f'SYN-{name}-{index}';path=incoming/(sid+('.pdf' if kind=='receipt' else '.xlsx'))\n        if kind=='receipt':\n            path.write_bytes(pdf([receipt(cid)]));record=_receipt_records(_pdf_pages(path,sid,sha(path)))[0]\n        else:\n            workbook=Workbook();sheet=workbook.active;sheet.title='Merchant payments'\n            value={'Transaction reference':'SYN-M-'+cid,'Expense reference':'COST-'+cid,'Employee ID':'EMP-01',\n                   'Trip reference':'T-'+cid,'Currency':'EUR','Gross amount':'100.00','Paid date':'2026-09-01',\n                   'Payment status':'settled','Receipt reference':'R-COST-'+cid}\n            sheet.append(list(value));sheet.append(list(value.values()));workbook.save(path)\n            record=_workbook_sheets(path,sid,sha(path))[0]['records'][0]\n        rows.append(dict(source_id=sid,path=path.name,sha256=sha(path),status='read',error=None,missing_scope=[],\n                         version=sha(path),observed_at='2026-10-02T12:00:00Z'))\n        outcome=outcomes.setdefault(item,dict(outcome='supported',note='SYNTHETIC response for '+item,source_refs=[],repairs=[]))\n        outcome['source_refs'].append(ref(record));outcome['repairs'].append(dict(kind=kind,record_ref=ref(record),supersedes_refs=supersedes))\n    for index,(item,outcome) in enumerate(outcomes.items()):\n        cid=item.split(':')[1]\n        revision=int(item.split(':')[2][1:])\n        assessments[str(index)]=dict(item_id=item,subject_type='claim',subject_id=cid,revision=revision,response_id='SYN-'+name,\n            actor_id='EMP-01',sufficient=True,reason='SYNTHETIC supplied evidence for exact expense',\n            provenance='SYNTHETIC employee response',evidence_refs=outcome['source_refs'],repairs=outcome['repairs'])\n        if ':review_return:' in item:\n            state=get(parent_path/('offline-replay-state.json' if (parent_path/'offline-replay-state.json').exists() else 'continuation-state.json'))\n            from travel_claim.repair_continuation import return_context\n            decision=return_context(state,item,cid,revision)\n            assessments[str(index)].update(return_decision_ref=ref(decision['raw_record']),repair_requested=decision['repair_requested'])\n    proof=incoming/'assessment.json';save(proof,assessments)\n    proof_id='SYN-assess-'+name\n    rows.append(dict(source_id=proof_id,path=proof.name,sha256=sha(proof),status='read',error=None,missing_scope=[],\n                     version=sha(proof),observed_at='2026-10-02T12:00:00Z'))\n    for index,outcome in enumerate(outcomes.values()):outcome['assessment_ref']=f'{proof_id}@{sha(proof)}#/{index}'\n    for item in insufficient:outcomes[item]=dict(outcome='insufficient',note='SYNTHETIC still missing',source_refs=[])\n    save(incoming/'sources.json',dict(files=rows))\n    response=tmp_path/('response-'+name+'.json')\n    save(response,dict(response_version='repair-response/1',response_id='SYN-'+name,actor_id='EMP-01',item_outcomes=outcomes))\n    return response,incoming\n\n\ndef run(parent_path, response, evidence, output):\n    return main(['continue-repairs',str(parent_path),str(response),str(output),'--evidence-dir',str(evidence),'--run-id',output.name])\n\n\ndef stage(state,cid,name):\n    return next(s for s in state['ordinary_workflows'][cid]['stages'] if s['stage']==name)['status']\n\n\ndef test_multiple_evidence_types_partial_response_and_repeated_resumption(tmp_path):\n    p=parent(tmp_path);before=hashes(p);old=get(p/'offline-replay-state.json')\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,insufficient=[b]);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    first=get(one/'continuation-state.json')\n    assert stage(first,'SYN-A','supporting_evidence')=='BLOCKED'  # Receipt alone cannot prove payment.\n    assert first['repair_queue']['items'][a]['status']=='open'\n    assert first['repair_queue']['items'][b]['status']=='open'\n    second_response,second_evidence=bundle(tmp_path,one,name='two',specs=[('A',a,'merchant-payment',[])],insufficient=[b])\n    two=tmp_path/'two';assert run(one,second_response,second_evidence,two)==0\n    final=get(two/'continuation-state.json');verify_continuation(two)\n    assert stage(final,'SYN-A','supporting_evidence')=='PASS'\n    assert final['repair_queue']['items'][a]['status']=='resolved'\n    assert final['repair_queue']['items'][b]['status']=='open'\n    assert final['ordinary_workflows']['SYN-B']==old['ordinary_workflows']['SYN-B']\n    assert final['ordinary_workflows']['SYN-C']==old['ordinary_workflows']['SYN-C']\n    assert final['finance_reconciliations']==old['finance_reconciliations']\n    assert final['decision_history']==old['decision_history']\n    assert final['revision_history']==old['revision_history']\n    assert final['cancellation_state']==old['cancellation_state']\n    assert final['budget_reconciliation']['scopes']==old['budget_reconciliation']['scopes']\n    assert final['budget_history']==old['budget_history']\n    assert final['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert final['ordinary_workflows']['SYN-A']['request'] is None\n    assert all(not w['status'].startswith('closed-') for w in final['ordinary_workflows'].values())\n    drafts=(two/'follow-up-drafts.md').read_text();assert f'Item `{a}`' not in drafts and f'Item `{b}`' in drafts\n    assert 'supporting_evidence=PASS' in (two/'report.md').read_text()\n    assert (two/final['native_source_manifest_path']).resolve()==(p/'sources.json').resolve()\n    row=next(r for r in csv.DictReader((two/'claims.csv').open()) if r['claim_id']=='SYN-A')\n    assert row['status']=='pending' and row['paid_cents']=='10000' and row['balance_cents']==''\n    assert row['revision']=='1' and row['trip_id']=='T-A'\n    assert row['allowed_cents']==str(final['ordinary_workflows']['SYN-A']['allowed_cents'])\n    unchanged=hashes(two);assert run(one,second_response,second_evidence,two)==0 and hashes(two)==unchanged\n    # Same response redelivered against the advanced state creates no new effect/result.\n    assert run(two,second_response,second_evidence,tmp_path/'retry')==0\n    assert not (tmp_path/'retry').exists() and hashes(two)==unchanged\n    another,another_evidence=bundle(tmp_path,two,name='three',specs=[('B',b,'receipt',[])])\n    assert run(two,another,another_evidence,tmp_path/'reuse'/'one')==1\n    assert not (tmp_path/'reuse').exists()\n    assert hashes(p)==before and len(list((p/'batches').glob('*.json')))==4\n    for key,item in old['repair_queue']['items'].items():\n        if item['subject_id'] not in {'SYN-A','SYN-B'}:assert final['repair_queue']['items'][key]==item\n\n\ndef test_valid_item_progresses_while_other_invalid_evidence_is_held(tmp_path):\n    p=parent(tmp_path,missing_merchants=())\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',a,'receipt',[]),('B',b,'receipt',[])])\n    bad=evidence/'SYN-one-1.pdf';bad.write_bytes(bad.read_bytes()+b'tampered')\n    out=tmp_path/'mixed';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json');q=state['repair_queue']\n    assert q['items'][a]['status']=='resolved' and q['items'][b]['status']=='open'\n    event=next(e for e in q['events'] if e.get('item_id')==b and e['event']=='response-recorded')\n    assert event['admission_status']=='held' and 'hash' in event['admission_reason']\n    assert (out/'response-evidence'/next(r['path'] for r in get(out/'response-evidence/sources.json')['files'] if r['source_id']=='SYN-one-1')).read_bytes()==bad.read_bytes()\n    verify_continuation(out)\n\n\n@pytest.mark.parametrize('fault',['stale','wrong-actor','wrong-hash','missing-file','wrong-revision-assessment','wrong-operation','unknown-ref','future','wrong-gross','invalid-number','unsupported'])\ndef test_negative_deliveries_never_resolve_or_authorize(tmp_path,fault):\n    p=parent(tmp_path);before=hashes(p);response,evidence=bundle(tmp_path,p)\n    obj=get(response);key=next(iter(obj['item_outcomes']))\n    if fault=='stale':obj['item_outcomes'][key.replace(':r1:',':r2:')]=obj['item_outcomes'].pop(key)\n    elif fault=='wrong-actor':obj['actor_id']='UNAUTHORIZED'\n    elif fault=='wrong-hash':(evidence/'SYN-one-0.pdf').write_bytes(b'tampered')\n    elif fault=='missing-file':(evidence/'SYN-one-0.pdf').unlink()\n    elif fault=='unknown-ref':obj['item_outcomes'][key]['source_refs']=['missing@'+'0'*64+'#row 1']\n    elif fault=='unsupported':obj['item_outcomes']['ordinary:SYN-A:r1:required_approvals']=obj['item_outcomes'].pop(key)\n    elif fault=='future':\n        manifest=get(evidence/'sources.json');manifest['files'][0]['observed_at']='2026-11-16T12:00:00Z';save(evidence/'sources.json',manifest)\n    else:\n        proof=get(evidence/'assessment.json')\n        if fault=='wrong-revision-assessment':proof['0']['revision']=2\n        elif fault=='wrong-operation':proof['0']['repairs'][0]['kind']='approval'\n        else:\n            # A real, hash-bound PDF with mismatched gross is not sufficient either.\n            path=evidence/'SYN-one-0.pdf';path.write_bytes(pdf([receipt(amount='invalid' if fault=='invalid-number' else '99.00')]))\n            rr=f'SYN-one-0@{sha(path)}#PDF page 1, receipt 1'\n            obj['item_outcomes'][key]['source_refs']=[rr];obj['item_outcomes'][key]['repairs'][0]['record_ref']=rr\n            proof['0']['evidence_refs']=[rr];proof['0']['repairs'][0]['record_ref']=rr\n        save(evidence/'assessment.json',proof);manifest=get(evidence/'sources.json')\n        for row in manifest['files']:row['sha256']=sha(evidence/row['path'])\n        save(evidence/'sources.json',manifest);obj['item_outcomes'][key]['assessment_ref']=f'SYN-assess-one@{sha(evidence/\"assessment.json\")}#/0'\n    save(response,obj);out=tmp_path/'negative'\n    rc=run(p,response,evidence,out)\n    if fault in {'stale','wrong-actor'}:assert rc==1 and not out.exists()\n    else:\n        assert rc==0\n        state=get(out/'continuation-state.json');assert state['response_holds']\n        assert all(i['status']=='open' for k,i in state['repair_queue']['items'].items() if k in obj['item_outcomes'])\n        assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    assert hashes(p)==before\n\n\ndef test_returned_work_receives_evidence_but_requires_human_re_review(tmp_path):\n    p=parent(tmp_path,returned=True)\n    old=get(p/'offline-replay-state.json');wf=old['ordinary_workflows']['SYN-A']\n    item='ordinary:SYN-A:r1:review_return:SYN-RETURN-A'\n    assert item in old['repair_queue']['items'] and old['repair_queue']['items'][item]['status']=='open'\n    response,evidence=bundle(tmp_path,p,specs=[('A',item,'receipt',[])])\n    partial=tmp_path/'returned-partial';assert run(p,response,evidence,partial)==0\n    assert get(partial/'continuation-state.json')['repair_queue']['items'][item]['status']=='open'\n    response2,evidence2=bundle(tmp_path,partial,name='returned-two',specs=[('A',item,'merchant-payment',[])])\n    out=tmp_path/'returned';assert run(partial,response2,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    assert stage(state,'SYN-A','required_approvals')=='BLOCKED'\n    assert state['repair_queue']['items'][item]['status']=='open'\n    assert state['repair_queue']['items'][item]['owner']=='ADMIN-01'\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['decision_history']==old['decision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n    assert 'human re-review' in (out/'report.md').read_text()\n\n\ndef test_original_evidence_and_derived_result_tampering_are_detected(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    (one/'claims.csv').write_text('tampered')\n    assert run(p,response,evidence,one)==1\n\n\ndef test_explicit_replacement_preserves_old_rows_and_conflicting_replay_is_rejected(tmp_path):\n    # Explicitly replace merchant proof, without changing any Finance event.\n    p=parent(tmp_path,missing_merchants=())\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    parsed=get(p/'parsed-records.json')\n    old_payment=next(r for s in parsed['workbook_sheets'] if s['name']=='Merchant payments'\n                     for r in s['records'] if fields(r).get('Expense reference')=='COST-A')\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',[]),('A',key,'merchant-payment',[ref(old_payment)])])\n    out=tmp_path/'replaced';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    changed=state['repair_deliveries'][0]['admitted'][0]['changes']\n    assert changed[1]['superseded']==[old_payment]\n    assert ref(old_payment) in get(response)['item_outcomes'][key]['repairs'][1]['supersedes_refs']\n    assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    before=hashes(out);obj=get(response);obj['item_outcomes'][key]['note']='conflicting replay';save(response,obj)\n    assert run(out,response,evidence,tmp_path/'conflict')==1 and hashes(out)==before\n\n\ndef test_unknown_supersession_is_held_and_unmatched_work_is_untouched(tmp_path):\n    p=parent(tmp_path)\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',['invented-ref'])])\n    out=tmp_path/'bad-replacement';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert 'superseded' in state['response_holds'][key]\n    assert not state['revalidated_claims']\n    assert state['ordinary_workflows']==get(p/'offline-replay-state.json')['ordinary_workflows']\n\n\ndef test_descendant_checks_original_ancestor_and_response_evidence(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response2,evidence2=bundle(tmp_path,one,name='two',specs=[('A',key,'merchant-payment',[])])\n    two=tmp_path/'two';assert run(one,response2,evidence2,two)==0\n    original=p/'sources/receipt-binder.pdf';original.write_bytes(original.read_bytes()+b'tampered')\n    with pytest.raises(ValueError,match='parent evidence changed'):\n        verify_continuation(two)\n\n\ndef test_current_corrected_revision_resumes_but_old_revision_response_is_rejected(tmp_path):\n    p=parent(tmp_path,corrected=True)\n    old=get(p/'offline-replay-state.json');assert old['ordinary_workflows']['SYN-A']['revision']==2\n    stale,evidence=bundle(tmp_path,p)\n    assert run(p,stale,evidence,tmp_path/'stale')==1\n    item='correction:SYN-A:r2:expense-evidence'\n    assert old['repair_queue']['items'][item]['status']=='open'\n    response,evidence2=bundle(tmp_path,p,name='current',specs=[('A',item,'receipt',[]),('A',item,'merchant-payment',[])])\n    out=tmp_path/'corrected';assert run(p,response,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert state['repair_queue']['items'][item]['status']=='resolved'\n    assert state['ordinary_workflows']['SYN-A']['revision']==2\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['revision_history']==old['revision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n","stderr":"","aggregated_output":"diff --git a/README.md b/README.md\nindex 8b93657..a32599f 100644\n--- a/README.md\n+++ b/README.md\n@@ -73,6 +73,78 @@ The owner-grouped repair queue API is in `travel_claim.outputs`. Queue items ret\n \n ## Verification\n \n+### Resumable evidence and returned-work repairs (Omega Attempt 3)\n+\n+From a restored offline replay, use a fresh result directory:\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+# A later authentic response can resume that result, retaining the full chain:\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Supply authentic employee responses, not generated answers. The envelope uses\n+`response_version: repair-response/1`, a stable `response_id`, employee `actor_id`\n+and exact `item_outcomes`. Each item retains its own outcome, note and refs.\n+Supported item IDs are current claim `ordinary:<id>:r<revision>:supporting_evidence`,\n+`correction:<id>:r<revision>:expense-evidence`, and\n+`ordinary:<id>:r<revision>:review_return:<decision-id>`. Non-claim items reject\n+this bounded command; unsupported claim approval, Finance, exception, policy\n+and budget repairs remain held.\n+\n+A supported outcome has `source_refs`, `assessment_ref`, and a nonempty `repairs`\n+array. Each operation has `kind` (`receipt` or `merchant-payment`), exact\n+`record_ref`, and `supersedes_refs` (empty for missing evidence; otherwise every\n+current row it explicitly replaces). A supplied JSON sufficiency assessment\n+binds the same item, subject, integer revision, response ID, employee `actor_id`,\n+reason, provenance, `evidence_refs` and **identical repairs array**. A reviewer\n+return also requires its exact `return_decision_ref` and original `repair_requested`\n+text. Matching actor identifiers do not independently authenticate the speaker.\n+\n+Use the receipt continuation manifest/reference format below. Receipt evidence\n+is a searchable PDF in the existing receipt-card schema. Merchant evidence is\n+an XLSX containing one nonempty `Merchant payments` tab with the existing native\n+headers. PDF and XLSX bytes are re-parsed; caller-provided parsed rows cannot\n+establish authority. Proof must match the current employee/trip/cost/receipt,\n+currency and full gross amount. Merchant proof additionally needs transaction\n+identity, settled status and an admissible payment date. Split-payment repairs\n+and shared-cost replacements require a broader adapter and remain held. New\n+deliveries need distinct supplemental source IDs; native IDs cannot be replaced.\n+\n+Valid independent items progress while unverifiable, insufficient or conflicting\n+items stay open. Bad declared hashes/observations and mismatched rows are retained\n+with admission reasons. Unknown items, stale revisions or wrong employees reject\n+the command without creating a result. The command rechecks affected claims,\n+updates queue/CSV/report/unsent drafts and retains old evidence/replacement history.\n+An evidence response does not approve a returned claim: current human re-review\n+and all other prerequisites still apply. No decisions, Finance events, cash or\n+reimbursement authorizations are imported or created.\n+\n+Results retain `continuation-input.json`, state, exact response, supplemental\n+evidence, output hashes and a recursively verified predecessor link. The four\n+original snapshots are unchanged; response ordinals are local evaluation order,\n+not additional native arrival batches or invented scenario times. Keep ancestors\n+available at their recorded relative paths. Exact command replay is inert;\n+exact response redelivery to its advanced state returns that existing result\n+without creating another directory. Conflicting response IDs and corrupted\n+history/results reject replay. Success (exit 0) can include held work: inspect\n+`response_holds`, the report and queue. Exit 1 means rejection/integrity failure.\n+Full-run `validate-readiness` does not accept this derived layout; built-in\n+verification checks its chain and output consistency, not submission compliance.\n+The receipt-only command remains compatible but its older derived format is\n+not a resumable parent for `continue-repairs`.\n+\n+Connected synthetic examples are in `tests/test_repair_continuation.py`.\n+No actual stakeholder response or new financial closure is demonstrated by them.\n+Native Notion access remains separately blocked.\n+\n ### Missing-receipt continuation (Omega Attempt 2)\n \n `continue-receipt` accepts one supplied employee receipt response against an\ndiff --git a/skills/travel-expense-claim/SKILL.md b/skills/travel-expense-claim/SKILL.md\nindex 3df6657..257d8e6 100644\n--- a/skills/travel-expense-claim/SKILL.md\n+++ b/skills/travel-expense-claim/SKILL.md\n@@ -175,8 +175,8 @@ then run the documented readiness command on the new run.\n Source-driven rechecks may resolve matching repairs with an\n `evidence-revalidated` event. This is not a stakeholder response. A separate\n general repair-response journal uses internal APIs in\n-[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The narrowly scoped\n-`continue-receipt` command below is an exception; `policy-replay` does not import\n+[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The bounded\n+`continue-receipt` and `continue-repairs` commands below expose supported slices; `policy-replay` does not import\n responses automatically:\n \n - `apply_partial_response(queue, response_id=..., item_outcomes=..., run_id=...,\n@@ -202,7 +202,7 @@ responses automatically:\n   conflicting replay is rejected. Unknown item IDs or malformed outcomes reject\n   the call. Changed subject revisions require current evidence: the internal\n   `update_repair_item` API reopens advanced revisions while retaining history.\n-- A developer must retain authentic evidence/assessments, load the queue, apply\n+- For types outside those commands, a developer must retain authentic evidence/assessments, load the queue, apply\n   the API, validate with `validate_partial_response_journal`, and persist a new\n   reviewable result without rewriting historical outputs. Queue resolution alone\n   does not rerun claim/Finance dependencies or regenerate snapshots, reports and\n@@ -241,6 +241,40 @@ native-source run or sealed arrival batch, a general importer, or support for\n chaining derived continuations. Parent evidence must stay available. Verification\n is built into this command; full-run readiness expects the original replay layout.\n \n+### Resumable evidence and returned-work repairs\n+\n+Use `continue-repairs` for current claim supporting-evidence repairs, correction\n+expense-evidence repairs and the evidence requested by a retained reviewer return.\n+It accepts receipts plus settled merchant proof, multiple matched items and\n+successive responses. See the [exact contract and invocation](../../README.md#resumable-evidence-and-returned-work-repairs-omega-attempt-3).\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Retain supplied item-specific assessments and explicit replacement references.\n+Only the verified selected rows enter the active evidence view; superseded rows,\n+invalid bytes and original snapshots remain retained. Valid independent items\n+progress; held items retain reasons. Inspect report, state, queue and unsent drafts\n+even after exit 0. Stale/wrong-employee subjects and integrity failures reject.\n+Exact replay is inert, including redelivery to an advanced result; conflicting\n+response IDs cannot change history. Preserve all ancestor directories.\n+\n+Returned evidence triggers rechecks, never reviewer approval. Finance, policy,\n+budget, exception, decision and independent cancellation imports are unsupported;\n+split/shared expense changes need developer integration. No cash or authorization\n+is changed. This is offline continuation with built-in chain/output checks,\n+not fresh acquisition, an extra native arrival batch or full-run readiness.\n+The older receipt-only result cannot be used as a continuation parent.\n+\n ## Errors, retries, and limitations\n \n - On source failure, retain the attempt URL, locator, UTC observation time, error, and missing scope. Hold only affected work and report its owner and resumption evidence.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 3b1d8bc..63b93b8 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -113,6 +113,13 @@ def build_parser() -> argparse.ArgumentParser:\n     receipt.add_argument('--evidence-dir', type=Path, required=True)\n     receipt.add_argument('--run-id', required=True)\n     receipt.add_argument('--schema', type=Path, default=_default_schema_path())\n+    repairs = commands.add_parser('continue-repairs', help='resume source-bound receipt/merchant and returned evidence repairs in a new derived result')\n+    repairs.add_argument('parent_run', type=Path)\n+    repairs.add_argument('response', type=Path)\n+    repairs.add_argument('output', type=Path)\n+    repairs.add_argument('--evidence-dir', type=Path, required=True)\n+    repairs.add_argument('--run-id', required=True)\n+    repairs.add_argument('--schema', type=Path, default=_default_schema_path())\n     readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n     readiness.add_argument(\"run_dir\", type=Path)\n     readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n@@ -123,6 +130,16 @@ def build_parser() -> argparse.ArgumentParser:\n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == 'continue-repairs':\n+        from .repair_continuation import continue_repairs\n+        try:\n+            result = continue_repairs(args.parent_run, args.response, args.evidence_dir, args.output,\n+                run_id=args.run_id, schema_path=args.schema)\n+        except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:\n+            print(f'Repair continuation rejected: {exc}', file=sys.stderr)\n+            return 1\n+        print(f\"OFFLINE REPAIR CONTINUATION {result['run_id']}: {'unchanged replay' if result['replayed'] else 'derived result verified'}; {result['output']}; human review and financial authority remain required\")\n+        return 0\n     if args.command == 'continue-receipt':\n         from .receipt_continuation import continue_receipt\n         try:\ndiff --git a/src/travel_claim/outputs.py b/src/travel_claim/outputs.py\nindex 6f1f267..c5140ab 100644\n--- a/src/travel_claim/outputs.py\n+++ b/src/travel_claim/outputs.py\n@@ -289,6 +289,7 @@ def apply_partial_response(\n     run_id: str,\n     batch_id: str,\n     evidence_directory: Path | None = None,\n+    admission_errors: dict[str, str] | None = None,\n ) -> None:\n     \"\"\"Record a supplied response against explicitly matched repair item IDs.\n \n@@ -301,6 +302,10 @@ def apply_partial_response(\n         raise ValueError(\"response_id is required\")\n     if not isinstance(item_outcomes, dict):\n         raise ValueError(\"item_outcomes must map repair item IDs to outcomes\")\n+    admission_errors = admission_errors or {}\n+    if (not set(admission_errors) <= set(item_outcomes)\n+            or any(not isinstance(v, str) or not v.strip() for v in admission_errors.values())):\n+        raise ValueError(\"context admission errors must identify response items and reasons\")\n     planned = []\n     for item_id, outcome in item_outcomes.items():\n         if item_id not in queue[\"items\"]:\n@@ -343,6 +348,7 @@ def apply_partial_response(\n                 verify_response_evidence(item, outcome, response_id, evidence_directory)\n             except (ValueError, KeyError, IndexError, TypeError, OSError) as exc:\n                 admission_error = f\"Response evidence held: {exc}\"\n+            admission_error = admission_error or admission_errors.get(item_id)\n         planned.append((item_id, item, kind, normalized_refs, None, admission_error))\n \n     # Mutate only after every item in this partial response passed validation.\ndiff --git a/src/travel_claim/receipt_continuation.py b/src/travel_claim/receipt_continuation.py\nindex 5fa73ee..a026d77 100644\n--- a/src/travel_claim/receipt_continuation.py\n+++ b/src/travel_claim/receipt_continuation.py\n@@ -143,9 +143,17 @@ def _report(state):\n              f\"Response: `{state['response']['response_id']}`. Native policy access: separately retained in parent sources.json.\",\n              'The local revalidation ordinal follows the parent arrivals; it is not an additional supplied arrival batch or a business timestamp.', '',\n              '## Response and revalidation', '']\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        lines[0] = '# Project D repair continuation — OFFLINE DERIVED RESULT'\n+        lines[6] = f\"Response: `{state['response']['response_id']}`. Native acquisition observations: [original sources.json]({state['native_source_manifest_path']}); supplemental replies do not change them.\"\n+        lines += ['Receipt and merchant evidence may resume checks; reviewer returns require current human re-review.', '']\n+        for delivery in state.get('repair_deliveries', []):\n+            lines.append(f\"- Response history `{delivery['response_id']}`: run `{delivery['run_id']}`, batch `{delivery['batch_id']}`; admitted items: {[x['item_id'] for x in delivery['admitted']]}; held items: {delivery['holds']}; source holds: {delivery['source_errors']}\")\n     for item, outcome in state['response']['item_outcomes'].items():\n         entry = state['repair_queue']['items'][item]\n         lines.append(f\"- `{item}`: {outcome['outcome']}; {entry['status']}; note: {outcome.get('note') or ''}; evidence: {outcome.get('source_refs', [])}\")\n+        if item in state.get('response_holds', {}):\n+            lines.append('  - Held: ' + state['response_holds'][item])\n     for cid in state['revalidated_claims']:\n         workflow = state['ordinary_workflows'][cid]\n         lines += [f\"- `{cid}` r{workflow['revision']}: {workflow['status']}; \" + '; '.join(\n@@ -168,9 +176,13 @@ def _report(state):\n     return '\\n'.join(lines)\n \n \n-def verify_continuation(output):\n+def verify_continuation(output, _seen=None):\n     \"\"\"Read-only integrity/consistency check; not submission or business approval.\"\"\"\n     output = Path(output).resolve()\n+    seen = set() if _seen is None else _seen\n+    if output in seen:\n+        raise ValueError('Continuation predecessor cycle')\n+    seen.add(output)\n     binding = read(output / 'continuation.json')\n     for path, sha in binding['output_hashes'].items():\n         if digest(confined(output, path)) != sha:\n@@ -179,13 +191,22 @@ def verify_continuation(output):\n     for path, sha in binding['parent_hashes'].items():\n         if digest(confined(parent, path)) != sha:\n             raise ValueError('Historical parent evidence changed: ' + path)\n+    if (parent / 'continuation.json').exists():\n+        verify_continuation(parent, seen)\n     state = read(output / 'continuation-state.json')\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        current = read(output / 'continuation-input.json').get('repair_continuation', {})\n+        if (current.get('mode') != state['mode'] or current.get('run_id') != state['run_id']\n+                or current.get('evidence_binding') != {'path': 'response-evidence/sources.json',\n+                    'sha256': digest(output / 'response-evidence/sources.json')}):\n+            raise ValueError('Continuation input and supplemental evidence binding disagree')\n     queue = load_repair_queue(output / 'repair-queue.json')\n     if queue != state['repair_queue'] or read(output / 'ordinary-workflow.json')['claims'] != state['ordinary_workflows']:\n         raise ValueError('Continuation queue/workflow/state disagree')\n     if read(output / 'response.json') != state['response']:\n         raise ValueError('Continuation response and state disagree')\n-    historical = read(parent / 'offline-replay-state.json')\n+    historical = read(parent / ('offline-replay-state.json' if (parent / 'offline-replay-state.json').exists()\n+                                else 'continuation-state.json'))\n     for key in ('finance_reconciliations', 'decision_history', 'revision_history', 'cancellation_state',\n                 'source_record_history', 'material_corrections'):\n         if state[key] != historical[key]:\n\"\"\"Bounded, resumable expense-evidence repairs; no decision or cash importer.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime\nfrom decimal import InvalidOperation\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport tempfile\nfrom zipfile import BadZipFile\nfrom xml.etree.ElementTree import ParseError\n\nfrom pypdf.errors import PdfReadError\nfrom openpyxl.utils.exceptions import InvalidFileException\n\nfrom .event_validation import observation_error, utc_time\nfrom .expenses import number, validate_employee_date\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import _sync_ordinary_repairs\nfrom .ordinary import connect_claim, expense_lines, fields, ref, table\nfrom .outputs import (apply_partial_response, validate_partial_response_journal,\n                      verify_response_evidence, project_claim_outputs, write_claims_csv, write_repair_queue)\nfrom .parsing import _pdf_pages, _receipt_records, _workbook_sheets\nfrom .receipt_continuation import (confined, digest, read, write, parent_evidence,\n                                   verify_continuation, _project, _report)\n\nMODE = 'offline-general-repair-continuation'\n\n\ndef load_parent(parent, schema):\n    if (parent / 'offline-replay-state.json').exists():\n        manifest, parsed, state, snapshot, queue, hashes = parent_evidence(parent, schema)\n        state['claims'] = snapshot['claims']\n        state['external_blockers'] = parsed.get('unresolved_issues', [])\n        state['parent_sealed_batches'] = state.pop('sealed_batches')\n        state['parent_parsed_records_path'] = state.pop('parsed_records_path')\n        state['parent_snapshot_hashes'] = {p: h for p, h in hashes.items() if p.startswith('batches/')}\n        return parent, manifest, parsed, state, queue, snapshot['travel_cancellations'], hashes\n    binding = verify_continuation(parent)\n    state = read(parent / 'continuation-state.json')\n    if state['mode'] != MODE:\n        raise ValueError('Resume requires an original replay or continue-repairs result')\n    root = (parent / binding['root_path']).resolve()\n    manifest = read(root / 'sources.json')\n    parsed = read(parent / 'continuation-input.json')\n    hashes = {p: digest(confined(parent, p)) for p in list(binding['output_hashes']) + ['continuation.json']}\n    return root, manifest, parsed, state, state['repair_queue'], state['travel_cancellations'], hashes\n\n\ndef retain_delivery(incoming, staging, prior, clock, response_id):\n    \"\"\"Retain even bad bytes; only freshly parsed, verified pieces are admissible.\"\"\"\n    if prior and (prior / 'response-evidence').exists():\n        shutil.copytree(prior / 'response-evidence', staging)\n        combined = read(staging / 'sources.json')\n        parsed = (read(staging / 'parsed-records.json') if (staging / 'parsed-records.json').exists()\n                  else {'pdf_pages': [], 'workbook_sheets': [], 'records': {'receipts': []}})\n    else:\n        staging.mkdir()\n        combined = {'files': []}\n        parsed = {'pdf_pages': [], 'workbook_sheets': [], 'records': {'receipts': []}}\n    supplied = read(incoming / 'sources.json')\n    rows = supplied.get('files')\n    if (not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows)\n            or any(not isinstance(r.get('source_id'), str) or not r['source_id'] for r in rows)\n            or len({r['source_id'] for r in rows}) != len(rows)):\n        raise ValueError('Delivery requires unique source entries')\n    old_ids = {r['source_id'] for r in combined['files']}\n    if old_ids & {r['source_id'] for r in rows}:\n        raise ValueError('New delivery must use distinct evidence source IDs')\n    prefix = 'delivery-' + hashlib.sha256(response_id.encode()).hexdigest()\n    copied = staging / prefix\n    copied.mkdir()\n    shutil.copyfile(incoming / 'sources.json', copied / 'original-manifest.json')\n    errors, records = {}, {}\n    hashes = {'sources.json': digest(incoming / 'sources.json')}\n    for row in rows:\n        source = confined(incoming, row['path'])\n        target = confined(copied, row['path'])\n        if row['path'] in {'original-manifest.json', 'sources.json', 'parsed-records.json'} or target.exists():\n            raise ValueError('Conflicting evidence path')\n        target.parent.mkdir(parents=True, exist_ok=True)\n        retained = dict(row, path=target.relative_to(staging).as_posix())\n        combined['files'].append(retained)\n        if not source.is_file():\n            hashes[row['path']] = None\n            errors[row['source_id']] = 'Missing retained evidence bytes'\n            continue\n        shutil.copyfile(source, target)\n        hashes[row['path']] = digest(target)\n        try:\n            if (row.get('status') != 'read' or row.get('missing_scope') != [] or row.get('error') is not None\n                    or not isinstance(row.get('version'), str) or not row['version'].strip()\n                    or hashes[row['path']] != row.get('sha256')):\n                raise ValueError('Incomplete, unobserved or hash-mismatched evidence')\n            observed = datetime.fromisoformat(str(row.get('observed_at')).replace('Z', '+00:00'))\n            if observed.utcoffset() is None:\n                raise ValueError('Evidence observation requires timezone')\n            error = observation_error(utc_time(row['observed_at']), clock)\n            if error:\n                raise ValueError(error)\n            if source.suffix == '.pdf':\n                pages = _pdf_pages(target, row['source_id'], row['sha256'])\n                rs = _receipt_records(pages)\n                if not rs or any(not p['text'].strip() for p in pages):\n                    raise ValueError('Receipt PDF is empty or incomplete')\n                parsed['pdf_pages'].extend(pages)\n                parsed['records']['receipts'].extend(rs)\n                records.update({ref(r): ('receipt', r) for r in rs})\n            elif source.suffix == '.xlsx':\n                sheets = _workbook_sheets(target, row['source_id'], row['sha256'])\n                if len(sheets) != 1 or sheets[0]['name'] != 'Merchant payments' or not sheets[0]['records']:\n                    raise ValueError('Only a nonempty Merchant payments tab is supported')\n                parsed['workbook_sheets'].extend(sheets)\n                records.update({ref(r): ('merchant-payment', r) for r in sheets[0]['records']})\n            elif source.suffix == '.json':\n                read(target)  # Retained assessment, never a trusted parsed-row substitute.\n            else:\n                raise ValueError('Only receipt PDF, merchant XLSX and assessment JSON are supported')\n        except (ValueError, TypeError, KeyError, OSError, BadZipFile, ParseError, PdfReadError, InvalidFileException) as exc:\n            errors[row['source_id']] = str(exc)\n    (staging / 'sources.json').write_text(json.dumps(combined, indent=2) + '\\n')\n    parsed['source_manifest'] = {'path': 'sources.json', 'sha256': digest(staging / 'sources.json')}\n    (staging / 'parsed-records.json').write_text(json.dumps(parsed, indent=2) + '\\n')\n    return combined, records, errors, hashes\n\n\ndef match_item(key, item, state, actor):\n    if not item or item['subject_type'] != 'claim':\n        raise ValueError('Unknown or non-claim repair item')\n    cid, revision = item['subject_id'], item['revision']\n    workflow = state['ordinary_workflows'].get(cid, {})\n    if item['status'] != 'open' or workflow.get('revision') != revision:\n        raise ValueError('Stale or non-open repair item/revision')\n    claim = next(r for r in state['revision_history']['claim'][cid]['revisions'] if r['revision'] == revision)\n    if actor != fields(claim['record']).get('Employee'):\n        raise ValueError('Response actor must match the claim employee')\n    return cid, claim\n\n\ndef return_context(state, key, cid, revision):\n    decision_id = key.split(':review_return:', 1)[1]\n    workflows = [state['ordinary_workflows'][cid]] + [x['workflow'] for x in state['ordinary_workflow_history']\n                    if x['workflow']['claim_id'] == cid and x['workflow']['revision'] == revision]\n    replies = {ref(d['raw_record']): d for wf in workflows for d in wf['observed_reviews']\n               if d['decision_id'] == decision_id and d['outcome'] == 'return' and d['evidence_valid']}\n    if len(replies) != 1:\n        raise ValueError('Return has no unique admitted historical reviewer authority')\n    return next(iter(replies.values()))\n\n\ndef admit_records(parsed, state, claim, outcome, records, assessment):\n    \"\"\"Use existing native schemas and exact, assessment-bound replacement intent.\"\"\"\n    repairs = outcome.get('repairs')\n    if not isinstance(repairs, list) or not repairs or assessment.get('repairs') != repairs:\n        raise ValueError('Assessment must bind the exact repair operations')\n    if outcome.get('source_refs') != list(dict.fromkeys(r.get('record_ref') for r in repairs)):\n        raise ValueError('Response references must exactly identify supplied repair rows')\n    cid = fields(claim['record'])['Claim reference']\n    employee = fields(claim['record'])['Employee']\n    trip = fields(claim['record'])['Trip reference']\n    changed = []\n    for repair in repairs:\n        kind, record = records.get(repair.get('record_ref'), (None, None))\n        if kind != repair.get('kind') or kind not in {'receipt', 'merchant-payment'}:\n            raise ValueError('Unsupported or unverified repair record')\n        values = fields(record)\n        cost = values.get('Expense reference')\n        lines = [l for l in expense_lines(claim['record']) if l['cost_id'] == cost]\n        if len(lines) != 1:\n            raise ValueError('Evidence must match an exact current expense')\n        line = lines[0]\n        for other, wf in state['ordinary_workflows'].items():\n            if other != cid and any(l['cost_id'] == cost or l.get('receipt_id') == line['receipt_id'] for l in wf['lines']):\n                raise ValueError('Shared expense/receipt requires broader dependency reconciliation')\n        if (values.get('Employee' if kind == 'receipt' else 'Employee ID') != employee\n                or values.get('Trip reference') != trip or values.get('Receipt reference') != line['receipt_id']\n                or values.get('Currency') != line['currency']\n                or number(values.get('Gross amount')) <= 0\n                or number(values.get('Gross amount')) != number(line['original_amount'])):\n            raise ValueError('Evidence employee/trip/cost/receipt/currency/gross mismatch')\n        if kind == 'receipt':\n            bucket = parsed['records']['receipts']\n            identity, identity_value = 'Receipt reference', line['receipt_id']\n        else:\n            if values.get('Payment status') != 'settled' or not values.get('Transaction reference'):\n                raise ValueError('Merchant proof requires an identified settled transaction')\n            validate_employee_date(values.get('Paid date'), 'Employee payment date', parsed,\n                                   {'employee_date_checks': [], 'source_refs': []}, [ref(record)])\n            # Materialized active view, with every superseded row retained below.\n            if 'merchant_payments' not in parsed['records']:\n                parsed['records']['merchant_payments'] = deepcopy(table(parsed, 'merchant_payments', 'Merchant payments'))\n            bucket = parsed['records']['merchant_payments']\n            identity, identity_value = 'Expense reference', cost\n            for old in bucket:\n                if fields(old).get('Transaction reference') == values['Transaction reference'] and fields(old).get('Expense reference') != cost:\n                    raise ValueError('Merchant transaction identity already belongs to a different expense')\n        existing = [r for r in bucket if fields(r).get(identity) == identity_value]\n        supersedes = repair.get('supersedes_refs', [])\n        if (not isinstance(supersedes, list) or len(set(supersedes)) != len(supersedes)\n                or set(supersedes) != {ref(r) for r in existing}):\n            raise ValueError('Replacement must explicitly name every superseded current row')\n        if any(ref(r) == ref(record) for r in existing):\n            raise ValueError('Evidence is already current; no repair performed')\n        bucket[:] = [r for r in bucket if r not in existing] + [deepcopy(record)]\n        changed.append(dict(kind=kind, current=deepcopy(record), superseded=deepcopy(existing)))\n    return changed\n\n\ndef continue_repairs(parent_run, response_file, evidence_dir, output, *, run_id, schema_path):\n    parent, response_file, incoming, output = [Path(p).resolve() for p in (parent_run, response_file, evidence_dir, output)]\n    if (not run_id or output.name != run_id or any(output == p or output.is_relative_to(p) for p in (parent, incoming))\n            or response_file.is_relative_to(output)):\n        raise ValueError('Use a distinct, new output directory named for the run ID')\n    root, manifest, parsed, state, queue, cancellations, hashes = load_parent(parent, schema_path)\n    if run_id in {state['run_id'], manifest['run_id']}:\n        raise ValueError('Continuation requires a new run ID')\n    response = read(response_file)\n    if (response.get('response_version') != 'repair-response/1' or not isinstance(response.get('response_id'), str)\n            or not response['response_id'].strip() or not isinstance(response.get('item_outcomes'), dict)\n            or not response['item_outcomes']):\n        raise ValueError('Invalid repair response envelope')\n    outcomes = response['item_outcomes']\n    response_id = response['response_id']\n    delivery = {'response': digest(response_file), 'manifest': digest(incoming / 'sources.json'),\n                'files': {r['path']: (digest(confined(incoming, r['path'])) if confined(incoming, r['path']).is_file() else None)\n                          for r in read(incoming / 'sources.json')['files']}}\n    fingerprint = hashlib.sha256(json.dumps(dict(parent=hashes, delivery=delivery, run_id=run_id), sort_keys=True).encode()).hexdigest()\n    if output.exists():\n        existing = verify_continuation(output)\n        if existing['input_sha256'] != fingerprint:\n            raise ValueError('Conflicting replay; result is immutable')\n        return dict(run_id=run_id, output=output, replayed=True)\n    for prior in state.get('repair_deliveries', []):\n        if prior['response_id'] == response_id:\n            if prior['delivery'] != delivery:\n                raise ValueError('Conflicting response ID replay')\n            return dict(run_id=state['run_id'], output=parent, replayed=True)\n    if run_id in {d['run_id'] for d in state.get('repair_deliveries', [])}:\n        raise ValueError('Run ID already belongs to an earlier continuation')\n    matches = {key: match_item(key, queue['items'].get(key), state, response.get('actor_id')) for key in outcomes}\n    batch = 'repair-response:' + response_id\n    ordinal = state.get('evaluation_boundary', {}).get('local_ordinal', max(parsed['arrival_batches'])) + 1\n    with tempfile.TemporaryDirectory(prefix='project-d-repairs-') as temp:\n        evidence = Path(temp) / 'response-evidence'\n        prior_evidence = parent if (parent / 'response-evidence').exists() else None\n        combined, records, source_errors, _ = retain_delivery(incoming, evidence, prior_evidence,\n            parsed.get('event_clock') or parsed.get('case_clock'), response_id)\n        if {r['source_id'] for r in combined['files']} & {r['source_id'] for r in manifest['files']}:\n            raise ValueError('Supplemental source IDs cannot replace native evidence')\n        observations = manifest['files'] + combined['files']\n        holds, admitted, affected = {}, [], set()\n        for key, outcome in outcomes.items():\n            if not isinstance(outcome, dict):\n                raise ValueError('Outcome must be an object')\n            if outcome.get('outcome') != 'supported':\n                continue\n            cid, claim = matches[key]\n            item = queue['items'][key]\n            try:\n                allowed = {f'ordinary:{cid}:r{claim[\"revision\"]}:supporting_evidence',\n                           f'correction:{cid}:r{claim[\"revision\"]}:expense-evidence'}\n                returned = key.startswith(f'ordinary:{cid}:r{claim[\"revision\"]}:review_return:')\n                if key not in allowed and not returned:\n                    raise ValueError('Repair type needs an unsupported authority/import adapter')\n                wf = state['ordinary_workflows'][cid]\n                if wf['status'] != 'pending' or wf['request'] or state['finance_reconciliations'][cid]['authorized_obligation']:\n                    raise ValueError('Only pending, currently unauthorized claims are supported')\n                assessment = verify_response_evidence(item, outcome, response_id, evidence)\n                refs = outcome['source_refs'] + [outcome['assessment_ref']]\n                for source_ref in refs:\n                    sid = source_ref.split('@', 1)[0]\n                    if sid in source_errors:\n                        raise ValueError(source_errors[sid])\n                if assessment.get('actor_id') != response.get('actor_id'):\n                    raise ValueError('Assessment must bind the response actor')\n                if returned:\n                    returned_reply = return_context(state, key, cid, claim['revision'])\n                    if (assessment.get('return_decision_ref') != ref(returned_reply['raw_record'])\n                            or assessment.get('repair_requested') != returned_reply['repair_requested']):\n                        raise ValueError('Returned work must bind its exact retained decision and repair request')\n                candidate = deepcopy(parsed)\n                changes = admit_records(candidate, state, claim, outcome, records, assessment)\n                parsed = candidate\n                admitted.append(dict(item_id=key, changes=changes))\n                affected.add(cid)\n            except (ValueError, TypeError, KeyError, IndexError, OSError, InvalidOperation) as exc:\n                holds[key] = 'Response evidence held: ' + str(exc)\n        for cid in sorted(affected):\n            claim = matches[next(k for k, v in matches.items() if v[0] == cid)][1]\n            before = state['finance_reconciliations'][cid]\n            wf = connect_claim(parsed=parsed, claim=claim, decisions=state['source_record_history']['decisions'],\n                finance_events=state['source_record_history']['finance_events'], finance=deepcopy(before),\n                cancellations=cancellations, arrival_batch=ordinal, source_observations=observations,\n                prior_finance=before, prior_workflow=state['ordinary_workflows'][cid],\n                budget_data=state['budget_reconciliation'], prepaid_data=state['budget_reconciliation']['cost_attribution'],\n                prior_budget_view=state['budget_reconciliation']['claim_views'][cid])\n            if wf.pop('finance') != before or wf['request'] is not None or wf['status'] != 'pending':\n                raise ValueError('Evidence continuation must not authorize reimbursement or change financial history')\n            # Evidence does not supply the current reviewer response. Retain\n            # returned work after its old packet becomes historical authority.\n            for key, item in queue['items'].items():\n                if item['status'] != 'open' or not key.startswith(f'ordinary:{cid}:r{claim[\"revision\"]}:review_return:'):\n                    continue\n                reply = return_context(state, key, cid, claim['revision'])\n                name = key.split(f'ordinary:{cid}:r{claim[\"revision\"]}:', 1)[1]\n                review_stage = next((s for s in wf['stages'] if s['stage'] == name), None)\n                if review_stage is None:\n                    review_stage = {'stage': name}\n                    wf['stages'].append(review_stage)\n                review_stage.update(status='BLOCKED', source_refs=reply['source_refs'],\n                    detail='Returned evidence rechecked; a current human reviewer response is still required: ' + reply['repair_requested'],\n                    owner=fields(reply['raw_record'])['Reviewer'], next_action='Obtain current source-bound reviewer response to the repaired evidence; no approval is inferred')\n            state['ordinary_workflows'][cid] = wf\n            state['ordinary_workflow_history'].append(dict(batch_id=batch, workflow=deepcopy(wf)))\n            state['budget_reconciliation']['claim_views'][cid] = deepcopy(wf['budget_view'])\n            _project(next(c for c in state['claims'] if c['claim_id'] == cid), wf, before)\n        apply_partial_response(queue, response_id=response_id, item_outcomes=outcomes, run_id=run_id,\n            batch_id=batch, evidence_directory=evidence, admission_errors=holds)\n        _sync_ordinary_repairs(dict(repair_queue=queue,\n            ordinary_workflows={cid: state['ordinary_workflows'][cid] for cid in affected},\n            finance_reconciliations={cid: state['finance_reconciliations'][cid] for cid in affected}), run_id=run_id, batch_id=batch)\n        validate_partial_response_journal(queue, evidence)\n        state.setdefault('repair_deliveries', []).append(dict(response_id=response_id, delivery=delivery,\n            run_id=run_id, batch_id=batch, admitted=admitted, holds=holds, source_errors=source_errors))\n        state.update(mode=MODE, run_id=run_id, parent_run_id=read(parent / ('sources.json' if parent == root else 'continuation-state.json'))['run_id'],\n            response=response, response_holds=holds, repair_queue=queue, revalidated_claims=sorted(affected),\n            parent_run_path=os.path.relpath(parent, output),\n            native_source_manifest_path=os.path.relpath(root / 'sources.json', output),\n            travel_cancellations=cancellations, evaluation_boundary=dict(kind='repair-response', response_id=response_id,\n                local_ordinal=ordinal, native_arrival_batch=None))\n        parsed['repair_continuation'] = dict(mode=MODE, run_id=run_id,\n            native_parent_path=os.path.relpath(root, output),\n            evidence_binding={'path': 'response-evidence/sources.json', 'sha256': digest(evidence / 'sources.json')})\n        output.parent.mkdir(parents=True, exist_ok=True)\n        output.mkdir(exist_ok=False)\n        shutil.copytree(evidence, output / 'response-evidence')\n        shutil.copyfile(response_file, output / 'response.json')\n        write(output / 'continuation-state.json', state)\n        write(output / 'continuation-input.json', parsed)\n        write_repair_queue(queue, output / 'repair-queue.json')\n        write_claims_csv(project_claim_outputs(state['claims'], queue), output / 'claims.csv')\n        write(output / 'ordinary-workflow.json', dict(mode=MODE, run_id=run_id, claims=state['ordinary_workflows']))\n        drafts, _ = render_follow_up_drafts(run_id=run_id, queue=queue, blockers=state['external_blockers'])\n        (output / 'follow-up-drafts.md').write_text(drafts, encoding='utf-8')\n        (output / 'report.md').write_text(_report(state), encoding='utf-8')\n        outputs = {p.relative_to(output).as_posix(): digest(p) for p in output.rglob('*') if p.is_file()}\n        write(output / 'continuation.json', dict(version='repair-continuation/1', run_id=run_id,\n            input_sha256=fingerprint, parent_path=os.path.relpath(parent, output), root_path=os.path.relpath(root, output),\n            parent_hashes=hashes, output_hashes=outputs, fresh_native_reads_performed=False))\n        verify_continuation(output)\n    return dict(run_id=run_id, output=output, replayed=False)\n\"\"\"End-to-end synthetic employee evidence; no real responses or authority.\"\"\"\nfrom copy import deepcopy\nimport csv\nimport io\nimport json\nfrom pathlib import Path\n\nfrom openpyxl import Workbook, load_workbook\nimport pytest\n\nfrom test_receipt_continuation import base_run, pdf, receipt, sha, hashes, SCHEMA, POLICY\nfrom travel_claim.cli import main\nfrom travel_claim.ordinary import fields, ref\nfrom travel_claim.parsing import parse_retained_run, _workbook_sheets, _pdf_pages, _receipt_records\nfrom travel_claim.policy_evidence import create_policy_replay\nfrom travel_claim.receipt_continuation import verify_continuation\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\ndef get(path):\n    return json.loads(path.read_text())\n\n\ndef save(path, data):\n    path.write_text(json.dumps(data, indent=2))\n\n\ndef parent(tmp_path, *, missing_merchants=('A',), returned=False, corrected=False):\n    seed = tmp_path / 'seed'; seed.mkdir()\n    first = base_run(seed)\n    workbook = load_workbook(first / 'sources/travel-registers-workbook.xlsx')\n    tab = workbook['Merchant payments']\n    for row in reversed(range(3, tab.max_row + 1)):\n        if tab.cell(row, 2).value in {'COST-' + c for c in missing_merchants}:\n            tab.delete_rows(row)\n    if returned:\n        original = get(first / 'parsed-records.json')\n        sample = get(Path(__file__).parent / 'fixtures/ordinary_claim_c01.json')\n        packet = {k: v['value'] for k, v in next(s for s in sample['workbook_sheets'] if s['name']=='Review packets')['records'][0]['values'].items()}\n        packet.update({'Decision reference':'SYN-RETURN-A', 'Trip reference':'T-A', 'Expense references':'COST-A'})\n        decision = {k:v['value'] for k,v in sample['records']['decisions'][0]['values'].items()}\n        decision.update({'Decision reference':'SYN-RETURN-A','Subject reference':'SYN-A', 'Outcome':'return',\n                         'Repair requested':'Supply receipt and settled merchant proof for COST-A',\n                         'Source revisions':'POL-2026.2\\n'+sha(first/'sources/initial-claim-binder.pdf')})\n        for name, row in [('Review packets',packet),('Review ledger',decision)]:\n            sheet=workbook[name];sheet.delete_rows(1,sheet.max_row)\n            sheet.append(list(row));sheet.append(list(row.values()))\n    buffer=io.BytesIO();workbook.save(buffer)\n    bodies={s.source_id: (first/next(r['path'] for r in get(first/'sources.json')['files']\n                                   if r['source_id']==s.source_id)).read_bytes()\n            for s in SOURCES if s.source_id!='policy-pol-2026-2'}\n    bodies.update({'policy-pol-2026-2':b'SYNTHETIC generic Notion shell', 'travel-registers-workbook':buffer.getvalue()})\n    if corrected:\n        from travel_claim.parsing import _pdf_pages\n        original_page=_pdf_pages(first/'sources/initial-claim-binder.pdf','synthetic','synthetic')[0]['text']\n        bodies['claim-updates-binder']=pdf([original_page.replace('Revision: 1','Revision: 2').replace('Arrival batch: 1','Arrival batch: 3')])\n    def fetch(url, timeout):\n        s=next(s for s in SOURCES if (s.export_url or s.url)==url)\n        return bodies[s.source_id],{},url\n    source=tmp_path/'source'\n    capture_sources(source,run_id='source',case_clock=None,fetch=fetch,observed_at=lambda:'2026-10-01T12:00:00Z')\n    parse_retained_run(source)\n    result=tmp_path/'parent'\n    create_policy_replay(source,result,run_id='parent',browser_policy=POLICY,schema_path=SCHEMA)\n    return result\n\n\ndef bundle(tmp_path, parent_path, *, name='one', specs=None, insufficient=()):\n    \"\"\"spec = (claim suffix, item, kind, superseded refs).\"\"\"\n    incoming=tmp_path/('incoming-'+name);incoming.mkdir()\n    rows=[];outcomes={};assessments={}\n    specs=specs or [('A','ordinary:SYN-A:r1:supporting_evidence','receipt',[])]\n    for index,(cid,item,kind,supersedes) in enumerate(specs):\n        sid=f'SYN-{name}-{index}';path=incoming/(sid+('.pdf' if kind=='receipt' else '.xlsx'))\n        if kind=='receipt':\n            path.write_bytes(pdf([receipt(cid)]));record=_receipt_records(_pdf_pages(path,sid,sha(path)))[0]\n        else:\n            workbook=Workbook();sheet=workbook.active;sheet.title='Merchant payments'\n            value={'Transaction reference':'SYN-M-'+cid,'Expense reference':'COST-'+cid,'Employee ID':'EMP-01',\n                   'Trip reference':'T-'+cid,'Currency':'EUR','Gross amount':'100.00','Paid date':'2026-09-01',\n                   'Payment status':'settled','Receipt reference':'R-COST-'+cid}\n            sheet.append(list(value));sheet.append(list(value.values()));workbook.save(path)\n            record=_workbook_sheets(path,sid,sha(path))[0]['records'][0]\n        rows.append(dict(source_id=sid,path=path.name,sha256=sha(path),status='read',error=None,missing_scope=[],\n                         version=sha(path),observed_at='2026-10-02T12:00:00Z'))\n        outcome=outcomes.setdefault(item,dict(outcome='supported',note='SYNTHETIC response for '+item,source_refs=[],repairs=[]))\n        outcome['source_refs'].append(ref(record));outcome['repairs'].append(dict(kind=kind,record_ref=ref(record),supersedes_refs=supersedes))\n    for index,(item,outcome) in enumerate(outcomes.items()):\n        cid=item.split(':')[1]\n        revision=int(item.split(':')[2][1:])\n        assessments[str(index)]=dict(item_id=item,subject_type='claim',subject_id=cid,revision=revision,response_id='SYN-'+name,\n            actor_id='EMP-01',sufficient=True,reason='SYNTHETIC supplied evidence for exact expense',\n            provenance='SYNTHETIC employee response',evidence_refs=outcome['source_refs'],repairs=outcome['repairs'])\n        if ':review_return:' in item:\n            state=get(parent_path/('offline-replay-state.json' if (parent_path/'offline-replay-state.json').exists() else 'continuation-state.json'))\n            from travel_claim.repair_continuation import return_context\n            decision=return_context(state,item,cid,revision)\n            assessments[str(index)].update(return_decision_ref=ref(decision['raw_record']),repair_requested=decision['repair_requested'])\n    proof=incoming/'assessment.json';save(proof,assessments)\n    proof_id='SYN-assess-'+name\n    rows.append(dict(source_id=proof_id,path=proof.name,sha256=sha(proof),status='read',error=None,missing_scope=[],\n                     version=sha(proof),observed_at='2026-10-02T12:00:00Z'))\n    for index,outcome in enumerate(outcomes.values()):outcome['assessment_ref']=f'{proof_id}@{sha(proof)}#/{index}'\n    for item in insufficient:outcomes[item]=dict(outcome='insufficient',note='SYNTHETIC still missing',source_refs=[])\n    save(incoming/'sources.json',dict(files=rows))\n    response=tmp_path/('response-'+name+'.json')\n    save(response,dict(response_version='repair-response/1',response_id='SYN-'+name,actor_id='EMP-01',item_outcomes=outcomes))\n    return response,incoming\n\n\ndef run(parent_path, response, evidence, output):\n    return main(['continue-repairs',str(parent_path),str(response),str(output),'--evidence-dir',str(evidence),'--run-id',output.name])\n\n\ndef stage(state,cid,name):\n    return next(s for s in state['ordinary_workflows'][cid]['stages'] if s['stage']==name)['status']\n\n\ndef test_multiple_evidence_types_partial_response_and_repeated_resumption(tmp_path):\n    p=parent(tmp_path);before=hashes(p);old=get(p/'offline-replay-state.json')\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,insufficient=[b]);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    first=get(one/'continuation-state.json')\n    assert stage(first,'SYN-A','supporting_evidence')=='BLOCKED'  # Receipt alone cannot prove payment.\n    assert first['repair_queue']['items'][a]['status']=='open'\n    assert first['repair_queue']['items'][b]['status']=='open'\n    second_response,second_evidence=bundle(tmp_path,one,name='two',specs=[('A',a,'merchant-payment',[])],insufficient=[b])\n    two=tmp_path/'two';assert run(one,second_response,second_evidence,two)==0\n    final=get(two/'continuation-state.json');verify_continuation(two)\n    assert stage(final,'SYN-A','supporting_evidence')=='PASS'\n    assert final['repair_queue']['items'][a]['status']=='resolved'\n    assert final['repair_queue']['items'][b]['status']=='open'\n    assert final['ordinary_workflows']['SYN-B']==old['ordinary_workflows']['SYN-B']\n    assert final['ordinary_workflows']['SYN-C']==old['ordinary_workflows']['SYN-C']\n    assert final['finance_reconciliations']==old['finance_reconciliations']\n    assert final['decision_history']==old['decision_history']\n    assert final['revision_history']==old['revision_history']\n    assert final['cancellation_state']==old['cancellation_state']\n    assert final['budget_reconciliation']['scopes']==old['budget_reconciliation']['scopes']\n    assert final['budget_history']==old['budget_history']\n    assert final['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert final['ordinary_workflows']['SYN-A']['request'] is None\n    assert all(not w['status'].startswith('closed-') for w in final['ordinary_workflows'].values())\n    drafts=(two/'follow-up-drafts.md').read_text();assert f'Item `{a}`' not in drafts and f'Item `{b}`' in drafts\n    assert 'supporting_evidence=PASS' in (two/'report.md').read_text()\n    assert (two/final['native_source_manifest_path']).resolve()==(p/'sources.json').resolve()\n    row=next(r for r in csv.DictReader((two/'claims.csv').open()) if r['claim_id']=='SYN-A')\n    assert row['status']=='pending' and row['paid_cents']=='10000' and row['balance_cents']==''\n    assert row['revision']=='1' and row['trip_id']=='T-A'\n    assert row['allowed_cents']==str(final['ordinary_workflows']['SYN-A']['allowed_cents'])\n    unchanged=hashes(two);assert run(one,second_response,second_evidence,two)==0 and hashes(two)==unchanged\n    # Same response redelivered against the advanced state creates no new effect/result.\n    assert run(two,second_response,second_evidence,tmp_path/'retry')==0\n    assert not (tmp_path/'retry').exists() and hashes(two)==unchanged\n    another,another_evidence=bundle(tmp_path,two,name='three',specs=[('B',b,'receipt',[])])\n    assert run(two,another,another_evidence,tmp_path/'reuse'/'one')==1\n    assert not (tmp_path/'reuse').exists()\n    assert hashes(p)==before and len(list((p/'batches').glob('*.json')))==4\n    for key,item in old['repair_queue']['items'].items():\n        if item['subject_id'] not in {'SYN-A','SYN-B'}:assert final['repair_queue']['items'][key]==item\n\n\ndef test_valid_item_progresses_while_other_invalid_evidence_is_held(tmp_path):\n    p=parent(tmp_path,missing_merchants=())\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',a,'receipt',[]),('B',b,'receipt',[])])\n    bad=evidence/'SYN-one-1.pdf';bad.write_bytes(bad.read_bytes()+b'tampered')\n    out=tmp_path/'mixed';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json');q=state['repair_queue']\n    assert q['items'][a]['status']=='resolved' and q['items'][b]['status']=='open'\n    event=next(e for e in q['events'] if e.get('item_id')==b and e['event']=='response-recorded')\n    assert event['admission_status']=='held' and 'hash' in event['admission_reason']\n    assert (out/'response-evidence'/next(r['path'] for r in get(out/'response-evidence/sources.json')['files'] if r['source_id']=='SYN-one-1')).read_bytes()==bad.read_bytes()\n    verify_continuation(out)\n\n\n@pytest.mark.parametrize('fault',['stale','wrong-actor','wrong-hash','missing-file','wrong-revision-assessment','wrong-operation','unknown-ref','future','wrong-gross','invalid-number','unsupported'])\ndef test_negative_deliveries_never_resolve_or_authorize(tmp_path,fault):\n    p=parent(tmp_path);before=hashes(p);response,evidence=bundle(tmp_path,p)\n    obj=get(response);key=next(iter(obj['item_outcomes']))\n    if fault=='stale':obj['item_outcomes'][key.replace(':r1:',':r2:')]=obj['item_outcomes'].pop(key)\n    elif fault=='wrong-actor':obj['actor_id']='UNAUTHORIZED'\n    elif fault=='wrong-hash':(evidence/'SYN-one-0.pdf').write_bytes(b'tampered')\n    elif fault=='missing-file':(evidence/'SYN-one-0.pdf').unlink()\n    elif fault=='unknown-ref':obj['item_outcomes'][key]['source_refs']=['missing@'+'0'*64+'#row 1']\n    elif fault=='unsupported':obj['item_outcomes']['ordinary:SYN-A:r1:required_approvals']=obj['item_outcomes'].pop(key)\n    elif fault=='future':\n        manifest=get(evidence/'sources.json');manifest['files'][0]['observed_at']='2026-11-16T12:00:00Z';save(evidence/'sources.json',manifest)\n    else:\n        proof=get(evidence/'assessment.json')\n        if fault=='wrong-revision-assessment':proof['0']['revision']=2\n        elif fault=='wrong-operation':proof['0']['repairs'][0]['kind']='approval'\n        else:\n            # A real, hash-bound PDF with mismatched gross is not sufficient either.\n            path=evidence/'SYN-one-0.pdf';path.write_bytes(pdf([receipt(amount='invalid' if fault=='invalid-number' else '99.00')]))\n            rr=f'SYN-one-0@{sha(path)}#PDF page 1, receipt 1'\n            obj['item_outcomes'][key]['source_refs']=[rr];obj['item_outcomes'][key]['repairs'][0]['record_ref']=rr\n            proof['0']['evidence_refs']=[rr];proof['0']['repairs'][0]['record_ref']=rr\n        save(evidence/'assessment.json',proof);manifest=get(evidence/'sources.json')\n        for row in manifest['files']:row['sha256']=sha(evidence/row['path'])\n        save(evidence/'sources.json',manifest);obj['item_outcomes'][key]['assessment_ref']=f'SYN-assess-one@{sha(evidence/\"assessment.json\")}#/0'\n    save(response,obj);out=tmp_path/'negative'\n    rc=run(p,response,evidence,out)\n    if fault in {'stale','wrong-actor'}:assert rc==1 and not out.exists()\n    else:\n        assert rc==0\n        state=get(out/'continuation-state.json');assert state['response_holds']\n        assert all(i['status']=='open' for k,i in state['repair_queue']['items'].items() if k in obj['item_outcomes'])\n        assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    assert hashes(p)==before\n\n\ndef test_returned_work_receives_evidence_but_requires_human_re_review(tmp_path):\n    p=parent(tmp_path,returned=True)\n    old=get(p/'offline-replay-state.json');wf=old['ordinary_workflows']['SYN-A']\n    item='ordinary:SYN-A:r1:review_return:SYN-RETURN-A'\n    assert item in old['repair_queue']['items'] and old['repair_queue']['items'][item]['status']=='open'\n    response,evidence=bundle(tmp_path,p,specs=[('A',item,'receipt',[])])\n    partial=tmp_path/'returned-partial';assert run(p,response,evidence,partial)==0\n    assert get(partial/'continuation-state.json')['repair_queue']['items'][item]['status']=='open'\n    response2,evidence2=bundle(tmp_path,partial,name='returned-two',specs=[('A',item,'merchant-payment',[])])\n    out=tmp_path/'returned';assert run(partial,response2,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    assert stage(state,'SYN-A','required_approvals')=='BLOCKED'\n    assert state['repair_queue']['items'][item]['status']=='open'\n    assert state['repair_queue']['items'][item]['owner']=='ADMIN-01'\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['decision_history']==old['decision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n    assert 'human re-review' in (out/'report.md').read_text()\n\n\ndef test_original_evidence_and_derived_result_tampering_are_detected(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    (one/'claims.csv').write_text('tampered')\n    assert run(p,response,evidence,one)==1\n\n\ndef test_explicit_replacement_preserves_old_rows_and_conflicting_replay_is_rejected(tmp_path):\n    # Explicitly replace merchant proof, without changing any Finance event.\n    p=parent(tmp_path,missing_merchants=())\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    parsed=get(p/'parsed-records.json')\n    old_payment=next(r for s in parsed['workbook_sheets'] if s['name']=='Merchant payments'\n                     for r in s['records'] if fields(r).get('Expense reference')=='COST-A')\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',[]),('A',key,'merchant-payment',[ref(old_payment)])])\n    out=tmp_path/'replaced';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    changed=state['repair_deliveries'][0]['admitted'][0]['changes']\n    assert changed[1]['superseded']==[old_payment]\n    assert ref(old_payment) in get(response)['item_outcomes'][key]['repairs'][1]['supersedes_refs']\n    assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    before=hashes(out);obj=get(response);obj['item_outcomes'][key]['note']='conflicting replay';save(response,obj)\n    assert run(out,response,evidence,tmp_path/'conflict')==1 and hashes(out)==before\n\n\ndef test_unknown_supersession_is_held_and_unmatched_work_is_untouched(tmp_path):\n    p=parent(tmp_path)\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',['invented-ref'])])\n    out=tmp_path/'bad-replacement';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert 'superseded' in state['response_holds'][key]\n    assert not state['revalidated_claims']\n    assert state['ordinary_workflows']==get(p/'offline-replay-state.json')['ordinary_workflows']\n\n\ndef test_descendant_checks_original_ancestor_and_response_evidence(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response2,evidence2=bundle(tmp_path,one,name='two',specs=[('A',key,'merchant-payment',[])])\n    two=tmp_path/'two';assert run(one,response2,evidence2,two)==0\n    original=p/'sources/receipt-binder.pdf';original.write_bytes(original.read_bytes()+b'tampered')\n    with pytest.raises(ValueError,match='parent evidence changed'):\n        verify_continuation(two)\n\n\ndef test_current_corrected_revision_resumes_but_old_revision_response_is_rejected(tmp_path):\n    p=parent(tmp_path,corrected=True)\n    old=get(p/'offline-replay-state.json');assert old['ordinary_workflows']['SYN-A']['revision']==2\n    stale,evidence=bundle(tmp_path,p)\n    assert run(p,stale,evidence,tmp_path/'stale')==1\n    item='correction:SYN-A:r2:expense-evidence'\n    assert old['repair_queue']['items'][item]['status']=='open'\n    response,evidence2=bundle(tmp_path,p,name='current',specs=[('A',item,'receipt',[]),('A',item,'merchant-payment',[])])\n    out=tmp_path/'corrected';assert run(p,response,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert state['repair_queue']['items'][item]['status']=='resolved'\n    assert state['ordinary_workflows']['SYN-A']['revision']==2\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['revision_history']==old['revision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n","exit_code":0,"duration":{"secs":0,"nanos":153612979},"formatted_output":"Warning: truncated output (original token count: 15010)\nTotal output lines: 924\n\ndiff --git a/README.md b/README.md\nindex 8b93657..a32599f 100644\n--- a/README.md\n+++ b/README.md\n@@ -73,6 +73,78 @@ The owner-grouped repair queue API is in `travel_claim.outputs`. Queue items ret\n \n ## Verification\n \n+### Resumable evidence and returned-work repairs (Omega Attempt 3)\n+\n+From a restored offline replay, use a fresh result directory:\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+# A later authentic response can resume that result, retaining the full chain:\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Supply authentic employee responses, not generated answers. The envelope uses\n+`response_version: repair-response/1`, a stable `response_id`, employee `actor_id`\n+and exact `item_outcomes`. Each item retains its own outcome, note and refs.\n+Supported item IDs are current claim `ordinary:<id>:r<revision>:supporting_evidence`,\n+`correction:<id>:r<revision>:expense-evidence`, and\n+`ordinary:<id>:r<revision>:review_return:<decision-id>`. Non-claim items reject\n+this bounded command; unsupported claim approval, Finance, exception, policy\n+and budget repairs remain held.\n+\n+A supported outcome has `source_refs`, `assessment_ref`, and a nonempty `repairs`\n+array. Each operation has `kind` (`receipt` or `merchant-payment`), exact\n+`record_ref`, and `supersedes_refs` (empty for missing evidence; otherwise every\n+current row it explicitly replaces). A supplied JSON sufficiency assessment\n+binds the same item, subject, integer revision, response ID, employee `actor_id`,\n+reason, provenance, `evidence_refs` and **identical repairs array**. A reviewer\n+return also requires its exact `return_decision_ref` and original `repair_requested`\n+text. Matching actor identifiers do not independently authenticate the speaker.\n+\n+Use the receipt continuation manifest/reference format below. Receipt evidence\n+is a searchable PDF in the existing receipt-card schema. Merchant evidence is\n+an XLSX containing one nonempty `Merchant payments` tab with the existing native\n+headers. PDF and XLSX bytes are re-parsed; caller-provided parsed rows cannot\n+establish authority. Proof must match the current employee/trip/cost/receipt,\n+currency and full gross amount. Merchant proof additionally needs transaction\n+identity, settled status and an admissible payment date. Split-payment repairs\n+and shared-cost replacements require a broader adapter and remain held. New\n+deliveries need distinct supplemental source IDs; native IDs cannot be replaced.\n+\n+Valid independent items progress while unverifiable, insufficient or conflicting\n+items stay open. Bad declared hashes/observations and mismatched rows are retained\n+with admission reasons. Unknown items, stale revisions or wrong employees reject\n+the command without creating a result. The command rechecks affected claims,\n+updates queue/CSV/report/unsent drafts and retains old evidence/replacement history.\n+An evidence response does not approve a returned claim: current human re-review\n+and all other prerequisites still apply. No decisions, Finance events, cash or\n+reimbursement authorizations are imported or created.\n+\n+Results retain `continuation-input.json`, state, exact response, supplemental\n+evidence, output hashes and a recursively verified predecessor link. The four\n+original snapshots are unchanged; response ordinals are local evaluation order,\n+not additional native arrival batches or invented scenario times. Keep ancestors\n+available at their recorded relative paths. Exact command replay is inert;\n+exact response redelivery to its advanced state returns that existing result\n+without creating another directory. Conflicting response IDs and corrupted\n+history/results reject replay. Success (exit 0) can include held work: inspect\n+`response_holds`, the report and queue. Exit 1 means rejection/integrity failure.\n+Full-run `validate-readiness` does not accept this derived layout; built-in\n+verification checks its chain and output consistency, not submission compliance.\n+The receipt-only command remains compatible but its older derived format is\n+not a resumable parent for `continue-repairs`.\n+\n+Connected synthetic examples are in `tests/test_repair_continuation.py`.\n+No actual stakeholder response or new financial closure is demonstrated by them.\n+Native Notion access remains separately blocked.\n+\n ### Missing-receipt continuation (Omega Attempt 2)\n \n `continue-receipt` accepts one supplied employee receipt response against an\ndiff --git a/skills/travel-expense-claim/SKILL.md b/skills/travel-expense-claim/SKILL.md\nindex 3df6657..257d8e6 100644\n--- a/skills/travel-expense-claim/SKILL.md\n+++ b/skills/travel-expense-claim/SKILL.md\n@@ -175,8 +175,8 @@ then run the documented readiness command on the new run.\n Source-driven rechecks may resolve matching repairs with an\n `evidence-revalidated` event. This is not a stakeholder response. A separate\n general repair-response journal uses internal APIs in\n-[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The narrowly scoped\n-`continue-receipt` command below is an exception; `policy-replay` does not import\n+[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The bounded\n+`continue-receipt` and `continue-repairs` commands below expose supported slices; `policy-replay` does not import\n responses automatically:\n \n - `apply_partial_response(queue, response_id=..., item_outcomes=..., run_id=...,\n@@ -202,7 +202,7 @@ responses automatically:\n   conflicting replay is rejected. Unknown item IDs or malformed outcomes reject\n   the call. Changed subject revisions require current evidence: the internal\n   `update_repair_item` API reopens advanced revisions while retaining history.\n-- A developer must retain authentic evidence/assessments, load the queue, apply\n+- For types outside those commands, a developer must retain authentic evidence/assessments, load the queue, apply\n   the API, validate with `validate_partial_response_journal`, and persist a new\n   reviewable result without rewriting historical outputs. Queue resolution alone\n   does not rerun claim/Finance dependencies or regenerate snapshots, reports and\n@@ -241,6 +241,40 @@ native-source run or sealed arrival batch, a general importer, or support for\n chaining derived continuations. Parent evidence must stay available. Verification\n is built into this command; full-run readiness expects the original replay layout.\n \n+### Resumable evidence and returned-work repairs\n+\n+Use `continue-repairs` for current claim supporting-evidence repairs, correction\n+expense-evidence repairs and the evidence requested by a retained reviewer return.\n+It accepts receipts plus settled merchant proof, multiple matched items and\n+successive responses. See the [exact contract and invocation](../../README.md#resumable-evidence-and-returned-work-repairs-omega-attempt-3).\n+\n+```bash\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\n+travel-claim continue-repairs \\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\n+  response.json \"$REPAIR_CHECK_DIR/repair-one\" \\\n+  --evidence-dir response-evidence --run-id repair-one\n+travel-claim continue-repairs \\\n+  \"$REPAIR_CHECK_DIR/repair-one\" later-response.json \\\n+  \"$REPAIR_CHECK_DIR/repair-two\" \\\n+  --evidence-dir later-response-evidence --run-id repair-two\n+```\n+\n+Retain supplied item-specific assessments and explicit replacement references.\n+Only the verified selected rows enter the active evidence view; superseded rows,\n+invalid bytes and original snapshots remain retained. Valid independent items\n+progress; held items retain reasons. Inspect report, state, queue and unsent drafts\n+even after exit 0. Stale/wrong-employee subjects and integrity failures reject.\n+Exact replay is inert, including redelivery to an advanced result; conflicting\n+response IDs cannot change history. Preserve all ancestor directories.\n+\n+Returned evidence triggers rechecks, never reviewer approval. Finance, policy,\n+budget, exception, decision and independent cancellation imports are unsupported;\n+split/shared expense changes need developer integration. No cash or authorization\n+is changed. This is offline continuation with built-in chain/output checks,\n+not fresh acquisition, an extra native arrival batch or full-run readiness.\n+The older receipt-only result cannot be used as a continuation parent.\n+\n ## Errors, retries, and limitations\n \n - On source failure, retain the attempt URL, locator, UTC observation time, error, and missing scope. Hold only affected work and report its owner and resumption evidence.\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\nindex 3b1d8bc..63b93b8 100644\n--- a/src/travel_claim/cli.py\n+++ b/src/travel_claim/cli.py\n@@ -113,6 +113,13 @@ def build_parser() -> argparse.ArgumentParser:\n     receipt.add_argument('--evidence-dir', type=Path, required=True)\n     receipt.add_argument('--run-id', required=True)\n     receipt.add_argument('--schema', type=Path, default=_default_schema_path())\n+    repairs = commands.add_parser('continue-repairs', help='resume source-bound receipt/merchant and returned evidence repairs in a new derived result')\n+    repairs.add_argument('parent_run', type=Path)\n+    repairs.add_argument('response', type=Path)\n+    repairs.add_argument('output', type=Path)\n+    repairs.add_argument('--evidence-dir', type=Path, required=True)\n+    repairs.add_argument('--run-id', required=True)\n+    repairs.add_argument('--schema', type=Path, default=_default_schema_path())\n     readiness = commands.add_parser(\"validate-readiness\", help=\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\")\n     readiness.add_argument(\"run_dir\", type=Path)\n     readiness.add_argument(\"--schema\", type=Path, default=_default_schema_path())\n@@ -123,6 +130,16 @@ def build_parser() -> argparse.ArgumentParser:\n \n def main(argv: list[str] | None = None) -> int:\n     args = build_parser().parse_args(argv)\n+    if args.command == 'continue-repairs':\n+        from .repair_continuation import continue_repairs\n+        try:\n+            result = continue_repairs(args.parent_run, args.response, args.evidence_dir, args.output,\n+                run_id=args.run_id, schema_path=args.schema)\n+        except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:\n+            print(f'Repair continuation rejected: {exc}', file=sys.stderr)\n+            return 1\n+        print(f\"OFFLINE REPAIR CONTINUATION {result['run_id']}: {'unchanged replay' if result['replayed'] else 'derived result verified'}; {result['output']}; human review and financial authority remain required\")\n+        return 0\n     if args.command == 'continue-receipt':\n         from .receipt_continuation import continue_receipt\n         try:\ndiff --git a/src/travel_claim/outputs.py b/src/travel_claim/outputs.py\nindex 6f1f267..c5140ab 100644\n--- a/src/travel_claim/outputs.py\n+++ b/src/travel_claim/outputs.py\n@@ -289,6 +289,7 @@ def apply_partial_response(\n     run_id: str,\n     batch_id: str,\n     evidence_directory: Path | None = None,\n+    admission_errors: dict[str, str] | None = None,\n ) -> None:\n     \"\"\"Record a supplied response against explicitly matched repair item IDs.\n \n@@ -301,6 +302,10 @@ def apply_partial_response(\n         raise ValueError(\"response_id is required\")\n     if not isinstance(item_outcomes, dict):\n         raise ValueError(\"item_outcomes must map repair item IDs to outcomes\")\n+    admission_errors = admission_errors or {}\n+    if (not set(admission_errors) <= set(item_outcomes)\n+            or any(not isinstance(v, str) or not v.strip() for v in admission_errors.values())):\n+        raise ValueError(\"context admission errors must identify response items and reasons\")\n     planned = []\n     for item_id, outcome in item_outcomes.items():\n         if item_id not in queue[\"items\"]:\n@@ -343,6 +348,7 @@ def apply_partial_response(\n                 verify_response_evidence(item, outcome, response_id, evidence_directory)\n             except (ValueError, KeyError, IndexError, TypeError, OSError) as exc:\n                 admission_error = f\"Response evidence held: {exc}\"\n+            admission_error = admission_error or admission_errors.get(item_id)\n         planned.append((item_id, item, kind, normalized_refs, None, admission_error))\n \n     # Mutate only after every item in this partial response passed validation.\ndiff --git a/src/travel_claim/receipt_continuation.py b/src/travel_claim/receipt_continuation.py\nindex 5fa73ee..a026d77 100644\n--- a/src/travel_claim/receipt_continuation.py\n+++ b/src/travel_claim/receipt_continuation.py\n@@ -143,9 +143,17 @@ def _report(state):\n              f\"Response: `{state['response']['response_id']}`. Native policy access: separately retained in parent sources.json.\",\n              'The local revalidation ordinal follows the parent arrivals; it is not an additional supplied arrival batch or a business timestamp.', '',\n              '## Response and revalidation', '']\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        lines[0] = '# Project D repair continuation — OFFLINE DERIVED RESULT'\n+        lines[6] = f\"Response: `{state['response']['response_id']}`. Native acquisition observations: [original sources.json]({state['native_source_manifest_path']}); supplemental replies do not change them.\"\n+        lines += ['Receipt and merchant evidence may resume checks; reviewer returns require current human re-review.', '']\n+        for delivery in state.get('repair_deliveries', []):\n+            lines.append(f\"- Response history `{delivery['response_id']}`: run `{delivery['run_id']}`, batch `{delivery['batch_id']}`; admitted items: {[x['item_id'] for x in delivery['admitted']]}; held items: {delivery['holds']}; source holds: {delivery['source_errors']}\")\n     for item, outcome in state['response']['item_outcomes'].items():\n         entry = state['repair_queue']['items'][item]\n         lines.append(f\"- `{item}`: {outcome['outcome']}; {entry['status']}; note: {outcome.get('note') or ''}; evidence: {outcome.get('source_refs', [])}\")\n+        if item in state.get('response_holds', {}):\n+            lines.append('  - Held: ' + state['response_holds'][item])\n     for cid in state['revalidated_claims']:\n         workflow = state['ordinary_workflows'][cid]\n         lines += [f\"- `{cid}` r{workflow['revision']}: {workflow['status']}; \" + '; '.join(\n@@ -168,9 +176,13 @@ def _report(state):\n     return '\\n'.join(lines)\n \n \n-def verify_continuation(output):\n+def verify_continuation(output, _seen=None):\n     \"\"\"Read-only integrity/consistency check; not submission or business approval.\"\"\"\n     output = Path(output).resolve()\n+    seen = set() if _seen is None else _seen\n+    if output in seen:\n+        raise ValueError('Continuation predecessor cycle')\n+    seen.add(output)\n     binding = read(output / 'continuation.json')\n     for path, sha in binding['output_hashes'].items():\n         if digest(confined(output, path)) != sha:\n@@ -179,13 +191,22 @@ def verify_continuation(output):\n     for path, sha in binding['parent_hashes'].items():\n         if digest(confined(parent, path)) != sha:\n             raise ValueError('Historical parent evidence changed: ' + path)\n+    if (parent / 'continuation.json').exists():\n+        verify_continuation(parent, seen)\n     state = read(output / 'continuation-state.json')\n+    if state.get('mode') == 'offline-general-repair-continuation':\n+        current = read(output / 'continuation-input.json').get('repair_continuation', {})\n+        if (current.get('mode') != state['mode'] or current.get('run_id') != state['run_id']\n+                or current.get('evidence_binding') != {'path': 'response-evidence/sources.json',\n+                    'sha256': digest(output / 'response-evidence/sources.json')}):\n+            raise ValueError('Continuation input and supplemental evidence binding disagree')\n     queue = load_repair_queue(output / 'repair-queue.json')\n     if queue != state['repair_queue'] or read(output / 'ordinary-workflow.json')['claims'] != state['ordinary_workflows']:\n         raise ValueError('Continuation queue/workflow/state disagree')\n     if read(output / 'response.json') != state['response']:\n         raise ValueError('Continuation response and state disagree')\n-    historical = read(parent / 'offline-replay-state.json')\n+    historical = read(parent / ('offline-replay-state.json' if (parent / 'offline-replay-state.json').exists()\n+                                else 'continuation-state.json'))\n     for key in ('finance_reconciliations', 'decision_history', 'revision_history', 'cancellation_state',\n                 'source_record_history', 'material_corrections'):\n         if state[key] != historical[key]:\n\"\"\"Bounded, resumable expense-evidence repairs; no decision or cash importer.\"\"\"\nfrom copy import deepcopy\nfrom datetime import datetime\nfrom decimal import InvalidOperation\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport tempfile\nfrom zipfile import BadZipFile\nfrom xml.etree.ElementTree import ParseError\n\nfrom pypdf.errors import PdfReadError\nfrom openpyxl.utils.exceptions import InvalidFileException\n\nfrom .event_validation import observation_error, utc_time\nfrom .expenses import number, validate_employee_date\nfrom .follow_up import render_follow_up_drafts\nfrom .integration import _sync_ordinary_repairs\nfrom .ordinary import connect_claim, expense_lines, fields, ref, table\nfrom .outputs import (apply_partial_response, validate_partial_response_journal,\n                      verify_response_evidence, project_claim_outputs, write_claims_csv, write_repair_queue)\nfrom .parsing import _pdf_pages, _receipt_records, _workbook_sheets\nfrom .receipt_continuation import (confined, digest, read, write, parent_evidence,\n                                   verify_continuation, _project, _report)\n\nMODE = 'offline-general-repair-continuation'\n\n\ndef load_parent(parent, schema):\n    if (parent / 'offline-replay-state.json').exists():\n        manifest, parsed, state, snapshot, queue, hashes = parent_evidence(parent, schema)\n        state['claims'] = snapshot['claims']\n        state['external_blockers'] = parsed.get('unresolved_issues', [])\n        state['parent_sealed_batches'] = state.pop('sealed_batches')\n        state['parent_parsed_records_path'] = state.pop('parsed_records_path')\n        state['parent_snapshot_hashes'] = {p: h for p, h in hashes.items() if p.startswith('batches/')}\n        return parent, manifest, parsed, state, queue, snapshot['travel_cancellations'], hashes\n    binding = verify_continuation(parent)\n    state = read(parent / 'continuation-state.json')\n    if state['mode'] != MODE:\n        raise ValueError('Resume requires an original replay or continue-repairs result')\n    root = (parent / binding['root_path']).resolve()\n    manifest = read(root / 'sources.json')\n    parsed = read(parent / 'continuation-input.json')\n    hashes = {p: digest(confined(parent, p)) for p in list(binding['output_hashes']) + ['continuation.json']}\n    return root, manifest, parsed, state, state['repair_queue'], state['travel_cancellations'], hashes\n\n\ndef retain_delivery(incoming, staging, prior, clock, response_id):\n    \"\"\"Retain even bad bytes; only freshly parsed, verified pieces are admissible.\"\"\"\n    if prior and (prior / 'response-evidence').exists():\n        shutil.copytree(prior / 'response-evidence', staging)\n        combined = read(staging / 'sources.json')\n        parsed = (read(staging / 'parsed-records.json') if (staging / 'parsed-records.json').exists()\n                  else {'pdf_pages': [], 'workbook_sheets': [], 'records': {'receipts': []}}…5010 tokens truncated…ternal_blockers'])\n        (output / 'follow-up-drafts.md').write_text(drafts, encoding='utf-8')\n        (output / 'report.md').write_text(_report(state), encoding='utf-8')\n        outputs = {p.relative_to(output).as_posix(): digest(p) for p in output.rglob('*') if p.is_file()}\n        write(output / 'continuation.json', dict(version='repair-continuation/1', run_id=run_id,\n            input_sha256=fingerprint, parent_path=os.path.relpath(parent, output), root_path=os.path.relpath(root, output),\n            parent_hashes=hashes, output_hashes=outputs, fresh_native_reads_performed=False))\n        verify_continuation(output)\n    return dict(run_id=run_id, output=output, replayed=False)\n\"\"\"End-to-end synthetic employee evidence; no real responses or authority.\"\"\"\nfrom copy import deepcopy\nimport csv\nimport io\nimport json\nfrom pathlib import Path\n\nfrom openpyxl import Workbook, load_workbook\nimport pytest\n\nfrom test_receipt_continuation import base_run, pdf, receipt, sha, hashes, SCHEMA, POLICY\nfrom travel_claim.cli import main\nfrom travel_claim.ordinary import fields, ref\nfrom travel_claim.parsing import parse_retained_run, _workbook_sheets, _pdf_pages, _receipt_records\nfrom travel_claim.policy_evidence import create_policy_replay\nfrom travel_claim.receipt_continuation import verify_continuation\nfrom travel_claim.sources import SOURCES, capture_sources\n\n\ndef get(path):\n    return json.loads(path.read_text())\n\n\ndef save(path, data):\n    path.write_text(json.dumps(data, indent=2))\n\n\ndef parent(tmp_path, *, missing_merchants=('A',), returned=False, corrected=False):\n    seed = tmp_path / 'seed'; seed.mkdir()\n    first = base_run(seed)\n    workbook = load_workbook(first / 'sources/travel-registers-workbook.xlsx')\n    tab = workbook['Merchant payments']\n    for row in reversed(range(3, tab.max_row + 1)):\n        if tab.cell(row, 2).value in {'COST-' + c for c in missing_merchants}:\n            tab.delete_rows(row)\n    if returned:\n        original = get(first / 'parsed-records.json')\n        sample = get(Path(__file__).parent / 'fixtures/ordinary_claim_c01.json')\n        packet = {k: v['value'] for k, v in next(s for s in sample['workbook_sheets'] if s['name']=='Review packets')['records'][0]['values'].items()}\n        packet.update({'Decision reference':'SYN-RETURN-A', 'Trip reference':'T-A', 'Expense references':'COST-A'})\n        decision = {k:v['value'] for k,v in sample['records']['decisions'][0]['values'].items()}\n        decision.update({'Decision reference':'SYN-RETURN-A','Subject reference':'SYN-A', 'Outcome':'return',\n                         'Repair requested':'Supply receipt and settled merchant proof for COST-A',\n                         'Source revisions':'POL-2026.2\\n'+sha(first/'sources/initial-claim-binder.pdf')})\n        for name, row in [('Review packets',packet),('Review ledger',decision)]:\n            sheet=workbook[name];sheet.delete_rows(1,sheet.max_row)\n            sheet.append(list(row));sheet.append(list(row.values()))\n    buffer=io.BytesIO();workbook.save(buffer)\n    bodies={s.source_id: (first/next(r['path'] for r in get(first/'sources.json')['files']\n                                   if r['source_id']==s.source_id)).read_bytes()\n            for s in SOURCES if s.source_id!='policy-pol-2026-2'}\n    bodies.update({'policy-pol-2026-2':b'SYNTHETIC generic Notion shell', 'travel-registers-workbook':buffer.getvalue()})\n    if corrected:\n        from travel_claim.parsing import _pdf_pages\n        original_page=_pdf_pages(first/'sources/initial-claim-binder.pdf','synthetic','synthetic')[0]['text']\n        bodies['claim-updates-binder']=pdf([original_page.replace('Revision: 1','Revision: 2').replace('Arrival batch: 1','Arrival batch: 3')])\n    def fetch(url, timeout):\n        s=next(s for s in SOURCES if (s.export_url or s.url)==url)\n        return bodies[s.source_id],{},url\n    source=tmp_path/'source'\n    capture_sources(source,run_id='source',case_clock=None,fetch=fetch,observed_at=lambda:'2026-10-01T12:00:00Z')\n    parse_retained_run(source)\n    result=tmp_path/'parent'\n    create_policy_replay(source,result,run_id='parent',browser_policy=POLICY,schema_path=SCHEMA)\n    return result\n\n\ndef bundle(tmp_path, parent_path, *, name='one', specs=None, insufficient=()):\n    \"\"\"spec = (claim suffix, item, kind, superseded refs).\"\"\"\n    incoming=tmp_path/('incoming-'+name);incoming.mkdir()\n    rows=[];outcomes={};assessments={}\n    specs=specs or [('A','ordinary:SYN-A:r1:supporting_evidence','receipt',[])]\n    for index,(cid,item,kind,supersedes) in enumerate(specs):\n        sid=f'SYN-{name}-{index}';path=incoming/(sid+('.pdf' if kind=='receipt' else '.xlsx'))\n        if kind=='receipt':\n            path.write_bytes(pdf([receipt(cid)]));record=_receipt_records(_pdf_pages(path,sid,sha(path)))[0]\n        else:\n            workbook=Workbook();sheet=workbook.active;sheet.title='Merchant payments'\n            value={'Transaction reference':'SYN-M-'+cid,'Expense reference':'COST-'+cid,'Employee ID':'EMP-01',\n                   'Trip reference':'T-'+cid,'Currency':'EUR','Gross amount':'100.00','Paid date':'2026-09-01',\n                   'Payment status':'settled','Receipt reference':'R-COST-'+cid}\n            sheet.append(list(value));sheet.append(list(value.values()));workbook.save(path)\n            record=_workbook_sheets(path,sid,sha(path))[0]['records'][0]\n        rows.append(dict(source_id=sid,path=path.name,sha256=sha(path),status='read',error=None,missing_scope=[],\n                         version=sha(path),observed_at='2026-10-02T12:00:00Z'))\n        outcome=outcomes.setdefault(item,dict(outcome='supported',note='SYNTHETIC response for '+item,source_refs=[],repairs=[]))\n        outcome['source_refs'].append(ref(record));outcome['repairs'].append(dict(kind=kind,record_ref=ref(record),supersedes_refs=supersedes))\n    for index,(item,outcome) in enumerate(outcomes.items()):\n        cid=item.split(':')[1]\n        revision=int(item.split(':')[2][1:])\n        assessments[str(index)]=dict(item_id=item,subject_type='claim',subject_id=cid,revision=revision,response_id='SYN-'+name,\n            actor_id='EMP-01',sufficient=True,reason='SYNTHETIC supplied evidence for exact expense',\n            provenance='SYNTHETIC employee response',evidence_refs=outcome['source_refs'],repairs=outcome['repairs'])\n        if ':review_return:' in item:\n            state=get(parent_path/('offline-replay-state.json' if (parent_path/'offline-replay-state.json').exists() else 'continuation-state.json'))\n            from travel_claim.repair_continuation import return_context\n            decision=return_context(state,item,cid,revision)\n            assessments[str(index)].update(return_decision_ref=ref(decision['raw_record']),repair_requested=decision['repair_requested'])\n    proof=incoming/'assessment.json';save(proof,assessments)\n    proof_id='SYN-assess-'+name\n    rows.append(dict(source_id=proof_id,path=proof.name,sha256=sha(proof),status='read',error=None,missing_scope=[],\n                     version=sha(proof),observed_at='2026-10-02T12:00:00Z'))\n    for index,outcome in enumerate(outcomes.values()):outcome['assessment_ref']=f'{proof_id}@{sha(proof)}#/{index}'\n    for item in insufficient:outcomes[item]=dict(outcome='insufficient',note='SYNTHETIC still missing',source_refs=[])\n    save(incoming/'sources.json',dict(files=rows))\n    response=tmp_path/('response-'+name+'.json')\n    save(response,dict(response_version='repair-response/1',response_id='SYN-'+name,actor_id='EMP-01',item_outcomes=outcomes))\n    return response,incoming\n\n\ndef run(parent_path, response, evidence, output):\n    return main(['continue-repairs',str(parent_path),str(response),str(output),'--evidence-dir',str(evidence),'--run-id',output.name])\n\n\ndef stage(state,cid,name):\n    return next(s for s in state['ordinary_workflows'][cid]['stages'] if s['stage']==name)['status']\n\n\ndef test_multiple_evidence_types_partial_response_and_repeated_resumption(tmp_path):\n    p=parent(tmp_path);before=hashes(p);old=get(p/'offline-replay-state.json')\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,insufficient=[b]);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    first=get(one/'continuation-state.json')\n    assert stage(first,'SYN-A','supporting_evidence')=='BLOCKED'  # Receipt alone cannot prove payment.\n    assert first['repair_queue']['items'][a]['status']=='open'\n    assert first['repair_queue']['items'][b]['status']=='open'\n    second_response,second_evidence=bundle(tmp_path,one,name='two',specs=[('A',a,'merchant-payment',[])],insufficient=[b])\n    two=tmp_path/'two';assert run(one,second_response,second_evidence,two)==0\n    final=get(two/'continuation-state.json');verify_continuation(two)\n    assert stage(final,'SYN-A','supporting_evidence')=='PASS'\n    assert final['repair_queue']['items'][a]['status']=='resolved'\n    assert final['repair_queue']['items'][b]['status']=='open'\n    assert final['ordinary_workflows']['SYN-B']==old['ordinary_workflows']['SYN-B']\n    assert final['ordinary_workflows']['SYN-C']==old['ordinary_workflows']['SYN-C']\n    assert final['finance_reconciliations']==old['finance_reconciliations']\n    assert final['decision_history']==old['decision_history']\n    assert final['revision_history']==old['revision_history']\n    assert final['cancellation_state']==old['cancellation_state']\n    assert final['budget_reconciliation']['scopes']==old['budget_reconciliation']['scopes']\n    assert final['budget_history']==old['budget_history']\n    assert final['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert final['ordinary_workflows']['SYN-A']['request'] is None\n    assert all(not w['status'].startswith('closed-') for w in final['ordinary_workflows'].values())\n    drafts=(two/'follow-up-drafts.md').read_text();assert f'Item `{a}`' not in drafts and f'Item `{b}`' in drafts\n    assert 'supporting_evidence=PASS' in (two/'report.md').read_text()\n    assert (two/final['native_source_manifest_path']).resolve()==(p/'sources.json').resolve()\n    row=next(r for r in csv.DictReader((two/'claims.csv').open()) if r['claim_id']=='SYN-A')\n    assert row['status']=='pending' and row['paid_cents']=='10000' and row['balance_cents']==''\n    assert row['revision']=='1' and row['trip_id']=='T-A'\n    assert row['allowed_cents']==str(final['ordinary_workflows']['SYN-A']['allowed_cents'])\n    unchanged=hashes(two);assert run(one,second_response,second_evidence,two)==0 and hashes(two)==unchanged\n    # Same response redelivered against the advanced state creates no new effect/result.\n    assert run(two,second_response,second_evidence,tmp_path/'retry')==0\n    assert not (tmp_path/'retry').exists() and hashes(two)==unchanged\n    another,another_evidence=bundle(tmp_path,two,name='three',specs=[('B',b,'receipt',[])])\n    assert run(two,another,another_evidence,tmp_path/'reuse'/'one')==1\n    assert not (tmp_path/'reuse').exists()\n    assert hashes(p)==before and len(list((p/'batches').glob('*.json')))==4\n    for key,item in old['repair_queue']['items'].items():\n        if item['subject_id'] not in {'SYN-A','SYN-B'}:assert final['repair_queue']['items'][key]==item\n\n\ndef test_valid_item_progresses_while_other_invalid_evidence_is_held(tmp_path):\n    p=parent(tmp_path,missing_merchants=())\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',a,'receipt',[]),('B',b,'receipt',[])])\n    bad=evidence/'SYN-one-1.pdf';bad.write_bytes(bad.read_bytes()+b'tampered')\n    out=tmp_path/'mixed';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json');q=state['repair_queue']\n    assert q['items'][a]['status']=='resolved' and q['items'][b]['status']=='open'\n    event=next(e for e in q['events'] if e.get('item_id')==b and e['event']=='response-recorded')\n    assert event['admission_status']=='held' and 'hash' in event['admission_reason']\n    assert (out/'response-evidence'/next(r['path'] for r in get(out/'response-evidence/sources.json')['files'] if r['source_id']=='SYN-one-1')).read_bytes()==bad.read_bytes()\n    verify_continuation(out)\n\n\n@pytest.mark.parametrize('fault',['stale','wrong-actor','wrong-hash','missing-file','wrong-revision-assessment','wrong-operation','unknown-ref','future','wrong-gross','invalid-number','unsupported'])\ndef test_negative_deliveries_never_resolve_or_authorize(tmp_path,fault):\n    p=parent(tmp_path);before=hashes(p);response,evidence=bundle(tmp_path,p)\n    obj=get(response);key=next(iter(obj['item_outcomes']))\n    if fault=='stale':obj['item_outcomes'][key.replace(':r1:',':r2:')]=obj['item_outcomes'].pop(key)\n    elif fault=='wrong-actor':obj['actor_id']='UNAUTHORIZED'\n    elif fault=='wrong-hash':(evidence/'SYN-one-0.pdf').write_bytes(b'tampered')\n    elif fault=='missing-file':(evidence/'SYN-one-0.pdf').unlink()\n    elif fault=='unknown-ref':obj['item_outcomes'][key]['source_refs']=['missing@'+'0'*64+'#row 1']\n    elif fault=='unsupported':obj['item_outcomes']['ordinary:SYN-A:r1:required_approvals']=obj['item_outcomes'].pop(key)\n    elif fault=='future':\n        manifest=get(evidence/'sources.json');manifest['files'][0]['observed_at']='2026-11-16T12:00:00Z';save(evidence/'sources.json',manifest)\n    else:\n        proof=get(evidence/'assessment.json')\n        if fault=='wrong-revision-assessment':proof['0']['revision']=2\n        elif fault=='wrong-operation':proof['0']['repairs'][0]['kind']='approval'\n        else:\n            # A real, hash-bound PDF with mismatched gross is not sufficient either.\n            path=evidence/'SYN-one-0.pdf';path.write_bytes(pdf([receipt(amount='invalid' if fault=='invalid-number' else '99.00')]))\n            rr=f'SYN-one-0@{sha(path)}#PDF page 1, receipt 1'\n            obj['item_outcomes'][key]['source_refs']=[rr];obj['item_outcomes'][key]['repairs'][0]['record_ref']=rr\n            proof['0']['evidence_refs']=[rr];proof['0']['repairs'][0]['record_ref']=rr\n        save(evidence/'assessment.json',proof);manifest=get(evidence/'sources.json')\n        for row in manifest['files']:row['sha256']=sha(evidence/row['path'])\n        save(evidence/'sources.json',manifest);obj['item_outcomes'][key]['assessment_ref']=f'SYN-assess-one@{sha(evidence/\"assessment.json\")}#/0'\n    save(response,obj);out=tmp_path/'negative'\n    rc=run(p,response,evidence,out)\n    if fault in {'stale','wrong-actor'}:assert rc==1 and not out.exists()\n    else:\n        assert rc==0\n        state=get(out/'continuation-state.json');assert state['response_holds']\n        assert all(i['status']=='open' for k,i in state['repair_queue']['items'].items() if k in obj['item_outcomes'])\n        assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    assert hashes(p)==before\n\n\ndef test_returned_work_receives_evidence_but_requires_human_re_review(tmp_path):\n    p=parent(tmp_path,returned=True)\n    old=get(p/'offline-replay-state.json');wf=old['ordinary_workflows']['SYN-A']\n    item='ordinary:SYN-A:r1:review_return:SYN-RETURN-A'\n    assert item in old['repair_queue']['items'] and old['repair_queue']['items'][item]['status']=='open'\n    response,evidence=bundle(tmp_path,p,specs=[('A',item,'receipt',[])])\n    partial=tmp_path/'returned-partial';assert run(p,response,evidence,partial)==0\n    assert get(partial/'continuation-state.json')['repair_queue']['items'][item]['status']=='open'\n    response2,evidence2=bundle(tmp_path,partial,name='returned-two',specs=[('A',item,'merchant-payment',[])])\n    out=tmp_path/'returned';assert run(partial,response2,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    assert stage(state,'SYN-A','required_approvals')=='BLOCKED'\n    assert state['repair_queue']['items'][item]['status']=='open'\n    assert state['repair_queue']['items'][item]['owner']=='ADMIN-01'\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['decision_history']==old['decision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n    assert 'human re-review' in (out/'report.md').read_text()\n\n\ndef test_original_evidence_and_derived_result_tampering_are_detected(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    (one/'claims.csv').write_text('tampered')\n    assert run(p,response,evidence,one)==1\n\n\ndef test_explicit_replacement_preserves_old_rows_and_conflicting_replay_is_rejected(tmp_path):\n    # Explicitly replace merchant proof, without changing any Finance event.\n    p=parent(tmp_path,missing_merchants=())\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    parsed=get(p/'parsed-records.json')\n    old_payment=next(r for s in parsed['workbook_sheets'] if s['name']=='Merchant payments'\n                     for r in s['records'] if fields(r).get('Expense reference')=='COST-A')\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',[]),('A',key,'merchant-payment',[ref(old_payment)])])\n    out=tmp_path/'replaced';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\n    changed=state['repair_deliveries'][0]['admitted'][0]['changes']\n    assert changed[1]['superseded']==[old_payment]\n    assert ref(old_payment) in get(response)['item_outcomes'][key]['repairs'][1]['supersedes_refs']\n    assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\n    before=hashes(out);obj=get(response);obj['item_outcomes'][key]['note']='conflicting replay';save(response,obj)\n    assert run(out,response,evidence,tmp_path/'conflict')==1 and hashes(out)==before\n\n\ndef test_unknown_supersession_is_held_and_unmatched_work_is_untouched(tmp_path):\n    p=parent(tmp_path)\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',['invented-ref'])])\n    out=tmp_path/'bad-replacement';assert run(p,response,evidence,out)==0\n    state=get(out/'continuation-state.json')\n    assert 'superseded' in state['response_holds'][key]\n    assert not state['revalidated_claims']\n    assert state['ordinary_workflows']==get(p/'offline-replay-state.json')['ordinary_workflows']\n\n\ndef test_descendant_checks_original_ancestor_and_response_evidence(tmp_path):\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\n    assert run(p,response,evidence,one)==0\n    key='ordinary:SYN-A:r1:supporting_evidence'\n    response2,evidence2=bundle(tmp_path,one,name='two',specs=[('A',key,'merchant-payment',[])])\n    two=tmp_path/'two';assert run(one,response2,evidence2,two)==0\n    original=p/'sources/receipt-binder.pdf';original.write_bytes(original.read_bytes()+b'tampered')\n    with pytest.raises(ValueError,match='parent evidence changed'):\n        verify_continuation(two)\n\n\ndef test_current_corrected_revision_resumes_but_old_revision_response_is_rejected(tmp_path):\n    p=parent(tmp_path,corrected=True)\n    old=get(p/'offline-replay-state.json');assert old['ordinary_workflows']['SYN-A']['revision']==2\n    stale,evidence=bundle(tmp_path,p)\n    assert run(p,stale,evidence,tmp_path/'stale')==1\n    item='correction:SYN-A:r2:expense-evidence'\n    assert old['repair_queue']['items'][item]['status']=='open'\n    response,evidence2=bundle(tmp_path,p,name='current',specs=[('A',item,'receipt',[]),('A',item,'merchant-payment',[])])\n    out=tmp_path/'corrected';assert run(p,response,evidence2,out)==0\n    state=get(out/'continuation-state.json')\n    assert state['repair_queue']['items'][item]['status']=='resolved'\n    assert state['ordinary_workflows']['SYN-A']['revision']==2\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\n    assert state['revision_history']==old['revision_history']\n    assert state['finance_reconciliations']==old['finance_reconciliations']\n"},"started_at_ms":1792480893952,"completed_at_ms":1792480894107}}
{"timestamp":"2026-10-20T07:21:34.624Z","ordinal":10684,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a1582f-dea0-7fd2-afbd-792ae1bd35e7","call_id":"call_61c0e6514ece41f282af6104de3beda7","output":[{"type":"input_text","text":"Script completed\nWall time 3.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 15350)\nTotal output lines: 3\n\n{\"chunk_id\":\"a9869a\",\"wall_time_seconds\":1.001770235,\"session_id\":70148,\"original_token_count\":0,\"output\":\"\"}\n{\"chunk_id\":\"6b4c49\",\"wall_time_seconds\":1.001388337,\"session_id\":67499,\"original_token_count\":0,\"output\":\"\"}\n{\"chunk_id\":\"c77ce6\",\"wall_time_seconds\":0.154820917,\"exit_code\":0,\"original_token_count\":15010,\"output\":\"diff --git a/README.md b/README.md\\nindex 8b93657..a32599f 100644\\n--- a/README.md\\n+++ b/README.md\\n@@ -73,6 +73,78 @@ The owner-grouped repair queue API is in `travel_claim.outputs`. Queue items ret\\n \\n ## Verification\\n \\n+### Resumable evidence and returned-work repairs (Omega Attempt 3)\\n+\\n+From a restored offline replay, use a fresh result directory:\\n+\\n+```bash\\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\\n+travel-claim continue-repairs \\\\\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\\\\n+  response.json \\\"$REPAIR_CHECK_DIR/repair-one\\\" \\\\\\n+  --evidence-dir response-evidence --run-id repair-one\\n+# A later authentic response can resume that result, retaining the full chain:\\n+travel-claim continue-repairs \\\\\\n+  \\\"$REPAIR_CHECK_DIR/repair-one\\\" later-response.json \\\\\\n+  \\\"$REPAIR_CHECK_DIR/repair-two\\\" \\\\\\n+  --evidence-dir later-response-evidence --run-id repair-two\\n+```\\n+\\n+Supply authentic employee responses, not generated answers. The envelope uses\\n+`response_version: repair-response/1`, a stable `response_id`, employee `actor_id`\\n+and exact `item_outcomes`. Each item retains its own outcome, note and refs.\\n+Supported item IDs are current claim `ordinary:<id>:r<revision>:supporting_evidence`,\\n+`correction:<id>:r<revision>:expense-evidence`, and\\n+`ordinary:<id>:r<revision>:review_return:<decision-id>`. Non-claim items reject\\n+this bounded command; unsupported claim approval, Finance, exception, policy\\n+and budget repairs remain held.\\n+\\n+A supported outcome has `source_refs`, `assessment_ref`, and a nonempty `repairs`\\n+array. Each operation has `kind` (`receipt` or `merchant-payment`), exact\\n+`record_ref`, and `supersedes_refs` (empty for missing evidence; otherwise every\\n+current row it explicitly replaces). A supplied JSON sufficiency assessment\\n+binds the same item, subject, integer revision, response ID, employee `actor_id`,\\n+reason, provenance, `evidence_refs` and **identical repairs array**. A reviewer\\n+return also requires its exact `return_decision_ref` and original `repair_requested`\\n+text. Matching actor identifiers do not independently authenticate the speaker.\\n+\\n+Use the receipt continuation manifest/reference format below. Receipt evidence\\n+is a searchable PDF in the existing receipt-card schema. Merchant evidence is\\n+an XLSX containing one nonempty `Merchant payments` tab with the existing native\\n+headers. PDF and XLSX bytes are re-parsed; caller-provided parsed rows cannot\\n+establish authority. Proof must match the current employee/trip/cost/receipt,\\n+currency and full gross amount. Merchant proof additionally needs transaction\\n+identity, settled status and an admissible payment date. Split-payment repairs\\n+and shared-cost replacements require a broader adapter and remain held. New\\n+deliveries need distinct supplemental source IDs; native IDs cannot be replaced.\\n+\\n+Valid independent items progress while unverifiable, insufficient or conflicting\\n+items stay open. Bad declared hashes/observations and mismatched rows are retained\\n+with admission reasons. Unknown items, stale revisions or wrong employees reject\\n+the command without creating a result. The command rechecks affected claims,\\n+updates queue/CSV/report/unsent drafts and retains old evidence/replacement history.\\n+An evidence response does not approve a returned claim: current human re-review\\n+and all other prerequisites still apply. No decisions, Finance events, cash or\\n+reimbursement authorizations are imported or created.\\n+\\n+Results retain `continuation-input.json`, state, exact response, supplemental\\n+evidence, output hashes and a recursively verified predecessor link. The four\\n+original snapshots are unchanged; response ordinals are local evaluation order,\\n+not additional native arrival batches or invented scenario times. Keep ancestors\\n+available at their recorded relative paths. Exact command replay is inert;\\n+exact response redelivery to its advanced state returns that existing result\\n+without creating another directory. Conflicting response IDs and corrupted\\n+history/results reject replay. Success (exit 0) can include held work: inspect\\n+`response_holds`, the report and queue. Exit 1 means rejection/integrity failure.\\n+Full-run `validate-readiness` does not accept this derived layout; built-in\\n+verification checks its chain and output consistency, not submission compliance.\\n+The receipt-only command remains compatible but its older derived format is\\n+not a resumable parent for `continue-repairs`.\\n+\\n+Connected synthetic examples are in `tests/test_repair_continuation.py`.\\n+No actual stakeholder response or new financial closure is demonstrated by them.\\n+Native Notion access remains separately blocked.\\n+\\n ### Missing-receipt continuation (Omega Attempt 2)\\n \\n `continue-receipt` accepts one supplied employee receipt response against an\\ndiff --git a/skills/travel-expense-claim/SKILL.md b/skills/travel-expense-claim/SKILL.md\\nindex 3df6657..257d8e6 100644\\n--- a/skills/travel-expense-claim/SKILL.md\\n+++ b/skills/travel-expense-claim/SKILL.md\\n@@ -175,8 +175,8 @@ then run the documented readiness command on the new run.\\n Source-driven rechecks may resolve matching repairs with an\\n `evidence-revalidated` event. This is not a stakeholder response. A separate\\n general repair-response journal uses internal APIs in\\n-[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The narrowly scoped\\n-`continue-receipt` command below is an exception; `policy-replay` does not import\\n+[`travel_claim.outputs`](../../src/travel_claim/outputs.py). The bounded\\n+`continue-receipt` and `continue-repairs` commands below expose supported slices; `policy-replay` does not import\\n responses automatically:\\n \\n - `apply_partial_response(queue, response_id=..., item_outcomes=..., run_id=...,\\n@@ -202,7 +202,7 @@ responses automatically:\\n   conflicting replay is rejected. Unknown item IDs or malformed outcomes reject\\n   the call. Changed subject revisions require current evidence: the internal\\n   `update_repair_item` API reopens advanced revisions while retaining history.\\n-- A developer must retain authentic evidence/assessments, load the queue, apply\\n+- For types outside those commands, a developer must retain authentic evidence/assessments, load the queue, apply\\n   the API, validate with `validate_partial_response_journal`, and persist a new\\n   reviewable result without rewriting historical outputs. Queue resolution alone\\n   does not rerun claim/Finance dependencies or regenerate snapshots, reports and\\n@@ -241,6 +241,40 @@ native-source run or sealed arrival batch, a general importer, or support for\\n chaining derived continuations. Parent evidence must stay available. Verification\\n is built into this command; full-run readiness expects the original replay layout.\\n \\n+### Resumable evidence and returned-work repairs\\n+\\n+Use `continue-repairs` for current claim supporting-evidence repairs, correction\\n+expense-evidence repairs and the evidence requested by a retained reviewer return.\\n+It accepts receipts plus settled merchant proof, multiple matched items and\\n+successive responses. See the [exact contract and invocation](../../README.md#resumable-evidence-and-returned-work-repairs-omega-attempt-3).\\n+\\n+```bash\\n+REPAIR_CHECK_DIR=$(mktemp -d /tmp/project-d-repairs-XXXXXXXX)\\n+travel-claim continue-repairs \\\\\\n+  artifacts/runs/project-d-stage7-terminal-20261016T110919Z-5afc36 \\\\\\n+  response.json \\\"$REPAIR_CHECK_DIR/repair-one\\\" \\\\\\n+  --evidence-dir response-evidence --run-id repair-one\\n+travel-claim continue-repairs \\\\\\n+  \\\"$REPAIR_CHECK_DIR/repair-one\\\" later-response.json \\\\\\n+  \\\"$REPAIR_CHECK_DIR/repair-two\\\" \\\\\\n+  --evidence-dir later-response-evidence --run-id repair-two\\n+```\\n+\\n+Retain supplied item-specific assessments and explicit replacement references.\\n+Only the verified selected rows enter the active evidence view; superseded rows,\\n+invalid bytes and original snapshots remain retained. Valid independent items\\n+progress; held items retain reasons. Inspect report, state, queue and unsent drafts\\n+even after exit 0. Stale/wrong-employee subjects and integrity failures reject.\\n+Exact replay is inert, including redelivery to an advanced result; conflicting\\n+response IDs cannot change history. Preserve all ancestor directories.\\n+\\n+Returned evidence triggers rechecks, never reviewer approval. Finance, policy,\\n+budget, exception, decision and independent cancellation imports are unsupported;\\n+split/shared expense changes need developer integration. No cash or authorization\\n+is changed. This is offline continuation with built-in chain/output checks,\\n+not fresh acquisition, an extra native arrival batch or full-run readiness.\\n+The older receipt-only result cannot be used as a continuation parent.\\n+\\n ## Errors, retries, and limitations\\n \\n - On source failure, retain the attempt URL, locator, UTC observation time, error, and missing scope. Hold only affected work and report its owner and resumption evidence.\\ndiff --git a/src/travel_claim/cli.py b/src/travel_claim/cli.py\\nindex 3b1d8bc..63b93b8 100644\\n--- a/src/travel_claim/cli.py\\n+++ b/src/travel_claim/cli.py\\n@@ -113,6 +113,13 @@ def build_parser() -> argparse.ArgumentParser:\\n     receipt.add_argument('--evidence-dir', type=Path, required=True)\\n     receipt.add_argument('--run-id', required=True)\\n     receipt.add_argument('--schema', type=Path, default=_default_schema_path())\\n+    repairs = commands.add_parser('continue-repairs', help='resume source-bound receipt/merchant and returned evidence repairs in a new derived result')\\n+    repairs.add_argument('parent_run', type=Path)\\n+    repairs.add_argument('response', type=Path)\\n+    repairs.add_argument('output', type=Path)\\n+    repairs.add_argument('--evidence-dir', type=Path, required=True)\\n+    repairs.add_argument('--run-id', required=True)\\n+    repairs.add_argument('--schema', type=Path, default=_default_schema_path())\\n     readiness = commands.add_parser(\\\"validate-readiness\\\", help=\\\"check local submission evidence; PASS/BLOCKED/FAIL, never live compliance\\\")\\n     readiness.add_argument(\\\"run_dir\\\", type=Path)\\n     readiness.add_argument(\\\"--schema\\\", type=Path, default=_default_schema_path())\\n@@ -123,6 +130,16 @@ def build_parser() -> argparse.ArgumentParser:\\n \\n def main(argv: list[str] | None = None) -> int:\\n     args = build_parser().parse_args(argv)\\n+    if args.command == 'continue-repairs':\\n+        from .repair_continuation import continue_repairs\\n+        try:\\n+            result = continue_repairs(args.parent_run, args.response, args.evidence_dir, args.output,\\n+                run_id=args.run_id, schema_path=args.schema)\\n+        except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:\\n+            print(f'Repair continuation rejected: {exc}', file=sys.stderr)\\n+            return 1\\n+        print(f\\\"OFFLINE REPAIR CONTINUATION {result['run_id']}: {'unchanged replay' if result['replayed'] else 'derived result verified'}; {result['output']}; human review and financial authority remain required\\\")\\n+        return 0\\n     if args.command == 'continue-receipt':\\n         from .receipt_continuation import continue_receipt\\n         try:\\ndiff --git a/src/travel_claim/outputs.py b/src/travel_claim/outputs.py\\nindex 6f1f267..c5140ab 100644\\n--- a/src/travel_claim/outputs.py\\n+++ b/src/travel_claim/outputs.py\\n@@ -289,6 +289,7 @@ def apply_partial_response(\\n     run_id: str,\\n     batch_id: str,\\n     evidence_directory: Path | None = None,\\n+    admission_errors: dict[str, str] | None = None,\\n ) -> None:\\n     \\\"\\\"\\\"Record a supplied response against explicitly matched repair item IDs.\\n \\n@@ -301,6 +302,10 @@ def apply_partial_response(\\n         raise ValueError(\\\"response_id is required\\\")\\n     if not isinstance(item_outcomes, dict):\\n         raise ValueError(\\\"item_outcomes must map repair item IDs to outcomes\\\")\\n+    admission_errors = admission_errors or {}\\n+    if (not set(admission_errors) <= set(item_outcomes)\\n+            or any(not isinstance(v, str) or not v.strip() for v in admission_errors.values())):\\n+        raise ValueError(\\\"context admission errors must identify response items and reasons\\\")\\n     planned = []\\n     for item_id, outcome in item_outcomes.items():\\n         if item_id not in queue[\\\"items\\\"]:\\n@@ -343,6 +348,7 @@ def apply_partial_response(\\n                 verify_response_evidence(item, outcome, response_id, evidence_directory)\\n             except (ValueError, KeyError, IndexError, TypeError, OSError) as exc:\\n                 admission_error = f\\\"Response evidence held: {exc}\\\"\\n+            admission_error = admission_error or admission_errors.get(item_id)\\n         planned.append((item_id, item, kind, normalized_refs, None, admission_error))\\n \\n     # Mutate only after every item in this partial response passed validation.\\ndiff --git a/src/travel_claim/receipt_continuation.py b/src/travel_claim/receipt_continuation.py\\nindex 5fa73ee..a026d77 100644\\n--- a/src/travel_claim/receipt_continuation.py\\n+++ b/src/travel_claim/receipt_continuation.py\\n@@ -143,9 +143,17 @@ def _report(state):\\n              f\\\"Response: `{state['response']['response_id']}`. Native policy access: separately retained in parent sources.json.\\\",\\n              'The local revalidation ordinal follows the parent arrivals; it is not an additional supplied arrival batch or a business timestamp.', '',\\n              '## Response and revalidation', '']\\n+    if state.get('mode') == 'offline-general-repair-continuation':\\n+        lines[0] = '# Project D repair continuation — OFFLINE DERIVED RESULT'\\n+        lines[6] = f\\\"Response: `{state['response']['response_id']}`. Native acquisition observations: [original sources.json]({state['native_source_manifest_path']}); supplemental replies do not change them.\\\"\\n+        lines += ['Receipt and merchant evidence may resume checks; reviewer returns require current human re-review.', '']\\n+        for delivery in state.get('repair_deliveries', []):\\n+            lines.append(f\\\"- Response history `{delivery['response_id']}`: run `{delivery['run_id']}`, batch `{delivery['batch_id']}`; admitted items: {[x['item_id'] for x in delivery['admitted']]}; held items: {delivery['holds']}; source holds: {delivery['source_errors']}\\\")\\n     for item, outcome in state['response']['item_outcomes'].items():\\n         entry = state['repair_queue']['items'][item]\\n         lines.append(f\\\"- `{item}`: {outcome['outcome']}; {entry['status']}; note: {outcome.get('note') or ''}; evidence: {outcome.get('source_refs', [])}\\\")\\n+        if item in state.get('response_holds', {}):\\n+            lines.append('  - Held: ' + state['response_holds'][item])\\n     for cid in state['revalidated_claims']:\\n         workflow = state['ordinary_workflows'][cid]\\n         lines += [f\\\"- `{cid}` r{workflow['revision']}: {workflow['status']}; \\\" + '; '.join(\\n@@ -168,9 +176,13 @@ def _report(state):\\n     return '\\\\n'.join(lines)\\n \\n \\n-def verify_continuation(output):\\n+def verify_continuation(output, _seen=None):\\n     \\\"\\\"\\\"Read-only integrity/consistency check; not submission or business approval.\\\"\\\"\\\"\\n     output = Path(output).resolve()\\n+    seen = set() if _seen is None else _seen\\n+    if output in seen:\\n+        raise ValueError('Continuation predecessor cycle')\\n+    seen.add(output)\\n     binding = read(output / 'continuation.json')\\n     for path, sha in binding['output_hashes'].items():\\n         if digest(confined(output, path)) != sha:\\n@@ -179,13 +191,22 @@ def verify_continuation(output):\\n     for path, sha in binding['parent_hashes'].items():\\n         if digest(confined(parent, path)) != sha:\\n             raise ValueError('Historical parent evidence changed: ' + path)\\n+    if (parent / 'continuation.json').exists():\\n+        verify_continuation(parent, seen)\\n     state = read(output / 'continuation-state.json')\\n+    if state.get('mode') == 'offline-general-repair-continuation':\\n+        current = read(output / 'continuation-input.json').get('repair_continuation', {})\\n+        if (current.get('mode') != state['mode'] or current.get('run_id') != state['run_id']\\n+                or current.get('evidence_binding') != {'path': 'response-evidence/sources.json',\\n+                    'sha256': digest(output / 'response-evidence/sources.json')}):\\n+            raise ValueError('Continuation input and supplemental evidence binding disagree')\\n     queue = load_repair_queue(output / 'repair-queue.json')\\n     if queue != state['repair_queue'] or read(output / 'ordinary-workflow.json')['claims'] != state['ordinary_workflows']:\\n         raise ValueError('Continuation queue/workflow/state disagree')\\n     if read(output / 'response.json') != state['response']:\\n         raise ValueError('Continuation response and state disagree')\\n-    historical = read(parent / 'offline-replay-state.json')\\n+    historical = read(parent / ('offline-replay-state.json' if (parent / 'offline-replay-state.json').exists()\\n+                                else 'continuation-state.json'))\\n     for key in ('finance_reconciliations', 'decision_history', 'revision_history', 'cancellation_state',\\n                 'source_record_history', 'material_corrections'):\\n         if state[key] != historical[key]:\\n\\\"\\\"\\\"Bounded, resumable expense-evidence repairs; no decision or cash importer.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nfrom datetime import datetime\\nfrom decimal import InvalidOperation\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport shutil\\nimport tempfile\\nfrom zipfile import BadZipFile\\nfrom xml.etree.ElementTree import ParseError\\n\\nfrom pypdf.errors import PdfReadError\\nfrom openpyxl.utils.exceptions import InvalidFileException\\n\\nfrom .event_validation import observation_error, utc_time\\nfrom .expenses import number, validate_employee_date\\nfrom .follow_up import render_follow_up_drafts\\nfrom .integration import _sync_ordinary_repairs\\nfrom .ordinary import connect_claim, expense_lines, fields, ref, table\\nfrom .outputs import (apply_partial_response, validate_partial_response_journal,\\n                      verify_response_evidence, project_claim_outputs, write_claims_csv, write_repair_queue)\\nfrom .parsing import _pdf_pages, _receipt_records, _workbook_sheets\\nfrom .receipt_continuation import (confined, digest, read, write, parent_evidence,\\n                                   verify_continuation, _project, _report)\\n\\nMODE = 'offline-general-repair-continuation'\\n\\n\\ndef load_parent(parent, schema):\\n    if (parent / 'offline-replay-state.json').exists():\\n        manifest, parsed, state, snapshot, queue, hashes = parent_evidence(parent, schema)\\n        state['claims'] = snapshot['claims']\\n        state['external_blockers'] = parsed.get('unresolved_issues', [])\\n        state['parent_sealed_batches'] = state.pop('sealed_batches')\\n        state['parent_parsed_records_path'] = state.pop('parsed_records_path')\\n        state['parent_snapshot_hashes'] = {p: h for p, h in hashes.items() if p.startswith('batches/')}\\n        return parent, manifest, parsed, state, queue, snapshot['travel_cancellations'], hashes\\n    binding = verify_continuation(parent)\\n    state = read(parent / 'continuation-state.json')\\n    if state['mode'] != MODE:\\n        raise ValueError('Resume requires an original replay or continue-repairs result')\\n    root = (parent / binding['root_path']).resolve()\\n    manifest = read(root / 'sources.json')\\n    parsed = read(parent / 'continuation-input.json')\\n    hashes = {…5350 tokens truncated…n', dict(version='repair-continuation/1', run_id=run_id,\\n            input_sha256=fingerprint, parent_path=os.path.relpath(parent, output), root_path=os.path.relpath(root, output),\\n            parent_hashes=hashes, output_hashes=outputs, fresh_native_reads_performed=False))\\n        verify_continuation(output)\\n    return dict(run_id=run_id, output=output, replayed=False)\\n\\\"\\\"\\\"End-to-end synthetic employee evidence; no real responses or authority.\\\"\\\"\\\"\\nfrom copy import deepcopy\\nimport csv\\nimport io\\nimport json\\nfrom pathlib import Path\\n\\nfrom openpyxl import Workbook, load_workbook\\nimport pytest\\n\\nfrom test_receipt_continuation import base_run, pdf, receipt, sha, hashes, SCHEMA, POLICY\\nfrom travel_claim.cli import main\\nfrom travel_claim.ordinary import fields, ref\\nfrom travel_claim.parsing import parse_retained_run, _workbook_sheets, _pdf_pages, _receipt_records\\nfrom travel_claim.policy_evidence import create_policy_replay\\nfrom travel_claim.receipt_continuation import verify_continuation\\nfrom travel_claim.sources import SOURCES, capture_sources\\n\\n\\ndef get(path):\\n    return json.loads(path.read_text())\\n\\n\\ndef save(path, data):\\n    path.write_text(json.dumps(data, indent=2))\\n\\n\\ndef parent(tmp_path, *, missing_merchants=('A',), returned=False, corrected=False):\\n    seed = tmp_path / 'seed'; seed.mkdir()\\n    first = base_run(seed)\\n    workbook = load_workbook(first / 'sources/travel-registers-workbook.xlsx')\\n    tab = workbook['Merchant payments']\\n    for row in reversed(range(3, tab.max_row + 1)):\\n        if tab.cell(row, 2).value in {'COST-' + c for c in missing_merchants}:\\n            tab.delete_rows(row)\\n    if returned:\\n        original = get(first / 'parsed-records.json')\\n        sample = get(Path(__file__).parent / 'fixtures/ordinary_claim_c01.json')\\n        packet = {k: v['value'] for k, v in next(s for s in sample['workbook_sheets'] if s['name']=='Review packets')['records'][0]['values'].items()}\\n        packet.update({'Decision reference':'SYN-RETURN-A', 'Trip reference':'T-A', 'Expense references':'COST-A'})\\n        decision = {k:v['value'] for k,v in sample['records']['decisions'][0]['values'].items()}\\n        decision.update({'Decision reference':'SYN-RETURN-A','Subject reference':'SYN-A', 'Outcome':'return',\\n                         'Repair requested':'Supply receipt and settled merchant proof for COST-A',\\n                         'Source revisions':'POL-2026.2\\\\n'+sha(first/'sources/initial-claim-binder.pdf')})\\n        for name, row in [('Review packets',packet),('Review ledger',decision)]:\\n            sheet=workbook[name];sheet.delete_rows(1,sheet.max_row)\\n            sheet.append(list(row));sheet.append(list(row.values()))\\n    buffer=io.BytesIO();workbook.save(buffer)\\n    bodies={s.source_id: (first/next(r['path'] for r in get(first/'sources.json')['files']\\n                                   if r['source_id']==s.source_id)).read_bytes()\\n            for s in SOURCES if s.source_id!='policy-pol-2026-2'}\\n    bodies.update({'policy-pol-2026-2':b'SYNTHETIC generic Notion shell', 'travel-registers-workbook':buffer.getvalue()})\\n    if corrected:\\n        from travel_claim.parsing import _pdf_pages\\n        original_page=_pdf_pages(first/'sources/initial-claim-binder.pdf','synthetic','synthetic')[0]['text']\\n        bodies['claim-updates-binder']=pdf([original_page.replace('Revision: 1','Revision: 2').replace('Arrival batch: 1','Arrival batch: 3')])\\n    def fetch(url, timeout):\\n        s=next(s for s in SOURCES if (s.export_url or s.url)==url)\\n        return bodies[s.source_id],{},url\\n    source=tmp_path/'source'\\n    capture_sources(source,run_id='source',case_clock=None,fetch=fetch,observed_at=lambda:'2026-10-01T12:00:00Z')\\n    parse_retained_run(source)\\n    result=tmp_path/'parent'\\n    create_policy_replay(source,result,run_id='parent',browser_policy=POLICY,schema_path=SCHEMA)\\n    return result\\n\\n\\ndef bundle(tmp_path, parent_path, *, name='one', specs=None, insufficient=()):\\n    \\\"\\\"\\\"spec = (claim suffix, item, kind, superseded refs).\\\"\\\"\\\"\\n    incoming=tmp_path/('incoming-'+name);incoming.mkdir()\\n    rows=[];outcomes={};assessments={}\\n    specs=specs or [('A','ordinary:SYN-A:r1:supporting_evidence','receipt',[])]\\n    for index,(cid,item,kind,supersedes) in enumerate(specs):\\n        sid=f'SYN-{name}-{index}';path=incoming/(sid+('.pdf' if kind=='receipt' else '.xlsx'))\\n        if kind=='receipt':\\n            path.write_bytes(pdf([receipt(cid)]));record=_receipt_records(_pdf_pages(path,sid,sha(path)))[0]\\n        else:\\n            workbook=Workbook();sheet=workbook.active;sheet.title='Merchant payments'\\n            value={'Transaction reference':'SYN-M-'+cid,'Expense reference':'COST-'+cid,'Employee ID':'EMP-01',\\n                   'Trip reference':'T-'+cid,'Currency':'EUR','Gross amount':'100.00','Paid date':'2026-09-01',\\n                   'Payment status':'settled','Receipt reference':'R-COST-'+cid}\\n            sheet.append(list(value));sheet.append(list(value.values()));workbook.save(path)\\n            record=_workbook_sheets(path,sid,sha(path))[0]['records'][0]\\n        rows.append(dict(source_id=sid,path=path.name,sha256=sha(path),status='read',error=None,missing_scope=[],\\n                         version=sha(path),observed_at='2026-10-02T12:00:00Z'))\\n        outcome=outcomes.setdefault(item,dict(outcome='supported',note='SYNTHETIC response for '+item,source_refs=[],repairs=[]))\\n        outcome['source_refs'].append(ref(record));outcome['repairs'].append(dict(kind=kind,record_ref=ref(record),supersedes_refs=supersedes))\\n    for index,(item,outcome) in enumerate(outcomes.items()):\\n        cid=item.split(':')[1]\\n        revision=int(item.split(':')[2][1:])\\n        assessments[str(index)]=dict(item_id=item,subject_type='claim',subject_id=cid,revision=revision,response_id='SYN-'+name,\\n            actor_id='EMP-01',sufficient=True,reason='SYNTHETIC supplied evidence for exact expense',\\n            provenance='SYNTHETIC employee response',evidence_refs=outcome['source_refs'],repairs=outcome['repairs'])\\n        if ':review_return:' in item:\\n            state=get(parent_path/('offline-replay-state.json' if (parent_path/'offline-replay-state.json').exists() else 'continuation-state.json'))\\n            from travel_claim.repair_continuation import return_context\\n            decision=return_context(state,item,cid,revision)\\n            assessments[str(index)].update(return_decision_ref=ref(decision['raw_record']),repair_requested=decision['repair_requested'])\\n    proof=incoming/'assessment.json';save(proof,assessments)\\n    proof_id='SYN-assess-'+name\\n    rows.append(dict(source_id=proof_id,path=proof.name,sha256=sha(proof),status='read',error=None,missing_scope=[],\\n                     version=sha(proof),observed_at='2026-10-02T12:00:00Z'))\\n    for index,outcome in enumerate(outcomes.values()):outcome['assessment_ref']=f'{proof_id}@{sha(proof)}#/{index}'\\n    for item in insufficient:outcomes[item]=dict(outcome='insufficient',note='SYNTHETIC still missing',source_refs=[])\\n    save(incoming/'sources.json',dict(files=rows))\\n    response=tmp_path/('response-'+name+'.json')\\n    save(response,dict(response_version='repair-response/1',response_id='SYN-'+name,actor_id='EMP-01',item_outcomes=outcomes))\\n    return response,incoming\\n\\n\\ndef run(parent_path, response, evidence, output):\\n    return main(['continue-repairs',str(parent_path),str(response),str(output),'--evidence-dir',str(evidence),'--run-id',output.name])\\n\\n\\ndef stage(state,cid,name):\\n    return next(s for s in state['ordinary_workflows'][cid]['stages'] if s['stage']==name)['status']\\n\\n\\ndef test_multiple_evidence_types_partial_response_and_repeated_resumption(tmp_path):\\n    p=parent(tmp_path);before=hashes(p);old=get(p/'offline-replay-state.json')\\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\\n    response,evidence=bundle(tmp_path,p,insufficient=[b]);one=tmp_path/'one'\\n    assert run(p,response,evidence,one)==0\\n    first=get(one/'continuation-state.json')\\n    assert stage(first,'SYN-A','supporting_evidence')=='BLOCKED'  # Receipt alone cannot prove payment.\\n    assert first['repair_queue']['items'][a]['status']=='open'\\n    assert first['repair_queue']['items'][b]['status']=='open'\\n    second_response,second_evidence=bundle(tmp_path,one,name='two',specs=[('A',a,'merchant-payment',[])],insufficient=[b])\\n    two=tmp_path/'two';assert run(one,second_response,second_evidence,two)==0\\n    final=get(two/'continuation-state.json');verify_continuation(two)\\n    assert stage(final,'SYN-A','supporting_evidence')=='PASS'\\n    assert final['repair_queue']['items'][a]['status']=='resolved'\\n    assert final['repair_queue']['items'][b]['status']=='open'\\n    assert final['ordinary_workflows']['SYN-B']==old['ordinary_workflows']['SYN-B']\\n    assert final['ordinary_workflows']['SYN-C']==old['ordinary_workflows']['SYN-C']\\n    assert final['finance_reconciliations']==old['finance_reconciliations']\\n    assert final['decision_history']==old['decision_history']\\n    assert final['revision_history']==old['revision_history']\\n    assert final['cancellation_state']==old['cancellation_state']\\n    assert final['budget_reconciliation']['scopes']==old['budget_reconciliation']['scopes']\\n    assert final['budget_history']==old['budget_history']\\n    assert final['ordinary_workflows']['SYN-A']['status']=='pending'\\n    assert final['ordinary_workflows']['SYN-A']['request'] is None\\n    assert all(not w['status'].startswith('closed-') for w in final['ordinary_workflows'].values())\\n    drafts=(two/'follow-up-drafts.md').read_text();assert f'Item `{a}`' not in drafts and f'Item `{b}`' in drafts\\n    assert 'supporting_evidence=PASS' in (two/'report.md').read_text()\\n    assert (two/final['native_source_manifest_path']).resolve()==(p/'sources.json').resolve()\\n    row=next(r for r in csv.DictReader((two/'claims.csv').open()) if r['claim_id']=='SYN-A')\\n    assert row['status']=='pending' and row['paid_cents']=='10000' and row['balance_cents']==''\\n    assert row['revision']=='1' and row['trip_id']=='T-A'\\n    assert row['allowed_cents']==str(final['ordinary_workflows']['SYN-A']['allowed_cents'])\\n    unchanged=hashes(two);assert run(one,second_response,second_evidence,two)==0 and hashes(two)==unchanged\\n    # Same response redelivered against the advanced state creates no new effect/result.\\n    assert run(two,second_response,second_evidence,tmp_path/'retry')==0\\n    assert not (tmp_path/'retry').exists() and hashes(two)==unchanged\\n    another,another_evidence=bundle(tmp_path,two,name='three',specs=[('B',b,'receipt',[])])\\n    assert run(two,another,another_evidence,tmp_path/'reuse'/'one')==1\\n    assert not (tmp_path/'reuse').exists()\\n    assert hashes(p)==before and len(list((p/'batches').glob('*.json')))==4\\n    for key,item in old['repair_queue']['items'].items():\\n        if item['subject_id'] not in {'SYN-A','SYN-B'}:assert final['repair_queue']['items'][key]==item\\n\\n\\ndef test_valid_item_progresses_while_other_invalid_evidence_is_held(tmp_path):\\n    p=parent(tmp_path,missing_merchants=())\\n    a='ordinary:SYN-A:r1:supporting_evidence';b='ordinary:SYN-B:r1:supporting_evidence'\\n    response,evidence=bundle(tmp_path,p,specs=[('A',a,'receipt',[]),('B',b,'receipt',[])])\\n    bad=evidence/'SYN-one-1.pdf';bad.write_bytes(bad.read_bytes()+b'tampered')\\n    out=tmp_path/'mixed';assert run(p,response,evidence,out)==0\\n    state=get(out/'continuation-state.json');q=state['repair_queue']\\n    assert q['items'][a]['status']=='resolved' and q['items'][b]['status']=='open'\\n    event=next(e for e in q['events'] if e.get('item_id')==b and e['event']=='response-recorded')\\n    assert event['admission_status']=='held' and 'hash' in event['admission_reason']\\n    assert (out/'response-evidence'/next(r['path'] for r in get(out/'response-evidence/sources.json')['files'] if r['source_id']=='SYN-one-1')).read_bytes()==bad.read_bytes()\\n    verify_continuation(out)\\n\\n\\n@pytest.mark.parametrize('fault',['stale','wrong-actor','wrong-hash','missing-file','wrong-revision-assessment','wrong-operation','unknown-ref','future','wrong-gross','invalid-number','unsupported'])\\ndef test_negative_deliveries_never_resolve_or_authorize(tmp_path,fault):\\n    p=parent(tmp_path);before=hashes(p);response,evidence=bundle(tmp_path,p)\\n    obj=get(response);key=next(iter(obj['item_outcomes']))\\n    if fault=='stale':obj['item_outcomes'][key.replace(':r1:',':r2:')]=obj['item_outcomes'].pop(key)\\n    elif fault=='wrong-actor':obj['actor_id']='UNAUTHORIZED'\\n    elif fault=='wrong-hash':(evidence/'SYN-one-0.pdf').write_bytes(b'tampered')\\n    elif fault=='missing-file':(evidence/'SYN-one-0.pdf').unlink()\\n    elif fault=='unknown-ref':obj['item_outcomes'][key]['source_refs']=['missing@'+'0'*64+'#row 1']\\n    elif fault=='unsupported':obj['item_outcomes']['ordinary:SYN-A:r1:required_approvals']=obj['item_outcomes'].pop(key)\\n    elif fault=='future':\\n        manifest=get(evidence/'sources.json');manifest['files'][0]['observed_at']='2026-11-16T12:00:00Z';save(evidence/'sources.json',manifest)\\n    else:\\n        proof=get(evidence/'assessment.json')\\n        if fault=='wrong-revision-assessment':proof['0']['revision']=2\\n        elif fault=='wrong-operation':proof['0']['repairs'][0]['kind']='approval'\\n        else:\\n            # A real, hash-bound PDF with mismatched gross is not sufficient either.\\n            path=evidence/'SYN-one-0.pdf';path.write_bytes(pdf([receipt(amount='invalid' if fault=='invalid-number' else '99.00')]))\\n            rr=f'SYN-one-0@{sha(path)}#PDF page 1, receipt 1'\\n            obj['item_outcomes'][key]['source_refs']=[rr];obj['item_outcomes'][key]['repairs'][0]['record_ref']=rr\\n            proof['0']['evidence_refs']=[rr];proof['0']['repairs'][0]['record_ref']=rr\\n        save(evidence/'assessment.json',proof);manifest=get(evidence/'sources.json')\\n        for row in manifest['files']:row['sha256']=sha(evidence/row['path'])\\n        save(evidence/'sources.json',manifest);obj['item_outcomes'][key]['assessment_ref']=f'SYN-assess-one@{sha(evidence/\\\"assessment.json\\\")}#/0'\\n    save(response,obj);out=tmp_path/'negative'\\n    rc=run(p,response,evidence,out)\\n    if fault in {'stale','wrong-actor'}:assert rc==1 and not out.exists()\\n    else:\\n        assert rc==0\\n        state=get(out/'continuation-state.json');assert state['response_holds']\\n        assert all(i['status']=='open' for k,i in state['repair_queue']['items'].items() if k in obj['item_outcomes'])\\n        assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\\n    assert hashes(p)==before\\n\\n\\ndef test_returned_work_receives_evidence_but_requires_human_re_review(tmp_path):\\n    p=parent(tmp_path,returned=True)\\n    old=get(p/'offline-replay-state.json');wf=old['ordinary_workflows']['SYN-A']\\n    item='ordinary:SYN-A:r1:review_return:SYN-RETURN-A'\\n    assert item in old['repair_queue']['items'] and old['repair_queue']['items'][item]['status']=='open'\\n    response,evidence=bundle(tmp_path,p,specs=[('A',item,'receipt',[])])\\n    partial=tmp_path/'returned-partial';assert run(p,response,evidence,partial)==0\\n    assert get(partial/'continuation-state.json')['repair_queue']['items'][item]['status']=='open'\\n    response2,evidence2=bundle(tmp_path,partial,name='returned-two',specs=[('A',item,'merchant-payment',[])])\\n    out=tmp_path/'returned';assert run(partial,response2,evidence2,out)==0\\n    state=get(out/'continuation-state.json')\\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\\n    assert stage(state,'SYN-A','required_approvals')=='BLOCKED'\\n    assert state['repair_queue']['items'][item]['status']=='open'\\n    assert state['repair_queue']['items'][item]['owner']=='ADMIN-01'\\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\\n    assert state['decision_history']==old['decision_history']\\n    assert state['finance_reconciliations']==old['finance_reconciliations']\\n    assert 'human re-review' in (out/'report.md').read_text()\\n\\n\\ndef test_original_evidence_and_derived_result_tampering_are_detected(tmp_path):\\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\\n    assert run(p,response,evidence,one)==0\\n    (one/'claims.csv').write_text('tampered')\\n    assert run(p,response,evidence,one)==1\\n\\n\\ndef test_explicit_replacement_preserves_old_rows_and_conflicting_replay_is_rejected(tmp_path):\\n    # Explicitly replace merchant proof, without changing any Finance event.\\n    p=parent(tmp_path,missing_merchants=())\\n    key='ordinary:SYN-A:r1:supporting_evidence'\\n    parsed=get(p/'parsed-records.json')\\n    old_payment=next(r for s in parsed['workbook_sheets'] if s['name']=='Merchant payments'\\n                     for r in s['records'] if fields(r).get('Expense reference')=='COST-A')\\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',[]),('A',key,'merchant-payment',[ref(old_payment)])])\\n    out=tmp_path/'replaced';assert run(p,response,evidence,out)==0\\n    state=get(out/'continuation-state.json')\\n    assert stage(state,'SYN-A','supporting_evidence')=='PASS'\\n    changed=state['repair_deliveries'][0]['admitted'][0]['changes']\\n    assert changed[1]['superseded']==[old_payment]\\n    assert ref(old_payment) in get(response)['item_outcomes'][key]['repairs'][1]['supersedes_refs']\\n    assert state['finance_reconciliations']==get(p/'offline-replay-state.json')['finance_reconciliations']\\n    before=hashes(out);obj=get(response);obj['item_outcomes'][key]['note']='conflicting replay';save(response,obj)\\n    assert run(out,response,evidence,tmp_path/'conflict')==1 and hashes(out)==before\\n\\n\\ndef test_unknown_supersession_is_held_and_unmatched_work_is_untouched(tmp_path):\\n    p=parent(tmp_path)\\n    key='ordinary:SYN-A:r1:supporting_evidence'\\n    response,evidence=bundle(tmp_path,p,specs=[('A',key,'receipt',['invented-ref'])])\\n    out=tmp_path/'bad-replacement';assert run(p,response,evidence,out)==0\\n    state=get(out/'continuation-state.json')\\n    assert 'superseded' in state['response_holds'][key]\\n    assert not state['revalidated_claims']\\n    assert state['ordinary_workflows']==get(p/'offline-replay-state.json')['ordinary_workflows']\\n\\n\\ndef test_descendant_checks_original_ancestor_and_response_evidence(tmp_path):\\n    p=parent(tmp_path);response,evidence=bundle(tmp_path,p);one=tmp_path/'one'\\n    assert run(p,response,evidence,one)==0\\n    key='ordinary:SYN-A:r1:supporting_evidence'\\n    response2,evidence2=bundle(tmp_path,one,name='two',specs=[('A',key,'merchant-payment',[])])\\n    two=tmp_path/'two';assert run(one,response2,evidence2,two)==0\\n    original=p/'sources/receipt-binder.pdf';original.write_bytes(original.read_bytes()+b'tampered')\\n    with pytest.raises(ValueError,match='parent evidence changed'):\\n        verify_continuation(two)\\n\\n\\ndef test_current_corrected_revision_resumes_but_old_revision_response_is_rejected(tmp_path):\\n    p=parent(tmp_path,corrected=True)\\n    old=get(p/'offline-replay-state.json');assert old['ordinary_workflows']['SYN-A']['revision']==2\\n    stale,evidence=bundle(tmp_path,p)\\n    assert run(p,stale,evidence,tmp_path/'stale')==1\\n    item='correction:SYN-A:r2:expense-evidence'\\n    assert old['repair_queue']['items'][item]['status']=='open'\\n    response,evidence2=bundle(tmp_path,p,name='current',specs=[('A',item,'receipt',[]),('A',item,'merchant-payment',[])])\\n    out=tmp_path/'corrected';assert run(p,response,evidence2,out)==0\\n    state=get(out/'continuation-state.json')\\n    assert state['repair_queue']['items'][item]['status']=='resolved'\\n    assert state['ordinary_workflows']['SYN-A']['revision']==2\\n    assert state['ordinary_workflows']['SYN-A']['status']=='pending'\\n    assert state['revision_history']==old['revision_history']\\n    assert state['finance_reconciliations']==old['finance_reconciliations']\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1582e-4aca-75b2-a254-a91278317c96","create_time":1792480894.624261}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
