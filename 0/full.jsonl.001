efs/entire/'],text=True)\nPath('/tmp/project-d-attempt3-entire-before.txt').write_text(refs)\nassert len(refs.splitlines())==30\nassert subprocess.run(['git','merge-base','--is-ancestor','ccea724fbcc1e1581b8625e66f2c9f263c1f8670','refs/entire/checkpoints/ZY/01M5AP7SG3VYTB9WS5VE0K9QZY']).returncode==0\nprint('30 Entire refs recorded; queued historical tail is a safe fast-forward')\nPY"],"cwd":"file:///home/maxg/travel-expense-claim","parsed_cmd":[{"type":"unknown","cmd":".venv/bin/python - <<'PY'\nimport hashlib,json,subprocess\nfrom pathlib import Path\nfiles=['README.md','skills/travel-expense-claim/SKILL.md','src/travel_claim/cli.py','src/travel_claim/outputs.py','src/travel_claim/receipt_continuation.py','src/travel_claim/repair_continuation.py','tests/test_repair_continuation.py']\nassert set(subprocess.check_output(['git','diff','--name-only'],text=True).splitlines())==set(files[:5])\nassert not subprocess.check_output(['git','diff','--cached','--name-only'])\nbase=json.loads(Path('/tmp/project-d-attempt3-baseline.json').read_text())\nfor p,h in base.items():\n if p in files:continue\n with Path(p).open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==h,p\nm=json.loads(Path('artifacts/submission/stage7-evidence-manifest.json').read_text())\nfor r in m['files']:\n for p,h in [(r['stored_path'],r['stored_sha256']),(r['path'],r['sha256'])]:\n  with Path(p).open('rb') as f:assert hashlib.file_digest(f,'sha256').hexdigest()==h,p\nprint('53/53 publication entries and 123 unrelated tracked baseline files preserved')\nold=set(Path('/tmp/project-d-attempt3-untracked-before.txt').read_bytes().split(b'\\0'))\nnow=set(subprocess.check_output(['git','ls-files','--others','--exclude-standard','-z']).split(b'\\0'))\nassert old<=now and now-old=={p.encode() for p in files[-2:]}\nprint('Untracked historical path inventory preserved; exactly two authorized new files')\nPath('/tmp/project-d-attempt3-reviewed.json').write_text(json.dumps({p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in files}))\nrefs=subprocess.check_output(['git','for-each-ref','--format=%(objectname) %(refname)','refs/entire/'],text=True)\nPath('/tmp/project-d-attempt3-entire-before.txt').write_text(refs)\nassert len(refs.splitlines())==30\nassert subprocess.run(['git','merge-base','--is-ancestor','ccea724fbcc1e1581b8625e66f2c9f263c1f8670','refs/entire/checkpoints/ZY/01M5AP7SG3VYTB9WS5VE0K9QZY']).returncode==0\nprint('30 Entire refs recorded; queued historical tail is a safe fast-forward')\nPY"}],"source":"unified_exec_startup","status":"completed","stdout":"53/53 publication entries and 123 unrelated tracked baseline files preserved\nUntracked historical path inventory preserved; exactly two authorized new files\n30 Entire refs recorded; queued historical tail is a safe fast-forward\n","stderr":"","aggregated_output":"53/53 publication entries and 123 unrelated tracked baseline files preserved\nUntracked historical path inventory preserved; exactly two authorized new files\n30 Entire refs recorded; queued historical tail is a safe fast-forward\n","exit_code":0,"duration":{"secs":4,"nanos":803938706},"formatted_output":"53/53 publication entries and 123 unrelated tracked baseline files preserved\nUntracked historical path inventory preserved; exactly two authorized new files\n30 Entire refs recorded; queued historical tail is a safe fast-forward\n"},"started_at_ms":1792480892785,"completed_at_ms":1792480897589}}
